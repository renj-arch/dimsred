    "linear_programming": "GENERATORS.math.linear_programming = [function(){var a=rand(2,4);var b=rand(3,6);return{q:'Max Z='+a+'x+'+(a+b)+'y, x≥0, y≥0, x+y≤'+(a+b)+'. Feasible region shape?',a:'Triangle',hint:'x≥0, y≥0, x+y≤'+(a+b)+' is a triangle',solution:'Concept: Vertices at (0,0), ('+(a+b)+',0), (0,'+(a+b)+') → triangle'};},function(){var a=rand(2,4);var b=rand(3,6);return{q:'Max Z=3x+2y, x+y≤'+a+', x≤'+b+'. At (0,0), Z=?',a:0,hint:'Plug x=0,y=0',solution:'Formula: 3(0)+2(0)=0'};},function(){var a=rand(2,5);var b=rand(6,10);var c=rand(1,4);return{q:'Min Z='+a+'x+'+b+'y, x+y≥'+c+', x,y≥0. Feasible region?',a:'Unbounded',hint:'Region extends infinitely',solution:'Concept: x+y≥'+c+', x,y≥0 → unbounded region'};},function(){var a=rand(2,4);var b=rand(3,5);return{q:'Max Z='+(a+b)+'x+'+a+'y, x≥0, y≥0, x+y≤'+b+'. Corner points?',a:'(0,0), ('+b+',0), (0,'+b+')',hint:'Intersection of x+y='+b+' with axes',solution:'Concept: Solve with axes → (0,0), ('+b+',0), (0,'+b+')'};},function(){var a=rand(2,4);var b=rand(5,8);return{q:'Max Z=x+2y, x+y≤'+b+', x≤'+a+'. Z at ('+a+','+(b-a)+')?',a:a+2*b-2*a,hint:'Substitute point',solution:'Formula: '+a+'+2('+(b-a)+') = '+(a+2*b-2*a)+' = '+(2*b-a)};},function(){var a=rand(2,4);var b=rand(5,8);return{q:'Max Z=x+2y, x+y≤'+b+', x≤'+a+'. Z at ('+a+',0)?',a:a,hint:'Substitute (x,y)',solution:'Formula: '+a+'+2(0)='+a};},function(){var a=rand(2,4);var b=rand(5,8);return{q:'Max Z=x+2y, x+y≤'+b+', x≤'+a+'. Z at (0,'+b+')?',a:2*b,hint:'Substitute (x,y)',solution:'Formula: 0+2('+b+')='+(2*b)};},function(){return{q:'Which theorem says optimum occurs at corner point?',a:'Corner point theorem',hint:'Optimum LPP lies at vertex',solution:'Concept: Corner point theorem → optimum of LPP at vertex of convex feasible region'};},function(){var a=rand(2,5);var b=rand(3,6);return{q:'LPP: x+'+a+'y≤'+(a*b)+', 2x+y≤'+(a+b)+', x,y≥0. Number of constraints?',a:4,hint:'Includes non-negativity',solution:'Concept: x+'+a+'y≤'+(a*b)+', 2x+y≤'+(a+b)+', x≥0, y≥0 → 4 co