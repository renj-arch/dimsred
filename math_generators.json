    "statistics": "GENERATORS.math.statistics.push(function(){var a=rand(2,5);var b=rand(6,10);return{q:'Mean of '+a+', '+b+', '+(a+b)+', '+(b-a)+'?',a:(2*b+2*a)/4,hint:'Sum/n',solution:'Formula: ('+a+'+'+b+'+'+(a+b)+'+'+(b-a)+')/4 = '+(a+b+Math.abs(a+b)+Math.abs(b-a))/4};},function(){var n=rand(4,7);return{q:'Median of '+n+','+(n+1)+','+(n+2)+','+(n+3)+','+(n+4)+'?',a:n+2,hint:'Middle value when sorted',solution:'Concept: Sorted: '+n+','+(n+1)+','+(n+2)+','+(n+3)+','+(n+4)+' → median = '+(n+2)};},function(){var n=rand(3,5);return{q:'Mode of '+n+','+(n+1)+','+n+','+(n+2)+','+n+'?',a:n,hint:'Most frequent value',solution:'Concept: '+n+' appears 3 times → mode = '+n};},function(){var a=rand(2,5);var b=rand(6,10);return{q:'Mean of first '+a+' natural numbers?',a:(a+1)/2,hint:'Mean = (n+1)/2',solution:'Formula: (1+2+...+'+a+')/'+a+' = ('+a+'('+a+'+1)/2)/'+a+' = '+(a+1)/2};},function(){var a=rand(2,5);var b=rand(6,10);return{q:'Variance of '+a+','+b+','+(a+b)+'?',a:'',hint:'σ² = (1/n)Σ(xᵢ-μ)²',solution:'Formula: Mean = '+(a+b+a+b)/3+', then compute deviations'};},function(){var a=rand(2,5);return{q:'Standard deviation of '+a+','+a+','+a+'?',a:0,hint:'No deviation when all values equal',solution:'Concept: All values same → SD = 0'};},function(){return{q:'Coefficient of variation formula?',a:'(σ/μ)×100%',hint:'CV = (SD/Mean)×100',solution:'Formula: CV = (Standard Deviation / Mean) × 100%'};},function(){var a=rand(2,5);var b=rand(3,6);return{q:'Combined mean of group1 n1='+a+', mean1='+b+' and group2 n2='+(a+1)+', mean2='+(b-1)+'?',a:'',hint:'x̄_c = (n₁x̄₁+n₂x̄₂)/(n₁+n₂)',solution:'Formula: ('+a+'·'+b+'+'+(a+1)+'·'+(b-1)+')/('+a+'+'+(a+1)+')'};},function(){var a=rand(3,6);return{q:'Mean deviation about mean for '+a+','+(a+1)+','+(a+2)+'?',a:'',hint:'MD = (1/n)Σ|xᵢ-x̄|',solution:'Formula: Mean='+(3*a+3)/3+'='+(a+1)+', MD = (|'+a+'-'+(a+1)+'|+|0|+|'+(a+2)+'-'+(a+1)+'|)/3 = 2/3'};},function(){return{q:'If all values multiplied by 2, variance multiplies by?',a:4,hint:'Var(cX)=c