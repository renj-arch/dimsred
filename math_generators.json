    "continuity": "GENERATORS.math.continuity = [function(){var a=rand(2,5);return{q:'f(x)='+a+'x+1 at x=2. Is f continuous?',a:'Yes, polynomial',hint:'Polynomials are continuous everywhere',solution:'Concept: f(x)='+a+'x+1 is polynomial → continuous on R → yes at x=2'};},function(){return{q:'f(x)=|x| at x=0. Is f continuous?',a:'Yes',hint:'LHL=RHL=f(0)=0',solution:'Concept: lim_{x→0⁻}|x|=0, lim_{x→0⁺}|x|=0, f(0)=0 → LHL=RHL=f(0) → continuous'};},function(){var a=rand(2,5);return{q:'f(x)=1/(x-'+a+') at x='+a+'. Discontinuity type?',a:'Infinite discontinuity',hint:'Denominator→0, function→∞',solution:'Concept: Denominator 0 at x='+a+' → infinite discontinuity'};},function(){var a=rand(1,4);var b=rand(2,5);return{q:'f(x)={x+'+a+', x<'+b+'; '+a+'x, x≥'+b+'} at x='+b+'. LHL?',a:a+b,hint:'Approach from left: x+'+(a),solution:'Formula: lim_{x→'+b+'⁻} f(x) = '+b+'+'+a+' = '+(a+b)};},function(){var a=rand(2,5);return{q:'lim_{x→0} sin('+a+'x)/x?',a:a,hint:'Standard limit',solution:'Formula: lim_{x→0} sin('+a+'x)/x = '+a};},function(){var a=rand(2,5);return{q:'f(x)=x²sin(1/x), f(0)=0. Continuous at 0?',a:'Yes',hint:'|x²sin(1/x)| ≤ x² → 0',solution:'Concept: 0≤|f(x)|≤x² → squeeze → lim_{x→0}f(x)=0=f(0) → continuous'};},function(){var a=rand(2,5);return{q:'Constant f(x)='+a+'. Is it continuous?',a:'Yes, everywhere',hint:'Constant functions have no jumps',solution:'Concept: lim_{x→c}'+a+'='+a+'=f(c) → continuous everywhere'};},function(){return{q:'f(x)=e^x at x=0. Continuous?',a:'Yes',hint:'Exponential is continuous on R',solution:'Concept: e^x continuous on R → e^0=1 → continuous at 0'};},function(){return{q:'Discontinuity of 1/(x²-x) at x=0?',a:'Infinite',hint:'Denominator x(x-1)→0',solution:'Concept: 1/(x(x-1)) → denominator 0 at x=0 and x=1 → infinite discontinuity'};},function(){var a=rand(2,4);return{q:'f(x)=[x] (GIF) at x='+a+'. Type?',a:'Jump discontinuity',hint:'LHL='+(a-1)+', RHL='+a+', f('+a+')='+a,solution:'Concept: LHL='+(a-1)+', RHL='+a+' → LHL≠RHL → jump discontin