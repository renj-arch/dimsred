    "algebra_binomial": "GENERATORS.math.algebra_binomial.push(function(){var n=rand(4,7);return{q:'General term in (1+x)^'+n+'?',a:'C('+n+',r)x^r',hint:'T_{r+1}=C(n,r)x^r',solution:'Formula: T_{r+1} = C('+n+',r)x^r'};},function(){var n=rand(3,6);return{q:'Middle term in (1+x)^'+(2*n)+'?',a:'C('+2*n+','+n+')x^'+n,hint:'n=2m, middle = T_{m+1}',solution:'Formula: n='+2*n+'(even), middle = C('+2*n+','+n+')x^'+n};},function(){var n=rand(3,5);return{q:'Independent of x in (x+1/x)^'+n+'?',a:n%2===0?'C('+n+','+n/2+')':'None',hint:'Set power of x to 0',solution:'Concept: T_{r+1}=C('+n+',r)x^'+(n-2*r)+' → n-2r=0 → r='+n/2+' → '+(n%2===0?'C('+n+','+n/2+')':'no independent term')};},function(){var n=rand(6,10);return{q:'ΣC('+n+',r) = ?',a:Math.pow(2,n),hint:'Put x=1 in (1+x)^n',solution:'Formula: 2^'+n+' = '+Math.pow(2,n)};},function(){var n=rand(5,8);return{q:'Σ(-1)^r C('+n+',r) = ?',a:0,hint:'Put x=-1 in (1+x)^n',solution:'Formula: (1-1)^'+n+' = 0'};},function(){var n=rand(4,7);return{q:'Σ[C('+n+',r)]² = ?',a:'C('+2*n+','+n+')',hint:'C(2n,n)',solution:'Formula: Σ[C('+n+',r)]² = C('+2*n+','+n+')'};},function(){var n=rand(4,6);return{q:'Coeff of x² in (1+2x)^'+n+'?',a:2*n*(n-1),hint:'C(n,2)(2x)²',solution:'Formula: C('+n+',2)·4 = '+n*(n-1)/2+'·4 = '+2*n*(n-1)};},function(){var n=rand(4,7);return{q:'Greatest coefficient in (1+x)^'+n+'?',a:'C('+n+','+Math.floor(n/2)+')',hint:'Middle term has greatest coefficient',solution:'Concept: For n='+n+', greatest coefficient = C('+n+','+Math.floor(n/2)+')'};},function(){var n=rand(3,5);return{q:'Coefficient of x² in (1+x)^'+n+'?',a:n*(n-1)/2,hint:'C(n,2)',solution:'Formula: C('+n+',2) = '+n*(n-1)/2};},function(){var n=rand(4,7);var k=rand(1,3);return{q:'Coeff of x^'+k+' in (1-2x)^'+n+'?',a:Math.pow(-2,k)*n*(n-1)/2,hint:'C('+n+','+k+')(-2)^'+k,solution:'Formula: C('+n+','+k+')(-2)^'+k+' = '+(n*(n-1)/2)+'·'+Math.pow(-2,k)};},function(){var n=rand(2,4);return{q:'(0.99)^'+n+' ≈?',a:1-0.01*n,hint:'(1-x)^n ≈ 1-nx',solution:'Formula: 1 - '+n+'(0