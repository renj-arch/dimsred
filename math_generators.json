    "trigonometry": "GENERATORS.math.trigonometry.push(function(){var a=rand(2,5);return{q:'sin('+a+'θ) in terms of sinθ?',a:'',hint:'Use sin(3θ)=3sinθ-4sin³θ etc',solution:'Formula: sin('+a+'θ) = ??? use multiple angle formula'};},function(){var a=rand(2,5);var b=rand(3,6);return{q:'sin('+a+'°+'+b+'°) = ?',a:'',hint:'sin(A+B)=sinA cosB+cosA sinB',solution:'Formula: sin('+a+')cos('+b+')+cos('+a+')sin('+b+')'};},function(){var a=rand(2,5);var b=rand(3,6);return{q:'cos('+a+'°-'+b+'°) = ?',a:'',hint:'cos(A-B)=cosA cosB+sinA sinB',solution:'Formula: cos('+a+')cos('+b+')+sin('+a+')sin('+b+')'};},function(){var a=rand(2,5);return{q:'sin2θ = ? (in terms of tanθ)',a:'2tanθ/(1+tan²θ)',hint:'sin2θ = 2tanθ/(1+tan²θ)',solution:'Formula: sin2θ = 2tanθ/(1+tan²θ)'};},function(){var a=rand(2,5);return{q:'cos2θ = ? (in terms of tanθ)',a:'(1-tan²θ)/(1+tan²θ)',hint:'cos2θ = (1-tan²θ)/(1+tan²θ)',solution:'Formula: cos2θ = (1-tan²θ)/(1+tan²θ)'};},function(){var a=rand(2,4);var b=rand(5,7);return{q:'sin('+a+'θ) + sin('+b+'θ) = ?',a:'2sin(('+a+'+'+b+')θ/2)cos(('+a+'-'+b+')θ/2)',hint:'sinC+sinD=2sin((C+D)/2)cos((C-D)/2)',solution:'Formula: sinC+sinD=2sin((C+D)/2)cos((C-D)/2)'};},function(){var a=rand(2,4);var b=rand(5,7);return{q:'cos('+a+'θ) - cos('+b+'θ) = ?',a:'-2sin(('+a+'+'+b+')θ/2)sin(('+a+'-'+b+')θ/2)',hint:'cosC-cosD=-2sin((C+D)/2)sin((C-D)/2)',solution:'Formula: cosC-cosD=-2sin((C+D)/2)sin((C-D)/2)'};},function(){return{q:'Principal solution of sin x = 1/2?',a:'x=π/6, 5π/6',hint:'sin positive in Q1 and Q2',solution:'Concept: sin x=1/2 → x=π/6, π-π/6=5π/6'};},function(){return{q:'General solution of sin x = 0?',a:'x=nπ, n∈Z',hint:'sin x=0 at multiples of π',solution:'Formula: x = nπ, n∈Z'};},function(){return{q:'General solution of cos x = 0?',a:'x=(2n+1)π/2, n∈Z',hint:'cos x=0 at odd multiples of π/2',solution:'Formula: x = (2n+1)π/2, n∈Z'};},function(){return{q:'General solution of tan x = √3?',a:'x=nπ+π/3, n∈Z',hint:'tan x = √3 → x = π/3',solution:'Formula: x = nπ + π/3, n∈Z'};}