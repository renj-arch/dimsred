    "inverse_trigonometry": "GENERATORS.math.inverse_trigonometry = [function(){return{q:'Domain of sin⁻¹x?',a:'[-1,1]',hint:'Inverse sine defined for x∈[-1,1]',solution:'Concept: y=sin⁻¹x defined for x∈[-1,1]'};},function(){return{q:'Principal value branch of sin⁻¹x?',a:'[-π/2, π/2]',hint:'sin⁻¹x range is [-π/2,π/2]',solution:'Concept: sin⁻¹x ∈ [-π/2, π/2] for principal values'};},function(){return{q:'Principal value branch of cos⁻¹x?',a:'[0, π]',hint:'cos⁻¹x range is [0,π]',solution:'Concept: cos⁻¹x ∈ [0, π] for principal values'};},function(){return{q:'Principal value branch of tan⁻¹x?',a:'(-π/2, π/2)',hint:'tan⁻¹x range is (-π/2,π/2)',solution:'Concept: tan⁻¹x ∈ (-π/2, π/2) for principal values'};},function(){return{q:'Principal value of sin⁻¹(1)?',a:'π/2',hint:'sin(π/2)=1',solution:'Formula: sin⁻¹(1) = π/2'};},function(){return{q:'Principal value of sin⁻¹(0)?',a:'0',hint:'sin(0)=0',solution:'Formula: sin⁻¹(0) = 0'};},function(){return{q:'sin(sin⁻¹(0.5))?',a:'0.5',hint:'sin(sin⁻¹x)=x for x∈[-1,1]',solution:'Formula: sin(sin⁻¹0.5) = 0.5'};},function(){return{q:'sin⁻¹(sin(π/3))?',a:'π/3',hint:'sin⁻¹(sin x)=x when x∈[-π/2,π/2]',solution:'Concept: π/3∈[-π/2,π/2] → sin⁻¹(sin(π/3)) = π/3'};},function(){return{q:'sin⁻¹(sin(5π/6))?',a:'π/6',hint:'5π/6 outside principal branch',solution:'Concept: sin(5π/6)=1/2, sin⁻¹(1/2)=π/6'};},function(){return{q:'tan⁻¹(1)?',a:'π/4',hint:'tan(π/4)=1',solution:'Formula: tan⁻¹(1) = π/4'};},function(){return{q:'cos⁻¹(0)?',a:'π/2',hint:'cos(π/2)=0',solution:'Formula: cos⁻¹(0) = π/2'};},function(){return{q:'cos(tan⁻¹x)?',a:'1/√(1+x²)',hint:'Let tan⁻¹x=θ, draw triangle',solution:'Concept: tanθ=x ⇒ cosθ=1/√(1+x²)'};},function(){var a=rand(2,5);return{q:'2tan⁻¹('+a+') = tan⁻¹(?)',a:'tan⁻¹('+2*a+'/(1-'+a*a+'))',hint:'2tan⁻¹x = tan⁻¹(2x/(1-x²))',solution:'Formula: 2/'+(1-a*a)+' → tan⁻¹('+2*a+'/'+(1-a*a)+')'};},function(){return{q:'sin⁻¹x + cos⁻¹x = ?',a:'π/2',hint:'Standard identity for all x∈[-1,1]',solution:'Formula: sin⁻¹x + cos⁻¹x = π/2'};}