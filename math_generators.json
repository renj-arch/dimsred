    "algebra_sequences": "GENERATORS.math.algebra_sequences.push(function(){var a=rand(2,5);var d=rand(3,7);var n=rand(5,10);return{q:'AP: a='+a+', d='+d+'. T_'+(n)+'?',a:a+(n-1)*d,hint:'T_n=a+(n-1)d',solution:'Formula: '+a+'+('+n+'-1)·'+d+' = '+a+'+'+(n-1)*d+' = '+(a+(n-1)*d)};},function(){var a=rand(2,5);var d=rand(3,7);var n=rand(5,10);return{q:'AP: a='+a+', d='+d+'. Sum of '+n+' terms?',a:n/2*(2*a+(n-1)*d),hint:'S_n=n/2[2a+(n-1)d]',solution:'Formula: S_'+n+'='+n+'/2[2·'+a+'+('+n+'-1)·'+d+']='+n/2*(2*a+(n-1)*d)};},function(){var a=rand(2,5);var b=rand(6,10);return{q:'AM between '+a+' and '+b+'?',a:(a+b)/2,hint:'AM=(a+b)/2',solution:'Formula: ('+a+'+'+b+')/2 = '+(a+b)/2};},function(){var a=rand(3,6);return{q:'Insert '+(a-1)+' AMs between 1 and '+a*a+'. Common d?',a:(a*a-1)+'/'+a,hint:'d=(b-a)/(n+1)',solution:'Formula: d=('+(a*a)+'-1)/'+a+' = '+(a*a-1)+'/'+a};},function(){var a=rand(2,4);var r=rand(2,4);var n=rand(4,7);return{q:'GP: a='+a+', r='+r+'. T_'+n+'?',a:a*Math.pow(r,n-1),hint:'T_n=ar^(n-1)',solution:'Formula: '+a+'·'+r+'^'+(n-1)+' = '+(a*Math.pow(r,n-1))};},function(){var a=rand(2,4);var r=rand(2,4);var n=rand(4,7);return{q:'GP: a='+a+', r='+r+'. S_'+n+'?',a:a*(Math.pow(r,n)-1)/(r-1),hint:'S_n=a(r^n-1)/(r-1)',solution:'Formula: '+a+'('+r+'^'+n+'-1)/'+(r-1)+' = '+a*(Math.pow(r,n)-1)/(r-1)};},function(){var a=rand(2,4);var r=rand(2,4);return{q:'GP: a='+a+', r=1/'+r+'. Sum to ∞?',a:a*r/(r-1),hint:'S_∞=a/(1-r)',solution:'Formula: '+a+'/(1-1/'+r+') = '+a*r+'/'+(r-1)};},function(){var a=rand(2,5);var b=rand(6,10);return{q:'GM between '+a+' and '+b+'?',a:Math.sqrt(a*b),hint:'GM=√(ab)',solution:'Formula: √('+a+'·'+b+') = √'+(a*b)};},function(){var a=rand(2,5);var b=rand(6,10);return{q:'HM between '+a+' and '+b+'?',a:2*a*b/(a+b),hint:'HM=2ab/(a+b)',solution:'Formula: 2·'+a+'·'+b+'/('+a+'+'+b+') = '+2*a*b/(a+b)};},function(){var a=rand(2,5);var b=rand(6,10);return{q:'Largest among AM,GM,HM of '+a+','+b+'?',a:'AM='+(a+b)/2,hint:'AM≥GM≥HM',solution:'Concept: AM = '+(a