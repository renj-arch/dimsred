// ============================================================
// ERA & TIMELINE DEFINITIONS
// ============================================================
const ERAS = [
  {id:'all',label:'All Eras',start:-5000,end:2030},
  {id:'ancient',label:'Ancient India',start:-3300,end:1206,bg:'#c084fc20'},
  {id:'medieval',label:'Medieval India',start:1206,end:1526,bg:'#fb923c20'},
  {id:'mughal',label:'Mughal Era',start:1526,end:1707,bg:'#f472b620'},
  {id:'modern',label:'Modern India',start:1707,end:1947,bg:'#60a5fa20'},
  {id:'post',label:'Post-1947',start:1947,end:2026,bg:'#34d39920'},
];

function fmtYear(y){
  if(y<0)return Math.abs(y)+' BCE';
  return y+' CE';
}
function eraRange(e){
  if(e.id==='all')return '';
  return fmtYear(e.start)+' – '+fmtYear(e.end);
}

// ============================================================
// HELPERS
// ============================================================
function parseYear(str){
  if(!str)return null;
  if(typeof str==='number')return str;
  if(typeof str!=='string')return null;
  const cleaned=str.replace(/,/g,'');
  const m=cleaned.match(/(-?\d+)/);
  if(!m)return null;
  let y=parseInt(m[1]);
  if(str.includes('BCE')||str.includes('BC'))y=-y;
  if(str.includes('cent')||str.includes('century')){
    y = y*100 - (y>0?100:0);
  }
  return y;
}

function getContemporaries(year,buffer=50){
  const alive=[];
  for(const [name,data] of Object.entries(CONTEMPORARIES)){
    const b=data.b,d=data.d;
    if(b!==undefined && d!==undefined){
      if(year>=b-buffer && year<=d+buffer){
        alive.push({name,...data});
      }
    }
  }
  return alive.sort((a,b)=>a.b-b.b);
}

function getEraEvents(year,buffer=100){
  const events=[];
  const catMap={battle:'battle',w_battle:'w_battle',temple:'temple',unesco:'unesco',city:'city',institution:'institution',kingdom:'kingdom',w_kingdom:'w_kingdom'};
  for(const [k,arr] of Object.entries(D)){
    if(!arr||!catMap[k])continue;
    arr.forEach(d=>{
      const sub=d.sub||'';
      const y=parseYear(sub);
      if(y && Math.abs(y-year)<=buffer){
        events.push({item:d,cat:k,label:d.n,sub:d.sub,color:CAT[k]?.color||'#fff',year:y});
      }
    });
  }
  return events.sort((a,b)=>a.year-b.year);
}

// ============================================================
// THREE.JS SETUP
// ============================================================
let totalItems=0;Object.values(D).forEach(a=>{if(a)totalItems+=a.length});


const scene = new THREE.Scene();
function getPanelRM(){return innerWidth<700?0:380;}
const cam = new THREE.PerspectiveCamera(40,(innerWidth-getPanelRM())/innerHeight,0.1,1000);
cam.position.set(0.15,0.4,1.9);
const ren = new THREE.WebGLRenderer({antialias:true});
ren.setSize(innerWidth-getPanelRM(),innerHeight);
ren.setPixelRatio(Math.min(devicePixelRatio,2));
ren.toneMapping=THREE.ACESFilmicToneMapping;ren.toneMappingExposure=1.2;
ren.domElement.style.position='fixed';ren.domElement.style.top='0';ren.domElement.style.left='0';
document.body.prepend(ren.domElement);

const ctrl = new OrbitControls(cam,ren.domElement);

ctrl.enableDamping=true;ctrl.dampingFactor=0.06;
ctrl.minDistance=1.2;ctrl.maxDistance=5.5;
ctrl.autoRotate=false;ctrl.enablePan=false;

// Stars
const sg=new THREE.BufferGeometry();
const sp=new Float32Array(4000*3);
for(let i=0;i<4000;i++){const t=Math.random()*Math.PI*2,p=Math.acos(2*Math.random()-1),r=50+Math.random()*150;sp[i*3]=r*Math.sin(p)*Math.cos(t);sp[i*3+1]=r*Math.cos(p);sp[i*3+2]=r*Math.sin(p)*Math.sin(t)}
sg.setAttribute('position',new THREE.BufferAttribute(sp,3));
scene.add(new THREE.Points(sg,new THREE.PointsMaterial({color:0xffffff,size:0.05,sizeAttenuation:true,transparent:true,opacity:0.8,blending:THREE.AdditiveBlending})));

// Earth
const R=1, EG=new THREE.Group();scene.add(EG);
EG.rotation.y=Math.PI; // Show India-facing side initially
const L=new THREE.TextureLoader();
const load=(u,cb)=>{L.load(u,cb)};
load('https://unpkg.com/three-globe@2.24.8/example/img/earth-blue-marble.jpg',(map)=>{
  load('https://unpkg.com/three-globe@2.24.8/example/img/earth-topology.png',(bump)=>{
    const m=new THREE.MeshStandardMaterial({map,bumpMap:bump,bumpScale:0.03,roughness:0.5,metalness:0.05});
    EG.add(new THREE.Mesh(new THREE.SphereGeometry(R,64,64),m));
  });
});
// Atmosphere
const gm=new THREE.ShaderMaterial({vertexShader:`varying vec3 vN;varying vec3 vP;void main(){vN=normalize(normalMatrix*normal);vP=(modelViewMatrix*vec4(position,1.0)).xyz;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}`,fragmentShader:`varying vec3 vN;varying vec3 vP;void main(){vec3 v=normalize(-vP);float r=1.0-max(0.0,dot(v,vN));r=pow(r,3.0);vec3 c=mix(vec3(0.3,0.6,1.0),vec3(0.1,0.8,0.6),r);gl_FragColor=vec4(c,r*0.5);}`,transparent:true,side:THREE.FrontSide,blending:THREE.AdditiveBlending,depthWrite:false});
EG.add(new THREE.Mesh(new THREE.SphereGeometry(R*1.06,48,48),gm));
const om=new THREE.ShaderMaterial({vertexShader:`varying vec3 vN;varying vec3 vP;void main(){vN=normalize(normalMatrix*normal);vP=(modelViewMatrix*vec4(position,1.0)).xyz;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}`,fragmentShader:`varying vec3 vN;varying vec3 vP;void main(){vec3 v=normalize(-vP);float r=1.0-max(0.0,dot(v,vN));r=pow(r,5.0);gl_FragColor=vec4(0.4,0.7,1.0,r*0.2);}`,transparent:true,side:THREE.BackSide,blending:THREE.AdditiveBlending,depthWrite:false});
EG.add(new THREE.Mesh(new THREE.SphereGeometry(R*1.18,48,48),om));
load('https://unpkg.com/three-globe@2.24.8/example/img/earth-water.png',(t)=>{EG.add(new THREE.Mesh(new THREE.SphereGeometry(R*1.005,48,48),new THREE.MeshPhongMaterial({map:t,transparent:true,opacity:0.06,depthWrite:false,blending:THREE.AdditiveBlending})))});
// Lighting
scene.add(new THREE.AmbientLight(0xffffff,1.8));
const sl=new THREE.DirectionalLight(0xffeedd,0.3);sl.position.set(5,3,5);scene.add(sl);
scene.add((()=>{const d=new THREE.DirectionalLight(0xffffff,0.2);d.position.set(-3,-1,-4);return d})());
scene.add((()=>{const d=new THREE.DirectionalLight(0xffffff,0.2);d.position.set(0,-4,2);return d})());

function ll(lat,lng,r=R){const p=(90-lat)*Math.PI/180,t=(lng+180)*Math.PI/180;return new THREE.Vector3(-r*Math.sin(p)*Math.cos(t),r*Math.cos(p),r*Math.sin(p)*Math.sin(t))}

// ============================================================
// INIT LAYER VIS STATE
// ============================================================
const layerVis=JSON.parse(localStorage.getItem('upsc_layer_vis')||'{}');
const labelVis=JSON.parse(localStorage.getItem('upsc_label_vis')||'{}');
function toggleLayer(k,on){
  layerVis[k]=on;
  localStorage.setItem('upsc_layer_vis',JSON.stringify(layerVis));
  if(layerGroups[k])layerGroups[k].visible=on;
}
function toggleLabel(k,on){
  labelVis[k]=on;
  localStorage.setItem('upsc_label_vis',JSON.stringify(labelVis));
  // Force label update
  updateLabels();
}

// ============================================================
// BUILD MARKERS
// ============================================================
const allMarkers=[], layerGroups={};
const catColors = {};

Object.entries(CAT).forEach(([k,v])=>{
  catColors[k]=v.color;
  const g=new THREE.Group();EG.add(g);
  layerGroups[k]=g;
  if(layerVis[k]===false)g.visible=false;
});

function mkGeom(shape,sz){
  switch(shape){
    case'box':return new THREE.BoxGeometry(sz*1.6,sz*1.6,sz*1.6);
    case'cone':return new THREE.ConeGeometry(sz*1.2,sz*2.4,3);
    case'tri':return new THREE.ConeGeometry(sz*1.4,sz*2.2,3);
    case'diamond':return new THREE.OctahedronGeometry(sz*1.6);
    case'ring':return new THREE.RingGeometry(sz*0.6,sz*1.6,8);
    case'pyramid':return new THREE.TetrahedronGeometry(sz*1.8);
    default:return new THREE.SphereGeometry(sz,8,8);
  }
}
const SHAPE_MAP={
  city:'box',w_city:'box',
  peak:'tri',w_peak:'tri',
  port:'ring',
  airport:'diamond',
  dam:'box',
  nuclear:'sphere',
  unesco:'cone',w_unesco:'cone',
  battle:'pyramid',w_battle:'pyramid',
  temple:'diamond',
  institution:'box',w_inst:'box',
  wildlife:'sphere',
  biosphere:'ring',
  ramsar:'sphere',
  national_park:'tri',w_np:'tri',
  w_landmark:'diamond',
  w_kingdom:'pyramid',
  kingdom:'pyramid',
  strait:'ring',
  desert:'sphere',
  lake:'sphere',
  island:'sphere',
  peninsula:'box',
  volcano:'tri',
  gulf:'ring',
  canal:'box',
  range:'cone',
  sea:'sphere',
  waterfall:'cone',
  reef:'ring',
  canyon:'cone',
  cape:'diamond',
  delta:'box',
  phenomena:'sphere',
  tiger:'sphere',
  hill:'cone',
  bird:'sphere',
  i_pass:'diamond',
  plateau:'box',
  plain:'sphere',
  valley:'cone',
  w_pass:'diamond',
  glacier:'cone',
  w_bridge:'box',
  lighthouse:'cone',
  wonder:'diamond',
  tower:'box',
  w_dam:'box',
  w_airport:'diamond',
  tunnel:'ring',
  oil:'sphere',
  personality:'diamond',
  crop:'cone',
  mineral:'sphere',
};
function mkPin(col,sz=0.008,cat=''){
  const shape=SHAPE_MAP[cat]||'sphere';
  const g=mkGeom(shape,sz);
  const m=new THREE.MeshStandardMaterial({color:col,emissive:col,emissiveIntensity:0.3});
  const sp=new THREE.Mesh(g,m);
  const gl=new THREE.Mesh(new THREE.SphereGeometry(sz*1.5,6,6),new THREE.MeshBasicMaterial({color:col,transparent:true,opacity:0.06}));
  const gr=new THREE.Group();gr.add(sp);gr.add(gl);
  return gr;
}

let _selHighlight=null;
let _selTube=null;
let _selArrows=null;
function clearHighlight(){
  if(_selHighlight){EG.remove(_selHighlight);_selHighlight=null;}
  if(_selTube){
    _selTube.material.color.set(_selTube.userData._origColor||'#ffffff');
    _selTube.material.opacity=_selTube.userData._origOpacity||0.5;
    _selTube.scale.set(1,1,1);
    _selTube=null;
    if(_selArrows)_selArrows.forEach(a=>{
      a.material.color.set(a.userData._origColor||'#ffffff');
      a.material.opacity=a.userData._origOpacity||0.4;
    });
    _selArrows=null;
  }
}
function setHighlight(lat,lng,color='#fb923c'){
  clearHighlight();
  const pos=ll(lat,lng,1.008);
  const g=new THREE.Group();
  const core=new THREE.Mesh(new THREE.SphereGeometry(0.02,12,12),new THREE.MeshBasicMaterial({color,transparent:true,opacity:0.95}));
  const glow=new THREE.Mesh(new THREE.SphereGeometry(0.04,12,12),new THREE.MeshBasicMaterial({color,transparent:true,opacity:0.12}));
  g.add(core);g.add(glow);
  g.position.copy(pos);
  EG.add(g);
  _selHighlight=g;
}

function mkLbl(text,col,scale=0.12){
  const c=document.createElement('canvas');c.width=512;c.height=56;
  const ctx=c.getContext('2d');
  ctx.font='bold 24px Inter,system-ui,sans-serif';
  ctx.textAlign='center';ctx.textBaseline='middle';
  ctx.shadowColor='rgba(0,0,0,0.85)';ctx.shadowBlur=10;
  ctx.fillStyle=col;ctx.fillText(text,256,28);
  const t=new THREE.CanvasTexture(c);t.minFilter=THREE.LinearFilter;
  const s=new THREE.Sprite(new THREE.SpriteMaterial({map:t,transparent:true,depthTest:false}));
  s.scale.set(scale*2,scale*0.22,1);
  return s;
}

// Build point markers with overlap spreading
const _placedPos = [];
function _spreadPos(la, ln) {
  const pos = ll(la, ln, R * 1.008);
  const threshold = 0.025;
  for (const p of _placedPos) {
    const d = pos.distanceTo(p);
    if (d < threshold) {
      const angle = Math.random() * Math.PI * 2;
      const spread = (threshold - d) * 0.6 + 0.003;
      const latR = la * Math.PI / 180;
      const lngR = ln * Math.PI / 180;
      const east = new THREE.Vector3(-Math.sin(lngR), 0, Math.cos(lngR));
      const north = new THREE.Vector3(-Math.sin(latR) * Math.cos(lngR), Math.cos(latR), -Math.sin(latR) * Math.sin(lngR));
      east.multiplyScalar(Math.cos(angle) * spread);
      north.multiplyScalar(Math.sin(angle) * spread);
      pos.add(east).add(north);
      break;
    }
  }
  _placedPos.push(pos.clone());
  return pos;
}
['city','peak','port','airport','dam','nuclear','unesco','battle','temple','institution','wildlife','biosphere','ramsar','national_park','kingdom','tiger','hill','bird','w_city','w_peak','w_np','w_unesco','w_battle','w_landmark','w_inst','w_kingdom','strait','desert','lake','island','peninsula','volcano','gulf','canal','range','sea','waterfall','reef','canyon','cape','delta','phenomena','plateau','plain','valley','glacier','w_bridge','lighthouse','wonder','tower','w_dam','w_airport','tunnel','oil','personality','crop','mineral'].forEach(k=>{
  const items=D[k]||[];
  const g=layerGroups[k];
  items.forEach(d=>{
    if(!d.la)return;
    const pos=_spreadPos(d.la,d.ln);
    const pin=mkPin(catColors[k],k==='city'?0.01:k==='strait'?0.025:0.007,k);
    pin.position.copy(pos);g.add(pin);
    const lbl=mkLbl(d.n,catColors[k]);
    lbl.position.copy(pos.clone().multiplyScalar(1.12));
    g.add(lbl);
    allMarkers.push({el:pin,lbl,data:d,cat:k,pos});
  });
});

// Build line features (rivers, railway, trade, passes) — thick tubes
['river','railway','w_river','trade','i_pass','w_pass','highway','i_range'].forEach(k=>{
  const items=D[k]||[];
  const g=layerGroups[k];
  const tubeRad=k==='railway'?0.01:k==='i_pass'||k==='w_pass'?0.012:0.014;
  const arrowRad=k==='railway'?0.008:k==='i_pass'||k==='w_pass'?0.007:0.01;
  const arrowLen=k==='railway'?0.018:k==='i_pass'||k==='w_pass'?0.016:0.022;
  items.forEach(d=>{
    if(!d.pts||d.pts.length<2)return;
    const pts=d.pts.map(p=>ll(p.la,p.ln,R*1.004));
    try{
      const curve=new THREE.CatmullRomCurve3(pts);
      const tubeGeo=new THREE.TubeGeometry(curve,Math.max(pts.length*4,24),tubeRad,5,false);
      const tubeMat=new THREE.MeshBasicMaterial({color:catColors[k],transparent:true,opacity:0.55});
      const tube=new THREE.Mesh(tubeGeo,tubeMat);
      tube.userData._origColor=catColors[k];
      tube.userData._origOpacity=0.55;
      d._tube=tube;
      g.add(tube);
    }catch(e){/* skip */}
    d._arrows=[];
    // Flow direction arrows
    const arrInt=Math.max(1,Math.floor(pts.length/3));
    for(let a=arrInt;a<pts.length-1;a+=arrInt){
      const from=pts[a-1],to=pts[a];
      if(from&&to){
        const dir=new THREE.Vector3().subVectors(to,from).normalize();
        const midPt=new THREE.Vector3().addVectors(from,to).multiplyScalar(0.5);
        const arrow=new THREE.Mesh(new THREE.ConeGeometry(arrowRad,arrowLen,4),new THREE.MeshBasicMaterial({color:catColors[k],transparent:true,opacity:0.4}));
        arrow.position.copy(midPt);
        const up=new THREE.Vector3(0,1,0);
        const q=new THREE.Quaternion().setFromUnitVectors(up,dir);
        arrow.quaternion.copy(q);
        arrow.userData._origColor=catColors[k];
        arrow.userData._origOpacity=0.4;
        d._arrows.push(arrow);
        g.add(arrow);
      }
    }
    // Label at mid
    const mid=pts[Math.floor(pts.length/2)];
    let lbl=null, lblPos=null;
    if(mid){
      lbl=mkLbl(d.n,catColors[k],0.16);
      lbl.position.copy(mid.clone().multiplyScalar(1.12));
      g.add(lbl);
      lblPos=mid;
    }
    // End pin
    const end=pts[pts.length-1];
    if(end){
      const pin=mkPin(catColors[k],0.005);
      pin.position.copy(end);g.add(pin);
      allMarkers.push({el:pin,lbl,data:d,cat:k,pos:lblPos||end});
    }
  });
});


// Build territory polygons (kingdoms)

['kingdom','w_kingdom'].forEach(k=>{
  const items=D[k]||[];
  const g=layerGroups[k];
  items.forEach(d=>{
    if(!d.pts||d.pts.length<3)return;
    const pts3=d.pts.map(p=>ll(p.la,p.ln,R*1.006));
    const cx=pts3.reduce((a,b)=>a.add(b),new THREE.Vector3()).divideScalar(pts3.length);
    const pos=[];[...Array(pts3.length)].forEach((_,i)=>{pos.push(cx.x,cx.y,cx.z,pts3[i].x,pts3[i].y,pts3[i].z,pts3[(i+1)%pts3.length].x,pts3[(i+1)%pts3.length].y,pts3[(i+1)%pts3.length].z)});
    const geo=new THREE.BufferGeometry();
    geo.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));
    const mat=new THREE.MeshBasicMaterial({color:catColors[k],transparent:true,opacity:0.18,depthWrite:false,side:THREE.DoubleSide,blending:THREE.AdditiveBlending});
    const mesh=new THREE.Mesh(geo,mat);g.add(mesh);
    // Capital pin & label
    const cp=ll(d.la,d.ln,R*1.008);
    const pin=mkPin(catColors[k],0.006);pin.position.copy(cp);g.add(pin);
    const lbl=mkLbl(d.n,catColors[k],0.08);lbl.position.copy(cp.clone().multiplyScalar(1.15));g.add(lbl);
    allMarkers.push({el:pin,lbl,data:d,cat:k,pos:cp,_eraHidden:false,_mesh:mesh});
  });
});


// Build latitude/longitude lines
(function buildLatLines(){
  const g=layerGroups.latitude;
  if(!g)return;
  const R2=R*1.003;
  function latCircle(lat,color,dash=false){
    const pts=[];
    const phi=lat*Math.PI/180;
    const steps=64;
    for(let i=0;i<=steps;i++){
      const theta=(i/steps)*2*Math.PI;
      const x=R2*Math.cos(phi)*Math.cos(theta);
      const y=R2*Math.sin(phi);
      const z=R2*Math.cos(phi)*Math.sin(theta);
      pts.push(new THREE.Vector3(x,y,z));
    }
    const bg=new THREE.BufferGeometry().setFromPoints(pts);
    const mat=new THREE.LineBasicMaterial({color,transparent:true,opacity:0.35});
    const line=new THREE.Line(bg,mat);
    g.add(line);
  }
  function lonHalfCircle(lon,color,dash=false){
    const pts=[];
    const lambda=lon*Math.PI/180;
    const steps=48;
    for(let i=0;i<=steps;i++){
      const phi=-Math.PI/2+(i/steps)*Math.PI;
      const x=R2*Math.cos(phi)*Math.cos(lambda);
      const y=R2*Math.sin(phi);
      const z=R2*Math.cos(phi)*Math.sin(lambda);
      pts.push(new THREE.Vector3(x,y,z));
    }
    const bg=new THREE.BufferGeometry().setFromPoints(pts);
    const mat=new THREE.LineBasicMaterial({color,transparent:true,opacity:dash?0.2:0.25});
    const line=new THREE.Line(bg,mat);
    g.add(line);
  }
  const majorLines=[
    {lat:0,color:'#ffffff',label:'Equator'},
    {lat:23.44,color:'#fbbf24',label:'Tropic of Cancer'},
    {lat:-23.44,color:'#fbbf24',label:'Tropic of Capricorn'},
    {lat:66.56,color:'#38bdf8',label:'Arctic Circle'},
    {lat:-66.56,color:'#38bdf8',label:'Antarctic Circle'},
  ];
  majorLines.forEach(l=>latCircle(l.lat,l.color));
  lonHalfCircle(0,'#ffffff');
  lonHalfCircle(180,'#ffffff');
})();


// Build ocean currents (thick tubes with warm/cold coloring)
(function buildCurrents(){
  const items=D.current||[];
  const g=layerGroups.current;
  if(!g||!items.length)return;
  items.forEach(d=>{
    if(!d.pts||d.pts.length<2)return;
    const isWarm=d.temp==='warm';
    const color=isWarm?'#ef4444':'#38bdf8';
    const radius=R*1.005;
    const pts=d.pts.map(p=>ll(p.la,p.ln,radius));
    // Use TubeGeometry for thick lines
    try{
      const curve=new THREE.CatmullRomCurve3(pts);
      const tubeGeo=new THREE.TubeGeometry(curve,Math.max(pts.length*4,32),0.022,7,false);
      const tubeMat=new THREE.MeshBasicMaterial({color,transparent:true,opacity:0.6});
      const tube=new THREE.Mesh(tubeGeo,tubeMat);
      tube.userData._origColor=color;
      tube.userData._origOpacity=0.6;
      d._tube=tube;
      g.add(tube);
    }catch(e){/* skip */}
    d._arrows=[];
    // Flow arrows (scaled to match tube thickness)
    const arrInt=Math.max(1,Math.floor(pts.length/2));
    for(let a=arrInt;a<pts.length-1;a+=arrInt){
      const from=pts[a-1],to=pts[a];
      if(from&&to){
        const dir=new THREE.Vector3().subVectors(to,from).normalize();
        const midPt=new THREE.Vector3().addVectors(from,to).multiplyScalar(0.5);
        const arrow=new THREE.Mesh(new THREE.ConeGeometry(0.014,0.035,4),new THREE.MeshBasicMaterial({color,transparent:true,opacity:0.55}));
        arrow.position.copy(midPt);
        const up=new THREE.Vector3(0,1,0);
        const q=new THREE.Quaternion().setFromUnitVectors(up,dir);
        arrow.quaternion.copy(q);
        arrow.userData._origColor=color;
        arrow.userData._origOpacity=0.55;
        d._arrows.push(arrow);
        g.add(arrow);
      }
    }
    // Label at mid, with pin + allMarkers registration for proper LOD/culling
    const mid=pts[Math.floor(pts.length/2)];
    let lbl=null, lblPos=null;
    if(mid){
      lbl=mkLbl(d.n,color,0.14);
      lbl.position.copy(mid.clone().multiplyScalar(1.12));
      g.add(lbl);
      lblPos=mid;
    }
    const end=pts[pts.length-1];
    if(end){
      const pin=mkPin(color,0.005);
      pin.position.copy(end);g.add(pin);
      allMarkers.push({el:pin,lbl,data:d,cat:'current',pos:lblPos||end});
    }
  });
})();


// Build El Niño / La Niña region overlay (equatorial Pacific warming/cooling band)
(function buildENSO(){
  const g=layerGroups.phenomena;
  if(!g)return;
  const r=R*1.006;
  // Region: 150°E to 80°W, 5°S to 5°N
  const lats=[-5,-3,0,3,5], lngs=[];
  for(let l=150;l>=-80;l-=8)lngs.push(l);
  const pos=[];
  for(let i=0;i<lats.length;i++)
    for(let j=0;j<lngs.length;j++){
      const p=ll(lats[i],lngs[j],r);
      pos.push(p.x,p.y,p.z);
    }
  const idx=[];
  for(let i=0;i<lats.length-1;i++)
    for(let j=0;j<lngs.length-1;j++){
      const a=i*lngs.length+j,b=a+1,c=(i+1)*lngs.length+j,d=c+1;
      idx.push(a,b,c,b,d,c);
    }
  const geo=new THREE.BufferGeometry();
  geo.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));
  geo.setIndex(idx);
  geo.computeVertexNormals();
  function ensoMat(col,op){
    return new THREE.MeshBasicMaterial({color:col,transparent:true,opacity:op,depthWrite:false,side:THREE.DoubleSide,blending:THREE.AdditiveBlending});
  }
  const elNino=new THREE.Mesh(geo,ensoMat('#ef4444',0.12));
  g.add(elNino);
  // La Niña region (slightly west, cooler blue)
  const lats2=[-5,-3,0,3,5], lngs2=[];
  for(let l=120;l>=-70;l-=8)lngs2.push(l);
  const pos2=[];
  for(let i=0;i<lats2.length;i++)
    for(let j=0;j<lngs2.length;j++){
      const p=ll(lats2[i],lngs2[j],r);
      pos2.push(p.x,p.y,p.z);
    }
  const idx2=[];
  for(let i=0;i<lats2.length-1;i++)
    for(let j=0;j<lngs2.length-1;j++){
      const a=i*lngs2.length+j,b=a+1,c=(i+1)*lngs2.length+j,d=c+1;
      idx2.push(a,b,c,b,d,c);
    }
  const geo2=new THREE.BufferGeometry();
  geo2.setAttribute('position',new THREE.Float32BufferAttribute(pos2,3));
  geo2.setIndex(idx2);
  geo2.computeVertexNormals();
  const laNina=new THREE.Mesh(geo2,ensoMat('#38bdf8',0.08));
  g.add(laNina);
  // Subtle outline for El Niño region
  const olPts=[], st=48;
  const addEdge=(la1,ln1,la2,ln2)=>{for(let i=0;i<=st;i++)olPts.push(ll(la1+(la2-la1)*i/st,ln1+(ln2-ln1)*i/st,r))};
  addEdge(5,150,5,-80); addEdge(5,-80,-5,-80);
  addEdge(-5,-80,-5,150); addEdge(-5,150,5,150);
  const olGeo=new THREE.BufferGeometry().setFromPoints(olPts);
  const olMat=new THREE.LineBasicMaterial({color:'#ef4444',transparent:true,opacity:0.25});
  g.add(new THREE.Line(olGeo,olMat));
})();


