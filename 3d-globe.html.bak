<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>UPSC Atlas — 3D Globe</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{overflow:hidden;background:#000;font-family:'Inter',system-ui,-apple-system,sans-serif;color:#fff}
canvas{display:block}

#topBar{
  position:fixed;top:14px;left:50%;transform:translateX(-50%);z-index:20;
  padding:6px 18px;border-radius:100px;
  background:rgba(0,0,0,.55);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  border:1px solid rgba(255,255,255,.06);
  display:flex;align-items:center;gap:10px;pointer-events:none;
  font-size:.78em;
}
#topBar .brand{font-weight:700;color:#fff}
#topBar .sep{color:rgba(255,255,255,.15)}
#topBar .info{color:rgba(255,255,255,.4)}

/* Layers panel */
#layersPanel{
  position:fixed;top:60px;left:14px;z-index:20;
  padding:10px 0;border-radius:14px;width:190px;max-height:calc(100vh - 160px);overflow-y:auto;
  background:rgba(0,0,0,.6);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);
  border:1px solid rgba(255,255,255,.06);
  scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.06) transparent;
  transition:transform .3s cubic-bezier(.22,1,.36,1),opacity .3s ease;
}
#layersPanel.collapsed{transform:translateX(-190px);opacity:0;pointer-events:none}
#layersPanel.collapsed + #layToggle{left:14px}
#layToggle{
  position:fixed;top:60px;left:210px;z-index:21;
  width:28px;height:28px;border-radius:0 8px 8px 0;border:none;
  background:rgba(0,0,0,.55);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  border:1px solid rgba(255,255,255,.06);
  color:rgba(255,255,255,.5);font-size:12px;cursor:pointer;font-family:inherit;
  display:flex;align-items:center;justify-content:center;
  transition:all .3s ease;
}
#layToggle:hover{background:rgba(255,255,255,.08);color:#fff}
#layToggle.open{left:14px}
#layToggle.open{left:14px}
#layersPanel::-webkit-scrollbar{width:3px}
#layersPanel::-webkit-scrollbar-thumb{background:rgba(255,255,255,.06);border-radius:3px}
.lay-section{padding:0 10px;margin-bottom:4px}
.lay-section:last-child{margin-bottom:0}
.lay-head{
  padding:5px 6px;border-radius:6px;cursor:pointer;
  display:flex;align-items:center;gap:6px;
  font-size:.7em;font-weight:600;text-transform:uppercase;letter-spacing:.04em;
  color:rgba(255,255,255,.6);transition:all .2s;
}
.lay-head:hover{background:rgba(255,255,255,.04);color:rgba(255,255,255,.85)}
.lay-head .arr{font-size:.6em;transition:transform .2s;margin-left:auto}
.lay-head .arr.open{transform:rotate(90deg)}
.lay-items{display:none;padding:2px 0 2px 18px}
.lay-items.open{display:block}
.lay-it{
  display:flex;align-items:center;gap:6px;padding:4px 6px;border-radius:5px;
  font-size:.68em;color:rgba(255,255,255,.5);cursor:pointer;transition:all .2s;
}
.lay-it:hover{background:rgba(255,255,255,.04);color:rgba(255,255,255,.8)}
.lay-it .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.lay-it .lbl{flex:1}
.lay-head .cnt{font-size:.62em;color:rgba(255,255,255,.2);margin-left:auto;padding-right:6px}

/* Detail panel */
#detail{
  position:fixed;bottom:auto;top:72px;right:16px;left:auto;z-index:18;
  padding:14px 18px;border-radius:16px;max-width:380px;width:340px;
  background:rgba(0,0,0,.75);-webkit-backdrop-filter:blur(24px);backdrop-filter:blur(24px);
  border:1px solid rgba(255,255,255,.06);
  opacity:0;pointer-events:none;transition:all .4s cubic-bezier(.22,1,.36,1);
  transform:translateY(-6px);max-height:60vh;overflow-y:auto;
}
#detail.show{opacity:1;pointer-events:auto;transform:translateY(0)}
#detail .d-badge{display:inline-block;padding:2px 10px;border-radius:100px;font-size:.6em;font-weight:600;text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px}
#detail .d-title{font-size:1em;font-weight:700;color:#fff;margin-bottom:1px}
#detail .d-sub{font-size:.72em;color:rgba(255,255,255,.4);margin-bottom:6px}
#detail .d-desc{font-size:.78em;color:rgba(255,255,255,.75);line-height:1.6;margin-bottom:4px}
#detail .d-fact{font-size:.72em;color:rgba(255,255,255,.5);line-height:1.5;padding:6px 10px;border-radius:6px;background:rgba(255,255,255,.04);margin-top:4px}
#detail .d-close{
  position:absolute;top:10px;right:12px;background:none;border:none;color:rgba(255,255,255,.3);
  font-size:16px;cursor:pointer;font-family:inherit;padding:4px
}
#detail .d-close:hover{color:#fff}

/* Bottom controls */
#bottomBar{
  position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:15;
  display:flex;gap:6px;align-items:center;
  padding:8px 16px;border-radius:100px;
  background:rgba(0,0,0,.5);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  border:1px solid rgba(255,255,255,.06);
}
#bottomBar button{
  width:34px;height:34px;border-radius:50%;border:1px solid transparent;
  background:transparent;color:rgba(255,255,255,.5);font-size:14px;cursor:pointer;
  transition:all .2s;font-family:inherit;display:flex;align-items:center;justify-content:center;
}
#bottomBar button:hover{background:rgba(255,255,255,.06);color:#fff}
#bottomBar .sep{width:1px;height:20px;background:rgba(255,255,255,.06)}
#searchInp{
  width:100px;padding:4px 10px;border-radius:100px;border:1px solid rgba(255,255,255,.08);
  background:rgba(255,255,255,.04);color:#fff;font-size:.7em;font-family:inherit;
  outline:none;transition:all .2s;
}
#searchInp:focus{border-color:rgba(167,139,250,.3);width:160px}
#searchInp::placeholder{color:rgba(255,255,255,.2)}

/* Era bar */
#eraBar{
  position:fixed;top:58px;left:50%;transform:translateX(-50%);z-index:19;
  display:flex;align-items:center;gap:8px;
  padding:6px 14px;border-radius:100px;
  background:rgba(0,0,0,.5);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  border:1px solid rgba(255,255,255,.06);
  white-space:nowrap;overflow-x:auto;scrollbar-width:none;max-width:92%;
}
#eraBar::-webkit-scrollbar{display:none}
#eraChips{display:flex;gap:4px}
.era-chip{
  padding:3px 10px;border-radius:100px;border:1px solid rgba(255,255,255,.08);
  font-size:.65em;cursor:pointer;color:rgba(255,255,255,.4);transition:all .2s;
  background:transparent;font-family:inherit;white-space:nowrap;
}
.era-chip:hover{border-color:rgba(255,255,255,.15);color:rgba(255,255,255,.7)}
.era-chip.active{background:rgba(167,139,250,.2);border-color:rgba(167,139,250,.3);color:#c084fc}

/* Contemporaries & era events */
.contemp-chip{
  display:inline-block;padding:2px 8px;border-radius:100px;
  font-size:.62em;color:rgba(255,255,255,.7);
  background:rgba(255,255,255,.06);margin:2px 0;cursor:default;
  border:1px solid rgba(255,255,255,.04);
}
.era-event-item{
  display:flex;align-items:center;gap:6px;padding:3px 6px;border-radius:4px;
  font-size:.68em;color:rgba(255,255,255,.5);margin:2px 0;cursor:pointer;
  transition:all .2s;
}
.era-event-item:hover{background:rgba(255,255,255,.04);color:rgba(255,255,255,.8)}
.era-event-item .e-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.era-event-item .e-year{color:rgba(255,255,255,.25);flex-shrink:0;min-width:32px}

/* Subtitle overlay */
#subtitle{
  position:fixed;bottom:120px;left:50%;transform:translateX(-50%);z-index:16;
  max-width:640px;width:90%;padding:10px 18px;border-radius:10px;
  background:rgba(0,0,0,.65);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);
  border:1px solid rgba(255,255,255,.06);
  color:rgba(255,255,255,.92);font-size:.85em;line-height:1.5;text-align:center;
  opacity:0;pointer-events:none;transition:opacity .35s ease;
}
#subtitle.show{opacity:1;pointer-events:none}

/* Timeline bar */
#tlBar{
  position:fixed;bottom:60px;left:50%;transform:translateX(-50%);z-index:17;
  width:92%;max-width:520px;border-radius:12px;
  background:rgba(0,0,0,.7);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);
  border:1px solid rgba(255,255,255,.08);
  opacity:0;pointer-events:none;transition:all .4s cubic-bezier(.22,1,.36,1);
  transform:translateX(-50%) translateY(20px);overflow:hidden;
}
#tlBar.show{opacity:1;pointer-events:auto;transform:translateX(-50%) translateY(0)}
#tlProgress{height:3px;background:#fb923c;width:0%;transition:width .5s ease;border-radius:2px}
#tlContent{display:flex;align-items:center;gap:10px;padding:10px 14px}
#tlStep{font-size:.6em;color:rgba(255,255,255,.35);white-space:nowrap;min-width:72px}
#tlLabel{flex:1;font-size:.78em;color:rgba(255,255,255,.8);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#tlControls{display:flex;gap:4px;flex-shrink:0}
#tlControls button{
  width:30px;height:30px;border-radius:50%;border:1px solid transparent;
  background:rgba(255,255,255,.06);color:rgba(255,255,255,.6);font-size:13px;cursor:pointer;
  transition:all .2s;font-family:inherit;display:flex;align-items:center;justify-content:center;
}
#tlControls button:hover{background:rgba(255,255,255,.12);color:#fff}
#tlPlayBtn{width:34px;height:34px}
#dTimeline{
  display:inline-flex;align-items:center;gap:6px;margin-top:8px;padding:6px 14px;border-radius:100px;
  border:1px solid rgba(251,146,60,.3);background:rgba(251,146,60,.1);
  color:#fb923c;font-size:.75em;font-weight:600;cursor:pointer;transition:all .2s;font-family:inherit;
}
#dTimeline:hover{background:rgba(251,146,60,.2);border-color:rgba(251,146,60,.5)}

/* Portrait overlay */
#portrait{
  position:fixed;right:14px;bottom:120px;z-index:20;
  opacity:0;pointer-events:none;transition:all .5s cubic-bezier(.22,1,.36,1);
  transform:translateY(10px);display:flex;flex-direction:column;align-items:center;gap:4px;
}
#portrait.show{opacity:1;pointer-events:none;transform:translateY(0)}
#portrait .p-frame{
  width:72px;height:72px;border-radius:50%;overflow:hidden;
  border:2px solid rgba(255,255,255,.12);
  background:rgba(0,0,0,.5);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  box-shadow:0 4px 24px rgba(0,0,0,.4),0 0 0 1px rgba(255,255,255,.04) inset;
  display:flex;align-items:center;justify-content:center;
}
#portrait img{width:100%;height:100%;object-fit:cover;display:block}
#portrait .p-name{
  font-size:.62em;color:rgba(255,255,255,.6);text-align:center;
  max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  padding:2px 8px;border-radius:100px;
  background:rgba(0,0,0,.4);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
}
#portrait .p-fallback{
  width:36px;height:36px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:20px;color:rgba(255,255,255,.3);
  background:rgba(255,255,255,.04);
}

/* Lecture mode */
#lectureBtn{background:linear-gradient(135deg,rgba(251,146,60,.2),rgba(236,72,153,.1));border-color:rgba(251,146,60,.3)!important;color:#fb923c!important;font-size:13px!important}
#lectureBtn:hover{background:linear-gradient(135deg,rgba(251,146,60,.3),rgba(236,72,153,.15))!important;border-color:rgba(251,146,60,.5)!important}
#lectureBtn.playing{background:linear-gradient(135deg,rgba(236,72,153,.3),rgba(59,130,246,.15))!important;border-color:rgba(236,72,153,.4)!important;color:#f472b6!important}

/* Chapter intro overlay */
#chapterIntro{
  position:fixed;inset:0;z-index:30;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  background:rgba(0,0,0,.85);-webkit-backdrop-filter:blur(30px);backdrop-filter:blur(30px);
  opacity:0;pointer-events:none;transition:opacity .8s ease;
  text-align:center;padding:40px;
}
#chapterIntro.show{opacity:1;pointer-events:auto}
#chapterIntro .ci-num{font-size:.75em;font-weight:600;color:rgba(251,146,60,.6);text-transform:uppercase;letter-spacing:.15em;margin-bottom:12px}
#chapterIntro .ci-title{font-size:2em;font-weight:700;color:#fff;margin-bottom:8px;line-height:1.2}
#chapterIntro .ci-era{font-size:.85em;color:rgba(255,255,255,.4);margin-bottom:16px}
#chapterIntro .ci-theme{font-size:1em;color:rgba(255,255,255,.6);max-width:500px;line-height:1.5;font-style:italic}
#chapterIntro .ci-start{padding:10px 28px;border-radius:100px;border:none;background:#fb923c;color:#000;font-weight:700;font-size:.85em;cursor:pointer;margin-top:20px;transition:all .2s;font-family:inherit}
#chapterIntro .ci-start:hover{background:#fc9f4a;transform:scale(1.05)}

/* Chapter outro */
#chapterOutro{
  position:fixed;inset:0;z-index:30;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  background:rgba(0,0,0,.85);-webkit-backdrop-filter:blur(30px);backdrop-filter:blur(30px);
  opacity:0;pointer-events:none;transition:opacity .8s ease;
  text-align:center;padding:40px;
}
#chapterOutro.show{opacity:1;pointer-events:auto}
#chapterOutro .co-label{font-size:.7em;font-weight:600;color:rgba(255,255,255,.3);text-transform:uppercase;letter-spacing:.12em;margin-bottom:8px}
#chapterOutro .co-title{font-size:1.2em;font-weight:600;color:rgba(255,255,255,.7);margin-bottom:4px}
#chapterOutro .co-sub{font-size:.85em;color:rgba(255,255,255,.4)}
#chapterOutro .co-next{padding:10px 28px;border-radius:100px;border:none;background:rgba(255,255,255,.1);color:#fff;font-weight:600;font-size:.85em;cursor:pointer;margin-top:20px;transition:all .2s;font-family:inherit}
#chapterOutro .co-next:hover{background:rgba(255,255,255,.18);transform:scale(1.05)}

/* Lecture panel (chapter selector) */
#lecturePanel{
  position:fixed;inset:0;z-index:25;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  background:rgba(0,0,0,.8);-webkit-backdrop-filter:blur(30px);backdrop-filter:blur(30px);
  opacity:0;pointer-events:none;transition:opacity .4s ease;
  padding:40px 20px;
}
#lecturePanel.show{opacity:1;pointer-events:auto}
#lecturePanel .lp-title{font-size:1.3em;font-weight:700;color:#fff;margin-bottom:4px}
#lecturePanel .lp-sub{font-size:.8em;color:rgba(255,255,255,.4);margin-bottom:24px}
#lecturePanel .lp-close{
  position:absolute;top:20px;right:20px;width:36px;height:36px;border-radius:50%;
  border:1px solid rgba(255,255,255,.08);background:rgba(0,0,0,.5);color:rgba(255,255,255,.5);
  font-size:16px;cursor:pointer;font-family:inherit;transition:all .2s;
  display:flex;align-items:center;justify-content:center;
}
#lecturePanel .lp-close:hover{color:#fff;background:rgba(255,255,255,.1)}
#lecturePanel .lp-chapters{display:flex;flex-direction:column;gap:6px;width:100%;max-width:380px;max-height:70vh;overflow-y:auto;padding:4px}
.lp-chap{
  display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:12px;
  border:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.02);
  cursor:pointer;transition:all .2s;text-align:left;font-family:inherit;color:#fff;width:100%;
}
.lp-chap:hover{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.1);transform:translateX(4px)}
.lp-chap .lc-num{font-size:.7em;font-weight:700;color:rgba(251,146,60,.5);min-width:28px}
.lp-chap .lc-name{font-size:.85em;font-weight:500;color:#fff}
.lp-chap .lc-era{font-size:.7em;color:rgba(255,255,255,.3);margin-left:auto}
.lp-chap .lc-count{font-size:.65em;color:rgba(255,255,255,.2);min-width:24px;text-align:right}

/* Lecture control bar (shown during lecture) */
#lectureBar{
  position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:17;
  display:flex;align-items:center;gap:8px;
  padding:6px 14px;border-radius:100px;
  background:rgba(0,0,0,.6);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  border:1px solid rgba(255,255,255,.08);
  opacity:0;pointer-events:none;transition:all .4s cubic-bezier(.22,1,.36,1);
  transform:translateX(-50%) translateY(20px);
}
#lectureBar.show{opacity:1;pointer-events:auto;transform:translateX(-50%) translateY(0)}
#lectureBar .lb-progress{font-size:.65em;color:rgba(255,255,255,.35);white-space:nowrap;min-width:40px;text-align:center}
#lectureBar .lb-chapter{font-size:.65em;font-weight:600;color:rgba(251,146,60,.6);white-space:nowrap}
#lectureBar .lb-title{font-size:.72em;color:rgba(255,255,255,.7);flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:200px;text-align:center}
#lectureBar button{
  width:28px;height:28px;border-radius:50%;border:1px solid transparent;
  background:rgba(255,255,255,.06);color:rgba(255,255,255,.5);font-size:12px;cursor:pointer;
  transition:all .2s;font-family:inherit;display:flex;align-items:center;justify-content:center;
}
#lectureBar button:hover{background:rgba(255,255,255,.12);color:#fff}
#lectureBar .lb-play{width:32px;height:32px;background:rgba(251,146,60,.15);color:#fb923c;font-size:13px}
#lectureBar .lb-play:hover{background:rgba(251,146,60,.25)}

/* Lecture bar mobile */
@media(max-width:640px){
  #lectureBar{padding:4px 10px;gap:4px}
  #lectureBar .lb-title{max-width:100px;font-size:.65em}
  #chapterIntro .ci-title{font-size:1.4em}
  #chapterIntro .ci-theme{font-size:.85em}
}

@media(max-width:640px){
  #layersPanel{width:160px;left:8px;top:52px;font-size:.9em;padding:6px 0}
  #layersPanel.collapsed{transform:translateX(-160px)}
  #layToggle{top:52px;left:174px;width:24px;height:24px;font-size:10px;border-radius:0 6px 6px 0}
  #layersPanel.collapsed + #layToggle{left:8px}
  #detail{bottom:80px;right:8px;left:auto;padding:14px 16px;max-width:96%;width:auto}
  #topBar{font-size:.7em;padding:4px 12px;top:8px}
  #eraBar{top:50px;padding:4px 10px;font-size:.9em}
  #bottomBar{padding:6px 10px;gap:4px}
  #searchInp{width:70px}
  #searchInp:focus{width:120px}
  #subtitle{bottom:80px;font-size:.78em;padding:8px 14px;max-width:94%}
  #portrait{right:8px;bottom:100px}
  #portrait .p-frame{width:56px;height:56px}
}
</style>
</head>
<body>



<div id="topBar">
  <span class="brand">UPSC Atlas</span>
  <span class="sep">·</span>
  <span class="info">Click any feature for details</span>
</div>

<div id="eraBar">
  <div style="display:flex;align-items:center;gap:6px">
    <span id="eraLabel" style="font-size:.65em;font-weight:600;color:rgba(255,255,255,.3);text-transform:uppercase;letter-spacing:.05em">All Eras</span>
    <span id="eraYears" style="font-size:.6em;color:rgba(255,255,255,.15)"></span>
    <span id="eraToggle" style="cursor:pointer;font-size:.55em;color:rgba(255,255,255,.2);padding:2px 4px" title="Toggle era bar">▼</span>
  </div>
  <div id="eraChips"></div>
</div>

<div id="layersPanel"></div>
<button id="layToggle" title="Toggle layers">◀</button>

<div id="detail">
  <button class="d-close" id="dClose">✕</button>
  <div class="d-badge" id="dBadge">Feature</div>
  <div class="d-title" id="dTitle"></div>
  <div class="d-sub" id="dSub"></div>
  <div class="d-desc" id="dDesc"></div>
  <div class="d-fact" id="dFact"></div>
  <div class="d-era" id="dEra" style="display:none;margin-top:8px;padding-top:8px;border-top:1px solid rgba(255,255,255,.06)">
    <div style="font-size:.7em;font-weight:600;color:rgba(255,255,255,.4);margin-bottom:4px">⏳ CONTEMPORARIES</div>
    <div id="dEraList" style="display:flex;flex-wrap:wrap;gap:4px"></div>
  </div>
  <div class="d-events" id="dEvents" style="display:none;margin-top:6px;padding-top:6px;border-top:1px solid rgba(255,255,255,.06)">
    <div style="font-size:.7em;font-weight:600;color:rgba(255,255,255,.4);margin-bottom:4px">📌 ERA EVENTS</div>
    <div id="dEventsList" style="max-height:120px;overflow-y:auto"></div>
  </div>
  <button id="dTimeline">▶ Play Timeline</button>
</div>

<div id="portrait">
  <div class="p-frame">
    <img id="pImg" alt="" style="display:none">
    <div class="p-fallback" style="display:flex">👤</div>
  </div>
  <div class="p-name" id="pName"></div>
</div>

<div id="tlBar">
  <div id="tlProgress"></div>
  <div id="tlContent">
    <span id="tlStep"></span>
    <span id="tlLabel"></span>
    <div id="tlControls">
      <button id="tlCloseBtn">✕</button>
      <button id="tlReplayBtn" title="Replay step">↺</button>
      <button id="tlPlayBtn">▶</button>
    </div>
  </div>
</div>

<div id="subtitle"></div>

<!-- Chapter intro overlay -->
<div id="chapterIntro">
  <div class="ci-num" id="ciNum"></div>
  <div class="ci-title" id="ciTitle"></div>
  <div class="ci-era" id="ciEra"></div>
  <div class="ci-theme" id="ciTheme"></div>
  <button class="ci-start" id="ciStart">▶ Begin Chapter</button>
</div>

<!-- Chapter outro overlay -->
<div id="chapterOutro">
  <div class="co-label">CHAPTER COMPLETE</div>
  <div class="co-title" id="coTitle"></div>
  <div class="co-sub" id="coSub"></div>
  <button class="co-next" id="coNext">▶ Next Chapter</button>
</div>

<!-- Lecture chapter selector panel -->
<div id="lecturePanel">
  <button class="lp-close" id="lpClose">✕</button>
  <div class="lp-title">🎓 Guided Lecture</div>
  <div class="lp-sub">Select a chapter to begin</div>
  <div class="lp-chapters" id="lpChapters"></div>
</div>

<!-- Lecture mode control bar -->
<div id="lectureBar">
  <span class="lb-chapter" id="lbChapter"></span>
  <span class="lb-progress" id="lbProgress"></span>
  <span class="lb-title" id="lbTitle"></span>
  <button id="lbPrev" title="Previous entry">⏮</button>
  <button class="lb-play" id="lbPlay" title="Play/Pause">▶</button>
  <button id="lbNext" title="Next entry">⏭</button>
  <button id="lbStop" title="Stop lecture">✕</button>
</div>

<div id="bottomBar">
  <input type="text" id="searchInp" placeholder="Search...">
  <div class="sep"></div>
  <button id="btnReset" title="Reset view">⟲</button>
  <button id="btnRotate" title="Toggle rotation">⏸</button>
  <button id="btnLayers" title="Toggle all layers">◉</button>
  <button id="lectureBtn" title="Guided lecture">🎓</button>
</div>

