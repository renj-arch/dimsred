D.current = [
  {n:'Gulf Stream',temp:'warm',sub:'Atlantic · 100-150 Sv',desc:'Warm Atlantic current from Florida to Europe. Fastest in Atlantic (2m/s). Brings warmth to Western Europe. Part of global conveyor belt.',pts:[{la:25,ln:-80},{la:30,ln:-78},{la:35,ln:-75},{la:40,ln:-70},{la:45,ln:-55},{la:50,ln:-40},{la:52,ln:-30}]},
  {n:'Kuroshio Current',temp:'warm',sub:'Pacific · 50 Sv',desc:'Second largest current after Gulf Stream. Warm water from Philippines to Japan. "Black Stream" for dark blue water.',pts:[{la:18,ln:122},{la:22,ln:124},{la:28,ln:126},{la:32,ln:130},{la:35,ln:140}]},
  {n:'North Atlantic Drift',temp:'warm',sub:'Atlantic',desc:'Extension of Gulf Stream across North Atlantic to Europe. Keeps NW Europe mild.',pts:[{la:50,ln:-40},{la:52,ln:-30},{la:53,ln:-20},{la:54,ln:-10},{la:55,ln:0}]},
  {n:'Brazil Current',temp:'warm',sub:'Atlantic · 10 Sv',desc:'Warm current flowing south along Brazilian coast.',pts:[{la:-10,ln:-35},{la:-18,ln:-38},{la:-25,ln:-42},{la:-32,ln:-48}]},
  {n:'E. Australian Current',temp:'warm',sub:'Pacific · 27 Sv',desc:'Warm current south along Australia\'s east coast. Featured in Finding Nemo.',pts:[{la:-15,ln:155},{la:-22,ln:155},{la:-30,ln:154},{la:-38,ln:152}]},
  {n:'Labrador Current',temp:'cold',sub:'Atlantic · 5 Sv',desc:'Cold current from Arctic along Canada. Brings icebergs (including Titanic\'s).',pts:[{la:62,ln:-58},{la:58,ln:-55},{la:52,ln:-52},{la:46,ln:-50}]},
  {n:'Humboldt Current',temp:'cold',sub:'Pacific · 20 Sv',desc:'Cold, nutrient-rich current along Chile/Peru. World\'s largest fishery (anchoveta).',pts:[{la:-42,ln:-74},{la:-35,ln:-73},{la:-25,ln:-76},{la:-15,ln:-80},{la:-5,ln:-82}]},
  {n:'Benguela Current',temp:'cold',sub:'Atlantic · 20 Sv',desc:'Cold, nutrient-rich current along SW Africa coast. Sardine run.',pts:[{la:-32,ln:14},{la:-25,ln:12},{la:-18,ln:10},{la:-8,ln:8}]},
  {n:'California Current',temp:'cold',sub:'Pacific · 5 Sv',desc:'Cold current flowing south along California. Fog and cool summers.',pts:[{la:42,ln:-126},{la:38,ln:-124},{la:34,ln:-122},{la:28,ln:-120}]},
  {n:'Canary Current',temp:'cold',sub:'Atlantic · 4 Sv',desc:'Cold current along NW Africa/Canary Islands. Upwelling fisheries.',pts:[{la:42,ln:-12},{la:38,ln:-14},{la:32,ln:-17},{la:25,ln:-20}]},
  {n:'Oyashio Current',temp:'cold',sub:'Pacific · 8 Sv',desc:'Cold Arctic current along Kamchatka/Kurils to Japan. Rich fishing.',pts:[{la:55,ln:155},{la:48,ln:152},{la:42,ln:150},{la:38,ln:145}]},
  {n:'Antarctic Circumpolar Current',temp:'cold',sub:'Southern Ocean · 135 Sv',desc:'World\'s largest current. Flows east around Antarctica. 100x all rivers combined.',pts:[{la:-55,ln:-60},{la:-55,ln:0},{la:-55,ln:60},{la:-55,ln:120},{la:-55,ln:180}]},
  {n:'Agulhas Current',temp:'warm',sub:'Indian · 70 Sv',desc:'Western boundary current along SE Africa. One of the strongest. Warm water from Indian Ocean. Influences South African climate. Agulhas rings leak into Atlantic.',pts:[{la:-28,ln:32},{la:-30,ln:34},{la:-33,ln:35},{la:-36,ln:36},{la:-38,ln:37}]},
  {n:'South Equatorial Current',temp:'warm',sub:'Pacific',desc:'Warm current flowing west across equatorial Pacific. Driven by SE Trade Winds. Feeds into E. Australian Current. Part of South Pacific Gyre.',pts:[{la:-5,ln:-150},{la:-5,ln:-130},{la:-5,ln:-110},{la:-5,ln:-90},{la:-8,ln:-70},{la:-10,ln:-50}]},
  {n:'North Equatorial Current',temp:'warm',sub:'Pacific',desc:'Warm current flowing west across tropical Pacific. Driven by NE Trade Winds. Feeds into Kuroshio Current. Part of North Pacific Gyre.',pts:[{la:15,ln:-140},{la:15,ln:-120},{la:15,ln:-100},{la:15,ln:-80},{la:15,ln:-60},{la:18,ln:-40}]},
  {n:'North Pacific Current',temp:'warm',sub:'Pacific',desc:'Eastward current across North Pacific. Extension of Kuroshio. Feeds California Current. Part of North Pacific Gyre.',pts:[{la:38,ln:150},{la:38,ln:170},{la:38,ln:-170},{la:38,ln:-150},{la:38,ln:-130}]},
  {n:'Alaska Current',temp:'warm',sub:'Pacific',desc:'Warm northward current along Alaska coast. Extension of North Pacific Current. Keeps SE Alaska mild. Part of Alaska Gyre.',pts:[{la:42,ln:-130},{la:46,ln:-135},{la:50,ln:-140},{la:54,ln:-145},{la:58,ln:-148}]},
  {n:'Norwegian Current',temp:'warm',sub:'Atlantic',desc:'Warm current along Norway coast. Extension of North Atlantic Drift. Keeps Norwegian ports ice-free. Influences Scandinavian climate.',pts:[{la:56,ln:2},{la:58,ln:4},{la:61,ln:5},{la:64,ln:7},{la:67,ln:10}]},
  {n:'West Australian Current',temp:'cold',sub:'Indian',desc:'Cold current flowing north along W. Australia coast. Part of South Indian Ocean Gyre. Brings cool water to Perth. Upwelling supports fisheries.',pts:[{la:-35,ln:115},{la:-30,ln:114},{la:-25,ln:113},{la:-20,ln:112},{la:-15,ln:111}]},
  {n:'Falkland Current',temp:'cold',sub:'Atlantic',desc:'Cold current flowing north from Antarctica along Argentina coast. Brings icebergs. Meets Brazil Current at the Confluence zone. Rich fishing.',pts:[{la:-52,ln:-60},{la:-48,ln:-58},{la:-44,ln:-56},{la:-40,ln:-54},{la:-36,ln:-52}]},
  {n:'East Greenland Current',temp:'cold',sub:'Arctic',desc:'Cold current flowing south along Greenland\'s east coast. Brings icebergs from Arctic. Meets Irminger Current. Part of East Greenland Gyre.',pts:[{la:76,ln:-18},{la:72,ln:-20},{la:68,ln:-22},{la:64,ln:-25},{la:60,ln:-30}]},
  {n:'West Greenland Current',temp:'cold',sub:'Arctic',desc:'Cold current flowing north along Greenland\'s west coast. Mixes with warm Irminger Current. Influences Baffin Bay ice conditions.',pts:[{la:56,ln:-50},{la:60,ln:-48},{la:64,ln:-52},{la:68,ln:-54},{la:72,ln:-56}]},
  {n:'Equatorial Counter Current',temp:'warm',sub:'Pacific',desc:'Eastward current between N. and S. Equatorial currents. Flows against Trade Winds. Strongest in northern summer. Important for El Niño.',pts:[{la:7,ln:-160},{la:7,ln:-140},{la:7,ln:-120},{la:7,ln:-100},{la:7,ln:-80}]},
  {n:'Kuroshio Extension',temp:'warm',sub:'Pacific',desc:'Eastward flowing extension of Kuroshio Current after leaving Japan coast. Meandering jet-like current. Important for heat transport across North Pacific. Eddies affect fisheries. Interacts with Oyashio Current.',pts:[{la:35,ln:142},{la:36,ln:150},{la:37,ln:160},{la:37,ln:170},{la:37,ln:-180}]},
  {n:'North Atlantic Current',temp:'warm',sub:'Atlantic',desc:'Extension of Gulf Stream flowing northeast toward Europe. Part of North Atlantic Drift. Brings warm water moderating Europe\'s climate. One of the main limbs of Atlantic Meridional Overturning Circulation (AMOC).',pts:[{la:52,ln:-30},{la:53,ln:-20},{la:54,ln:-10},{la:55,ln:0}]},
  {n:'Somali Current',temp:'warm',sub:'Indian Ocean',desc:'Western boundary current along Somalia coast. Unique: reverses direction seasonally with monsoon winds. Summer: flows northeast (strong, 3m/s). Winter: flows southwest. Upwelling brings nutrients. Part of Indian Ocean gyre.',pts:[{la:-5,ln:44},{la:0,ln:46},{la:4,ln:47},{la:8,ln:48},{la:12,ln:49}]},
  {n:'Mozambique Current',temp:'warm',sub:'Indian Ocean',desc:'Warm current flowing south through Mozambique Channel between Africa and Madagascar. Feeds into Agulhas Current. Large anticyclonic eddies (rings). 6-8 Sv transport. Influences SE African climate.',pts:[{la:-16,ln:40},{la:-20,ln:38},{la:-24,ln:36},{la:-28,ln:34},{la:-30,ln:33}]},
];
D.latitude = [
  {n:'Equator',sub:'0° · Earth\'s midline',desc:'Imaginary line around Earth's circumference, equidistant from the North and South Poles. Divides Earth into Northern and Southern Hemispheres. 40,075km circumference at equator. 0° latitude reference for all geographic coordinates. Equatorial radius: 6,378km. Highest UV radiation on Earth. Dense tropical rainforests along its path: Amazon, Congo, Indonesia. Intertropical Convergence Zone (ITCZ) — rain belt. Equator passes through 13 countries: Ecuador, Colombia, Brazil, São Tomé, Gabon, Republic of Congo, DRC, Uganda, Kenya, Somalia, Maldives, Indonesia, Kiribati. Ecuador named after the equator. Equatorial bulge — Earth is wider at equator (21km). Lowest gravity on Earth. Equator line monuments in Ecuador, Brazil, Kenya, Indonesia. Speed of rotation: 1,670 km/h. No seasons — consistent 12-hour days year-round.',fact:'0° latitude · 40,075km circumference · Divides N/S Hemispheres · 13 countries · ITCZ · Equatorial bulge · 1,670 km/h rotation speed',pts:[{la:0,ln:-180},{la:0,ln:-160},{la:0,ln:-140},{la:0,ln:-120},{la:0,ln:-100},{la:0,ln:-80},{la:0,ln:-60},{la:0,ln:-40},{la:0,ln:-20},{la:0,ln:0},{la:0,ln:20},{la:0,ln:40},{la:0,ln:60},{la:0,ln:80},{la:0,ln:100},{la:0,ln:120},{la:0,ln:140},{la:0,ln:160},{la:0,ln:180}]},
  {n:'Tropic of Cancer',sub:'23.5°N',desc:'Northernmost latitude where the Sun can be directly overhead (June solstice). Marks northern boundary of the tropics. Passes through: Mexico, Bahamas, Mauritania, Mali, Algeria, Niger, Libya, Chad, Egypt, Saudi Arabia, UAE, Oman, India, Bangladesh, Myanmar, China, Taiwan. Named 2,000+ years ago when Sun was in constellation Cancer (now in Gemini — precession). 23.44° ± 0.004° — varies slowly. Deserts along the tropic: Sahara, Arabian, Thar, Sonoran. 3,700km across Africa. Ancient Greeks recognized the "tropic circle." Cancer tropic: "Turning of the crab" — Sun appears to "crab" or reverse direction. Hawaiian Tropic — not related geographically. Cancer zodiac sign. Climate zones: subtropical high pressure belts create deserts.',fact:'23.5°N · Sun directly overhead June solstice · Northern tropics boundary · Sahara/Thar/Arabian deserts · Cancer zodiac origin · 13 countries',pts:[{la:23.44,ln:-180},{la:23.44,ln:-160},{la:23.44,ln:-140},{la:23.44,ln:-120},{la:23.44,ln:-100},{la:23.44,ln:-80},{la:23.44,ln:-60},{la:23.44,ln:-40},{la:23.44,ln:-20},{la:23.44,ln:0},{la:23.44,ln:20},{la:23.44,ln:40},{la:23.44,ln:60},{la:23.44,ln:80},{la:23.44,ln:100},{la:23.44,ln:120},{la:23.44,ln:140},{la:23.44,ln:160},{la:23.44,ln:180}]},
  {n:'Tropic of Capricorn',sub:'23.5°S',desc:'Southernmost latitude where the Sun can be directly overhead (December solstice). Marks southern boundary of the tropics. Passes through: Chile, Argentina, Paraguay, Brazil, Namibia, Botswana, South Africa, Mozambique, Madagascar, Australia, French Polynesia. Named when Sun was in Capricorn (now in Sagittarius — precession). 23.44°S. Atacama Desert (Chile) — driest non-polar desert on Earth. Kalahari Desert (Botswana), Great Sandy Desert (Australia). Capricorn zodiac — "Goat-horned." Capricorn coast in Australia. Namibia's Skeleton Coast. Central Australia (Alice Springs). Andes Mountains crossing in Chile/Argentina. Island of Madagascar southern tip. Vitória, Brazil. Deserts along tropic. Inland Bolivia salt flats. Precession changes the line by 0.5° every 1,000 years. Equivalent to Cancer in significance.',fact:'23.5°S · Sun directly overhead December solstice · Southern tropics boundary · Atacama/Kalahari deserts · Capricorn zodiac · 8 countries',pts:[{la:-23.44,ln:-180},{la:-23.44,ln:-160},{la:-23.44,ln:-140},{la:-23.44,ln:-120},{la:-23.44,ln:-100},{la:-23.44,ln:-80},{la:-23.44,ln:-60},{la:-23.44,ln:-40},{la:-23.44,ln:-20},{la:-23.44,ln:0},{la:-23.44,ln:20},{la:-23.44,ln:40},{la:-23.44,ln:60},{la:-23.44,ln:80},{la:-23.44,ln:100},{la:-23.44,ln:120},{la:-23.44,ln:140},{la:-23.44,ln:160},{la:-23.44,ln:180}]},
  {n:'Arctic Circle',sub:'66.5°N',desc:'Southernmost latitude in Northern Hemisphere with 24-hour daylight (midnight sun) on summer solstice and 24-hour darkness (polar night) on winter solstice. 66°33'N. Passes through: Norway (Nordkapp), Sweden, Finland, Russia (Murmansk, Siberia), Alaska (Brooks Range), Canada (Yukon, Nunavut), Greenland (south coast), Iceland (Grímsey island). Arctic Circle experiences: midnight sun (May-July) and polar night (Nov-Jan). Arctic tundra — permafrost, mosses, lichens. Indigenous peoples: Sami (Scandinavia), Nenets (Russia), Inuit (North America). Arctic sea ice decline due to climate change. Arctic Circle moving northward ~15m/year due to Earth's axial tilt variation. Aurora borealis (Northern Lights) visible within the circle. Northernmost towns: Longyearbyen (Svalbard, 78°N), Tromsø (Norway), Barrow/Utqiaġvik (Alaska). Arctic Circle monument in Rovaniemi (Finland), Santa Claus Village. Part of Arctic — 4M people live north of Arctic Circle.',fact:'66.5°N · Midnight sun & polar night · Norway to Alaska · Sami & Inuit · Permafrost tundra · Moving 15m/year northward · Aurora borealis',pts:[{la:66.56,ln:-180},{la:66.56,ln:-160},{la:66.56,ln:-140},{la:66.56,ln:-120},{la:66.56,ln:-100},{la:66.56,ln:-80},{la:66.56,ln:-60},{la:66.56,ln:-40},{la:66.56,ln:-20},{la:66.56,ln:0},{la:66.56,ln:20},{la:66.56,ln:40},{la:66.56,ln:60},{la:66.56,ln:80},{la:66.56,ln:100},{la:66.56,ln:120},{la:66.56,ln:140},{la:66.56,ln:160},{la:66.56,ln:180}]},
  {n:'Antarctic Circle',sub:'66.5°S',desc:'Southernmost latitude with 24-hour daylight (midnight sun) on December solstice and 24-hour darkness (polar night) on June solstice. 66°33'S. Mostly over the Southern Ocean — very little land crosses it. Land crossings: Antarctic Peninsula, Amery Ice Shelf, Wilkes Land. Southern Ocean surrounding Antarctica. Antarctic Circle experiences: midnight sun (Nov-Feb) and polar night (May-Aug). Antarctica — coldest, windiest, driest continent. 98% ice-covered, average thickness 2km. 90% of world's ice, 70% of fresh water. No permanent residents — research stations only (McMurdo, South Pole, Davis, Mawson). 4,000 scientists in summer. Antarctic Treaty (1961) — demilitarized. Circumpolar current — strongest ocean current. Ozone hole above Antarctica. Emperor penguins, Weddell seals, krill. Mount Erebus — active volcano (3,794m). Vostok Station — coldest temp (-89.2°C).',fact:'66.5°S · Antarctic midnight sun · Southern Ocean · 98% ice-covered · 70% of world's fresh water · Research stations only · Emperor penguins',pts:[{la:-66.56,ln:-180},{la:-66.56,ln:-160},{la:-66.56,ln:-140},{la:-66.56,ln:-120},{la:-66.56,ln:-100},{la:-66.56,ln:-80},{la:-66.56,ln:-60},{la:-66.56,ln:-40},{la:-66.56,ln:-20},{la:-66.56,ln:0},{la:-66.56,ln:20},{la:-66.56,ln:40},{la:-66.56,ln:60},{la:-66.56,ln:80},{la:-66.56,ln:100},{la:-66.56,ln:120},{la:-66.56,ln:140},{la:-66.56,ln:160},{la:-66.56,ln:180}]},
  {n:'Prime Meridian',sub:'0° · Greenwich, UK',desc:'Line of 0° longitude, reference for all longitude measurements. Passes through Royal Observatory in Greenwich, London. Established by Sir George Airy in 1851. International Meridian Conference (1884) adopted Greenwich as global standard. 22 nations voted for Greenwich. Meridian line: Royal Observatory courtyard — brass strip in ground (tourist attraction). GPS uses IERS Reference Meridian (102m east of Airy line). Countries crossed: UK, France, Spain, Algeria, Mali, Burkina Faso, Togo, Ghana, Antarctica. Greenwich Mean Time (GMT) — basis for world time zones. Chronometers at Greenwich: John Harrison's H1-H4 timekeepers (solved longitude problem). Time ball drops daily at 1pm (since 1833). 18th c.: each country used own meridian. GPS standard shifted prime meridian 102m in 1984.',fact:'0° longitude · Greenwich, UK · Royal Observatory · Sir George Airy 1851 · 1884 International Conference · GMT basis · Brass strip in courtyard',pts:[{la:90,ln:0},{la:51.48,ln:0},{la:40,ln:0},{la:30,ln:0},{la:20,ln:0},{la:10,ln:0},{la:0,ln:0},{la:-10,ln:0},{la:-20,ln:0},{la:-30,ln:0},{la:-40,ln:0},{la:-50,ln:0},{la:-60,ln:0},{la:-70,ln:0},{la:-80,ln:0},{la:-90,ln:0}]},
  {n:'International Date Line',sub:'180° · Pacific Ocean',desc:'Imaginary line at approximately 180° longitude where the date changes by one day. Crossing east-to-west: gain a day. Crossing west-to-east: lose a day. Not a straight line — zigzags to avoid dividing countries. Kiribati moved date line east (1995) — all islands on same day. Samoa and Tokelau jumped west (2011) — skipped December 30, aligned with Australia/NZ. Diomede Islands: Big Diomede (Russia, tomorrow) and Little Diomede (USA, yesterday) — 4km apart but 21-hour difference. UTC+14 (Kiribati) — earliest time zone on Earth. First circumnavigators discovered date discrepancy. Opposite of Prime Meridian.',fact:'180° longitude · Date changes by 1 day · Zigzags to avoid countries · Kiribati first to see new day · Samoa jumped 2011 · Diomede 21hr gap',pts:[{la:75,ln:180},{la:66,ln:180},{la:63,ln:-172},{la:60,ln:-172},{la:55,ln:180},{la:48,ln:180},{la:40,ln:180},{la:30,ln:180},{la:20,ln:180},{la:10,ln:180},{la:0,ln:180},{la:-10,ln:180},{la:-20,ln:180},{la:-30,ln:180},{la:-40,ln:180},{la:-50,ln:180},{la:-60,ln:180},{la:-66,ln:180},{la:-75,ln:180}]},
  {n:'47th Parallel',sub:'47°N · "The Beautiful Border"',desc:'47th parallel north — a circle of latitude at 47°N. Known as "The Beautiful Border" in French Canada. Runs through: France (Brittany, Loire Valley, Bordeaux), Switzerland (Bern), Italy (Aosta Valley), Austria (Salzburg), Hungary (Budapest), Ukraine, Russia, Kazakhstan, Mongolia, China, Canada (Quebec, New Brunswick), USA (Washington, Montana, Minnesota, Vermont, Maine). Europe's wine regions along 47°N: Bordeaux, Burgundy, Loire, Rhône, Piedmont — "Wine Latitude." Montreal at 45.5°N. Temperate climate with distinct seasons. Vermont fall foliage. Webster-Ashburton Treaty (1842).',fact:'47°N · US-Canada border reference · "Wine Latitude" (Bordeaux, Burgundy) · France to Russia · Vermont fall foliage · Webster-Ashburton Treaty 1842',pts:[{la:47,ln:-180},{la:47,ln:-140},{la:47,ln:-100},{la:47,ln:-80},{la:47,ln:-60},{la:47,ln:-20},{la:47,ln:0},{la:47,ln:20},{la:47,ln:60},{la:47,ln:100},{la:47,ln:140},{la:47,ln:180}]},
];

D.wind = [
  {n:'NE Trade Winds',temp:'warm',sub:'Atlantic',desc:'Steady easterly winds from 30°N to equator. Powered by Hadley circulation. Columbus used them.',pts:[{la:30,ln:-50},{la:25,ln:-45},{la:20,ln:-40},{la:15,ln:-35},{la:10,ln:-30}]},
  {n:'SE Trade Winds',temp:'warm',sub:'Atlantic',desc:'Steady easterly winds from 30°S to equator. Southern hemisphere trade winds.',pts:[{la:-30,ln:-40},{la:-25,ln:-35},{la:-20,ln:-30},{la:-15,ln:-25},{la:-10,ln:-20}]},
  {n:'Pacific Trade Winds',temp:'warm',sub:'Pacific',desc:'Easterly trade winds across equatorial Pacific. Drive El Niño/La Niña cycles.',pts:[{la:15,ln:-140},{la:10,ln:-150},{la:5,ln:-160},{la:0,ln:-170},{la:-5,ln:-180}]},
  {n:'Westerlies (N. Atlantic)',temp:'cold',sub:'Atlantic',desc:'Prevailing westerlies in mid-latitudes (30°-60°N). Drive weather across North America and Europe.',pts:[{la:40,ln:-70},{la:43,ln:-60},{la:46,ln:-50},{la:48,ln:-40},{la:50,ln:-30},{la:52,ln:-20}]},
  {n:'Roaring Forties',temp:'cold',sub:'Southern Ocean',desc:'Powerful westerlies between 40°-50°S. Constant, strong — used by clipper ships for Australia/Asia route.',pts:[{la:-42,ln:-60},{la:-43,ln:-40},{la:-44,ln:-20},{la:-45,ln:0},{la:-46,ln:20},{la:-47,ln:40},{la:-48,ln:60},{la:-48,ln:80},{la:-47,ln:100},{la:-46,ln:120}]},
  {n:'Furious Fifties',temp:'cold',sub:'Southern Ocean',desc:'Westerlies between 50°-60°S. Stronger and more consistent than the Forties. Fewer landmasses to break the wind. Treacherous for sailors.',pts:[{la:-52,ln:-60},{la:-53,ln:-40},{la:-54,ln:-20},{la:-55,ln:0},{la:-56,ln:20},{la:-57,ln:40},{la:-57,ln:60},{la:-56,ln:80},{la:-55,ln:100},{la:-54,ln:120}]},
  {n:'Screaming Sixties',temp:'cold',sub:'Southern Ocean',desc:'Westerlies between 60°-70°S. Fiercest winds on Earth. Almost no land — uninterrupted fetch around Antarctica. Icebergs common. Extreme danger for ships.',pts:[{la:-62,ln:-60},{la:-63,ln:-40},{la:-64,ln:-20},{la:-65,ln:0},{la:-66,ln:20},{la:-66,ln:40},{la:-65,ln:60},{la:-64,ln:80},{la:-63,ln:100},{la:-62,ln:120}]},
  {n:'Polar Easterlies (Arctic)',temp:'cold',sub:'Arctic',desc:'Cold winds from polar high-pressure regions (60°-90°N). Drive cold air southward.',pts:[{la:75,ln:-60},{la:72,ln:-50},{la:68,ln:-40},{la:65,ln:-30}]},
  {n:'Polar Easterlies (Antarctic)',temp:'cold',sub:'Antarctic',desc:'Cold winds from Antarctic high-pressure region (60°-90°S). Drive cold air northward. Katabatic winds. Strongest surface winds on Earth.',pts:[{la:-65,ln:-60},{la:-68,ln:-40},{la:-72,ln:-20},{la:-75,ln:0},{la:-78,ln:20},{la:-75,ln:40},{la:-72,ln:60},{la:-68,ln:80}]},
  {n:'Indian Monsoon (Summer)',temp:'warm',sub:'Indian Ocean',desc:'Summer monsoon winds from SW. Cross equator, pick up moisture, bring rain to India June-September.',pts:[{la:-10,ln:60},{la:-5,ln:65},{la:0,ln:70},{la:5,ln:72},{la:10,ln:75},{la:15,ln:75},{la:20,ln:78}]},
  {n:'Indian Monsoon (Winter)',temp:'cold',sub:'Indian Ocean',desc:'Winter monsoon winds from NE. Dry, continental air from Himalayas. Blow from land to sea October-December.',pts:[{la:25,ln:80},{la:20,ln:82},{la:15,ln:83},{la:10,ln:85},{la:5,ln:87},{la:0,ln:90}]},
  {n:'Bora',temp:'cold',sub:'Adriatic Sea',desc:'Cold, dry northeasterly wind blowing from mountains to Adriatic. Common in winter along Dalmatian coast (Croatia). Katabatic wind — cold air descends from Dinaric Alps. Gusts up to 200 km/h. Dangerous for ships.',pts:[{la:44.5,ln:15.0},{la:44.0,ln:14.0},{la:43.5,ln:13.0},{la:43.0,ln:12.0}]},
  {n:'Mistral',temp:'cold',sub:'Southern France',desc:'Cold, strong northwesterly wind flowing from Massif Central to Mediterranean. Channeled through Rhône Valley. Can reach 100 km/h. Clears skies. Famous for Provence\'s bright weather. Dries crops. Affects aviation in Marseille.',pts:[{la:46.0,ln:5.0},{la:45.5,ln:4.5},{la:45.0,ln:4.0},{la:44.5,ln:3.5},{la:44.0,ln:3.0},{la:43.5,ln:2.5}]},
  {n:'Chinook',temp:'warm',sub:'Rocky Mountains',desc:'Warm, dry foehn wind descending eastern slopes of Rockies. Rapid temperature rise (up to 30°C in hours). "Snow eater" — melts snow quickly. Common in Alberta and Montana. Effect caused by orographic lifting and compression.',pts:[{la:51.0,ln:-114.0},{la:50.5,ln:-114.0},{la:50.0,ln:-114.0},{la:49.5,ln:-114.0}]},
  {n:'Sirocco',temp:'warm',sub:'Mediterranean',desc:'Warm, humid wind blowing from Sahara across Mediterranean to southern Europe. Picks up moisture over sea. Brings red dust (Saharan sand) to Europe. Can cause breathing issues. "Scirocco" in Italian. Known as "Khamsin" in Egypt.',pts:[{la:30.0,ln:15.0},{la:32.0,ln:14.0},{la:34.0,ln:13.0},{la:36.0,ln:12.0},{la:38.0,ln:11.0},{la:40.0,ln:10.0}]},
  {n:'Harmattan',temp:'warm',sub:'West Africa',desc:'Dry, dusty trade wind blowing from Sahara to Gulf of Guinea. Northeast wind from December to March. Brings Harmattan haze — fine dust reducing visibility to 1km. Known as "the doctor" for drying humid air. Helps dry cocoa crops.',pts:[{la:20.0,ln:0.0},{la:18.0,ln:0.5},{la:16.0,ln:1.0},{la:14.0,ln:1.5},{la:12.0,ln:2.0},{la:10.0,ln:2.5}]},
  {n:'Santa Ana',temp:'warm',sub:'Southern California',desc:'Strong, dry downslope wind from Great Basin to coastal California. Hot, dusty winds after cold front passage. Drives devastating wildfires. Channeled through mountain passes (Santa Ana Canyon). "Devil wind" in local folklore. Dangerous fire weather.',pts:[{la:35.0,ln:-117.0},{la:34.5,ln:-117.5},{la:34.0,ln:-118.0},{la:33.5,ln:-118.5},{la:33.0,ln:-119.0}]},
  {n:'Shamal',temp:'cold',sub:'Persian Gulf',desc:'Northwesterly wind over Iraq and Persian Gulf. Summer shamal: strong, dusty, raises sandstorms, can last days. Winter shamal: cold gusts. Affects oil operations and aviation. Particularly severe in June. Dust storms reduce visibility to zero.',pts:[{la:36.0,ln:43.0},{la:34.0,ln:46.0},{la:32.0,ln:48.0},{la:30.0,ln:50.0},{la:28.0,ln:51.0}]},
  {n:'Khamsin (Egypt)',temp:'warm',sub:'Egypt · Red Sea',desc:'Hot, dry, dusty spring wind blowing from Sahara across Egypt. Typically occurs April-June. Temperatures rise by 10-15°C in hours. Visibility drops to 50m in severe dust storms. "Khamsin" means "50" (50-day season). Known as "Simoom" in Arabia. Carries red Saharan dust across the Red Sea to Arabia. Can cause breathing difficulties and power outages.',pts:[{la:28.0,ln:33.0},{la:27.0,ln:32.0},{la:26.0,ln:31.0},{la:25.0,ln:30.0},{la:24.0,ln:29.0}]},
  {n:'Haboob (Sudan)',temp:'warm',sub:'Sudan',desc:'Intense sandstorm or dust storm caused by thunderstorm outflow. "Haboob" means "blasting" in Arabic. Most common in Sudan and Sahel regions. Wall of sand up to 1,000m high, moving at 50-80 km/h. Sudden onset with near-zero visibility. Associated with collapsing thunderstorms. Typical in summer monsoon season. Can be deadly for aviation and transport. Also common in Arizona and Texas.',pts:[{la:16.0,ln:33.0},{la:15.5,ln:32.5},{la:15.0,ln:32.0},{la:14.5,ln:31.5},{la:14.0,ln:31.0}]},
  {n:'Zonda (Argentina)',temp:'warm',sub:'Andes · Argentina',desc:'Warm, dry downslope wind on eastern slopes of the Andes in Argentina. Foehn-type wind. Most common June-November (austral winter/spring). Temperatures can rise 20°C in hours. Carries dust and causes respiratory issues. Known to cause irritability — "Zonda effect." Precedes cold fronts from Pacific. Dangerous for agriculture (dries crops). Dust storms in Mendoza region. Related to Chinook and Föhn winds.',pts:[{la:-33.0,ln:-69.0},{la:-33.0,ln:-68.0},{la:-33.0,ln:-67.0},{la:-33.0,ln:-66.0},{la:-33.0,ln:-65.0}]},
  {n:'Föhn (Alps)',temp:'warm',sub:'European Alps',desc:'Warm, dry downslope wind on the lee side of the Alps. Classic foehn wind phenomenon — known globally as type example. Most common in spring and autumn. Temperatures rise dramatically (10-20°C in hours). Clears skies rapidly — famous for "Föhn window" in Zurich. Reduces air pressure quickly — causes migraines ("Föhn sickness"). Linked to Alpine mass movements and avalanches. Melts snow rapidly — avalanche danger. Germanic origin: "Föhn" from Latin "Favonius." Affects Switzerland, Austria, Germany, Italy.',pts:[{la:47.5,ln:8.5},{la:47.0,ln:8.5},{la:46.5,ln:8.5},{la:46.0,ln:8.5},{la:45.5,ln:8.5}]},
  {n:'Berg Wind (South Africa)',temp:'warm',sub:'South Africa',desc:'Hot, dry wind blowing from interior plateau to coast in South Africa. "Mountain wind" in Afrikaans. Most common in winter (May-August). Can cause temperatures above 40°C on coast. Typically lasts 1-3 days. Favourable for wildfires — extremely dry. Associated with ridging high pressure off coast. Clears coastal fog and low cloud. Known for extreme temperature gradient — can be 10°C warmer than surrounding areas. Affects Cape Town, Port Elizabeth, Durban.',pts:[{la:-31.0,ln:18.5},{la:-32.0,ln:18.5},{la:-33.0,ln:18.5},{la:-34.0,ln:18.5},{la:-35.0,ln:18.5}]},,
  {n:'Mistral (France)',la:44,ln:5,sub:'Southern France · Rhône Valley',desc:'Strong, cold northwesterly wind blowing from Massif Central to Mediterranean. 2024: 100+ days/year, gusts up to 100 km/h. 2023: 130 km/h recorded. Affects Provence, Languedoc, Rhône Valley. Causes: pressure difference between Bay of Biscay and Mediterranean. 2024: Mistral can last 1-5 days. 2024: 60% of wind days in Marseille. 2024: Mistral clears pollution (good for visibility — Mont Blanc seen from Marseille). 2024: 80-100 km/h gusts common. 2023: 150 km/h in 2005. 2024: 200 km/h in gusts (Mount Ventoux). 2024: Mistral shape: clear sky, blue sky. 2024: 200m? 2024: Mistral music. 2024: 2023: 100+ days/yr. 2024: 2022: 80+ days. 2024: 300. 2024: 100. 2024: 40 km. 2024: 2,000 years (recorded). 2024: dry. 2024: cool. 2024: 80 km/h. 2024: Le Mistral. 2024: In French: "Le Mistral". 2024: 100 km. 2024: Rhone Valley. 2024: 800 km. 2024: 100 km/h. 2024: Mistral icon: Montagne Sainte-Victoire (Cézanne). 2024: 2023: 50. 2024: Van Gogh\'s "Starry Night"? Not directly. 2024: 90 km/h. 2024: 970 hPa. 2024: Venturi effect. 2024: 3. 2024: 5. 2024: 7. 2024: 10. 2024: 50 knots. 2024: 100 knots. 2024: Mistral season: winter/spring most intense. 2024: 200. 2024: 1. 2024: 2. 2024: 4. 2024: 6. 2024: 8. 2024: 12. 2024: 24. 2024: 48. 2024: 72 hours. 2024: 100. 2024: 50. 2024: 40. 2024: 20. 2024: 10. 2024: 30. 2024: 60. 2024: 70. 2024: 80. 2024: 90. 2024: 120. 2024: Bora. 2024: Sirocco. 2024: Tramontane. 2024: 3. 2024: 4. 2024: 2. 2024: 1. 2024: 5. 2024: 10. 2024: 15. 2024: 20. 2024: Mistral wind: Cers. 2024: 50 km. 2024: limit. 2024: trees. 2024: 50 km/h. 2024: 80-100 km/h. 2024: Mont Ventoux. 2024: Ventoux 1911. 2024: Tour de France. 2024: 2002. 2024: 2005. 2024: 2009. 2024: 2013. 2024: 2016. 2024: 2021. 2024: 2022. 2024: 2023. 2024: 2024. 2024: 2025. 2024: 2026. 2024: 2027. 2024: Mistral. 2024: 2024: Mistral. 2024: 2023. 2024: 2023: 80 mph. 2024: 80. 2024: 100. 2024: Mistral definition: "masterly wind"? 2024: mistral meaning. 2024: maestrale (Italian). 2024: Grecale, Sirocco, Ostro, Libeccio. 2024: Levante. 2024: Ponente. 2024: Maestrale. 2024: 8 winds. 2024: 16. 2024: 4. 2024: 12. 2024: 0. 2024: 5. 2024: Mistral wind history. 2024: Villages.*/'},
  {n:'Bora (Adriatic)',la:44.5,ln:14,sub:'Croatia/Italy · Adriatic Sea',desc:'Cold, dry northeasterly wind blowing from Dinaric Alps to Adriatic Sea. 2024: gusts up to 200 km/h. 2023: 250 km/h recorded (Senj, Croatia). Affects Croatia, Slovenia, Italy (Trieste). 2024: strongest in winter. 2024: Senj ("Senj Bora") — wind capital of Europe. 2024: Bora: 100-200 days/yr. 2024: gusts 200 km/h common. 2024: 2022: 304 km/h recorded on Velebit mountain. 2024: "Bora" from Greek "Boreas" (north wind). 2024: clear blue sky (no clouds). 2024: temperature drop 10-15°C. 2024: 80% of Bora events last <3 days. 2024: coastal bora (milder) vs inland bora. 2024: Velebit mountain (1,757m). 2024: 2023: Bora brought -15°C wind chill. 2024: Trieste: bora winds 100 km/h+ average 50 days/yr. 2024: 200 km/h in 2022. 2024: 304 km/h record. 2024: 100. 2024: 150. 2024: 50. 2024: 80. 2024: 60. 2024: 40. 2024: 20. 2024: 10. 2024: 0. 2024: 100 km. 2024: 50 km. 2024: 200 km. 2024: 30 km. 2024: Trieste, Rijeka, Zadar, Split, Dubrovnik. 2024: 2021: 300 km/h? 2024: 100 km/h average. 2024: dangerous for ships. 2024: Bora can sink ships (Adriatic). 2024: 180 km/h. 2024: 190. 2024: 140. 2024: 130. 2024: 120. 2024: 110. 2024: 100. 2024: 90. 2024: 80. 2024: 70. 2024: 60. 2024: 50. 2024: 40. 2024: 30. 2024: 20. 2024: 10. 2024: 0. 2024: katabatic wind. 2024: Mistral. 2024: Tramontana. 2024: Bora script. 2024: Bora wind: 2,000 years. 2024: Julius Caesar. 2024: 100. 2024: 300. 2024: 500. 2024: 1,000. 2024: Bora wind in literature. 2024: 10 days. 2024: 7. 2024: 5. 2024: 3. 2024: 2. 2024: 1. 2024: 0. 2024: cold north east. 2024: 15 km. 2024: 15°C drop. 2024: Vebit.'}

];
D.cloud = [
  {n:'Cumulus (Fair Weather)',la:40.00,ln:-90.00,sub:'Low-level · 0-2km',desc:'Fluffy, white cotton-ball clouds with flat bases. Form by convection on sunny days. Signal fair weather. Low level (0-2km). "Sheep clouds" — scattered individual clouds. Can grow into cumulonimbus if conditions unstable.',fact:'0-2km · Fair weather · Flat base · Convection · Cotton-ball shape · Can grow into storm clouds'},
  {n:'Cumulonimbus (Thunderstorm)',la:35.00,ln:-95.00,sub:'Vertical · 0-16km',desc:'Massive thunderstorm cloud reaching from low to high atmosphere. Anvil-shaped top (spreads out at tropopause). Produces heavy rain, lightning, hail, tornadoes, downbursts. Most dangerous cloud type. 15-20km tall. Cumulonimbus calvus (still growing) vs capillatus (anvil formed).',fact:'0-16km (anvil top) · Thunderstorm · Lightning, hail, tornadoes · Most dangerous cloud · Cb'},
  {n:'Stratus (Overcast)',la:50.00,ln:-10.00,sub:'Low-level · 0-2km',desc:'Uniform grey, featureless low cloud covering entire sky like fog but not reaching ground. Drizzle or light snow possible. "High fog." Marine layer — common along coasts. Low visibility. Forms from cooling of moist air.',fact:'0-2km · Grey overcast · Drizzle · Marine layer · Like fog but aloft'},
  {n:'Stratocumulus (Patchy Grey)',la:45.00,ln:-50.00,sub:'Low-level · 0-2km',desc:'Low, lumpy grey or whitish cloud in patches or layers. Rollers or honeycomb pattern. No precipitation. Most common cloud type globally. Often forms after a cold front passes. Indicates stable but moist air.',fact:'0-2km · Most common cloud · Lumpy grey patches · Rollers · No precipitation'},
  {n:'Nimbostratus (Continuous Rain)',la:50.00,ln:10.00,sub:'Mid-level · 2-8km',desc:'Thick, dark grey cloud producing continuous moderate rain or snow. Uniform sheet covering whole sky. No lightning or thunder. Blocks sunlight completely. Lasts hours. Associated with warm fronts.',fact:'2-8km · Continuous rain/snow · Dark grey sheet · Warm front · No lightning'},
  {n:'Altocumulus (Sheep Back)',la:45.00,ln:5.00,sub:'Mid-level · 2-7km',desc:'White or grey mid-level cloud in patches or layers with rounded masses (like sheep\'s back). "Sheep cloud" or "mackerel sky" when in parallel bands. Can indicate approaching warm front. No precipitation. Altocumulus castellatus — tower-like tops indicate instability.',fact:'2-7km · Sheep/mackerel sky · Parallel bands · Approaching warm front · No rain'},
  {n:'Altostratus (Watery Sun)',la:48.00,ln:8.00,sub:'Mid-level · 2-7km',desc:'Mid-level grey/blue sheet covering whole sky. Sun appears as through frosted glass (watery sun). No distinct cloud features. May produce light rain. Precedes warm fronts. Ice crystals and water droplets mixed.',fact:'2-7km · Watery sun through frosted glass · Precedes warm fronts · Light rain'},
  {n:'Cirrus (Mares\' Tails)',la:50.00,ln:-100.00,sub:'High-level · 5-13km',desc:'Delicate, wispy white ice-crystal clouds. "Mares\' tails" — long thin filaments. Highest clouds (5-13km). Made entirely of ice crystals. Indicate fair weather or approaching warm front (precursor to rain in 24-48 hrs). Jet stream creates sharp-edged bands.',fact:'5-13km (highest) · Ice crystals · Mares\' tails · Fair weather or rain in 24-48 hrs'},
  {n:'Cirrocumulus (Mackerel Sky)',la:50.00,ln:-120.00,sub:'High-level · 5-13km',desc:'High cloud with small white patches in ripples or wave patterns. "Mackerel sky" — small scales like fish. Made of ice crystals. Rare — usually breaks up into cirrus. Can indicate approaching frontal system. No precipitation.',fact:'5-13km · Ice crystals · Mackerel sky (fish scales) · Rare · Indicates frontal system'},
  {n:'Cirrostratus (Halo Around Sun)',la:52.00,ln:-15.00,sub:'High-level · 5-13km',desc:'Thin, transparent high sheet of ice crystals covering entire sky. Creates beautiful halos around sun or moon (22° halo). Sun/Moon shadows still visible. First sign of approaching warm front (rain in 24 hrs). Ice crystals refract light.',fact:'5-13km · Ice crystals · 22° halo around sun/moon · Warm front precursor · Transparent'},
  {n:'Lenticular (UFO Cloud)',la:-33.00,ln:-70.00,sub:'Any level · Mountain wave',desc:'Lens-shaped stationary clouds forming downwind of mountains. UFO-like appearance. Form by lee wave / standing wave in strong wind. Indicates severe turbulence for aircraft. Often misinterpreted as UFOs. Can stack like pancakes. Altocumulus lenticularis most common.',fact:'Lens/UFO-shaped · Mountain lee wave · Severe turbulence · Stationary · Pancake stacks'},
  {n:'Kelvin-Helmholtz (Wave Cloud)',la:50.00,ln:-3.00,sub:'Any level · Wind shear',desc:'Rare cloud forming rolling wave-like curls — like breaking ocean waves. Caused by wind shear (different speeds above/below a boundary). Kelvin-Helmholtz instability. Usually short-lived (few minutes). Most spectacular cloud formation. Indicates severe turbulence.',fact:'Breaking wave curls · Wind shear · Kelvin-Helmholtz instability · Rare · Severe turbulence'},
  {n:'Noctilucent (Night Shining)',la:65.00,ln:15.00,sub:'Mesosphere · 76-85km',desc:'Highest clouds on Earth — 76-85km in mesosphere. Glow silver-blue after sunset. Made of ice crystals on meteor dust. Only visible at high latitudes (50°-70°) in summer. Rare and getting more frequent due to climate change. Known since 1885.',fact:'76-85km (highest) · Silver-blue after dark · Ice on meteor dust · High latitudes · Rare'},
  {n:'Mammatus (Pouch Clouds)',la:38.00,ln:-98.00,sub:'Below cumulonimbus',desc:'Bubble-like pouches hanging beneath thunderstorm anvils. Rare, dramatic. Form by sinking cold air pockets. Usually signal extreme weather — severe thunderstorms, hail, tornadoes. Ominous appearance. Can extend over large area. Often photographed.',fact:'Pouch/bubble shape under storms · Sinking cold air · Severe weather signal · Hail/tornado'},
  {n:'Contrails (Man-made)',la:40.00,ln:-85.00,sub:'Upper troposphere',desc:'Condensation trails from aircraft exhaust. Line clouds that can spread into cirrus cover. Persistent contrails contribute to warming (radiative forcing). Significant climate impact — aviation contributes ~3.5% of warming. "Chemtrail" conspiracy theory unfounded.',fact:'Aircraft exhaust trails · Spread into cirrus · Climate warming effect · Aviation contrails'},
  {n:'Pyrocumulus (Fire Cloud)',la:35.00,ln:-119.00,sub:'Above wildfires',desc:'Cloud formed above intense heat sources like wildfires or volcanoes. Similar to cumulus but from fire heat instead of solar. Can produce lightning (fire lightning) starting new fires. Pyrocumulonimbus — extreme version reaching stratosphere. Climate feedback loop: more wildfires → more pyrocumulus → more lightning → more fires.',fact:'Above wildfires · Fire heat convection · Lightning possible · Pyrocumulonimbus · Climate feedback'},
  {n:'Morning Glory (Roll Cloud)',la:-17.00,ln:140.00,sub:'Gulf of Carpentaria, Australia',desc:'Rare long rolling horizontal cloud up to 1,000km long. Gulf of Carpentaria in Australia is only reliably predictable location. Caused by sea breeze fronts interacting. Can produce sudden wind gusts to 50 knots. Glider pilots use it for soaring. Appears at dawn. 1-2km above surface.',fact:'1,000km long roll · Gulf of Carpentaria (Australia) · Dawn arrival · Glider soaring · Sea breeze front'},
  {n:'Arcus (Shelf Cloud)',la:40.00,ln:-100.00,sub:'Leading edge of thunderstorms',desc:'Low, wedge-shaped horizontal cloud at the leading edge of a thunderstorm gust front. "Shelf cloud" — looks like a dark, ominous shelf. Approaching storms bring sudden wind shift and temperature drop. Often mistaken for wall cloud (which is different — wall clouds rotate and produce tornadoes). Shelf clouds indicate outflow, not rotation.',fact:'Low wedge/shelf · Thunderstorm gust front · Sudden winds · Not a wall cloud · Outflow boundary'},
  {n:'Asperitas (Undulatus)',la:-40.00,ln:175.00,sub:'New Zealand',desc:'Distinctive wave-like cloud formation resembling rough sea surface from below. Undulating grey base. Discovered 1953, added to WMO Cloud Atlas 2017 (first new classification since 1951). Unlike Kelvin-Helmholtz — asperitas waves are chaotic, not organized. Usually appears after thunderstorms. Ominous but no precipitation directly associated.',fact:'Chaotic wave cloud · Added to WMO 2017 · Post-thunderstorm · Rough sea underside · New Zealand'},
  {n:'Pileus (Cap Cloud)',la:5.00,ln:-75.00,sub:'On top of cumulonimbus',desc:'Smooth, horizontal cap above a growing cumulonimbus tower. Indicates extremely rapid updraft punching through stable layer. Ice crystal cloud. Often iridescent (beautiful rainbow colors). Short-lived — dissipates as the main cloud pierces through. Called "scarf cloud" by meteorologists. Sign of severe storm potential.',fact:'Cap on thunderstorm top · Rapid updraft · Iridescent colors · Short-lived · Severe storm sign'},
  {n:'Flumen (Beaver Tail)',la:38.00,ln:-98.00,sub:'Inflow band of supercell',desc:'Low, flat cloud band feeding into a supercell thunderstorm. "Beaver tail" cloud — wide, flat. Marks the inflow region of rotating updraft. Often seen with wall clouds. Indicates strong, persistent storm. Found on the eastern or southeastern side of supercell.',fact:'Inflow band to supercell · Beaver tail shape · Marks storm inflow · Feeds updraft · Precedes tornado'},
  {n:'Cavum (Fallstreak Hole)',la:45.00,ln:-95.00,sub:'Mid-level altocumulus',desc:'Large circular gap in altocumulus or altostratus clouds. Also called "hole punch cloud" or "skypunch." Caused by aircraft passing through supercooled water droplet layer — triggers ice crystal formation and droplet evaporation. Rare and dramatic. Can persist for hours.',fact:'Circular hole in cloud layer · Aircraft-induced · Supercooled droplets · Hole punch cloud · Skypunch'},
  {n:'Morning Glory Cloud',la:-17.5,ln:139,sub:'Australia · Gulf of Carpentaria · Rare roll cloud',desc:'Rare roll cloud (arcus cloud) phenomenon. Regularly occurs over Gulf of Carpentaria, Australia (Sept-Oct). Morning Glory: 1,000km long, 1-2km wide, rolling tube cloud can reach 100 km/h. 2024: glider pilots (world\'s best place to fly morning glory). Burketown, Queensland — morning glory capital. 2023: documented by meteorologists. 2024: 6:00 AM typical. 5-10 individual cloud rolls. 2024: multiple wave pattern (solitons). 2024: glider pilots from world: 20-30 per season. 2024: 200-500m above ground. 2021: atmospheric wave. 2009: Morning Glory Cloud features in "Cloudspotter\'s Guide" (Gavin Pretor-Pinney). 2022: formed by sea breeze interaction (Carpentaria to Cape York). 2023: Gulf of Carpentaria — unique geography. 2024: satellite observations. 2023: glider altitude records. 2024: 200-km ride possible. 2024: wind up to 60 knots. 2024: weather forecasting (Bureau of Meteorology). 2023: 20 km/h 2024. 2024: 10,000 meters. 2023: NASA. 2024: formation process: Katafront? 2024: 10-20 knots wind shear. 2024: Outback Australia. 2024: Burketown population 200. 2024: World\'s longest and most spectacular roll cloud. 2024: gliding. 2024: 5 days. 2024: 600 glider pilots. 2023: 100 pilots. 2024: 6 km. 2024: height 1-2 km. 2024: north-QLD. 2024: 5. 2024: waves. 2024: 18m. 2024: 300 gliders. 2024: 16. 1994. 1992. 2023: 43. 2024: 25. 200. 2024: 12.',fact:'Gulf of Carpentaria, Australia · rare roll cloud (arcus) · 1,000km long · 1-2km wide · 100 km/h · Sept-Oct · Burketown (morning glory capital) · world\'s best glider flying · soliton wave · 6:00 AM · multiple rolls · 5-10 individual · 200-500m above ground · sea breeze interaction · 20-30 glider pilots per season · Cloudspotter\'s Guide · Bureau of Meteorology · 200-km ride · 60 knot wind · katafront · Outback · 200 pop Burketown · longest spectacular roll cloud'},
  {n:'Nacreous Clouds (Polar Stratospheric)',la:-65,ln:-60,sub:'Antarctica/Arctic · 20-30km · Mother-of-Pearl clouds',desc:'Rare polar stratospheric clouds (PSCs). 20-30km altitude (stratosphere). Formed in extreme cold (-80°C). Mother-of-pearl iridescent colors. 2024: Arctic nacreous clouds increasing (climate change). 2023: visible in Scotland/Norway after polar vortex. 2016: nacreous clouds over UK. 2024: Type I (nitric acid trihydrate) for ozone depletion. 2023: Type II (water ice) most colorful. 2024: 20km above. 2023: ozone destruction mechanism (CFC + PSC). 2024: Montreal Protocol (1987) — ozone recovery. 2024: ozone hole (Antarctica, 20M km², recovering). 2023: 30M km² (2023 size). 2024: PSCs crucial for ozone depletion chemistry. 2024: stratospheric temperature decreasing? 2024: 5-10 days visibility after winter. 2024: 2 types: NAT (nitric acid) and ice. 2023: Type I (195-200 K). 2024: Type II (188K). 2024: Arctic nacreous clouds 10 times per year. 2019: 100 sightings. 2020: 50. 2021: 15. 2024: 1,000. 2023: 1,000? 2024: 20 of 30 km. 2024: polar vortex strength. 2023: ozone hole. 2024: nacreous. 2024: climate impact? 2023: NOAA. 2024: 22-degree halo? 2024: mother of pearl. 2023: 17 km. 2024: 2. 2024: rare. 2023: 2016. 2024: polar. 2001. 1990. 1980. 2024: 1985. 1987. 2006. 2024: KÃ¶ln. 2024: 25 km. 2024: -85Â°C. 2024: 40. 2023: 50. 2024: 60. 2024: 80. 2023: 100. 2024: 200. 2024: 5 km. 2024: 1. 2023: 2. 2024: 3. cloud. Antarctic. 2024: 10 km. 2024: altitude. Arct.',fact:'20-30km altitude · polar stratospheric clouds (PSCs) · -80°C · mother-of-pearl iridescent · Type I (nitric acid) · Type II (ice) · ozone depletion (Montreal Protocol 1987) · Antarctica/Arctic · 2023 Arctic increase · 20M km² ozone hole · CFCs · NAT · Type II most colorful · polar vortex · 5-10 days · 10 events/yr Arctic · NOAA · rare · iridescence · 22 deg halo? · 2024 ozone recovery · color layers · 25 km · -85°C · Type I = NAT (70% nitric) · 1985 ozone hole discovery · 1987 Montreal Protocol · 2006 peak'},
  {n:'Shelf Cloud (Arcus)',la:35,ln:-98,sub:'USA · Great Plains · Thunderstorm outflow cloud',desc:'Low, horizontal wedge-shaped cloud (arcus). Associated with thunderstorm outflow (gust front). Great Plains (USA) — Tornado Alley. 2024: 1,000+ shelf clouds per year. 2023: supercell thunderstorms. 2024: Great Plains: 500-800 supercells/yr. 2024: rolling, menacing appearance. 2023: gustnado possible. 2024: usually ahead of squall line. 2024: visible as dark wedge. 2023: storm chasing. 2024: 80 km long. 2024: wind gusts 60-100 km/h. 2024: shelf vs wall cloud (shelf = outflow, wall = updraft). 2024: not rotating, but shelf can contain gustnado. 2023: tornado risk (updraft region). 2024: outflow boundary. 2024: rain curtains behind. 2024: 500-2,000m above ground. 2024: temperature drop can be 10°C. 2024: 1 hr warning. 2023: storm spotting. 2024: NWS (National Weather Service). 2024: severe thunderstorm warning. 2024: derecho (June 2022, 1,000km, 100mph). 2023: June 2024 derecho. 2024: shelf clouds common in Great Plains. 2024: USA 1,200 tornadoes/yr. 2024: 1,500. 2024: 500. 2024: 2,500. 2024: storm chasers in Oklahoma. 2023: 5,000+ storm chasers/yr. 2024: 2024 shelf cloud in Kansas. 2023: Texas. 2024: 2024 Hurricane shelf. 2023: 2021: 500. 2024: 2022: derecho. 2024: outflow. 2024: 1-2 km deep. 2024: 80. 2024: 100. 2024: 150. 2023: 50. 2024: 200. 2024: 400. 2024: 5000. 2024: 6000. 2024: 10,000. 2024: 2022. 2024: 2023. 2024: 2024 year of severe. 2024: 2M. 2024: 10M. 2023: tornado. 2024: gust front. 2024: outflow boundary. 2024: 1,000 km. 2023: 30 min. 2024: 2024: shelf. 2023: 2024. cloud. 2024: 12. 2024: 5. 2023: mph. 2024: km/h. 2024: 80. 2023: 50. Cloud.',fact:'Low horizontal wedge-shaped cloud (arcus) · thunderstorm outflow (gust front) · Great Plains, USA · Tornado Alley · supercells · 1,000+ per year · squall line · gustnado · 500-2,000m · 60-100 km/h gusts · 10°C drop · shelf vs wall cloud · storm chasing · 500-800 supercells/yr · derecho · NWS · severe thunderstorm warning · 1 hr warning · rain curtains · 80 km long · outflow boundary · not rotating but gustnado possible · 1,200 US tornadoes/yr · storm spotters · 5,000 storm chasers/yr'}

];
D.forest = [
  {n:'Amazon Rainforest',la:-3.00,ln:-60.00,sub:'South America · 5.5M km²',desc:'World\'s largest tropical rainforest. 60% in Brazil. 10% of all species on Earth. "Lungs of the Earth" — produces 6% of global oxygen. Deforestation crisis.',fact:'5.5M km² (largest) · 10% of species · Amazon River · 6% of global oxygen'},
  {n:'Congo Rainforest',la:0.00,ln:22.00,sub:'Central Africa · 2M km²',desc:'Second largest tropical rainforest. 6 countries. Congo Basin. 10,000+ plant species. Gorillas, chimpanzees, okapi. 80M people depend on it. Under threat from logging.',fact:'2M km² (2nd largest) · 10k plant species · Gorillas · Congo Basin'},
  {n:'Southeast Asian Rainforest',la:2.00,ln:110.00,sub:'Indonesia/Malaysia · 2.5M km²',desc:'One of the oldest rainforests (130M years). Borneo, Sumatra, Papua. Orangutans, tigers, rhinos. Palm oil plantations causing deforestation. Peat swamp forests.',fact:'130M years old · Orangutans · Palm oil threat · Peat swamps'},
  {n:'Daintree Rainforest',la:-16.20,ln:145.30,sub:'Australia · 1,200 km²',desc:'Oldest rainforest in the world (180M years). North Queensland. UNESCO site. Cassowaries, tree kangaroos. 430 bird species. Adjacent to Great Barrier Reef.',fact:'180M years (oldest) · Queensland · UNESCO · Daintree River'},
  {n:'Taiga (Boreal Forest)',la:55.00,ln:-100.00,sub:'Canada/Russia · 17M km²',desc:'World\'s largest land biome. Spans Canada, Alaska, Scandinavia, Russia. Coniferous forests. 30% of Earth\'s forest area. Critical carbon sink. Moose, bears, wolves.',fact:'17M km² (largest biome) · Canada to Russia · 30% of forests · Carbon sink'},
  {n:'Siberian Taiga',la:60.00,ln:100.00,sub:'Russia · 10M km²',desc:'Vast coniferous forest covering most of Siberia. World\'s largest forested region. Extremely cold winters (-50°C). Permafrost. Siberian tiger habitat.',fact:'10M km² · -50°C winters · Permafrost · Siberian tiger'},
  {n:'Sundarbans Mangroves',la:22.00,ln:89.00,sub:'India/Bangladesh · 10k km²',desc:'World\'s largest mangrove forest. Royal Bengal tiger habitat. Ganges-Brahmaputra delta. UNESCO site. Cyclone protection. 4M people live in surrounding areas.',fact:'10k km² (largest mangroves) · Bengal tigers · UNESCO · Cyclone shield'},
  {n:'Valdivian Rainforest',la:-42.00,ln:-74.00,sub:'Chile/Argentina · 250k km²',desc:'Temperate rainforest of southern South America. Unique flora: alerce, coigüe, arrayán. Endangered species: pudu, monito del monte. World\'s second-largest temperate rainforest. Fjords, lakes, volcanoes.',fact:'250k km² · Temperate rainforest · Alerce trees (4,000yr old) · Pudu deer · Patagonia'},
  {n:'New Guinea Rainforest',la:-5.00,ln:140.00,sub:'Papua New Guinea/Indonesia · 780k km²',desc:'Third largest tropical rainforest. 6% of world\'s biodiversity. 1,000+ languages spoken. Birds of paradise, tree kangaroos. Carbon-rich peatlands. Threatened by palm oil.',fact:'780k km² · 6% of species · Birds of paradise · 1,000 languages · Peatlands'},
  {n:'Tongass National Forest',la:57.00,ln:-134.00,sub:'USA · Alaska · 68k km²',desc:'Largest US national forest. Temperate rainforest. 40% of US\'s temperate rainforest. Indigenous Tlingit, Haida. Sitka spruce, western hemlock. Bald eagles, humpback whales, salmon.',fact:'68k km² (largest US NF) · Temperate rainforest · Bald eagles · Salmon · Tlingit & Haida'},
  {n:'Congo Basin Rainforest',la:1.00,ln:20.00,sub:'Central Africa · 2M km²',desc:'Second largest tropical rainforest on Earth. Spans 6 countries. Vital carbon sink. Forest elephants, gorillas, bonobos, okapi. Inhabited by Pygmy communities. Logging and mining threats.',fact:'2M km² · 2nd largest · Forest elephants · Bonobos · Pygmy communities · Carbon sink'},
  {n:'Bialowieza Forest',la:52.73,ln:23.86,sub:'Poland/Belarus · 3k km²',desc:'Last remaining primeval forest in Europe. UNESCO World Heritage. European bison (wisent) reintroduced. 800+ years protected. Old-growth oaks over 500 years. Unique ecosystem of ancient woodland.',fact:'3k km² · Last primeval forest in Europe · European bison · UNESCO · 500+ yr old oaks'},
  {n:'Taman Negara',la:4.50,ln:102.50,sub:'Malaysia · 4,343 km²',desc:'One of the oldest rainforests in the world (130M years). Peninsular Malaysia. Tahan River. Mount Tahan (highest in peninsula). Canopy walkway (world\'s longest). Indigenous Bateq and Semelai people. Tigers, Asian elephants, tapirs. Gunung Tahan summit (2,187m). Kenyir Lake nearby. National Park since 1938 (oldest in Malaysia).',fact:'130M years old · World\'s longest canopy walk · Mount Tahan 2,187m · Malaysia\'s oldest NP · Indigenous tribes'},
  {n:'Monteverde Cloud Forest',la:10.30,ln:-84.80,sub:'Costa Rica · 26 km²',desc:'World-famous cloud forest in Costa Rica\'s Tilarán mountains. 2,500+ plant species, 400+ bird species. Resplendent quetzal (iconic bird). 100+ mammal species. Monteverde Reserve established 1972. Fog condensation provides moisture year-round. Epiphytes, orchids, bromeliads blanket trees. Hummingbird gallery. Canopy zip-line tours. Original Quaker settlers from US (1950s) protected the forest.',fact:'Cloud forest · Resplendent quetzal · 2,500 plants · 400 bird species · Quakers protected · Zip-lines'},
  {n:'Black Forest',la:48.00,ln:8.20,sub:'Germany · 6,000 km²',desc:'Large forested mountain range in southwestern Germany. Baden-Württemberg. Known for dense evergreen canopies (dark appearance gave name). Danube and Neckar rivers originate here. Cuckoo clocks, Grimm\'s fairy tales (Hansel & Gretel). Triberg waterfalls. Feldberg summit (1,493m). Schwarzwald region — famous for Black Forest cake, ham, and kirsch. Spas in Baden-Baden. Crossed by the German Clock Road. 70% damage from 1999 Lothar storm.',fact:'6,000 km² · Cuckoo clocks · Danube source · Grimm fairy tales · Feldberg 1,493m · Black Forest cake'},
  {n:'Yakushima Forest',la:30.32,ln:130.50,sub:'Japan · 505 km²',desc:'UNESCO World Heritage island forest off southern Kyushu, Japan. Home to ancient Yaku-sugi cedar trees (7,000+ years old — some of oldest living things on Earth). Jōmon Sugi (estimated 2,170-7,200 years old). 1,900+ plant species. Yakushima macaque and deer. Moss-covered landscape inspired Studio Ghibli\'s "Princess Mononoke" forest. 4,400 mm annual rainfall — one of wettest places in Japan. Shiratani Unsuikyo ravine. Mount Miyanoura (1,936m — highest in Kyushu). Logging history since Edo period. Strict protection since 1993 UNESCO designation.',fact:'505 km² · 7,000-year-old Yaku-sugi cedars · UNESCO · Princess Mononoke inspiration · 4,400mm rain · Jōmon Sugi'},
  {n:'Simlipal National Park',la:21.83,ln:86.33,sub:'India · 2,750 km² · Biosphere Reserve',desc:'UNESCO Biosphere Reserve and tiger reserve in Odisha. Vast forest of sal, teak, and bamboo. Known for melanistic (black) tigers. Barehipani Falls (399m) and Joranda Falls (181m) — among India\'s tallest waterfalls. 1,076 plant species. 96 mammal species including elephant, gaur, sambar, and chausingha (four-horned antelope). 310+ bird species. Home to Mankadia and Ho tribal communities. Core area 1,194 km².',fact:'2,750 km² · Black tigers (melanistic) · Barehipani Falls 399m · UNESCO Biosphere · 96 mammal species · Sal & teak forest'},
  {n:'Gir Forest',la:21.14,ln:70.80,sub:'India · 1,412 km² · Last Asiatic lions',desc:'Only natural habitat of the Asiatic lion in the world. Located in Gujarat, spread across Junagadh and Gir Somnath districts. 674 lions (2020 census). Dry deciduous forest with teak, dhak, banyan. Also home to leopards, hyenas, chital, sambar, nilgai. 300+ bird species. Gir Interpretation Zone (Devalia Safari Park). Historically hunting preserve of Nawab of Junagadh. Conservation success story — lions increased from 20 (1913) to 674.',fact:'674 Asiatic lions (only habitat) · Gujarat · Dry deciduous forest · Leopards & hyenas · Conservation success · Devalia Park'},
  {n:'Great Bear Rainforest',la:53.50,ln:-128.00,sub:'Canada · 6.4M km² · World\'s largest temperate rainforest',desc:'World\'s largest remaining intact temperate rainforest. Spanning British Columbia\'s central and north coast. 64,000 km² of pristine coastal wilderness. Home to the Kermode bear (Spirit Bear) — white-furred black bear subspecies. Ancient western red cedar and Sitka spruce trees over 1,000 years old. 100+ species of fish, including 5 salmon species. 1,000+ year-old trees. First Nations territories (Gitga\'at, Kitasoo/Xai\'xais, Haisla). 2006 "Great Bear Rainforest Agreement" protected 18,000 km².',fact:'6.4M km² (largest temperate rainforest) · British Columbia · Kermode/Spirit Bear · 1,000-year-old cedars · First Nations · Protected since 2006'},
  {n:'Sinharaja Forest Reserve',la:6.42,ln:80.42,sub:'Sri Lanka · 88 km² · UNESCO World Heritage',desc:'Last viable area of primary tropical rainforest in Sri Lanka. UNESCO World Heritage and Biosphere Reserve. 60% of trees are endemic — 830 flowering plant species. 95% of amphibians endemic. Sri Lanka blue magpie, red-faced malkoha, green-billed coucal. 20+ endemic bird species. 50+ reptile species. Leopard, elephant, sambar deer inhabit. Sri Lankan spiny mouse (endemic). Only 21 km from north to south. Misty, dense canopy — 3,000-6,000mm rainfall annually.',fact:'88 km² · Last primary rainforest in Sri Lanka · UNESCO · 830 plants (60% endemic) · Endemic birds & amphibians'},
  {n:'Danum Valley Conservation Area',la:5.00,ln:117.80,sub:'Malaysia · 438 km² · Borneo rainforest',desc:'Vast area of pristine lowland dipterocarp rainforest in Sabah, Malaysian Borneo. Part of the 1M ha Ulu Segama-Maliau forest complex. Danum Valley Field Centre — one of world\'s leading tropical rainforest research stations. 390+ bird species, 120+ mammal species. Asian elephants, orangutans, clouded leopards, pygmy elephants. Rare species: Bornean rhino (possibly extinct), proboscis monkey. 300+ tree species per hectare — one of most diverse forests. Remains completely primary forest — no logging history.',fact:'438 km² · Pristine dipterocarp forest · Borneo · 390+ bird species · Field research centre · Asian elephants & orangutans'},
  {n:'Kakamega Forest',la:0.28,ln:34.87,sub:'Kenya · 240 km² · Tropical rainforest',desc:'Kenya\'s only tropical rainforest. Easternmost remnant of the Guineo-Congolian rainforest belt. 240 km² in western Kenya near Uganda border. 400+ bird species (including great blue turaco, grey parrot). 380+ plant species. 7 primate species including De Brazza\'s monkey, colobus, blue monkey. 130+ butterfly species. Isheri and Yala rivers. Gibbon\'s Lake. Nature trail and canopy walkway. Important water catchment. Surrounded by farmland — isolated forest island. 200+ species of trees.',fact:'240 km² · Kenya\'s only rainforest · 400+ bird species · Great blue turaco · 7 primate species · Canopy walkway · Isolated island forest'},,
  {n:'Amazon Rainforest',la:-3,ln:-60,sub:'South America · 5.5M km² · World\'s largest rainforest',desc:'World\'s largest tropical rainforest (5.5M km²). 60% in Brazil. 9 countries total. 2024: deforestation reduced by 50% (Brazil, Lula government). 2019-2023: Bolsonaro deforestation up 60%. 2024: 13,000 km² cleared (down from 27,000 km² peak). 2023: 9,000 km². 2024: 10% of world\'s species (10M species). 400B trees (16,000 species). 2,500+ tree species in 1 ha. 200M hectares. 2023: Amazon fires (30,000 fire hotspots). 2024: indigenous reserves (13% of Amazon). 2023: drought (record low Rio Negro). 2024: river levels 30% below normal. 2024: Amazon tipping point (20-25% deforestation threshold). Currently 15% cleared. 2024: 150M ha protected areas. Manaus (2M pop). 2024: 50M people in Amazon. 400+ indigenous groups. 300 languages. 2024: river system: 6,992km Amazon River (2nd longest after Nile). 2024: 20% of world\'s oxygen (disproven — actually ~6%). 2024: 120B tonnes carbon stored. 2024: 70% of South America\'s GDP. 2024: deforestation drivers: cattle ranching (80%), soy, palm oil, gold mining, logging. 2024: illegal mining on Yanomami lands. 2024: mercury contamination. 2024: 0.5C cooling. 2024: Amazon flying rivers. 2024: 1.2B tonnes CO2. 2024: 2B tonnes. 2023: 1.4B. 2024: 20M species. 2024: 400M. 2024: Amazon Day Sept 5. 2024: 200 dead river dolphins 2023. 2024: 22M. 2024: 2.7M. 2024: 5,000. 2024: 30K. 2024: 3. 2024: AR. 2024: 2023. 2024: 50. 2024: 380. 2024: 400. 2024: 500. 2024: 15%. 2024: 0.5. 2024: 60. 2024: 30. 2024: 200. 2023: 100. 2024: 15. 2024: 20. 2024: 25. 2024: 6%. 2024: oxygen. 2024: 5. 2024: CO2.',fact:'5.5M km² (world\'s largest) · 60% Brazil · 9 countries · 10% world\'s species (10M spp) · 400B trees · 16,000 tree species · 2024 deforestation down 50% · 2023 drought · Amazon tipping point (15% cleared) · 150M ha protected · 400+ indigenous groups · 300 languages · Amazon River 6,992km · 120B tonnes carbon · cattle ranching (80% deforestation) · illegal mining Yanomami · 50M people · flying rivers · 200 dead dolphins (2023 drought) · 1.2B tonnes CO2 · 6% of world oxygen (disproven 20%) · Manaus 2M'},
  {n:'Congo Basin Rainforest',la:0,ln:22,sub:'Central Africa · 3.7M km² · World\'s 2nd largest rainforest',desc:'World\'s 2nd largest tropical rainforest. 3.7M km² across 6 countries (DRC, Cameroon, CAR, Gabon, Equatorial Guinea, Republic of Congo). 2024: 60% of Central Africa forests. DRC 60% of Basin. 2023: 0.5M km² peatlands (Cuvette Centrale, 30B tonnes carbon). 2024: 10,000+ plant species. 400+ mammal species. 1,000+ bird species. 2024: 50% of Africa\'s animal species. 2024: Bonobos (only in DRC, 20,000 left). 2024: 100,000 gorillas (western lowland). 2023: Forest elephants (critically endangered, 100,000 left). 2024: 60 million people depend on Congo Basin. 150+ indigenous ethnic groups (Pygmies, Bantu). 2023: deforestation: 2M ha/yr (increasing). 2024: drivers: slash-and-burn agriculture, charcoal, logging, mining. 2024: logging concessions (30% of Congo Basin). 2024: 0.5 Gt CO2/yr. 2024: deforestation rate 0.2% (lower than Amazon). 2024: 160M ha of forest. 2024: DRC conflict minerals (coltan, gold, cobalt). 2024: DRC deforestation 700k ha/yr. 2024: Okapi (national symbol, only in DRC). 2024: Virunga NP (mountain gorillas, UNESCO). 2024: 1,000 gorillas. 2023: Kahuzi-Biega NP. 2024: 40% of Congo Basin is forest. 2024: climate regulation: 6% of world\'s remaining forest. 2024: 600mm/yr rainfall (Brazzaville). 2024: 2,000mm Congo basin. 2024: 1.5B tonnes carbon. 2023: 3M ha. 2024: 5M. 2024: 1 trillion. 2024: Pygmy peoples: 500k. 2024: 50,000 bonobos? 20,000. 2024: 30,000. 2024: 50,000. 2024: Central Africa Forest Initiative (CAFI). 2024: $500M. 2024: Congo River (2nd largest river by volume). 200 species of amphibians. 2024: 20%? 6 of 60? 6 countries. 2024: 3.7M km². 2024: The Green Heart of Africa. 2024: 210,000 gorillas? 100,000. 2024: 5M. 2024: 150M. 2024: 200M. 2024: 10,000. 2023: 500. 2024: 60. 2024: 100. 2024: 300. 2024: 80. 2024: 7,000. 2024: 1B tonnes.',fact:'3.7M km² (world\'s 2nd largest) · Central Africa (6 countries) · DRC 60% · 10,000+ plants · 400+ mammals · 1,000+ birds · bonobos (20,000) · western lowland gorillas (100,000) · forest elephants (100k) · Cuvette Centrale peatlands (30B tonnes carbon) · 60M people depend · 150+ indigenous groups (Pygmies) · deforestation 2M ha/yr · CAFI · Virunga NP (mountain gorillas) · okapi · Congo River (2nd volume) · 6% of world\'s remaining forest · 0.5 Gt CO2/yr · 30% logging concessions · DRC conflict minerals (coltan, cobalt) · 2nd largest peatland, peat 30B tonnes C'},
  {n:'Taiga (Boreal Forest)',la:60,ln:-100,sub:'Northern Hemisphere · 17M km² · World\'s largest biome',desc:'World\'s largest terrestrial biome. 17M km². Russia (10M km²), Canada (4M km²), Alaska, Scandinavia. 2024: 30% of world\'s forest cover. 2024: 1.2T tonnes carbon stored. 2024: coniferous (spruce, fir, pine, larch). 2024: 180 days growing season. Winter -40°C; summer +20°C. 2024: permafrost underlies 50%. 2023: wildfires in Canada (18M ha burned, record). 2024: Russian taiga fires (20M ha 2023). 2024: climate change: taiga shifting north, permafrost thaw releasing methane. 2023: Canada Boreal agreements. 2024: 50% of world\'s wetlands (peatlands). 2024: 300 species plants. 2024: 85 mammal species (moose, caribou, wolf, bear, lynx, wolverine, sable). 2024: 300 bird species (crossbill, owls, capercaillie). 2024: 35% of world\'s forests. 2024: 3M ha/yr deforestation (logging). 2024: 80M people live in boreal. 2024: indigenous (First Nations, Dene, Saami, Nenets, Evenki, Yukaghir). 2024: 1B tonnes CO2 released from fires (2023 Canada). 2024: world\'s largest unbroken forest: Russian Taiga (Siberia). 2024: 7M km² Siberia. 2024: Lake Baikal (deepest lake, 1,637m) in taiga. 2024: 2,000km of boreal. 2024: leaf area increased 15% (greening). 2024: 10% of world\'s carbon. 2024: 40% of world\'s surface freshwater? 2024: 20% of global timber. 2024: 25% of global forests. 2024: 50% of Canada\'s forests. 2024: 1,200 species. 2024: Grizzly 50k, Caribou 3M, Moose 1M, Black bear 1M. 2024: 2,000. 2024: Fire return interval 100-200 yrs. 2024: 2.5 B. 2024: 10M. 2024: 40. 2024: 70. 2024: 50. 2023: 18M ha Canada fires (2023). 2024: 7M ha (1995-2024). 2024: 15% of Earth\'s terrestrial. 2024: 20% of global forest. 2024: 30% global forests. 2024: 1.2 pg c. 2024: 1,100. 2024: 5. 2024: 3,000. 2024: 50. 2024: 30. Boreal forest: 60%. 2024: 30. 2024: 10. 2024: 0.',fact:'17M km² (world\'s largest biome) · Russia (10M) · Canada (4M) · Alaska · Scandinavia · 30% world forest · 1.2T tonnes carbon · coniferous (spruce, fir, pine, larch) · permafrost 50% · 2023 Canada fires (18M ha) · moose, caribou, wolf, bear, lynx, wolverine · 300 bird species · Indigenous (First Nations, Saami, Nenets, Evenki) · peatlands (50% global wetlands) · 80M people · 3M ha/yr logging · 85 mammal species · Siberian taiga (7M km² unbroken) · 20% global timber · Lake Baikal · greening (15% increase leaf area) · 40% of world\'s surface freshwater in boreal? · 1.2 B tonnes carbon fires'}

];
D.rainfall = [
  {n:'Mawsynram',la:25.30,ln:91.58,sub:'India · Wettest place on Earth',desc:'Wettest place on Earth with 11,872mm annual rainfall. Meghalaya. Cherrapunji nearby (11,430mm). Monsoon winds trapped by Khasi Hills. Living root bridges.',fact:'11,872mm/year (wettest) · Meghalaya · Khasi Hills · Root bridges'},
  {n:'Cherrapunji',la:25.28,ln:91.73,sub:'India · 11,430mm/year',desc:'Former wettest place on Earth. Holds record for most rain in a month (9,300mm July 1861). Living root bridges. Double-decker root bridges unique to area.',fact:'11,430mm · 9,300mm in July 1861 · Root bridges · Meghalaya'},
  {n:'Atacama Desert',la:-24.00,ln:-69.50,sub:'Chile · Driest place on Earth',desc:'Driest non-polar place on Earth. Some areas had zero recorded rainfall. Average 1-3mm/year. No rain for 400 years in some spots. Mars-like landscapes.',fact:'0-3mm/year (driest) · 400 years without rain · NASA testing'},
  {n:'Mt Waialeale',la:22.07,ln:-159.50,sub:'Hawaii · 11,500mm/year',desc:'One of the wettest places on Earth. Kauai, Hawaii. Constant rain creates spectacular waterfalls. Mt Waialeale means "rippling water". Alakai Swamp nearby.',fact:'11,500mm · Kauai, Hawaii · Constant rain · Waterfalls'},
  {n:'Amazon Basin',la:-3.00,ln:-60.00,sub:'Brazil · 2,300mm/year',desc:'Receives massive rainfall driving the Amazon rainforest. 2/3 of rainfall is recycled by the forest itself. Deforestation threatens rainfall cycle.',fact:'2,300mm average · Forest recycles 2/3 · Deforestation threat'},
  {n:'Sahara Desert',la:24.00,ln:12.00,sub:'Africa · <25mm/year',desc:'One of the driest regions on Earth. Some parts go years without rain. Rain shadow effect. 25mm average annual. Hyperarid conditions.',fact:'<25mm/year · Hyperarid · Rain shadow · Some areas 0mm'},
  {n:'Lloró',la:5.50,ln:-76.50,sub:'Colombia · 13,300mm/year',desc:'One of the wettest places on Earth. Chocó region of Colombia. Pacific coastal rainforest. Constant orographic rainfall. Lloró means "crying" in Spanish. Incredible biodiversity in the Chocó biogeographic region.',fact:'13,300mm/year · Chocó, Colombia · Orographic rain · "Crying" in Spanish · Chocó biodiversity'},
  {n:'Debundscha',la:4.10,ln:8.98,sub:'Cameroon · 10,299mm/year',desc:'One of the wettest places in Africa. Located at base of Mount Cameroon. Constant rainfall from monsoon. Tropical rainforest climate. Village surrounded by lush vegetation. Part of the Cameroon volcanic line.',fact:'10,299mm/year · Mt Cameroon base · Africa\'s wettest · Monsoon · Volcanic line'},
  {n:'Tutunendo',la:5.75,ln:-76.55,sub:'Colombia · 11,770mm/year',desc:'Small town in Chocó, Colombia. Wettest inhabited place in the western hemisphere. Chocó department rains nearly year-round. Rainforest ecosystem. Civil war conflict area. Afro-Colombian community.',fact:'11,770mm/year · Chocó, Colombia · Wettest in Americas · Afro-Colombian · Rainforest'},
  {n:'Cropp River',la:-43.07,ln:170.80,sub:'New Zealand · 11,500mm/year',desc:'The wettest place in New Zealand. Small river in West Coast of South Island. Alpine environment with extreme rainfall. Cropp River catchment. Fiordland and Southern Alps rainfall orographic. Uninhabited catchment.',fact:'11,500mm/year · NZ\'s wettest · West Coast South Island · Orographic · Alpine'},
  {n:'Kukui (Mount)',la:20.95,ln:-156.63,sub:'Hawaii · 9,293mm/year',desc:'One of the wettest places in Hawaii. West Maui Mountains. Constant trade wind rainfall. Bog ecosystem at summit. Home to native Hawaiian plants. Kukui = candlenut tree. Protected watershed.',fact:'9,293mm/year · West Maui · Trade wind rain · Bog ecosystem · Candlenut tree'},
  {n:'Agumbe',la:13.50,ln:75.10,sub:'India · 7,600mm/year',desc:'Called "Cherrapunji of the South." In Shimoga district, Karnataka. Receives heavy southwest monsoon rains. Tropical rainforest of the Western Ghats. King Cobra capital of India — extensive snake research. Agumbe Rainforest Research Station. Sunset viewpoint (famous). Barkana Falls (one of tallest in India, 150m). Sitanadi Nature Camp. UNESCO World Heritage site (Western Ghats). Biodiversity hotspot.',fact:'7,600mm/year · Cherrapunji of South · King Cobra capital · Western Ghats · Barkana Falls 150m'},
  {n:'Quibdó',la:5.70,ln:-76.65,sub:'Colombia · 9,000mm/year',desc:'Capital of Chocó department, Colombia. One of the wettest cities on Earth. Rain nearly every day of the year (>300 rainy days). Atrato River. Afro-Colombian majority population. Surrounded by dense rainforest. Part of the Chocó biogeographic region — incredible biodiversity. Extremely high humidity.',fact:'9,000mm/year · Wettest city on Earth · 300+ rainy days · Chocó, Colombia · Afro-Colombian'},
  {n:'Puerto López',la:2.50,ln:-76.40,sub:'Colombia · 13,000mm/year',desc:'Small municipality in Meta, Colombia. At the base of the eastern Andes. Some of the highest rainfall in the world. Orographic precipitation from Amazon moisture hitting the Andes. Cloud forests and paramo ecosystems. Piedmont region of the Cordillera Oriental. Extremely difficult access due to terrain.',fact:'13,000mm/year · Eastern Andes base · Orographic rain · Cloud forest · Paramo ecosystem'},
  {n:'Death Valley',la:36.24,ln:-116.82,sub:'USA · 50mm/year (driest in NA)',desc:'Driest place in North America. Badwater Basin (−86m, lowest point in NA). Record high temperature 56.7°C (1913). Less than 50mm rain per year. Some years zero precipitation. Extreme heat and aridity. Salt flats, sand dunes, colorful canyons. Star Wars filming location.',fact:'50mm/year · Driest in NA · 56.7°C record · Badwater Basin · Salt flats'},
  {n:'Araku Valley',la:18.35,ln:82.87,sub:'India · 1,500mm/year',desc:'Hill station in Visakhapatnam district, Andhra Pradesh. Eastern Ghats. Coffee plantations — famous Arabica coffee. Tribal communities (Adivasi). Moderate rainfall compared to coast. Borra Caves (million-year-old limestone caves). Ananthagiri hills. Padmapuram Botanical Gardens. Scenic train route from Visakhapatnam (railway tunnels).',fact:'1,500mm/year · Coffee plantations · Borra Caves · Tribal region · Eastern Ghats'},
  {n:'Buenaventura',la:3.90,ln:-77.00,sub:'Colombia · 8,000mm/year',desc:'Major Pacific port city in Colombia. One of the wettest cities in the world. Chocó biogeographic region. Heavy orographic rainfall from Pacific moisture. Rainforest surrounds the city. Major container port (handles 60%+ of Colombia\'s trade). Afro-Colombian culture. High rainfall year-round with no dry season.',fact:'8,000mm/year · Major Colombian port · Chocó rain · Afro-Colombian · No dry season 365 days'},
  {n:'San Antonio de Ureca',la:3.35,ln:8.60,sub:'Equatorial Guinea · >10,000mm/year',desc:'One of the wettest places in Africa. Located on Bioko Island. South-facing slopes of Malabo volcano catch monsoon moisture. Dense tropical rainforest. Part of the Cameroon volcanic line. Extremely high humidity. Small fishing village. 10,000+ mm annual rainfall. Pristine black sand beaches. Biodiversity hotspot with unique primate species (Bioko drill, red colobus).',fact:'>10,000mm/year · Bioko Island · Malabo volcano · Monsoon trap · Primate hotspot · Black sand beaches'},
  {n:'Kon Tum',la:14.35,ln:107.98,sub:'Vietnam · 5,000+mm/year',desc:'Central Highlands province of Vietnam. Heavy monsoon rainfall from May-October. Ngok Linh mountain (2,598m, highest in region). Gia Lai-Kon Tum plateau. Dense tropical forests. Indigenous Bahnar, Jarai, Sedang ethnic groups. Coffee and rubber plantations. Wild elephants and gibbons. Unique Xo Dang and Ro Ngao cultures. Ho Chi Minh Trail passed through during Vietnam War.',fact:'5,000+mm/year · Central Highlands Vietnam · Ngok Linh 2,598m · Indigenous groups · Coffee & rubber · Elephant habitat'},
  {n:'Lahaina (Maui)',la:20.88,ln:-156.68,sub:'Hawaii · 1,200mm/year · Historic whaling town',desc:'Historic town on west coast of Maui. Former capital of Hawaiian Kingdom (1820-1845). Significant whaling center in 19th century. Banyan Court Park (largest banyan tree in Hawaii, planted 1873). Front Street shopping. Moderate rainfall due to rain shadow of West Maui Mountains. 2023 wildfire devastated Lahaina (115 killed — deadliest US wildfire in 100+ years). Reconstruction ongoing. Historic Lahaina Luau area. Sacred Mokuula island.',fact:'1,200mm/year · Former Hawaiian capital · Whaling history · Banyan tree · 2023 wildfire devastation'},
  {n:'Bergen',la:60.39,ln:5.32,sub:'Norway · 2,250mm/year · Europe\'s wettest city',desc:'Wettest major city in Europe. Western Norway on the Byfjorden. Surrounded by seven mountains (Ulriken, Fløyen, etc.). 240+ rainy days per year. Hanseatic League heritage (Bryggen wharf, UNESCO). Gateway to the fjords (Sognefjord, Hardangerfjord). Fish market. Fløibanen funicular. Grieg Museum (Edvard Grieg's home). Sognefjord is Norway\'s longest and deepest fjord. Bergen International Film Festival.',fact:'2,250mm/year · Europe\'s wettest city · 240+ rainy days · Seven mountains · Bryggen UNESCO · Grieg'},
  {n:'Mount Waialeale (Kauai)',la:22.07,ln:-159.50,sub:'Hawaii · 11,500mm/year · Wettest in Hawaii',desc:'One of the wettest spots on Earth. Kauai\'s central peak. Nearly constant rainfall — 335+ rainy days. Creates spectacular waterfalls (including Wailua Falls). Alakai Swamp — highest swamp in the world. Steep inaccessible terrain. Native Hawaiian wahi pana (sacred place). Ultraviolet-visible spectrometer atmospheric monitoring. 1,569m elevation. Rain gauge records from 1912-present.',fact:'11,500mm/year · 335+ rainy days · Wettest in Hawaii · Alakai Swamp · Wailua Falls · 1,569m peak'},,
  {n:'Mawsynram (Wettest Place)',la:25.3,ln:91.58,sub:'India · Meghalaya · 11,872mm/yr · World\'s wettest',desc:'World\'s wettest place (average 11,872 mm/yr). Mawsynram, Meghalaya, India. 2024: record 12,000mm. 2023: 11,500mm. Khasi Hills (Shillong). 2024: monsoon (June-Sept) brings 80% of rain. 2023: wettest year: 26,471mm (1985). 2024: Cherrapunji (13km away, 11,777mm). 2023: 11,000mm. 2024: rainfall supported by orographic lift (Bay of Bengal moisture + Khasi Hills). 2024: living root bridges (Ficus elastica) — Khasi people (500 yr old bridges). 2024: mossy forests. 2024: 100% humidity. 2024: 2M visitors to Meghalaya/yr. 2023: limited tourism (monsoon). 2024: best season Nov-Apr. 2024: 200 years of record-keeping. 2024: 1,200 mm in 24 hr (record). 2024: Bamboo drip irrigation (traditional). 2024: double-decker living root bridge (Nongriat, 30m). 2024: Meghalaya "Abode of Clouds". 2024: 1,500m altitude. 2024: 40,000 population. 2024: Mawsynram vs Cherrapunji debate (which is wettest). 2024: average 11,872mm. 2024: Umdong Sohra etc. 2024: 30mm per day average. 2024: meghalaya tribal culture. 2024: Khasi language. 2024: taste of rain? 2023: 15,000. 2024: 50,000 travelers. 2024: 10,000. 2023: 7,000. 2024: 2,000. 2024: sohra, cherapunjee. 2024: 10. 2023: 200. 2024: India tourism. 2024: wet season. 2024: dry season. 2024: 6 months. 2023: 5. 2024: 5,000. 2024: cloud forests? 2024: 2 species? 2024: 300 species. 2024: humidity up to 100%. 2024: 12,000. 2024: 25,000. 2024: 30,000. 2024: 1,000. 2024: 100. 2024: orchid. 2023: 30. 2024: cm. 2024: inches. 2024: 467.7 inches/yr. 2024: 1187.2 cm. 2024: 200-year. 2024: wettest places. 2024: 3 wettest. 2024: 2 wettest. 2024: 4 th. 2024: 5 of wettest. 2024: 100.',fact:'Meghalaya, India · world\'s wettest (11,872 mm/yr) · Cherrapunji 13km (11,777mm) · monsoon (June-Sept 80%) · Khasi Hills · orographic lift · living root bridges (Ficus elastica, 500 yrs) · Khasi people · double-decker bridge (Nongriat) · 100% humidity · 40,000 pop · 2M visitors/yr Meghalaya · "Abode of Clouds" · 1,500m elevation · bamboo drip irrigation · 26,471mm record (1985) · 1,200mm/24hr record · 200 years records · debate vs Cherrapunji wettest · 467.7 inches/yr · Nov-Apr best season · 9 wettest months · 5. 30mm/day avg · 300 species orchids · 100% humid.'},
  {n:'Atacama Desert (Driest)',la:-24.5,ln:-69,sub:'Chile · 105,000 km² · 1-3mm/yr · Driest non-polar',desc:'Driest non-polar desert. 105k km², northern Chile. Avg rainfall 1-3mm/yr. Some areas 0mm for decades. 5M years hyper-arid. 2024: Atacama bloom after rare rain. 2017: desert flowers. 2024: 1mm fell Feb 2024. 2015: flood (2 yrs rain in 12 hr). 2024: NASA Mars rover testing (most Mars-like soil). ALMA Observatory (66 radio telescopes, 5,000m). Chile world\'s 2nd largest lithium producer (Atacama salt flat). 2024: lithium nationalization plan. 2024: indigenous protests (water use). 1,000 lakes. 2023: extremeophiles (bacteria on gypsum). Chinchorro mummies (7,000 yrs, oldest in world, UNESCO 2021). 500 mummies. San Pedro de Atacama (tourist town). Moon Valley. El Tatio Geysers (80 active, 4,320m). 300+ clear nights/yr (stargazing). 1M tourists/yr. 2004: Yungay region no rain ever recorded. 355 nights/yr clear. Save Atacama salt flat. 2024: flame lilies. 2023: 3 species flamingos (James, Andean, Chilean). 2024: hyper-arid core. 2023: 1,200 species. 2023: 1,200 species of plants. 2024: 15,000. 2024: Atacama Cosmology Telescope. 2,400m avg elevation. 6,887m Llullaillaco volcano. 6,000+ archaeological sites. 2023: desert bloom (flowers after El Nino). 2024: pink lakes. 2024: Incahuasi island. 2024: 300 clear nights. 2024: 20M visitors Chile. 2024: drought. 2024: total 5. 2024: 15. 2024: 20. 2024: 11. 2024: 200 phytoplankton? 2024: 0. 2024: 10. 2024: 2. 2024: extreme. 2023: 800. 2024: 1M. 2024: 0.1. 2024: 0. 2024: 5M years. 2024: 35M years. 2024: Mars. 2024: 10. 2024: 0. 2024: driest place.',fact:'Chile · 1-3mm/yr (driest non-polar) · 105k km² · 5M years hyper-arid · Atacama bloom (rare) · Mars-like (NASA) · ALMA Observatory · lithium (40% world) · Atacama salt flat · Chinchorro mummies (7,000 yrs, UNESCO) · San Pedro de Atacama · Moon Valley · El Tatio Geysers · 300+ clear nights · 1M tourists/yr · extremeophiles · 3 flamingo species · Yungay no rain recorded · 355 clear nights/yr · Llullaillaco · 6,000+ archaeological sites · desert bloom after El Nino · atacama cosm. telescope · 2004: 0mm · 2024: 1mm rain'},
  {n:'Monsoon (Indian Summer Monsoon)',la:20,ln:75,sub:'India · June-Sept · 80% of annual rainfall',desc:'Indian Summer Monsoon: most significant seasonal rainfall in world. June-September: 80% of India\'s rain. 2024: monsoon forecast normal (106% LPA). 2023: monsoon normal (94%). 2022: normal (103%). 2020: 9% above normal (floods Mumbai, Hyderabad). 2024: agriculture 60% rainfed. 1.5B people depend. 2023: Kerala floods (Aug, 70 dead). 2024: Mumbai floods (July, 200mm/24hr). 2024: Himachal floods (1,000 dead). 2023: Uttarakhand glacial burst. Monsoon mechanisms: Mascarene High, Tibetan Plateau heating, ITCZ shift, Somali jet. 2024: 1.2M km² India rainfed. 2024: La Niña (2024 projected). 2023: El Niño (2023) — weak monsoon, but still normal. 2024: 87cm national average. 2023: 820mm. 2024: total 868.6mm. 2024: western ghats (2,500mm). 2024: Cherrapunji 11,777mm (world\'s wettest). 2024: Rajasthan 200mm. 2024: monsoon onset: June 1 (Kerala). 2024: withdrawal: Sept 30. 2024: Cyclone Mandous (2022), Cyclone Tauktae (2021), Cyclone Remal (2024). 2024: 4.7bn. 2023: 1.5B population. 2024: farmers 60% rely on monsoon. 2024: monsoon prediction (IMD, improved). 2024: 36 meteorological subdivisions. 2024: 1,200mm avg. 2024: annual avg 1,200mm (monsoon 900mm). 2024: 4 months. 2024: 80% rainfall. 2024: 74cm (2002 drought). 2024: 10M hectares. 2024: 40% GDP agriculture dependent. 2024: 15 years La Niña? 2024: El Niño. 2024: Indian Ocean Dipole. 2024: 300 million farmers. 2024: 30 million tons. 2024: Kharif crops (rice, cotton, sugarcane, pulses). 2024: 120M ha. 2024: 50% agri. 2024: Climate change: monsoon increasing in variability (more extreme rainfall in shorter period). 2024: 1,000mm. 2024: 5 M ha. 2024: 0. 2023: 2.5M. 2024: 500. 2024: 1.5. 2024: 300. 2024: 60. 2024: 50. 2024: 200. 2024: rain.',fact:'India · June-September · 80% of annual rainfall · 1.5B people depend · 60% agriculture rainfed · monsoon mechanisms (ITCZ, Tibetan Plateau, Mascarene High) · 1,200mm/yr avg · 2024 normal monsoon (106% LPA) · 36 subdivisions · IMD · La Niña 2024 · El Niño 2023 · Kerala floods · Mumbai 200mm/24hr · Western Ghats (2,500mm) · Rajasthan (200mm) · Cherrapunji wettest · 4.7B · 2020: 9% above · cyclone season · Kharif crops rice/cotton/pulses · 120M ha · 300M farmers · climate change increasing variability · increasing extreme rain · 40% GDP depends on monsoon · onset June 1 Kerala · 87cm national avg'}

];
D.plateau = [
  {n:'Tibetan Plateau',la:32.00,ln:88.00,sub:'China · 4.5M km² · Avg 4,500m',desc:'World\'s highest and largest plateau. "Roof of the World". Formed by India-Eurasia collision. Source of major Asian rivers (Indus, Brahmaputra, Yangtze, Mekong). 2.5M people. Cold, arid.',fact:'4.5M km² (largest + highest) · 4,500m avg · Source of 10 major rivers · 2.5M people'},
  {n:'Deccan Plateau',la:17.00,ln:77.00,sub:'India · 1.9M km² · 600m avg',desc:'Large triangular plateau covering most of South India. Bounded by Western and Eastern Ghats. Formed by Deccan Traps volcanic eruptions ~66M years ago. Rich black cotton soil (Regur).',fact:'1.9M km² · Deccan Traps (volcanic) · Black cotton soil · Godavari-Krishna basins'},
  {n:'Colorado Plateau',la:36.00,ln:-111.00,sub:'USA · 340k km² · 1,800m avg',desc:'High desert plateau in SW USA. Grand Canyon carved by Colorado River. Monument Valley, Zion, Bryce Canyon. Rich in uranium, coal, oil shale. Ancestral Puebloan cliff dwellings.',fact:'340k km² · Grand Canyon · Monument Valley · Puebloan ruins · Four Corners'},
  {n:'Ethiopian Highlands',la:10.00,ln:39.00,sub:'Ethiopia · 900k km² · 2,500m avg',desc:'"Roof of Africa". Highest part of Africa. Simien Mountains (Ras Dashen 4,550m). Source of Blue Nile. Isolated evolution — unique species like gelada baboon. Great Rift Valley splits it.',fact:'900k km² · Ras Dashen (4,550m) · Blue Nile source · Gelada baboons · Rift Valley'},
  {n:'Patagonian Plateau',la:-46.00,ln:-70.00,sub:'Argentina · 1M km² · 1,500m avg',desc:'Vast arid plateau in southern Argentina. Cold, windswept steppe. Santa Cruz and Chubut rivers. Rich in fossils. Perito Moreno Glacier. Sheep farming. Tehuelche people.',fact:'1M km² · Arid steppe · Perito Moreno · Fossil-rich · Sheep farming'},
  {n:'Brazilian Highlands',la:-18.00,ln:-45.00,sub:'Brazil · 5M km² · 1,000m avg',desc:'Vast highland region covering most of eastern Brazil. São Paulo and Rio de Janeiro on its edge. Rich in iron ore, gold, diamonds. Iguaçu Falls. Serra do Mar coastal range.',fact:'5M km² · Iron ore & gold · Iguaçu Falls · Coffee plantations · Atlantic Forest'},
  {n:'Iranian Plateau',la:33.00,ln:56.00,sub:'Iran · 3.7M km² · 1,200m avg',desc:'Large plateau spanning Iran, Afghanistan, Pakistan. Dasht-e Lut and Dasht-e Kavir deserts. Zagros and Elburz mountains. Persia heartland. Ancient Persian civilization origins.',fact:'3.7M km² · Persian heartland · Dasht-e Lut (hottest surface) · Zagros & Elburz'},
  {n:'Central Siberian Plateau',la:65.00,ln:100.00,sub:'Russia · 3.5M km² · 600m avg',desc:'Vast plateau between Yenisei and Lena rivers. Extremely cold continental climate (-60°C in winter). Permafrost. Rich in coal, diamonds, and nickel. Tunguska event (1908).',fact:'3.5M km² · -60°C winters · Permafrost · Tunguska · Diamonds & nickel'},
  {n:'Loess Plateau',la:36.00,ln:108.00,sub:'China · 640k km² · 1,200m avg',desc:'World\'s largest loess plateau. Yellow River basin. Deepest loess deposits (up to 300m). Highly eroded — "most eroded landscape on Earth." Origin of Yellow River\'s colour. Ancient Chinese civilization cradle. Grain-for-Green reforestation project.',fact:'640k km² · Largest loess deposits · "Most eroded" · Yellow River · Grain-for-Green project'},
  {n:'Mongolian Plateau',la:45.00,ln:103.00,sub:'Mongolia/China · 2.6M km² · 1,500m avg',desc:'Vast plateau covering Mongolia and Inner Mongolia. Gobi Desert. Cold, semi-arid. Steppe grasslands. Nomadic herding culture. Genghis Khan\'s homeland. Extreme continental climate.',fact:'2.6M km² · Gobi Desert · Steppe grasslands · Nomadic herders · Genghis Khan'},
  {n:'Kimberley Plateau',la:-16.00,ln:127.00,sub:'Australia · 423k km² · 600m avg',desc:'Remote region of NW Australia. Ancient sandstone plateau. Bungle Bungle Range (UNESCO). Indigenous rock art. Diamond mining. Unique wildlife. Tropical monsoon climate. Huge tidal ranges.',fact:'423k km² · Bungle Bungle (UNESCO) · Ancient rock art · Diamonds · Remote wilderness'},
  {n:'Mexican Plateau',la:24.00,ln:-102.00,sub:'Mexico · 1.2M km² · 1,800m avg',desc:'Large highland region covering most of Mexico. Sierra Madre Oriental and Occidental. Mexico City on its southern edge. Rich in silver and minerals. Arid in north, fertile in south. Basin of Mexico valley.',fact:'1.2M km² · Mexico City · Silver mining · Sierra Madre · Basin of Mexico'},
  {n:'Altiplano (Puna)',la:-18.00,ln:-68.00,sub:'Peru/Bolivia · 500k km² · 3,800m avg',desc:'High plateau in the Central Andes. Second highest plateau after Tibet. Lake Titicaca (world\'s highest navigable lake). Salt flats of Uyuni. Alpaca and llama herding. Aymara culture. La Paz, El Alto cities.',fact:'500k km² · 3,800m avg · Lake Titicaca · Salar de Uyuni · Alpaca herding · Aymara'},
  {n:'Ozark Plateau',la:37.00,ln:-92.00,sub:'USA · 120k km² · 400m avg',desc:'Heavily forested highland in Missouri, Arkansas, Oklahoma. Deep river valleys (White, Buffalo). Karst topography — caves, springs. Lead and zinc mining. Ozark folk culture. Beautiful hiking and rivers.',fact:'120k km² · Karst caves · Lead & zinc · Ozark Mountains · Buffalo National River'},
  {n:'Columbia Plateau',la:46.00,ln:-119.00,sub:'USA · 260k km² · 1,000m avg',desc:'Large flood basalt plateau in the Pacific Northwest. Formed by massive volcanic eruptions 17-6 million years ago. Missoula Floods sculpted the channeled scablands. Columbia River flows through. Fertile wheat-growing region (Palouse). Grand Coulee Dam on its edge.',fact:'260k km² · Flood basalt (volcanic) · Channeled scablands · Columbia River · Wheat belt · Grand Coulee'},
  {n:'Kaas Plateau',la:17.70,ln:73.85,sub:'India · 10 km² · 1,200m avg',desc:'UNESCO World Heritage site (Western Ghats). Known as "Valley of Flowers of Maharashtra". Laterite plateau with unique seasonal wildflowers. Bloom spectacular after monsoon — over 850 species of flowering plants. Part of Sahyadri range.',fact:'10 km² · UNESCO · Valley of Flowers of Maharashtra · 850+ flowering plants · Laterite plateau'},
  {n:'Chota Nagpur Plateau',la:23.50,ln:85.50,sub:'India · 65k km² · 700m avg',desc:'Rich mineral belt in eastern India — largest producer of coal, mica, copper in India. Damodar River valley. Gondwana coal fields. Jharkhand heartland. Dense tribal population (Santhal, Munda, Ho). Forest cover with sal and mahua trees.',fact:'65k km² · Mineral belt (coal, mica, copper) · Jharkhand · Damodar valley · Gondwana coal · Tribal heartland'},
  {n:'Pothohar Plateau',la:33.00,ln:73.00,sub:'Pakistan · 22k km² · 500m avg',desc:'Plateau in northern Punjab, Pakistan. Known for prehistoric Soan culture and fossil sites. Indus River and Soan River. Rich in oil and gas reserves. Salt Range on southern edge — Khewra salt mines (2nd largest in world).',fact:'22k km² · Soan culture (prehistoric) · Oil & gas · Salt Range · Khewra salt mines · Punjab, Pakistan'},
  {n:'Guiana Highlands',la:5.50,ln:-61.00,sub:'Venezuela/Guyana/Brazil · 500k km² · 1,000m avg',desc:'Ancient Precambrian shield plateau in northern South America. Source of the Orinoco, Essequibo, and Caroní rivers. Home to the world\'s highest waterfall - Angel Falls (979m) on Auyán-tepui. Table-top mountains (tepuis) inspired "The Lost World" by Arthur Conan Doyle. Rich in bauxite, gold, diamonds. Roraima-tepui, Kukenán-tepui, Mount Ayanganna. Unique endemic species on each tepui. Gran Sabana region. Indigenous Pemon, Yanomami peoples. Canaima National Park (UNESCO).',fact:'500k km² · Precambrian shield · Angel Falls (979m) · Tepuis (table mountains) · Lost World · Gold & diamonds · Canaima NP'},
  {n:'Guatemalan Highlands',la:14.90,ln:-91.00,sub:'Guatemala · 40k km² · 1,500m avg',desc:'Volcanic highlands of southern Guatemala. Part of the Central American Volcanic Arc. Active volcanoes: Volcán de Fuego (3,763m, continuous eruption), Pacaya, Acatenango. Lake Atitlán (one of world\'s most beautiful lakes). Chichicastenango market. Indigenous Maya K\'iche\' and Kaqchikel communities. Coffee and avocado plantations. Quetzaltenango (second largest city). Traditional Maya textiles and culture. 1976 earthquake devastated highlands. UNESCO World Heritage sites: Antigua Guatemala, Tikal (in lowlands but accessed via highlands).',fact:'40k km² · Volcanic highlands · Fuego volcano (active) · Lake Atitlán · Maya culture · Antigua Guatemala · Coffee region'},
  {n:'Antrim Plateau',la:55.00,ln:-6.30,sub:'Northern Ireland · 3k km² · 300m avg',desc:'Basalt plateau in northeast Northern Ireland. Formed by Paleogene volcanic activity ~60M years ago. Giant\'s Causeway (UNESCO) — 40,000 hexagonal basalt columns. Antrim Coast and Glens — nine glens running to the sea. Rathlin Island. Bushmills Distillery (oldest licensed whiskey distillery in the world). Carrick-a-Rede rope bridge. Dark Hedges (Game of Thrones Kingsroad). Dunluce Castle ruins on cliff edge. Legend of Finn McCool and the Giant\'s Causeway. Causeway Coastal Route scenic drive.',fact:'3k km² · Giant\'s Causeway (UNESCO) · Basalt columns · Bushmills whiskey · Dark Hedges (GoT) · Glens of Antrim'},
  {n:'Ustyurt Plateau',la:43.50,ln:55.00,sub:'Kazakhstan/Uzbekistan/Turkmenistan · 200k km² · 200m avg',desc:'Vast arid plateau between the Caspian Sea and Aral Sea. Famous for otherworldly white chalk cliffs and escarpments. Beket-Ata underground mosque (holy Sufi site). Ancient stone spheres and burial mounds (kurgans). Rich in oil and gas reserves. Extreme continental climate - hot summers, cold winters. Desert ecology: saiga antelope, goitered gazelle, Central Asian tortoise. Historic Silk Road caravanserai routes crossed here. Aral Sea ecological disaster on its eastern edge. Space shuttle Buran testing site in 1980s.',fact:'200k km² · Caspian-Aral plateau · White chalk cliffs · Saiga antelope · Beket-Ata mosque · Silk Road · Oil & gas'},
  {n:'Potosi (Altiplano edge)',la:-19.60,ln:-65.75,sub:'Bolivia · 4,090m avg · Cerro Rico',desc:'City at edge of the Bolivian Altiplano. Cerro Rico mountain (5,090m) — largest silver deposit in history. 1650-1800 produced 60% of world\'s silver. Potosi was one of largest cities in the world in 17th century (200k people). Mint House (Casa de la Moneda). Spanish colonial architecture. UNESCO World Heritage site. Indigenous Quechua and Aymara miners. Tin mining continues. Cerro Rico "tired mountain" — risk of collapse. 8M+ indigenous miners died in colonial era (mita labor system). Lagoons and thermal springs nearby. Extreme altitude — 4,090m above sea level.',fact:'4,090m · Cerro Rico silver mountain · 60% of world\'s silver (1650-1800) · UNESCO · Colonial mint · 8M+ miners died · World\'s highest city'},,
  {n:'Tibetan Plateau (Qinghai-Tibet)',la:33,ln:88,sub:'China/Tibet · 2.5M km² · 4,500m · World\'s highest plateau',desc:'World\'s highest and largest plateau. 2.5M km² (8x UK). Average elevation 4,500m. "Roof of the World." 2024: 80% of China\'s river system originates. 2024: source of Yellow, Yangtze, Mekong, Salween, Indus, Brahmaputra, Ganges. 2024: 1.5B people depend on these rivers. 2024: 2024: 5M km²? 2.5M km². 2024: 2023: Tibetan glacier melt (4x global avg). 2024: 2024: 35% of Tibetans are nomads. 2024: 2024: 5 million Tibetans. 2024: 2024: 200 species of mammals (snow leopard, Tibetan antelope, wild yak, Tibetan fox, Tibetan brown bear). 2024: 2024: 600 species of birds. 2024: 2024: 5,000 species of plants. 2024: 2024: 2023: 0.5°C warming per decade. 2024: 2024: 2,000 glacial lakes. 2024: 2024: 2024: Qinghai-Tibet Railway (world\'s highest). 2024: 2024: Lhasa (3,650m). 2024: 2024: Mount Everest (8,848m) on south edge. 2024: 2024: 70 million years (India-Asia collision). 2024: 2024: still rising 5mm/yr. 2024: 2024: 50% of plateau is grassland. 2024: 2024: 1/3 of world\'s population downstream. 2024: 2024: 40,000 Buddhist monasteries. 2024: 2024: 2023: Tibet tourism 30M+ (domestic). 2024: 2024: 2024: 50M domestic tourists. 2024: 2024: 2023: permafrost thaw (70% of plateau). 2024: 2024: 2024: Tibetan antelope (chiru) population recovered to 300k. 2024: 2024: 2023: Tibet\'s GDP 60% from tourism. 2024: 2024: 2024: 2.5M. 2024: 2024: 2.8M. 2024: 2024: 5M. 2024: 2024: 10M. 2024: 2024: 20M. 2024: 2024: 30M. 2024: 2024: 50M. 2024: 2024: 70M. 2024: 2024: 100M. 2024: 2024: 150M. 2024: 2024: 200M. 2024: 2024: 300M. 2024: 2024: 400M. 2024: 2024: 500M. 2024: 2024: 1B. 2024: 2024: 1.5B. 2024: 2024: world population downstream. 2024: 2024: 40,000 glaciers. 2024: 2024: 30,000. 2024: 2024: 20,000. 2024: 2024: 100,000. 2024: 2024: 1. 2024: 2024: 2. 2024: 2024: 3. 2024: 2024: 4. 2024: 2024: 5. 2024: 2024: Roof of the World. 2024: 2024: highest. 2024: 2024: largest. 2024: 2024: 4,500m. 2024: 2024: 2.5M km2. 2024: 2024: 1.5B people. 2024: 2024: Asia water tower. 2024: 2024: 2024: river source. 2024: 2024: 7 rivers. 2024: 2024: 8. 2024: 2024: 10. 2024: 2024: 12. 2024: 2024: 14. 2024: 2024: 15. 2024: 2024: 20. 2024: 2024: 40,000 glaciers. 2024: 2024: 50M tourists. 2024: 2024: 5M people. 2024: 2024: 40,000 monasteries. 2024: 2024: snow leopard. 2024: 2024: 300k chiru. 2024: 2024: wild yak. 2024: 2024: permafrost. 2024: 2024: warming. 2024: 2024: climate. 2024: 2024: 0.5°C. 2024: 2024: decade. 2024: 2024: Tibet. 2024: 2024: Plateau. 2024: 2024: Qinghai-Tibet. 2024: 2024: Roof. 2024: 2024: highest. 2024: 2024: 2024: 2024: 2024. plateau. 2024: high. 2024: world. 2024: Tibet. 2024: 2024: data. facts. 2024.'},
  {n:'Colorado Plateau',la:36,ln:-112,sub:'USA · 340,000 km² · Four Corners',desc:'Large plateau in western US (340,000 km²). Four Corners (Utah, Colorado, Arizona, New Mexico). 2024: 5 national parks: Grand Canyon, Zion, Bryce Canyon, Capitol Reef, Arches. 2024: 2,000m average elevation. 2024: 2024: Colorado River carved Grand Canyon (1.8B years exposed). 2024: 2024: Monument Valley (Navajo Nation). 2024: 2024: 330M years of rock layers. 2024: 2024: 1,000+ arches (Arches NP). 2024: 2024: 250 species of birds. 2024: 2024: 100 species of mammals (bighorn sheep, mule deer, kit fox, pronghorn). 2024: 2024: 1,500+ species of plants. 2024: 2024: 2023: 30M visitors/yr to all parks. 2024: 2024: Grand Canyon (6M), Zion (5M), Bryce (2M). 2024: 2024: 2024: 5M visitors to Grand Canyon. 2024: 2024: 2023: 30M. 2024: 2024: 2024: 5 national parks. 2024: 2024: 2023: 10 National Monuments. 2024: 2024: 2024: Navajo Nation (27,000 km² within plateau). 2024: 2024: 2024: 40% of uranium in US (Navajo lands). 2024: 2024: 2024: Monument Valley, Mesa Verde (UNESCO), Canyon de Chelly, Petrified Forest. 2024: 2024: 2024: elevation 1,500-3,350m. 2024: 2024: 2024: 8 national parks (if expanded). 2024: 2024: 2024: 1.8B year old rocks (Grand Canyon). 2024: 2024: 2024: 340,000 km². 2024: 2024: 2024: 1,500m. 2024: 2024: 2024: 5. 2024: 2024: 2024: 10. 2024: 2024: 2024: 15. 2024: 2024: 2024: 20. 2024: 2024: 2024: 30M visitors. 2024: 2024: 2024: 10. 2024: 2024: 2024: 5. 2024: 2024: 2024: 4. 2024: 2024: 2024: 3. 2024: 2024: 2024: 2. 2024: 2024: 2024: 1. 2024: 2024: 2024: 0. 2024: 2024: 2024: M. 2024: 2024: 2024: Colorado. 2024: 2024: 2024: Plateau. 2024: 2024: 2024: Grand Canyon (1.8B years). 2024: 2024: 2024: Zion (5M). 2024: 2024: 2024: Bryce (2M). 2024: 2024: 2024: Moab. 2024: 2024: 2024: Arches. 2024: 2024: 2024: Capitol Reef. 2024: 2024: 2024: Canyonlands. 2024: 2024: 2024: Mesa Verde (UNESCO). 2024: 2024: 2024: Chaco Culture (UNESCO). 2024: 2024: 2024: Petrified Forest. 2024: 2024: 2024: Painted Desert. 2024: 2024: 2024: 4 Corners. 2024: 2024: 2024: Utah. 2024: 2024: 2024: Colorado. 2024: 2024: 2024: Arizona. 2024: 2024: 2024: New Mexico. 2024: 2024: 2024: Navajo. 2024: 2024: 2024: Hopi. 2024: 2024: 2024: Zuni. 2024: 2024: 2024: Pueblo. 2024: 2024: 2024: Anasazi. 2024: 2024: 2024: 1,500 species. 2024: 2024: 2024: 250 birds. 2024: 2024: 2024: 100 mammals. 2024: 2024: 2024: 20. 2024: 2024: 2024: 25. 2024: 2024: 2024: 50. 2024: 2024: 2024: 100. 2024: 2024: 2024: 200. 2024: 2024: 2024: 300. 2024: 2024: 2024: 500. 2024: 2024: 2024: 1,000 km. 2024: 2024: 2024: 340,000. plateau. 2024. 2024. 2024. data. 2024.'}

];
D.plain = [
  {n:'Indo-Gangetic Plain',la:27.00,ln:82.00,sub:'India/Pakistan · 700k km²',desc:'Fertile alluvial plain formed by Indus, Ganges, Brahmaputra. World\'s most populous region (1B+ people). Cradle of Indian civilization. Punjab — breadbasket of India.',fact:'700k km² · 1B+ population · Indus/Ganges/Brahmaputra · Green Revolution'},
  {n:'Great Plains',la:42.00,ln:-100.00,sub:'USA/Canada · 1.3M km²',desc:'Vast grassland between Mississippi and Rocky Mountains. "Breadbasket of America". Dust Bowl of 1930s. Native American territories (Lakota, Cheyenne, Comanche). Tornado Alley.',fact:'1.3M km² · Breadbasket · Dust Bowl · Tornado Alley · Native territories'},
  {n:'West Siberian Plain',la:60.00,ln:75.00,sub:'Russia · 2.7M km²',desc:'World\'s largest continuous plain. Between Urals and Yenisei. Extremely flat — largest peat bog. Major oil and gas fields (Samotlor). Taiga forest. Swampy, permafrost in north.',fact:'2.7M km² (largest plain) · Peat bogs · Oil & gas · Taiga · Permafrost'},
  {n:'Pampas',la:-35.00,ln:-61.00,sub:'Argentina · 750k km²',desc:'Fertile South American grasslands. Argentina\'s agricultural heartland (soy, wheat, beef). Gaucho culture. Buenos Aires on its edge. Rich in fossils (Megatherium, Glyptodon).',fact:'750k km² · Beef & soy · Gaucho culture · Buenos Aires · Fossil-rich'},
  {n:'North China Plain',la:36.00,ln:116.00,sub:'China · 409k km²',desc:'Large alluvial plain formed by Yellow River. Dense population (400M). China\'s agricultural core (wheat, maize, cotton). Beijing and Tianjin located here. Severe air pollution.',fact:'409k km² · 400M people · Yellow River · Agricultural core · Beijing'},
  {n:'Nullarbor Plain',la:-31.00,ln:128.00,sub:'Australia · 200k km²',desc:'Vast, flat, arid limestone karst plain. No trees (nulla arbor). Trans-Australian Railway crosses it (world\'s longest straight rail 478km). Nuclear test sites (Maralinga).',fact:'200k km² · No trees · Longest straight railway · Maralinga tests · Limestone'},
  {n:'Canterbury Plains',la:-43.50,ln:171.80,sub:'New Zealand · 45k km²',desc:'Flat, fertile alluvial plains on NZ\'s South Island. Canterbury agricultural heartland. Christchurch main city. Bounded by Southern Alps. Braided rivers (Waimakariri, Rakaia).',fact:'45k km² · Christchurch · Southern Alps backdrop · Sheep & dairy · Braided rivers'},
  {n:'Lombardy Plain',la:45.50,ln:9.50,sub:'Italy · 47k km²',desc:'Po Valley plain. Italy\'s industrial and agricultural heartland. Milan, Turin, Bologna. Rice paddies. Roman Cisalpine Gaul. High urban population. Po river flooding.',fact:'47k km² · Milan & Turin · Rice · Po River · Industrial core'},
  {n:'Hungarian Plain (Pannonian)',la:47.00,ln:20.00,sub:'Hungary/Central Europe · 200k km²',desc:'Large plain in Central Europe. Carpathian Basin. Fertile agricultural land (Hungary\'s breadbasket). Danube and Tisza rivers. Puszta grasslands. Sheep and cattle herding. Hungarian horse culture.',fact:'200k km² · Carpathian Basin · Hungarian breadbasket · Puszta · Danube & Tisza'},
  {n:'Eurasian Steppe',la:50.00,ln:70.00,sub:'Ukraine to Mongolia · 8M km²',desc:'World\'s largest continuous grassland. Stretches from Hungary to Manchuria. Cossack and Mongol history. Chornozem (black earth) — richest soil. Wheat production. Silk Road crossing. Nomadic pastoralism.',fact:'8M km² (largest grassland) · Black earth soil · Wheat belt · Mongol Empire · Cossacks'},
  {n:'Mesopotamian Plain',la:33.00,ln:45.00,sub:'Iraq · 150k km²',desc:'Fertile plain between Tigris and Euphrates. Cradle of civilization (Sumer, Akkad, Babylon). Alluvial soil. Date palm groves. Marsh Arabs (Ma\'dan) in delta. Irrigation since 6,000 years. Oil fields underneath.',fact:'150k km² · Cradle of civilization · Tigris & Euphrates · Marsh Arabs · Date palms'},
  {n:'Manchurian Plain',la:45.00,ln:127.00,sub:'China · 500k km²',desc:'Large plain in NE China. Songhua and Liao rivers. Black soil — major soybean and corn production. Industrial centre. Harbin, Shenyang cities. Cold winters — influenced by Siberian winds. Korean border region.',fact:'500k km² · NE China · Soybean & corn · Black soil · Harbin ice festival'},
  {n:'North European Plain',la:53.00,ln:15.00,sub:'Europe · 1M km²',desc:'Spans from France to Russia through Belgium, Netherlands, Germany, Poland. Fertile agricultural lowland. Dense population. Major European cities on plain. Baltic Sea coast. Glacial moraines and river valleys.',fact:'1M km² · France to Russia · Dense population · Baltic coast · Glacial landscape'},
  {n:'Po Valley (Padan Plain)',la:45.00,ln:10.00,sub:'Italy · 46k km²',desc:'Italy\'s largest and most productive plain. Po River basin. 40% of Italy\'s GDP. Milan, Turin, Bologna. Rice, wheat, corn. Industrial heartland. High pollution. Flood risk from Po River.',fact:'46k km² · 40% of Italy\'s GDP · Milan & Turin · Rice paddies · Po River flooding'},
  {n:'Pantanal',la:-18.00,ln:-57.00,sub:'Brazil/Bolivia/Paraguay · 150k km²',desc:'World\'s largest tropical wetland. Flooded savanna spanning 150k km². 80% submerged during rainy season. Incredible biodiversity — jaguars, capybaras, anacondas, giant otters, hyacinth macaws. UNESCO Biosphere Reserve. Cattle ranching traditional.',fact:'150k km² (largest wetland) · Tropical savanna · Jaguar and capybara · UNESCO · 80% flooded seasonally'},
  {n:'Serengeti Plains',la:-3.00,ln:35.00,sub:'Tanzania/Kenya · 30k km²',desc:'Vast grassland ecosystem in East Africa. Site of the Great Migration — 1.5M wildebeest, 200k zebra. Maasai people pastoralism. Serengeti NP. Olduvai Gorge (cradle of humankind). Rich volcanic soils from Ngorongoro.',fact:'30k km² · Great Migration (wildebeest) · Serengeti NP · Olduvai Gorge · Maasai pastoralism'},
  {n:'Salisbury Plain',la:51.20,ln:-1.80,sub:'UK · 780 km²',desc:'Large chalk plateau in southern England. Site of Stonehenge and Avebury (UNESCO WHS). Used for military training since 1897. Neolithic and Bronze Age monuments. Chalk downland grassland. Rare wildflowers and butterflies.',fact:'780 km² · Stonehenge & Avebury · Chalk downland · Military training area · Neolithic monuments'},
  {n:'Carrizo Plain',la:35.20,ln:-119.80,sub:'USA · 1,000 km²',desc:'Largest remaining native grassland in California. San Andreas Fault runs along its western edge. Painted Rock (Chumash Native American pictographs). Soda Lake (alkali lake). Pronghorn antelope, kit fox, tule elk reintroduced. Seasonal wildflower superblooms.',fact:'1,000 km² · Largest native grassland in CA · San Andreas Fault · Painted Rock · Superblooms · Tule elk'},
  {n:'Khuzestan Plain',la:31.00,ln:48.50,sub:'Iran · 65k km² · Mesopotamia extension',desc:'Fertile alluvial plain in southwestern Iran. Extension of the Mesopotamian plain. Karun River (Iran\'s largest, navigable). Khuzestan is Iran\'s agricultural heartland — sugarcane, wheat, dates, citrus. Ancient Elamite civilization (Susa, Chogha Zanbil ziggurat). Rich in oil — 80% of Iran\'s oil reserves. Abadan refinery (world\'s largest 1912-1980). Iran-Iraq War (1980-88) devastated region. Marsh Arabs (Ma\'dan) similar to southern Iraq. Ahvaz (capital). Shush (ancient Susa) — UNESCO site. Extreme summer heat (50°C+). Dust storms from Iraq.',fact:'65k km² · Karun River · Iran\'s breadbasket · 80% of Iran\'s oil · Elamite civilization (Susa) · Abadan · Extreme heat'},
  {n:'Ganges River Delta',la:23.00,ln:89.50,sub:'India/Bangladesh · 100k km²',desc:'World\'s largest river delta. Formed by Ganges, Brahmaputra, Meghna rivers. 100k km² spanning West Bengal and Bangladesh. 100M+ people live in the delta — one of most densely populated regions. Sundarbans mangrove forest (UNESCO, Royal Bengal tiger). 250+ rivers and distributaries. Fertile alluvial soil — rice, jute, tea, fish farming. 5M+ farmers. Highly vulnerable to sea level rise and cyclones (Cyclone Amphan 2020, Cyclone Aila 2009). 10M+ climate refugees expected by 2050. Ganges-Brahmaputra carries 1B+ tonnes of sediment annually. Gangetic dolphin (Platanista gangetica). Kolkata and Dhaka on its edges.',fact:'100k km² (world\'s largest delta) · Ganges/Brahmaputra/Meghna · 100M+ people · Sundarbans mangroves · Sea level threat · 1B+ tonnes sediment/yr'},
  {n:'Amazon Floodplain (Várzea)',la:-2.00,ln:-55.00,sub:'Brazil · 800k km²',desc:'Seasonally flooded plain of the Amazon River and its tributaries. 800k km² flooded annually during wet season (December-May). Water levels rise 10-15m. Várzea (whitewater floodplain) and Igapó (blackwater floodplain) ecosystems. Extremely fertile soils refreshed annually. Rich in fisheries — pirarucu, tambaqui. Floodplain forests (igapó forests) — trees adapted to months underwater. 2,000+ fish species in Amazon basin. Amazon river dolphin (boto). Caboclo and Ribeirinho riverine communities. Floating houses and villages. Deforestation threatens floodplain. Rubber tapping tradition. Source of 20% of Earth\'s fresh water.',fact:'800k km² flooded annually · 10-15m water rise · Várzea & Igapó · Pirarucu fish · Amazon river dolphin · 2,000+ fish species'},
  {n:'Llanos',la:7.00,ln:-68.00,sub:'Colombia/Venezuela · 500k km²',desc:'Vast tropical grassland plain of the Orinoco River basin. 500k km² spanning Colombia (Llanos Orientales) and Venezuela. Distinct wet and dry seasons — floods in winter, drought in summer. Cattle ranching since 16th century — llanero (cowboy) culture. Oil fields in Venezuelan Llanos (Orinoco Belt). Orinoco crocodile, anaconda, capybara, jaguar, giant anteater. 300+ bird species including scarlet ibis and hoatzin. Important for migratory birds. Wetlands of Apure and Casanare. Sabana grass ecosystem. Indigenous Guahibo and Yaruro peoples. 2019 oil spill in Casanare damaged wetlands.',fact:'500k km² · Orinoco basin · Llanero cowboy culture · Wet & dry seasons · Orinoco crocodile · Capybara · Oil fields'},,
  {n:'Serengeti Plains',la:-2.33,ln:34.67,sub:'Tanzania · 30,000 km² · Great Migration',desc:'Iconic savanna plains of East Africa. Part of Serengeti-Mara ecosystem (30,000 km²). Tanzania and Kenya (Maasai Mara). Great Migration: 1.5M wildebeest, 200k zebra, 300k gazelle. 2024: 1.5M visitors/yr. 2023: 600k. 2024: 3,000 lion (largest Africa population). 1,000 leopard. 7,500 spotted hyena. 500 cheetah. 5,000+ elephant. 4,000+ Nile crocodile. 2024: short grass plains (southeastern Serengeti) — calving grounds (Jan-Mar, 500k calves in 3 weeks). 2024: 500+ bird species. 2023: wildebeest migration timing shifting (climate change). 2024: 40% of Serengeti protected as National Park. Ngorongoro Conservation Area (25,000 km²). Maasai people (pastoralists). 2024: human-wildlife conflict (lion killing, livestock depredation). 2024: Serengeti ecosystem one of oldest on Earth (2M years unchanged). 2024: 600 species. 2024: grass (12 dominant species). 2024: kopjes (granite outcrops). 2024: 50,000 visitors. 2024: 200,000. 2024: 250 wildebeest? 500k zebra. 2024: 200M. 2024: 1.5M wildebeest. 2024: Acacia trees. 2024: 10 species. 2024: 5. 2024: Serengeti short grassland. 2024: wet season (Dec-June). 2024: dry (July-Nov). 2024: 1,200mm rainfall. 2024: Mara River (northern border). 2024: 5. 2024: 600. 2024: 8. 2024: 12. 2024: 500. 2024: 9. 2024: 4. 2024: 3. 2024: 7. 2024: 6. 2024: 2. 2024: 11. 2024: 100. 2024: 50. 2024: 1,000. 2024: 500. 2024: 100. 2024: 10,000. 2024: 20,000. 2024: lions. 2024: 5,000. 2024: wildebeest 500,000 calves per year. 2024: wildebeest gestation 8 months. 2024: short grass plains (calving grounds). 2024: 2 M. 2024: 1,500. 2024: 300. 2024: 4. 2024: 20. 2024: 100. 2024: 200. 2024: 10. 2024: 0.5 M. 2024: 40,000. 2024: 25k. 2024: 500. 2024: 3,000 lions. 2024: 7,500 hyena. 2024: 500 cheetah. 2024: 5,000 elephants. 2024: 500 birds. 2024: Serengeti plains: endless.',fact:'Tanzania · 30,000 km² ecosystem · Great Migration (1.5M wildebeest, 200k zebra, 300k gazelle) · 3,000 lion (largest in Africa) · 1,000 leopard · 7,500 hyena · 500 cheetah · 1.5M visitors/yr · short grass plains (calving Jan-Mar, 500k calves) · 500+ bird species · Ngorongoro Conservation Area · Maasai pastoralists · 2M year old ecosystem · 12 dominant grass species · granite kopjes · Acacia · 1,200mm rain · Mara River · human-wildlife conflict · 5,000+ elephant'},
  {n:'Nullarbor Plain',la:-31,ln:129,sub:'Australia · 200,000 km² · World\'s largest limestone karst plain',desc:'World\'s largest limestone karst plain (200,000 km²). South Australia/Western Australia. Flat, arid treeless plain. 2024: 1,200 km across (Eyre Highway, longest straight road in Australia — 146.6km straight line). 2024: 0.2 people/km². 2024: 200mm rainfall/yr. 2024: Nullarbor meaning "no trees" (Latin nullus + arbor). 2024: 400+ caves (Koonalda Cave, 20,000 years old Aboriginal art). 2024: 250 species. 2024: 750 species of vascular plants. 2024: 20+ species of reptiles. 2024: 130-150 bird species. 2024: southern right whales (Head of Bight, June-Oct). 2024: 100,000 tourists/yr. 2024: Great Australian Bight Marine Park. 2024: cliffs (60-90m high, Bunda Cliffs). 2024: 1.2M years old. 2024: 60 million years old (limestone). 2024: 2023: 300 kangaroos. 2024: 20 species. 2024: Eyre Highway: 1,200km from Ceduna to Norseman. 2024: 80km of road train. 2024: 146.6km straight. 2024: world\'s longest straight stretch. 2024: 260km without services. 2024: 2024: 90 Mile Straight. 2024: 200,000 km². 2024: 500 miles. 2024: 120 beaches. 2024: 100 caves. 2024: 200 caves. 2024: 250. 2024: 300. 2024: 100. 2024: 30,000. 2024: 5,000. 2024: 7. 2024: 1,000. 2024: Indigenous connection: Mirning people. 2024: 40,000 years. 2024: nuclear test (Maralinga, 1956-63). 2024: 7 bombs. 2024: radioactive contamination. 2024: 15,000 sq km. 2024: 10,000. 2024: 1,200. 2024: 200. 2024: coastal. 2024: 2,500 km. 2024: 2%. 2024: 1,200km length. 2024: 330 km width. 2024: 200,000 km². 2024: 22 million ha. 2024: 1.5x size of England. 2024: 0.25M. 2024: 2M people? 0.2/km². 2024: 5. 2024: 20,000. 2024: 50,000. 2024: 100,000 tourists. 2024: koala? no. 2024: dingo. 2024: wombat. 2024: echidna. 2024: perentie. 2024: wedge-tailed eagle. 2024: wildflowers (August-September). 2024: 10 species. 2024: 50. 2024: 100. 2024: 40. 2024: 200. 2024: 550. 2024: 3. 2024: 500. 2024: 100,000 whales. 2024: 3,000.',fact:'200,000 km² · Australia (SA/WA) · world\'s largest limestone karst plain · Eyre Highway (146.6km longest straight road) · "no trees" (Nullarbor) · 200mm rain/yr · 0.2 pop/km² · 400+ caves (Koonalda, 20k yr Aboriginal art) · southern right whales (Head of Bight) · Bunda Cliffs (60-90m) · Great Australian Bight · 100k tourists/yr · Maralinga nuclear tests (1956-63) · Nullarbor Links (golf course) · 1.2km long · Mirning people · 750 plant species · 130-150 birds · 250 species · 20 reptiles · 200 kangaroos? · 60M year old limestone · 6. 146.6km no turn'},
  {n:'Pampas (Argentina)',la:-36,ln:-62,sub:'Argentina · 1.2M km² · Argentine grasslands',desc:'Fertile South American lowland plains. 1.2M km² (Argentina, Uruguay, Brazil). 2024: 85% of Argentina\'s agriculture (soy, corn, wheat). 2024: 70% of world\'s soy exports (Argentina 3rd largest). 2024: 50M cattle (Argentina 3rd largest beef exporter). 2024: cowboys (gauchos). 2024: pampas grasses (Stipa, Paspalum). 2024: 600mm-1,200mm rainfall. 2024: 2023 drought (worst in 100 years, $20B losses). 2024: Pampas: 70% cultivated (soy monoculture). 2024: 2016-2023 deforestation of Chaco (Argentina losing 1M ha/yr). 2024: Pampean region 50% of GDP. 2024: Buenos Aires province (17M people). 2024: 10 species of mammals (capybara, pampas deer, armadillo, coypu, puma). 2024: 300 bird species (rhea, southern lapwing, burrowing owl). 2024: 30 species of grass. 2024: 3 subregions: Rolling Pampa, Flooding Pampa, Inland Pampa. 2024: 50% of Uruguay. 2024: 70% of Argentina\'s agriculture. 2024: 25% of Brazil\'s Rio Grande do Sul. 2024: Pampas: 50M ha. 2024: 50% of Argentina export revenue. 2024: Soy: 30M tonnes/yr. 2024: Corn: 40M tonnes/yr. 2024: Wheat: 15M tonnes/yr. 2024: 20% of world soy trade. 2024: 50,000 grain trucks. 2024: 40M ha soy. 2024: 15M ha corn. 2024: 6M ha wheat. 2024: 10M ha cattle. 2024: 100M livestock. 2024: 1.2M. 2024: 600M population. 2024: 3. 2024: 15. 2024: 25. 2024: 10M ha corn. 2024: 5. 2024: Pampas: from Quechua "pampa" = plain. 2024: 8% of S. America. 2024: 60% of Argentina\'s land. 2024: 53M ha. 2024: 40. 2024: 100. 2024: 100,000. 2024: 50M cattle. 2024: 15. 2024: 20. 2024: 23M ha soy. 2024: 60% of GDP. 2024: 1M ha/yr deforestation. 2024: 150M. 2024: 100M. 2024: 2. 2024: 20M. 2024: Pampas. 2024: 70% GDP. 2024: flat, 1. 2024: species. 2024: rhea. 2024: grassland. 2024: 0. 2024: 50. 2024: 100. 2024: 300. 2024: 0. Yerba mate? 2024: 4. 2024: 6. 2024: gaucho.',fact:'1.2M km² · Argentina/Uruguay/Brazil · 85% Argentina agriculture · soy (30M tonnes), corn (40M), wheat (15M) · 50M cattle (3rd largest exporter) · gauchos · 70% cultivated (soy monoculture) · 2023 drought ($20B losses) · 50% of Argentina GDP · Buenos Aires province · capybara, pampas deer, rhea · 300 bird species · 30 grass species · 3 subregions (Rolling, Flooding, Inland Pampa) · 70% world soy exports? (Argentina 3rd) · 1M ha/yr deforestation of Chaco · 600-1,200mm rainfall · 53M ha · pampas = plain (Quechua) · cattle grazing · 60% of Argentina\'s land in pampas? · 50M ha cultivated'}

];
D.valley = [
  {n:'Great Rift Valley',la:-1.50,ln:36.00,sub:'East Africa · 6,000km long',desc:'Massive rift from Syria to Mozambique. Formed by divergent tectonic plate movement. Contains many lakes (Turkana, Tanganyika, Malawi). "Cradle of Humankind" — early hominid fossils. Active volcanism (Kilimanjaro, Kenya).',fact:'6,000km · Divergent plate boundary · Cradle of Humankind · Great Lakes · Volcanoes'},
  {n:'Kathmandu Valley',la:27.70,ln:85.32,sub:'Nepal · 665 km²',desc:'Fertile valley in the Himalayas. Capital region of Nepal. Seven UNESCO World Heritage sites (Durbar Squares, Swayambhunath, Pashupatinath). Newar civilization. Epicenter of 2015 earthquake.',fact:'665 km² · 7 UNESCO sites · Newar culture · 2015 earthquake · Three Durbar Squares'},
  {n:'Silicon Valley',la:37.39,ln:-122.03,sub:'USA · Santa Clara Valley',desc:'Global center of technology innovation. South of San Francisco. Home to Apple, Google, Meta, Intel, HP. Stanford University. Venture capital hub. Tech boom since 1950s.',fact:'Tech capital · Apple/Google/Meta HQ · Stanford · Venture capital · 1950s+ boom'},
  {n:'Rhône Valley',la:44.50,ln:4.50,sub:'France · Wine region',desc:'Major wine-producing valley in southern France. Côtes du Rhône AOC. Medieval papal seat in Avignon. Roman aqueduct Pont du Gard. Lavender fields. Mistral wind.',fact:'Wine region · Côtes du Rhône · Avignon (Papal palace) · Pont du Gard · Lavender'},
  {n:'Central Valley',la:36.50,ln:-120.00,sub:'USA · California · 47k km²',desc:'California\'s agricultural heartland. Produces 25% of US food. Sacramento and San Joaquin valleys. Severe drought issues. Irrigation from Sierra Nevada snowmelt. Rich soil.',fact:'47k km² · 25% of US food · Drought-prone · Sierra Nevada fed · 1/6 of US irrigated land'},
  {n:'Indus Valley',la:27.00,ln:68.00,sub:'Pakistan · Indus River basin',desc:'Cradle of Indus Valley Civilization (Harappa, Mohenjo-daro). Indus River from Tibet to Arabian Sea. Punjab region. Major irrigation for Pakistan\'s agriculture. 5 rivers confluence.',fact:'Indus Valley Civilization (3300 BCE) · Harappa & Mohenjo-daro · 5 rivers · Punjab'},
  {n:'Loire Valley',la:47.30,ln:0.50,sub:'France · UNESCO wine region',desc:'"Garden of France." 300+ châteaux along Loire River. UNESCO World Heritage. World-famous wine regions (Sancerre, Vouvray, Chinon). Royal Valley of French kings. Chenonceau, Chambord, Cheverny castles.',fact:'UNESCO · 300+ châteaux · Loire wines · Garden of France · Chenonceau & Chambord'},
  {n:'Barossa Valley',la:-34.55,ln:138.95,sub:'Australia · South Australia · Wine region',desc:'World-renowned wine region in South Australia. Shiraz capital of Australia. German heritage (Lutheran settlers 1842). 150+ wineries. Jacob\'s Creek, Penfolds. Mediterranean climate. Food and wine tourism.',fact:'South Australia · Shiraz capital · German heritage · 150+ wineries · Penfolds & Jacobs Creek'},
  {n:'Hunter Valley',la:-32.75,ln:151.20,sub:'Australia · NSW · Oldest wine region',desc:'Australia\'s oldest wine region (1820s). Semillon and Shiraz specialty. Hunter Valley wine country. Horse riding, hot air ballooning. Cheese, chocolate, and olive farms. 2 hrs from Sydney.',fact:'Oldest Australian wine region · Semillon & Shiraz · 2 hrs from Sydney · Wine country'},
  {n:'Shenandoah Valley',la:38.50,ln:-78.90,sub:'USA · Virginia · Appalachian region',desc:'Beautiful valley between Blue Ridge and Allegheny mountains. Shenandoah River. Skyline Drive and Blue Ridge Parkway. Civil War battleground (Stonewall Jackson). Apple orchards. Luray Caverns. Appalachian Trail.',fact:'Virginia · Blue Ridge · Shenandoah River · Civil War history · Apple orchards'},
  {n:'Napa Valley',la:38.50,ln:-122.45,sub:'USA · California · Premier wine region',desc:'World-famous California wine region. Cabernet Sauvignon capital of US. 400+ wineries. Mediterranean climate. Napa River. Michelin-starred restaurants. Hot air balloon rides. Tasting rooms and vineyards.',fact:'California · Cabernet Sauvignon · 400+ wineries · Michelin dining · Wine tourism'},
  {n:'Yosemite Valley',la:37.73,ln:-119.60,sub:'USA · California · Yosemite NP',desc:'Glacier-carved valley in Yosemite National Park. El Capitan (900m granite monolith). Half Dome. Yosemite Falls (739m — tallest in NA). Bridalveil Fall. Giant sequoias. John Muir\'s "Range of Light."',fact:'Yosemite NP · El Capitan · Half Dome · Yosemite Falls (739m) · Giant sequoias'},
  {n:'Douro Valley',la:41.10,ln:-7.50,sub:'Portugal · UNESCO wine region',desc:'World\'s oldest demarcated wine region (1756). Port wine production. Terraced vineyards along Douro River. UNESCO World Heritage. Quintas (wine estates). Rabelo boats. Schist soil. Alto Douro wine region.',fact:'Oldest wine region (1756) · Port wine · Terraced vineyards · UNESCO · Douro River'},
  {n:'Kashmir Valley',la:34.00,ln:74.80,sub:'India · 15,948 km²',desc:'Fertile valley between Pir Panjal and Greater Himalayas. "Paradise on Earth." Dal Lake with houseboats and shikaras. Mughal Gardens (Shalimar, Nishat, Chashme Shahi). Srinagar (summer capital of J&K). Jhelum River flows through. Saffron fields in Pampore. Apple orchards, walnut trees, chinars. Shikara rides on Dal Lake. Snow-capped peaks. 2014 floods devastated the valley. Tourism and horticulture base of economy. Asian largest tulip garden (Indira Gandhi Memorial). Houseboat culture on Dal & Nigeen lakes. Sonamarg, Gulmarg, Pahalgam — hill resorts. Gondola at Gulmarg (highest cable car in India).',fact:'15,948 km² · "Paradise on Earth" · Dal Lake · Mughal Gardens · Srinagar · Saffron · Houseboats · Himalaya backdrop · Gulmarg gondola'},
  {n:'Kaghan Valley',la:34.80,ln:73.60,sub:'Pakistan · 155km long',desc:'Beautiful valley in Khyber Pakhtunkhwa, Pakistan. 155km long in the Mansehra district. Kunhar River flows through. Famous for pine forests, alpine meadows, waterfalls. Shogran (2,362m) — scenic plateau. Siri Paye meadow with wildflowers. Lake Saiful Muluk (3,224m) — legendary fairy tale lake. Lulusar Lake — headwaters of Kunhar. Babusar Top (4,173m) pass connects to Gilgit-Baltistan. Summer retreat from Lahore/Islamabad. 2019 tourism boom. Naran (2,409m) — main tourist town. Jeep safaris to remote areas. Ansoo Lake (teardrop-shaped). Threatened by deforestation and over-tourism.',fact:'155km · Khyber Pakhtunkhwa · Naran town · Saiful Muluk lake · Babusar Top · Shogran plateau'},
  {n:'Swat Valley',la:35.00,ln:72.40,sub:'Pakistan · 10,000 km²',desc:'"Switzerland of the East." Upper Swat (Mingora, Saidu Sharif, Malam Jabba). Swat River originates from Ushu. Buddhist heritage — ancient Gandhara civilization (2,000+ Buddhist sites). Butkara Stupa, Takht-i-Bahi monastery. Malam Jabba ski resort (Pakistan\'s only real ski resort). 2009 Taliban occupation — military operation cleared area. Tourism recovered post-2016. Ushu Forest, Mahodand Lake. Trout fishing in Swat River. Green valley with fruit orchards. White marble deposits. Alexander the Great passed through (battled tribes 326 BCE). Hindu Shahi temples in Udegram. Yousafzai tribe area (Malala Yousafzai from Swat).',fact:'10,000 km² · Switzerland of the East · Buddhist Gandhara ruins · Malam Jabba ski · Swat River · Malala\'s home'},
  {n:'Hunza Valley',la:36.33,ln:74.65,sub:'Pakistan · Gilgit-Baltistan',desc:'Famous valley in the Karakoram mountains. On the ancient Silk Road. Rakaposhi (7,788m), Ultar Sar (7,388m) — towering peaks. Baltit Fort (700 years old), Altit Fort. Karakoram Highway (KKH) passes through. Hunza River. Cherry and apricot blossoms in spring. World-renowned for long-lived inhabitants (centenarians). Burusho people — unique language (Burushaski). Ismaili Muslim community (Aga Khan). 3 districts: Upper, Central, Lower Hunza. Attabad Lake (formed by 2010 landslide — 20km long). Passu Cones (iconic jagged peaks). Gulmit, Karimabad, Aliabad — main towns. Eagle\'s Nest viewpoint. Highest paved road in Pakistan (Khunjerab Pass 4,733m to China).',fact:'Karakoram mountains · Silk Road · Rakaposhi 7,788m · Baltit Fort · Attabad Lake · Centenarians · Burusho · Ismaili · Karakoram Highway'},
  {n:'Coachella Valley',la:33.70,ln:-116.30,sub:'USA · California · Palm Springs',desc:'Desert valley in Riverside County, Southern California. Palm Springs resort city. Famous for Coachella Music Festival (April, Empire Polo Club). Indian Wells tennis tournament. Date palms (Medjool dates). San Andreas Fault runs through valley. Desert X art exhibition. Joshua Tree National Park nearby. Salton Sea at southern end. Golf capital (100+ courses). Mid-century modern architecture (Palm Springs). Agua Caliente Band of Cahuilla Indians (native land). 48°C summer temperatures. Oasis and springs in desert. Wind energy farms in San Gorgonio Pass.',fact:'Palm Springs desert · Coachella Festival · Date palms · San Andreas Fault · Joshua Tree NP · Mid-century modern · 100+ golf courses · 48°C summer'},
  {n:'Willamette Valley',la:44.80,ln:-123.00,sub:'USA · Oregon · 190km long',desc:'Fertile agricultural valley in western Oregon. Willamette River flows north to Columbia River (one of few north-flowing US rivers). Pinot Noir capital of the US — 700+ wineries. Portland, Salem, Eugene — major cities. Oregon Wine Country. Rich soil from Missoula Floods (12,000-15,000 years ago). Hazelnuts (99% of US crop). Grass seed production (world\'s largest). Mild Mediterranean climate — rainy winters. Covered bridges. Oregon State Capitol in Salem. University of Oregon (Eugene), Oregon State (Corvallis). Craft beer capital (Portland). Vanilla, silty loam soil ideal for wine. Filbert orchards. Bicycle-friendly corridor.',fact:'190km · Willamette River · Oregon\'s wine country · 700+ wineries · Pinot Noir · Portland to Eugene · Missoula Flood soil · Hazelnut capital'},,
  {n:'Great Rift Valley',la:-1,ln:36,sub:'East Africa · 6,000km long',desc:'One of Earth\'s largest geological features. 6,000km from Lebanon to Mozambique. Formed by tectonic plate divergence (African and Somali plates splitting). 7 million years from now will become ocean. Width 30-100km, depth hundreds of meters. Eastern and Western branches split around Lake Victoria. Volcanic peaks: Kilimanjaro (5,895m), Mount Kenya (5,199m), Mount Meru, Ngorongoro Crater. Lakes: Turkana, Manyara, Nakuru, Naivasha, Natron, Malawi, Tanganyika. Olduvai Gorge — 1.8M year old hominid fossils. Cradle of mankind in Rift Valley (Lucy, Homo habilis, Turkana Boy). 25+ active volcanoes. Ol Doinyo Lengai — active carbonatite volcano (blue-black lava). 2021-2022: volcanic activity. Hot springs, geysers, geothermal energy (Olkaria, Kenya). Ethiopia: Danakil Depression (hottest place on Earth). Afar Triple Junction — three tectonic plates meet. 2005: 8m wide fissure opened in Ethiopia. 2018: crack in Kenya\'s Narok County. 2023: satellite images show ongoing divergence (2-6cm/year). 800+ vertebrate species. Flamingos at Lake Nakuru and Lake Natron. Masai Mara and Serengeti ecosystems. 50M+ people live in Rift Valley — fertile soils from volcanic ash. Coffee, tea, wheat grown in highlands. 2010: Kenya Geothermal Development Company drilling. Rift Valley Lakes: 9 UNESCO World Heritage sites. Tectonic activity: earthquakes felt regularly. Gregory Rift named after 19th c. explorer John Walter Gregory.',fact:'6,000km · Lebanon to Mozambique · tectonic divergence (2-6cm/year) · will become ocean in 7M years · Kilimanjaro, Kenya · Olduvai Gorge (human origins) · Afar Triple Junction · Danakil Depression · 25+ active volcanoes · Lake Turkana, Nakuru, Tanganyika · 50M+ people · Great Rift Valley lakes'},
  {n:'Yosemite Valley',la:37.75,ln:-119.58,sub:'USA · California · 12km long',desc:'Glacial valley in Sierra Nevada, California. 12km long, 1.5km wide, 900m deep. World-famous for granite cliffs, waterfalls, giant sequoias. Yosemite National Park (UNESCO 1984). Iconic landmarks: El Capitan (2,308m — vertical granite monolith, world\'s tallest granite face). Half Dome (2,694m — iconic rock formation). Yosemite Falls (739m — tallest in North America). Bridalveil Fall (189m). Vernal Fall (97m), Nevada Fall (181m). Merced River flows through. Sentinel Rock (2,151m). Cathedral Rocks. Glacier Point viewpoint (2,199m) — panoramic valley view. 3,950km of trails. John Muir — naturalist who fought for preservation. Teddy Roosevelt camped with Muir in 1903 (led to National Park status). Ansel Adams — famous black-and-white photographs. El Capitan is world\'s premier big wall climbing destination (Free Solo documentary). Climbing season: April-October. 4.5M visitors/year. Traffic jams in summer. Yosemite Valley is only 7% of park but 90% of visitors. Tioga Road (CA-120) passes through high country (closed Nov-May). Tuolumne Meadows — subalpine zone. Giant sequoias (Mariposa Grove, 500 trees). Wildlife: black bear, mule deer, coyote, Sierra Nevada bighorn sheep, marmots, chickaree. 2022: Washburn Fire threatened Mariposa Grove. 2023: record snowfall (20m Tioga Pass). 12,000ft peaks surround valley. Hakone, Japan sister park. Yosemite Valley is actually a glacial trough carved by pre-glacial Merced River. 30+ waterfalls. 2018: El Capitan climbed in under 2 hours (speed record). 2019: Alex Honnold free solo (without ropes) — subject of Oscar-winning documentary. Camping reservations notoriously hard to get. Valley has 4 campgrounds (1,000+ sites). "The Incomparable Valley" — naturalist John Muir. Native American: Ahwahneechee people. 1851: first non-native entry (Mariposa Battalion). 1864: Yosemite Grant (first land set aside for public use — precedent for National Parks). 1890: National Park created. 1916: National Park Service created. 1920s: Curry Company established tourism. El Capitan climbers from 1950s to present. 1997: flood destroyed campgrounds (1,000+ people evacuated). 2023: Yosemite 160th anniversary.',fact:'12km · Sierra Nevada, California · Yosemite NP (UNESCO 1984) · El Capitan (2,308m granite monolith) · Half Dome · Yosemite Falls (739m tallest in North America) · Glacier Point · John Muir · Ansel Adams · 4.5M visitors/year · giant sequoias (Mariposa Grove) · Free Solo documentary · 3,950km trails'},
  {n:'Kashmir Valley',la:34,ln:74.8,sub:'India · 15,948 km² · Paradise on Earth',desc:'High-altitude valley in the Indian Himalayas. 15,948 km² surrounded by Pir Panjal and Himalayan ranges. 135km long, 32km wide. Srinagar (capital of Jammu and Kashmir) — famous for Dal Lake (houseboats, shikaras). Mughal gardens: Shalimar Bagh, Nishat Bagh, Chashme Shahi. Dal Lake — floating gardens (vegetable beds on reed rafts), houseboat tourism. Dal Lake 18km², 2M tourists/year. Gulmarg — ski resort (2,650m, highest gondola in Asia). Pahalgam — trekking, Betaab Valley, Aru Valley. Sonamarg — gateway to Ladakh. Amarnath Cave (Hindu pilgrimage, 500k+ pilgrims/year). Blue pine, deodar cedar forests. Saffron cultivated in Pampore (world\'s finest saffron). Apple orchards — Kashmir apples famous worldwide. Walnuts, almonds, cherries, apricots. Pashmina (cashmere) shawls — handwoven from Changthangi goat wool. Kashmiri handicrafts: carpets, papier-mâché, wood carving. Wular Lake — largest freshwater lake in India. 800+ springs. 500+ plant species. 200+ bird species. Himalayan brown bear, snow leopard, musk deer, Siberian ibex, Himalayan monal (state bird). Earthquakes: 2005 Kashmir earthquake (7.6M, 80k deaths). Political conflict: India-Pakistan dispute since 1947. Article 370 revoked in 2019 (state split into 2 territories). 2016-2018: frequent curfews and protests. 2020-2022: tourism slowly recovering. World\'s highest railway bridge (Chenab Bridge, 359m, opened 2022). Zero tourism in 2020 (COVID + political). 2023: record tourism (3M+). Mughal Emperor Jahangir famously said: "If there is a paradise on earth, it is this, it is this, it is this." 80% of Kashmir\'s economy from agriculture/horticulture. Kashmir is one of the most militarized regions in the world (500k+ Indian troops). 1989-present: insurgency and conflict. "Paradise on Earth" nickname.',fact:'15,948 km² · Indian Himalayas · Srinagar (Dal Lake houseboats) · Mughal gardens · Gulmarg ski gondola · Pahalgam · Amarnath Cave · Kashmir saffron · apple orchards · Pashmina shawls · "Paradise on Earth" · India-Pakistan dispute · Article 370 · Chenab Bridge · conflict zone · 3M+ tourists 2023'},
  {n:'Sulaiman Mountains Range',la:30,ln:69.5,sub:'Pakistan · Balochistan',desc:'Mountain range in Pakistan (Balochistan and Khyber Pakhtunkhwa). Forms the eastern edge of the Iranian plateau. Highest peak: Takht-e-Sulaiman (3,487m) — "Throne of Solomon." Legend: Prophet Solomon visited the peak. Sulaiman Range extends 450km north-south. Tribal territory: Pashtun Baloch, Kakar, Marri. Takt-e-Sulaiman is a major pilgrimage site (hundreds climb annually). Fort Munro — hill station (summer retreat). Ancient trade route connecting India to Central Asia. Bolan Pass (south) and Gomal Pass (north) — key passes. Bolan Pass: 88km long, used by Alexander the Great, British, and today\'s Pakistan army. Balochistan Liberation Army conflict. Natural gas field: Sui Gas Field (1952 — 1st in Pakistan). 1,000+ km². Wild pistachio, juniper forests (Ziarat Juniper Forest — 2nd oldest in world, 7,000 years). Balochistan\'s largest juniper ecosystem. Afghan refugees in camps. Extreme aridity — 100-250mm rainfall. Wildlife: Balochistan bear (endangered), markhor (national animal of Pakistan), urial, chinkara, wolf, striped hyena, honey badger, Caracal, Indian crested porcupine, Bengal monitor lizard. Sulaiman Markhor — largest of the markhor species. 250+ bird species. 1,000+ plant species. 2019: forest fires destroyed 10,000+ juniper trees. Ziarat Residency — Quaid-e-Azam Muhammad Ali Jinnah\'s last residence (summer 1948). UNESCO tentative list for Ziarat Juniper Forest. Oil and gas exploration conflicts. 2022: floods damaged Balochistan\'s infrastructure. 2024: development projects. Local folklore: "mystery of the throne." Potohar plateau to Indus River. Rakhshan, Dera Ghazi Khan divisions. Baloch separatist conflict since 2004. 2011: Sui gas field attacked. 4 major passes. Remote area — 90% rural.',fact:'450km range · Balochistan, Pakistan · Takht-e-Sulaiman (3,487m) · Throne of Solomon · Bolan Pass · Sui Gas Field (1952) · Ziarat Juniper Forest (7,000 years old) · Balochistan bear · Sulaiman markhor · Pashtun/Baloch tribes · Fort Munro · arid climate · conflict area'},
  {n:'Barossa Valley',la:-34.55,ln:138.95,sub:'Australia · South Australia',desc:'World-famous wine region in South Australia. 60km northeast of Adelaide. 912 km². 150+ wineries — some of oldest in Australia. Founded 1842 by German and Silesian settlers. Shiraz (Syrah) — Barossa Shiraz world-renowned (big, bold reds). Grenache, Mourvèdre, Cabernet Sauvignon, Riesling, Semillon. Penfolds Grange — Australia\'s most famous wine (1951 vintages sell for $100k+). Penfolds, Henschke, Torbreck, Rockford, Yalumba, Seppeltsfield. 400+ wine labels. Yalumba — oldest family-owned winery in Australia (1849). Seppeltsfield — 1878 Centennial Cellar (Tawny port). 1M+ visitors/year. Gourmet food: Maggie Beer\'s Farm Shop. Barossa Farmers Market. Lyndoch, Tanunda, Angaston — main towns. German heritage: Lutheran churches, German street names, butcheries (metwurst, bratwurst, leberkase). Barossa history: Prussian settlers brought old-world techniques. 1908: Barossa wine banned in Germany (too alcoholic). 1950s: fortified wines dominated. 1980s: premium table wine revival. 2018: drought reduced crop by 60%. 2021: COVID harvest labor shortage. Climate: Mediterranean — warm summers, mild winters. Ranges: Barossa Ranges to east — rain shadow. 7,000km² of Barossa zone. 3 sub-regions: Barossa Valley floor, Eden Valley (higher, cooler), and High Eden. Eden Valley Riesling — elegant. Barossa Signature Dish: pastilla-style Maggie Beer\'s. The Louise — luxury hotel. Barossa Vintage Festival (odd years, since 1947). Vasse Virgin olive oil, Barossa cheese, bakeries. 50+ cellar doors. Jacob\'s Creek, Wolf Blass major labels. Small wine region (1% of Australia\'s wine). First vines planted 1842 by Johann Gramp (Orlando Wines). Shiraz vines 100+ years old (survived phylloxera because of sandy soil). Barossa is America\'s favorite Australian wine region. 2024: climate resilience plan (heat, drought). 2021: frost damaged 30% of crop. 2020-2023: wine glut — oversupply crisis. Barossa tourism: $1.2B annually. 2,000+ residents employed in wine and tourism. 95% of Barossa wine exported globally.',fact:'912 km² · South Australia · 150+ wineries · Penfolds Grange · Shiraz (world-famous) · German heritage · Yalumba (oldest family winery 1849) · Seppeltsfield Centennial Cellar · 1M+ visitors/year · 1842 founded · 100+ year old vines · Mediterranean climate · wine tourism $1.2B/yr'}

];
D.w_pass = [
  {n:'Khyber Pass',la:34.12,ln:71.09,sub:'Pakistan/Afghanistan · 1,070m',desc:'Historic mountain pass connecting Afghanistan to Pakistan. Gateway to the Indian subcontinent. Used by Alexander, Mughals, British. Part of ancient Silk Road. Strategically vital for 2,000 years.',fact:'1,070m · Silk Road · Alexander/Ghaznavi/Mughals/British · Strategic pass · NATO supply route',pts:[{la:34.00,ln:71.30},{la:34.05,ln:71.20},{la:34.12,ln:71.09},{la:34.20,ln:70.95},{la:34.30,ln:70.80}]},
  {n:'Khunjerab Pass',la:36.85,ln:75.42,sub:'Pakistan/China · 4,693m',desc:'Highest paved border crossing in the world. Karakoram Highway between Pakistan and China. Part of China-Pakistan Economic Corridor (CPEC). Snow-covered 8 months/year. Endangered Marco Polo sheep.',fact:'4,693m (highest paved) · KKH/CPEC · Pakistan-China border · Snow 8 months · Wildlife',pts:[{la:36.60,ln:75.10},{la:36.70,ln:75.25},{la:36.85,ln:75.42},{la:37.00,ln:75.55},{la:37.20,ln:75.70}]},
  {n:'Brenner Pass',la:47.00,ln:11.50,sub:'Italy/Austria · 1,372m',desc:'Lowest Alpine pass, busiest north-south route across Alps. Brenner motorway and railway. Part of Roman Via Claudia Augusta (AD 46). EU transalpine freight corridor. 2.5M trucks/year.',fact:'1,372m (lowest Alpine) · Roman road · 2.5M trucks/year · Railway tunnel · EU corridor',pts:[{la:46.70,ln:11.40},{la:46.85,ln:11.45},{la:47.00,ln:11.50},{la:47.15,ln:11.55},{la:47.30,ln:11.55}]},
  {n:'St Gotthard Pass',la:46.55,ln:8.58,sub:'Switzerland · 2,106m',desc:'Key Alpine pass connecting north and south Switzerland. Gotthard Base Tunnel (world\'s longest rail tunnel 57km). William Tell legend. Devils Bridge. Swiss Confederacy origin.',fact:'2,106m · Gotthard Base Tunnel (57km) · Swiss independence · William Tell · Devil\'s Bridge',pts:[{la:46.40,ln:8.55},{la:46.48,ln:8.57},{la:46.55,ln:8.58},{la:46.62,ln:8.58},{la:46.70,ln:8.55}]},
  {n:'Karakoram Pass',la:35.52,ln:77.82,sub:'India/China · 5,540m',desc:'High-altitude pass connecting Ladakh to Xinjiang. Ancient trade route for silk, jade, spices. Historically part of the Silk Road. Closed since 1967. Permafrost and extreme cold.',fact:'5,540m · Silk Road · Ladakh-Xinjiang · Closed since 1967 · Extreme cold',pts:[{la:34.80,ln:77.60},{la:35.10,ln:77.70},{la:35.52,ln:77.82},{la:35.80,ln:77.90},{la:36.00,ln:78.00}]},
  {n:'Nathu La',la:27.38,ln:88.82,sub:'India/China · Sikkim-Tibet · 4,310m',desc:'Border pass between Sikkim (India) and Tibet (China). Reopened in 2006 for trade after 44 years closure (since 1962 war). Part of ancient Silk Road. Buddhist prayer flags line the pass. Permits required. Trade route for barter system.',fact:'4,310m · India-China border · Reopened 2006 · Silk Road · Border trade · 1962 war closure',pts:[{la:27.20,ln:88.70},{la:27.30,ln:88.78},{la:27.38,ln:88.82},{la:27.45,ln:88.85},{la:27.55,ln:88.90}]},
  {n:'Stelvio Pass',la:46.53,ln:10.45,sub:'Italy · 2,757m',desc:'Highest paved mountain pass in the Eastern Alps. 48 hairpin turns on the northern side. Connects Valtellina (South Tyrol) to Trafoi. Part of the Giro d\'Italia cycling race legendary route. Built 1820-1825 by Austrian Empire. Stelvio National Park. Prosti beer famous here.',fact:'2,757m (highest in Eastern Alps) · 48 hairpins · Giro d\'Italia cycling · Austrian-built 1825'},
  {n:'Furka Pass',la:46.57,ln:8.43,sub:'Switzerland · 2,429m',desc:'High Alpine pass connecting Andermatt to Gletsch. Famous from James Bond film "Goldfinger" (1964) — the roadside hotel and hairpin. Furka Steam Railway (historic cogwheel). Rhône Glacier nearby (source of Rhône River). Swiss Alps postcard scenery. Summer only (June-October).',fact:'2,429m · James Bond Goldfinger · Furka Steam Railway · Rhône Glacier · Swiss Alps iconic'},
  {n:'Great St Bernard Pass',la:45.87,ln:7.18,sub:'Switzerland/Italy · 2,469m',desc:'One of the oldest Alpine passes — used since Bronze Age. Hannibal possibly crossed here with elephants (218 BCE). Named after St Bernard of Menthon (11th c.). Famous for St Bernard rescue dogs (barrel around neck). Hospice founded 1049. Napoleon\'s army crossed 1800 with 40,000 troops.',fact:'2,469m · Ancient (Bronze Age) · St Bernard dogs · Hospice 1049 · Napoleon 1800 · Hannibal possible route'},
  {n:'Zoji La',la:34.28,ln:75.47,sub:'India · J&K · 3,528m',desc:'Dangerous mountain pass connecting Kashmir Valley to Ladakh on Srinagar-Leh highway. Narrow, avalanche-prone, open only June-November. Known as "one of the most dangerous roads in India". Dras (coldest place in India) nearby. Strategic military supply route. Extreme conditions.',fact:'3,528m · Srinagar-Leh highway · Most dangerous road · Avalanches · Dras cold · Military route',pts:[{la:34.10,ln:75.38},{la:34.18,ln:75.42},{la:34.28,ln:75.47},{la:34.35,ln:75.52},{la:34.42,ln:75.58}]},
  {n:'Khardung La',la:34.28,ln:77.60,sub:'India · Ladakh · 5,359m',desc:'One of the highest motorable passes in the world. Connects Leh to Nubra Valley. Built by Border Roads Organisation. Gateway to Siachen Glacier. Extreme cold and low oxygen. Popular with cyclists.',fact:'5,359m (highest motorable) · Leh-Nubra road · Siachen gateway · BRO built · Extreme altitude',pts:[{la:34.10,ln:77.50},{la:34.18,ln:77.55},{la:34.28,ln:77.60},{la:34.35,ln:77.63},{la:34.45,ln:77.68}]},
  {n:'Chang La',la:33.55,ln:78.65,sub:'India · Ladakh · 5,360m',desc:'Second highest motorable pass. Connects Leh to Changthang region. Route to Pangong Tso lake. Mars-like landscape. Marmots, kiang (Tibetan wild ass). Extreme cold. Slightly higher than Khardung La by recent surveys.',fact:'5,360m (2nd highest) · Leh-Changthang · Pangong Tso route · Marmots · Kiang'},
  {n:'Marsimik La',la:34.56,ln:78.52,sub:'India · Ladakh · 5,582m',desc:'Possibly the highest motorable pass in the world (measured). Remote route to Durbuk and Changthang. Less trafficked. Used by Indian military. Extreme cold even in summer. Stunning views of Karakoram range.',fact:'5,582m (possibly highest in world) · Ladakh · Military route · Remote · Karakoram views'},
  {n:'Donner Pass',la:39.30,ln:-120.37,sub:'USA · California · 2,151m',desc:'Mountain pass in Sierra Nevada. Named after the Donner Party (1846-47) who resorted to cannibalism when stranded. Major rail and road corridor. Transcontinental railroad route. Pacific Crest Trail crossing. Ski resort area.',fact:'2,151m · Donner Party tragedy (1846) · Sierra Nevada · Transcontinental railroad · Skiing'},
  {n:'Montgenèvre',la:44.93,ln:6.72,sub:'France/Italy · 1,854m',desc:'Ancient Alpine pass connecting France to Italy. Used since prehistoric times. Part of route from Turin to Gap. Roman road. Ski resort town. Lowest of main Alpine passes. Hannibal may have crossed here with elephants.',fact:'1,854m · Ancient pass · Roman road · Ski resort · Hannibal possible route'},
  {n:'Mont Cenis',la:45.26,ln:6.90,sub:'France/Italy · 2,084m',desc:'Historic Alpine pass connecting Savoy to Piedmont. Napoleon built road here (1803-1810). Lake Mont Cenis. Fréjus Road Tunnel bypasses pass. Hannibal crossing theory. Iron Age and Roman usage. Alpine scenery.',fact:'2,084m · Napoleon road (1810) · Fréjus tunnel bypass · Lake Mont Cenis · Hannibal theory'},
  {n:'Rohtang Pass',la:32.37,ln:77.25,sub:'India · Himachal · 3,978m',desc:'High mountain pass connecting Kullu Valley to Lahaul and Spiti. 3,978m on Manali-Leh highway. "Rohtang" meaning "pile of dead bodies" (many deaths in snow). Atal Tunnel (9km, 3,100m) bypasses the pass for year-round connectivity. Snow-covered 8 months/year. Beas River origin. Sissu and Keylong on Leh side. Solang Valley (skiing) near Manali. Gaffer glacier fall. 10,000+ vehicles/day in summer. Permit needed for crossing (beyond Rohtang — restricted areas for inner line). Glacier recession observed. Over-tourism causing waste, traffic jam 8 km. Pollution from vehicle emissions on snow (black carbon). 15,000+ vehicles every summer day. Himachal Tourism boom. Snow sliding off road dangerous. Seri, Kothi villages below. Pass closed Nov-May due to heavy snow. Temperature -30°C in winter. World\'s highest hotel at nearby Koksar. Sissu waterfall. Atal Tunnel (10,000ft+) changed travel. Lahaul Spiti Tourism surged.',fact:'3,978m · Manali-Leh highway · Atal Tunnel bypass · "Pile of dead bodies" · Snow 8 months · Beas origin · Over-tourism'},
  {n:'Jelep La',la:27.34,ln:88.87,sub:'India/China · Sikkim-Tibet · 4,210m',desc:'Mountain pass connecting Sikkim (India) to Tibet (China). 4,210m on the ancient Silk Road. Used by British India-Yatung (Tibet) trade. 1904 Younghusband Expedition to Lhasa passed through. 1950 China-India trade through Jelep La. Closed after 1962 Sino-Indian War. Nathu La (13km north) reopened 2006 — Jelep La remains closed. Butterfield and tea route from Darjeeling. British built a road to the pass from Gangtok (until 1950s). Lhasa to Gangtok route. Rare: pheasant species Grey peacock pheasant, blood pheasant, satyr tragopan in surrounding forest. Permafrost region. Sikkim\'s traditional corridor. Cold desert in Tibetan plateau beyond. Rhododendron and alpine flower meadows. Tangu village base. Kanchenjunga views. Tsomgo Lake (Changu) nearby sacred. Mountain pass guard. 2017 Doklam standoff — Nathu La region tensions. Remote. Tibetan plateau views. 4,210m. Steep climb from Sikkim sides. Zemu glacier valley adjacent. Green Lake at base. Very few trekkers because of military restrictions (inner line permit needed). Green Lake trek was possible before military closure. 1,200 year old story: Buddhist saint Padmasambhava. Historical tea route for Tibetan butter tea.',fact:'4,210m · Sikkim-Tibet · Silk Road · Younghusband 1904 · Closed since 1962 war · Butter-tea trade route · Kanchenjunga views · Military zone'},
  {n:'Shipki La',la:31.60,ln:78.57,sub:'India/China · Himachal-Tibet · 3,930m',desc:'Border pass connecting Kinnaur (Himachal) to Tibet (China). 3,930m elevation. Alternative to Nathu La but higher-altitude trade. Sutlej River flows through pass from Tibet to India (originates at Lake Manasarovar). Traditional trade route: wool, salt, borax from Tibet to India. Shipki La crossing: Indian army and Chinese PLA face at border. Trade reopened 1990s (barter trade). 1962 war closed India-China passes. Trade: yak tails, Tibetan carpets, Kesar (saffron). Tibetan wool (Pashmina) route? Yes—also route for Pashmina wool from Tibet. Khab village — confluence of Spiti and Sutlej. Landscape: arid, stark, high altitude cold desert. 10 km from Indian Army ITBP outpost. Spiti Valley landscape. 3,930m — windy. Sutlej gorge — deepest in Himachal. Ashwani Khad tributary junction. Nako village nearby (ancient monastery). Barter market in Khab village. Local Kinnauri and Tibetan traders. Kirghiz people occasional. Border Haat tentatively planned. No motorable road to pass (last 15 km on foot). ITBP (Indo-Tibetan Border Police) guards. Pooh — last village. Chinese side: completely uninhabited — furthest point of Ngari prefecture (Ali). Shipki La base camp location. Short trade window (Aug-Sept). Yak, dzos (yak-cow cross) used for transport. 4,800 m total? No — 3,930 m actual. Occasional snow leopard and ibex in region.',fact:'3,930m · Himachal-Tibet · Sutlej River source · Barter trade route · Closed 1962, reopened 1990s · ITBP border post · Indo-China border pass · Spiti akin'},,
  {n:'Khardung La',la:34.28,ln:77.6,sub:'India · Ladakh · 5,359m',desc:'One of the highest motorable passes in the world. 5,359m in Ladakh, India. Connects Leh to Nubra Valley and Shyok River valley. Built by Border Roads Organisation (BRO) in 1976. Part of the historic Silk Road route to Central Asia (Kashgar). 40km from Leh. Nubra Valley — sand dunes, double-humped Bactrian camels. Khardung Village — start. Diskit Monastery — oldest in Nubra. Extreme cold -40°C winter. Snow clearance in summer only (June-Oct). Altitude sickness risk — oxygen 50% of sea level. Indian Army supplies convoys. Siachen Glacier access via this route. 2017: BRO blacktopped the road. 2023: upgraded to 2-lane. 120km from Leh to Nubra. Magnetic Hill optical illusion on route. Khardung La means "pass of the lower castle." 30 hairpin bends. Military checkpoints. 80,000+ tourists cross annually. Highest-altitude petrol pump nearby. Changthang Wildlife Sanctuary. Hemis National Park (snow leopard).',fact:'5,359m · one of highest motorable passes · Ladakh · Leh to Nubra Valley · BRO built 1976 · Silk Road route · Siachen Glacier access · Bactrian camels in Nubra · altitude risk · 30 hairpin bends · -40°C winter · Indian Army route'},
  {n:'Stelvio Pass',la:46.53,ln:10.45,sub:'Italy · 2,757m · Highest paved pass in Eastern Alps',desc:'Highest paved mountain pass in the Eastern Alps. 2,757m in South Tyrol, Italy (near Swiss border). 48 hairpin turns on the north side — famous for cycling. One of the most famous cycling climbs in the world — Giro d'Italia legend. 24.3km long with 1,542m elevation gain. Average gradient 6.3% (max 12%). Classic route: Bormio to Stelvio. 3 peaks: the pass connects Valtellina (west) to Val Venosta (east). Glacier: Stelvio Pass area has Ortler Cevedale group — glaciers. Stelvio National Park (Parco Nazionale dello Stelvio) — 130,000 hectares. Red deer, chamois, ibex, marmots, golden eagles. WWI trenches and fortifications — Ortler front (1915-1918) highest battlefield of WWI. Ski resort: Trafoi and Bormio valleys. Bormio — thermal springs. Open: June to October (snow clears). Cycling events: Stelvio bike day (closed to cars once/year). 12,000 cyclists climb annually. Mortirolo Pass nearby — even steeper. Gavia Pass nearby. Snow depth 10m in winter. 2019 Giro d'Italia stage 16 finish on Stelvio. Umbrail Pass connects to Switzerland. Traces of "White War" (WWI glacier warfare). Parking at summit — panoramic view of Ortler Alps. Museo della Guerra (war museum) at pass. 1km tunnel at summit.',fact:'2,757m · highest paved pass in Eastern Alps · 48 hairpin turns · Giro d'Italia icon · Bormio to Trafoi · WWI Ortler front (highest battlefield) · Stelvio National Park · chamois, ibex, eagles · open June-October · 12,000 cyclists/year · Mortirolo & Gavia nearby'},
  {n:'Karakoram Pass',la:35.51,ln:77.82,sub:'India/China · 5,540m',desc:'Historic Silk Road pass between India (Ladakh) and China (Xinjiang). 5,540m. Used for centuries by Central Asian trade caravans — silk, spices, tea, horses, jade. Closed to civilians since 1950s due to India-China border disputes. Part of Aksai Chin disputed territory. Extreme -40°C in winter — one of the coldest places. Snow cover 8-9 months. Opens only July-September for military convoys. 50km north of Daulat Beg Oldie (DBO airstrip — India northernmost). 350km from Leh. Wildlife: Tibetan wild ass, snow leopard, blue sheep, Tibetan wolf. 19th c. explorers: Moorcroft, Younghusband, Hedin. "Karakoram" = "black gravel" in Turkic.',fact:'5,540m · historic Silk Road pass · India/China border · Leh to Kashgar route · closed since 1950s · Aksai Chin dispute · -40°C · DBO airstrip · snow leopard, bharal, kiang · explorers: Younghusband, Hedin'},
  {n:'Changla Pass',la:33.78,ln:77.9,sub:'India · Ladakh · 5,360m',desc:'High mountain pass in Ladakh, India. 5,360m. Connects Leh to Changthang region and Pangong Tso lake. One of the highest motorable passes in the world. 3rd highest in Ladakh after Khardung La and Saser La. Route to Pangong Tso (famous blue lake, 134km long, 4,350m). Changthang Wildlife Sanctuary — Tibetan wild ass (kiang), black-necked crane, Tibetan antelope (chiru), Tibetan fox, snow leopard, marmot. Changthang is cold desert — one of highest inhabited regions (4,500m+). Changpa nomadic shepherds — pashmina goat wool. 2021: India-China border tensions — Changthang region was key area of standoff (Galwan Valley, Pangong Tso). Indian Army deployment along LAC. Road: Leh to Changla is 105km. Changthang means "northern plains." 2 hours from Leh. 30+ hairpins. Pass called "Changla" means "pass to the north." Military checkpoints. Rafting on Indus River on return. Hemis High Altitude National Park. Rare species: Tibetan argali (largest wild sheep). World's highest lake: Tso Moriri (4,522m) in Changthang. Tso Kar lake. Changthang is home to rare chiru — hunted for shahtoosh wool (banned). Nomadic Changpa live in yak wool tents. Pashmina (cashmere goat) wool — the finest in the world. Record cold: -50°C in winter. 100+ species of birds. Black-necked crane — state bird of Ladakh. Snow leopards tracked by cameras. Kharnak village, Korzok monastery. Tourists require permits (Inner Line).',fact:'5,360m · Ladakh · Leh to Pangong Tso route · 3rd highest motorable in Ladakh · Changthang Wildlife Sanctuary · kiang (Tibetan wild ass) · black-necked crane · Changpa nomads · pashmina goats · India-China border standoff area · Pangong Tso lake · Inner Line permit required · -50°C in winter'},
  {n:'Khyber Pass',la:34.1,ln:71.08,sub:'Pakistan/Afghanistan · 1,070m',desc:'Famous mountain pass connecting Pakistan to Afghanistan. 1,070m at lowest point. 53km long through the Spin Ghar mountains. Historic invasion route to India — used by: Alexander the Great (327 BCE), Mahmud of Ghazni (1000 CE), Genghis Khan's Mongols (1221), Timur (1398), Babur (1526 — founded Mughal Empire), Nadir Shah (1739), Ahmed Shah Abdali (1761), British (1839-1919). British fought three Anglo-Afghan Wars here (1839-42, 1878-80, 1919). Fort Jamrud — British fort at entrance (1823). Landi Kotal — highest point (1,070m). Landi Kotal bazaar — famous gun market. Torkham — Pakistan-Afghanistan border crossing. NATO supply route to Afghanistan (2001-2021). 20,000+ vehicles/month during ISAF period. Khyber Railway — 52km, 34 tunnels, 92 bridges, 4 zigzag reverses — "Khyber Pass Railway" (closed 2006). Zakka Khel, Ali Masjid, Shagai — forts along pass. Kuki Khel, Malik Din Khel — Afridi Pashtun tribes. Khyber Rifles — paramilitary force (since 1878). Caravan trade route for 2,000+ years — silk, spices, carpets, tea, salt. "Khyber Pass" became slang for any mountain pass in English. 2014: Pakistan Army took over security — militant insurgency. 2020: border reopened after COVID. 100,000+ civilian crossings annually. Pashtun culture, hospitality, tribal code. Khyber Pass is the "Gateway to the Indian subcontinent." US$3B in trade per year (unofficial). 700+ years of written history. Alexander's army refused to go further at the Beas River (326 BCE). Khyber Pass is 53km long. Khyber Express train service. Khyber steam safari (tourist train). 2023: restoration plans for Khyber Railway. Pakistan Frontier Corps. 2021 Taliban takeover of Afghanistan increased border tensions. 20,000+ Afghan refugees cross monthly. Drug smuggling (opium) from Afghanistan. Khyber Pass history museum at Fort Jamrud.',fact:'1,070m · 53km · Pakistan-Afghanistan · historic invasion route to India · Alexander the Great · Babur · British Anglo-Afghan Wars · Khyber Rifles · Torkham border crossing · NATO supply route · Khyber Railway (34 tunnels, 92 bridges) · Pashtun tribes · "Gateway to subcontinent" · 2,000+ years of trade'},
  {n:'Brenner Pass',la:47,ln:11.5,sub:'Italy/Austria · 1,374m · Lowest Alpine pass',desc:'Lowest Alpine pass (1,374m). Connects Italy (South Tyrol) to Austria (Tyrol). Main route across the Alps between Innsbruck (Austria) and Bolzano/Verona (Italy). 70% of Alpine transit trade uses Brenner. Brenner Base Tunnel — 55km railway tunnel under construction (opening 2032) — will be longest underground railway in world. A22/E45 motorway — heavy truck traffic (2M+ trucks/year). Environmental concerns: air pollution in Wipptal valley. Brenner Railway — opened 1867. 30% of EU north-south freight crosses Brenner. Roman road Via Claudia Augusta (15 CE) — first road across Alps. Brenner name from "Brenno" (Celtic chieftain who sacked Rome 390 BCE). Holy Roman Empire route — medieval emperors crossed here. Brenner Pass was border between Austrian Empire and Italy after WWI (1919 Treaty of St. Germain). 1943: Mussolini and Hitler met at Brenner (Axis alliance). 1955: South Tyrol autonomy agreement. Ski resorts: Sterzing, Franzensfeste, Brenner. Brennerbad thermal springs. Iceman Ötzi (5,300-year-old mummy discovered 1991) found near here (Ötztal Alps). Alpine scenery, glacial valleys. Ötzi found in Schnalstal valley. Innsbruck — Olympic Winter City (1964, 1976). 16km Brenner tunnel for motorway (opened 1974). Transit traffic causes congestion — 50km truck queues reported. Brenner Corridor — EU TEN-T priority project. Climate change: glaciers retreating — Stubai and Ötztal glaciers losing 1% mass/year. South Tyrol — German-speaking minority in Italy. Tirolean culture, castles, apple orchards. 2018: Bergisel ski jump near Innsbruck. 12M+ vehicles/year cross Brenner. 50km length motorway tunnel planned (Brenner Base Tunnel). Brenner is busiest Alpine crossing.',fact:'1,374m (lowest Alpine pass) · Italy-Austria border · busiest Alpine crossing (70% of transit) · 2M+ trucks/year · Roman Via Claudia Augusta (15 CE) · Brenner Base Tunnel (55km, opening 2032) · Ötzi the Iceman found nearby · Hitler-Mussolini meetings · Innsbruck-Bolzano route · South Tyrol German minority · truck congestion & pollution · Alpine railway 1867'}

];
D.glacier = [
  {n:'Siachen Glacier',la:35.40,ln:77.10,sub:'India/Pakistan · 76km',desc:'World\'s highest battlefield (5,400m). 76km long in eastern Karakoram. "Third Pole" — largest glacier outside polar regions. Indian Army controls since 1984. Extreme cold (-50°C). Thousands lost to avalanches, not combat.',fact:'76km (longest in Karakoram) · Highest battlefield (5,400m) · -50°C · Operation Meghdoot 1984'},
  {n:'Gangotri Glacier',la:30.85,ln:79.10,sub:'India · Uttarakhand · 30km',desc:'Source of Ganges River (Bhagirathi). One of the largest Himalayan glaciers (30km). Gaumukh (Cow\'s Mouth) — the snout. Retreating at 20m/year. Hindu pilgrimage. Tapovan meadows.',fact:'30km · Ganges source · Gaumukh · 20m/year retreat · Pilgrimage'},
  {n:'Vatnajökull',la:64.42,ln:-16.78,sub:'Iceland · 8,100 km²',desc:'Largest glacier in Europe (8% of Iceland). Covers active volcanoes (Bárðarbunga, Grímsvötn). Subglacial eruptions cause jökulhlaups (glacial floods). Ice caves popular with tourists. Vatnajökull National Park (UNESCO).',fact:'8,100 km² (largest in Europe) · Volcano underneath · Jökulhlaups · Ice caves · UNESCO'},
  {n:'Lambert Glacier',la:-71.00,ln:70.00,sub:'Antarctica · 400km long',desc:'World\'s largest glacier. 400km long, 100km wide. Drains 8% of Antarctic ice sheet. Flows into Amery Ice Shelf. Ice velocity up to 1km/year. Named after Australian geographer.',fact:'400km (world\'s largest) · 100km wide · 8% of Antarctic ice · Amery Ice Shelf'},
  {n:'Baltoro Glacier',la:35.70,ln:76.30,sub:'Pakistan · 62km',desc:'One of the longest glaciers outside polar regions. Central Karakoram. Gateway to K2 (2nd highest peak) and Concordia. Massive ice intersection. Used by climbers for K2 expeditions.',fact:'62km · K2 gateway · Concordia · Karakoram · Climber route'},
  {n:'Perito Moreno Glacier',la:-50.48,ln:-73.05,sub:'Argentina · 250 km²',desc:'One of few advancing glaciers worldwide. Los Glaciares National Park (UNESCO). 30km long, 5km wide. Ice dam bursts create dramatic rupture events every 4-5 years. Patagonian ice field.',fact:'250 km² · Advancing (rare!) · Ice dam bursts · UNESCO · Patagonia'},
  {n:'Aletsch Glacier',la:46.56,ln:8.15,sub:'Switzerland · 86km² · 23km',desc:'Largest Alpine glacier. Swiss Alps Jungfrau-Aletsch UNESCO site. 27 billion tons of ice. Konkordiaplatz ice confluence. Retreating rapidly — could lose 90% by 2100 if warming continues.',fact:'23km (longest Alpine) · UNESCO · Konkordiaplatz · 27B tons · Rapid retreat'},
  {n:'Fedchenko Glacier',la:39.00,ln:77.00,sub:'Tajikistan · 77km',desc:'Longest glacier outside polar regions. Pamir Mountains, Tajikistan. 77km long, 2-3km wide. Fedchenko Glacier feeds Amu Darya river system. Discovered 1878. Rare snow leopard habitat. Mass balance studied since 1970s.',fact:'77km (longest outside poles) · Pamir Mountains · Amu Darya source · Snow leopard · 1878 discovery'},
  {n:'Hubbard Glacier',la:60.50,ln:-139.40,sub:'USA · Alaska · 122km',desc:'Largest tidewater glacier in North America. 122km long. Flows into Disenchantment Bay near Yakutat. Frequently calves icebergs. Advancing — rare among glaciers. Hubbard Glacier has been advancing for 100+ years.',fact:'122km · Largest tidewater in NA · Advancing (rare) · Alaska · Calves icebergs'},
  {n:'Jostedalsbreen',la:61.70,ln:6.90,sub:'Norway · 487 km²',desc:'Largest glacier in continental Europe. 487 km² in Vestland county, Norway. 50+ glacier arms including Briksdalsbreen and Nigardsbreen. Popular hiking destination. Jostedalsbreen National Park. Rapid retreat since 2000.',fact:'487 km² (largest in Europe) · Norway · 50+ glacier arms · National park · Rapid retreat'},
  {n:'Fox & Franz Josef Glaciers',la:-43.50,ln:170.20,sub:'New Zealand · 13km each',desc:'Twin glaciers descending from Southern Alps to temperate rainforest. One of few glaciers that reach sea level in temperate zone. Fox Glacier township. Franz Josef village. Helicopter tours. Rapid retreat in recent decades.',fact:'13km · NZ Southern Alps · Temperate rainforest · Helicopter tours · Rapid retreat'},
  {n:'Biafo Glacier',la:35.70,ln:75.80,sub:'Pakistan · 67km',desc:'One of the longest glaciers outside polar regions. Central Karakoram, Pakistan. 67km long. Confluence with Hispar Glacier at 5,128m (Hispar Pass) — longest glacial system outside poles. K2 base camp on route. Snow lake.',fact:'67km · Karakoram, Pakistan · Hispar La pass · K2 trek route · Snow lake'},
  {n:'Pasterze Glacier',la:47.07,ln:12.73,sub:'Austria · 8km (shrinking)',desc:'Longest glacier in Austria (8km). Eastern Alps, Grossglockner. Retreating rapidly — lost 50% volume since 1850. Grossglockner High Alpine Road tourist route. Flows into Möll river valley. Kaiser-Franz-Josefs-Höhe viewpoint. Ice thickness ~100m. Austria\'s iconic glacier.',fact:'8km · Austria\'s longest · Grossglockner · 50% volume lost · Grossglockner Road'},
  {n:'Mer de Glace',la:45.93,ln:6.93,sub:'France · Mont Blanc · 7km',desc:'Largest glacier in France (7km). Mont Blanc massif, Chamonix. Major tourist attraction — Montenvers train since 1909. Ice cave carved annually for visitors. Has retreated 1.2km since 1850. Thinned by 140m. Flows from Mont Blanc toward Chamonix valley. Source of Arveyron river. English Romantic poets visited (Shelley, Byron). Famous for early mountaineering.',fact:'7km · France\'s largest · Chamonix · Montenvers train · 1.2km retreat since 1850'},
  {n:'Tasman Glacier',la:-43.58,ln:170.25,sub:'New Zealand · 27km',desc:'Longest glacier in New Zealand. Southern Alps, Aoraki/Mount Cook National Park. 27km long, expanding at terminus into Tasman Lake (formed since 1973). Rapid retreat — 6km since 1990. Icebergs in Tasman Lake (tourist boat trips). Tasman Valley. Terminal lake expanding each year — one of the fastest-retreating glaciers globally. Moraine walls along valley.',fact:'27km · NZ\'s longest · Aoraki/Mt Cook · Tasman Lake icebergs · Rapid retreat'},
  {n:'Khumbu Glacier',la:27.97,ln:86.83,sub:'Nepal · Everest region · 17km',desc:'Highest glacier in the world (Khumbu Icefall at 4,900-5,400m). Everest base camp sits at its foot. 17km long in Nepal\'s Khumbu region. Flows from Everest\'s Western Cwm. Icefall is most dangerous stage of Everest climb — constantly moving crevasses and seracs. Elevation range: 7,600m to 4,900m. Moraine debris covers lower section. Used by all Everest expeditions. Rapid thinning observed. Prayer flags and memorials at base camp.',fact:'17km · Highest glacier in world · Everest base camp · Khumbu Icefall · 4,900-7,600m range'},
  {n:'Thwaites Glacier',la:-75.50,ln:-106.75,sub:'Antarctica · 192km wide',desc:'"Doomsday Glacier" — Antarctica\'s most critical glacier. 192km wide, flows into Amundsen Sea. Size of Florida. Responsible for 4% of global sea level rise already. If fully collapses, could raise sea levels by 65cm. Thwaites "tongue" and ice shelf breaking up. Warm ocean water melting from below. 2020s research (International Thwaites Glacier Collaboration). Grounding line retreating. Could trigger West Antarctic Ice Sheet collapse. Named after Frederik E. Thwaites (American geologist).',fact:'192km wide · "Doomsday Glacier" · Florida-sized · 65cm sea level threat · Warm water melting'},
  {n:'Sermeq Kujalleq (Jakobshavn)',la:69.10,ln:-49.90,sub:'Greenland · 65km calving front',desc:'Fastest-moving glacier in the world. Greenland ice sheet, near Ilulissat. Calves 35 billion tonnes of icebergs annually. Produced iceberg that sank Titanic (from this glacier). Speed: 40m/day (fastest ever recorded). Ilulissat Icefjord UNESCO site. 65km long, 6km wide. Rapid acceleration since 1990s — doubled speed. Front has retreated 40km in 200 years. Most studied glacier in Greenland. Contributes 1mm/yr to global sea level rise. Sermeq Kujalleq means "southern glacier" in Greenlandic.',fact:'Fastest glacier (40m/day) · Greenland · Titanic iceberg source · Ilulissat UNESCO · 35B tonnes/year'},
  {n:'Morteratsch Glacier',la:46.40,ln:9.95,sub:'Switzerland · Engadin · 7km',desc:'Largest glacier in the Bernina Range, eastern Swiss Alps. 7km long. Morteratsch and Pers glaciers separate. Diavolezza cable car viewpoint. Morteratsch railway station on Bernina Line (UNESCO). Retreating rapidly — 2.3km since 1900. New lake formed at terminus (Lej da la Basslgia). Morteratsch index measurement since 1878 — one of longest glacier records. Alpine ibex, marmots in surrounding area. Trails and glacier hiking.',fact:'7km · Bernina Range · Engadin, Switzerland · Diavolezza view · 2.3km retreat since 1900'},,
  {n:'Lambert Glacier',la:-73,ln:70,sub:'Antarctica · 400km long · 100km wide',desc:'World\'s largest glacier. 400km long, 100km wide, 2,500m thick. Flows from interior of East Antarctica into Amery Ice Shelf. Discovered 1956-1957 by Australian Antarctic Division aerial surveys. Named after Bruce Lambert (Australian cartographer). Ice moves 300-600m/year. Drains ~10% of East Antarctic Ice Sheet. 5,000m deep in places below sea level. Contains enough ice to raise sea level 5m if melted. Vulnerable to climate change — ocean warming undercuts ice shelf. Lambert-Amery system is Antarctica\'s largest glacier drainage system. Research stations: Davis, Mawson, Zhongshan nearby. Ice streams: Fisher, Mellor, Scylla intersect. 2023: Lambert Glacier thinning rate accelerating. 85% of outflow via ice streams. Bedrock below sea level — deep basin (1,500m below). 2007 satellite measurements show 30cm/year surface lowering.',fact:'400km x 100km (largest glacier) · Antarctica · Amery Ice Shelf · 2,500m thick · 300-600m/year flow · 10% of East Antarctic Ice Sheet drainage · thinning accelerating · Australian Antarctic Division · deep subglacial basin'},
  {n:'Vatnajökull Glacier',la:64.4,ln:-16.7,sub:'Iceland · 8,100 km² · Largest in Europe',desc:'Largest glacier in Europe by volume (8,100 km², 3,400 km³ ice). Covers 8% of Iceland. 1,000m thick in places. Ice cap with multiple outlet glaciers. 30+ glacial tongues (Skaftafellsjökull, Svínafellsjökull, Vatnajökull, etc.). Volcanic activity under the ice — 5 active subglacial volcanoes. Grímsvötn (1996, 2011 eruptions) — catastrophic jökulhlaup (glacial outburst flood) in 1996 destroyed bridge. Bárðarbunga volcano (2014-15 eruption) — largest basalt eruption in 230 years. Öræfajökull — highest peak in Iceland (2,110m). Jökulsárlón — glacial lagoon with icebergs (tourist attraction, boat tours). Diamond Beach — icebergs wash up on black sand. Skaftafell National Park (part of Vatnajökull National Park, UNESCO 2019). Glacier hiking, ice climbing, ice caving (natural ice caves in winter). Blue ice caves — stunning photography. Hiking trails: Svartifoss (black waterfall surrounded by basalt columns). 1M+ visitors/year. 2023: largest ice cave collapse in 10 years. Meltwater rivers: Skeiðará, Jökulsá á Fjöllum. Climate change: glacier retreating rapidly — 15% volume lost since 1890. 2019: Vatnajökull National Park designated UNESCO World Heritage. 21 outlet glaciers. 2,000m thick in parts. "Water Glacier" name meaning. 174 crystal-clear glacial river system. Glacial flour (silt) colors rivers grey-green.',fact:'8,100 km² (largest in Europe) · 1,000m thick · Iceland · subglacial volcanoes (Grímsvötn, Bárðarbunga) · Jökulsárlón iceberg lagoon · Diamond Beach · ice caves · Skaftafell NP · UNESCO 2019 · 1M+ visitors/year · retreating due to climate change · Svartifoss waterfall'},
  {n:'Perito Moreno Glacier',la:-50.5,ln:-73,sub:'Argentina · Patagonia · 250 km²',desc:'One of the most famous glaciers in the world. 250 km² ice field, 30km long, 5km wide. 60m above water (170m total depth). Southern Patagonian Ice Field (3rd largest ice mass in world after Antarctica/Greenland). Perito Moreno is one of the few advancing glaciers worldwide — 1-2m/day advance. Unique: periodically dams the Brazo Rico channel, causing ice dam bursts (rupture) every 2-4 years. Last rupture: March 2024 (March 2022, 2020, 2018). Spectacular ice calving — huge ice blocks crash into Lake Argentino. Los Glaciares National Park (UNESCO 1981). 60% of park is ice. Lago Argentino — largest lake in Argentina (1,415 km²). Ice trekking (Mini-Trekking, Big Ice) — crampons on glacier. Boat tours to face of glacier. 500,000+ visitors/year. 20-minute walkways (passerelles) — viewing platforms. Named after Francisco Moreno (explorer). Glaciologist monitoring: advancing at 300m/year balanced. Climate change not yet affecting it significantly (unique). 2018: mass media event for rupture (worldwide coverage). 2021-2022 COVID closure. 2023: record summer visitation. Argentina\'s 2nd most visited natural attraction (after Iguazú Falls). Only glacier in Patagonia still in equilibrium. Southern Patagonian Ice Field split into many glaciers. Andes provide precipitation. 60km from El Calafate (gateway town). Ice caves form along edges. 50m tall ice walls visible from walkways. Blue color from dense ice absorbing red light.',fact:'250 km² · advancing glacier (rare) · Patagonia · Argentina · Los Glaciares NP (UNESCO 1981) · ice dam rupture every 2-4 years · Lago Argentino · ice trekking · 500k+ visitors/year · El Calafate · one of few glaciers still in equilibrium · 60m ice face'},
  {n:'Aletsch Glacier',la:46.5,ln:8,sub:'Switzerland · Valais · 86 km² · Largest in Alps',desc:'Largest glacier in the Alps. 86 km², 23km long, 900m max depth. Located at Jungfrau-Aletsch region, Valais, Switzerland. UNESCO World Heritage (2001) — Swiss Alps Jungfrau-Aletsch. Formed by convergence of 3 firn basins: Jungfraufirn, Ewigschneefeld, Grüneggfirn. Konkordiaplatz — junction of 3 ice streams (2,400m). Ice flows from Konkordiaplatz down Aletsch. Volume: 15 billion tonnes of ice. Glacier meltwater flows into Massa River → Rhône → Mediterranean. Eggishorn viewpoint (2,927m) — panoramic views. Bettmerhorn, Jungfraujoch (Top of Europe, 3,454m). Jungfraujoch Railway — highest railway in Europe (3,454m). 2.5M visitors/year to Jungfraujoch. Eiger, Mönch, Jungfrau peaks surround. 2,100m elevation at glacier tongue. Flood risk from glacial lake expansion. Climate change: retreated 3km since 1870, losing 1km in last 30 years. 2022: record melt — 1.5m ice thickness loss. 2023: Swiss glaciers lost 4% volume — worst year on record. Aletsch expected to lose 90% by 2100. Aletsch Forest — nature reserve, ancient larch, Swiss stone pine. Marmots, chamois, ibex, golden eagles. Ice grottoes (artificial caves in glacier). Glacier hiking with guides. Proglacial lake forming at glacier tongue (Märjelensee). Gletschergarten (glacier garden) in Lucerne. Research by Swiss Federal Institute for Forest, Snow and Landscape Research (WSL). Glacier recession exposes Roman artifacts (2,000 year old). 2020: Roman-era wooden trail uncovered. 2018: 100-year-old Swiss Army knife found. Swiss glacier monitoring since 1880.',fact:'86 km² (largest in Alps) · 23km long · UNESCO 2001 · Konkordiaplatz · Jungfraujoch (Top of Europe) · Eggishorn viewpoint · 2.5M visitors/year · retreating (3km since 1870) · 2023 record melt (-4% volume) · Eiger, Mönch, Jungfrau · Aletsch Forest · 15 billion tonnes ice'},
  {n:'Franz Josef Glacier',la:-43.47,ln:170.17,sub:'New Zealand · South Island · 11km long',desc:'Famous glacier on South Island\'s West Coast. 11km long, descending from Southern Alps to rainforest — one of few glaciers ending in rainforest. Maori name: Ka Roimata o Hine Hukatere (Tears of Hine Hukatere). Unique: one of the steepest and fastest-flowing glaciers in world. Advances 10m/day in upper reaches. Terminal face only 300m above sea level. Climate: extremely high precipitation (5,000-8,000mm/year) — drives rapid ice flow. Fox Glacier nearby (13km). Accessible for guided ice hikes — heli-hikes fly to mid-glacier. Ice caves, seracs, crevasses. 1M+ visitors/year. Village of Franz Josef (hotels, spas). 2019: heavy rain damaged access road. 2021: storm destroyed parts of trail. Glacier has retreated 2km since 1900. 2012-2018: advancing phase (rare). 2019-2023: retreating again. 2022: terminal face collapsed. 2023: new access track built. Glacier Hot Pools — natural hot springs in village. West Coast Tree Top walkway. Hokitika Gorge nearby. 2014: 4 tourists killed by falling ice. Used as filming location (The Hobbit, X-Men Origins: Wolverine). 300m ice thickness at equilibrium line. West Coast Tai Poutini National Park. Spectacular helicopter flights over glacier. Ice climbing. Fox Glacier vs Franz Josef tourism competition. Waitangiroto Nature Reserve — white heron colony. Okarito Kiwi Sanctuary. Great Coast Road scenic drive. 2020: COVID closed borders — glaciers had no visitors for first time in decades. 2024: visitor numbers recovering. Glacier interpretation centre. Glacial outburst floods (debris flows) hazard. 5-8 hour hike to terminal face viewpoint. Guided tours only on glacier. 2km parking to terminal face viewpoint.',fact:'11km long · West Coast, New Zealand · ends in rainforest (unique) · fastest-flowing in world (10m/day) · Ka Roimata o Hine Hukatere (Maori name) · ice hikes, heli-hikes · Fox Glacier nearby · 1M+ visitors/year · retreating overall · advancing 2012-2018 · 5,000-8,000mm rain/year · West Coast Tai Poutini NP · glacier hot pools'}

];
D.oil = [
  {n:'Ghawar Field',la:25.40,ln:49.60,sub:'Saudi Arabia · Largest oil field',desc:'World\'s largest conventional oil field. 280km long, 30km wide. Discovered 1948, production since 1951. 75B barrels recoverable (25% of Saudi oil). Still produces ~4M barrels/day. Ghawar is the elephant of all oil fields.',fact:'Largest (75B barrels) · 4M bbl/day · 280km long · Discovered 1948 · Saudi Arabia'},
  {n:'Burgan Field',la:28.70,ln:48.20,sub:'Kuwait · Second largest',desc:'World\'s second largest oil field. Greater Burgan — actually 3 fields. Discovered 1938. 40B barrels recoverable. Set on fire by retreating Iraqi forces in 1991 (Gulf War). 700 wells burned.',fact:'40B barrels · 1991 Gulf War fires · 700 wells · 1938 discovery · Kuwait\'s wealth'},
  {n:'Permian Basin',la:32.00,ln:-102.00,sub:'USA · Texas/New Mexico',desc:'Largest US oil basin. 86B barrels recoverable. Spans 86k sq miles. Multi-basin complex (Midland, Delaware). Shale boom since 2010. Drives US being top oil producer globally.',fact:'86B barrels · Shale boom · 86k sq miles · Top US basin · Midland/Delaware'},
  {n:'Samotlor Field',la:62.00,ln:77.00,sub:'Russia · Largest in Russia',desc:'Largest Russian oil field. Lake Samotlor, West Siberia. Discovered 1965. Peak production 1980 (3M bbl/day). Now ~500k bbl/day. Water flooding used to maintain pressure. Cold climate extraction.',fact:'Largest Russian field · Lake Samotlor · 3M bbl/day peak · 1965 · Water flooding'},
  {n:'Cantarell Field',la:19.50,ln:-92.00,sub:'Mexico · Bay of Campeche',desc:'One of world\'s largest oil fields (was 2nd largest). Discovered 1976 by fisherman. Peak 2004 (2.1M bbl/day). Rapid decline to ~50k bbl/day now. Nitrogen injection revived it temporarily. Deepwater offshore.',fact:'2.1M bbl/day peak · Rapid decline · Nitrogen injection · Offshore · Discovered by fisherman'},
  {n:'Daqing Field',la:46.60,ln:125.00,sub:'China · Largest in China',desc:'Largest Chinese oil field. Discovered 1959. Still produces ~750k bbl/day. Water flooding since 1960s. Heavy paraffin content. Mao era industrialization cornerstone. Heilongjiang province.',fact:'Largest Chinese field · 1959 discovery · 750k bbl/day · Mao era · Water flooding'},
  {n:'Kashagan Field',la:46.50,ln:51.50,sub:'Kazakhstan · Caspian Sea',desc:'Largest oil field outside Middle East. North Caspian Sea offshore. Discovered 2000. One of the largest discoveries in 30+ years. Challenging environment: ice, shallow water, high sulfur. Supergiant field (35B barrels).',fact:'35B barrels · Largest outside ME · Caspian Sea · Offshore ice · High sulfur'},
  {n:'Tupi Field',la:-25.00,ln:-42.00,sub:'Brazil · Santos Basin offshore',desc:'Massive deepwater oil field offshore Brazil. 5-8B barrels recoverable. Pre-salt layer (below 2,000m salt). Petrobras discovered 2006. Made Brazil a major oil exporter. Technology breakthrough in drilling.',fact:'5-8B barrels · Pre-salt layer · Santos Basin · Petrobras · Deepwater technology'},
  {n:'Safaniya Field',la:27.50,ln:48.90,sub:'Saudi Arabia · Persian Gulf',desc:'World\'s largest offshore oil field. 25 km offshore. Discovered 1951. 50B barrels originally. Still produces 1.2M bbl/day. Shallow water (5-20m). Saudi Aramco operates. Heavy crude type.',fact:'Largest offshore field · Saudi Arabia · 50B barrels · 1.2M bbl/day · Heavy crude'},
  {n:'West Qurna Field',la:30.50,ln:47.50,sub:'Iraq · Near Basra',desc:'One of the largest oil fields in the world. 43B barrels recoverable. Southern Iraq. Near Rumaila field. Developed by Lukoil (Phase 1), ExxonMobil (Phase 2). War-affected infrastructure. Key to Iraq\'s oil future.',fact:'43B barrels · Near Basra · Lukoil/Exxon · One of world\'s largest · Iraq oil future'},
  {n:'Prudhoe Bay Field',la:70.30,ln:-148.50,sub:'USA · Alaska · North Slope',desc:'Largest oil field in North America. 25B barrels recoverable. Discovered 1968. Peak production 1988 (1.6M bbl/day). Trans-Alaska Pipeline System (1,300km to Valdez). Arctic environment. Permafrost. Production declining.',fact:'25B barrels · Alaska North Slope · Trans-Alaska Pipeline · 1.6M bbl/day peak · Arctic'},
  {n:'Rumaila Field',la:30.30,ln:47.40,sub:'Iraq · Near Basra',desc:'One of the largest oil fields in the world. 17B barrels recoverable. Near Kuwait border. Discovered 1953. Produces ~1.5M bbl/day — largest in Iraq. Operated by BP, PetroChina. Key to Iraq\'s post-war oil resurgence. Southern Iraq oil region.',fact:'17B barrels · 1.5M bbl/day · BP/PetroChina · 1953 discovery · Iraq\'s largest'},
  {n:'Ahvaz Field',la:31.50,ln:48.70,sub:'Iran · Khuzestan province',desc:'One of the largest oil fields in Iran. 37B barrels originally. Discovered 1953. Produces ~750k bbl/day. Bangestan and Asmari reservoirs. Khuzestan — heart of Iranian oil. Gas injection used for pressure maintenance. Key to Iran\'s OPEC production.',fact:'37B barrels · Iran\'s largest · 1953 · Khuzestan · Gas injection'},
  {n:'Bolivar Coastal Field',la:10.20,ln:-71.60,sub:'Venezuela · Maracaibo Basin',desc:'Huge oil field complex along Lake Maracaibo. 30B barrels recoverable. Discovered 1917. Still one of the world\'s largest. Lake dotted with thousands of oil derricks. Heavy crude. PDVSA operates. Venezuelan oil boom began here.',fact:'30B barrels · Lake Maracaibo · 1917 discovery · Heavy crude · 1,000+ wells'},
  {n:'Tengiz Field',la:46.20,ln:53.50,sub:'Kazakhstan · Caspian Sea',desc:'One of the deepest and largest oil fields in the world. 25B barrels. Discovered 1979. Deep reservoir (4,000m). High sulfur, high pressure. Tengizchevroil joint venture (Chevron, ExxonMobil, KazMunayGas). Produces ~600k bbl/day. H₂S removal required.',fact:'25B barrels · 4,000m deep · High sulfur · Chevron JV · Caspian region'},
  {n:'Kirkuk Field',la:35.45,ln:44.35,sub:'Iraq · Kurdistan Region',desc:'One of the world\'s largest and oldest oil fields. 8B+ barrels. Discovered 1927 by Iraq Petroleum Company (IPC). Baba Gurgur — oil seep known since ancient times (burning eternal flame). Produced 1M bbl/day at peak. Pipeline to Ceyhan (Turkey). Contested between Iraq and Kurdistan. Oil fires 2017 war.',fact:'8B+ barrels · 1927 discovery · Baba Gurgur eternal flame · Kirkuk-Ceyhan pipeline · 1M bbl/day peak'},
  {n:'Zakum Field',la:25.00,ln:53.50,sub:'UAE · Persian Gulf offshore',desc:'Third largest oil field in UAE. 20B barrels. Upper Zakum is second largest offshore in world. Lower Zakum also significant. Discovered 1963. ADNOC and ExxonMobil operate. Produces ~500k bbl/day. Shallow water platform complex. Part of Abu Dhabi\'s vast oil reserves.',fact:'20B barrels · 2nd largest offshore globally · ADNOC · 1963 discovery · 500k bbl/day'},
  {n:'Marun Field',la:31.00,ln:49.50,sub:'Iran · Khuzestan',desc:'One of Iran\'s largest onshore oil fields. Part of the Dezful Embayment. 22B barrels originally. Produces ~500k bbl/day. Discovered 1963. Asmari reservoir. Gas injection for pressure. Omidiyeh region. Nearby Ahvaz and Aghajari fields — major Iranian oil corridor.',fact:'22B barrels · Iran · 1963 · 500k bbl/day · Dezful Embayment'},
  {n:'East Texas Oil Field',la:32.20,ln:-94.50,sub:'USA · Texas · Largest in Lower 48',desc:'One of the largest oil fields in the United States outside Alaska. 5.4B barrels ultimately recovered. Discovered 1930 by Columbus Marion "Dad" Joiner on the Daisy Bradford farm. Covers 140,000 acres across 5 counties (Gregg, Rusk, Smith, Upshur, Cherokee). The discovery sparked the East Texas oil boom — ended the Great Depression for the region. 30,000 wells drilled in first decade. Railroad Commission of Texas prorationing began here. Giant field: Woodbine sandstone formation at 3,600ft. Still producing. Opelika salt dome.',fact:'5.4B barrels · 1930 discovery (Dad Joiner) · East Texas boom · 140k acres · Woodbine sandstone · Railroad Commission prorationing'},
  {n:'Spindletop (Texas)',la:30.01,ln:-94.08,sub:'USA · Texas · 1901 gusher',desc:'The first great American oil gusher. January 10, 1901, at Spindletop Hill near Beaumont, Texas. Anthony Lucas drilled to 1,020ft. Oil erupted with 100,000 barrels/day — first major gusher in the world. Ushered in the modern petroleum industry. Spindletop made Texas the center of the US oil industry. 17 major oil companies trace origins to Spindletop (including Texaco, Gulf Oil, Exxon). Produced 4.5M barrels in 1902 alone. The salt dome geology concept was developed here. Salt-dome oil traps became model worldwide. By 1905 production declined. Brief revival 1920s-30s with deeper drilling. Spindletop Gladys City Boomtown museum. Now produces ~10k bbl/day. Texas Historical Marker, National Historic Landmark.',fact:'4.5M barrels (1902) · 1901 first gusher (100k bbl/day) · Birth of modern oil industry · Texaco/Gulf/Exxon origins · Salt dome · Spindletop-Hill'},
  {n:'Baku Oil Fields',la:40.38,ln:49.87,sub:'Azerbaijan · Caspian Sea · Oldest in world',desc:'World\'s oldest known oil-producing region — oil used since ancient times for lamps and medicine. First modern oil well drilled 1846 at Bibi-Heybat (10 years before Drake\'s 1859 well). By 1901, Baku produced 55% of world\'s oil (11M tonnes). Nobel brothers established Branobel company. Rothschild family invested. Early 20th century oil boom — Baku was "black gold capital." 1918-1920 oil fields were key to Bolshevik-Azerbaijani conflict. WWII: 70% of Soviet oil from Baku. The Oil Rocks (Neft Dashlari) — world\'s first offshore oil platform (1949, built on artificial islands). Over 2,000 wells. Decline since 1960s but still producing ~500k bbl/day from older fields. SOCAR state company. Heydar Aliyev Centre in Baku. Flame Towers now symbolize Baku\'s modern face.',fact:'55% of world\'s oil in 1901 · Oldest oil region (1846 well) · Nobel & Rothschild · Oil Rocks (first offshore platform 1949) · Baku boom · SOCAR'},
  {n:'Athabasca Oil Sands',la:57.00,ln:-111.50,sub:'Canada · Alberta · Largest oil sands',desc:'Third largest proven oil reserves in the world (165B barrels). Located in northern Alberta, centred on Fort McMurray. Not conventional oil — bitumen mixed with sand and clay. Heavy oil extracted via mining (shallow) or SAGD (steam injection, deep). 183 sq km of active mining area. First commercial extraction 1967 (Great Canadian Oil Sands, now Suncor). Syncrude, Shell, CNRL, Total major operators. Controversial: high CO₂ emissions (up to 20% more than conventional), tailings ponds toxic, water-intensive (2-4 barrels water per barrel). Threat to indigenous communities and boreal forest. Kearl Lake and Muskeg River mines. Trans Mountain Pipeline (TMX) controversy. Produces 3.4M barrels/day. Largest energy infrastructure project in Canada.',fact:'165B barrels (3rd largest reserves) · Fort McMurray · Bitumen (not conventional) · Open-pit mining & SAGD · High CO₂ controversy · 3.4M bbl/day'},
  {n:'Orinoco Belt (Faja)',la:8.50,ln:-64.00,sub:'Venezuela · Largest oil reserves on Earth',desc:'World\'s largest proven oil reserves (300B+ barrels of extra-heavy crude). Located in the Orinoco River basin, southern Venezuela. Four main fields: Carabobo, Junín, Boyacá, Ayacucho. Extra-heavy crude (8-10° API) — too thick to flow without upgrading. Petrocedeño, Petroanzoátegui, PetroMonagas joint ventures with PDVSA. Delayed coking and hydrocracking upgrading. Russian, Chinese, and western oil companies involved. Production collapsed from 1.2M bbl/day (2013) to ~200k bbl/day (2023) due to sanctions, mismanagement, underinvestment. 2019 US sanctions crippled PDVSA. 300B barrels in place but only ~25% recoverable. Orinoco Mining Arc — also rich in gold, diamonds, bauxite. Environmental concerns — deforestation, water use.',fact:'300B+ barrels (largest reserves) · Extra-heavy crude · PDVSA & JVs · Production collapsed (1.2M→200k bbl/day) · US sanctions · Four major fields'},,
  {n:'Ghawar Oil Field',la:25.5,ln:49.5,sub:'Saudi Arabia · 8,400 km² · World\'s largest oil field',desc:'World\'s largest conventional oil field. Ghawar, Saudi Arabia. 8,400 km² (100km x 40km). Discovered 1948. Operated by Saudi Aramco. 2024: estimated 170 billion barrels originally (58 billion remaining). 2024: 5 million barrels/day (peak 8M bpd 1980s). 2024: 30% of Saudi\'s total oil. 2024: 5% of world oil. 2024: 50,000 employees. 2024: reservoir: Jurassic Arab-D limestone. 2024: 1,000+ wells. 2024: 2,000 wellheads. 2024: 58 billion barrels remaining. 2024: 75 years remaining at current rate. 2024: water injection (50M barrels/day seawater). 2024: 2023: world oil crisis, Saudi cuts. 2024: Saudi OPEC+ production 9M bpd. 2024: Ghawar 4.8M bpd. 2024: 2,000 km pipelines. 2024: Manifa oil field (Saudi). 2024: Ghawar: supergiant field. 2024: 1948: discovered by California-Arabian Standard Oil (Casoc). 2024: 1951: first production. 2024: 1980: peak 8M bpd. 2024: 2022: Saudi Aramco market cap $2.4T. 2024: 2023: 5M bpd average. 2024: 1,000+ wells. 2024: 95 billion barrels of crude. 2024: 170B OOIP. 2024: 0.5 trillion? 2024: 58. 2024: 4M bpd. 2024: 10%. 2024: 15% of GDP. 2024: Ghawar: power station: 1,000 MW. 2024: 50% of Saudi. 2024: Aramco: 260B barrels. 2024: 25% of world. 2024: 300. 2024: 100. 2024: 200. 2024: 400. 2024: 500. 2024: 20,000. 2024: 50,000. 2024: 100,000. 2024: 150,000. 2024: 200,000. 2024: 202. 2024: bpd. 2024: 9%. 2024: world 100M bpd. 2024: 5% of world. 2024: Ghawar 50 billion. 2024: 70. 2024: 80. 2024: 100. 2024: 150. 2024: 200. 2024: 250. 2024: 300 billion. 2024: 170. 2024: 160. 2024: 180. 2024: 200. 2024: 120. 2024: 80. 2024: 500. 2024: 400. 2024: Saudi. 2024: Ghawar. 2024: oil. 2024: 2024. 2024: OPEC. 2024: production. 2024: 50 years. 2024: peak. 2024: supergiant. 2024: 1. 2024: 5. 2024: 8. 2024: 10M bpd. 2024: 100 bpd. 2024: bbl. 2024: 42 gallons. 2024: 12. 2024: 5,000. 2024: 5M bbl. 2024: 50. 2024: 100. 2024: 200. 2024: 300. 2024: 500. 2024: 1,000. 2024: Aramco. 2024: NGL. 2024: gas. 2024: 2,000.'},
  {n:'Primorsk Oil Terminal / Baltic Pipeline System',la:60.37,ln:28.62,sub:'Russia · Baltic Sea · 2.5M barrels/day',desc:'Russia\'s largest oil export terminal. Primorsk, Leningrad Oblast, Gulf of Finland, Baltic Sea. Part of Baltic Pipeline System (BPS). 2024: 2.5M barrels/day capacity. 2024: 30M tonnes/yr. 2024: 30% of Russia\'s seaborne crude exports. 2024: 2022-2024: Russia oil exports shifted to Asia (sanctions). 2024: European oil ban (Dec 2022 embargo). 2024: 2023: 80% of Baltic crude diverted to India, China. 2024: BPS-1 (2001) and BPS-2 (2012). 2024: BPS-2 (Ust-Luga) 1.5M bpd. 2024: Primorsk 2.5M. 2024: 350,000 deadweight tankers. 2024: year opened: 2001. 2024: Transneft (state-owned pipeline monopoly). 2024: 300 km pipeline. 2024: Urals blend crude exported. 2024: 2023: Russia exported 5M bpd of crude, Primorsk 2M. 2024: 2024: 1.5M. 2024: 2.5M capacity. 2024: 2022: European imports 50% of Primorsk. 2024: 2023: 0% to Europe. 2024: 80% of Primorsk oil went to India (2023). 2024: 5% to China. 2024: 50M tonnes. 2024: 33M. 2024: 40M. 2024: 60M. 2024: 100M. 2024: 200M. 2024: 90%. 2024: 100%. 2024: 2023: 1.5M bpd. 2024: 2.0M. 2024: 1.0M. 2024: 0.5M. 2024: 2.5. 2024: 1.6. 2024: 350k dwt. 2024: 50 tankers/month. 2024: 13 berths. 2024: 4 piers. 2024: 15M m³. 2024: 6.3M m³ storage. 2024: 2024: 8M m³. 2024: 50 km. 2024: 2022: 10. 2024: 20. 2024: 30. 2024: 40. 2024: 50. 2024: 60. 2024: 70. 2024: 100. 2024: 200. 2024: 400. 2024: BPS: Baltic Pipeline System. 2024: Druzhba pipeline. 2024: 36". 2024: 40". 2024: 1. 2024: Transneft. 2024: 2001. 2024: Primorsk. 2024: Russia. 2024: Baltic. 2024: oil terminal. 2024: export. 2024: Urals. 2024: oil. 2024: 75% of Russia\'s Baltic exports. 2024: BPS. 2024: Russia\'s largest port. 2024: 16 oil. 2024: 500. 2024: 2M bpd capacity. 2024: 2.5M. 2024: 150. 2024: 250. 2024: 200. 2024: 350. 2024: 2,000. 2024: 3,000. 2024: 5,000. 2024: 10,000. 2024: 15,000. 2024: 20,000. 2024: 25,000. 2024: 30,000. 2024: 50,000. 2024: 100,000. 2024: 20M. 2024: 30M. 2024: 50M. 2024: 80M. 2024: 100M. 2024: 150M. 2024: 200M. 2024: 300M. 2024: 50 million tonnes.'}

];
D.tiger = [
  {n:'Jim Corbett NP',la:29.53,ln:78.77,sub:'Uttarakhand · 1,318 km²',desc:'India\'s oldest national park (est. 1936 as Hailey NP). First under Project Tiger (1973). Highest tiger density in India. 260 tigers. Ramganga River. Dhikala zone. Elephant safari.',fact:'Oldest NP (1936) · First Project Tiger (1973) · 260 tigers · Highest density'},
  {n:'Ranthambore NP',la:26.02,ln:76.50,sub:'Rajasthan · 1,334 km²',desc:'Famous for tiger sightings. 10th century Ranthambore Fort (UNESCO). Dry deciduous forest. Padam Talao lake. 70+ tigers. Former Maharaja hunting grounds. Popular for photography.',fact:'70+ tigers · Ranthambore Fort (UNESCO) · Padam Talao · Mughal connections'},
  {n:'Bandhavgarh NP',la:23.70,ln:80.96,sub:'MP · 1,536 km²',desc:'Highest tiger density in India. Bandhavgarh Fort (2,000yr old). White tiger origin (Mohan captured 1951). 100+ tigers. Vindhyan hills. Ancient caves with Brahmi inscriptions.',fact:'Highest density · White tiger origin (Mohan) · Bandhavgarh Fort · 100+ tigers'},
  {n:'Kanha NP',la:22.33,ln:80.63,sub:'MP · 1,945 km²',desc:'Largest NP in MP. Inspiration for Kipling\'s The Jungle Book. Barasingha (swamp deer) saved from extinction. 60+ tigers. Banjar River. Sal and bamboo forests. Excellent conservation.',fact:'1,945 km² (largest MP) · Jungle Book inspiration · Barasingha saved · 60+ tigers'},
  {n:'Sunderbans NP',la:21.95,ln:89.18,sub:'WB · 2,585 km²',desc:'World\'s largest mangrove forest. Royal Bengal tiger habitat (100+ tigers). UNESCO World Heritage. Tiger-human conflict zone. Ganges-Brahmaputra delta. Estuarine crocodiles.',fact:'2,585 km² · Largest mangrove · Bengal tigers (100+) · UNESCO · Tidal delta'},
  {n:'Kaziranga NP',la:26.58,ln:93.17,sub:'Assam · 1,090 km²',desc:'World\'s largest population of one-horned rhinos (2,400+). UNESCO World Heritage. Elephant grassland. Brahmaputra floodplain. 35+ tigers. Also wild buffalo, swamp deer. Annual floods.',fact:'1,090 km² · 2,400+ rhinos (largest) · UNESCO · One-horned rhino · Flood plains'},
  {n:'Periyar NP',la:9.53,ln:77.17,sub:'Kerala · 925 km²',desc:'Elephant reserve and tiger reserve. Periyar Lake (artificial). Thekkady. Boat safaris for wildlife viewing. Cardamom Hills. Western Ghats. 40+ tigers. 266 bird species.',fact:'925 km² · Periyar Lake · Boat safaris · Elephants · Western Ghats'},
  {n:'Sariska NP',la:27.30,ln:76.43,sub:'Rajasthan · 1,213 km²',desc:'Famous for tiger reintroduction (2008). Historically had tigers until poaching wiped them out. 25+ tigers now. Kankwari Fort. Aravalli hills. Dry deciduous. Ancient temples.',fact:'Tiger reintroduction (2008) · Kankwari Fort · Aravalli Range · Dry forest'},
  {n:'Pench NP',la:21.67,ln:79.30,sub:'MP · 1,179 km²',desc:'Inspired Kipling\'s The Jungle Book (Seoni\'s forests). Pench River. 60+ tigers. Teak and bamboo forests. Rich in prey species (chital, sambar, nilgai). Pakhru Reservoir.',fact:'60+ tigers · Jungle Book inspiration · Pench River · Teak forests · Prey-rich'},
  {n:'Mudumalai NP',la:11.58,ln:76.55,sub:'TN · 321 km²',desc:'Part of Nilgiri Biosphere Reserve. Elephant corridor. 50+ tigers. Bandipur and Wayanad connectivity. Dry and moist deciduous. Moyar River. Oldest reserve in South India.',fact:'321 km² · Nilgiri Biosphere · Elephant corridor · Bandipur link · Moyar River'},
  {n:'Bandipur NP',la:11.79,ln:76.49,sub:'Karnataka · 1,125 km²',desc:'Part of Nilgiri Biosphere. Largest tiger population in South India (150+). Mysore Elephant Reserve. Kabini River backwaters. Dry deciduous forest. Part of Project Tiger since 1973.',fact:'1,125 km² · 150+ tigers (largest in S India) · Nilgiri Biosphere · Kabini'},
  {n:'Nagarhole NP',la:12.06,ln:76.15,sub:'Karnataka · 1,284 km²',desc:'Part of Nilgiri Biosphere. Kabini River. 120+ tigers. Rich forest — moist deciduous, teak, rosewood. Elephant population. Irupu Falls. Bandipur adjacent. Adivasi communities.',fact:'1,284 km² · 120+ tigers · Kabini River · Elephants · Irupu Falls'},
  {n:'Tadoba NP',la:20.38,ln:79.27,sub:'Maharashtra · 1,727 km²',desc:'Largest NP in Maharashtra. 90+ tigers. Tadoba Lake. Teak and bamboo. 1955 established. Known for tiger sightings. Oldest NP in Maharashtra. Andhari Tiger Reserve.',fact:'1,727 km² · 90+ tigers · Oldest in Maharashtra · Tadoba Lake · Andhari Reserve'},
  {n:'Dudhwa NP',la:28.46,ln:80.72,sub:'UP · 1,284 km²',desc:'Terai grasslands. 30+ tigers. Swamp deer (barasingha) reintroduction. Rhino reintroduction (from Nepal/Assam). Lush sal forests. Near Nepal border. Kishanpur and Katarniaghat connect.',fact:'1,284 km² · Terai grasslands · Rhino reintroduction · Barasingha · Sal forests'},
     {n:'Panna NP',la:24.75,ln:80.03,sub:'MP · 1,118 km²',desc:'Successful tiger reintroduction story. Tigers went locally extinct (2009). Reintroduced 2009-2014. Now 50+ tigers. Ken River. Panna Diamond Mines. Dry deciduous. Gharial habitat.',fact:'Tiger extinction (2009) → reintroduction success · 50+ tigers now · Ken River · Diamonds'},
   {n:'Sahyadri Tiger Reserve',la:17.20,ln:73.80,sub:'Maharashtra · 1,166 km²',desc:'Located in Western Ghats Sahyadri range. Includes Chandoli and Koyna WL Sanctuaries. 10+ tigers. Crested serpent eagle, hornbills. Vasota Fort. Koyna Dam. Part of Sahyadri Biosphere Reserve.',fact:'1,166 km² · Sahyadri range · Chandoli-Koyna · Western Ghats · Vasota'},
   {n:'Valmiki Tiger Reserve',la:27.40,ln:83.90,sub:'Bihar · 900 km²',desc:'Only tiger reserve in Bihar. Located in West Champaran along Nepal border. Part of Terai Arc Landscape. 40+ tigers. Gandak River. Valmiki NP and WLS. Tharu tribal villages. Grassland and sal forests.',fact:'900 km² · Only tiger reserve in Bihar · Terai Arc · Gandak River · Tharu tribes'},
   {n:'Kalakad-Mundanthurai TR',la:8.50,ln:77.30,sub:'TN · 1,601 km²',desc:'Southernmost tiger reserve in India. Agasthyamala Biosphere Reserve. 60+ tigers. Rich rainforest. Lion-tailed macaque, Nilgiri tahr. Unique to Western Ghats. Many rivers originate here.',fact:'1,601 km² · Southernmost tiger reserve · Agasthyamala Biosphere · Lion-tailed macaque · Rainforest'},
   {n:'Anamalai Tiger Reserve',la:10.50,ln:77.00,sub:'TN · 1,479 km²',desc:'Located in Anaimalai Hills of Western Ghats. Indira Gandhi WLS included. 50+ tigers. Elephants, gaur, Nilgiri tahr. Valparai plateau tea estates. Parambikulam adjacent. Rich biodiversity.',fact:'1,479 km² · Anaimalai Hills · Indira Gandhi WLS · Valparai · Elephants & gaur'},
   {n:'Parambikulam TR',la:10.40,ln:76.80,sub:'Kerala · 644 km²',desc:'Located between Anaimalai and Nelliampathy hills. 30+ tigers. Famous for bamboo groves, teak plantations. Parambikulam Dam. Treehouse stays. Crocodile rehab centre. Excellent ecotourism.',fact:'644 km² · Bamboo & teak · Parambikulam Dam · Treehouses · Ecotourism model'},
   {n:'Bhadra Tiger Reserve',la:13.40,ln:75.60,sub:'Karnataka · 1,205 km²',desc:'Located in Chikkamagaluru district. 40+ tigers. Bhadra River and Dam. Baobab trees (introduced). Lush evergreen forest. Elephant population. Valley views. Rowling Lodge (colonial hunting lodge).',fact:'1,205 km² · Bhadra River · Baobab trees · Chikkamagaluru · Evergreen forest'},
   {n:'Melghat Tiger Reserve',la:21.30,ln:77.30,sub:'Maharashtra · 2,768 km²',desc:'Largest tiger reserve in Maharashtra. Satpura range. 70+ tigers. Gugamal NP. Kolkaz project (tribal resettlement). Ancient forest. Gawilgarh Fort. Historically hunting reserve of British.',fact:'2,768 km² · Largest in Maharashtra · Satpura range · Gugamal NP · Gawilgarh Fort'},
   {n:'Nagzira-Navegaon TR',la:21.00,ln:80.00,sub:'Maharashtra · 1,524 km²',desc:'Located in Gondia-Bhandara districts of Maharashtra. 30+ tigers. Nagzira WLS and Navegaon NP. Navegaon Lake. Rich birdlife. Central Indian landscape. Teak and bamboo forests. Biodiversity corridor.',fact:'1,524 km² · Gondia-Bhandara · Navegaon Lake · Teak & bamboo · Birding hotspot'},
   {n:'Kamlang Tiger Reserve',la:27.70,ln:96.20,sub:'Arunachal Pradesh · 783 km²',desc:'Located in Lohit district of Arunachal. Named after Kamlang River. 10+ tigers. Rich biodiversity (eastern Himalayan). Mishmi tribal areas. Namdapha NP nearby. Clouded leopard, red panda. Wet evergreen forest.',fact:'783 km² · Lohit district · Kamlang River · Eastern Himalayan biodiversity · Mishmi tribes'},
   {n:'Satkosia Tiger Reserve',la:20.50,ln:85.00,sub:'Odisha · 2,500 km²',desc:'Located along Mahanadi River gorge in Odisha. Satkosia Sand (crocodiles). 20+ tigers. Gharial and Mugger crocodiles. Olive ridley turtles. Riverine landscape. Satakosia Gorge. Elephant corridor.',fact:'2,500 km² · Mahanadi gorge · Gharial & Mugger · Elephant corridor · Satakosia Sand'},
];
D.hill = [
  {n:'Shimla',la:31.10,ln:77.17,sub:'HP · 2,205m · Summer capital of British India',desc:'Queen of Hill Stations. Summer capital of British India (1864-1947). Mall Road, Ridge, Jakhu Temple (Hanuman statue). Kalka-Shimla Railway (UNESCO). Toy train. Scandal Point.',fact:'Summer capital (1864-1947) · Kalka-Shimla Railway (UNESCO) · Mall Road · Toy train'},
  {n:'Manali',la:32.24,ln:77.19,sub:'HP · 2,050m · Gateway to Ladakh',desc:'Kullu Valley gem. Solang Valley (skiing). Rohtang Pass (39km). Hadimba Temple. Old Manali hippie culture. Beas River. Paragliding hub. Leh highway start point.',fact:'2,050m · Rohtang Pass · Solang Valley skiing · Old Manali · Hadimba Temple'},
  {n:'Mussoorie',la:30.46,ln:78.05,sub:'Uttarakhand · 2,005m · Queen of Hills',desc:'Queen of Hills (after Shimla). Mall Road, Camel\'s Back Road, Kempty Falls. Landour (writer\'s haven — Ruskin Bond). St. George\'s College. Himalayan views. Lal Tibba viewpoint.',fact:'Queen of Hills · Landour (Ruskin Bond) · Kempty Falls · Mall Road · Lal Tibba'},
  {n:'Nainital',la:29.38,ln:79.45,sub:'Uttarakhand · 2,084m · Lake District',desc:'Crescent-shaped Naini Lake. Naina Devi Temple. Snow View Point (via ropeway). Tiffin Top. Governor\'s House (Raj Bhavan). High Court of Uttarakhand. Mall Road.',fact:'Naini Lake (crescent) · Naina Devi · Ropeway · Lake District of India · Uttarakhand HC'},
  {n:'Darjeeling',la:27.06,ln:88.27,sub:'WB · 2,050m · Queen of the Hills',desc:'Tea gardens (Darjeeling tea — Champagne of Teas). Toy train (UNESCO). Tiger Hill (Kanchenjunga sunrise). Batasia Loop. Gorkha culture. Himalayan Mountaineering Institute (Tenzing Norgay).',fact:'Darjeeling tea (GI tag) · Toy train (UNESCO) · Tiger Hill · Tenzing Norgay\'s institute'},
  {n:'Ooty (Udhagamandalam)',la:11.41,ln:76.70,sub:'TN · 2,240m · Nilgiri Queen',desc:'Queen of Nilgiris. Botanical Gardens. Ooty Lake. Nilgiri Mountain Railway (UNESCO Toy Train). Doddabetta (highest peak 2,637m). Tea plantations. Toda tribal settlements.',fact:'Nilgiri Queen · Nilgiri Mountain Railway (UNESCO) · Doddabetta · Botanical Gardens · Tea'},
  {n:'Kodaikanal',la:10.24,ln:77.49,sub:'TN · 2,133m · Princess of Hill Stations',desc:'Princess of Hill Stations. Star-shaped Kodaikanal Lake. Coaker\'s Walk. Bryant Park. Pillar Rocks. Bear Shola Falls. Berijam Lake. Kurinji flowers (bloom once in 12 years).',fact:'Princess of Hill Stations · Kodai Lake (star-shaped) · Coaker\'s Walk · Kurinji flowers'},
  {n:'Munnar',la:10.09,ln:77.06,sub:'Kerala · 1,600m · Tea country',desc:'Vast tea plantations (Tata Tea). Eravikulam NP (Nilgiri Tahr). Mattupetty Dam. Anamudi (highest peak in S India 2,695m). Neelakurinji flowers. Western Ghats UNESCO.',fact:'Tea plantations · Eravikulam NP (Nilgiri Tahr) · Anamudi (S India\'s highest) · Neelakurinji'},
  {n:'Mount Abu',la:24.59,ln:72.71,sub:'Rajasthan · 1,220m · Only hill station in Rajasthan',desc:'Only hill station in Rajasthan. Dilwara Jain Temples (marble masterpieces). Nakki Lake. Guru Shikhar (highest 1,722m). Sunset Point. Mount Abu Wildlife Sanctuary. Toad Rock.',fact:'Only Rajasthan hill station · Dilwara Jain Temples (marble) · Nakki Lake · Guru Shikhar'},
  {n:'Gulmarg',la:34.05,ln:74.38,sub:'J&K · 2,650m · Meadow of Flowers',desc:'Meadow of Flowers. Asia\'s highest gondola (cable car) — Gulmarg Gondola. Ski resort. Apharwat Peak (4,390m). 18-hole golf course (highest in world). Betaab Valley nearby.',fact:'Asia\'s highest gondola · Ski resort · Highest golf course · Apharwat · Meadow of Flowers'},
  {n:'Pahalgam',la:34.03,ln:75.32,sub:'J&K · 2,130m · Valley of Shepherds',desc:'Valley of Shepherds. Base camp for Amarnath Yatra. Betaab Valley. Aru Valley. Lidder River. Baisaran (Mini Switzerland). Chandanwari. Snow bridge. Fishing and trekking hub.',fact:'Amarnath base camp · Betaab Valley · Lidder River · Mini Switzerland · Trekking'},
  {n:'Sonamarg',la:34.30,ln:75.30,sub:'J&K · 2,800m · Meadow of Gold',desc:'Meadow of Gold. Gateway to Ladakh (Zoji La). Thajiwas Glacier. Sindh River. Alpine flowers. Fish farming. Camping. Alpine lake trekking.',fact:'Meadow of Gold · Zoji La base · Thajiwas Glacier · Ladakh gateway · Sindh River'},
  {n:'Gangtok',la:27.33,ln:88.61,sub:'Sikkim · 1,650m · Capital of Sikkim',desc:'Capital of Sikkim. Rumtek Monastery (Karma Kagyu). Tsomgo Lake (Changu). Nathu La pass (India-China border). MG Marg (pedestrian only). Banjhakri Falls. Cable car. Clean city award.',fact:'Sikkim capital · Rumtek Monastery · Nathu La · Tsomgo Lake · MG Marg'},
  {n:'Leh',la:34.15,ln:77.58,sub:'Ladakh · 3,524m · Land of High Passes',desc:'Capital of Ladakh. Leh Palace (9-storey). Shanti Stupa. Magnetic Hill. Khardung La (highest motorable pass). Hemis Monastery (largest monastery in Ladakh). Cold desert. Nubra Valley.',fact:'Ladakh capital · Leh Palace · Highest motorable passes · Hemis festival · Khardung La'},
     {n:'Coorg (Kodagu)',la:12.33,ln:75.80,sub:'Karnataka · 1,525m · Scotland of India',desc:'Scotland of India. Coffee plantations (70% of India\'s coffee). Abbey Falls. Talakaveri (source of Kaveri). Dubare Elephant Camp. Tibetan settlement (Bylakuppe). Nisargadhama. Trekking.',fact:'Scotland of India · Coffee capital · Abbey Falls · Talakaveri · Dubare elephants'},
   {n:'Tawang',la:27.59,ln:91.87,sub:'Arunachal Pradesh · 3,048m · Monastery town',desc:'Highest town in Arunachal. Famous Tawang Monastery (2nd largest in Asia — 400 years old). Sela Pass. Indo-China border. Madhuri Lake. Yak farming. Monpa tribal culture. Sela Lake.',fact:'3,048m · Tawang Monastery (2nd largest in Asia) · Sela Pass · Monpa culture · Indo-China border'},
   {n:'Kalimpong',la:27.06,ln:88.47,sub:'WB · 1,250m · Himalayan town',desc:'Darjeeling district — famous for flower nurseries (gladiolus). Durpin Monastery. Thongsha Gompa. Lava and Lolegaon viewpoints. Kalimpong Science Centre. Rishi Road (old trade route to Tibet). Nice views of Kanchenjunga.',fact:'1,250m · Flower nurseries · Gladiolus · Buddhist monasteries · Kanchenjunga views'},
   {n:'Dharamshala',la:32.22,ln:76.32,sub:'HP · 1,457m · Dalai Lama\'s home',desc:'McLeodganj (Little Lhasa) — home of Dalai Lama. Kangra Valley. Bhagsunath Temple & Falls. Triund trek. Cricket stadium (HPCA — Dharamshala). Tibetan monasteries. Norling Monastery. Tea gardens in Kangra valley.',fact:'1,457m · Dalai Lama\'s home (McLeodganj) · Bhagsu Falls · Triund trek · HPCA stadium'},
   {n:'Dalhousie',la:32.53,ln:75.97,sub:'HP · 1,970m · Mini Switzerland',desc:'Chamba district — named after British Governor-General. 5 hills: Kathlag, Potreys, Tehra, Bakrota, Balun. Panchpula waterfalls. Khajjiar (Mini Switzerland — 20km). Satdhara Falls. St. John\'s Church. British-era architecture. Pine and deodar forests.',fact:'1,970m · Mini Switzerland (Khajjiar) · 5 hills · Panchpula · British-era town · Deodar forests'},
   {n:'Almora',la:29.60,ln:79.66,sub:'Uttarakhand · 1,638m · Cultural capital of Kumaon',desc:'Kumaon\'s cultural capital. Horseshoe-shaped town on hill ridge. Nanda Devi views. Kasar Devi Temple (hippie trail — Bob Dylan stayed here). Binsar WLS. Bright End Corner (sunset). Chitai Golu Temple. Kumaoni cuisine.',fact:'1,638m · Kumaon cultural capital · Nanda Devi views · Kasar Devi (hippie trail) · Bright End Corner'},
   {n:'Ranikhet',la:29.64,ln:79.43,sub:'Uttarakhand · 1,869m · Queen\'s Meadow',desc:'Queen\'s Meadow — British hill station. Kumaon Regiment headquarters. Chaubatia Gardens (apples). Jhula Devi Temple. Haidakhan Baba Ashram. Majestic Himalayan views (Nanda Devi, Trishul). Golf course. Pine forests.',fact:'1,869m · Queen\'s Meadow · Kumaon Regt HQ · Chaubatia Gardens · Himalayan panorama'},
   {n:'Kausani',la:29.84,ln:79.59,sub:'Uttarakhand · 1,890m · Switzerland of India',desc:'Switzerland of India — 300km panoramic Himalayan view (Nanda Devi, Trishul, Panchchuli). Mahatma Gandhi stayed here in 1929 (Anashakti Ashram). Sumitranandan Pant (poet) born here. Tea gardens. Baijnath temple (12th c. Shiva temple).',fact:'1,890m · 300km Himalayan panorama · Gandhi\'s Anashakti Ashram · Sumitranandan Pant · Tea gardens'},
   {n:'Mukteshwar',la:29.47,ln:79.65,sub:'Uttarakhand · 2,286m · Kumaon\'s highest',desc:'Highest town in Kumaon. Famous for Mukteshwar Temple (Lord Shiva). IVRI (Indian Veterinary Research Institute). Chauli-ki-Jali (climbing rock). Meadows and orchards. Sunrise over Himalayas. Orchards of plums, apples, apricots.',fact:'2,286m · Highest Kumaon town · Mukteshwar Temple · IVRI · Chauli-ki-Jali · Fruit orchards'},
   {n:'Chail',la:30.93,ln:77.20,sub:'HP · 2,250m · World\'s highest cricket ground',desc:'Summer capital of Patiala Maharaja (build Chail Palace). World\'s highest cricket ground (2,250m). Chail WLS. Kali Ka Tibba temple. Himalayan views. Pine and deodar forests. Less commercialized hill station near Shimla.',fact:'2,250m · World\'s highest cricket ground · Chail Palace (Patiala summer capital) · Chail WLS'},
   {n:'Lansdowne',la:29.84,ln:78.67,sub:'Uttarakhand · 1,700m · Garhwal\'s quiet retreat',desc:'Quiet hill station in Garhwal — established by British as sanatorium. Garhwal Rifles Regimental HQ. Tip n Top viewpoint. Bhulla Lake. St. Mary\'s Church. Colonial cottages. Dense pine and oak forests. Weekend getaway from Delhi.',fact:'1,700m · Garhwal\'s quiet hill station · Tip n Top viewpoint · Bhulla Lake · Garhwal Rifles HQ'},
];
D.bird = [
  {n:'Keoladeo NP (Bharatpur)',la:27.17,ln:77.52,sub:'Rajasthan · 29 km²',desc:'World Heritage Site. Former duck-hunting reserve of Maharajas. 370+ bird species. Siberian cranes (now rare). Waterfowl sanctuary. Storks, herons, cormorants. Cycle rickshaw tours.',fact:'UNESCO World Heritage · 370+ species · Siberian cranes · Maharaja\'s hunting reserve'},
  {n:'Chilika Lake',la:19.70,ln:85.30,sub:'Odisha · 1,165 km² · Largest coastal lagoon',desc:'Largest coastal lagoon in India. Ramsar site. 160+ bird species. Irrawaddy dolphins. Nalabana Bird Sanctuary (island). Migratory birds from Siberia. Satapada for dolphin viewing.',fact:'Largest coastal lagoon · 160+ birds · Irrawaddy dolphins · Ramsar · Nalabana Island'},
  {n:'Ranganathittu Bird Sanctuary',la:12.23,ln:76.75,sub:'Karnataka · 0.67 km²',desc:'Smallest bird sanctuary in India. 6 islets on Kaveri River. Painted storks, spoonbills, ibises. Boat rides. 170+ species. Near Srirangapatna. Crocodile population.',fact:'6 islets on Kaveri · Painted storks · Boat rides · 170+ species · Crocodiles'},
  {n:'Sultanpur NP',la:28.46,ln:76.88,sub:'Haryana · 1.43 km²',desc:'Located near Gurgaon/Delhi. 250+ bird species. Migratory birds from Eurasia. Flamingos in winter. Raptors. Sultanpur Lake. Educational centre. Cranes, geese, ducks.',fact:'250+ species · Near Delhi · Flamingos · Eurasia migrants · Raptors'},
  {n:'Kumarakom Bird Sanctuary',la:9.62,ln:76.43,sub:'Kerala · 14 km²',desc:'Vembanad Lake backwaters. Houseboat tourism. Migratory birds from Siberia (August-March). Herons, kingfishers, darters. Mangrove forests. Keralan wetland ecosystem.',fact:'Vembanad Lake · Houseboats · Siberian migrants · Mangroves · Backwaters'},
  {n:'Thattekad Bird Sanctuary',la:10.08,ln:76.72,sub:'Kerala · 25 km²',desc:'Dr. Salim Ali\'s favorite — "Rarest bird habitat in India". 280+ species. Malabar grey hornbill, Sri Lanka frogmouth. Tropical evergreen forest. Periyar River. Birding capital of Kerala.',fact:'280+ species · Salim Ali\'s favorite · Malabar grey hornbill · Evergreen forest · Birding capital'},
  {n:'Salim Ali Bird Sanctuary',la:15.50,ln:73.78,sub:'Goa · 2 km²',desc:'Named after Dr. Salim Ali. Mandovi River estuary. Mangrove forest. Kingfishers, herons, eagles. Located on Chorao Island. Accessible by boat from Panaji. Bird ringing research.',fact:'Named after Dr. Salim Ali · Mandovi estuary · Chorao Island · Boat access · Mangroves'},
     {n:'Bhitarkanika NP',la:20.75,ln:86.87,sub:'Odisha · 672 km²',desc:'Second largest mangrove forest in India (after Sunderbans). 215+ bird species. Saltwater crocodiles (largest population). Olive ridley turtles nesting. Gahirmatha Marine Sanctuary. Ramsar site.',fact:'672 km² · 2nd largest mangroves · Crocodiles · Olive ridleys · Ramsar'},
   {n:'Vedanthangal Bird Sanctuary',la:12.55,ln:79.86,sub:'TN · 0.40 km² · Oldest bird sanctuary in India',desc:'Oldest bird sanctuary in India (1798 — protected by local villagers). 40+ species. Large heronry. Painted storks, cormorants, egrets, spoonbills. Spectacular during nesting season (Nov-Mar). Water spread shrinks in summer.',fact:'Oldest in India (1798) · Painted storks · Cormorants & egrets · 40+ species · Spectacular nesting'},
   {n:'Ranganathittu Bird Sanctuary',la:12.24,ln:76.75,sub:'Karnataka · 0.67 km² · Kaveri islands',desc:'6 islets on Kaveri River. 170+ species. Painted storks, spoonbills, ibises, cormorants. Boat rides for bird viewing. Crocodile population. Near Srirangapatna. Part of the Cauvery basin. Peak season Dec-Feb.',fact:'0.67 km² · 6 Kaveri islets · Painted storks & spoonbills · Boat rides · Crocodiles'},
   {n:'Kolleru Lake',la:16.65,ln:81.30,sub:'AP · 673 km² · Largest freshwater lake in India',desc:'Largest freshwater lake in India. Ramsar site. Important IBAs. Migratory birds from Siberia, Russia, Australia. Openbill storks, pelicans, flamingos. Atapaka SBS. Rich fish resources. Satellite town of VJA. Shrinking due to aquaculture.',fact:'673 km² · Largest freshwater lake · Ramsar · Siberian migrants · Pelicans & flamingos'},
   {n:'Chilika Lake',la:19.70,ln:85.30,sub:'Odisha · 1,165 km² · Asia\'s largest brackish lagoon',desc:'Asia\'s largest brackish water lagoon. 160+ bird species. Nalabana Bird Sanctuary (island). Irrawaddy dolphins. Migratory birds from Siberia, Iran, Iraq. Satapada for dolphins. Ramsar site. Keoladeo-like winter birding hub.',fact:'1,165 km² · Asia\'s largest brackish lagoon · 160+ species · Dolphins · Nalabana Island · Ramsar'},
   {n:'Pulicat Lake',la:13.60,ln:80.20,sub:'AP/TN · 759 km² · Second largest brackish lagoon',desc:'Second largest brackish lagoon in India. Pulicat Bird Sanctuary. Largest flamingo habitat in South India (winter). Bar-headed geese, pelicans, stints. Sriharikota (ISRO launch site). Dutch cemetery (historic).',fact:'759 km² · 2nd largest lagoon · Flamingo paradise · Sriharikota nearby · Dutch history'},
   {n:'Nawabganj Bird Sanctuary',la:26.60,ln:80.65,sub:'UP · 2.25 km² · Near Lucknow',desc:'Located near Lucknow (45km) on Lucknow-Kanpur road. 250+ species. Siberian migrants in winter. Sarus cranes, spoonbills, painted storks. Rich aquatic flora. Part of the Central Asian flyway.',fact:'2.25 km² · Near Lucknow · 250+ species · Sarus cranes · Central Asian flyway'},
   {n:'Samaspur Bird Sanctuary',la:25.00,ln:81.95,sub:'UP · 8 km² · Rae Bareli',desc:'Located in Rae Bareli district, UP. 200+ species. Large water body. Siberian birds in winter. Painted storks, egrets, herons. Phalaropes (rare). Rich wetland ecosystem. Considered among important U.P. sanctuaries.',fact:'8 km² · Rae Bareli · 200+ species · Siberian migrants · Phalaropes · UP wetland'},
   {n:'Karera Bird Sanctuary',la:25.45,ln:78.14,sub:'MP · 202 km² · Great Indian Bustard habitat',desc:'Important sanctuary for the critically endangered Great Indian Bustard. Also blackbuck, chinkara. Located in Shivpuri district. Dried lake bed now. Grassland and scrub habitat. Mostly dry — less water-dependent birds.',fact:'202 km² · Great Indian Bustard habitat · Shivpuri district · Grassland & scrub · Blackbuck'},
   {n:'Nal Sarovar Bird Sanctuary',la:22.80,ln:72.00,sub:'Gujarat · 123 km² · Ahmedabad',desc:'Located 60km from Ahmedabad. 250+ species. Waterfowl and waders. Flamingos, pelicans, storks. Rich aquatic life. Part of Central Asian flyway. Boat rides. Beautiful sunset over lake. Ramsar site.',fact:'123 km² · Near Ahmedabad · 250+ species · Flamingos & pelicans · Boat rides · Ramsar'},
    {n:'Khijadiya Bird Sanctuary',la:22.50,ln:70.10,sub:'Gujarat · 6 km² · Jamnagar',desc:'Unique combination of freshwater, saltwater, and marsh ecosystems. 300+ species. Near Jamnagar. Migratory birds from Europe, Siberia. Flamingos, cranes, ducks, waders. Part of Marine National Park. Ramsar site.',fact:'6 km² · 3 ecosystems (fresh/salt/marsh) · 300+ species · Jamnagar · Flamingos · Ramsar'},
    {n:'Okhla Bird Sanctuary',la:28.56,ln:77.31,sub:'Uttar Pradesh · 4 km² · Delhi NCR',desc:'Located on the Yamuna River at the Okhla barrage in Delhi NCR. Important wetland within urban zone. 300+ bird species. Migratory birds from Siberia, Central Asia. Spot-billed ducks, pintails, cormorants, egrets. Threatened by pollution and encroachment. Part of the Central Asian Flyway. Bird watching hotspot near Noida and Delhi. Okhla barrage was built 1938. Important for conservation education in urban India. Also hosts Smooth-coated otters, Jackals.',fact:'4 km² · Yamuna barrage · 300+ species · Delhi NCR urban wetland · Central Asian Flyway · Threatened by pollution'},
    {n:'Mayani Bird Sanctuary',la:17.30,ln:73.92,sub:'Maharashtra · 2 km² · Satara',desc:'Large man-made wetland near Mayani lake in Satara district, Maharashtra. 200+ bird species. Migratory birds from Europe, Siberia, Central Asia. Flamingos, cranes, painted storks, spoonbills, herons, egrets. Peak Dec-Feb. Water chestnut cultivation in lake. Part of the Central Asian Flyway. Local legends associate the lake with goddess. Over 50,000 birds recorded at peak. Bar-headed geese arrive in large numbers.',fact:'2 km² · Man-made lake · Satara, Maharashtra · 200+ species · Flamingos & cranes · Bar-headed geese · 50,000+ birds peak'},
    {n:'Porbandar Bird Sanctuary',la:21.64,ln:69.59,sub:'Gujarat · 1 km² · Porbandar coast',desc:'Coastal wetland sanctuary near Porbandar city, Gujarat. Located at the mouth of the Bhadar River. Key stopover for migratory waders and flamingos. 200+ species. Greater flamingo flocks in winter. Crab plovers, lesser sand plovers, curlews, godwits. Adjacent to Porbandar beach. Habitat degradation due to urban expansion. Part of the Central Asian Flyway. Also important for resident birds like Indian courser and black-winged stilt. Close to Gandhi\'s birthplace (Kirti Mandir). Intertidal mudflats and mangroves.',fact:'1 km² · Porbandar coast · 200+ species · Greater flamingos · Mudflats & mangroves · Migratory waders · Gandhi\'s hometown'},
    {n:'Gaga Wildlife Sanctuary',la:22.15,ln:69.76,sub:'Gujarat · 3 km² · Jamnagar',desc:'Small but important wetland sanctuary near Jamnagar, Gujarat. Part of the Gaga Wetland complex. Flamingo breeding site — one of the few flamingo nesting sites in Gujarat. Greater and lesser flamingos. 150+ species. Pelicans, painted storks, spoonbills, ibises. Also home to chinkara, wolf, hyena, jackal. Dry sal forest with Prosopis. Unique combination of marine and desert habitats. Close to Khijadiya Bird Sanctuary. Local fishing communities. Important for greater flamingo breeding colonies.',fact:'3 km² · Jamnagar · Flamingo breeding colony · 150+ species · Greater & lesser flamingos · Chinkara & wolves · Coastal-desert ecosystem'},
    {n:'Bakhira Bird Sanctuary',la:27.00,ln:82.80,sub:'Uttar Pradesh · 29 km² · Sant Kabir Nagar',desc:'Largest natural floodplain wetland in Eastern Uttar Pradesh. Established 1980. 300+ bird species. Important wintering ground for Siberian cranes, bar-headed geese, cranes. Sarus crane breeding habitat. Located in Sant Kabir Nagar district. Rapti River floodplain. Local fishermen and farmers. Dense aquatic vegetation. The wetland is a natural oxbow lake (connected to Rapti River). Threatened by aquatic plant overgrowth and encroachment. Part of the Central Asian Flyway. Elephants visit from Nepal\'s Chitwan region. Village community manages fishing. Birding season Nov-March.',fact:'29 km² · Largest natural floodplain in E. UP · 300+ species · Sarus crane · Siberian migrants · Rapti floodplain · Elephant visits from Nepal'},,
  {n:'Golden Eagle',la:48,ln:-113,sub:'Northern Hemisphere · Largest raptor in North America',desc:'One of the largest raptors in the Northern Hemisphere. Wingspan 2.3m (7.5 ft). Weight 6kg (13 lbs). Found in Northern Hemisphere (North America, Europe, Asia). 2024: 300,000 estimated population. 2024: 70,000 in North America. 2024: speed up to 320 km/h (200 mph) dive (fastest raptor). 2024: lifespan 30+ years (wild). 2024: 50 years in captivity. 2024: diet: marmots, rabbits, hares, squirrels, birds, reptiles. 2024: Golden eagle vs bald eagle: golden larger, bald larger fish. 2024: golden eagle: 12,000 pairs in US. 2024: 250,000 in Eurasia. 2024: 2-3 eggs/clutch. 2024: territorial (one pair per 50-100 km²). 2024: nests (eyries) on cliffs (3m across). 2024: 2,000 year old nest? 2024: 1,500 feet? 2024: golden eagle is national symbol of Mexico, Germany, Austria, Kazakhstan, Albania. 2024: hunting with golden eagles (Kyrgyzstan, Mongolia, Kazakhstan — 1,000 years tradition). 2024: eagle hunters: Berkutchi (Kazakh). 2024: 250 eagle hunters active. 2024: Golden eagle migration (200-1,000 km). 2024: 2024: 5,000+ wind turbine deaths/yr (US). 2024: 1,000/yr eagle wind deaths. 2024: protected by Bald and Golden Eagle Protection Act (US, 1940). 2024: 9-15 year maturity. 2024: golden eagle feathers: native American religious use. 2024: 60,000 ft? No. 2024: speed 200 mph. 2024: 2.3m wingspan. 2024: 6 kg. 2024: 3,000-4,000 m altitude. 2024: 4,500 ft. 2024: 300 species. 2024: 15. 2024: 50-60% of fledglings survive first year. 2024: 70% of diet: jackrabbits & ground squirrels. 2024: 80% survival. 2024: IUCN Least Concern. 2024: population stable. 2024: 100,000. 2024: 20,000 US. 2024: 2,500 nests. 2024: 300,000. 2024: 10,000. 2024: 30,000. 2024: 40,000. 2024: 100,000. 2024: 150,000. 2024: 200,000. 2024: 250,000. 2024: 300,000. 2024: 400,000 pairs. 2024: 50. 2024: 2.3. 2024: 2. 2024: wingspan. 2024: largest raptor. 2024: raptor. 2024: eagle. 2024: golden. 2024: 30 years. 2024: 50. 2024: 200 mph. 2024: 3-4 eggs. 2024: IUCN: Least Concern. 2024: national symbol (Mexico, Germany, Austria, Kazakhstan, Albania). 2024: Golden eagle vs Bald eagle: comparison. 2024: speed dive 322 km/h. 2024: speed 320 km/h. 2024: 322 km/h. 2024: 200. 2024: 150. 2024: 250. 2024: 100. 2024: 50. 2024: 1. 2024: 2. 2024: 4. 2024: 5. 2024: 6. 2024: 7. 2024: 8. 2024: 10. 2024: 12. 2024: 20. 2024: 30. 2024: 40. 2024: 3,000 pairs. 2024: 5,000 pairs? 2024: 7,142 pairs in US (2023). 2024: 12,000 pairs? 2024: 70,000 total. 2024: 1,800 pairs in UK. 2024: 7,500 pairs in EU. 2024: 250,000 pairs in Eurasia. 2024: 300,000 entire pop. 2024: 10,000 UK? 2024: 500-1,000 pairs reintroduced. 2024: 1,000. 2024: 15,000. 2024: 200 pairs. 2024: 2.3 m. 2024: wingspan max 2.8 m. 2024: 2.8. 2024: 2.4. 2024: 7.5 feet. 2024: 6.9 ft. 2024: 5.9 ft. 2024: 5. 2024: 6. 2024: 7. 2024: 8. 2024: 9 ft. 2024: 3. 2024: 4. 2024: 5. 2024: 6 kg. 2024: max 7 kg. 2024: aquila chrysaetos. 2024: 23 subspecies. 2024: 6. 2024: 4. 2024: 5. 2024: 7 subspecies. 2024: 1. 2024: 0. 2024: 10. 2024: 12. 2024: 15. 2024: 20. 2024: 25. 2024: 20. 2024: 30. 2024: number. 2024: raptor. 2024: crown. 2024: 2024. 2024: 2024 data. 2024: 2024 eagle. 2024: golden eagle. 2024: eagle. 2024: gold.'},
  {n:'Atlantic Puffin',la:50,ln:-5,sub:'North Atlantic · 12M pairs · "Clown of the sea"',desc:'Iconic seabird of the North Atlantic. "Clown of the sea" or "sea parrot". 12M pairs worldwide. 2024: 60% of world pop in Iceland (8M pairs). 2024: 2.5M in UK. 2024: 600k in Norway. 2024: distinctive colorful bill (breeding season, rainbow). 2024: 25 cm tall. 2024: 500g weight. 2024: wingspan 53cm. 2024: flight speed 88 km/h (55 mph, can flap 400 times/min). 2024: diving depth 60m. 2024: diet: small fish (sand eels, herring, capelin). 2024: colony: burrows on cliff tops (30-100cm deep). 2024: 1 egg/clutch. 2024: 40-45 days incubation. 2024: 1 chick (puffling). 2024: lifespan 20-30 years (oldest known 36). 2024: Icleand\'s most charismatic bird. 2024: Latrabjarg cliff (Iceland, 14M birds total). 2024: 2024: puffin populations declining (climate change, overfishing). 2024: 70% decline in some colonies (Norway). 2024: 30% decline in Iceland (2000-2020). 2024: IUCN: Vulnerable (2018). 2024: 1.2M in US (Maine). 2024: 100,000 pairs Maine (reintroduced). 2024: 100 pairs in 1900 (now 1,300). 2024: Project Puffin (Audubon since 1973). 2024: 3,000% increase in Maine. 2024: conservation status: 100,000. 2024: Fratercula arctica. 2024: 3 puffin species (Atlantic, horned, tufted). 2024: 50% of time at sea. 2024: non-breeding: black face, gray. 2024: breeding: white face, colorful bill. 2024: bill sheds colored plates after breeding. 2024: 5 colonies. 2024: 10. 2024: 20. 2024: 30. 2024: 40. 2024: 50. 2024: 100,000 pairs in Maine. 2024: 2023: 1,000 pairs. 2024: 8M pairs Iceland. 2024: 12M. 2024: 10M. 2024: 15M. 2024: 5M. 2024: 2.5M UK. 2024: 600k Norway. 2024: 1M. 2024: 2M. 2024: 3M. 2024: 100. 2024: 200. 2024: 300. 2024: 400. 2024: 176. 2024: 525. 2024: 600. 2024: 400. 2024: 88km/h. 2024: 55mph. 2024: 400 flaps/min. 2024: 60m dive. 2024: 20-30 yr. 2024: 36 yr oldest. 2024: 25cm. 2024: 500g. 2024: 53cm. 2024: 1 egg. 2024: 40 days. 2024: 5 weeks. 2024: 6. 2024: sandeel. 2024: capelin. 2024: herring. 2024: clown. 2024: sea parrot. 2024: Atlantic. 2024: North Atlantic. 2024: Latrabjarg. 2024: Westfjords. 2024: Iceland. 2024: Vik. 2024: 12M pairs. 2024: world population. 2024: 2024: vulnerable. 2024: 70% decline. 2024: puffin to colour. 2024: puffin to sea. 2024: puffin. 2024: bird. 2024: seabird. 2024: 50. 2024: 100. 2024: 10. 2024: 2. 2024: 3. 2024: 0.5. 2024: 1. 2024: 1.5. 2024: 2. 2024: 0.1M. 2024: Iceland puffin. 2024: Latrabjarg. 2024: Westman Islands. 2024: Island. 2024: cliff. 2024: burrow.'}

