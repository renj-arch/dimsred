  {n:'Mumbai-Delvia',pts:[{la:19.08,ln:72.88},{la:23.26,ln:77.41},{la:26.85,ln:80.95},{la:28.61,ln:77.23}],sub:'Mumbai-Delhi (1385 km)',desc:'Mumbai-Delhi Line via Itarsi-Jhansi. Central Railway + West Central Railway. Rajdhani (Ahmedabad route), Paschim Express.',fact:'Western Dedicated Freight Corridor · JNPT connectivity · Palghar ~ Surat industrial belt'},
  {n:'Chennai-Delvia',pts:[{la:13.08,ln:80.27},{la:15.49,ln:80.04},{la:17.36,ln:78.47},{la:25.59,ln:85.14},{la:28.61,ln:77.23}],sub:'Chennai-Delhi (2181 km)',desc:'Grand Trunk route — longest north-south route via Vijayawada, Nagpur, Jhansi. GT Express.',fact:'G.T. Express (oldest) · Vijayawada junction · Nagpur Zero Mile · 2 longest railway route'},
  {n:'Konkan Railway',pts:[{la:15.49,ln:73.83},{la:14.33,ln:74.35},{la:13.38,ln:74.55},{la:12.98,ln:74.88}],sub:'Mumbai-Mangalore (740 km)',desc:'Spectacular route along Western Ghats & Arabian Sea. 92 tunnels, 2000 bridges. Built 1998. India\'s largest railway bridge (Sharavati).',fact:'93 tunnels total · Overnight route · Goa & coastal Karnataka · Dudhsagar waterfalls view'},
  {n:'Darjeeling Toy Train',pts:[{la:26.68,ln:88.30},{la:27.00,ln:88.27},{la:27.05,ln:88.27}],sub:'New Jalpaiguri-Darjeeling (88 km)',desc:'UNESCO WHS. 2 ft gauge. Zigzag & loop (Batasia). Steam engines. Built 1881. Runs at 12 kmph.',fact:'Batasia Loop (spiral) · Ghum (2258m, highest station in India) · UNESCO since 1999'},
  {n:'Kalka-Shimla Toy Train',pts:[{la:30.90,ln:76.94},{la:31.10,ln:77.17}],sub:'Kalka-Shimla (96 km)',desc:'UNESCO WHS (2008). 102 tunnels, 864 bridges, 917 curves. 2 ft 6 in gauge. Opened 1903.',fact:'102 tunnels (Barog longest 1144m) · 18 stations · Steam heritage · Scenic beauty'},
  {n:'Nilgiri Mountain Railway',pts:[{la:11.34,ln:76.78},{la:11.41,ln:76.70}],sub:'Mettupalayam-Ooty (46 km)',desc:'UNESCO WHS (2005). Ranked rack railway (cogwheel). 1 m gauge. 16 tunnels, multiple viaducts. Est. 1908.',fact:'Only rack railway in India · Steam powered · UNESCO WHS (2005) · Ooty summer station'},
  {n:'Howrah-Mumbai (via Nagpur)',pts:[{la:22.58,ln:88.33},{la:23.30,ln:87.30},{la:21.14,ln:79.10},{la:19.08,ln:72.88}],sub:'Howrah-Mumbai (1949 km)',desc:'Via Kharagpur, Nagpur. Gitanjali Express (oldest superfast). Steel & coal corridor.',fact:'Kharagpur workshop · Tatanagar junction · Nagpur "Zero Mile" · Itarsi junction'},
  {n:'Delhi-Kolkata (via Grand Chord)',pts:[{la:28.61,ln:77.23},{la:25.62,ln:85.12},{la:24.80,ln:86.20},{la:23.60,ln:87.30},{la:22.58,ln:88.33}],sub:'Delhi-Kolkata via Grand Chord (1452 km)',desc:'Via Grand Chord route — Mughalsarai, Gomoh. Shorter than main line. Rajdhani Express via this route.',fact:'Grand Chord (Gaya-Gomoh cut) · Rajdhani route · 1452 km · Mughalsarai yard'},
  {n:'Chennai-Bangalore',pts:[{la:13.08,ln:80.27},{la:12.95,ln:79.80},{la:12.60,ln:78.50},{la:12.95,ln:77.60}],sub:'Chennai-Bangalore (361 km)',desc:'Electrified double line. Shatabdi Express (fastest). Connects two IT hubs. via Arakkonam, Jolarpettai, KSR Bengaluru.',fact:'Shatabdi Express · 361 km · IT corridor · Double electrified'},
  {n:'Delhi-Jaipur-Ahmedabad',pts:[{la:28.61,ln:77.23},{la:26.90,ln:75.80},{la:24.60,ln:73.70},{la:23.03,ln:72.58}],sub:'Delhi-Jaipur-Ahmedabad (1024 km)',desc:'Western Railway main line. Connects Delhi to Rajasthan & Gujarat. Shatabdi & Rajdhani. Ahmedabad-Mumbai connects via Vadodara.',fact:'1024 km · Western Railway · Shatabdi · Delhi-Ahmedabad high-speed rail coming'},
  {n:'Gorakhpur-Siliguri',pts:[{la:26.75,ln:83.37},{la:26.50,ln:84.50},{la:26.00,ln:85.80},{la:24.80,ln:87.20},{la:26.72,ln:88.43}],sub:'Gorakhpur-Siliguri (530 km)',desc:'Northeast Frontier Railway. Connects UP to North Bengal via Bihar. Via Narkatiaganj, Sitamarhi, Darbhanga. Gateway to Northeast India.',fact:'NF Railway · 530 km · NE gateway · Gonda & Lucknow connectivity'},
  {n:'Chennai-Mumbai (via Konkan)',pts:[{la:13.08,ln:80.27},{la:12.95,ln:79.80},{la:11.00,ln:76.90},{la:10.80,ln:76.80},{la:12.98,ln:74.88},{la:19.08,ln:72.88}],sub:'Chennai-Mumbai via Konkan (1289 km)',desc:'Scenic route via Coimbatore, Palakkad, Mangalore, Konkan Railway. Chalukya Express & other trains.',fact:'Konkan route · 1289 km · Scenic Western Ghats · Palakkad Gap'},
  {n:'Trans-Siberian Railway',pts:[{la:55.76,ln:37.62},{la:53.20,ln:44.97},{la:56.84,ln:53.20},{la:58.01,ln:56.23},{la:57.00,ln:60.55},{la:56.13,ln:69.50},{la:55.34,ln:73.40},{la:55.04,ln:75.97},{la:55.47,ln:78.39},{la:55.02,ln:82.94},{la:55.87,ln:86.09},{la:56.00,ln:92.88},{la:56.14,ln:98.88},{la:56.00,ln:101.60},{la:55.85,ln:103.04},{la:56.40,ln:106.07},{la:56.10,ln:110.12},{la:56.00,ln:113.57},{la:55.50,ln:116.77},{la:55.60,ln:117.58},{la:55.52,ln:120.00},{la:54.80,ln:122.12},{la:53.70,ln:123.92},{la:53.30,ln:126.20},{la:53.50,ln:127.25},{la:53.40,ln:130.16},{la:53.39,ln:132.45},{la:53.20,ln:133.20},{la:53.00,ln:134.70},{la:52.00,ln:136.60},{la:51.70,ln:139.80},{la:50.84,ln:142.16},{la:49.10,ln:142.10}],sub:'Russia · Moscow to Vladivostok · 9,289 km',desc:'World\'s longest railway line. Moscow to Vladivostok across 8 time zones. 9,289 km. Building started 1891 (under Tsar Alexander III). Completed 1916. Connects Moscow, Yaroslavl, Yekaterinburg, Novosibirsk, Irkutsk, Lake Baikal, Vladivostok. 146 stations. Travel time: 6-7 days (non-stop). Baikal-Amur Mainline (BAM) branch. Electrified entire length. Carries 30% of Russia\'s freight. Used by 2M+ passengers annually. 100+ bridges and tunnels. Steam, diesel, electric eras. The "golden eagle" luxury train. Connects Europe to Asia overland. World\'s longest continuous rail journey. Scenic highlight: Lake Baikal (deepest lake). Epic train travel bucket list.',fact:'9,289 km (world\'s longest) · Moscow to Vladivostok · 8 time zones · 1916 complete · Lake Baikal · Trans-Siberian epic · 6-7 day journey'},
  {n:'Orient Express',pts:[{la:48.86,ln:2.35},{la:50.85,ln:4.35},{la:48.14,ln:11.58},{la:48.21,ln:16.37},{la:47.50,ln:19.04},{la:44.43,ln:26.10},{la:41.02,ln:28.98}],sub:'Paris to Istanbul · 3,000 km',desc:'World\'s most famous train route. Paris to Istanbul, 3,000 km. Started 1883 (Compagnie Internationale des Wagons-Lits). Original route: Paris-Strasbourg-Munich-Vienna-Budapest-Bucharest-Constanța-Varna-Istanbul. Later simplified to Paris-Milan-Venice-Belgrade-Sofia-Istanbul. Sleeping cars, dining cars — height of luxury. Murder on the Orient Express (Agatha Christie, 1934). Orient Express was daily train until 1977. Venice Simplon-Orient-Express (VSOE) — restored 1980s private luxury service. Kings, spies, diplomats, writers rode. 1929 train trapped in Turkey for 6 days (inspired Christie). Train immortalized in film and fiction. Simplon Tunnel (19.8 km — longest in world when built 1906). Modern VSOE: Venice to London (with Paris stop). Belle Époque glamour. Deco and Edwardian carriages. Legendary onboard service. One of world\'s greatest train journeys.',fact:'3,000 km · Paris to Istanbul · 1883 debut · Belmond luxury · Agatha Christie\'s Murder on the Orient Express · Simplon Tunnel · Belle Époque · King of trains'},
  {n:'Shinkansen (Tōkaidō Line)',pts:[{la:35.68,ln:139.69},{la:35.32,ln:139.45},{la:35.18,ln:138.67},{la:35.11,ln:138.22},{la:35.01,ln:138.49},{la:34.99,ln:138.10},{la:34.84,ln:137.54},{la:34.76,ln:137.39},{la:34.57,ln:137.08},{la:34.59,ln:136.53},{la:34.72,ln:135.50},{la:34.83,ln:135.43},{la:34.70,ln:135.49},{la:34.67,ln:135.50},{la:34.52,ln:135.40}],sub:'Japan · Tokyo to Osaka · 515 km',desc:'High-speed rail line between Tokyo and Osaka. First high-speed rail in the world (1964 Tokyo Olympics). Shinkansen ("bullet train") — 320 km/h maximum. 515 km in 2h21m. Over 400,000 passengers daily. Zero passenger fatalities in 60+ years — legendary safety record. 16-car N700 series trains. Tokyo, Yokohama, Nagoya, Kyoto, Osaka — major cities. 285 stations. 7 other Shinkansen lines across Japan. Trains every 3-5 minutes at peak. Punctuality: average delay <1 minute. Earthquake safety: immediate braking system. 1964 enabled Olympics tourism boom. Reduced travel time from 6h40m to 2h21m. Shinkansen network: 2,765 km total. Driverless trains (planned for future). Snow, earthquake, tsunami resilient design. Green Car (first class) — reclining seats, amenities. Cultural icon — symbol of Japanese efficiency.',fact:'515 km · Tokyo to Osaka · 320 km/h · 1964 (world\'s first HSR) · Zero fatalities since 1964 · N700 series · 2h21m · Symbol of Japan'},
  {n:'Eurostar (Channel Tunnel)',pts:[{la:51.53,ln:-0.13},{la:50.85,ln:1.15},{la:50.11,ln:1.84},{la:50.07,ln:2.05},{la:50.01,ln:2.17},{la:50.00,ln:2.48},{la:49.93,ln:3.00},{la:49.72,ln:3.42},{la:48.86,ln:2.35}],sub:'London to Paris · 495 km · 2h15m',desc:'High-speed train connecting London (St Pancras) to Paris (Gare du Nord) and Brussels. Channel Tunnel (50km — longest undersea tunnel) between Folkestone and Calais. Opened 1994. 2h15m London-Paris, 2h Brussels. 300 km/h through France (below 160 km/h in UK until HS1 opened 2007). 400 trains/day at peak. 20M passengers/year (pre-COVID). One of world\'s busiest international rail routes. Dual voltage (25 kV in France/UK, 750 V DC in tunnel). 50km Channel Tunnel - 38km undersea (deepest point 75m below seabed). Immense engineering project: 15,000 workers, 11 TBMs. Safety: LeShuttle carries cars/trucks. Fire safety: 1996, 2006, 2012 fires (no casualties). UK border checks in Paris and Brussels (juxtaposed controls). Eurostar e320 trains. Integrated European rail network. Green travel: 1/10th the carbon of flying. Climate-friendly travel increasingly popular. "Railway of the 21st century." Brexit introduced passport checks (delays).',fact:'495 km · London-Paris 2h15m · Channel Tunnel (50km undersea) · 1994 opening · 300 km/h · 20M passengers/yr · Juxtaposed border · Green alternative to flying'},
  {n:'Glacier Express',pts:[{la:46.80,ln:10.08},{la:46.81,ln:9.85},{la:46.76,ln:9.60},{la:46.65,ln:9.58},{la:46.57,ln:9.53},{la:46.52,ln:9.42},{la:46.43,ln:9.37},{la:46.35,ln:9.23},{la:46.25,ln:9.17},{la:46.09,ln:9.15},{la:45.93,ln:9.14},{la:45.92,ln:9.10},{la:45.94,ln:9.03},{la:45.87,ln:8.96},{la:45.85,ln:8.89},{la:45.84,ln:8.80},{la:45.86,ln:8.78},{la:45.88,ln:8.73},{la:45.88,ln:8.66},{la:45.88,ln:8.60},{la:45.82,ln:8.57},{la:45.80,ln:8.52},{la:45.84,ln:8.46},{la:45.86,ln:8.40},{la:45.86,ln:8.32},{la:45.90,ln:8.24},{la:45.90,ln:8.19},{la:45.89,ln:8.13},{la:45.94,ln:8.02},{la:46.01,ln:7.93},{la:46.02,ln:7.86},{la:46.07,ln:7.79},{la:46.08,ln:7.73}],sub:'Switzerland · Zermatt to St Moritz · 291 km',desc:'"Slowest express train in the world" — 291 km in 8 hours (avg 35 km/h). Spectacular Swiss Alpine scenery. 291 bridges, 91 tunnels. Landwasser Viaduct (iconic curved stone bridge). Oberalp Pass — highest point at 2,033m. Glacier (Rhône) and Rhine Gorge (Swiss Grand Canyon). From Zermatt (Matterhorn) to St Moritz (Engadin). First class panorama windows (floor-to-ceiling). Operated by Matterhorn Gotthard Bahn. 2,033m at Oberalp Pass — snow-covered often. Oldest continuously operating scenic railway. 1930 inaugural. Disney-style fairy tale landscape. Crosses the Landwasser River — curved viaduct photo is iconic. 3-course meal served at seat. Electrical power (overhead wires). Connects 2 famous Alpine resorts. One of the most scenic train journeys in the world. Reservations mandatory. Award-winning travel experience.',fact:'291 km · Zermatt to St Moritz · 8 hours · "Slowest express" · 291 bridges · 91 tunnels · Oberalp Pass 2,033m · Landwasser Viaduct · Swiss Alpine scenery'},
  {n:'Beijing-Shanghai HSR',pts:[{la:39.90,ln:116.40},{la:39.10,ln:117.20},{la:36.70,ln:117.00},{la:34.30,ln:117.20},{la:32.10,ln:118.80},{la:31.20,ln:121.50}],sub:'China · Beijing-Shanghai · 1,318 km · 4h30m',desc:'World\'s busiest high-speed rail line. 1,318 km between China\'s two largest cities. Opened June 30, 2011. 380 km/h maximum speed (fastest regular service in the world initially). 4h30m travel time (vs 12h conventional, 2h flight). 200M+ passengers annually. 24 stations including Nanjing, Jinan, Xuzhou, Tianjin. Fuxing Hao (CR400AF/BF) — 350 km/h operational. Reduced carbon emissions vs flying. 5,000+ trains per month. Economic impact: 2-3x GDP growth along corridor. Build time: 3 years (2008-2011). 1,200 workers per km. 2,200 MW power consumption. Only HSR in world that operates at 350 km/h year-round. World\'s longest HSR line at time of opening. Ticket price competitive with economy flights. 80% punctuality rate. Scenic: flat North China Plain, Yellow River, Yangtze River crossings. Symbol of China\'s infrastructure leadership.',fact:'1,318 km · Beijing to Shanghai · 350 km/h · World\'s busiest HSR · 200M+ passengers/yr · 2011 opening · 4h30m · Fuxing Hao · Economic corridor'},,
  {n:'Trans-Siberian Railway',la:55,ln:83,sub:'Russia · 9,289km · World\'s longest railway',desc:'World\'s longest railway line. 9,289km connecting Moscow to Vladivostok. Crosses 8 time zones. 87 cities, 30+ rivers. Construction 1891-1916 under Tsar Alexander III and Nicholas II. 7 days continuous travel. Trains: Rossiya (1/2), Grand Express, Baikal-Mongolia. Electrified entire route (2002). 2023: 15M+ passengers annually. 100+ stations. Lake Baikal route section (Circum-Baikal Railway — 1904, engineering marvel). 128 tunnels. 2,300 bridges. Maximum speed 100-140 km/h. 2024: modernizing with new trains (Grand Express luxury). Trans-Siberian+Trans-Mongolian to Beijing. Trans-Manchurian branch. Cargo: oil, lumber, containers (30% of Russia\'s rail freight). The Forgotten Railway: Baikal-Amur Mainline (BAM, 4,324km) built 1930s-1980s. 60% of Russia\'s total rail freight. 2022: record container traffic (1.5M TEU). 2023: Russia-China trade via Trans-Siberian up 30%. World\'s longest electrified railway. 16,000+ freight trains per year. Ticket cost Moscow-Vladivostok: $400-1500. 2018: FIFA World Cup special trains. 2024: high-speed rail plans under discussion. Ural Mountains, Siberia, Russian Far East. 40+ stops. Yekaterinburg, Novosibirsk, Irkutsk, Ulan-Ude, Khabarovsk, Vladivostok. Novosibirsk — largest station on route. Omsk, Krasnoyarsk, Chita. Volga, Ob, Irtysh, Yenisei, Amur rivers crossed. 3,000km in frozen permafrost. 2,000+ bridges over rivers. Winter temperatures -40°C. 7 time zone change. 2020: reduced service during COVID. 2023: new tourist railcar "Imperial Russia". Chinese tourists 30% of passengers. Oldest sections: 1842 St Petersburg-Moscow.',fact:'9,289km (world\'s longest) · Moscow-Vladivostok · 8 time zones · 87 cities · 128 tunnels · 2,300 bridges · 7 days travel · 1891-1916 construction · 15M+ passengers/year · Circum-Baikal Railway · Trans-Mongolian to Beijing · $400-1500 ticket · -40°C temperatures'},
  {n:'Bernina Railway',la:46.38,ln:10.02,sub:'Switzerland · 61km · UNESCO World Heritage',desc:'Highest alpine railway crossing in Europe. 61km from St. Moritz to Tirano (Switzerland-Italy). UNESCO World Heritage (2008, Rhaetian Railway). No rack-and-pinion — pure adhesion railway on steep gradients (7% grade). Highest point: Ospizio Bernina (2,253m). Opened 1910. 15 tunnels, 52 viaducts. Brusio Circular Viaduct — iconic spiral viaduct (9-arch, 360° loop). Glacier Express connects to Zermatt. Bernina Express panoramic train — 2.5 hour journey. 2023: 500k passengers/year. St. Moritz — luxury ski resort. Tirano — Italian town, connection to Milan. Morteratsch Glacier views. Lago Bianco, Lej Nair — alpine lakes. Diavolezza — mountain station 2,973m. Alp Grüm — panoramic viewpoint. Montebello curve — famous photo spot. 2008: World Heritage status. 2024: new panoramic carriages. Winter service year-round. 365 days/year operation. 40 bridges. 5 towns, 10 stations. Maximum gradient: 7% (1 in 14.3). Electric railway (1000V DC overhead). 1910-1914: construction under difficult alpine conditions. 4,000+ workers built it. 201 km/h cross-border route. Swiss Grand Train Tour. 60% of passengers are tourists. First Class panoramic windows. Dining car service. 2022: Bernina Express voted Europe\'s most beautiful train ride. 2023: record year — 600k passengers. Tirano-Milan connection for cruise ships. St. Moritz tourism (200k visitors/year). Engadin valley. UNESCO World Heritage Railway (shared with Albula Railway). 2010: Albula-Bernina UNESCO designation.',fact:'61km · Switzerland-Italy · UNESCO 2008 (Rhaetian Railway) · highest alpine crossing (2,253m) · no rack-and-pinion (7% grade) · Brusio Circular Viaduct · Bernina Express · St. Moritz to Tirano · 15 tunnels · 52 viaducts · 500k passengers/year · opened 1910'},
  {n:'Orient Express',la:48.87,ln:2.33,sub:'Europe · Paris to Istanbul · 2,800km',desc:'Legendary long-distance passenger train. 2,800km from Paris Gare de l\'Est to Istanbul Sirkeci. Launched 1883 by Compagnie Internationale des Wagons-Lits. Original route: Paris-Strasbourg-Stuttgart-Munich-Vienna-Budapest-Bucharest-Varna-Istanbul (sea connection). Direct Istanbul service from 1889 via Belgrade-Sofia. Luxury sleeping cars, dining cars — epitome of luxury travel. Famous for intrigue, espionage, murder mysteries. Agatha Christie: "Murder on the Orient Express" (1934). Ian Fleming wrote James Bond on board. Golden age: 1883-1914, 1920s-1930s. Closed: 1977 (direct Paris-Istanbul discontinued). 1982: restored private service Venice Simplon-Orient-Express (Belmond) — London-Paris-Venice. Original Wagon-Lits restored. 2023: Belmond Venice Simplon-Orient-Express from $3,590/person. 2024: La Dolce Vita Orient Express (Italy) launching. 2021: Orient Express announces 2025 return Paris-Istanbul. 2025: Orient Express La Dolce Vita Italia. 16+ iconic routes. Compagnie des Wagons-Lits hotel cars. World\'s most famous train murder (Christie). Film adaptations: 1974 (Albert Finney, Ingrid Bergman); 2017 (Kenneth Branagh, Johnny Depp). James Bond connection: From Russia with Love. 1919: Simplon Tunnel opened, new route via Lausanne, Milan, Venice. Orient-Express hotels: Cipriani Venice, Hotel de Paris Monte-Carlo, etc. 2024: Maxime d\'Angeac-designed interiors. Original 1920s Art Deco carriages. Dinner service: silver, crystal, linen. Michelin-starred chefs. 2023: Venice Simplon-Orient-Express summer routes include Paris-Istanbul again (5 days, $40k). Night train culture. 2019: new Orient Express brand train sets for 2025. Orient Express heritage brand now owned by Accor. 2024: new Orient Express train unveiled at Versailles. World\'s most legendary train. The Train of Kings. 1883 inaugural journey (3,000 guests).',fact:'2,800km · Paris to Istanbul · 1883 inaugural · Compagnie Internationale des Wagons-Lits · luxury sleeper/dining cars · Agatha Christie "Murder on the Orient Express" · Belmond Venice Simplon-Orient-Express · James Bond · 1977 direct service ended · 2025 return planned · $3,590-$40k tickets · 1919 Simplon Tunnel route'},
  {n:'Qinghai-Tibet Railway',la:32,ln:91,sub:'China · 1,956km · World\'s highest railway',desc:'World\'s highest railway by altitude. 1,956km from Xining (Qinghai) to Lhasa (Tibet). Highest point: Tanggula Pass (5,072m). 80% of route above 4,000m. Opened 2006 (Golmud-Lhasa section). Xining-Golmud section opened 1984. 50+ oxygen supply systems in carriages. Pressurized trains to combat altitude sickness. 14 tunnels, 675 bridges. Fenghuoshan tunnel — world\'s highest rail tunnel (4,905m). 550km of track built on permafrost. Special engineering: bridges over permafrost (heat pipes, crushed rock embankments). 2023: 20M+ passengers carried. Lhasa station — 3,642m. Golmud-Lhasa travel time: 14 hours. Xining-Lhasa overnight train: 22 hours. Tibet Express (Z165, Z21). 2021: Lhasa-Nyingchi railway opened (435km, 47 tunnels, 121 bridges). 2022: Sichuan-Tibet railway under construction (1,838km, extremely difficult terrain). Train features: supplementary oxygen outlets, Tibetan prayer flags decor. Tibetan antelope (chiru) crossing corridors along route. Environmental impact: 3,000 wild animal crossings. 2024: new electric locomotives (Fuxing model). Labor: 200,000+ workers. 2023: trains now run daily (multiple services). 20+ stations. Lhasa, Nagqu, Golmud, Delingha, Xining. Nagqu station — world\'s highest (4,514m). 60% of cargo to Tibet via railway. 2024: tourist boom — 40M+ visitors to Tibet annually. Direct trains: Beijing-Lhasa (40h), Shanghai-Lhasa (47h), Chengdu-Lhasa, Guangzhou-Lhasa. China\'s engineering miracle. Cost: $4.2 billion. 1,140km of permafrost line. 2021: Fuxing high-speed trains on Xining-Golmud section (200 km/h). 2024: Golmud-Korla railway connection opens. 20,000+ workers employed for Golmud-Lhasa. 50M tonnes freight/year. Qinghai Lake views. Tanggula Mountains. Kekexili (Hoh Xil) nature reserve.',fact:'1,956km · world\'s highest (5,072m Tanggula Pass) · Xining to Lhasa · 2006 opened · 80% above 4,000m · permafrost engineering · oxygen-supplied carriages · 14 tunnels · 675 bridges · 20M+ passengers/year · Tibet Express · $4.2 billion · Fenghuoshan Tunnel (4,905m) · Lhasa-Nyingchi railway 2021'},
  {n:'Highland Railway (Scotland) / Far North Line',la:57.44,ln:-4.22,sub:'Scotland · 270km · Inverness to Wick/Thurso',desc:'Epic Scottish railway journey. 270km from Inverness to Wick and Thurso (Far North Line). Britain\'s most northerly railway. Kyle of Lochalsh Line: 100km Inverness-Kyle (scenic, coastal). West Highland Line: Fort William-Mallaig (Hogwarts Express — Glenfinnan Viaduct). Glenfinnan Viaduct — 380m curved viaduct, 21 arches (1898). Harry Potter filmed here (Jacobite steam train). Famous for stunning scenery: mountains, lochs, coastline. 2023: 1M+ visitors on Jacobite Steam Train. 2024: new safety rules limiting window-hanging on Jacobite. North Coast 500 road route parallels. Landmark: Helmsdale, Golspie, Brora, Lairg. Thurso — most northerly town on British mainland. Wick — herring fishing history. 100+ stations (many request stops). Dingwall, Tain, Golspie, Thurso. Highest station: Corrour (410m, West Highland Line). Remote: trains pass through empty wilderness. 2019: first direct Inverness-London sleeper service upgraded. Caledonian Sleeper — 15 hours, double beds. 2023: ScotRail taken into public ownership. 2024: decarbonization plans (battery trains). Trainspotting: 2-3 car diesel trains. 1 train every 3-4 hours in remote areas. 2018: new station at Inverness Airport opened. 2021: level crossing upgrades. 1990s: line threatened with closure, saved by community campaigns. 50% of Far North Line passengers use for commuting; 50% tourism. 2022: record passenger numbers (400k/year Far North). 2023: Highland Railway 150th anniversary. Single-track with passing loops. Highest rail bridge in Scotland: Glenfinnan Viaduct. Jacobite Steam Train runs April-October. 2017: Harry Potter 20th anniversary boosted tourism. 2024: additional services added for 2025. 4 major scenic railway lines in Scotland. "The most beautiful train journey in the world."',fact:'270km · Inverness to Wick/Thurso · Far North Line · Glenfinnan Viaduct (Harry Potter/Jacobite Steam Train) · West Highland Line · Kyle of Lochalsh Line · 21-arch viaduct (1898) · 1M+ visitors/yr · Caledonian Sleeper · Corrour station (410m highest) · Scotland\'s wild beauty · request stops'}

];

D.wildlife = [
  {n:'Sultanpur Bird Sanctuary',la:28.48,ln:76.89,sub:'Haryana · Ramsar 2021',desc:'Important bird area (IBA). Near Gurugram. 250+ bird species. Migratory: flamingo, crane, pelican.',fact:'Ramsar site (2021) · Sultanpur Lake · 143 sq km · Nesting & wintering ground'},
  {n:'Bharatpur Bird Sanctuary',la:27.16,ln:77.52,sub:'Rajasthan · (same as Keoladeo NP)',desc:'UNESCO WHS, Ramsar site. Man-made wetland. 364 bird species. Wintering ground for Siberian cranes.',fact:'See Keoladeo NP above'},
  {n:'Mudumalai Sanctuary',la:11.60,ln:76.55,sub:'Tamil Nadu',desc:'Part of Nilgiri Biosphere. Connected to Bandipur, Wayanad, Nagarhole. Elephant corridor crucial.',fact:'Elephant, tiger, leopard · 321 sq km · Gudalur forest division · Sigur plateau'},
  {n:'Wayanad Sanctuary',la:11.70,ln:76.20,sub:'Kerala',desc:'Part of Nilgiri Biosphere. 344 sq km. Elephant corridor. Kabini river. Dense moist deciduous forest.',fact:'Second largest wildlife sanctuary in Kerala · Wayanad district · Edakkal caves nearby'},
  {n:'Dachigam Sanctuary',la:34.15,ln:75.00,sub:'J&K',desc:'In Zabarwan Range near Srinagar. Hangul (Kashmir stag) — critically endangered. Est. 1910.',fact:'Only habitat for Hangul · Dal Lake catchment · 141 sq km · Snow leopard present'},
  {n:'Siberian Crane Habitat',la:0,ln:0,sub:'Various wetlands in India',desc:'Siberian crane migrates to India (Keoladeo, etc.). Critically endangered. Climate change threat.',fact:'One of longest migration birds (6000 km) · Only 4-6 in wild · Now stops in Iran'},
  {n:'Corbett Sanctuary (buffer)',la:29.50,ln:78.60,sub:'Uttarakhand',desc:'Part of Corbett Tiger Reserve. Kalagarh Tiger Reserve buffer. Sonanadi Wildlife Sanctuary adjacent.',fact:'See Jim Corbett NP above'},
  {n:'Kalakkad Mundanthurai TR',la:8.50,ln:77.35,sub:'Tamil Nadu · Tiger reserve',desc:'In Western Ghats (Agasthyamalai hills). 895 sq km. Kalakkad NP + Mundanthurai Sanctuary. Important for lion-tailed macaque.',fact:'Lion-tailed macaque haven · Tiger reserve (1988) · Western Ghats · Grizzled squirrel'},
  {n:'Satpura Tiger Reserve',la:22.30,ln:78.10,sub:'Madhya Pradesh',desc:'Satpura NP + Bori + Pachmarhi Sanctuaries. Hilly terrain. Denwa river. Boating safari (unique in MP). Tiger, leopard.',fact:'Satpura = "seven folds" · Boating safari in Denwa · Pachmarhi hill station within · ~2200 sq km'},
  {n:'Koyna Wildlife Sanctuary',la:17.42,ln:73.75,sub:'Maharashtra',desc:'Part of Western Ghats UNESCO. Koyna dam backwaters. Tiger, leopard, gaur. 424 sq km. Est. 1985.',fact:'Western Ghats UNESCO · Koyna reservoir · Sahyadri Tiger Reserve part · 200+ bird species'},
  {n:'Chinnar Wildlife Sanctuary',la:10.30,ln:77.22,sub:'Kerala · Dry zone',desc:'Unique dry thorn forest in otherwise wet Kerala. Grizzled giant squirrel (endangered). Star tortoise. 90 sq km.',fact:'Grizzled giant squirrel · Dry zone in Western Ghats · Eravikulam border · Thorn forest'},
  {n:'Thattekkad Bird Sanctuary',la:10.13,ln:76.70,sub:'Kerala · Dr. Salim Ali\'s choice',desc:'India\'s first bird sanctuary (1983). Designed by Dr. Salim Ali. 25 sq km on Periyar. 280+ bird species.',fact:'Dr. Salim Ali\'s sanctuary · 280+ birds · Periyar river · 25 sq km'},
  {n:'Bhadra Wildlife Sanctuary',la:13.40,ln:75.60,sub:'Karnataka',desc:'Part of Bhadra Tiger Reserve. In Western Ghats (Chikkamagaluru district). Bhadra river. Tiger, elephant, leopard.',fact:'Bhadra Tiger Reserve · 890 sq km · Elephant corridor · Muthodi forest zone'},
  {n:'Sita Mata Wildlife Sanctuary',la:24.00,ln:74.50,sub:'Rajasthan · Flying squirrel',desc:'In Pratapgarh, Rajasthan. Only sanctuary for giant flying squirrel. Phulwari Ki Nal. 423 sq km. Deciduous forest.',fact:'Flying squirrel · Phulwari Ki Nal · 423 sq km · 400+ plant species'},
  {n:'Pakhal Wildlife Sanctuary',la:17.60,ln:80.00,sub:'Telangana',desc:'Man-made Pakhal Lake (Kakatiya dynasty, 1213 CE). 879 sq km. Tiger, leopard, sambar, sloth bear. Heritage site.',fact:'Pakhal Lake built by Kakatiya king Ganapati Deva · 13th C · 879 sq km · Warangal district'},
  {n:'Wild Ass Sanctuary',la:23.75,ln:70.70,sub:'Gujarat · Little Rann',desc:'Only home of Indian wild ass (khur). Little Rann of Kutch. 4954 sq km. Flamingo & pelican breeding. ESA listing.',fact:'Khur (Indian wild ass) · Little Rann · 4954 sq km · Flamingo · Desert National Park'},
  {n:'Dandeli Wildlife Sanctuary',la:15.50,ln:74.60,sub:'Karnataka · Kali river',desc:'Second largest wildlife sanctuary in Karnataka (886 sq km). Kali river flows through. Dense moist deciduous and semi-evergreen forests. Wildlife: tigers, leopards, elephants, black panthers (rare). 200+ bird species — birdwatcher\'s paradise. River rafting in Kali river. Sykes Point viewpoint. Kavala Caves — natural limestone cave. Syntheri Rocks — monolithic granite gorge. Nagzari Dam and backwaters. Est. 1956. Part of Kali Tiger Reserve. Hornbill nesting site. Kingfisher, drongos, barbets.',fact:'886 sq km · Kali river · Tiger & black panther · Birdwatcher\'s paradise · River rafting · Kavala caves · Kali Tiger Reserve'},
  {n:'Chambal River Sanctuary',la:26.50,ln:78.50,sub:'MP/Rajasthan/UP · 5,400 sq km',desc:'Unique riverine sanctuary along Chambal River. Known as "one of the cleanest rivers in India." Critical habitat for Ganges river dolphin (Platanista). Gharial (fish-eating crocodile) — largest population in India. Red-crowned roof turtle, Indian skimmer, black-bellied tern. 330+ bird species. National Chambal Sanctuary (1979). 5,400 sq km across 3 states. Rare Ganga dolphin nesting. 25,000-50,000 gharial migration. No fishing, no boating zones. Protected by forest guards and local communities. Solar fences to reduce human-wildlife conflict. Human-crocodile coexistence studied.',fact:'5,400 sq km · Chambal River · Ganges dolphin · Gharial population · 330+ birds · 3-state sanctuary · 1979'},
  {n:'Melghat Tiger Reserve',la:21.50,ln:77.00,sub:'Maharashtra · 2,768 sq km',desc:'First tiger reserve in Maharashtra (1974). Satpuda range. Dense dry deciduous forest. 2,768 sq km (core 1,500 sq km). 51 tigers (2022 census). 6 major rivers: Tapti, Dolar, Sipna, Gadga, Khapra, Wan. Kolkazari tribal communities. 3 parts: Gugamal NP, Ambabarwa, Wan Sanctuaries. 75+ tigers in wider Satpuda landscape. Project Tiger site. Rich avifauna — 250+ bird species. Gaur, sambar, nilgai, sloth bear, leopard. Narnala fort within reserve. Gond tribal art. Semadoh tourist complex. Forest rest houses and nature trails. Recently connected with Pench landscape.',fact:'2,768 sq km · 1st tiger reserve in Maharashtra (1974) · Satpuda range · 51 tigers · Gaur & sloth bear · Kolkazari tribes · Gugamal NP'},,
  {n:'Bharatpur Bird Sanctuary',la:27.16,ln:77.52,sub:'India · 29 km² · Rajasthan',desc:'UNESCO World Heritage (1985). 29 km² former duck-hunting reserve of Maharajas. 370+ bird species. Major wintering ground for Siberian migrants. Sarus crane breeding. Painted storks, spoonbills, openbill storks. 6+ kingfisher species. Sambar, nilgai, wild boar. Cycle rickshaws. 100+km dykes. 1981 drought threatened sanctuary. 50 km from Agra.',fact:'UNESCO 1985 · 29 km² · 370+ bird species · Siberian migrants · Sarus crane · Painted storks · former Maharaja hunting reserve · cycle rickshaws · Rajasthan'},
  {n:'Etosha National Park',la:-19,ln:16,sub:'Namibia · 22,270 km²',desc:'One of Africa\'s largest reserves. Etosha Pan — 4,760 km² salt pan. 114 mammals: lion, leopard, cheetah, elephant, black rhino, white rhino, giraffe, zebra, gemsbok, kudu, springbok, eland. 340+ birds: ostriches, kori bustard, secretary bird, flamingos. 16 waterholes — wildlife concentrates in dry season. Okaukuejo spotlit waterhole night viewing. 4x4 self-drive safaris. Etosha means "Great White Place." KAZA transfrontier conservation area. Established 1907 by German administration.',fact:'22,270 km² · Etosha Pan (4,760 km² salt pan) · 114 mammals · 340+ birds · Okaukuejo night waterhole · black & white rhino · lions, cheetah · self-drive safaris · KAZA area'},
  {n:'Serengeti National Park',la:-2.3,ln:34.8,sub:'Tanzania · 14,763 km²',desc:'UNESCO World Heritage (1981). 14,763 km². 1.5M wildebeest, 200k zebra, 300k gazelle — Great Migration. Grumeti and Mara river crossings. 4,000 lions (largest population in Africa). 1,000+ leopards, 3,500+ hyenas, cheetah. 500+ bird species. Seronera Valley, kopjes. Masai people co-exist. Olduvai Gorge (Leakey\'s human origins). 350k+ visitors/year. Hot air balloon safaris. Ngorongoro Crater nearby. "Endless plains" in Masai.',fact:'14,763 km² · UNESCO 1981 · 1.5M wildebeest migration · 4,000 lions · 1,000+ leopards · cheetah · Olduvai Gorge (human origins) · hot air balloon · "endless plains"'},
  {n:'Yellowstone National Park',la:44.6,ln:-110.5,sub:'USA · 8,991 km² · World\'s first NP',desc:'World\'s first national park (1872). 8,991 km². Yellowstone Caldera — supervolcano. 300+ geysers (half of world's total). Old Faithful (35-120 min). Grand Prismatic Spring (largest hot spring in US). Mammoth Hot Springs. Grand Canyon of the Yellowstone. Yellowstone Lake. 67 mammals: grizzly (700+), wolf (reintroduced 1995), bison (5k), elk (30k). 300+ birds: bald eagle, trumpeter swan. 4.5M visitors/year. 1988 wildfires (36% of park). 2022 severe floods destroyed roads.',fact:'8,991 km² · world\'s first national park (1872) · Yellowstone supervolcano · Old Faithful geyser · Grand Prismatic Spring · grizzly bears, wolves, bison · 4.5M visitors/year · 2022 floods'},
  {n:'Galápagos National Park',la:-0.5,ln:-90.5,sub:'Ecuador · 7,970 km²',desc:'UNESCO World Heritage (1978). 19 main islands. Darwin\'s finches — evolution theory born here (1835). Giant tortoises (15 species, up to 250kg). Marine iguanas (only sea-going iguana). Blue-footed boobies. Galápagos penguins (only north of equator). Flightless cormorant. Sea lions (50k+). Hammerhead sharks, whale sharks. 500+ endemic plant species. 270k visitors/year. Strict naturalist guide system. Charles Darwin Research Station. Lonesome George died 2012. Invasive species threat. Marine reserve 133k km².',fact:'UNESCO 1978 · 19 islands · Darwin & evolution · giant tortoises · marine iguanas · blue-footed boobies · Galápagos penguins · hammerhead sharks · Lonesome George · 270k visitors/year · invasive species threat'}

];
// ============================================================
// KINGDOMS & EMPIRES
// ============================================================
function territory(pts){return pts.map(([la,ln])=>({la,ln}))}
D.kingdom = [
   {n:'Maurya Empire',sub:'321-185 BCE',la:25.61,ln:85.14,desc:'First pan-Indian empire. Founded by Chandragupta Maurya (321 BCE). Peak under Ashoka the Great (268-232 BCE) — unified most of subcontinent. Spread Buddhism across Asia.',fact:'Ashoka\'s edicts · Chanakya (Arthashastra) · Kalinga War (261 BCE) · Mauryan administration',steps:[{year:-321,label:'Foundation',la:25.61,ln:85.14,desc:'Chandragupta Maurya, aided by Chanakya, overthrows the Nanda dynasty and establishes the Maurya Empire with its capital at Pataliputra.'},{year:-269,label:'Ashoka\'s Coronation',la:27.47,ln:83.51,desc:'Ashoka the Great ascends the throne and later, after the Kalinga War, embraces Buddhism and spreads its teachings across Asia through rock and pillar edicts.'},{year:-232,label:'Decline Begins',la:25.61,ln:85.14,desc:'After Ashoka\'s death, the empire fragments into smaller kingdoms and is eventually overthrown by the Shunga dynasty around 185 BCE.'}],pts:territory([[37.0,62.0],[36.0,75.0],[34.0,72.0],[30.0,75.0],[28.0,70.0],[24.0,70.0],[20.0,72.0],[16.0,74.0],[12.0,78.0],[12.0,80.0],[14.0,82.0],[18.0,84.0],[22.0,88.0],[24.0,90.0],[27.0,88.0],[28.0,84.0],[32.0,76.0]]),eraHidden:false},
   {n:'Gupta Empire',sub:'320-550 CE',la:25.61,ln:85.14,desc:'Golden Age of India. Founded by Chandragupta I (320 CE). Peak under Samudragupta & Chandragupta II (Vikramaditya). Advances in science, mathematics, art (zero, Aryabhata, Kalidasa).',fact:'Zero & decimal system · Nalanda University peak · Iron Pillar of Delhi · Ajanta caves',steps:[{year:320,label:'Chandragupta I',la:25.61,ln:85.14,desc:'Chandragupta I ascends as the first major Gupta ruler, establishing the empire in the Ganges basin and initiating the classical Gupta era.'},{year:375,label:'Samudragupta',la:25.61,ln:85.14,desc:'Samudragupta expands the empire through military campaigns across northern India, earning the title \'Napoleon of India\' for his conquests.'},{year:415,label:'Golden Age Peak',la:25.61,ln:85.14,desc:'Under Chandragupta II (Vikramaditya), the empire reaches its zenith in art, literature, and science, with luminaries like Kalidasa and Aryabhata.'},{year:550,label:'Decline',la:25.61,ln:85.14,desc:'The Gupta Empire fragments under pressure from Huna invasions and internal revolts, ending the classical age of ancient India.'}],pts:territory([[32.0,72.0],[30.0,76.0],[34.0,78.0],[28.0,82.0],[26.0,90.0],[24.0,88.0],[20.0,84.0],[18.0,80.0],[20.0,74.0],[24.0,72.0],[28.0,70.0]]),eraHidden:false},
   {n:'Chola Empire',sub:'850-1279 CE',la:10.79,ln:79.14,desc:'Greatest maritime empire of South India. Rajaraja Chola I (985-1014) & Rajendra Chola I (1014-1044). Conquered Sri Lanka, Maldives, Srivijaya (Sumatra, Malaysia). Brihadeeswarar Temple masterpiece.',fact:'Largest navy in Indian history · Gangaikonda Cholapuram · Bronze Nataraja · Tamil trade with China',steps:[{year:985,label:'Rajaraja I',la:10.79,ln:79.14,desc:'Rajaraja Chola I ascends the throne and begins a series of conquests across southern India, Sri Lanka, and the Maldives, building a powerful navy.'},{year:1010,label:'Brihadeeswarar Temple',la:10.79,ln:79.14,desc:'Rajaraja completes the Brihadeeswarar Temple in Thanjavur, a masterpiece of Dravidian architecture and a UNESCO World Heritage site.'},{year:1025,label:'Srivijaya Campaign',la:-2.99,ln:104.76,desc:'Rajendra Chola I launches a naval expedition against the Srivijaya Empire in Southeast Asia, establishing Chola dominance over maritime trade routes.'},{year:1279,label:'Decline',la:10.79,ln:79.14,desc:'The Chola Empire gradually declines due to Pandya resurgence and Hoysala pressure, ending one of the longest-ruling dynasties of South India.'}],pts:territory([[8.0,77.0],[10.0,76.0],[12.0,77.0],[14.0,80.0],[16.0,82.0],[14.0,78.0],[12.0,76.0],[10.0,75.0],[8.0,76.0],[6.0,80.0],[3.0,81.0],[8.0,78.0]]),eraHidden:false},
   {n:'Vijayanagara Empire',sub:'1336-1646 CE',la:15.34,ln:76.46,desc:'Last great Hindu kingdom of South India. Founded by Harihara & Bukka Raya (1336). Peak under Krishnadevaraya (1509-1529). Hampi — capital & UNESCO WHS. Patron of art, literature.',fact:'Krishnadevaraya\'s rule · Battle of Talikota (1565) · Hampi ruins · Sangama, Tuluva, Aravidu dynasties',steps:[{year:1336,label:'Foundation',la:15.34,ln:76.46,desc:'Harihara and Bukka Raya establish the Vijayanagara Empire on the banks of the Tungabhadra River, with Hampi as their magnificent capital.'},{year:1509,label:'Krishnadevaraya',la:15.34,ln:76.46,desc:'Krishnadevaraya ascends the throne and leads the empire to its greatest territorial extent, patronizing Telugu literature and temple architecture.'},{year:1565,label:'Battle of Talikota',la:16.43,ln:76.33,desc:'The Deccan Sultanates defeat the Vijayanagara army at Talikota, leading to the sacking and abandonment of Hampi, the glorious capital.'}],pts:territory([[18.0,74.0],[16.0,76.0],[14.0,75.0],[12.0,77.0],[10.0,78.0],[10.0,80.0],[14.0,80.0],[16.0,82.0],[18.0,80.0],[20.0,78.0],[18.0,76.0]]),eraHidden:false},
   {n:'Mughal Empire',sub:'1526-1857 CE',la:27.18,ln:78.02,desc:'Largest & wealthiest empire of its time. Founded by Babur (1526). Peak under Akbar (1556-1605), Jahangir, Shah Jahan (Taj Mahal), Aurangzeb. Centralized administration, Persian-influenced culture.',fact:'Taj Mahal · Red Fort · Din-i-Ilahi (Akbar) · Mansabdari system · Decline after 1707',steps:[{year:1526,label:'Battle of Panipat',la:29.39,ln:76.97,desc:'Babur defeats Ibrahim Lodi at the First Battle of Panipat, founding the Mughal Empire in India with superior tactics and artillery.'},{year:1556,label:'Akbar\'s Reign',la:27.18,ln:78.02,desc:'Akbar ascends at age 13 and expands the empire through conquest and diplomacy, implementing religious tolerance and the Mansabdari administrative system.'},{year:1653,label:'Taj Mahal',la:27.18,ln:78.02,desc:'Shah Jahan completes the Taj Mahal in Agra as a mausoleum for his wife Mumtaz Mahal, a pinnacle of Mughal architecture and a World Wonder.'},{year:1707,label:'Decline Begins',la:27.18,ln:78.02,desc:'After Aurangzeb\'s death, the Mughal Empire fragments under weak successors, facing Maratha, Sikh, and British challenges until its formal end in 1857.'}],pts:territory([[36.0,68.0],[34.0,72.0],[32.0,76.0],[34.0,80.0],[30.0,84.0],[26.0,90.0],[24.0,88.0],[20.0,84.0],[18.0,78.0],[22.0,72.0],[26.0,68.0],[30.0,66.0]]),eraHidden:false},
   {n:'Maratha Empire',sub:'1674-1818 CE',la:18.25,ln:73.44,desc:'Dominant power in 18th-century India. Founded by Shivaji Maharaj (1674). Peak under Peshwa Baji Rao I (1720-1740). Controlled most of India before British rise. Light cavalry & guerrilla tactics.',fact:'Battle of Panipat III (1761) · Ashtapradhan council · Navy under Angre · Treaty of Bassein (1802)',steps:[{year:1674,label:'Coronation of Shivaji',la:18.25,ln:73.44,desc:'Shivaji Maharaj is crowned Chhatrapati at Raigad Fort, establishing the Maratha Empire with the Ashtapradhan council of eight ministers for governance.'},{year:1737,label:'Baji Rao\'s Delhi March',la:18.25,ln:73.44,desc:'Peshwa Baji Rao I leads a lightning campaign to the outskirts of Delhi, demonstrating Maratha power and extracting tribute from the weakening Mughals.'},{year:1761,label:'Third Panipat',la:29.39,ln:76.97,desc:'The Marathas suffer a devastating loss at Panipat against Ahmad Shah Durrani, halting their northern expansion and leading to British ascendancy.'}],pts:territory([[28.0,72.0],[26.0,78.0],[24.0,80.0],[20.0,82.0],[18.0,76.0],[14.0,74.0],[16.0,72.0],[18.0,70.0],[24.0,72.0],[28.0,70.0]]),eraHidden:false},
   {n:'Delhi Sultanate',sub:'1206-1526 CE',la:28.61,ln:77.23,desc:'Five Muslim dynasties ruled from Delhi (Mamluk, Khilji, Tughlaq, Sayyid, Lodi). Introduced Persian culture & Islamic architecture to India. Alauddin Khilji (1296-1316) expanded to Deccan.',fact:'Qutub Minar · Ala-ud-din\'s market reforms · Ibn Battuta visited · Timur\'s invasion (1398)',steps:[{year:1206,label:'Mamluk Dynasty',la:28.61,ln:77.23,desc:'Qutb-ud-din Aibak, a former slave general, establishes the Delhi Sultanate as the first Mamluk ruler, beginning construction of the Qutub Minar.'},{year:1311,label:'Alauddin Khilji',la:28.61,ln:77.23,desc:'Alauddin Khilji expands the Sultanate deep into the Deccan, implementing market price controls and defending India against Mongol invasions.'},{year:1398,label:'Timur\'s Invasion',la:28.61,ln:77.23,desc:'Timur (Tamerlane) sacks Delhi, massacring its population and severely weakening the Sultanate, leading to the decline of the Tughlaq dynasty.'},{year:1526,label:'Fall to Babur',la:28.61,ln:77.23,desc:'Ibrahim Lodi is defeated by Babur at Panipat, ending the Delhi Sultanate and paving the way for the Mughal Empire.'}],pts:territory([[34.0,72.0],[32.0,76.0],[30.0,80.0],[28.0,84.0],[24.0,86.0],[22.0,82.0],[20.0,78.0],[22.0,74.0],[26.0,70.0],[30.0,68.0]]),eraHidden:false},
   {n:'Kushan Empire',sub:'30-375 CE',la:34.01,ln:71.58,desc:'Empire connecting India to Central Asia & China. Kanishka (127-150 CE) greatest ruler. Patron of Gandharan art, Buddhism. Silk Road trade. Capital at Purushapura (Peshawar).',fact:'Kanishka stupa · Gandharan Buddhist art · Fourth Buddhist council · Gold coinage',steps:[{year:30,label:'Foundation',la:34.01,ln:71.58,desc:'The Yuezhi tribes unify under the Kushan clan, establishing an empire that bridges Central Asia and northern India along the Silk Road.'},{year:127,label:'Kanishka\'s Reign',la:34.01,ln:71.58,desc:'Kanishka the Great ascends and expands the empire to its greatest extent, patronizing Gandharan art and convening the Fourth Buddhist Council.'},{year:375,label:'Decline',la:34.01,ln:71.58,desc:'The Kushan Empire fragments under pressure from the Sasanian Empire and Gupta expansion, ending its dominance over the Silk Road trade routes.'}],pts:territory([[40.0,62.0],[38.0,66.0],[36.0,70.0],[34.0,72.0],[32.0,76.0],[28.0,78.0],[26.0,74.0],[28.0,68.0],[32.0,64.0],[36.0,60.0]]),eraHidden:false},
   {n:'Satavahana Empire',sub:'230 BCE-220 CE',la:19.48,ln:75.38,desc:'Deccan kingdom that lasted ~450 years. Known for trade with Roman Empire. Patron of Prakrit & Sanskrit. Built Amaravati stupa. Ruled from Pratishthana (Paithan).',fact:'Nahapana & Gautamiputra Satakarni · Ajanta caves (stupa) · Roman trade routes · Lead coinage',steps:[{year:-230,label:'Foundation',la:19.48,ln:75.38,desc:'The Satavahanas rise in the Deccan after the decline of the Mauryas, establishing their capital at Pratishthana and controlling trade routes to the west.'},{year:78,label:'Gautamiputra Satakarni',la:19.48,ln:75.38,desc:'Gautamiputra Satakarni defeats the Scythian Kshatrapas and restores Satavahana power, becoming the most celebrated ruler of the dynasty.'},{year:220,label:'Decline',la:19.48,ln:75.38,desc:'The Satavahana Empire fragments into smaller successor states as the Abhiras, Ikshvakus, and others assert independence across the Deccan.'}],pts:territory([[22.0,76.0],[20.0,80.0],[18.0,82.0],[16.0,80.0],[14.0,78.0],[14.0,76.0],[16.0,74.0],[18.0,72.0],[20.0,74.0]]),eraHidden:false},
   {n:'Rashtrakuta Empire',sub:'753-982 CE',la:17.19,ln:77.16,desc:'Deccan empire that rivaled the Palas & Pratiharas for Kannauj ("tripartite struggle"). Built Kailasa temple (Ellora). Dantidurga, Govinda III, Amoghavarsha notable rulers.',fact:'Kailasa Temple (Ellora) carved from single rock · Kannada literature · Arab trade records',steps:[{year:753,label:'Foundation',la:17.19,ln:77.16,desc:'Dantidurga establishes the Rashtrakuta Empire by overthrowing the Chalukyas of Badami, with his capital at Manyakheta in present-day Karnataka.'},{year:800,label:'Tripartite Struggle',la:17.19,ln:77.16,desc:'Govinda III leads successful campaigns against the Palas and Pratiharas for control of Kannauj, establishing Rashtrakuta supremacy in northern India.'},{year:815,label:'Kailasa Temple',la:20.02,ln:75.18,desc:'The Rashtrakuta king Krishna I completes the Kailasa Temple at Ellora, an extraordinary rock-cut monolith carved from a single cliff face.'},{year:982,label:'Decline',la:17.19,ln:77.16,desc:'The Rashtrakuta Empire falls to the Western Chalukyas of Kalyani, ending their nearly 230-year dominance of the Deccan plateau.'}],pts:territory([[24.0,74.0],[22.0,78.0],[20.0,80.0],[16.0,80.0],[14.0,78.0],[14.0,74.0],[16.0,72.0],[20.0,72.0]]),eraHidden:false},
   {n:'Pallava Empire',sub:'275-897 CE',la:12.83,ln:79.71,desc:'Tamil kingdom known for Dravidian architecture. Mahabalipuram shore temple & cave temples. Narasimhavarman I (630-668) defeated Chalukyas. Patron of Sanskrit & Tamil.',fact:'Mahabalipuram rock-cut temples · Kanchi was capital · Hiuen Tsang visited · Dravidian style origin',steps:[{year:630,label:'Narasimhavarman I',la:12.83,ln:79.71,desc:'Narasimhavarman I (Mamalla) ascends and defeats the Chalukya king Pulakeshin II, avenging his father\'s defeat and commissioning the Mamallapuram monuments.'},{year:700,label:'Architectural Zenith',la:12.83,ln:79.71,desc:'The Pallavas build the Shore Temple at Mahabalipuram and the Kailasanathar Temple at Kanchipuram, pioneering Dravidian temple architecture.'},{year:897,label:'Chola Conquest',la:12.83,ln:79.71,desc:'The Pallava kingdom is annexed by the expanding Chola Empire under Aditya I, ending nearly six centuries of Pallava rule in Tamil country.'}],pts:territory([[16.0,80.0],[14.0,82.0],[12.0,80.0],[10.0,79.0],[10.0,77.0],[12.0,76.0],[14.0,78.0],[16.0,80.0]]),eraHidden:false},
   {n:'Chalukya Empire',sub:'543-753 CE',la:15.92,ln:75.68,desc:'Badami Chalukyas ruled western Deccan. Pulakeshin II (610-642) defeated Harsha & Pallavas. Built cave temples at Badami, Aihole, Pattadakal (UNESCO). Temple architecture bridge.',fact:'Aihole — cradle of Indian architecture · Pulakeshin II\'s Aihole inscription · Pattadakal UNESCO',steps:[{year:543,label:'Foundation',la:15.92,ln:75.68,desc:'Pulakeshin I establishes the Chalukya dynasty at Badami, with the cave temples of Aihole and Badami becoming early centers of architecture.'},{year:631,label:'Pulakeshin II',la:15.92,ln:75.68,desc:'Pulakeshin II defeats the powerful Harshavardhana on the Narmada and checks Pallava expansion, earning the title \'Dakshinapatha Pati\'.'},{year:753,label:'Rashtrakuta Takeover',la:15.92,ln:75.68,desc:'The Chalukya king Kirtivarman II is overthrown by Dantidurga of the Rashtrakutas, ending the Badami Chalukya line after two centuries of rule.'}],pts:territory([[20.0,74.0],[18.0,78.0],[16.0,78.0],[14.0,74.0],[14.0,72.0],[16.0,70.0],[18.0,72.0]]),eraHidden:false},
   {n:'Bahmani Sultanate',sub:'1347-1527 CE',la:17.33,ln:76.84,desc:'First independent Muslim kingdom of Deccan. Founded by Alauddin Bahman Shah. Later split into 5 Deccan Sultanates (Bijapur, Golconda, Ahmednagar, Berar, Bidar). Persian influence.',fact:'Mahmud Gawan\'s reforms · Bidriware craft · Deccani architecture · Battle of Talikota role',steps:[{year:1347,label:'Foundation',la:17.33,ln:76.84,desc:'Alauddin Bahman Shah revolts against the Delhi Sultanate and establishes the Bahmani Sultanate with Gulbarga as his capital.'},{year:1481,label:'Mahmud Gawan',la:17.33,ln:76.84,desc:'Mahmud Gawan, the Persian prime minister, implements administrative reforms and expands the Sultanate but is executed, leading to fragmentation.'},{year:1527,label:'Dissolution',la:17.33,ln:76.84,desc:'The Bahmani Sultanate splits into five Deccan Sultanates — Bijapur, Golconda, Ahmednagar, Berar, and Bidar — ending the unified kingdom.'}],pts:territory([[22.0,76.0],[20.0,80.0],[18.0,80.0],[16.0,78.0],[16.0,74.0],[18.0,72.0],[20.0,74.0]]),eraHidden:false},
   {n:'Sikh Empire',sub:'1799-1849 CE',la:31.55,ln:74.36,desc:'Founded by Maharaja Ranjit Singh (1799). Secular rule uniting Sikhs, Muslims, Hindus. Controlled Punjab, Kashmir, parts of Afghanistan. Famous for Koh-i-Noor diamond & Khalsa army.',fact:'Ranjit Singh\'s secularism · Koh-i-Noor diamond · Fauj-i-Khas (European-trained) · Treaty of Lahore (1849)',steps:[{year:1799,label:'Ranjit Singh\'s Rise',la:31.55,ln:74.36,desc:'Ranjit Singh captures Lahore and unites the Sikh misls under one rule, founding the Sikh Empire and beginning a secular administration.'},{year:1839,label:'Death of Ranjit Singh',la:31.55,ln:74.36,desc:'Maharaja Ranjit Singh dies, leaving a power vacuum that leads to internal strife and military conflict with the expanding British East India Company.'},{year:1849,label:'Annexation',la:31.55,ln:74.36,desc:'The Sikh Empire is formally annexed by the British after the Second Anglo-Sikh War, with the Treaty of Lahore ending Khalsa sovereignty.'}],pts:territory([[36.0,72.0],[34.0,76.0],[32.0,78.0],[30.0,76.0],[30.0,72.0],[32.0,70.0],[34.0,70.0]]),eraHidden:false},
   {n:'Harsha Empire',sub:'606-647 CE',la:25.44,ln:81.85,desc:'Harshavardhana of Kannauj. Ruled northern India after Gupta decline. Patron of Buddhism & literature. Hiuen Tsang visited his court. Pushyabhuti dynasty. Capital at Kanyakubja (Kannauj).',fact:'Harshacharita by Bana · Hiuen Tsang\'s account · Nalanda patron · Kannauj assembly',steps:[{year:606,label:'Accession',la:25.44,ln:81.85,desc:'Harshavardhana ascends the throne of Thanesar after his brother\'s death and establishes his capital at Kannauj, uniting northern India.'},{year:631,label:'Hiuen Tsang Visit',la:25.44,ln:81.85,desc:'The Chinese Buddhist pilgrim Hiuen Tsang visits Harsha\'s court and provides detailed accounts of the prosperity and administration of the empire.'},{year:647,label:'Death of Harsha',la:25.44,ln:81.85,desc:'Harsha dies without an heir, causing the rapid disintegration of his empire into smaller states and the rise of the Yashovarman dynasty.'}],pts:territory([[32.0,72.0],[28.0,78.0],[26.0,84.0],[24.0,86.0],[22.0,82.0],[22.0,78.0],[28.0,70.0]]),eraHidden:false},
   {n:'Pala Empire',sub:'750-1161 CE',la:23.08,ln:88.80,desc:'Buddhist empire of Bengal & Bihar. Dharmapala & Devapala greatest rulers. Founded Nalanda & Vikramashila universities. Patron of Mahayana Buddhism. "Lord of Gauda".',fact:'Nalanda & Vikramashila · Sahaja Buddhist art · Mahipala I revived · Tripartite struggle for Kannauj',steps:[{year:750,label:'Foundation',la:23.08,ln:88.80,desc:'Gopala I is elected as the first Pala king, establishing a Buddhist empire in Bengal that will revive Nalanda University.'},{year:810,label:'Devapala\'s Peak',la:23.08,ln:88.80,desc:'Devapala expands the Pala Empire to its greatest extent, patronizing Vikramashila University and controlling much of northern and eastern India.'},{year:1161,label:'Decline',la:23.08,ln:88.80,desc:'The Pala Empire fragments under Senas and other rivals, ending the last great Buddhist imperial power of the Indian subcontinent.'}],pts:territory([[28.0,84.0],[26.0,90.0],[24.0,92.0],[22.0,90.0],[20.0,88.0],[22.0,84.0],[24.0,82.0],[26.0,84.0]]),eraHidden:false},
   {n:'Gurjara-Pratihara Empire',sub:'730-1036 CE',la:26.92,ln:75.80,desc:'Northern Indian empire that resisted Arab invasions. Peak under Mihira Bhoja (836-885). Ruled from Kannauj. Fought tripartite struggle with Palas & Rashtrakutas.',fact:'Arab resistance under Nagabhata I · Mihira Bhoja\'s reign · Temple builder · Kannauj control',steps:[{year:738,label:'Arab Defeat',la:26.92,ln:75.80,desc:'Nagabhata I defeats an Arab invasion from Sindh, establishing the Pratiharas as the foremost defenders of northern India against Islamic expansion.'},{year:836,label:'Mihira Bhoja',la:26.92,ln:75.80,desc:'Mihira Bhoja ascends and expands the empire to its zenith, capturing Kannauj and patronizing temple building across northern India.'},{year:1036,label:'Decline',la:26.92,ln:75.80,desc:'The Pratihara Empire collapses under Mahmud of Ghazni\'s raids and internal rebellions, with its territory absorbed by successor kingdoms.'}],pts:territory([[30.0,72.0],[28.0,78.0],[26.0,82.0],[24.0,80.0],[22.0,76.0],[22.0,72.0],[24.0,70.0],[28.0,72.0]]),eraHidden:false},
   {n:'Shunga Empire',sub:'185-73 BCE',la:25.61,ln:85.14,desc:'Post-Mauryan dynasty. Founded by Pushyamitra Shunga (185 BCE). Revived Brahmanical Hinduism. Patron of art (Bharhut stupa). Fought Indo-Greeks & Kalinga. Capital Pataliputra.',fact:'Pushyamitra Shunga · Bharhut stupa sculptures · Patanjali\'s Yoga Sutras · Indo-Greek wars',steps:[{year:-185,label:'Foundation',la:25.61,ln:85.14,desc:'Pushyamitra Shunga overthrows the last Maurya ruler and establishes the Shunga dynasty, restoring Brahmanical rituals and patronage of Hindu temples.'},{year:-150,label:'Bharhut Stupa',la:25.61,ln:85.14,desc:'The Shungas construct the Bharhut stupa with exquisite narrative reliefs, marking an important phase in early Indian Buddhist art.'},{year:-73,label:'Decline',la:25.61,ln:85.14,desc:'The Shunga dynasty ends with the assassination of Devabhuti, leading to the rise of the Kanva dynasty and further political fragmentation.'}],pts:territory([[30.0,74.0],[28.0,80.0],[26.0,84.0],[24.0,82.0],[22.0,78.0],[24.0,74.0],[26.0,72.0],[28.0,72.0]]),eraHidden:false},
   {n:'Hoysala Empire',sub:'1000-1346 CE',la:12.46,ln:76.67,desc:'Kannada kingdom of Belur & Halebidu. Famous for temple architecture (Chennakeshava Temple, Hoysaleswara Temple). Veera Ballala II & Vishnuvardhana. Fought Yadavas, Kakatiyas & Pandya.',fact:'Star-shaped temple platforms · Soapstone carving · Sala killed tiger (Hoysala legend) · Jain & Vaishnava patron',steps:[{year:1116,label:'Vishnuvardhana',la:12.46,ln:76.67,desc:'Vishnuvardhana converts from Jainism to Vaishnavism and commissions the Chennakeshava Temple at Belur, a masterpiece of Hoysala architecture.'},{year:1190,label:'Veera Ballala II',la:12.46,ln:76.67,desc:'Veera Ballala II expands the Hoysala Empire, defeating the Yadavas and Chalukyas, and establishes Halebidu as the majestic capital.'},{year:1346,label:'Vijayanagara Absorption',la:12.46,ln:76.67,desc:'The Hoysala kingdom is absorbed by the Vijayanagara Empire after repeated invasions from the Delhi Sultanate to the north.'}],pts:territory([[16.0,76.0],[14.0,78.0],[12.0,78.0],[10.0,76.0],[10.0,74.0],[12.0,74.0],[14.0,74.0]]),eraHidden:false},
   {n:'Kakatiya Empire',sub:'1163-1323 CE',la:18.20,ln:79.40,desc:'Telugu kingdom that ruled from Warangal. Built thousand-pillar temple, Ramappa temple (UNESCO). Rani Rudramma Devi (one of few female rulers). Defeated by Delhi Sultanate (1323).',fact:'Rudramma Devi queen · Ramappa temple · Thousand Pillar temple · Kakatiya Kala Thoranam (Warangal gate)',steps:[{year:1163,label:'Foundation',la:18.20,ln:79.40,desc:'The Kakatiya dynasty asserts independence from the Chalukyas of Kalyani, establishing Warangal as their fortified capital.'},{year:1262,label:'Rudramma Devi',la:18.20,ln:79.40,desc:'Rani Rudramma Devi becomes one of the few female rulers in Indian history, leading the kingdom successfully against internal and external threats.'},{year:1323,label:'Delhi Conquest',la:18.20,ln:79.40,desc:'The Kakatiya kingdom falls to the Delhi Sultanate under Muhammad bin Tughlaq, ending Telugu sovereignty in the region.'}],pts:territory([[20.0,78.0],[18.0,82.0],[16.0,80.0],[16.0,78.0],[18.0,76.0],[20.0,78.0]]),eraHidden:false},
   {n:'Gajapati Empire',sub:'1434-1541 CE',la:20.30,ln:85.80,desc:'Odishan empire founded by Kapilendra Deva. Peak under Purushottama Deva & Prataparudra Deva. Controlled from Ganga to Kaveri. Patron of Jagannath culture. Rival of Vijayanagara.',fact:'Kapilendra Deva\'s conquests · Purushottama Deva\'s Tirupati donation · Jagannath Temple patron · Mukunda Deva last',steps:[{year:1434,label:'Foundation',la:20.30,ln:85.80,desc:'Kapilendra Deva overthrows the Eastern Ganga dynasty and establishes the Gajapati Empire, expanding Odishan rule from Bengal to the Kaveri.'},{year:1467,label:'Purushottama Deva',la:20.30,ln:85.80,desc:'Purushottama Deva expands the empire and donates to the Tirupati temple, strengthening ties with South Indian kingdoms.'},{year:1541,label:'Decline',la:20.30,ln:85.80,desc:'After the death of Prataparudra Deva, the Gajapati Empire fragments due to internal succession disputes and pressure from Vijayanagara.'}],pts:territory([[22.0,84.0],[20.0,88.0],[18.0,86.0],[16.0,84.0],[16.0,82.0],[18.0,80.0],[20.0,82.0]]),eraHidden:false},
   {n:'Chera Empire',sub:'300 BCE-1200 CE',la:10.70,ln:76.07,desc:'Ancient Tamil dynasty of Kerala. Famous for spice trade with Romans, Phoenicians. Capital at Vanchi/Muziris. Patron of Tamil literature (Sangam). Legendary Cheran Chenguttuvan.',fact:'Muziris port (Roman trade) · Spice Route · Jewish & Christian settlements (ancient) · Chera-Senguttuvan\'s expeditions',steps:[{year:-150,label:'Sangam Age',la:10.70,ln:76.07,desc:'The Chera kingdom flourishes during the Sangam period, with Muziris emerging as a major spice port trading with the Roman Empire.'},{year:120,label:'Chenguttuvan\'s Reign',la:10.70,ln:76.07,desc:'Cheran Chenguttuvan expands Chera influence and builds a temple to Kannagi, becoming a legendary figure celebrated in Tamil epic literature.'},{year:1200,label:'Decline',la:10.70,ln:76.07,desc:'The Chera kingdom fragments into smaller principalities, with the Kulasekhara dynasty ruling parts of Kerala from Mahodayapuram.'}],pts:territory([[12.0,76.0],[10.0,78.0],[8.0,76.0],[8.0,74.0],[10.0,74.0]]),eraHidden:false},
   {n:'Pandya Empire',sub:'300 BCE-1345 CE',la:8.95,ln:78.12,desc:'Ancient Tamil kingdom of Madurai. Famous for Meenakshi Temple. Sangam age patrons. Kathakali & Carnatic music. Fought Cholas, Chera. Revived under Jatavarman Sundara Pandya.',fact:'Meenakshi Amman Temple · Sangam poetry · Korkai pearl trade · Marco Polo visited "greatest empire"',steps:[{year:-200,label:'Sangam Era',la:8.95,ln:78.12,desc:'The Pandyas are one of the three ancient Tamil kingdoms, patronizing the Tamil Sangam literature and controlling the pearl fisheries of Korkai.'},{year:1251,label:'Sundara Pandya',la:8.95,ln:78.12,desc:'Jatavarman Sundara Pandya revives Pandya power, defeating the Cholas and expanding into the Telugu country and Sri Lanka.'},{year:1345,label:'Delhi Invasion',la:8.95,ln:78.12,desc:'The Pandya kingdom collapses under invasion from the Delhi Sultanate led by Malik Kafur, and Madurai is brought under sultanate control.'}],pts:territory([[10.0,78.0],[8.0,80.0],[6.0,78.0],[8.0,76.0],[10.0,78.0]]),eraHidden:false},
   {n:'Ahom Kingdom',sub:'1228-1826 CE',la:26.63,ln:92.77,desc:'Tai-Ahom kingdom of Assam. Founded by Sukapha (1228). Resisted Mughal invasions 17 times. Peak under Rudra Singha (1696-1714). Annexed by British after Treaty of Yandabo (1826).',fact:'Never conquered by Mughals · Paik system · Buranjis (chronicles) · Lachit Borphukan\'s Saraighat victory',steps:[{year:1228,label:'Sukapha\'s Arrival',la:26.63,ln:92.77,desc:'Sukapha, a Tai prince from Mong Mao, crosses the Patkai hills and establishes the Ahom kingdom in the Brahmaputra valley of Assam.'},{year:1671,label:'Battle of Saraighat',la:26.63,ln:92.77,desc:'Lachit Borphukan leads the Ahom army to a decisive victory over the Mughals at Saraighat, the greatest naval battle in India\'s history.'},{year:1826,label:'Treaty of Yandabo',la:26.63,ln:92.77,desc:'The Ahom kingdom is annexed by the British East India Company after the Treaty of Yandabo, ending nearly 600 years of Ahom rule.'}],pts:territory([[28.0,92.0],[26.0,96.0],[24.0,94.0],[24.0,90.0],[26.0,90.0],[28.0,92.0]]),eraHidden:false},
   {n:'Kadamba Kingdom',sub:'345-525 CE',la:15.55,ln:74.52,desc:'First Kannada kingdom of Banavasi. Founded by Mayurasharma (Brahmin turned warrior). Patron of Jainism & Sanskrit. Built Madhukeshwara Temple. Forerunner of Kannada culture.',fact:'Mayurasharma founded after insult at Pallava court · Earliest Kannada inscription (Halmidi) · Banavasi capital',steps:[{year:345,label:'Mayurasharma',la:15.55,ln:74.52,desc:'Mayurasharma, a Brahmin student humiliated at the Pallava court, takes up arms and founds the Kadamba kingdom in the forests of Banavasi.'},{year:450,label:'Kannada Inscription',la:15.55,ln:74.52,desc:'The Halmidi inscription, the earliest known Kannada language inscription, is created during the Kadamba period, marking a linguistic milestone.'},{year:525,label:'Pallava Conquest',la:15.55,ln:74.52,desc:'The Kadamba kingdom is subdued by the Chalukyas of Badami, though the dynasty continues as feudatories for several centuries.'}],pts:territory([[16.0,74.0],[14.0,76.0],[12.0,74.0],[14.0,72.0],[16.0,74.0]]),eraHidden:false},
   {n:'Kalinga Kingdom',sub:'1100 BCE-261 BCE',la:20.30,ln:85.80,desc:'Powerful eastern kingdom of ancient India. Famous for resisting Mauryan conquest (Kalinga War 261 BCE). Maritime trade with SE Asia. Kalinga architecture & iron-working.',fact:'Kalinga War changed Ashoka · Maritime traders to SE Asia · Hatigumpha inscription (Kharavela) · Kalinga architecture',steps:[{year:-400,label:'Maritime Power',la:20.30,ln:85.80,desc:'Kalinga emerges as a powerful maritime kingdom with extensive trade networks connecting Southeast Asia, known for its iron-working and naval capabilities.'},{year:-261,label:'Kalinga War',la:20.30,ln:85.80,desc:'Ashoka Maurya conquers Kalinga in a bloody war that causes immense casualties, leading him to embrace Buddhism and renounce violence.'},{year:-150,label:'Kharavela\'s Reign',la:20.30,ln:85.80,desc:'King Kharavela restores Kalinga power, as recorded in the Hatigumpha inscription, expanding the kingdom and patronizing Jain culture.'}],pts:territory([[22.0,84.0],[20.0,88.0],[18.0,86.0],[18.0,82.0],[20.0,82.0]]),eraHidden:false},
   {n:'Maitraka Kingdom',sub:'475-776 CE',la:22.30,ln:73.20,desc:'Kingdom of Valabhi (Gujarat). Founded by Bhatarka. Known for Valabhi University (Buddhist center). Peaceful, prosperous. Hiuen Tsang visited. Fell to Arabs from Sindh.',fact:'Valabhi University · Maitraka coinage · Hiuen Tsang visited · First copper plate grants in Gujarat',steps:[{year:475,label:'Foundation',la:22.30,ln:73.20,desc:'Bhatarka establishes the Maitraka dynasty at Valabhi in Gujarat, ruling as a feudatory of the Guptas before asserting independence.'},{year:640,label:'Hiuen Tsang Visit',la:22.30,ln:73.20,desc:'The Chinese pilgrim Hiuen Tsang visits Valabhi and describes its flourishing Buddhist university and prosperous society.'},{year:776,label:'Arab Conquest',la:22.30,ln:73.20,desc:'The Maitraka kingdom falls to Arab invaders from Sindh, ending the peaceful and prosperous Valabhi period.'}],pts:territory([[24.0,72.0],[22.0,74.0],[20.0,72.0],[22.0,70.0],[24.0,72.0]]),eraHidden:false},
   {n:'Vakataka Kingdom',sub:'250-510 CE',la:19.00,ln:78.00,desc:'Deccan kingdom contemporary with Guptas. Famous for Ajanta cave paintings (second phase). Harishena (475-500 CE) patron of Ajanta. Marital alliance with Gupta empire.',fact:'Ajanta caves\' Vakataka phase · Varahadeva\'s inscription · Pravarsena I\'s Asvamedha · Gupta alliance',steps:[{year:250,label:'Foundation',la:19.00,ln:78.00,desc:'Vindhyashakti establishes the Vakataka kingdom in the Deccan, which becomes a contemporary and ally of the Gupta Empire.'},{year:475,label:'Ajanta Paintings',la:20.02,ln:75.18,desc:'Under Harishena, the Vakataka prime minister Varahadeva patronizes the Ajanta cave paintings, creating masterpieces of Buddhist art.'},{year:510,label:'Decline',la:19.00,ln:78.00,desc:'The Vakataka kingdom is absorbed by the expanding Kalachuri and Vishnukundina powers, ending its cultural patronage in the Deccan.'}],pts:territory([[22.0,76.0],[20.0,80.0],[18.0,78.0],[18.0,74.0],[20.0,74.0],[22.0,76.0]]),eraHidden:false},
   {n:'Sharqi Sultanate',sub:'1394-1479 CE',la:25.75,ln:82.69,desc:'Muslim kingdom of Jaunpur (UP). Founded by Khwaja Jahan (Malik Sarwar). Rival of Delhi Sultanate. Known for Sharqi architecture (Atala Masjid, Jama Masjid). Annexed by Sikandar Lodi.',fact:'Sharqi architectural style (Jaunpur) · Atala Masjid · Malik Sarwar founder · Cultural capital of Eastern India',steps:[{year:1394,label:'Foundation',la:25.75,ln:82.69,desc:'Malik Sarwar, a eunuch official of the Delhi Sultanate, declares independence at Jaunpur and founds the Sharqi Sultanate.'},{year:1408,label:'Sharqi Architecture',la:25.75,ln:82.69,desc:'The Sharqi sultans build the Atala Masjid and Jami Masjid in Jaunpur, developing a distinctive architectural style blending Hindu and Islamic elements.'},{year:1479,label:'Lodi Annexation',la:25.75,ln:82.69,desc:'Sikandar Lodi of the Delhi Sultanate conquers Jaunpur and annexes the Sharqi Sultanate, ending its independent rule.'}],pts:territory([[28.0,80.0],[26.0,84.0],[24.0,82.0],[24.0,78.0],[26.0,78.0],[28.0,80.0]]),eraHidden:false},
   {n:'Yadava Empire',sub:'850-1334 CE',la:20.09,ln:75.18,desc:'Marathi kingdom of Devagiri (Daulatabad). Seuna dynasty. Peak under Singhana II (1200-1247). Patron of Marathi language. Fought Hoysalas & Kakatiyas. Annexed by Alauddin Khalji (1294).',fact:'First Marathi inscriptions · Devagiri fort (impregnable) · Sant Dnyaneshwar (Jnaneshwari) · Khalji\'s raid 1294',steps:[{year:1187,label:'Bhillama V',la:20.09,ln:75.18,desc:'Bhillama V establishes the Yadava (Seuna) dynasty at Devagiri, which becomes a powerful fortress and the Marathi cultural center.'},{year:1247,label:'Simhana\'s Peak',la:20.09,ln:75.18,desc:'Simhana II expands the Yadava Empire to its greatest extent and patronizes Marathi literature, including the composition of the Jnaneshwari.'},{year:1334,label:'Tughlaq Conquest',la:20.09,ln:75.18,desc:'The Yadava kingdom falls to the Tughlaq dynasty after repeated invasions by Alauddin Khalji and Muhammad bin Tughlaq.'}],pts:territory([[22.0,74.0],[20.0,78.0],[18.0,76.0],[18.0,72.0],[20.0,72.0],[22.0,74.0]]),eraHidden:false},
   {n:'Kingdom of Mewar',sub:'734-1949 CE',la:24.58,ln:73.68,desc:'Legendary Rajput kingdom of Udaipur & Chittor. Founded by Bappa Rawal (734). Famous for resistance against Delhi Sultanate & Mughals. Maharana Pratap, Rana Sanga. Never fully submitted.',fact:'Maharana Pratap (Haldighati) · 3 jauhar in Chittor · Padmini legend · Sisodia clan · Lake Palace Udaipur',steps:[{year:734,label:'Bappa Rawal',la:24.58,ln:73.68,desc:'Bappa Rawal captures Chittor from the Mori Rajputs and establishes the Guhila dynasty, founding the Kingdom of Mewar.'},{year:1576,label:'Battle of Haldighati',la:24.58,ln:73.68,desc:'Maharana Pratap fights the Mughal army under Man Singh at Haldighati, becoming a symbol of Rajput resistance despite eventual retreat.'},{year:1949,label:'Integration',la:24.58,ln:73.68,desc:'Mewar signs the Instrument of Accession and joins the Union of India, ending over a millennium of Sisodia rule.'}],pts:territory([[26.0,72.0],[24.0,76.0],[22.0,74.0],[22.0,70.0],[24.0,70.0]]),eraHidden:false},
   {n:'Kingdom of Marwar',sub:'1226-1949 CE',la:26.30,ln:73.02,desc:'Rajput kingdom of Jodhpur. Rathore clan. Founded by Rao Jodha (1459). Built Mehrangarh Fort. Rao Maldeo (1532-1562) resisted Mughals. Later allied with British. Largest Rajput state.',fact:'Mehrangarh Fort · Rao Jodha founder · Jaswant Singh II modernizer · Marwar Festival · Blue city (Jodhpur)',steps:[{year:1459,label:'Rao Jodha',la:26.30,ln:73.02,desc:'Rao Jodha establishes his capital at Jodhpur, founding the Rathore kingdom and beginning construction of the imposing Mehrangarh Fort.'},{year:1540,label:'Rao Maldeo',la:26.30,ln:73.02,desc:'Rao Maldeo expands Marwar to its greatest extent, commanding a powerful army that resists Mughal expansion attempts.'},{year:1949,label:'Union with India',la:26.30,ln:73.02,desc:'Marwar accedes to the Union of India, becoming part of the state of Rajasthan under the leadership of Hanwant Singh.'}],pts:territory([[28.0,72.0],[26.0,76.0],[24.0,74.0],[24.0,70.0],[26.0,70.0],[28.0,72.0]]),eraHidden:false},
   {n:'Chandela Kingdom',sub:'831-1208 CE',la:24.85,ln:79.93,desc:'Central Indian Rajput dynasty of Khajuraho. Famous for Khajuraho temples (UNESCO). Built 85+ temples. Dhanga (950-999) & Vidyadhara (1017-1035) greatest rulers. Resisted Mahmud of Ghazni.',fact:'Khajuraho temples (UNESCO) · 85 temples (20 survive) · Dhanga\'s Kalinjar fort · Vidyadhara repelled Ghazni · Paramara-Chandela rivalry',steps:[{year:954,label:'Dhanga\'s Reign',la:24.85,ln:79.93,desc:'Dhanga ascends the throne and begins the construction of the magnificent Khajuraho temples, transforming the kingdom into a cultural center.'},{year:1022,label:'Ghaznavid Resistance',la:24.85,ln:79.93,desc:'Vidyadhara repels Mahmud of Ghazni\'s invasion, one of the few Indian kings to successfully resist the Ghaznavid army.'},{year:1208,label:'Delhi Conquest',la:24.85,ln:79.93,desc:'The Chandela kingdom is conquered by Qutb-ud-din Aibak of the Delhi Sultanate, ending the dynasty that built the Khajuraho temples.'}],pts:territory([[26.0,78.0],[24.0,82.0],[22.0,80.0],[22.0,76.0],[24.0,76.0],[26.0,78.0]]),eraHidden:false},
   {n:'Paramara Kingdom',sub:'800-1305 CE',la:23.50,ln:75.50,desc:'Rajput kingdom of Malwa (Dhar, Mandu). Raja Bhoja (1010-1055) — polymath king, writer, astronomer, builder. Built Bhojeshwar Temple & Bhojpur lake. Patron of Sanskrit learning.',fact:'Bhoja (1010-1055) · Bhojeshwar Temple (largest Shiva lingam) · Mandu city · Bhoja\'s writings (Sringara Prakasha, Samarangana Sutradhara) · Defeated Mahmud of Ghazni\'s son',steps:[{year:1010,label:'Raja Bhoja',la:23.50,ln:75.50,desc:'Raja Bhoja ascends the Paramara throne and becomes a celebrated polymath, writing works on architecture, astronomy, and poetry.'},{year:1040,label:'Bhojeshwar Temple',la:23.50,ln:75.50,desc:'Bhoja commissions the Bhojeshwar Temple with the largest Shiva lingam in India and constructs the Bhojpur lake, demonstrating his engineering prowess.'},{year:1305,label:'Alauddin\'s Conquest',la:23.50,ln:75.50,desc:'The Paramara kingdom is conquered by Alauddin Khalji of the Delhi Sultanate, bringing an end to the independent rule of Malwa.'}],pts:territory([[26.0,74.0],[24.0,78.0],[22.0,76.0],[22.0,72.0],[24.0,72.0],[26.0,74.0]]),eraHidden:false},
   {n:'Solanki (Chaulukya) Kingdom',sub:'940-1244 CE',la:23.02,ln:72.57,desc:'Kingdom of Gujarat. Built Modhera Sun Temple, Rani ki Vav (UNESCO). Kumarapala greatest ruler. Patron of Jainism (Hemachandra). Resisted Ghaznavid invasions. Capital at Patan (Anhilwada).',fact:'Rani ki Vav stepwell (UNESCO) · Modhera Sun Temple · Hemachandra the Jain scholar · Kumarapala\'s conversion · Alauddin Khalji ended Solanki rule',steps:[{year:1027,label:'Modhera Sun Temple',la:23.02,ln:72.57,desc:'King Bhima I builds the Sun Temple at Modhera, an architectural marvel dedicated to Surya with a stunning stepwell and intricately carved pillars.'},{year:1145,label:'Kumarapala',la:23.02,ln:72.57,desc:'Kumarapala converts to Jainism under the influence of Acharya Hemachandra and becomes a great patron of Jain art and literature.'},{year:1244,label:'Decline',la:23.02,ln:72.57,desc:'The Solanki kingdom declines after the death of Kumarapala, and Gujarat is eventually conquered by Alauddin Khalji\'s forces.'}],pts:territory([[26.0,70.0],[24.0,74.0],[22.0,72.0],[20.0,70.0],[22.0,68.0],[24.0,68.0],[26.0,70.0]]),eraHidden:false},
   {n:'Gahadavala Kingdom',sub:'1089-1197 CE',la:25.44,ln:81.85,desc:'Kingdom of Kannauj. Ruled by Jaichand (the "traitor" of legend). Defeated by Muhammad Ghori at Chandravar (1194). Last major Hindu kingdom of North India before Ghori\'s conquests.',fact:'Jaichand (legend says he didn\'t help Prithviraj) · Kannauj capital · Chandravar battle (1194) · Jayachandra inscribed on stone · Ganges-Yamuna doab rulers',steps:[{year:1089,label:'Foundation',la:25.44,ln:81.85,desc:'Chandradeva establishes the Gahadavala dynasty in Kannauj, ruling over the fertile Ganges-Yamuna doab region.'},{year:1194,label:'Battle of Chandawar',la:25.44,ln:81.85,desc:'Jaichand is defeated and killed by Muhammad Ghori at Chandawar, leading to the fall of Kannauj and the end of the Gahadavala kingdom.'}],pts:territory([[28.0,78.0],[26.0,82.0],[24.0,80.0],[24.0,76.0],[26.0,76.0],[28.0,78.0]]),eraHidden:false},
   {n:'Kalachuri Kingdom',sub:'550-1210 CE',la:22.70,ln:75.90,desc:'Central Indian kingdom of Chedi (Tripuri, near Jabalpur). Patron of art (Karan Temple, Bheraghat). Gangeyadeva & Lakshmikarna expanded. Also a branch in Kalyan (Kalyani Chalukya vassals).',fact:'Tripuri (Tewar) capital · Karan Temple & Bheraghat marble rocks · Gangeyadeva "Vikramaditya" · Kalachuri era calendar · Alha-Udal legends',steps:[{year:550,label:'Foundation',la:22.70,ln:75.90,desc:'The Kalachuris establish their kingdom at Tripuri near Jabalpur, marking the beginning of the Kalachuri era that uses a distinct calendar system.'},{year:1015,label:'Gangeyadeva',la:22.70,ln:75.90,desc:'Gangeyadeva expands the Kalachuri kingdom and assumes the title \'Vikramaditya\', becoming the most powerful ruler in central India.'},{year:1210,label:'Decline',la:22.70,ln:75.90,desc:'The Kalachuri kingdom of Tripuri declines under pressure from the Chandellas and the Delhi Sultanate, ending its independent rule.'}],pts:territory([[24.0,78.0],[22.0,82.0],[20.0,80.0],[20.0,76.0],[22.0,74.0],[24.0,76.0]]),eraHidden:false},
   {n:'Lohara Dynasty',sub:'1003-1320 CE',la:34.15,ln:74.80,desc:'Kashmir kingdom. Founded by Samgramaraja. Peak under Kalhana\'s patron Jayasimha (1128-1155). Kalhana wrote Rajatarangini (Kashmir history). Destroyed by Shah Mir (first Muslim ruler of Kashmir).',fact:'Rajatarangini by Kalhana (1148) · First Indian history text · Jayasimha\'s patronage · Shah Mir dynasty followed · Kashmiri Shaivism patron',steps:[{year:1003,label:'Foundation',la:34.15,ln:74.80,desc:'Samgramaraja establishes the Lohara dynasty in Kashmir, ruling from the fortified town of Lohara.'},{year:1148,label:'Rajatarangini',la:34.15,ln:74.80,desc:'Kalhana completes the Rajatarangini, a historical chronicle of Kashmir that is considered the first historical text in Indian literature.'},{year:1320,label:'Shah Mir Takeover',la:34.15,ln:74.80,desc:'The Lohara dynasty ends with the rise of Shah Mir, who establishes the first Muslim sultanate in Kashmir.'}],pts:territory([[36.0,74.0],[34.0,76.0],[32.0,74.0],[34.0,72.0],[36.0,74.0]]),eraHidden:false},
   {n:'Shahi Kingdom',sub:'850-1026 CE',la:34.01,ln:71.58,desc:'Hindu-Buddhist kingdom of Kabul Valley & Punjab (Udabhandapura). Jayapala (964-1001) resisted Mahmud of Ghazni. Fought multiple invasions. Collapsed from Ghaznavid attacks.',fact:'Jayapala\'s heroic suicide in battle · Anatandapala last ruler · Stubborn resistance to Ghaznavids · Kabul Shahis before, Hindu Shahis after · 6 Ghaznavid invasions repelled',steps:[{year:850,label:'Hindu Shahi',la:34.01,ln:71.58,desc:'The Hindu Shahi dynasty establishes its rule in the Kabul Valley with its capital at Udabhandapura, succeeding the earlier Buddhist Kabul Shahis.'},{year:1001,label:'Battle of Peshawar',la:34.01,ln:71.58,desc:'Jayapala suffers a major defeat against Mahmud of Ghazni and later immolates himself in a heroic act of defiance rather than accepting subjugation.'},{year:1026,label:'Collapse',la:34.01,ln:71.58,desc:'The remaining Shahi territories are annexed by Mahmud of Ghazni, ending Hindu-Buddhist rule in the Kabul-Punjab region.'}],pts:territory([[36.0,68.0],[34.0,72.0],[32.0,74.0],[30.0,72.0],[30.0,68.0],[32.0,64.0],[34.0,66.0]]),eraHidden:false},
   {n:'Deccan Sultanates',sub:'1490-1687 CE',la:17.33,ln:76.84,desc:'Five sultanates (Bijapur, Golconda, Ahmednagar, Berar, Bidar) formed after Bahmani split. Allied to defeat Vijayanagara (Talikota 1565). Fought each other. Annexed by Mughals gradually.',fact:'Talikota coalition (1565) · Golconda\'s diamonds · Bijapur\'s Gol Gumbaz · Ahmednagar\'s Malik Ambar · Chand Bibi defender of Ahmednagar',steps:[{year:1490,label:'Formation',la:17.33,ln:76.84,desc:'The Bahmani Sultanate fragments into five Deccan Sultanates of Bijapur, Golconda, Ahmednagar, Berar, and Bidar.'},{year:1565,label:'Battle of Talikota',la:17.33,ln:76.84,desc:'The five sultanates form a coalition and decisively defeat the Vijayanagara Empire at Talikota, changing the political landscape of South India.'},{year:1687,label:'Mughal Annexation',la:17.33,ln:76.84,desc:'Aurangzeb annexes the last Deccan Sultanates — Bijapur in 1686 and Golconda in 1687 — ending their independent rule.'}],pts:territory([[22.0,74.0],[20.0,80.0],[18.0,82.0],[16.0,80.0],[16.0,76.0],[18.0,72.0],[20.0,72.0]]),eraHidden:false},
   {n:'Kingdom of Awadh',sub:'1722-1856 CE',la:26.85,ln:80.95,desc:'Mughal successor state in UP. Founded by Saadat Ali Khan. Peak under Asaf-ud-Daula (built Lucknow). Known for Nawabi culture, fine arts. Annexed by British under Doctrine of Lapse (1856).',fact:'Nawab of Awadh · Lucknow\'s Imambara & Rumi Darwaza · Wajid Ali Shah last Nawab · Annexation by Dalhousie 1856 · Gharana music & Kathak dance',steps:[{year:1722,label:'Foundation',la:26.85,ln:80.95,desc:'Saadat Ali Khan is appointed Nawab of Awadh by the Mughal emperor, establishing a semi-independent kingdom in the fertile Gangetic plains.'},{year:1780,label:'Lucknow\'s Golden Age',la:26.85,ln:80.95,desc:'Asaf-ud-Daula moves the capital to Lucknow and builds the Bara Imambara, Rumi Darwaza, and other architectural marvels.'},{year:1856,label:'British Annexation',la:26.85,ln:80.95,desc:'The British East India Company annexes Awadh under the Doctrine of Lapse, accusing Nawab Wajid Ali Shah of misgovernment.'}],pts:territory([[28.0,78.0],[26.0,84.0],[24.0,82.0],[24.0,78.0],[26.0,76.0],[28.0,78.0]]),eraHidden:false},
   {n:'Mysore Kingdom',sub:'1399-1947 CE',la:12.30,ln:76.63,desc:'Kannada kingdom of Wodeyar dynasty. Peak under Hyder Ali & Tipu Sultan (1760-1799). Resisted British in 4 Anglo-Mysore Wars. Tipu died in 1799. Restored to Wodeyars under British suzerainty.',fact:'Tipu Sultan "Tiger of Mysore" · Rocket warfare · Hyder Ali\'s rise · Mysore silk & sandalwood · Dasara festival tradition',steps:[{year:1399,label:'Wodeyar Dynasty',la:12.30,ln:76.63,desc:'The Wodeyar dynasty establishes the Kingdom of Mysore with its capital at Mysore, beginning over five centuries of rule.'},{year:1799,label:'Tipu\'s Fall',la:12.30,ln:76.63,desc:'Tipu Sultan is killed defending his capital Srirangapatna in the Fourth Anglo-Mysore War, ending his reformed rocket artillery experiments.'},{year:1947,label:'Union with India',la:12.30,ln:76.63,desc:'Mysore accedes to the Union of India under Maharaja Jayachamarajendra Wodeyar, becoming one of the largest princely states.'}],pts:territory([[14.0,74.0],[12.0,78.0],[10.0,76.0],[10.0,74.0],[12.0,72.0],[14.0,74.0]]),eraHidden:false},
   {n:'Travancore Kingdom',sub:'1729-1949 CE',la:8.49,ln:76.95,desc:'Kingdom of southern Kerala. Marthanda Varma (1729-1758) expanded. Known for Temple Entry Proclamation (1936) by Chithira Thirunal. First Indian state to achieve 100% literacy. Padmanabhaswamy Temple.',fact:'Marthanda Varma "maker of Travancore" · Temple Entry Proclamation 1936 · First 100% literate region · Sree Padmanabhaswamy treasure (richest temple) · Velu Thampi Dalawa revolt',steps:[{year:1729,label:'Marthanda Varma',la:8.49,ln:76.95,desc:'Marthanda Varma ascends the throne and expands Travancore by defeating the Dutch at the Battle of Colachel in 1741, ending Dutch colonial ambitions in India.'},{year:1936,label:'Temple Entry',la:8.49,ln:76.95,desc:'Maharaja Chithira Thirunal issues the Temple Entry Proclamation, opening Hindu temples to all castes, a landmark social reform in Kerala.'},{year:1949,label:'Integration',la:8.49,ln:76.95,desc:'Travancore merges with Cochin to form Travancore-Cochin state, later becoming part of Kerala state in the Indian Union.'}],pts:territory([[10.0,76.0],[8.0,78.0],[6.0,76.0],[8.0,74.0],[10.0,76.0]]),eraHidden:false},
    {n:'Jain Kingdom of Ganga',sub:'350-1000 CE',la:12.30,ln:76.63,desc:'Western Ganga dynasty of southern Karnataka. Patrons of Jainism (Shravanabelagola). Famous for Gommateshwara (Bahubali) monolith — 17m tall. Ruled from Talakad. Feudatory of larger empires.',fact:'Gommateshwara statue (981 CE · 17m) by Chavundaraya · Shravanabelagola Jain pilgrimage · 1000+ Jain monuments · Talakad capital · Davangere inscriptions',steps:[{year:350,label:'Foundation',la:12.30,ln:76.63,desc:'The Western Ganga dynasty establishes its rule from Talakad in southern Karnataka, with Jainism as the state religion.'},{year:981,label:'Gommateshwara Statue',la:12.30,ln:76.63,desc:'Chavundaraya commissions the 17-meter Gommateshwara monolith at Shravanabelagola, the tallest Jain statue and a masterpiece of sculpture.'},{year:1000,label:'Chola Absorption',la:12.30,ln:76.63,desc:'The Western Ganga kingdom is absorbed by the expanding Chola Empire, though the region remains a center of Jain culture.'}],pts:territory([[14.0,74.0],[12.0,78.0],[10.0,76.0],[10.0,74.0],[12.0,72.0],[14.0,74.0]]),eraHidden:false},
    {n:'Hyderabad State',sub:'1724-1948 CE',la:17.38,ln:78.47,desc:'Princely state of Nizam. Founded by Asaf Jah I (1724). Richest prince in India. Known for Nizam\'s wealth, Golconda diamonds. Survived British Paramountcy. Annexed by India in Operation Polo 1948.',fact:'Nizam-ul-Mulk · Asaf Jahi dynasty · Osmania University · Salar Jung Museum · Charminar · Operation Polo 1948',steps:[{year:1724,label:'Foundation',la:17.38,ln:78.47,desc:'Asaf Jah I declares independence from the weakening Mughal Empire and establishes the Asaf Jahi dynasty with Hyderabad as his capital.'},{year:1798,label:'British Subsidiary Alliance',la:17.38,ln:78.47,desc:'The Nizam signs a subsidiary alliance with the British, becoming the largest princely state under British paramountcy.'},{year:1948,label:'Operation Polo',la:17.38,ln:78.47,desc:'India annexes Hyderabad through Operation Polo after the Nizam refuses to join the Indian Union, ending 224 years of Asaf Jahi rule.'}],pts:territory([[22.0,76.0],[20.0,80.0],[18.0,82.0],[16.0,80.0],[16.0,76.0],[18.0,72.0],[20.0,72.0]]),eraHidden:false},
    {n:'Kingdom of Manipur',sub:'1110-1949 CE',la:24.80,ln:93.92,desc:'Meitei kingdom in NE India. Kangleipak era. Peak under King Garib Niwaz (1709-1748). Introduced Hinduism. Anglo-Manipur War 1891. Last king Bodhchandra signed merger in 1949.',fact:'Meitei culture · Ras Lila dance · Ima Keithel (women\'s market) · Anglo-Manipur War 1891 · Merger 1949',steps:[{year:1110,label:'Foundation',la:24.80,ln:93.92,desc:'The Meitei kingdom of Kangleipak is established in the Manipur valley, with its own script and distinct Meitei culture.'},{year:1891,label:'Anglo-Manipur War',la:24.80,ln:93.92,desc:'British forces defeat the Manipuri army in the Anglo-Manipur War, executing some chiefs and reducing the kingdom to a princely state.'},{year:1949,label:'Merger with India',la:24.80,ln:93.92,desc:'Maharaja Bodhchandra Singh signs the Instrument of Accession, merging Manipur into the Indian Union under controversial circumstances.'}],pts:territory([[26.0,92.0],[24.0,94.0],[22.0,92.0],[24.0,90.0]]),eraHidden:false},
    {n:'Tripura Kingdom',sub:'1430-1949 CE',la:23.84,ln:91.42,desc:'Manikya dynasty ruled Tripura for over 500 years. Peak under Maharaja Bir Chandra Manikya (1862-1896). Known for temple architecture at Udaipur (Matabari). Merged with India 1949.',fact:'Manikya dynasty · Mata Tripura Sundari temple · Neermahal palace · Udaipur capital · Merger 1949',steps:[{year:1430,label:'Foundation',la:23.84,ln:91.42,desc:'The Manikya dynasty is established in Tripura, ruling from the historic capital at Udaipur (present-day Gomati district).'},{year:1862,label:'Bir Chandra\'s Reforms',la:23.84,ln:91.42,desc:'Maharaja Bir Chandra Manikya modernizes the kingdom, introducing administrative reforms, building roads and palaces.'},{year:1949,label:'Union with India',la:23.84,ln:91.42,desc:'Tripura accedes to the Indian Union, ending the Manikya dynasty\'s rule over the kingdom.'}],pts:territory([[24.0,90.0],[22.0,92.0],[22.0,90.0],[23.0,89.0]]),eraHidden:false},
    {n:'Koch Kingdom',sub:'1515-1949 CE',la:26.32,ln:89.58,desc:'Koch dynasty of medieval Assam/Bengal. Founded by Biswa Singha. Peak under Nara Narayan (1553-1587). Patron of Assamese literature. Later split into Koch Bihar and Koch Hajo.',fact:'Biswa Singha · Nara Narayan · Sankardeva patron · Koch Bihar state · Cooch Behar palace',steps:[{year:1515,label:'Foundation',la:26.32,ln:89.58,desc:'Biswa Singha establishes the Koch kingdom in the Kamrup region, unifying the Koch tribes under a single rule.'},{year:1553,label:'Nara Narayan',la:26.32,ln:89.58,desc:'Nara Narayan expands the kingdom to its greatest extent and patronizes Assamese culture and Vaishnavism under Sankardeva.'},{year:1949,label:'Merger',la:26.32,ln:89.58,desc:'Koch Bihar accedes to the Indian Union in 1949, ending over 400 years of Koch rule in the region.'}],pts:territory([[28.0,88.0],[26.0,90.0],[24.0,88.0],[26.0,86.0]]),eraHidden:false},
    {n:'Gondwana Kingdom',sub:'1200-1750 CE',la:22.50,ln:79.50,desc:'Tribal kingdom of Gond rulers in central India. Garha-Mandla kingdom. Rani Durgavati (1564) famously resisted Akbar. Known for Gond architecture at Mandla, Chauragarh.',fact:'Rani Durgavati (1524-1564) · Garha-Mandla · Gond art at Chauragarh · Akbar\'s invasion 1564 · Tribal kingdom',steps:[{year:1200,label:'Rise of Gondwana',la:22.50,ln:79.50,desc:'The Gond kingdoms emerge in central India, with Garha-Mandla becoming the most powerful Gond kingdom in the Narmada valley.'},{year:1564,label:'Rani Durgavati\'s Resistance',la:22.50,ln:79.50,desc:'Rani Durgavati, the Gond queen, fights a heroic battle against Akbar\'s forces and dies fighting, becoming a symbol of resistance.'},{year:1750,label:'Decline',la:22.50,ln:79.50,desc:'The Gond kingdoms decline under Maratha and later British pressure, with their territories absorbed into larger empires.'}],pts:territory([[24.0,78.0],[22.0,82.0],[20.0,80.0],[20.0,76.0],[22.0,74.0],[24.0,76.0]]),eraHidden:false},
    {n:'Kingdom of Sikkim',sub:'1642-1975 CE',la:27.33,ln:88.61,desc:'Buddhist kingdom in the Himalayas. Founded by Phuntsog Namgyal (1642). Treaty of Tumlong (1861) made it British protectorate. Merged with India in 1975 (referendum).',fact:'Namgyal dynasty · Buddhist kingdom · Chogyal monarchy · Indo-Sikkim Treaty 1950 · Merger 1975 referendum',steps:[{year:1642,label:'Foundation',la:27.33,ln:88.61,desc:'Phuntsog Namgyal is consecrated as the first Chogyal (king) of Sikkim by three Tibetan lamas, establishing the Namgyal dynasty.'},{year:1888,label:'British Protectorate',la:27.33,ln:88.61,desc:'The British establish control over Sikkim after the Anglo-Sikkimese conflict, making it a protectorate.'},{year:1975,label:'Merger with India',la:27.33,ln:88.61,desc:'After a referendum, Sikkim becomes the 22nd state of India, ending the Chogyal monarchy.'}],pts:territory([[30.0,86.0],[28.0,90.0],[26.0,88.0],[28.0,84.0]]),eraHidden:false},
    {n:'Carnatic Sultanate',sub:'1690-1855 CE',la:12.92,ln:79.14,desc:'Nawab of Arcot. Ruled by Nawayat dynasty. Played key role in Carnatic Wars (1746-1763) between British and French. Annexed by British under Doctrine of Lapse.',fact:'Nawab of Arcot · Carnatic Wars · Clive\'s first campaign · Anwaruddin Khan · Arcot capital',steps:[{year:1690,label:'Foundation',la:12.92,ln:79.14,desc:'The Mughal Empire establishes the Nawab of the Carnatic, with its capital at Arcot, as a provincial governor of the Deccan.'},{year:1749,label:'Carnatic Wars',la:12.92,ln:79.14,desc:'The Carnatic region becomes the battleground for Anglo-French rivalry, with the British emerging victorious under Robert Clive.'},{year:1855,label:'Annexation',la:12.92,ln:79.14,desc:'The British annex the Carnatic under the Doctrine of Lapse after the death of Nawab Ghulam Muhammad Ghouse Khan without a heir.'}],pts:territory([[16.0,78.0],[14.0,82.0],[10.0,80.0],[10.0,76.0],[12.0,74.0],[14.0,76.0]]),eraHidden:false},
];
D.w_kingdom = [
   {n:'Roman Empire',sub:'27 BCE-476 CE',la:41.90,ln:12.50,desc:'Greatest ancient empire. From Britain to Mesopotamia. Peak under Trajan (117 CE). Latin, law, engineering, Christianity shaped Western civilization. Senate, emperors, legions.',fact:'Pax Romana · 5000 km roads · Colosseum · Aqueducts · Fall 476 CE (Romulus Augustulus)',steps:[{year:-27,label:'Augustus',la:41.90,ln:12.50,desc:'Augustus becomes the first Roman emperor, ending the Republic and establishing the Principate that brings peace and stability to the Mediterranean world.'},{year:117,label:'Maximum Extent',la:41.90,ln:12.50,desc:'Under Emperor Trajan, the Roman Empire reaches its greatest territorial extent, stretching from Britain to Mesopotamia and the Caucasus.'},{year:313,label:'Edict of Milan',la:41.90,ln:12.50,desc:'Constantine legalizes Christianity with the Edict of Milan, transforming the empire\'s religious landscape and paving the way for Christendom.'},{year:476,label:'Fall of Rome',la:41.90,ln:12.50,desc:'The last Roman emperor Romulus Augustulus is deposed by Germanic chieftain Odoacer, marking the traditional end of the Western Roman Empire.'}],pts:territory([[55.0,-5.0],[50.0,2.0],[48.0,8.0],[45.0,12.0],[42.0,8.0],[40.0,2.0],[38.0,10.0],[36.0,14.0],[32.0,22.0],[30.0,28.0],[28.0,32.0],[30.0,36.0],[32.0,40.0],[36.0,36.0],[40.0,28.0],[42.0,20.0],[45.0,16.0],[48.0,12.0],[50.0,5.0],[52.0,0.0],[52.0,-5.0]]),eraHidden:false},
   {n:'Mongol Empire',sub:'1206-1368 CE',la:47.00,ln:102.00,desc:'Largest contiguous land empire in history. Founded by Genghis Khan (1206). At peak under Kublai Khan — from Pacific to Eastern Europe. Silk Road united. Yuan Dynasty in China.',fact:'Largest empire (33M km²) · Yam postal system · Pax Mongolica · Siege of Baghdad (1258) · Split into 4 khanates',steps:[{year:1206,label:'Genghis Khan',la:47.00,ln:102.00,desc:'Temujin is proclaimed Genghis Khan at the Kurultai, uniting the Mongol tribes and beginning the conquest of Eurasia.'},{year:1258,label:'Siege of Baghdad',la:33.32,ln:44.39,desc:'Hulagu Khan sacks Baghdad, ending the Abbasid Caliphate and establishing Mongol dominance over the Islamic heartland.'},{year:1271,label:'Yuan Dynasty',la:39.90,ln:116.41,desc:'Kublai Khan founds the Yuan Dynasty in China, completing the Mongol conquest of China and ruling the largest contiguous land empire ever.'},{year:1368,label:'Mongol Decline',la:47.00,ln:102.00,desc:'The Yuan Dynasty falls to the Ming, and the Mongol Empire fragments into four separate khanates that gradually weaken and dissolve.'}],pts:territory([[55.0,30.0],[50.0,40.0],[45.0,50.0],[40.0,60.0],[42.0,70.0],[45.0,80.0],[48.0,90.0],[50.0,100.0],[55.0,110.0],[50.0,120.0],[45.0,130.0],[40.0,120.0],[35.0,110.0],[30.0,100.0],[28.0,90.0],[25.0,80.0],[30.0,70.0],[35.0,60.0],[40.0,50.0],[45.0,40.0],[48.0,30.0]]),eraHidden:false},
   {n:'Ottoman Empire',sub:'1299-1922 CE',la:41.01,ln:28.98,desc:'Last great Islamic caliphate. Founded by Osman I. Mehmed II conquered Constantinople (1453). Peak under Suleiman the Magnificent (1520-1566). Controlled SE Europe, W Asia, N Africa.',fact:'Fall of Constantinople 1453 · Siege of Vienna 1529 & 1683 · Janissaries · Suleiman\'s legal code',steps:[{year:1299,label:'Foundation',la:41.01,ln:28.98,desc:'Osman I declares independence from the Seljuk Sultanate and founds the Ottoman Beylik in northwestern Anatolia.'},{year:1453,label:'Fall of Constantinople',la:41.01,ln:28.98,desc:'Mehmed II conquers Constantinople, ending the Byzantine Empire and establishing Ottoman dominance in the Eastern Mediterranean.'},{year:1683,label:'Siege of Vienna',la:48.21,ln:16.37,desc:'The Ottomans suffer a decisive defeat at Vienna, halting their expansion into Europe and beginning a long period of slow decline.'},{year:1922,label:'Abolition',la:41.01,ln:28.98,desc:'The Ottoman Sultanate is abolished after the Turkish War of Independence, ending over six centuries of imperial rule.'}],pts:territory([[48.0,12.0],[45.0,16.0],[42.0,20.0],[40.0,28.0],[36.0,36.0],[32.0,40.0],[30.0,36.0],[28.0,30.0],[30.0,26.0],[32.0,20.0],[35.0,16.0],[38.0,12.0],[42.0,8.0],[46.0,10.0]]),eraHidden:false},
   {n:'Achaemenid Empire',sub:'550-330 BCE',la:29.93,ln:52.89,desc:'First Persian Empire. Founded by Cyrus the Great. Peak under Darius I — from Balkans to Indus Valley. Royal Road, satrapies, Persepolis. Defeated by Alexander (330 BCE).',fact:'Cyrus Cylinder · Royal Road (2500 km) · Persepolis palace · 23 satrapies · Behistun inscription',steps:[{year:-550,label:'Cyrus the Great',la:29.93,ln:52.89,desc:'Cyrus II overthrows the Median Empire and founds the Achaemenid dynasty, conquering Babylon and liberating the Jewish exiles.'},{year:-522,label:'Darius I',la:29.93,ln:52.89,desc:'Darius I ascends the throne and reorganizes the empire into satrapies, building the Royal Road and the ceremonial capital at Persepolis.'},{year:-330,label:'Fall to Alexander',la:29.93,ln:52.89,desc:'Alexander the Great defeats Darius III and burns Persepolis, ending the Achaemenid Empire and beginning the Hellenistic period.'}],pts:territory([[40.0,22.0],[38.0,28.0],[36.0,32.0],[32.0,36.0],[30.0,40.0],[32.0,48.0],[30.0,52.0],[28.0,56.0],[26.0,60.0],[24.0,64.0],[20.0,72.0],[22.0,60.0],[24.0,52.0],[28.0,48.0],[30.0,44.0],[32.0,40.0],[36.0,36.0],[38.0,30.0],[32.0,32.0],[30.0,28.0],[32.0,24.0],[36.0,20.0]]),eraHidden:false},
   {n:'British Empire',sub:'1707-1997 CE',la:51.51,ln:-0.13,desc:'Largest empire in history (1921: 35M km²). Colonies on every continent. "The empire on which the sun never sets." Industrial Revolution, Royal Navy, English language global spread.',fact:'Largest empire ever (35M km²) · East India Company (1600) · American Independence (1776) · Commonwealth',steps:[{year:1757,label:'Indian Conquest',la:51.51,ln:-0.13,desc:'Robert Clive wins the Battle of Plassey, establishing British East India Company rule in Bengal and laying the foundation of the British Raj.'},{year:1776,label:'American Loss',la:51.51,ln:-0.13,desc:'The American colonies declare independence, marking a major setback but the British Empire expands elsewhere in Asia, Africa, and the Pacific.'},{year:1921,label:'Peak Extent',la:51.51,ln:-0.13,desc:'The British Empire reaches its greatest territorial extent, governing roughly a quarter of the world\'s population and land area.'},{year:1997,label:'Hong Kong Handover',la:51.51,ln:-0.13,desc:'Britain hands Hong Kong back to China, symbolically marking the end of the British Empire as the last major colonial possession.'}],pts:territory([[55.0,-10.0],[50.0,-5.0],[52.0,2.0],[48.0,-2.0],[45.0,-5.0],[48.0,-10.0],[52.0,-8.0],[55.0,-10.0]]),eraHidden:false},
   {n:'Han Dynasty',sub:'206 BCE-220 CE',la:34.00,ln:108.00,desc:'Golden age of China. Founded by Liu Bang. Peak under Emperor Wu (141-87 BCE). Silk Road opened to West. Confucianism state philosophy. Paper, compass, seismograph invented.',fact:'Silk Road opened 130 BCE · Paper invented ~105 CE · Cao Wei, Shu Han, Wu Dong split · 400 years rule',steps:[{year:-206,label:'Foundation',la:34.00,ln:108.00,desc:'Liu Bang establishes the Han Dynasty after defeating Xiang Yu, with Chang\'an as the capital and Confucianism as the state philosophy.'},{year:-130,label:'Silk Road',la:34.00,ln:108.00,desc:'Emperor Wu sends Zhang Qian to Central Asia, opening the Silk Road trade routes that connect China to the West.'},{year:220,label:'Three Kingdoms',la:34.00,ln:108.00,desc:'The Han Dynasty collapses and splits into the Three Kingdoms of Wei, Shu, and Wu, ending over four centuries of Han rule.'}],pts:territory([[42.0,80.0],[40.0,90.0],[38.0,100.0],[40.0,110.0],[38.0,120.0],[35.0,122.0],[30.0,120.0],[28.0,110.0],[25.0,108.0],[22.0,100.0],[20.0,90.0],[22.0,80.0],[28.0,78.0],[32.0,76.0],[35.0,80.0],[38.0,78.0]]),eraHidden:false},
   {n:'Umayyad Caliphate',sub:'661-750 CE',la:33.51,ln:36.29,desc:'Second Islamic caliphate, largest of early Islam. From Spain to Indus. Capital Damascus. Arabic administration. Built Dome of the Rock. Conquered Hispania, Transoxiana, Sindh.',fact:'Largest empire of 7th-8th century · Dome of the Rock (691) · Battle of Tours (732) · Arabization',steps:[{year:661,label:'Foundation',la:33.51,ln:36.29,desc:'Muawiya I establishes the Umayyad Caliphate with Damascus as its capital, shifting the Islamic empire\'s center from Arabia to Syria.'},{year:691,label:'Dome of the Rock',la:31.78,ln:35.23,desc:'Caliph Abd al-Malik builds the Dome of the Rock in Jerusalem, the first great masterpiece of Islamic architecture.'},{year:732,label:'Battle of Tours',la:47.39,ln:0.68,desc:'Charles Martel halts the Umayyad advance into Western Europe at Tours, marking the Islamic empire\'s furthest westward expansion.'},{year:750,label:'Abbasid Overthrow',la:33.51,ln:36.29,desc:'The Umayyads are overthrown by the Abbasids in a revolution, with most of the family massacred and a new caliphate established in Baghdad.'}],pts:territory([[44.0,-8.0],[42.0,0.0],[40.0,4.0],[38.0,8.0],[36.0,12.0],[32.0,20.0],[30.0,28.0],[28.0,32.0],[30.0,36.0],[32.0,40.0],[30.0,48.0],[28.0,52.0],[26.0,60.0],[24.0,64.0],[22.0,60.0],[20.0,52.0],[24.0,48.0],[26.0,40.0],[28.0,32.0],[32.0,24.0],[36.0,16.0],[42.0,4.0]]),eraHidden:false},
   {n:'Spanish Empire',sub:'1492-1898 CE',la:40.42,ln:-3.70,desc:'First global empire (16th c.). Conquered Americas (Cortés, Pizarro). Philip II — "The empire on which the sun never sets." Armada, Siglo de Oro. Lost colonies 19th c. (Cuba 1898).',fact:'Spanish Inquisition · Gold from Americas · Armada defeat 1588 · Siglo de Oro (art/literature)',steps:[{year:1492,label:'Discovery of Americas',la:40.42,ln:-3.70,desc:'Christopher Columbus reaches the Americas under Spanish patronage, opening the door to massive colonization and the flow of gold from the New World.'},{year:1521,label:'Aztec Conquest',la:19.43,ln:-99.13,desc:'Hernan Cortes conquers the Aztec Empire, gaining control of vast territories and wealth in Mesoamerica for Spain.'},{year:1588,label:'Armada Defeat',la:40.42,ln:-3.70,desc:'The Spanish Armada is defeated by England, marking the beginning of Spanish naval decline and the rise of English maritime power.'},{year:1898,label:'Spanish-American War',la:40.42,ln:-3.70,desc:'Spain loses Cuba, Puerto Rico, Guam, and the Philippines after the Spanish-American War, ending its remaining colonial empire.'}],pts:territory([[44.0,-10.0],[42.0,-8.0],[40.0,-5.0],[38.0,-2.0],[36.0,0.0],[38.0,2.0],[42.0,4.0],[44.0,-2.0]]),eraHidden:false},
   {n:'Byzantine Empire',sub:'330-1453 CE',la:41.01,ln:28.98,desc:'Eastern Roman Empire. Capital Constantinople. Greek Orthodox Christianity. Justinian\'s Code, Hagia Sophia. Preserved Greco-Roman knowledge. Fall to Ottomans 1453.',fact:'Hagia Sophia (537) · Justinian Code (529) · Body of Civil Law · Fall 1453 (Mehmed II) · Greek fire',steps:[{year:330,label:'Constantinople Founded',la:41.01,ln:28.98,desc:'Constantine the Great dedicates Constantinople as the new capital of the Roman Empire, creating a Christian Eastern hub.'},{year:537,label:'Hagia Sophia',la:41.01,ln:28.98,desc:'Emperor Justinian completes the Hagia Sophia, the largest cathedral in the world for nearly a thousand years and an architectural marvel.'},{year:1453,label:'Fall of Constantinople',la:41.01,ln:28.98,desc:'Mehmed II conquers Constantinople, ending the Byzantine Empire and transforming Hagia Sophia into a mosque.'}],pts:territory([[44.0,22.0],[42.0,26.0],[40.0,28.0],[38.0,32.0],[36.0,36.0],[32.0,32.0],[30.0,30.0],[32.0,26.0],[36.0,22.0],[40.0,20.0],[42.0,18.0]]),eraHidden:false},
   {n:'Ming Dynasty',sub:'1368-1644 CE',la:39.90,ln:116.41,desc:'Last imperial dynasty of China ruled by Han Chinese. Zheng He\'s treasure voyages. Great Wall rebuilt. Forbidden City, Ming porcelain, navy dominance. Fall to Manchu/Qing 1644.',fact:'Forbidden City built (1420) · Zheng He\'s fleet (1405-1433) · Great Wall renovation · 54 million population',steps:[{year:1368,label:'Foundation',la:39.90,ln:116.41,desc:'Zhu Yuanzhang expels the Mongols and establishes the Ming Dynasty, restoring Han Chinese rule with Nanjing as the capital.'},{year:1421,label:'Forbidden City',la:39.90,ln:116.41,desc:'The Yongle Emperor moves the capital to Beijing and completes the Forbidden City, the world\'s largest palace complex.'},{year:1433,label:'Zheng He\'s Voyages',la:39.90,ln:116.41,desc:'Zheng He\'s treasure fleet completes its last voyage across the Indian Ocean, demonstrating China\'s naval dominance before isolation.'},{year:1644,label:'Qing Conquest',la:39.90,ln:116.41,desc:'The Ming Dynasty falls to the Manchu Qing invaders after rebel Li Zicheng captures Beijing, ending nearly 300 years of Ming rule.'}],pts:territory([[42.0,80.0],[40.0,90.0],[38.0,100.0],[40.0,112.0],[42.0,120.0],[40.0,130.0],[35.0,122.0],[30.0,120.0],[28.0,110.0],[25.0,108.0],[22.0,100.0],[22.0,80.0],[28.0,78.0],[32.0,76.0],[35.0,80.0],[40.0,78.0]]),eraHidden:false},
   {n:'Abbasid Caliphate',sub:'750-1258 CE',la:33.32,ln:44.39,desc:'Third Islamic caliphate, Golden Age of Islam. Capital Baghdad (House of Wisdom). Peak under Harun al-Rashid. Advances in math, science, medicine, philosophy. Ended by Mongols 1258.',fact:'House of Wisdom · Al-Khwarizmi (algebra) · One Thousand and One Nights · Islamic Golden Age',steps:[{year:750,label:'Foundation',la:33.32,ln:44.39,desc:'The Abbasid Revolution overthrows the Umayyads and establishes a new caliphate with Baghdad as the capital, founded by Caliph al-Mansur.'},{year:830,label:'House of Wisdom',la:33.32,ln:44.39,desc:'Caliph al-Mamun establishes the House of Wisdom in Baghdad, a center for translation and scholarship during the Islamic Golden Age.'},{year:1258,label:'Mongol Sack',la:33.32,ln:44.39,desc:'Hulagu Khan and the Mongols sack Baghdad, destroying the House of Wisdom and ending the Abbasid Caliphate in the east.'}],pts:territory([[42.0,8.0],[38.0,16.0],[36.0,20.0],[32.0,28.0],[30.0,36.0],[32.0,40.0],[34.0,44.0],[36.0,48.0],[32.0,50.0],[30.0,56.0],[28.0,52.0],[24.0,48.0],[26.0,40.0],[28.0,32.0],[30.0,28.0],[34.0,20.0],[38.0,12.0],[40.0,6.0]]),eraHidden:false},
   {n:'Maurya Empire (World)',sub:'321-185 BCE',la:25.61,ln:85.14,desc:'See Indian Kingdoms section for details. The Maurya Empire also had influence over Hellenistic world through diplomatic missions & trade.',fact:'Megasthenes (Greek ambassador) · Ashoka\'s missions to Greece, Egypt, Sri Lanka · Pataliputra palace',steps:[{year:-321,label:'Foundation',la:25.61,ln:85.14,desc:'Chandragupta Maurya establishes the Maurya Empire with guidance from Chanakya, creating the largest empire in the ancient Indian subcontinent.'},{year:-269,label:'Ashoka\'s Edicts',la:25.61,ln:85.14,desc:'Ashoka embraces Buddhism after the Kalinga War and sends diplomatic missions to Greek kings, Egypt, and Sri Lanka spreading dhamma.'},{year:-185,label:'Decline',la:25.61,ln:85.14,desc:'The Maurya Empire falls to the Shunga dynasty after a period of decline following Ashoka\'s death and the division of the empire.'}],pts:territory([[36.0,64.0],[34.0,70.0],[30.0,72.0],[26.0,72.0],[20.0,74.0],[16.0,76.0],[12.0,78.0],[8.0,78.0],[8.0,80.0],[12.0,82.0],[18.0,84.0],[22.0,88.0],[26.0,90.0],[28.0,86.0],[32.0,82.0],[34.0,78.0],[36.0,72.0]]),eraHidden:false},
   {n:'Inca Empire',sub:'1438-1533 CE',la:-13.52,ln:-71.97,desc:'Largest empire in pre-Columbian Americas. Andes from Ecuador to Chile. Cusco capital. Machu Picchu. Road system (40,000 km). Quipu record-keeping. Conquered by Pizarro (1533).',fact:'Machu Picchu · 40,000 km roads · Quipu (knot record) · Atahualpa last emperor · Terrace farming',steps:[{year:1438,label:'Pachacuti',la:-13.52,ln:-71.97,desc:'Pachacuti Inca Yupanqui becomes the ninth Sapa Inca and transforms the Inca state into a vast empire, rebuilding Cusco and building Machu Picchu.'},{year:1532,label:'Spanish Arrival',la:-13.52,ln:-71.97,desc:'Francisco Pizarro captures Emperor Atahualpa at Cajamarca, beginning the Spanish conquest of the Inca Empire.'},{year:1533,label:'Fall of Inca',la:-13.52,ln:-71.97,desc:'Atahualpa is executed despite a ransom of gold, and the Spanish capture Cusco, bringing an end to the Inca Empire.'}],pts:territory([[0.0,-80.0],[-2.0,-78.0],[-4.0,-80.0],[-6.0,-78.0],[-8.0,-76.0],[-10.0,-76.0],[-12.0,-74.0],[-14.0,-72.0],[-16.0,-70.0],[-18.0,-70.0],[-20.0,-72.0],[-22.0,-68.0],[-18.0,-68.0],[-16.0,-72.0],[-14.0,-74.0],[-12.0,-76.0],[-10.0,-78.0],[-8.0,-80.0],[-4.0,-82.0],[-2.0,-80.0],[0.0,-78.0],[2.0,-76.0]]),eraHidden:false},
   {n:'Aztec Empire',sub:'1428-1521 CE',la:19.43,ln:-99.13,desc:'Mesoamerican empire of central Mexico. Tenochtitlan (Mexico City) — island capital. Triple Alliance. Advanced calendar, pyramids, chinampas. Cortés conquered (1521).',fact:'Tenochtitlan (200,000 population) · Chinampas (floating gardens) · Human sacrifice · 365-day calendar · Eagle warrior',steps:[{year:1428,label:'Triple Alliance',la:19.43,ln:-99.13,desc:'The Aztecs form the Triple Alliance with Texcoco and Tlacopan, establishing the foundation of the Aztec Empire under Itzcoatl.'},{year:1502,label:'Moctezuma II',la:19.43,ln:-99.13,desc:'Moctezuma II becomes emperor and expands the Aztec Empire to its greatest extent, ruling over an estimated five million people.'},{year:1521,label:'Spanish Conquest',la:19.43,ln:-99.13,desc:'Hernan Cortes and his Tlaxcalan allies capture Tenochtitlan after a brutal siege, ending the Aztec Empire.'}],pts:territory([[24.0,-106.0],[22.0,-104.0],[20.0,-102.0],[18.0,-100.0],[16.0,-98.0],[14.0,-96.0],[14.0,-92.0],[16.0,-90.0],[18.0,-92.0],[20.0,-94.0],[22.0,-96.0],[24.0,-98.0],[26.0,-100.0]]),eraHidden:false},
  {n:'Egyptian Empire',sub:'1550-1077 BCE',la:25.68,ln:32.65,desc:'New Kingdom of Egypt. Peak under Hatshepsut, Thutmose III, Ramesses II. Empire from Nubia to Syria. Valley of the Kings, Karnak Temple, Abu Simbel.',fact:'Ramesses II (Great) · Valley of the Kings · Hatshepsut female pharaoh · Battle of Kadesh (1274 BCE) · Abu Simbel',steps:[{year:-1479,label:'Thutmose III',la:25.68,ln:32.65,desc:'Thutmose III launches 17 military campaigns across Syria and Nubia, expanding Egypt to its greatest extent and making it the dominant power of the Near East.'},{year:-1274,label:'Battle of Kadesh',la:34.58,ln:36.50,desc:'Ramesses II fights the Hittites at Kadesh in the largest chariot battle in history; the subsequent treaty is the oldest known peace agreement.'},{year:-1077,label:'Empire Declines',la:25.68,ln:32.65,desc:'The New Kingdom collapses under internal decay, tomb robberies, and invasions by the Sea Peoples, ending over five centuries of Pharaonic imperial rule.'}],pts:territory([[32.0,24.0],[30.0,26.0],[28.0,28.0],[26.0,30.0],[24.0,32.0],[22.0,34.0],[20.0,36.0],[18.0,38.0],[16.0,36.0],[14.0,34.0],[12.0,32.0],[10.0,30.0],[12.0,28.0],[14.0,26.0],[16.0,24.0],[18.0,22.0],[20.0,20.0],[24.0,22.0],[28.0,24.0],[30.0,24.0]]),eraHidden:false},
  {n:'Assyrian Empire',sub:'911-609 BCE',la:36.34,ln:43.13,desc:'Mesopotamian empire — the first superpower. Harsh military rule. Nineveh capital. Library of Ashurbanipal. Conquered Babylon, Israel, Egypt. Fallen to Medes & Babylonians.',fact:'Library of Ashurbanipal (20,000+ tablets) · Nineveh walls (12 km) · First systematic military state · Iron weapons',steps:[{year:-911,label:'Neo-Assyrian Begins',la:36.34,ln:43.13,desc:'Adad-nirari II launches campaigns of reconquest, initiating the Neo-Assyrian period that transforms Assyria into the first true imperial superpower.'},{year:-722,label:'Conquest of Israel',la:32.08,ln:34.78,desc:'Sargon II conquers the Kingdom of Israel and deports its population, marking the first major phase of Assyrian expansion into the Mediterranean.'},{year:-612,label:'Fall of Nineveh',la:36.34,ln:43.13,desc:'A coalition of Medes, Babylonians, and Scythians destroys Nineveh, ending the Assyrian Empire through the complete devastation of its capital.'}],pts:territory([[38.0,32.0],[36.0,36.0],[34.0,40.0],[32.0,44.0],[36.0,48.0],[38.0,44.0],[40.0,40.0],[42.0,36.0],[40.0,32.0],[38.0,32.0]]),eraHidden:false},
  {n:'Neo-Babylonian Empire',sub:'626-539 BCE',la:32.54,ln:44.42,desc:'Chaldean dynasty of Babylon. Nebuchadnezzar II (605-562 BCE) built Hanging Gardens (Wonder of World). Ishtar Gate. Conquered Jerusalem (586 BCE). Fell to Persia (539 BCE).',fact:'Hanging Gardens of Babylon · Ishtar Gate · Tower of Babel legend · Nebuchadnezzar\'s inscriptions · Captivity of Jews',steps:[{year:-626,label:'Nabopolassar',la:32.54,ln:44.42,desc:'Nabopolassar rebels against Assyrian rule and establishes the Neo-Babylonian Empire, making Babylon the greatest and most magnificent city of the ancient world.'},{year:-586,label:'Jerusalem Destroyed',la:31.78,ln:35.22,desc:'Nebuchadnezzar II captures Jerusalem, destroys the Temple of Solomon, and deports the Jews to Babylon, beginning the Babylonian Captivity of the Jewish people.'},{year:-539,label:'Fall to Persia',la:32.54,ln:44.42,desc:'Cyrus the Great of Persia captures Babylon without a battle, ending the Neo-Babylonian Empire and allowing the exiled Jews to return to Jerusalem.'}],pts:territory([[36.0,40.0],[34.0,44.0],[32.0,48.0],[30.0,46.0],[30.0,42.0],[32.0,38.0],[34.0,38.0]]),eraHidden:false},
  {n:'Macedonian Empire',sub:'336-323 BCE',la:40.76,ln:22.50,desc:'Empire of Alexander the Great. From Greece to Indus (3 continents). Spread Hellenistic culture. Defeated Persia (Gaugamela 331 BCE). Founded Alexandria. Empire split after his death.',fact:'Alexander (356-323 BCE) · Battle of Gaugamela · Founded ~20 Alexandria cities · Hellenistic Age began · Gordian knot',steps:[{year:-336,label:'Alexander Ascends',la:40.76,ln:22.50,desc:'Alexander III becomes king of Macedon at age 20 after the assassination of his father Philip II, inheriting a unified Greek army and plans to invade Persia.'},{year:-331,label:'Gaugamela',la:36.36,ln:43.25,desc:'Alexander defeats Darius III at Gaugamela in a decisive battle, shattering the Achaemenid Persian Empire and making Alexander the undisputed master of Asia.'},{year:-323,label:'Alexander Dies',la:32.54,ln:44.42,desc:'Alexander dies in Babylon at age 32 after a decade of continuous conquest, his empire immediately divided among his generals who found the Hellenistic kingdoms.'}],pts:territory([[42.0,18.0],[40.0,22.0],[38.0,24.0],[36.0,28.0],[34.0,30.0],[32.0,36.0],[30.0,40.0],[30.0,48.0],[32.0,52.0],[34.0,56.0],[36.0,60.0],[32.0,64.0],[30.0,68.0],[28.0,64.0],[28.0,60.0],[28.0,56.0],[30.0,50.0],[32.0,44.0],[34.0,36.0],[36.0,30.0],[38.0,24.0],[40.0,20.0]]),eraHidden:false},
  {n:'Ptolemaic Kingdom',sub:'305-30 BCE',la:31.18,ln:29.89,desc:'Hellenistic kingdom of Egypt. Founded by Ptolemy I (general of Alexander). Cleopatra VII last ruler. Library of Alexandria. Pharos lighthouse (Wonder). Annexed by Rome (30 BCE).',fact:'Library of Alexandria · Pharos Lighthouse (Wonder) · Cleopatra VII · Rosetta Stone · Serapeum temple',steps:[{year:-305,label:'Ptolemy I Crowned',la:31.18,ln:29.89,desc:'Ptolemy I Soter declares himself king of Egypt, founding the last dynasty of pharaohs and establishing Alexandria as the greatest center of Hellenistic learning.'},{year:-246,label:'Library Peak',la:31.18,ln:29.89,desc:'The Library of Alexandria flourishes under Ptolemy III, housing hundreds of thousands of scrolls and attracting the greatest scholars of the ancient world.'},{year:-30,label:'Cleopatra\'s Fall',la:31.18,ln:29.89,desc:'Cleopatra VII dies by suicide after Octavian\'s conquest; Egypt is annexed as a Roman province, ending over 250 years of Ptolemaic rule.'}],pts:territory([[32.0,24.0],[30.0,26.0],[28.0,28.0],[26.0,30.0],[24.0,32.0],[22.0,34.0],[20.0,36.0],[18.0,34.0],[18.0,30.0],[20.0,28.0],[22.0,26.0],[24.0,24.0],[28.0,24.0],[30.0,24.0]]),eraHidden:false},
  {n:'Seleucid Empire',sub:'312-63 BCE',la:33.52,ln:36.32,desc:'Hellenistic empire from Anatolia to Indus. Founded by Seleucus I Nicator. Fought Mauryas (gave up eastern provinces). Capital at Antioch. Declined from Parthian & Roman pressure.',fact:'Seleucus I · Battle of Ipsus (301 BCE) · Treaty with Chandragupta Maurya · Antioch capital · Greco-Bactrian split',steps:[{year:-312,label:'Seleucus Takes Babylon',la:33.52,ln:36.32,desc:'Seleucus I Nicator establishes himself in Babylon and founds the Seleucid Empire, the largest of the Hellenistic kingdoms stretching from Anatolia to the Indus.'},{year:-301,label:'Battle of Ipsus',la:38.95,ln:30.85,desc:'The Battle of Ipsus decides the final division of Alexander\'s empire; Seleucus gains Syria and secures his realm against rival successors.'},{year:-63,label:'Roman Annexation',la:33.52,ln:36.32,desc:'Pompey the Great annexes Syria as a Roman province, ending the once-mighty Seleucid Empire that had ruled the Near East for over two centuries.'}],pts:territory([[40.0,26.0],[38.0,32.0],[36.0,36.0],[34.0,40.0],[36.0,44.0],[38.0,48.0],[36.0,52.0],[34.0,56.0],[32.0,60.0],[28.0,64.0],[24.0,60.0],[26.0,56.0],[28.0,50.0],[30.0,44.0],[32.0,36.0],[34.0,30.0],[36.0,24.0]]),eraHidden:false},
  {n:'Carthaginian Empire',sub:'814-146 BCE',la:36.86,ln:10.33,desc:'Phoenician maritime empire of North Africa. Rival of Rome. Hannibal\'s crossing of Alps (218 BCE). Punic Wars. Destroyed by Rome in Third Punic War (146 BCE). Salt on fields.',fact:'Hannibal\'s Alps crossing · Elephants in warfare · Cato "Carthago delenda est" · Punic Wars 3 phases · Salt legend',steps:[{year:-264,label:'First Punic War',la:36.86,ln:10.33,desc:'The First Punic War begins between Rome and Carthage over control of Sicily, launching the first of three devastating conflicts between the two Mediterranean powers.'},{year:-218,label:'Hannibal Crosses Alps',la:45.07,ln:6.70,desc:'Hannibal Barca leads his army including war elephants across the Alps in a daring march, surprising the Romans and invading Italy from the north.'},{year:-146,label:'Carthage Destroyed',la:36.86,ln:10.33,desc:'Roman forces under Scipio Aemilianus raze Carthage after a three-year siege, selling the survivors into slavery and pouring salt on the ruins.'}],pts:territory([[40.0,-6.0],[38.0,-2.0],[36.0,2.0],[34.0,6.0],[32.0,10.0],[30.0,12.0],[28.0,14.0],[26.0,12.0],[26.0,8.0],[28.0,4.0],[30.0,0.0],[32.0,-4.0],[36.0,-8.0],[38.0,-6.0]]),eraHidden:false},
  {n:'Holy Roman Empire',sub:'800-1806 CE',la:50.12,ln:8.68,desc:'Multi-ethnic empire of Central Europe. Founded by Charlemagne (800 CE). Otto I revived. Hapsburg dynasty. Voltaire said "neither Holy, nor Roman, nor an Empire". Dissolved 1806 (Napoleon).',fact:'Charlemagne (800) · Golden Bull (1356) · 30 Years\' War (1618-48) · Peace of Westphalia · 300+ states',steps:[{year:800,label:'Charlemagne Crowned',la:41.89,ln:12.49,desc:'Pope Leo III crowns Charlemagne Emperor of the Romans in St Peter\'s Basilica, reviving the Western imperial title after three centuries of disunity.'},{year:962,label:'Otto I Revives Empire',la:41.89,ln:12.49,desc:'Otto I is crowned Holy Roman Emperor by Pope John XII, founding the Ottonian dynasty and establishing the empire as the dominant power in Germany and Italy.'},{year:1806,label:'Dissolution',la:50.12,ln:8.68,desc:'Emperor Francis II abdicates under pressure from Napoleon, dissolving the Holy Roman Empire after a thousand years and bringing the Habsburg imperial title to an end.'}],pts:territory([[54.0,6.0],[52.0,10.0],[50.0,14.0],[48.0,16.0],[46.0,18.0],[44.0,16.0],[42.0,14.0],[44.0,12.0],[46.0,8.0],[48.0,6.0],[50.0,4.0],[52.0,4.0]]),eraHidden:false},
  {n:'French Empire (Napoleonic)',sub:'1804-1815 CE',la:48.86,ln:2.35,desc:'Napoleon Bonaparte\'s empire. Controlled most of Europe (1812 peak). Napoleonic Code. Grand Army. Defeated at Waterloo (1815). Exiled to St Helena. ended by Congress of Vienna.',fact:'Napoleonic Code (1804) · 1812 invasion of Russia · Waterloo (1815) · 600,000 Grand Army · French Revolution legacy',steps:[{year:1804,label:'Napoleon Crowned',la:48.86,ln:2.35,desc:'Napoleon Bonaparte crowns himself Emperor of the French at Notre Dame Cathedral, establishing the First French Empire with a new hereditary dynasty.'},{year:1812,label:'Invasion of Russia',la:55.75,ln:37.62,desc:'Napoleon invades Russia with the Grand Army of over 600,000 men, but the brutal Russian winter destroys his forces and marks the beginning of his catastrophic decline.'},{year:1815,label:'Waterloo',la:50.68,ln:4.41,desc:'Wellington and Blücher defeat Napoleon at Waterloo in a close-fought battle, ending the Napoleonic Wars and sending the emperor into exile on St Helena.'}],pts:territory([[52.0,4.0],[50.0,8.0],[48.0,12.0],[46.0,14.0],[44.0,12.0],[42.0,8.0],[44.0,4.0],[46.0,2.0],[48.0,0.0],[50.0,-2.0]]),eraHidden:false},
  {n:'Russian Empire',sub:'1721-1917 CE',la:59.94,ln:30.31,desc:'Third largest empire in history (22.8M km²). Founded by Peter the Great. Romanov dynasty. Serfdom abolished 1861. Trans-Siberian Railway. Fell to Bolshevik Revolution (1917).',fact:'Peter the Great (1682-1725) · Catherine the Great · Trans-Siberian Railway (9,289 km) · Serfdom · Romanov 300 years',steps:[{year:1721,label:'Peter Proclaimed Emperor',la:59.94,ln:30.31,desc:'Peter the Great is proclaimed Emperor of All Russia after the Treaty of Nystad, modernizing the country and transforming it into a major European power.'},{year:1861,label:'Serfdom Abolished',la:59.94,ln:30.31,desc:'Tsar Alexander II issues the Emancipation Reform, freeing 23 million serfs from feudal bondage in a landmark but incomplete social transformation.'},{year:1917,label:'Bolshevik Revolution',la:59.94,ln:30.31,desc:'The Bolshevik Revolution led by Vladimir Lenin overthrows the provisional government and ends over three centuries of Romanov imperial rule in Russia.'}],pts:territory([[70.0,30.0],[65.0,40.0],[60.0,50.0],[55.0,60.0],[50.0,70.0],[48.0,80.0],[50.0,90.0],[52.0,100.0],[55.0,110.0],[50.0,120.0],[45.0,130.0],[45.0,120.0],[45.0,110.0],[42.0,100.0],[40.0,90.0],[38.0,80.0],[40.0,70.0],[42.0,60.0],[45.0,50.0],[48.0,40.0],[50.0,30.0],[55.0,20.0],[60.0,20.0]]),eraHidden:false},
  {n:'Japanese Empire',sub:'1868-1947 CE',la:35.68,ln:139.69,desc:'Modern imperial Japan. Meiji Restoration (1868). Rapid industrialization. Conquered Korea, Taiwan, Manchuria, SE Asia. Defeated in WWII (1945). Atomic bombs, occupation. Peace constitution.',fact:'Meiji Restoration (1868) · Russo-Japanese War (1905) · Pearl Harbor (1941) · Hiroshima & Nagasaki 1945 · Emperor Hirohito',steps:[{year:1868,label:'Meiji Restoration',la:35.68,ln:139.69,desc:'Emperor Meiji is restored to power after the fall of the Tokugawa shogunate, beginning a period of rapid modernization and industrialization in Japan.'},{year:1905,label:'Russo-Japanese Victory',la:35.68,ln:139.69,desc:'Japan defeats the Russian Empire in the Russo-Japanese War, the first Asian victory over a European power in modern times, establishing Japan as a major world power.'},{year:1945,label:'World War II Surrender',la:35.68,ln:139.69,desc:'Japan surrenders after the atomic bombings of Hiroshima and Nagasaki, ending World War II and the Japanese Empire; a pacifist constitution is adopted.'}],pts:territory([[46.0,140.0],[44.0,144.0],[40.0,144.0],[36.0,140.0],[34.0,136.0],[32.0,132.0],[34.0,128.0],[36.0,124.0],[38.0,126.0],[40.0,130.0],[42.0,134.0],[46.0,138.0]]),eraHidden:false},
  {n:'Mali Empire',sub:'1235-1670 CE',la:14.49,ln:-4.00,desc:'Wealthy West African empire. Famous for Mansa Musa (richest person in history). Timbuktu intellectual centre. Sankore University. Gold & salt trade. Fell to Songhai.',fact:'Mansa Musa (1312-1337) · Timbuktu gold · Sankore University · 60M gold (his pilgrimage) · Sundiata Keita founder',steps:[{year:1235,label:'Sundiata Founds Mali',la:14.49,ln:-4.00,desc:'Sundiata Keita defeats the Sosso king Soumaoro Kante at the Battle of Kirina, founding the Mali Empire that will dominate West Africa for centuries.'},{year:1324,label:'Mansa Musa\'s Pilgrimage',la:14.49,ln:-4.00,desc:'Mansa Musa embarks on his famous hajj to Mecca, distributing so much gold in Cairo that it causes a decade of inflation and puts Mali on the world map.'},{year:1670,label:'Empire Collapses',la:14.49,ln:-4.00,desc:'The Mali Empire disintegrates as vassal states break away and the rising Songhai Empire captures Timbuktu, ending centuries of Malian dominance in the Sahel.'}],pts:territory([[18.0,-10.0],[16.0,-8.0],[14.0,-6.0],[12.0,-4.0],[10.0,-2.0],[8.0,0.0],[6.0,-2.0],[8.0,-4.0],[10.0,-6.0],[12.0,-8.0],[14.0,-12.0],[16.0,-10.0]]),eraHidden:false},
  {n:'Songhai Empire',sub:'1464-1591 CE',la:16.77,ln:-2.99,desc:'Largest empire in West African history. Crossed Mali. Askia Muhammad the Great. Timbuktu, Gao, Djenne. Islamic scholarship. Defeated by Morocco with guns (1591).',fact:'Askia Muhammad (1493-1528) · Timbuktu manuscripts · Gao capital · Songhai navy · Defeated by Moroccan arquebusiers',steps:[{year:1464,label:'Sunni Ali Takes Power',la:16.77,ln:-2.99,desc:'Sunni Ali Ber becomes ruler of Songhai and embarks on a campaign of conquest, capturing Timbuktu and Djenne and greatly expanding Songhai territory.'},{year:1493,label:'Askia Muhammad',la:16.77,ln:-2.99,desc:'Askia Muhammad overthrows Sunni Baru and establishes the Askia dynasty, reorganizing the empire around Islam and a centralized administrative system.'},{year:1591,label:'Moroccan Conquest',la:16.77,ln:-2.99,desc:'Moroccan forces armed with arquebuses crush the Songhai army at the Battle of Tondibi, ending the largest empire in West African history.'}],pts:territory([[20.0,-10.0],[18.0,-8.0],[16.0,-6.0],[14.0,-4.0],[12.0,-2.0],[10.0,0.0],[8.0,2.0],[8.0,4.0],[10.0,6.0],[12.0,4.0],[14.0,2.0],[16.0,0.0],[18.0,-2.0],[20.0,-4.0],[22.0,-6.0]]),eraHidden:false},
   {n:'Khmer Empire',sub:'802-1431 CE',la:13.41,ln:103.87,desc:'Hindu-Buddhist empire of Cambodia. Angkor Wat — world\'s largest religious monument. Peak under Jayavarman VII (1181-1218). Extensive water management (baray). Declined after Siamese invasions.',fact:'Angkor Wat (UNESCO) · Jayavarman VII · Angkor Thom & Bayon faces · 1,000 km² water system · Suryavarman II built Angkor Wat',steps:[{year:802,label:'Foundation',la:13.41,ln:103.87,desc:'Jayavarman II declares independence from Java and founds the Khmer Empire, establishing the cult of the god-king (devaraja) on Phnom Kulen.'},{year:1113,label:'Angkor Wat Built',la:13.41,ln:103.87,desc:'Suryavarman II commissions Angkor Wat, the largest religious monument in the world, originally dedicated to the Hindu god Vishnu.'},{year:1181,label:'Jayavarman VII',la:13.41,ln:103.87,desc:'Jayavarman VII defeats the Chams and builds Angkor Thom with its iconic Bayon temple featuring over two hundred smiling stone faces.'},{year:1431,label:'Siamese Invasion',la:13.41,ln:103.87,desc:'The Siamese kingdom of Ayutthaya sacks Angkor, forcing the Khmer court to relocate south to Phnom Penh.'}],pts:territory([[16.0,104.0],[14.0,106.0],[12.0,108.0],[10.0,106.0],[10.0,104.0],[12.0,102.0],[14.0,100.0],[16.0,102.0]]),eraHidden:false},
   {n:'Srivijaya Empire',sub:'650-1377 CE',la:-2.99,ln:104.76,desc:'Buddhist thalassocratic empire of Sumatra. Controlled Strait of Malacca (key trade route). I-ching visited. Center of Buddhist learning. Palembang capital. Declined from Chola & Majapahit.',fact:'Strait of Malacca control · Chinese & Indian trade · Palembang capital · Chola raid 1025 · I-ching\'s records',steps:[{year:650,label:'Emergence',la:-2.99,ln:104.76,desc:'Srivijaya emerges as a powerful Buddhist thalassocracy based in Palembang, controlling the strategic Strait of Malacca trade route.'},{year:671,label:'I-ching Visit',la:-2.99,ln:104.76,desc:'The Chinese Buddhist monk I-ching visits Srivijaya and studies Sanskrit, describing it as a major center of Buddhist learning.'},{year:1025,label:'Chola Raid',la:-2.99,ln:104.76,desc:'Rajendra Chola I launches a massive naval raid against Srivijaya, sacking the capital and weakening its maritime dominance.'},{year:1377,label:'Majapahit Conquest',la:-2.99,ln:104.76,desc:'The Majapahit Empire conquers the remnants of Srivijaya, ending the long history of the Malay Buddhist maritime empire.'}],pts:territory([[4.0,98.0],[2.0,100.0],[0.0,102.0],[-2.0,104.0],[-4.0,106.0],[-2.0,108.0],[0.0,106.0],[2.0,104.0],[4.0,102.0]]),eraHidden:false},
   {n:'Majapahit Empire',sub:'1293-1527 CE',la:-7.26,ln:112.75,desc:'Last great Hindu-Buddhist empire of Indonesia. Based in Java. Peak under Hayam Wuruk (1350-1389) & Gajah Mada. Controlled much of SE Asia. Palapa Oath unified archipelago.',fact:'Gajah Mada\'s Palapa Oath · Hayam Wuruk · Nagarakretagama epic · Largest archipelagic empire · Spread of Islam ended it',steps:[{year:1293,label:'Foundation',la:-7.26,ln:112.75,desc:'Raden Wijaya defeats the Mongol invasion and establishes the Majapahit Empire in eastern Java with the support of Madura.'},{year:1336,label:'Palapa Oath',la:-7.26,ln:112.75,desc:'Gajah Mada takes his famous Palapa Oath, vowing not to eat any spices until he has unified the entire Nusantara archipelago under Majapahit.'},{year:1389,label:'Hayam Wuruk Dies',la:-7.26,ln:112.75,desc:'The death of Hayam Wuruk ends the golden age of Majapahit, and internal succession struggles weaken the empire.'},{year:1527,label:'Fall to Demak',la:-7.26,ln:112.75,desc:'The Muslim Demak Sultanate conquers the last Majapahit territories, marking the end of the Hindu-Buddhist era in Java.'}],pts:territory([[6.0,96.0],[4.0,98.0],[2.0,100.0],[0.0,102.0],[-2.0,104.0],[-4.0,106.0],[-6.0,108.0],[-8.0,106.0],[-8.0,112.0],[-6.0,114.0],[-4.0,112.0],[-2.0,110.0],[0.0,108.0],[2.0,106.0],[4.0,104.0],[6.0,102.0],[8.0,100.0]]),eraHidden:false},
   {n:'Timurid Empire',sub:'1370-1507 CE',la:39.65,ln:66.95,desc:'Central Asian empire founded by Timur (Tamerlane). Conquered Persia, Mesopotamia, India (sacked Delhi 1398). Samarkand capital — cultural & architectural renaissance. Mughals are descendants.',fact:'Timur (Tamerlane) · Samarkand Registan · Gur-e-Amir tomb · Sacked Delhi (1398) · Babur was descendant · Timurid Renaissance',steps:[{year:1370,label:'Timur\'s Rise',la:39.65,ln:66.95,desc:'Timur captures Samarkand and proclaims himself ruler of the Chagatai Khanate, making the city the dazzling capital of his growing empire.'},{year:1398,label:'Sack of Delhi',la:28.61,ln:77.23,desc:'Timur invades India and sacks Delhi, massacring tens of thousands and dismantling the Delhi Sultanate\'s military power.'},{year:1405,label:'Death of Timur',la:39.65,ln:66.95,desc:'Timur dies while leading a campaign against the Ming Dynasty, leaving a fragmented empire divided among his sons and grandsons.'},{year:1507,label:'Uzbek Conquest',la:39.65,ln:66.95,desc:'The Uzbeks under Muhammad Shaybani conquer the last Timurid strongholds, forcing Babur to flee south where he later founds the Mughal Empire.'}],pts:territory([[44.0,58.0],[42.0,62.0],[40.0,66.0],[38.0,70.0],[36.0,72.0],[34.0,68.0],[32.0,64.0],[30.0,60.0],[32.0,56.0],[34.0,52.0],[36.0,48.0],[38.0,52.0],[40.0,56.0],[42.0,58.0]]),eraHidden:false},
   {n:'Safavid Empire',sub:'1501-1736 CE',la:35.69,ln:51.39,desc:'Persian empire that made Shia Islam state religion. Peak under Shah Abbas I (1588-1629). Capital Isfahan — "half of the world". Rival of Ottomans & Mughals. Silk Road trade.',fact:'Shah Abbas I · Isfahan Naqsh-e Jahan Square · Persian carpet · Shia conversion · Battle of Chaldiran (1514) · Decline from 1722',steps:[{year:1501,label:'Shah Ismail I',la:35.69,ln:51.39,desc:'Shah Ismail I defeats the Aq Qoyunlu and enters Tabriz, proclaiming Twelver Shia Islam as the state religion of the new Safavid Empire.'},{year:1514,label:'Battle of Chaldiran',la:39.15,ln:42.54,desc:'The Safavids suffer a decisive defeat against the Ottoman Empire at Chaldiran, which sets the eastern border and limits Safavid expansion westward.'},{year:1598,label:'Isfahan Capital',la:35.69,ln:51.39,desc:'Shah Abbas I moves the capital to Isfahan and builds the Naqsh-e Jahan Square, transforming the city into one of the world\'s most beautiful.'},{year:1736,label:'Safavid Fall',la:35.69,ln:51.39,desc:'Nader Shah deposes the last Safavid shah and crowns himself, ending the Safavid dynasty that had ruled Persia for over two centuries.'}],pts:territory([[40.0,42.0],[38.0,44.0],[36.0,48.0],[34.0,52.0],[32.0,56.0],[30.0,54.0],[28.0,50.0],[26.0,48.0],[28.0,44.0],[30.0,40.0],[32.0,36.0],[34.0,38.0],[36.0,40.0],[38.0,42.0]]),eraHidden:false},
   {n:'Tang Dynasty',sub:'618-907 CE',la:34.30,ln:108.86,desc:'Golden Age of China. Chang\'an (Xi\'an) was world\'s largest city. Empress Wu Zetian. Poetry (Li Bai, Du Fu). Woodblock printing. Silk Road prosperity. Territory reached Central Asia.',fact:'Wu Zetian (only female emperor) · Chang\'an 1M population · Tang poetry golden age · An Lushan Rebellion (755) · Printing invented',steps:[{year:618,label:'Foundation',la:34.30,ln:108.86,desc:'Li Yuan declares himself emperor and establishes the Tang Dynasty in Chang\'an, ending the Sui Dynasty\'s brief but tumultuous rule.'},{year:690,label:'Wu Zetian',la:34.30,ln:108.86,desc:'Wu Zetian becomes the only female emperor in Chinese history, ruling as Empress of the Zhou Dynasty and elevating Buddhism over Confucianism.'},{year:755,label:'An Lushan Rebellion',la:34.30,ln:108.86,desc:'General An Lushan launches a massive rebellion that devastates China, killing millions and permanently weakening the Tang imperial government.'},{year:907,label:'Tang Collapse',la:34.30,ln:108.86,desc:'The last Tang emperor abdicates after years of warlord conflict, ending nearly three centuries of Chinese imperial golden age.'}],pts:territory([[46.0,80.0],[44.0,90.0],[42.0,100.0],[40.0,110.0],[38.0,120.0],[35.0,122.0],[30.0,120.0],[28.0,110.0],[25.0,108.0],[22.0,100.0],[20.0,90.0],[22.0,80.0],[28.0,78.0],[32.0,76.0],[36.0,78.0],[40.0,78.0],[44.0,78.0]]),eraHidden:false},
   {n:'Song Dynasty',sub:'960-1279 CE',la:34.79,ln:114.35,desc:'Medieval Chinese economic revolution. Paper money, gunpowder, movable type printing, compass. Southern Song (Hangzhou) peak. Neo-Confucianism. Marco Polo visited. Fallen to Mongols (1279).',fact:'First paper money (1024) · Gunpowder weapons · Movable type (Bi Sheng, 1040) · Civil service exams · Song navy & trade',steps:[{year:960,label:'Foundation',la:34.79,ln:114.35,desc:'General Zhao Kuangyin deposes the child emperor and founds the Song Dynasty in Kaifeng, reuniting most of China under a single ruler.'},{year:1040,label:'Movable Type',la:34.79,ln:114.35,desc:'Bi Sheng invents movable type printing using baked clay, a revolutionary technology that precedes Gutenberg by over four centuries.'},{year:1127,label:'Southern Song',la:34.79,ln:114.35,desc:'Jurchen Jin forces capture Kaifeng, forcing the Song court to flee south and reestablish the capital at Hangzhou as the Southern Song.'},{year:1279,label:'Mongol Conquest',la:34.79,ln:114.35,desc:'Kublai Khan\'s Mongol fleet annihilates the Song navy at Yamen, ending the Song Dynasty and completing the Mongol conquest of China.'}],pts:territory([[42.0,100.0],[40.0,110.0],[38.0,120.0],[35.0,122.0],[30.0,120.0],[28.0,110.0],[25.0,108.0],[22.0,100.0],[22.0,92.0],[24.0,90.0],[28.0,88.0],[32.0,90.0],[36.0,92.0],[40.0,94.0]]),eraHidden:false},
   {n:'Qin Dynasty',sub:'221-206 BCE',la:34.30,ln:108.86,desc:'First imperial dynasty of China. Qin Shi Huang (First Emperor). Standardized writing, currency, weights. Built Great Wall. Terracotta Army (8,000 soldiers). Legalist philosophy. Fell to Han.',fact:'Terracotta Army · Great Wall unification · Standardized script (small seal) · Burning of books (213 BCE) · 15 years only',steps:[{year:-221,label:'Unification',la:34.30,ln:108.86,desc:'Qin Shi Huang conquers the last of the Warring States and proclaims himself the First Emperor, unifying China under a centralized Legalist government.'},{year:-213,label:'Book Burning',la:34.30,ln:108.86,desc:'The Emperor orders the burning of books and burial of scholars to suppress Confucian thought, enforcing ideological uniformity through Legalist doctrine.'},{year:-210,label:'First Emperor Dies',la:34.30,ln:108.86,desc:'Qin Shi Huang dies while on a tour of eastern China and is buried with the massive Terracotta Army of over eight thousand life-sized soldiers.'},{year:-206,label:'Han Rebellion',la:34.30,ln:108.86,desc:'Rebellions led by Liu Bang and others overwhelm the Qin court; the last Qin ruler surrenders, ending the short-lived dynasty.'}],pts:territory([[40.0,100.0],[38.0,108.0],[36.0,112.0],[34.0,118.0],[32.0,120.0],[30.0,116.0],[28.0,108.0],[28.0,102.0],[30.0,98.0],[34.0,96.0],[38.0,98.0]]),eraHidden:false},
   {n:'Qing Dynasty',sub:'1644-1912 CE',la:39.90,ln:116.41,desc:'Last imperial dynasty of China. Manchu origin. Peak under Kangxi, Qianlong. China\'s territory doubled. Opium Wars with British. Taiping Rebellion (20M dead). Ended with Xinhai Revolution.',fact:'Kangxi (61 year reign) · Qianlong (60 year) · Opium Wars (1839-42, 1856-60) · Taiping (1850-64) · Boxer Rebellion (1900) · Last emperor 1912',steps:[{year:1644,label:'Qing Conquest',la:39.90,ln:116.41,desc:'Manchu armies capture Beijing after rebel Li Zicheng topples the Ming, and the Shunzhi Emperor becomes the first Qing ruler of China.'},{year:1683,label:'Unification',la:39.90,ln:116.41,desc:'The Qing conquer the Ming loyalist Kingdom of Tungning in Taiwan, bringing all of China under Manchu rule for the first time.'},{year:1839,label:'Opium War',la:39.90,ln:116.41,desc:'The First Opium War breaks out between Qing China and Britain over trade imbalances and opium smuggling, ending in China\'s humiliating defeat.'},{year:1912,label:'Xinhai Revolution',la:39.90,ln:116.41,desc:'The Xinhai Revolution forces the abdication of the last emperor Puyi, ending over two thousand years of imperial rule in China.'}],pts:territory([[48.0,78.0],[44.0,88.0],[42.0,100.0],[40.0,112.0],[42.0,120.0],[40.0,130.0],[35.0,122.0],[30.0,120.0],[28.0,110.0],[25.0,108.0],[22.0,100.0],[20.0,90.0],[22.0,80.0],[28.0,78.0],[32.0,76.0],[36.0,78.0],[40.0,78.0],[44.0,76.0]]),eraHidden:false},
   {n:'Dutch Empire',sub:'1602-1975 CE',la:52.37,ln:4.90,desc:'Dutch colonial empire. VOC (1602) — first multinational corporation. Controlled Indonesia, Sri Lanka, Cape of Good Hope, Suriname, Netherlands Antilles. Trade rival of British & Portuguese.',fact:'VOC (1602-1800) · Dutch East Indies (Indonesia) · New Amsterdam (NYC) · Tulip mania (1637) · Dutch Golden Age painting',steps:[{year:1602,label:'VOC Founded',la:52.37,ln:4.90,desc:'The Dutch East India Company (VOC) is chartered as the first multinational corporation, given a monopoly on Asian trade by the States General.'},{year:1624,label:'New Amsterdam',la:52.37,ln:4.90,desc:'Dutch settlers establish New Amsterdam on Manhattan Island, which becomes the capital of New Netherland and later New York City.'},{year:1800,label:'VOC Dissolved',la:52.37,ln:4.90,desc:'The VOC is formally dissolved due to financial troubles after the Fourth Anglo-Dutch War, and its colonies come under direct Dutch state control.'},{year:1945,label:'Indonesian Independence',la:52.37,ln:4.90,desc:'Indonesia declares independence from Dutch colonial rule after World War II, though the Dutch formally recognize it only in 1949.'}],pts:territory([[54.0,4.0],[52.0,6.0],[50.0,4.0],[48.0,2.0],[50.0,0.0],[52.0,2.0]]),eraHidden:false},
   {n:'Portuguese Empire',sub:'1415-1999 CE',la:38.72,ln:-9.13,desc:'First global empire (Age of Discovery). Vasco da Gama to India (1498). Cabral to Brazil (1500). Magellan\'s circumnavigation. Controlled Brazil, Goa, Macau, Angola, Mozambique. Longest-lived colonial empire (584 years).',fact:'Vasco da Gama (1498) · Pedro Álvares Cabral (1500) · Treaty of Tordesillas (1494) · Goa, Macau, Brazil colonies · 584-year empire',steps:[{year:1415,label:'Ceuta Captured',la:38.72,ln:-9.13,desc:'Portugal captures Ceuta in North Africa, marking the beginning of European overseas expansion and the first step of the Portuguese Empire.'},{year:1498,label:'Vasco da Gama',la:38.72,ln:-9.13,desc:'Vasco da Gama reaches Calicut in India by sailing around Africa, opening the first direct sea route between Europe and Asia.'},{year:1500,label:'Brazil Discovered',la:38.72,ln:-9.13,desc:'Pedro Álvares Cabral lands on the coast of Brazil and claims it for Portugal, establishing the foundation of Portugal\'s American colony.'},{year:1999,label:'Macau Handover',la:38.72,ln:-9.13,desc:'Portugal returns Macau to China, ending the last and longest-lived European colonial empire at 584 years of continuous existence.'}],pts:territory([[42.0,-10.0],[40.0,-8.0],[38.0,-10.0],[36.0,-8.0],[38.0,-6.0],[40.0,-2.0],[42.0,-6.0]]),eraHidden:false},
   {n:'Parthian Empire',sub:'247 BCE-224 CE',la:35.69,ln:51.39,desc:'Iranian empire that rivaled Rome. Arsacid dynasty. Defeated Crassus at Carrhae (53 BCE). Controlled Silk Road trade. Capital at Ctesiphon. Fell to Sasanians.',fact:'Battle of Carrhae (53 BCE) — Crassus killed · Silk Road middlemen · Ctesiphon capital · Defeated by Sasanians · Horse archers & cataphracts',steps:[{year:-247,label:'Arsacid Rise',la:35.69,ln:51.39,desc:'Arsaces I leads the Parni tribes to conquer Parthia from the Seleucids, founding the Arsacid dynasty that rules Persia for nearly five centuries.'},{year:-53,label:'Carrhae',la:35.69,ln:51.39,desc:'Parthian general Surena annihilates a Roman army under Crassus at Carrhae, one of Rome\'s worst military disasters, killing the triumvir.'},{year:224,label:'Sasanian Conquest',la:35.69,ln:51.39,desc:'Ardashir I defeats the last Parthian king Artabanus IV at Hormozdgan, ending the Parthian Empire and founding the Sasanian dynasty.'}],pts:territory([[40.0,44.0],[38.0,48.0],[36.0,52.0],[34.0,56.0],[32.0,60.0],[30.0,58.0],[28.0,52.0],[30.0,48.0],[32.0,44.0],[34.0,40.0],[36.0,38.0],[38.0,42.0]]),eraHidden:false},
   {n:'Sasanian Empire',sub:'224-651 CE',la:29.93,ln:52.89,desc:'Last Persian empire before Islam. Ardashir I founder. Peak under Khosrow I & Khosrow II. Rival of Rome/Byzantium. Zoroastrian state religion. Fell to Arab conquest (651 CE).',fact:'Khosrow I (Anushirvan "the Just") · Taq Kasra arch (Ctesiphon) · Zoroastrianism · Defeated by Caliph Umar · Shahrbaraz\'s wars with Byzantium',steps:[{year:224,label:'Foundation',la:29.93,ln:52.89,desc:'Ardashir I defeats the last Parthian king and crowns himself Shahanshah, founding the Sasanian Empire and restoring Zoroastrian orthodoxy.'},{year:531,label:'Khosrow I',la:29.93,ln:52.89,desc:'Khosrow I Anushirvan begins his reign, ushering in a golden age through administrative reforms, building projects, and patronage of scholarship.'},{year:651,label:'Arab Conquest',la:29.93,ln:52.89,desc:'Yazdegerd III is killed near Merv, and the last organized Sasanian resistance collapses before the advancing Arab Muslim armies.'}],pts:territory([[40.0,38.0],[38.0,44.0],[36.0,48.0],[34.0,52.0],[32.0,56.0],[30.0,60.0],[28.0,56.0],[24.0,52.0],[26.0,48.0],[28.0,44.0],[30.0,40.0],[32.0,36.0],[36.0,36.0],[38.0,38.0]]),eraHidden:false},
   {n:'Hittite Empire',sub:'1600-1178 BCE',la:39.94,ln:32.87,desc:'Ancient Anatolian empire. First to extensively use iron. Rival of Egypt. Battle of Kadesh (1274 BCE) against Ramesses II. Lost to Sea Peoples. Capital Hattusa (UNESCO, Turkey).',fact:'First iron-working empire · Battle of Kadesh 1274 BCE · Treaty of Kadesh (oldest peace treaty) · Hattusa capital · Suppiluliuma I greatest ruler',steps:[{year:-1600,label:'Old Kingdom',la:39.94,ln:32.87,desc:'The Hittite Old Kingdom is established with its capital at Hattusa, emerging as a major power in Anatolia under rulers like Hattusili I.'},{year:-1274,label:'Battle of Kadesh',la:39.94,ln:32.87,desc:'Hittite king Muwatalli II fights Ramesses II of Egypt at Kadesh, the largest chariot battle in history, ending in a stalemate and a peace treaty.'},{year:-1178,label:'Sea Peoples',la:39.94,ln:32.87,desc:'The Hittite Empire collapses as the mysterious Sea Peoples invade and burn Hattusa, destroying one of the great Bronze Age civilizations.'}],pts:territory([[42.0,28.0],[40.0,32.0],[38.0,36.0],[36.0,40.0],[34.0,36.0],[36.0,32.0],[38.0,28.0],[40.0,26.0]]),eraHidden:false},
   {n:'Median Empire',sub:'678-550 BCE',la:35.69,ln:51.39,desc:'First Iranian kingdom. Cyaxares (625-585 BCE) defeated Assyrians. Capital Ecbatana (Hamadan). Allied with Babylonians to destroy Nineveh (612 BCE). Precursor to Achaemenid Empire.',fact:'Destruction of Nineveh (612 BCE) · Cyaxares the Great · Ecbatana palace (Deioces built) · Astyages last king · Conquered by Cyrus the Great',steps:[{year:-678,label:'Deioces',la:35.69,ln:51.39,desc:'Deioces unites the Median tribes and builds the palace at Ecbatana, founding the first consolidated Iranian kingdom in western Iran.'},{year:-612,label:'Nineveh Destroyed',la:35.69,ln:51.39,desc:'Cyaxares allies with the Babylonians and Scythians to sack Nineveh, ending the Assyrian Empire and establishing Media as the dominant Near Eastern power.'},{year:-550,label:'Persian Conquest',la:35.69,ln:51.39,desc:'Cyrus the Great rebels against his grandfather Astyages and conquers Media, absorbing it into the new Achaemenid Persian Empire.'}],pts:territory([[38.0,44.0],[36.0,48.0],[34.0,52.0],[32.0,48.0],[34.0,44.0],[36.0,40.0],[38.0,44.0]]),eraHidden:false},
   {n:'Republic of Venice',sub:'697-1797 CE',la:45.44,ln:12.32,desc:'Maritime republic that dominated Mediterranean trade. Crusades (sacked Constantinople 1204). Venetian Arsenal, Grand Canal, St Mark\'s Basilica. Patron of Renaissance art (Titian, Tintoretto). Ended by Napoleon (1797).',fact:'Venetian Arsenal (shipbuilding) · 1204 Crusade sack of Constantinople · Marco Polo of Venice · Gondolas & canals · Doge\'s rule for 1,100 years',steps:[{year:697,label:'Foundation',la:45.44,ln:12.32,desc:'Paolo Lucio Anafesto is elected the first Doge of Venice, establishing the maritime republic that will dominate Mediterranean trade for a millennium.'},{year:1204,label:'Sack of Constantinople',la:41.01,ln:28.98,desc:'Venice diverts the Fourth Crusade to sack Constantinople, gaining vast territories and trading privileges that make Venice the supreme Mediterranean power.'},{year:1453,label:'Trade Decline',la:45.44,ln:12.32,desc:'The Ottoman conquest of Constantinople disrupts Venetian trade routes with the East, gradually undermining the republic\'s commercial supremacy.'},{year:1797,label:'Napoleon\'s Conquest',la:45.44,ln:12.32,desc:'Napoleon Bonaparte conquers Venice and forces the last Doge to abdicate, ending over a millennium of the Most Serene Republic\'s independence.'}],pts:territory([[46.0,12.0],[44.0,14.0],[42.0,12.0],[44.0,10.0],[46.0,10.0]]),eraHidden:false},
   {n:'Kushan Empire (World)',sub:'30-375 CE',la:34.01,ln:71.58,desc:'See Indian Kingdoms section. Kushans connected India to Central Asia & Rome. Kanishka the Great. Silk Road patrons. Gandharan art bridge between East & West.',fact:'Kanishka\'s realm from Central Asia to Varanasi · Gandharan Buddhist art · Silk Road prosperity · Gold coinage standard',steps:[{year:30,label:'Kujula Kadphises',la:34.01,ln:71.58,desc:'Kujula Kadphises unites the Yuezhi tribes and founds the Kushan Empire in Bactria, establishing a vast realm connecting China, India, and Rome.'},{year:127,label:'Kanishka the Great',la:34.01,ln:71.58,desc:'Emperor Kanishka I expands the empire to its greatest extent and becomes a great patron of Buddhism, convening the Fourth Buddhist Council.'},{year:375,label:'Sasanian Absorption',la:34.01,ln:71.58,desc:'The Kushan Empire fragments under pressure from the Sasanian Persians and the Gupta Empire, ending their role as Silk Road intermediaries.'}],pts:territory([[42.0,60.0],[40.0,64.0],[38.0,68.0],[36.0,72.0],[34.0,76.0],[32.0,72.0],[32.0,68.0],[34.0,64.0],[36.0,60.0],[38.0,56.0],[40.0,58.0]]),eraHidden:false},
   {n:'Khazar Khaganate',sub:'650-969 CE',la:45.00,ln:47.00,desc:'Turkic semi-nomadic empire between Caspian & Black Sea. Unique: elite converted to Judaism (8th c.). Controlled Silk Road routes. Rival of Arabs & Byzantines. Defeated by Kievan Rus.',fact:'Conversion to Judaism (~740 CE) · Itil capital · Silk Road toll masters · Arab-Byzantine trade · Kievan Rus\' destroyed Itil 969 CE',steps:[{year:650,label:'Khazar State',la:45.00,ln:47.00,desc:'The Khazars establish an independent khaganate north of the Caucasus, forming a powerful buffer state between the Byzantine and Arab empires.'},{year:740,label:'Conversion to Judaism',la:45.00,ln:47.00,desc:'The Khazar ruling elite converts to Judaism as a way to maintain neutrality between the Christian Byzantines and Muslim Arabs.'},{year:969,label:'Rus\' Invasion',la:45.00,ln:47.00,desc:'Kievan Rus prince Sviatoslav I sacks the Khazar capital Itil, destroying the khaganate and ending Khazar dominance of the Eurasian steppe.'}],pts:territory([[48.0,40.0],[46.0,44.0],[44.0,48.0],[42.0,46.0],[42.0,42.0],[44.0,38.0],[46.0,36.0],[48.0,38.0]]),eraHidden:false},
   {n:'Seljuk Empire',sub:'1037-1194 CE',la:39.15,ln:42.54,desc:'Great Seljuk Empire (Sunni Turkic). Defeated Byzantines at Manzikert (1071). Controlled Persia, Anatolia, Levant. Patron of Persian culture & architecture. Opposed Crusaders. Sultan Alp Arslan & Malik Shah.',fact:'Alp Arslan\'s Manzikert (1071) · Malik Shah\'s golden age · Nizam al-Mulk (vizier) founded Madrasa Nizamiyya · Persian literature & architecture · Decline from Crusades',steps:[{year:1037,label:'Tughril Beg',la:39.15,ln:42.54,desc:'Tughril Beg captures Nishapur and proclaims the Great Seljuk Empire, uniting the Turkic Oghuz tribes under Sunni Islamic leadership.'},{year:1071,label:'Manzikert',la:39.15,ln:42.54,desc:'Alp Arslan defeats the Byzantine army at Manzikert, capturing Emperor Romanos IV and opening Anatolia to Turkic settlement.'},{year:1092,label:'Malik Shah Dies',la:39.15,ln:42.54,desc:'Sultan Malik Shah and his vizier Nizam al-Mulk die within months of each other, plunging the Seljuk Empire into succession struggles.'},{year:1194,label:'Khwarezmian Conquest',la:39.15,ln:42.54,desc:'The last Great Seljuk sultan Toghrul III is defeated and killed by the Khwarezmian Empire, ending Seljuk rule in Persia.'}],pts:territory([[42.0,34.0],[40.0,38.0],[38.0,42.0],[36.0,46.0],[34.0,50.0],[36.0,54.0],[38.0,58.0],[40.0,54.0],[40.0,48.0],[40.0,42.0],[42.0,38.0],[44.0,34.0]]),eraHidden:false},
   {n:'Mamluk Sultanate',sub:'1250-1517 CE',la:30.04,ln:31.24,desc:'Mamluk (slave-soldier) dynasty of Egypt & Syria. Defeated Mongols at Ain Jalut (1260) — first Mongol defeat. Baybars, Qutuz, Qalawun great sultans. Ended Crusader states. Fell to Ottomans 1517.',fact:'Battle of Ain Jalut (1260) — first Mongol defeat · Baybars the great · Defeated Crusaders (Acre 1291) · Cairo capital · Military slave dynasty',steps:[{year:1250,label:'Mamluk Coup',la:30.04,ln:31.24,desc:'Mamluk generals assassinate the last Ayyubid sultan and seize power in Egypt, establishing a slave-soldier dynasty that dominates the Middle East.'},{year:1260,label:'Ain Jalut',la:30.04,ln:31.24,desc:'Sultan Qutuz and general Baybars defeat the Mongols at Ain Jalut in Palestine, the first major Mongol defeat in history.'},{year:1291,label:'Acre Captured',la:30.04,ln:31.24,desc:'Sultan al-Ashraf Khalil captures Acre, the last Crusader stronghold in the Holy Land, ending the Crusader states permanently.'},{year:1517,label:'Ottoman Conquest',la:30.04,ln:31.24,desc:'Sultan Selim I of the Ottoman Empire defeats the Mamluks at Marj Dabiq and conquers Cairo, ending the Mamluk Sultanate.'}],pts:territory([[36.0,30.0],[34.0,34.0],[32.0,38.0],[30.0,36.0],[28.0,32.0],[24.0,28.0],[22.0,32.0],[24.0,36.0],[28.0,38.0],[30.0,40.0],[32.0,34.0],[34.0,30.0]]),eraHidden:false},
   {n:'Viking Age Kingdoms',sub:'793-1066 CE',la:55.67,ln:12.57,desc:'Norse kingdoms of Scandinavia (Denmark, Norway, Sweden). Vikings raided, traded across Europe (to Byzantine & North America). Leif Erikson reached America ~1000 CE. Norman conquest of England 1066 ended Viking Age.',fact:'Leif Erikson (Vinland ~1000 CE) · Lindisfarne raid (793) · Runes & longships · Varangian Guard (Byzantium) · Norman descendants (William 1066)',steps:[{year:793,label:'Lindisfarne Raid',la:55.67,ln:12.57,desc:'Vikings raid the monastery at Lindisfarne in England, a shocking attack that marks the traditional beginning of the Viking Age in Europe.'},{year:1000,label:'Vinland',la:55.67,ln:12.57,desc:'Leif Erikson reaches Vinland in North America, becoming the first European to set foot on the American continent, nearly five centuries before Columbus.'},{year:1066,label:'Norman Conquest',la:55.67,ln:12.57,desc:'William the Conqueror, a descendant of Vikings, defeats Harold Godwinson at Hastings, ending the Viking Age by incorporating Scandinavia into European Christendom.'}],pts:territory([[70.0,5.0],[64.0,10.0],[60.0,12.0],[56.0,14.0],[56.0,10.0],[58.0,6.0],[62.0,4.0],[66.0,0.0],[70.0,-5.0]]),eraHidden:false},
   {n:'Sultanate of Zanzibar',sub:'1856-1964 CE',la:-6.17,ln:39.19,desc:'East African sultanate (Omani dynasty). Spice islands (clove, nutmeg). Slave trade hub. European colonization. Zanzibar Revolution (1964) unified with Tanganyika (Tanzania). Shortest war in history (Anglo-Zanzibar 1896 ~40 min).',fact:'Anglo-Zanzibar War (40 min — shortest in history) · Clove islands · Stone Town (UNESCO) · Slave market · Zanzibar Revolution 1964',steps:[{year:1856,label:'Independence',la:-6.17,ln:39.19,desc:'The Sultanate of Zanzibar is established after the death of Said bin Sultan, separating from Oman and becoming an independent sultanate.'},{year:1896,label:'Anglo-Zanzibar War',la:-6.17,ln:39.19,desc:'The shortest war in history erupts between Britain and Zanzibar, lasting only 40 minutes before the Sultan surrenders and is replaced by a British puppet.'},{year:1964,label:'Zanzibar Revolution',la:-6.17,ln:39.19,desc:'The Zanzibar Revolution overthrows the Sultanate and establishes a socialist government, which immediately merges with Tanganyika to form Tanzania.'}],pts:territory([[-4.0,38.0],[-6.0,40.0],[-8.0,38.0],[-6.0,36.0],[-4.0,38.0]]),eraHidden:false},
   {n:'Habsburg Monarchy',sub:'1282-1918 CE',la:48.21,ln:16.37,desc:'European ruling house. Ruled Austria, Hungary, Spain, Holy Roman Empire. Charles V (16th c.) — empire on which sun never set. Austro-Hungarian Empire (1867). Ended WWI (1918). Sarajevo 1914 started WWI.',fact:'Charles V (1519-1556) · Vienna & Schönbrunn Palace · Maria Theresa (1740-1780) · Franz Ferdinand assassination 1914 · Maximilian I\'s expansion',steps:[{year:1282,label:'Austria Acquired',la:48.21,ln:16.37,desc:'Rudolf I of Habsburg grants the Duchy of Austria to his sons, establishing the Habsburgs as a major European dynasty in Central Europe.'},{year:1519,label:'Charles V',la:48.21,ln:16.37,desc:'Charles V inherits an empire spanning Spain, Austria, the Low Countries, and the Americas, becoming the most powerful ruler in Europe.'},{year:1867,label:'Dual Monarchy',la:48.21,ln:16.37,desc:'The Austro-Hungarian Compromise creates the dual monarchy, giving Hungary equal status with Austria and forming the Austro-Hungarian Empire.'},{year:1918,label:'Monarchy Dissolved',la:48.21,ln:16.37,desc:'After defeat in World War I, the last Habsburg emperor Charles I abdicates, ending over six centuries of Habsburg rule in Europe.'}],pts:territory([[52.0,10.0],[50.0,14.0],[48.0,18.0],[46.0,22.0],[44.0,20.0],[42.0,16.0],[44.0,12.0],[46.0,10.0],[48.0,8.0],[50.0,8.0]]),eraHidden:false},
      {n:'Siam (Rattanakosin)',sub:'1782-1932 CE',la:13.75,ln:100.50,desc:'Kingdom of Thailand (Chakri dynasty). Only SE Asian state never colonized. King Mongkut & Chulalongkorn modernized. Bangkok\'s Grand Palace. Ayutthaya legacy. Constitutional monarchy 1932.',fact:'Only SE Asian state never colonized · King Chulalongkorn (Rama V) abolished slavery 1905 · Grand Palace Bangkok · Ayutthaya kingdom before · Democracy 1932',steps:[{year:1782,label:'Chakri Dynasty',la:13.75,ln:100.50,desc:'Rama I founds the Chakri dynasty and establishes Bangkok as the new capital, building the Grand Palace and shifting the center of Siamese power.'},{year:1851,label:'King Mongkut',la:13.75,ln:100.50,desc:'King Mongkut (Rama IV) ascends the throne and begins modernizing Siam through diplomacy, science, and trade with Western powers.'},{year:1905,label:'Slavery Abolished',la:13.75,ln:100.50,desc:'King Chulalongkorn (Rama V) abolishes slavery in Siam, continuing his father\'s reforms and modernizing the kingdom to avoid colonization.'},{year:1932,label:'Constitutional Monarchy',la:13.75,ln:100.50,desc:'A bloodless revolution forces King Prajadhipok (Rama VII) to accept a constitution, ending absolute monarchy and establishing a constitutional monarchy.'}],pts:territory([[20.0,98.0],[18.0,104.0],[16.0,106.0],[14.0,104.0],[12.0,102.0],[10.0,100.0],[8.0,98.0],[10.0,96.0],[14.0,96.0],[18.0,94.0]]),eraHidden:false},
   {n:'Austro-Hungarian Empire',sub:'1867-1918 CE',la:48.21,ln:16.37,desc:'Dual monarchy of Austria-Hungary. Second largest European empire (after Russia). Franz Joseph I ruled 68 years. Multi-ethnic state (12 nationalities). Annexed Bosnia 1908. Assassination of Franz Ferdinand at Sarajevo 1914 triggered WWI. Dissolved 1918 after defeat.',fact:'Dual monarchy (1867) · Franz Joseph I (1848-1916) · 12 nationalities · Sarajevo 1914 · Schönbrunn Palace · Vienna & Budapest capitals',steps:[{year:1867,label:'Ausgleich',la:48.21,ln:16.37,desc:'The Austro-Hungarian Compromise creates the dual monarchy, granting Hungary equality with Austria and establishing the Austro-Hungarian Empire.'},{year:1908,label:'Bosnia Annexed',la:43.85,ln:18.36,desc:'Austria-Hungary officially annexes Bosnia and Herzegovina, inflaming tensions with Serbia and Russia in the Balkan powder keg.'},{year:1914,label:'Sarajevo Assassination',la:43.86,ln:18.42,desc:'Gavrilo Princip assassinates Archduke Franz Ferdinand in Sarajevo, triggering the July Crisis and the outbreak of World War I.'},{year:1918,label:'Empire Dissolved',la:48.21,ln:16.37,desc:'After military defeat, Emperor Karl I abdicates and the empire dissolves into Austria, Hungary, Czechoslovakia, and other successor states.'}],pts:territory([[50.0,12.0],[48.0,16.0],[46.0,20.0],[44.0,24.0],[42.0,22.0],[40.0,20.0],[42.0,16.0],[44.0,14.0],[46.0,12.0],[48.0,10.0]]),eraHidden:false},
   {n:'Aksumite Empire',sub:'100-940 CE',la:14.13,ln:38.72,desc:'Ancient Ethiopian empire. Major Red Sea power. Ezana converted to Christianity (330 CE). Obelisks of Axum (UNESCO). Rival of Persia, Rome. Legendary Queen of Sheba connection. Kept the Ark of the Covenant (tradition).',fact:'Ezana (330 CE Christian king) · Axum obelisks · Queen of Sheba legend · Ark of Covenant tradition · Red Sea trade empire · Ge\'ez script',steps:[{year:100,label:'Aksum Rise',la:14.13,ln:38.72,desc:'Aksum emerges as a major trading nation in the Horn of Africa, connecting the Roman Empire with India through the Red Sea port of Adulis.'},{year:330,label:'Christian Conversion',la:14.13,ln:38.72,desc:'King Ezana embraces Christianity, making Aksum one of the earliest Christian states and establishing the Ethiopian Orthodox Church.'},{year:940,label:'Decline',la:14.13,ln:38.72,desc:'The Aksumite Empire collapses under economic pressure and the rise of competing powers, but leaves a lasting Christian legacy in Ethiopia.'}],pts:territory([[18.0,36.0],[16.0,38.0],[14.0,40.0],[12.0,42.0],[10.0,44.0],[10.0,40.0],[12.0,36.0],[14.0,34.0],[16.0,34.0]]),eraHidden:false},
   {n:'Ghana Empire',sub:'300-1240 CE',la:15.50,ln:-9.50,desc:'First great West African empire. "Land of Gold." Controlled trans-Saharan gold trade. Koumbi Saleh capital. Dual capital system (Muslim & pagan). Almoravid attack weakened it. Sundiata annexed to Mali.',fact:'Gold trade empire · Koumbi Saleh (capital) · "Ghana" means war chief · 200,000-man army · Almoravid invasion 1076',steps:[{year:300,label:'Emergence',la:15.50,ln:-9.50,desc:'The Ghana Empire emerges among the Soninke people in the Sahel, controlling the lucrative trans-Saharan gold and salt trade routes.'},{year:1076,label:'Almoravid Attack',la:15.50,ln:-9.50,desc:'The Almoravids from the north invade Ghana, sacking Koumbi Saleh and fracturing the empire\'s power and trade monopoly.'},{year:1240,label:'Mali Conquest',la:15.50,ln:-9.50,desc:'Sundiata Keita of the expanding Mali Empire conquers the remnants of Ghana, incorporating its lands and trade networks.'}],pts:territory([[18.0,-12.0],[16.0,-10.0],[14.0,-8.0],[12.0,-6.0],[12.0,-4.0],[14.0,-2.0],[16.0,-4.0],[18.0,-6.0],[20.0,-8.0]]),eraHidden:false},
   {n:'Oyo Empire',sub:'1300-1896 CE',la:8.00,ln:4.00,desc:'Powerful Yoruba empire in present-day Nigeria. Oyo Mesi (council of chiefs) checked the Alaafin (king). Cavalry-based army. Controlled Dahomey (Benin). Major slave trade participant. Collapsed in civil wars 19th c.',fact:'Yoruba empire · Alaafin of Oyo · Oyo Mesi council · Cavalry army · Controlled Dahomey · 19th century civil war collapse',steps:[{year:1300,label:'Formation',la:8.00,ln:4.00,desc:'The Oyo Empire is established by the Yoruba people in the savanna region north of the forest, gradually becoming the most powerful state in the region.'},{year:1724,label:'Dahomey Conquest',la:8.00,ln:4.00,desc:'Oyo conquers the Kingdom of Dahomey and forces it to pay tribute, extending Oyo control to the Atlantic coast and the slave trade.'},{year:1896,label:'British Absorption',la:8.00,ln:4.00,desc:'The last Alaafin signs a protectorate treaty with the British, ending Oyo sovereignty and absorbing the empire into the colony of Nigeria.'}],pts:territory([[10.0,2.0],[8.0,4.0],[6.0,6.0],[4.0,4.0],[4.0,2.0],[6.0,0.0],[8.0,-2.0]]),eraHidden:false},
   {n:'Ashanti Empire',sub:'1670-1902 CE',la:6.70,ln:-1.60,desc:'Powerful Akan empire in modern Ghana. Golden Stool (soul of the nation). Asantehene monarch. Wealth from gold and slave trade. Resisted British in 4 Anglo-Ashanti wars. Yaa Asantewaa led last war (1900).',fact:'Golden Stool (sacred symbol) · Asantehene · Osei Tutu founder · Yaa Asantewaa War 1900 · Gold coast wealth · Kumasi capital',steps:[{year:1670,label:'Osei Tutu',la:6.70,ln:-1.60,desc:'Osei Tutu I unifies the Ashanti states and establishes the empire with the Golden Stool as the divine symbol of Ashanti nationhood.'},{year:1824,label:'Battle of Nsamankow',la:6.70,ln:-1.60,desc:'Ashanti forces defeat a British army, killing Governor Sir Charles MacCarthy, whose skull becomes a royal drinking cup.'},{year:1902,label:'British Annexation',la:6.70,ln:-1.60,desc:'After the War of the Golden Stool and the rebellion led by Yaa Asantewaa, Britain annexes Ashanti as a crown colony.'}],pts:territory([[8.0,-4.0],[6.0,-2.0],[4.0,0.0],[4.0,-2.0],[5.0,-4.0],[6.0,-6.0]]),eraHidden:false},
   {n:'Tokugawa Shogunate',sub:'1603-1868 CE',la:35.68,ln:139.69,desc:'Last feudal Japanese military government. Tokugawa Ieyasu unified Japan. Edo (Tokyo) capital. Sakoku isolation policy (closed country 1639-1853). 250 years of peace & stability. Social hierarchy: samurai, farmer, artisan, merchant. Ended by Meiji Restoration.',fact:'Edo period (1603-1868) · Sakoku isolation · 250 years peace · Samurai code (Bushido) · Kabuki & ukiyo-e · Perry\'s Black Ships (1853) opened Japan',steps:[{year:1603,label:'Tokugawa Shogunate',la:35.68,ln:139.69,desc:'Tokugawa Ieyasu is appointed shogun, establishing the Tokugawa shogunate with its capital at Edo (Tokyo) and unifying Japan after centuries of civil war.'},{year:1639,label:'Sakoku Isolation',la:35.68,ln:139.69,desc:'The shogunate enacts the Sakoku policy, closing Japan to almost all foreign contact and trade, except for limited Dutch access at Nagasaki.'},{year:1853,label:'Perry Expedition',la:35.68,ln:139.69,desc:'Commodore Matthew Perry\'s Black Ships arrive in Edo Bay, forcing Japan to open to foreign trade and ending over two centuries of isolation.'},{year:1868,label:'Meiji Restoration',la:35.68,ln:139.69,desc:'Emperor Meiji is restored to power after the Boshin War, ending the Tokugawa shogunate and beginning Japan\'s rapid modernization.'}],pts:territory([[46.0,138.0],[42.0,142.0],[38.0,140.0],[34.0,136.0],[34.0,132.0],[36.0,130.0],[38.0,126.0],[40.0,128.0],[44.0,136.0]]),eraHidden:false},
   {n:'Joseon Dynasty',sub:'1392-1910 CE',la:37.57,ln:126.98,desc:'Korean dynasty lasting 518 years. Founded by Yi Seong-gye. Neo-Confucian state. Hangeul alphabet invented by Sejong the Great (1443). Imjin War (Japanese invasion 1592-98). Lasted until Japanese annexation (1910).',fact:'Sejong the Great (Hangeul 1443) · Neo-Confucian capital Hanyang (Seoul) · Imjin War 1592-98 · Joseon white porcelain · Yi Sun-sin\'s turtle ships · 518 year dynasty',steps:[{year:1392,label:'Dynasty Founded',la:37.57,ln:126.98,desc:'Yi Seong-gye overthrows the Goryeo dynasty and establishes the Joseon Dynasty, moving the capital to Hanyang (modern Seoul).'},{year:1443,label:'Hangeul Created',la:37.57,ln:126.98,desc:'King Sejong the Great invents Hangeul, the Korean alphabet, to promote literacy among commoners who could not read Chinese characters.'},{year:1592,label:'Imjin War',la:37.57,ln:126.98,desc:'Toyotomi Hideyoshi invades Korea with 160,000 Japanese troops, but Admiral Yi Sun-sin\'s turtle ships and Ming Chinese forces repel the invasion.'},{year:1910,label:'Japanese Annexation',la:37.57,ln:126.98,desc:'Japan formally annexes Korea through the Japan-Korea Treaty, ending the 518-year Joseon Dynasty and beginning 35 years of colonial rule.'}],pts:territory([[42.0,124.0],[40.0,128.0],[38.0,130.0],[36.0,128.0],[34.0,126.0],[34.0,124.0],[36.0,122.0],[38.0,122.0],[40.0,122.0]]),eraHidden:false},
   {n:'Delhi Sultanate',sub:'1206-1526 CE',la:28.61,ln:77.23,desc:'Five Islamic dynasties ruling North India from Delhi. Slave, Khalji, Tughlaq, Sayyid, Lodi dynasties. Alauddin Khalji\'s expansion. Tughlaqabad fort. Ibn Battuta visited. Defeated by Babur at Panipat (1526).',fact:'5 dynasties (1206-1526) · Alauddin Khalji (market reforms) · Muhammad bin Tughlaq (capital shift) · Ibn Battuta visited · Babur ended at Panipat 1526 · Qutb Minar built',steps:[{year:1206,label:'Slave Dynasty',la:28.61,ln:77.23,desc:'Qutb-ud-din Aibak, a former slave general, establishes the Delhi Sultanate as the first Muslim kingdom to rule northern India.'},{year:1296,label:'Alauddin Khalji',la:28.61,ln:77.23,desc:'Alauddin Khalji becomes sultan and expands the Delhi Sultanate to its greatest extent, conquering Gujarat, Rajasthan, and the Deccan.'},{year:1398,label:'Timur Sack',la:28.61,ln:77.23,desc:'Timur sacks Delhi, massacring tens of thousands and crippling the Delhi Sultanate from which it never fully recovers.'},{year:1526,label:'Babur\'s Conquest',la:28.61,ln:77.23,desc:'Babur defeats Ibrahim Lodi at the First Battle of Panipat using gunpowder and cannons, ending the Delhi Sultanate and founding the Mughal Empire.'}],pts:territory([[32.0,72.0],[30.0,76.0],[28.0,80.0],[26.0,84.0],[24.0,82.0],[22.0,78.0],[22.0,74.0],[24.0,70.0],[28.0,68.0],[30.0,70.0]]),eraHidden:false}
];
D.w_city = [
  {n:'Washington DC',la:38.91,ln:-77.04,sub:'USA · Capital',desc:'Capital of United States. White House, Capitol Hill, Supreme Court, Pentagon. Designed by Pierre L\'Enfant (1791).',fact:'Federal district · Smithsonian museums · National Mall · Cherry blossoms'},
  {n:'London',la:51.51,ln:-0.13,sub:'UK · Capital',desc:'Capital of UK. Houses of Parliament, Buckingham Palace, Tower of London, Big Ben, Thames River. Global financial hub.',fact:'Oldest metro (1863) · City of London financial district · Greenwich Mean Time'},
  {n:'Paris',la:48.86,ln:2.35,sub:'France · Capital',desc:'Capital of France. Eiffel Tower (1889), Louvre Museum, Notre-Dame, Arc de Triomphe. Global fashion & culture hub.',fact:'City of Light · 20 arrondissements · Seine River · Most visited city globally'},
  {n:'Tokyo',la:35.68,ln:139.69,sub:'Japan · Capital',desc:'Capital of Japan. Largest metro economy globally. Shibuya, Shinjuku, Imperial Palace, Meiji Shrine, Tsukiji.',fact:'World\'s largest metro area (37M+) · Shinkansen bullet train · Cherry blossoms'},
  {n:'Beijing',la:39.90,ln:116.41,sub:'China · Capital',desc:'Capital of China. Forbidden City, Tiananmen Square, Great Wall. Hosted 2008 & 2022 Olympics. Political & cultural centre.',fact:'15M+ population · Hutongs · Peking Man site · Oldest continuous civilization'},
  {n:'Moscow',la:55.76,ln:37.62,sub:'Russia · Capital',desc:'Capital of Russia. Kremlin, Red Square, St Basil\'s Cathedral. Largest country by area. Political & cultural hub.',fact:'Moscow metro (art) · Bolshoi Theatre · 7 Stalinist skyscrapers'},
  {n:'Berlin',la:52.52,ln:13.41,sub:'Germany · Capital',desc:'Capital of Germany. Brandenburg Gate, Reichstag, Berlin Wall memorial. Reunified 1990. Cultural & tech hub.',fact:'Berlin Wall fell 1989 · Museum Island (UNESCO) · 3 opera houses'},
  {n:'Rome',la:41.90,ln:12.50,sub:'Italy · Capital',desc:'Capital of Italy. Colosseum, Vatican City, Roman Forum, Trevi Fountain. Ancient Roman Empire centre. UNESCO city.',fact:'2,500+ years old · Vatican City (smallest country) · 280+ fountains'},
  {n:'Cairo',la:30.04,ln:31.24,sub:'Egypt · Capital',desc:'Capital of Egypt. Pyramids of Giza, Sphinx, Egyptian Museum, Nile River. Largest city in Africa & Arab world.',fact:'Pyramids last ancient Wonder standing · Al-Azhar University (970 CE) · Khan el-Khalili'},
  {n:'Canberra',la:-35.28,ln:149.13,sub:'Australia · Capital',desc:'Capital of Australia. Parliament House, Australian War Memorial, Lake Burley Griffin. Designed by Walter Burley Griffin.',fact:'Planned capital · National Gallery · Floriade festival'},
  {n:'Brasilia',la:-15.79,ln:-47.88,sub:'Brazil · Capital',desc:'Capital of Brazil. Planned city by Oscar Niemeyer & Lúcio Costa (1960). UNESCO WHS. Modernist architecture.',fact:'Completed 41 months · Designed as aeroplane shape · Pilot Plan layout'},
  {n:'Ottawa',la:45.42,ln:-75.70,sub:'Canada · Capital',desc:'Capital of Canada. Parliament Hill, Rideau Canal, National Gallery. Rideau Canal (UNESCO). Bilingual city.',fact:'Largest skating rink (Rideau) · ByWard Market · Peace Tower'},
  {n:'Buenos Aires',la:-34.60,ln:-58.38,sub:'Argentina · Capital',desc:'Capital of Argentina. Tango, steak, Recoleta Cemetery, Casa Rosada. European-style architecture.',fact:'La Boca colourful neighbourhood · Obelisco · Teatro Colón (opera)'},
  {n:'Seoul',la:37.57,ln:126.98,sub:'South Korea · Capital',desc:'Capital of South Korea. Gyeongbokgung, N Seoul Tower, Gangnam district. K-pop & tech hub. DMZ nearby.',fact:'World\'s fastest internet · 10M+ population · 5G & AI pioneer'},
  {n:'Bangkok',la:13.76,ln:100.50,sub:'Thailand · Capital',desc:'Capital of Thailand. Grand Palace, Wat Pho, floating markets, street food. Most visited city in SEA.',fact:'Temple of Emerald Buddha · 40M+ annual visitors · Chao Phraya river'},
  {n:'Singapore',la:1.35,ln:103.82,sub:'Singapore · City-State',desc:'City-state & global financial hub. Marina Bay Sands, Gardens by the Bay, Sentosa. 4 official languages.',fact:'World\'s busiest port · Lee Kuan Yew\'s vision · 63 islands · Merlion'},
  {n:'Dubai',la:25.20,ln:55.27,sub:'UAE · Largest city',desc:'Largest city in UAE. Burj Khalifa (tallest in world, 828m), Palm Islands, Dubai Mall. Global business hub.',fact:'Burj Khalifa 828m · Man-made islands · Gold & spice souks · 7-star hotel'},
  {n:'Riyadh',la:24.71,ln:46.68,sub:'Saudi Arabia · Capital',desc:'Capital of Saudi Arabia. Kingdom Centre, Masmak Fortress. Largest city in Saudi. Oil & finance hub.',fact:'NEOM mega-city project · King Abdullah financial district'},
  {n:'Tehran',la:35.69,ln:51.39,sub:'Iran · Capital',desc:'Capital of Iran. Azadi Tower, Golestan Palace, Milad Tower. Major cultural & political centre of Middle East.',fact:'Tehran metro · Mount Tochal · Bazaar Grand'},
  {n:'Ankara',la:39.93,ln:32.86,sub:'Turkey · Capital',desc:'Capital of Turkey. Anıtkabir (Atatürk\'s mausoleum), Ankara Castle. Planned as capital by Atatürk (1923).',fact:'Hittite museum · Oldest settlements · 2nd largest city in Turkey'},
  {n:'Istanbul',la:41.01,ln:28.98,sub:'Turkey · Largest city',desc:'Largest city in Turkey. Hagia Sophia, Blue Mosque, Topkapi Palace. Only city spanning Europe & Asia.',fact:'Formerly Constantinople · Bosphorus strait · 15M+ population'},
  {n:'Jerusalem',la:31.77,ln:35.22,sub:'Israel · Claimed capital',desc:'Holy city for Judaism, Christianity, Islam. Western Wall, Church of Holy Sepulchre, Dome of the Rock.',fact:'Old City walls · Via Dolorosa · Temple Mount · 4000+ years history'},
  {n:'Nairobi',la:-1.29,ln:36.82,sub:'Kenya · Capital',desc:'Capital of Kenya. Nairobi National Park (wildlife near city). UN Office. East African hub.',fact:'Green City in Sun · Maasai Market · Giraffe Centre'},
  {n:'Cape Town',la:-33.93,ln:18.42,sub:'South Africa · Legislative capital',desc:'Legislative capital of SA. Table Mountain, Robben Island, Cape of Good Hope. Most beautiful city in Africa.',fact:'Table Mountain 1,086m · Cape Winelands · Boulders Beach penguins'},
  {n:'Mexico City',la:19.43,ln:-99.13,sub:'Mexico · Capital',desc:'Capital of Mexico. Ancient Aztec Tenochtitlan. Zócalo, Frida Kahlo Museum, floating gardens of Xochimilco.',fact:'20M+ metro · Built on lake · 68+ indigenous languages · UNESCO centre'},
  {n:'New York City',la:40.71,ln:-74.01,sub:'USA · Largest city',desc:'Largest US city. Statue of Liberty, Times Square, Central Park, Broadway, Wall Street. UN HQ. Global financial capital.',fact:'World\'s #1 financial centre · 5 boroughs · Ellis Island · 800+ languages spoken'},
  {n:'Los Angeles',la:34.05,ln:-118.24,sub:'USA · Entertainment capital',desc:'Second-largest US city. Hollywood, Beverly Hills, Santa Monica. Global entertainment & film industry hub.',fact:'Hollywood sign · Disneyland · 9M+ metro · Diverse & multicultural'},
  {n:'Shanghai',la:31.23,ln:121.47,sub:'China · Largest city',desc:'Largest city in China. The Bund, Oriental Pearl Tower, Pudong skyline. Global financial centre.',fact:'26M+ population · Fastest train (Maglev 431 km/h) · Huangpu river'},
  {n:'Sydney',la:-33.87,ln:151.21,sub:'Australia · Largest city',desc:'Largest city in Australia. Opera House (UNESCO), Harbour Bridge, Bondi Beach. 2000 Olympics host.',fact:'Opera House roof = sail design · Harbour Bridge 1932 · Taronga Zoo'},
  {n:'Rio de Janeiro',la:-22.91,ln:-43.17,sub:'Brazil · Cultural capital',desc:'Famous for Christ the Redeemer, Sugarloaf Mountain, Copacabana beach, Carnival. Hosted 2016 Olympics.',fact:'Christ statue 38m tall · Sambódromo · Tijuca rainforest (largest urban forest)'},
  {n:'Toronto',la:43.65,ln:-79.38,sub:'Canada · Largest city',desc:'Largest city in Canada. CN Tower, Royal Ontario Museum, Distillery District. Global banking hub.',fact:'CN Tower 553m · Multicultural (180+ languages) · Maple Leafs'},
  {n:'Chicago',la:41.88,ln:-87.63,sub:'USA · Third-largest city',desc:'Third-largest US city. Willis Tower (formerly Sears), Navy Pier, deep-dish pizza, blues & jazz.',fact:'First skyscraper (Home Insurance 1885) · Lake Michigan · O\'Hare airport'},
  {n:'San Francisco',la:37.77,ln:-122.42,sub:'USA · Tech capital',desc:'Global tech hub. Golden Gate Bridge, Alcatraz, Silicon Valley nearby. Cable cars. Fog city.',fact:'Golden Gate 1937 · Tech boom hub · 1906 earthquake · Fisherman\'s Wharf'},
  {n:'Karachi',la:24.86,ln:67.01,sub:'Pakistan · Largest city',desc:'Largest city and financial hub of Pakistan. Port city on Arabian Sea. Former capital (1947-1959).',fact:'Quaid-e-Azam\'s mausoleum · 15M+ population · Textile industry'},
  {n:'Lahore',la:31.55,ln:74.36,sub:'Pakistan · Cultural capital',desc:'Second-largest city. Badshahi Mosque, Lahore Fort (UNESCO), Shalimar Gardens. Cultural heart of Pakistan.',fact:'Basant kite festival · Food street · 12 gates of Walled City'},
  {n:'Dhaka',la:23.81,ln:90.41,sub:'Bangladesh · Capital',desc:'Capital of Bangladesh. Largest city in Bengal delta. World\'s densest major city. Rickshaw capital.',fact:'600,000+ rickshaws · Garment industry capital · Sundarbans nearby'},
  {n:'Kathmandu',la:27.72,ln:85.32,sub:'Nepal · Capital',desc:'Capital of Nepal. Gateway to Himalayas. Durbar Square, Swayambhunath (Monkey Temple), Pashupatinath.',fact:'7 UNESCO WHS sites within valley · Lukla airport to Everest'},
  {n:'Colombo',la:6.93,ln:79.84,sub:'Sri Lanka · Capital',desc:'Commercial capital of Sri Lanka. Port city. Galle Face Green, Gangaramaya Temple, Pettah market.',fact:'Sri Jayawardenepura Kotte is official capital · Cinnamon & tea trade'},
  {n:'Kabul',la:34.56,ln:69.21,sub:'Afghanistan · Capital',desc:'Capital of Afghanistan. Over 3500 years old. Gardens of Babur, Kabul Museum. Historical Silk Road city.',fact:'Ancient Gandhara region · Bamiyan Buddhas (destroyed 2001)'},
  {n:'Rangoon (Yangon)',la:16.84,ln:96.13,sub:'Myanmar · Former capital',desc:'Largest city in Myanmar. Shwedagon Pagoda (99m gilded stupa). Colonial architecture. Yangon River.',fact:'Shwedagon 2500+ years old · Hledan Centre · Mergui Archipelago'},
  {n:'Phnom Penh',la:11.56,ln:104.92,sub:'Cambodia · Capital',desc:'Capital of Cambodia. Royal Palace, Silver Pagoda, Tuol Sleng Genocide Museum. Mekong & Tonlé Sap rivers.',fact:'Killing fields memorial · Angkor Wat nearby · French colonial architecture'},
  {n:'Vientiane',la:17.97,ln:102.62,sub:'Laos · Capital',desc:'Capital of Laos. Pha That Luang (golden stupa), Patuxai Arch. On Mekong River. French colonial charm.',fact:'That Luang national symbol · Buddha Park · Beerlao'},
  {n:'Hanoi',la:21.03,ln:105.85,sub:'Vietnam · Capital',desc:'Capital of Vietnam. Ho Chi Minh Mausoleum, Old Quarter, Temple of Literature. 1000+ years old.',fact:'First university (1076) · Pho & street food · Hoan Kiem Lake'},
  {n:'Ho Chi Minh City',la:10.78,ln:106.70,sub:'Vietnam · Largest city',desc:'Largest city in Vietnam. Former Saigon. Ben Thanh Market, Cu Chi Tunnels. Economic powerhouse.',fact:'9M+ population · French colonial landmarks · Motorbike capital'},
  {n:'Kuala Lumpur',la:3.14,ln:101.69,sub:'Malaysia · Capital',desc:'Capital of Malaysia. Petronas Twin Towers (451m), Batu Caves, KL Tower. Multicultural hub.',fact:'Petronas tallest 1998-2004 · Batu Caves Hindu shrine · Nasi lemak'},
  {n:'Jakarta',la:-6.21,ln:106.85,sub:'Indonesia · Capital',desc:'Capital of Indonesia. 10M+ population. Kota Tua (Old Town), National Monument. Sinking into Java Sea.',fact:'New capital Nusantara being built · Sunda Kelapa old port'},
  {n:'Manila',la:14.60,ln:120.98,sub:'Philippines · Capital',desc:'Capital of Philippines. Intramuros (walled city), Rizal Park, Manila Bay sunset. 13M+ metro.',fact:'Oldest Chinatown (Binondo) · Jeepneys · Tagalog & Spanish mix'},
  {n:'Taipei',la:25.03,ln:121.57,sub:'Taiwan · Capital',desc:'Capital of Taiwan. Taipei 101 (508m), National Palace Museum, night markets. Tech hub.',fact:'Taipei 101 tallest 2004-2010 · Bubble tea origin · Chiang Kai-shek hall'},
  {n:'Hong Kong',la:22.32,ln:114.17,sub:'China · Special Region',desc:'Global financial hub. Victoria Harbour, The Peak, Disneyland, dim sum. Former British colony (1997).',fact:'7.5M population · Skyscraper capital · Airport Express · Star Ferry'},
  {n:'Lisbon',la:38.72,ln:-9.14,sub:'Portugal · Capital',desc:'Capital of Portugal. Belém Tower, Jerónimos Monastery, tiled facades. Global Age of Discovery hub.',fact:'Vasco da Gama bridge · Oldest city in Europe (pre-Roman) · Lisbon metro'},
  {n:'Madrid',la:40.42,ln:-3.70,sub:'Spain · Capital',desc:'Capital of Spain. Prado Museum, Royal Palace, Retiro Park. Global art & culture hub.',fact:'Plaza Mayor · Real Madrid football · Tapas & flamenco'},
  {n:'Barcelona',la:41.39,ln:2.17,sub:'Spain · Cultural capital',desc:'Sagrada Familia (Gaudí), Gothic Quarter, Camp Nou, La Boqueria. Mediterranean coast. 1992 Olympics.',fact:'Sagrada Familia under construction since 1882 · Catalan culture'},
  {n:'Vienna',la:48.21,ln:16.37,sub:'Austria · Capital',desc:'Capital of Austria. Schönbrunn Palace, St Stephen\'s Cathedral, Wiener Schnitzel. Classical music capital.',fact:'UNESCO city · Danube River · Freud & Mozart lived here'},
  {n:'Prague',la:50.08,ln:14.42,sub:'Czech Republic · Capital',desc:'Capital of Czechia. Charles Bridge, Prague Castle, Old Town Square. Best-preserved medieval city.',fact:'Astronomical Clock 1410 · Castle largest in world · Beer culture'},
  {n:'Warsaw',la:52.23,ln:21.01,sub:'Poland · Capital',desc:'Capital of Poland. Old Town (rebuilt after WWII, UNESCO). Palace of Culture. Resilient city.',fact:'90% destroyed in WWII · Vistula River · Chopin\'s birthplace'},
  {n:'Budapest',la:47.50,ln:19.04,sub:'Hungary · Capital',desc:'Capital of Hungary. Chain Bridge, Parliament, Buda Castle. Thermal bath capital. Divided by Danube.',fact:'106 years as one city (Buda+Pest) · Széchenyi baths · Paprika'},
  {n:'Stockholm',la:59.33,ln:18.07,sub:'Sweden · Capital',desc:'Capital of Sweden. 14 islands. Gamla Stan (old town), Vasa Museum, ABBA Museum. Nobel Prize ceremony.',fact:'Vasa ship (1628) · Nobel Museum · Archipelago of 30,000 islands'},
  {n:'Oslo',la:59.91,ln:10.75,sub:'Norway · Capital',desc:'Capital of Norway. Viking Ship Museum, Oslo Opera House, Holmenkollen. Fram Museum. Fjord city.',fact:'Nobel Peace Prize · Scream by Munch · Midnight sun in summer'},
  {n:'Copenhagen',la:55.68,ln:12.57,sub:'Denmark · Capital',desc:'Capital of Denmark. Tivoli Gardens, Little Mermaid, Nyhavn Harbour. World\'s happiest country.',fact:'Øresund Bridge to Sweden · LEGO origin · Bicycle capital'},
  {n:'Helsinki',la:60.17,ln:24.94,sub:'Finland · Capital',desc:'Capital of Finland. Helsinki Cathedral, Suomenlinna Fortress (UNESCO), design district. Archipelago.',fact:'Suomenlinna 1748 · Design capital · Sauna culture · Northern Lights'},
  {n:'Reykjavik',la:64.15,ln:-21.82,sub:'Iceland · Capital',desc:'Capital of Iceland. Hallgrímskirkja church, Blue Lagoon, Northern Lights, geothermal pools. Fire & ice.',fact:'Geothermal energy · No mosquitoes · Midnight sun · Volcanic landscape'},
  {n:'Athens',la:37.98,ln:23.73,sub:'Greece · Capital',desc:'Capital of Greece. Acropolis, Parthenon, Plaka, Syntagma Square. Birthplace of democracy & Western philosophy.',fact:'Acropolis 5th century BC · Olympic Games origin · 3000+ years history'},
  {n:'Amsterdam',la:52.37,ln:4.90,sub:'Netherlands · Capital',desc:'Capital of Netherlands. Canals, Anne Frank House, Van Gogh Museum, Rijksmuseum. Bicycle & tulip city.',fact:'165 canals · 90+ islands · Coffee shops · Red Light District'},
  {n:'Brussels',la:50.85,ln:4.35,sub:'Belgium · Capital',desc:'Capital of Belgium & EU HQ. Grand Place (UNESCO), Manneken Pis, Atomium, waffles, chocolate & beer.',fact:'EU & NATO HQ · 1700+ beers · Comic strip murals'},
  {n:'Zurich',la:47.38,ln:8.54,sub:'Switzerland · Largest city',desc:'Largest city in Switzerland. Banking hub. Lake Zurich, Old Town. World\'s highest quality of life.',fact:'UBS & Credit Suisse · Swiss Alps views · FIFA HQ · Fondue'},
  {n:'Geneva',la:46.20,ln:6.14,sub:'Switzerland · Diplomatic hub',desc:'UN & Red Cross HQ. Jet d\'Eau fountain, Lake Geneva, Mont Blanc views. Global diplomacy capital.',fact:'UN Office (Palais des Nations) · CERN nearby · Watch industry'},
  {n:'Dublin',la:53.35,ln:-6.26,sub:'Ireland · Capital',desc:'Capital of Ireland. Trinity College (Book of Kells), Guinness Storehouse, Temple Bar. Tech EU HQ hub.',fact:'Google/Facebook EU base · St Patrick\'s Day · Cliffs of Moher'},
  {n:'Edinburgh',la:55.95,ln:-3.19,sub:'Scotland · Capital',desc:'Capital of Scotland. Edinburgh Castle, Arthur\'s Seat, Royal Mile. UNESCO Old & New Town. Festival city.',fact:'Fringe festival world\'s largest · Scotch whisky · Loch Ness nearby'},
  {n:'Bern',la:46.95,ln:7.45,sub:'Switzerland · Capital',desc:'Capital of Switzerland. Zytglogge (medieval clock), Einstein\'s house, Aare River. UNESCO Old Town.',fact:'Einstein developed relativity here · 6 km of arcades · Bear Park'},
  {n:'Lima',la:-12.05,ln:-77.04,sub:'Peru · Capital',desc:'Capital of Peru. Plaza Mayor, Larco Museum, Miraflores. Gastronomic capital of Latin America.',fact:'Ceviche origin · 10M+ population · Huaca Pucllana pyramid'},
  {n:'Bogota',la:4.71,ln:-74.07,sub:'Colombia · Capital',desc:'Capital of Colombia. Gold Museum, Monserrate, La Candelaria. High altitude (2600m). Cultural hub.',fact:'Altitude 2640m · Gabriel García Márquez · Salt Cathedral of Zipaquirá'},
  {n:'Santiago',la:-33.45,ln:-70.67,sub:'Chile · Capital',desc:'Capital of Chile. Plaza de Armas, San Cristóbal Hill, Andes backdrop. Wine region.',fact:'Andes views · Neruda\'s houses · Easter Island (Rapa Nui)'},
  {n:'Havana',la:23.12,ln:-82.38,sub:'Cuba · Capital',desc:'Capital of Cuba. Malecón seafront, Old Havana (UNESCO), classic cars, cigar & rum culture.',fact:'1950s classic cars · Fidel Castro\'s revolution · Hemingway\'s hangout'},
  {n:'San Juan',la:18.47,ln:-66.11,sub:'Puerto Rico · Capital',desc:'Capital of Puerto Rico (US territory). El Morro fortress, Old San Juan cobblestones, tropical beaches.',fact:'Fortress built 1539 · Ponce de León · Salsa & reggaeton'},
  {n:'Panama City',la:8.98,ln:-79.52,sub:'Panama · Capital',desc:'Capital of Panama. Panama Canal (engineering marvel). Skyline with skyscrapers. Casco Viejo.',fact:'Panama Canal 1914 · 5% of global trade · Casco Viejo (UNESCO)'},
  {n:'Abuja',la:9.08,ln:7.40,sub:'Nigeria · Capital',desc:'Capital of Nigeria. Aso Rock, Nigerian National Mosque, National Church. Planned city (1991).',fact:'Central location in Nigeria · 3M+ population · Zuma Rock'},
  {n:'Lagos',la:6.52,ln:3.38,sub:'Nigeria · Largest city',desc:'Largest city in Africa (15M+). Economic hub of Nigeria. Lekki Peninsula, National Museum, beaches.',fact:'15M+ growing to 30M · Nollywood film industry · Makoko floating slum'},
  {n:'Addis Ababa',la:9.03,ln:38.74,sub:'Ethiopia · Capital',desc:'Capital of Ethiopia. UN Economic Commission for Africa. National Museum (Lucy skeleton). African Union HQ.',fact:'3.2M+ population · 2,355m altitude · Original coffee'},
  {n:'Tunis',la:36.81,ln:10.18,sub:'Tunisia · Capital',desc:'Capital of Tunisia. Medina (UNESCO), Carthage ruins, Bardo Museum. Mediterranean coast.',fact:'Carthage founded 814 BC · Jasmine Revolution 2011 · Star Wars filming'},
  {n:'Casablanca',la:33.57,ln:-7.59,sub:'Morocco · Largest city',desc:'Largest city in Morocco. Hassan II Mosque (world\'s 2nd largest). Modern Atlantic port city.',fact:'Hassan II mosque 210m minaret · 1942 movie · Art Deco architecture'},
  {n:'Marrakech',la:31.63,ln:-8.01,sub:'Morocco · Cultural capital',desc:'Historic imperial city. Djemaa el-Fna square, Bahia Palace, Majorelle Garden. Red city walls.',fact:'Founded 1070 · Souk labyrinth · Atlas Mountains backdrop'},
  {n:'Dakar',la:14.69,ln:-17.45,sub:'Senegal · Capital',desc:'Capital of Senegal. Gorée Island (slave trade memorial), African Renaissance Monument. Westernmost point of Africa.',fact:'Gorée slave trade · Dakar Rally · Teranga hospitality'},
  {n:'Accra',la:5.56,ln:-0.20,sub:'Ghana · Capital',desc:'Capital of Ghana. Kwame Nkrumah Mausoleum, Makola Market, Labadi Beach. First sub-Saharan independent country.',fact:'Independence 1957 · Gold Coast · Cocoa & kente cloth'},
  {n:'Mumbai',la:19.08,ln:72.88,sub:'India · Financial capital',desc:'Financial and entertainment capital of India. Bollywood, Gateway of India, Marine Drive. Most populous city in India (20M+).',fact:'Bollywood film industry · Gateway of India · Dabbawalas · 20M+ population'},
  {n:'Melbourne',la:-37.81,ln:144.96,sub:'Australia · Cultural capital',desc:'Cultural and sports capital of Australia. Flinders Street, Federation Square, Great Ocean Road. World\'s most livable city.',fact:'Most livable city · AFL Grand Final · Coffee culture · Hosier Lane street art'},
  {n:'Johannesburg',la:-26.20,ln:28.04,sub:'South Africa · Largest city',desc:'Largest city in South Africa. Gold mining origin. Apartheid Museum, Soweto, Nelson Mandela\'s house. Economic powerhouse of Africa.',fact:'City of Gold · Soweto uprising 1976 · Mandela\'s house · 5M+ population'},
  {n:'Vancouver',la:49.28,ln:-123.12,sub:'Canada · Pacific gateway',desc:'Major Pacific port city. Stanley Park, Granville Island, mountains and ocean. Hosted 2010 Winter Olympics. Asian gateway.',fact:'Stanley Park · 2010 Olympics · Vancouver Island · Snow-capped mountains'},
  {n:'Munich',la:48.14,ln:11.58,sub:'Germany · Bavarian capital',desc:'Capital of Bavaria. Oktoberfest, BMW, Hofbräuhaus, English Garden. Beer culture. Hosted 1972 Olympics. Alpine gateway.',fact:'Oktoberfest (6M visitors) · BMW HQ · Marienplatz · Munich agreement 1938'},
  {n:'Milan',la:45.46,ln:9.19,sub:'Italy · Fashion & finance capital',desc:'Global fashion and design capital. Duomo, La Scala. Stock exchange. Da Vinci\'s Last Supper. HQ of Prada, Versace, Armani.',fact:'Duomo (5th largest church) · La Scala opera · Last Supper · Fashion Week'},
  {n:'Porto',la:41.16,ln:-8.63,sub:'Portugal · Northern capital',desc:'Port wine capital. Douro Valley, Dom Luís I Bridge. Historic centre UNESCO. Ribeira district. Named after Roman Portus Cale.',fact:'Port wine cellars · Dom Luís I bridge (Gustave Eiffel) · UNESCO centre'},
  {n:'Busan',la:35.18,ln:129.08,sub:'South Korea · Second-largest city',desc:'South Korea\'s largest port city. Haeundae Beach, Jagalchi Fish Market, Gamcheon Culture Village. Busan International Film Festival.',fact:'Largest port in Korea · BIFF film festival · Haedong Yonggungsa temple · Beomeosa'},
  {n:'Osaka',la:34.69,ln:135.50,sub:'Japan · Osaka prefecture capital',desc:'Japan\'s third-largest city. Osaka Castle, Dotonbori district, street food. Water city with canals. Commercial hub since ancient times.',fact:'Dotonbori neon lights · Osaka Castle · Takoyaki & okonomiyaki · Kuromon market'},
  {n:'Ahmedabad',la:23.02,ln:72.58,sub:'India · Gujarat capital',desc:'Capital of Gujarat. Sabarmati Ashram (Gandhi). UNESCO World Heritage city. Textile industry. Ahmedabad International Airport.',fact:'Gandhi\'s Sabarmati Ashram · First UNESCO WHS city in India · CEPT University · Kankaria Lake'},
];

D.w_river = [
  {n:'Amazon',pts:[{la:-4.10,ln:-73.46},{la:-4.45,ln:-66.50},{la:-5.12,ln:-60.77},{la:-4.65,ln:-57.90},{la:-4.05,ln:-53.55},{la:-1.90,ln:-49.60},{la:-0.70,ln:-48.50}],sub:'6,992 km · South America',desc:'World\'s largest river by volume (20% of global river flow). Flows from Andes to Atlantic. Amazon rainforest basin.',fact:'Largest drainage basin · 1/5 of world\'s freshwater · Pink river dolphin'},
  {n:'Nile',pts:[{la:30.17,ln:31.10},{la:26.85,ln:31.35},{la:24.08,ln:32.89},{la:21.48,ln:30.97},{la:19.60,ln:30.45},{la:15.62,ln:32.50},{la:12.00,ln:32.50},{la:9.48,ln:31.20},{la:6.35,ln:31.60},{la:2.78,ln:32.25},{la:0.50,ln:33.25},{la:-0.42,ln:33.21}],sub:'6,650 km · Africa',desc:'Longest river in the world. Flows through 11 countries. Ancient Egyptian civilization along its banks. Major dams: Aswan High Dam.',fact:'Blue & White Nile merge at Khartoum · Aswan Dam (1970) · Crocodiles'},
  {n:'Mississippi-Missouri',pts:[{la:29.15,ln:-89.25},{la:29.98,ln:-90.00},{la:31.01,ln:-91.19},{la:33.02,ln:-91.17},{la:35.15,ln:-90.07},{la:36.60,ln:-89.53},{la:38.68,ln:-90.18},{la:40.45,ln:-91.43},{la:42.48,ln:-91.44}],sub:'6,275 km · USA',desc:'Major US river system. Flows from Minnesota to Gulf of Mexico. Crucial for trade & agriculture. Mark Twain\'s inspiration.',fact:'3rd longest river system · 31 US states drainage · Steamboats history'},
  {n:'Yangtze (Chang Jiang)',pts:[{la:31.50,ln:121.45},{la:31.18,ln:120.80},{la:30.60,ln:116.80},{la:30.40,ln:113.40},{la:30.00,ln:110.00},{la:29.80,ln:107.50},{la:29.50,ln:104.50},{la:29.00,ln:102.00},{la:27.50,ln:99.90},{la:25.50,ln:98.00}],sub:'6,300 km · China',desc:'Longest river in Asia. Flows from Tibetan Plateau to East China Sea. Three Gorges Dam (world\'s largest). Crucial for Chinese civilization.',fact:'Three Gorges Dam (22.5 GW) · Yangtze finless porpoise · Cruise tourism'},
  {n:'Yellow River (Huang He)',pts:[{la:36.10,ln:118.00},{la:35.80,ln:116.80},{la:35.20,ln:113.70},{la:35.50,ln:111.20},{la:36.20,ln:109.50},{la:36.80,ln:104.50},{la:36.00,ln:102.00},{la:35.80,ln:99.50}],sub:'5,464 km · China',desc:'2nd longest in China. "Mother River" of Chinese civilization. Known for silt (yellow loess). Frequent flooding historically.',fact:'Cradle of Chinese civilization · Silt gives yellow colour · Flood control projects'},
  {n:'Volga',pts:[{la:46.30,ln:48.00},{la:48.50,ln:46.50},{la:50.10,ln:47.00},{la:52.80,ln:47.50},{la:55.80,ln:48.80},{la:57.50,ln:49.00},{la:61.00,ln:43.00}],sub:'3,530 km · Russia',desc:'Longest river in Europe. Flows from Valdai Hills to Caspian Sea. Crucial for Russian trade & culture. "Mother Volga".',fact:'Bridges Europe & Asia · Major hydroelectric dams · Caviar from sturgeon'},
  {n:'Danube',pts:[{la:45.30,ln:28.50},{la:44.30,ln:27.50},{la:44.00,ln:25.60},{la:43.80,ln:23.70},{la:44.20,ln:22.60},{la:44.80,ln:21.00},{la:45.20,ln:20.00},{la:45.80,ln:18.80},{la:47.50,ln:19.00},{la:48.10,ln:17.10},{la:48.20,ln:16.40},{la:48.30,ln:15.10},{la:49.00,ln:12.00}],sub:'2,850 km · Europe',desc:'2nd longest in Europe. Flows through 10 countries (most in the world). Connects Black Forest to Black Sea. Vienna, Budapest, Belgrade on its banks.',fact:'10 countries · Iron Gates dam · Danube Delta (UNESCO) · Blue Danube waltz'},
  {n:'Mekong',pts:[{la:9.75,ln:106.60},{la:10.50,ln:105.30},{la:12.00,ln:105.40},{la:14.00,ln:105.80},{la:16.00,ln:105.50},{la:18.00,ln:103.00},{la:20.30,ln:101.40},{la:22.00,ln:101.00},{la:24.50,ln:99.80},{la:27.00,ln:96.00}],sub:'4,350 km · SE Asia',desc:'Major SE Asian river. Flows through 6 countries. Tonlé Sap lake in Cambodia. Mekong Delta (rice bowl).',fact:'6 countries · Tonlé Sap reverses flow · Irrawaddy dolphin · Rice terraces'},
  {n:'Congo',pts:[{la:-5.95,ln:12.30},{la:-6.00,ln:14.50},{la:-4.00,ln:15.40},{la:-3.50,ln:17.00},{la:-2.70,ln:18.00},{la:-0.50,ln:18.50},{la:1.50,ln:19.00},{la:3.00,ln:19.50},{la:4.30,ln:20.50},{la:6.00,ln:20.00}],sub:'4,700 km · Africa',desc:'2nd longest in Africa. Deepest river in the world (220m+). Crosses equator twice. Massive rainforest basin.',fact:'Deepest river (220m) · 2nd largest rainforest · Bonobos & okapi'},
  {n:'Ganges',pts:[{la:22.10,ln:90.80},{la:23.50,ln:89.00},{la:24.30,ln:87.50},{la:25.00,ln:86.50},{la:25.30,ln:85.50},{la:24.80,ln:84.50},{la:25.20,ln:83.00},{la:25.50,ln:81.50},{la:26.50,ln:80.50},{la:28.70,ln:77.20},{la:30.30,ln:78.50},{la:31.00,ln:79.00}],sub:'2,525 km · India/Bangladesh',desc:'Most sacred river in Hinduism. Ganga: from Gangotri glacier to Bay of Bengal. Flows through India & Bangladesh.',fact:'Most sacred · Ganga Aarti at Varanasi · National River of India · Gangetic dolphin'},
  {n:'Blue Nile',pts:[{la:15.62,ln:32.50},{la:15.50,ln:32.40},{la:15.00,ln:37.00},{la:14.50,ln:37.50},{la:13.50,ln:37.50},{la:12.50,ln:37.00},{la:12.00,ln:37.00},{la:11.50,ln:36.50},{la:11.00,ln:37.00}],sub:'1,450 km · Ethiopia to Sudan',desc:'Major Nile tributary. Originates from Lake Tana (Ethiopia). Provides 85% of Nile water during monsoon. Blue Nile Falls.',fact:'85% of Nile\'s water · Lake Tana source · Blue Nile Falls "Smoking Water" · Grand Ethiopian Renaissance Dam'},
  {n:'White Nile',pts:[{la:15.62,ln:32.50},{la:12.00,ln:32.50},{la:9.50,ln:32.50},{la:7.70,ln:32.50},{la:5.50,ln:32.00},{la:4.00,ln:32.00},{la:2.00,ln:33.00},{la:0.50,ln:33.25},{la:-0.42,ln:33.21}],sub:'3,700 km · Great Lakes to Sudan',desc:'The longer Nile source. Originates from Lake Victoria (Jinja, Uganda). Flows through multiple lakes. Joins Blue Nile at Khartoum.',fact:'Originates from Lake Victoria · Albert Nile, Bahr al-Jabal sections · Sudd wetlands (massive swamp)'},
  {n:'Rio de la Plata',pts:[{la:-35.00,ln:-56.00},{la:-35.50,ln:-57.00},{la:-36.00,ln:-56.50},{la:-36.30,ln:-56.00}],sub:'290 km · Argentina/Uruguay',desc:'Estuary of Paraná & Uruguay rivers. Widest river in the world (220 km). Buenos Aires & Montevideo on its banks.',fact:'220 km wide · Silver river name · Paraná + Uruguay rivers feed · Río de la Plata basin'},
  {n:'Paraná',pts:[{la:-34.00,ln:-58.00},{la:-33.50,ln:-59.00},{la:-32.00,ln:-60.00},{la:-30.00,ln:-60.00},{la:-28.00,ln:-60.00},{la:-26.00,ln:-60.00},{la:-22.00,ln:-58.00},{la:-20.00,ln:-56.00},{la:-18.00,ln:-54.00}],sub:'4,880 km · South America',desc:'Second longest South American river. Flows through Brazil, Paraguay, Argentina. Itaipu Dam (world\'s 2nd largest hydro). Paraná Delta.',fact:'Itaipu Dam (14 GW) · Iguazu Falls on tributary · Paraná = "sea-like" in Tupi'},
  {n:'Orinoco',pts:[{la:8.50,ln:-61.00},{la:8.00,ln:-62.50},{la:7.50,ln:-63.50},{la:6.50,ln:-64.50},{la:6.00,ln:-65.00},{la:5.00,ln:-65.50},{la:4.50,ln:-66.00},{la:4.00,ln:-67.00}],sub:'2,140 km · Venezuela',desc:'Major South American river. Famous for the Casiquiare canal connecting to Amazon. Orinoco crocodile. Angel Falls (world\'s highest).',fact:'Casiquiare bifurcation (unique) · Angel Falls (979m) · Llanos plains · Orinoco basin heavy oil'},
  {n:'São Francisco',pts:[{la:-10.50,ln:-36.00},{la:-11.00,ln:-37.50},{la:-12.00,ln:-38.50},{la:-13.00,ln:-38.50},{la:-14.00,ln:-38.50},{la:-15.00,ln:-39.00},{la:-16.00,ln:-40.00},{la:-17.50,ln:-44.00},{la:-18.50,ln:-45.00},{la:-20.00,ln:-46.00},{la:-21.00,ln:-47.00}],sub:'2,914 km · Brazil',desc:'"River of national unity" in Brazil. Originates from Minas Gerais. Major hydro (Paulo Afonso). Semi-arid Northeast irrigation.',fact:'Paulo Afonso Falls & Dam · Sobradinho Dam (one of largest) · Transposition project (waters to NE)'},
  {n:'Lena',pts:[{la:73.00,ln:126.00},{la:71.00,ln:127.00},{la:69.00,ln:128.00},{la:67.00,ln:126.00},{la:65.00,ln:125.00},{la:63.00,ln:126.00},{la:60.00,ln:124.00},{la:57.00,ln:122.00},{la:55.00,ln:120.00},{la:54.00,ln:116.00}],sub:'4,400 km · Russia',desc:'Longest river entirely within Russia. Originates from Baikal Mountains. Lena Delta (largest Arctic delta). Major Siberian transport route.',fact:'Lena Pillars (UNESCO) · Lena Delta (30,000 km²) · Frozen 8 months/year · Major Siberian river'},
  {n:'Ob-Irtysh',pts:[{la:66.60,ln:68.50},{la:65.00,ln:70.00},{la:63.00,ln:72.00},{la:60.00,ln:72.00},{la:58.00,ln:74.00},{la:56.00,ln:76.00},{la:54.00,ln:76.00},{la:52.00,ln:76.00},{la:50.00,ln:77.00},{la:48.00,ln:76.00},{la:46.00,ln:75.00}],sub:'5,410 km · Russia/Kazakhstan',desc:'Seventh longest river. Irtysh is main headwater. Flows to Arctic Ocean. Major hydro (Novosibirsk Dam). Siberian economic artery.',fact:'Irtysh is longer (4,248 km) · Novosibirsk hydro · Ob Gulf estuary · Trans-Siberian bridge crossing'},
  {n:'Yenisei',pts:[{la:72.00,ln:82.00},{la:70.00,ln:84.00},{la:68.00,ln:86.00},{la:65.00,ln:88.00},{la:62.00,ln:90.00},{la:60.00,ln:90.00},{la:58.00,ln:92.00},{la:56.00,ln:94.00},{la:54.00,ln:96.00},{la:52.00,ln:98.00},{la:50.00,ln:100.00}],sub:'5,539 km · Russia',desc:'Fifth longest river. Originates from Mongolia (tributaries). Flows to Arctic Kara Sea. Major hydro (Sayano-Shushenskaya — largest in Russia).',fact:'Sayano-Shushenskaya Dam (6.4 GW) · Lake Baikal drainage · Deepest river canyon · Turukhansk region'},
