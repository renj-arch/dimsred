const D = {};

D.city = [
  {n:'New Delhi',la:28.61,ln:77.23,sub:'National Capital Territory',desc:'Capital of India on the Yamuna River. Seat of Parliament, Supreme Court, and Rashtrapati Bhavan. Designed by Edwin Lutyens and Herbert Baker.',fact:'Built on 7 cities · Mughal capital Shahjahanabad · India Gate memorial · Lotus Temple · Qutub Minar (UNESCO)'},
  {n:'Mumbai',la:19.08,ln:72.88,sub:'Maharashtra · Financial Capital',desc:'Largest city and financial hub. Home to RBI, BSE, NSE, Bollywood, and Bombay Stock Exchange. Major natural deep-water port.',fact:'Seven islands merged by Hornby Vellard (1782) · Chhatrapati Shivaji Terminus (UNESCO) · Dabbawalas · Vihar Lake water source'},
  {n:'Chennai',la:13.08,ln:80.27,sub:'Tamil Nadu · Detroit of India',desc:'Capital of Tamil Nadu. Major auto manufacturing hub. Home to Madras HC (oldest HC in India). Marina Beach (2nd longest in world).',fact:'Fort St. George (1644) · First British settlement in India · Kapaleeshwarar Temple · Mylapore culture'},
  {n:'Kolkata',la:22.57,ln:88.36,sub:'West Bengal · Cultural Capital',desc:'Capital of WB. Former capital of British India (1772-1911). Victoria Memorial, Howrah Bridge, Indian Museum (oldest in Asia).',fact:'First metro in India (1984) · Mother Teresa served here · Kalighat Kali Temple · Durga Puja (UNESCO Intangible)'},
  {n:'Bengaluru',la:12.97,ln:77.59,sub:'Karnataka · Silicon Valley',desc:'Capital of Karnataka. India\'s IT hub. Known for pleasant climate, Cubbon Park, Lalbagh, and Vidhana Soudha.',fact:'Founded by Kempegowda (1537) · IISc (est. 1909) · Hindustan Aeronautics Ltd · Bengaluru Palace'},
  {n:'Hyderabad',la:17.38,ln:78.46,sub:'Telangana · Pearl City',desc:'Capital of Telangana. Known for Charminar, Golconda Fort, and IT corridor (HITEC City). Founded by Muhammad Quli Qutb Shah (1591).',fact:'Hyderabad House · Osmania University · Ramoji Film City · Biryani and pearls'},
  {n:'Jaipur',la:26.91,ln:75.79,sub:'Rajasthan · Pink City',desc:'Capital of Rajasthan. Planned city by Sawai Jai Singh II (1727). Hawa Mahal, City Palace, Jantar Mantar (UNESCO). Part of Golden Triangle. Known for block printing, blue pottery, and gemstones.',fact:'Pink City due to 1876 Prince of Wales visit · Jantar Mantar astronomical marvel · Rajput architecture'},
  {n:'Lucknow',la:26.85,ln:80.95,sub:'Uttar Pradesh · City of Nawabs',desc:'Capital of UP. Known for Nawabi culture, cuisine, and architecture. Bara Imambara, Chota Imambara, Rumi Darwaza.',fact:'Founded by Nawab Asaf-ud-Daula · Chikankari embroidery · Tehzeeb (etiquette) culture'},
  {n:'Patna',la:25.59,ln:85.14,sub:'Bihar · Ancient Capital',desc:'Capital of Bihar. Located on Ganga. One of oldest continuously inhabited cities. Ancient Pataliputra — capital of Maurya & Gupta empires.',fact:'Golghar (1786) · Bihar Museum · Takht Sri Patna Sahib · Nalanda nearby'},
  {n:'Bhopal',la:23.26,ln:77.41,sub:'Madhya Pradesh · City of Lakes',desc:'Capital of MP. Known for Upper & Lower Lakes, Bharat Bhavan, and Taj-ul-Masajid (largest mosque in India).',fact:'Bhopal Gas Tragedy (1984) · Founded by Dost Mohammad Khan (1707) · Van Vihar NP'},
  {n:'Bhuvaneswar',la:20.30,ln:85.83,sub:'Odisha · Temple City',desc:'Capital of Odisha. Known for Lingaraj Temple, Mukteswara Temple, and Rajarani Temple. Planned by Otto Königsberger.',fact:'Lingaraj built 11th century · Nandankanan Zoo nearby · Udayagiri & Khandagiri caves'},
  {n:'Gandhinagar',la:23.22,ln:72.68,sub:'Gujarat · Green Capital',desc:'Planned capital of Gujarat. Named after Mahatma Gandhi. Akshardham Temple, Sarita Udyan, and Indroda Nature Park.',fact:'Designed by H.K. Mewada · Most green city in Asia · Delhi-Gandhinagar similar layout'},
  {n:'Chandigarh',la:30.73,ln:76.78,sub:'Punjab/Haryana UT',desc:'Capital of Punjab & Haryana. India\'s first planned post-independence city. Designed by Le Corbusier. Rock Garden, Capitol Complex (UNESCO).',fact:'City Beautiful · Sector-based design · Lake Sukhna · Open Hand Monument'},
  {n:'Srinagar',la:34.08,ln:74.80,sub:'J&K (Summer Capital)',desc:'Summer capital of J&K. Located in Kashmir Valley on Jhelum. Dal Lake, Shalimar Bagh, Mughal Gardens, Char Chinar.',fact:'Founded by Ashoka · Lalitaditya built Martand Sun Temple · Houseboats · Saffron'},
  {n:'Jammu',la:32.73,ln:74.87,sub:'J&K (Winter Capital)',desc:'Winter capital of J&K. Known for Vaishno Devi shrine (Mata Rani). Bahu Fort, Raghunath Temple, Amar Mahal.',fact:'Dogra dynasty capital · Mubarak Mandi Palace · World\'s second-largest kitchen at Vaishno Devi'},
  {n:'Dehradun',la:30.32,ln:78.03,sub:'Uttarakhand · Doon Valley',desc:'Capital of Uttarakhand. Located in Doon Valley between Himalayas & Shivaliks. Forest Research Institute, Indian Military Academy.',fact:'Robber\'s Cave · Tapkeshwar Temple · Sahastradhara · Known for basmati rice & lychees'},
  {n:'Shimla',la:31.10,ln:77.17,sub:'Himachal Pradesh · Queen of Hills',desc:'Capital of HP. Summer capital of British India (1864-1939). Ridge, Mall Road, Viceregal Lodge (Indian Institute of Advanced Study).',fact:'Jakhoo Temple · Kalka-Shimla railway (UNESCO) · Toy train · Scandal Point'},
  {n:'Ranchi',la:23.35,ln:85.33,sub:'Jharkhand · City of Waterfalls',desc:'Capital of Jharkhand. Known for Hundru Falls (Subarnarekha River), Jonha Falls, and Dhoni Falls. Rock Garden, Kanke Dam.',fact:'Tagore Hill · Birsa Munda\'s birthplace · Tribal culture · Jharkhand formed 2000'},
  {n:'Raipur',la:21.25,ln:81.63,sub:'Chhattisgarh',desc:'Capital of Chhattisgarh. Known for ancient temples, Nandanvan Garden, and marine fossil park at Naya Raipur.',fact:'Swami Vivekanand Sarovar · Chhattisgarh formed 2000 · Richest mineral state'},
  {n:'Panaji',la:15.49,ln:73.83,sub:'Goa',desc:'Capital of Goa. Located on Mandovi River banks. Known for Portuguese-era architecture, churches, and casinos.',fact:'Basilica of Bom Jesus (UNESCO) · Se Cathedral · Fontainhas (Latin Quarter) · Carnival'},
  {n:'Thiruvananthapuram',la:8.52,ln:76.94,sub:'Kerala',desc:'Capital of Kerala. Known for Sri Padmanabhaswamy Temple (world\'s richest temple), Kovalam Beach, Technopark, VSSC (ISRO).',fact:'Named after Ananta (Shesha) · Napier Museum · Kuthira Malika · Kerala Legislature'},
  {n:'Guwahati',la:26.18,ln:91.73,sub:'Assam · Gateway to NE',desc:'Largest city in NE. On Brahmaputra. Kamakhya Temple (shakti peetha), Umananda Island, Assam State Museum.',fact:'Ancient Pragjyotishpura · Kaziranga nearby · Assam tea · Brahmaputra river cruise'},
  {n:'Shillong',la:25.58,ln:91.89,sub:'Meghalaya · Scotland of East',desc:'Capital of Meghalaya. Known for lush hills, waterfalls (Elephant Falls), and pleasant climate. Highest rainfall area near Mawsynram.',fact:'Ward\'s Lake · Umiam Lake · Shillong Peak (1965m) · Golf course oldest in India (1898)'},
  {n:'Imphal',la:24.82,ln:93.95,sub:'Manipur',desc:'Capital of Manipur. Site of WWII Battle of Imphal (1944). Known for Sangai deer, polo (origin), and Loktak Lake.',fact:'Kangla Fort · Ima Market (women-only) · Manipuri dance · Kwai (betel nut) tradition'},
  {n:'Kohima',la:25.68,ln:94.11,sub:'Nagaland',desc:'Capital of Nagaland. WWII Kohima War Cemetery, Hornbill Festival, Naga heritage complex.',fact:'"Kohima Epitaph" WWII · Dzukou Valley · Angami tribe · Terracotta & bamboo work'},
  {n:'Aizawl',la:23.73,ln:92.72,sub:'Mizoram',desc:'Capital of Mizoram. Located at 1132m in Lushai Hills. Solomon\'s Temple, Reiek Tlang, Vantawng Falls.',fact:'Mizoram: most literate state (91.3%) · Handloom industry · Bamboo dance'},
  {n:'Agartala',la:23.83,ln:91.28,sub:'Tripura',desc:'Capital of Tripura. Ujjayanta Palace, Neermahal, Tripura Sundari Temple (one of 51 shakti peethas).',fact:'Last princely state to join India (1949) · Bamboo & cane crafts · Rubber production'},
  {n:'Gangtok',la:27.33,ln:88.62,sub:'Sikkim',desc:'Capital of Sikkim. In Himalayas. Rumtek Monastery, Tsomgo Lake, Nathu La pass (India-China border).',fact:'First organic state in India · Kanchenjunga (8586m) view · Yak and snow leopard'},
  {n:'Itanagar',la:27.10,ln:93.62,sub:'Arunachal Pradesh',desc:'Capital of Arunachal. Ita Fort (14th-15th cent), Ganga Lake, Namdapha NP near. Ziro Valley for paddy fields.',fact:'Most linguistically diverse state · Tawang Monastery (largest in India) · Sela Pass'},
  {n:'Port Blair',la:11.67,ln:92.75,sub:'A&N Islands',desc:'Capital of Andaman & Nicobar. Cellular Jail (Kaala Paani), Ross Island, Havelock Island (Radhanagar Beach), Baratang Island.',fact:'Cellular Jail built 1906 by British · VE Day & water sports · Tribes: Sentinelese, Jarawa'},
  {n:'Kavaratti',la:10.56,ln:72.64,sub:'Lakshadweep UT',desc:'Capital of Lakshadweep. 36 islands, coral atolls. Marine life, lagoons, water sports. Smallest UT by area.',fact:'Only 10 inhabited islands · Bangaram atoll · Agatti airport · Marine aquarium'},
  {n:'Puducherry',la:11.94,ln:79.83,sub:'Puducherry UT',desc:'Capital of Puducherry. French colonial heritage (French Quarter), Sri Aurobindo Ashram, Auroville (Matrimandir), Promenade Beach.',fact:'French territory until 1954 · French & Tamil cultures blend · Paradise Beach'},
  {n:'Leh',la:34.16,ln:77.58,sub:'Ladakh UT',desc:'Largest town in Ladakh. At 3500m. Shanti Stupa, Leh Palace, Pangong Tso Lake, Khardung La (one of highest motorable passes).',fact:'Nubra Valley · Magnetic Hill · Two-humped Bactrian camels · Hemis Festival'},
  {n:'Daman',la:20.42,ln:72.84,sub:'D&NH and D&D UT',desc:'Capital of DNH & Daman Diu. Portuguese colonial history. Fort of Moti Daman, Devka Beach, Bom Jesus Church.',fact:'Portuguese until 1961 · Silvassa nearby · Fishing & tourism economy'},
  {n:'Agra',la:27.18,ln:78.02,sub:'Uttar Pradesh · Mughal City',desc:'Home of Taj Mahal (UNESCO) — one of Seven Wonders. Agra Fort (UNESCO), Fatehpur Sikri (UNESCO). Mughal capital under Akbar, Jahangir, Shah Jahan.',fact:'Built by Shah Jahan for Mumtaz (1631-53) · Yamuna riverfront · Marble inlay work · Mughlai cuisine'},
  {n:'Varanasi',la:25.32,ln:82.97,sub:'UP · Spiritual Capital',desc:'World\'s oldest living city. On Ganga. Kashi Vishwanath Temple (12 jyotirlinga), Sarnath (Buddha\'s first sermon), Ganga Aarti at Dasashwamedh Ghat.',fact:'>3000 years old · Mark Twain quote · Banarasi silk · Banaras Hindu University (BHU)'},
  {n:'Ajmer',la:26.45,ln:74.64,sub:'Rajasthan',desc:'Ajmer Sharif Dargah (Sufi shrine of Khwaja Moinuddin Chisti). Ana Sagar Lake, Mayo College, Pushkar nearby (Brahma Temple).',fact:'Founded by Ajayaraja II (Chahamana) · Only Brahma temple in Pushkar · Camel fair'},
  {n:'Amritsar',la:31.63,ln:74.87,sub:'Punjab · Golden Temple',desc:'Holy city of Sikhism. Golden Temple (Harmandir Sahib) with holy sarovar. Jallianwala Bagh, Wagah Border ceremony.',fact:'Founded by Guru Ram Das (1574) · Amritsar = pool of nectar · Partition riots 1947'},
  {n:'Mysuru',la:12.30,ln:76.64,sub:'Karnataka · Palace City',desc:'City of Palaces — Mysore Palace (Amba Vilas). Dasara festival (Navaratri) celebrated grandly. Chamundi Hills, Brindavan Gardens, Srirangapatna.',fact:'Wodeyar dynasty · Sandalwood & silk · Mysore Pak sweet · KRS Dam · Infosys campus'},
  {n:'Madurai',la:9.92,ln:78.12,sub:'Tamil Nadu · Temple City',desc:'Meenakshi Amman Temple (14 gopurams, 1000-pillar hall). Pandya dynasty capital. Thirumalai Nayakkar Palace.',fact:'>2500 years old · Tamil Sangam (literary academy) · Jallikattu bull festival'},
  {n:'Udaipur',la:24.59,ln:73.73,sub:'Rajasthan · City of Lakes',desc:'Lake City — Pichola, Fateh Sagar, Udai Sagar lakes. City Palace, Jag Mandir, Lake Palace (Taj hotel). Called "Rajasthan\'s most romantic city".',fact:'Founded by Maharana Udai Singh II (1559) · Sisarma & Ahar rivers · Miniature paintings'},
  {n:'Haridwar',la:29.97,ln:78.16,sub:'Uttarakhand · Gateway to Gods',desc:'One of 4 sites of Kumbh Mela. Ganga enters plains here. Har Ki Pauri (footprint of Vishnu), Chandi Devi, Mansa Devi temples.',fact:'Mentioned in Puranas · Ganga Aarti at dusk · Daksha Mahadev Temple · Ayurveda hub'},
  {n:'Rishikesh',la:30.09,ln:78.29,sub:'Uttarakhand · Yoga Capital',desc:'World yoga capital. Beatles Ashram (Maharishi Mahesh Yogi). Lakshman Jhula, Ram Jhula. Adventure sports hub — river rafting on Ganga.',fact:'"Gateway to Himalayas" · Triveni Ghat · Neelkanth Mahadev · International Yoga Festival'},
  {n:'Dwarka',la:22.23,ln:68.97,sub:'Gujarat · Lord Krishna\'s City',desc:'One of Char Dham. Dwarkadhish Temple (Jagat Mandir). Ancient city submerged in sea — discovered underwater by ASI.',fact:'Mentioned in Mahabharata · Bet Dwarka island · Nageshwara Jyotirlinga · Sudama Setu'},
  {n:'Puri',la:19.81,ln:85.83,sub:'Odisha · Jagannath Puri',desc:'One of Char Dham. Jagannath Temple (Rath Yatra). Puri beach (Golden Beach). Gundicha Temple, Chilika Lake nearby.',fact:'Rath Yatra (chariot festival) · Mahaprasad · Only temple with flying flag symbolism'},
  {n:'Rameswaram',la:9.29,ln:79.32,sub:'Tamil Nadu',desc:'One of Char Dham. Ramanathaswamy Temple (longest corridor in India). Pamban Bridge (India\'s first sea bridge). Adam\'s Bridge (Ram Setu).',fact:'Setu Bhushan · Dhanushkodi · Dr. APJ Abdul Kalam\'s hometown · Fishing hub'},
  {n:'Nashik',la:20.00,ln:73.78,sub:'Maharashtra · Wine Capital',desc:'Holy city on Godavari. Kumbh Mela every 12 years. Trimbakeshwar Jyotirlinga (source of Godavari). Sula Vineyards (wine tourism). Pandavleni Caves.',fact:'Pandavleni (Jain) caves · Godavari origin · Wine capital of India · Kalaram Temple'},
  {n:'Vadodara',la:22.31,ln:73.18,sub:'Gujarat · Cultural Capital',desc:'Also Baroda. Laxmi Vilas Palace (4x size of Buckingham Palace). Sayaji Garden. MS University. Vadodara = pet name for banyan (Vad).',fact:'Gaekwad dynasty · Maharaja Sayajirao III (reformer) · Vadodara Marathon · Birla Temple'},
  {n:'Surat',la:21.17,ln:72.83,sub:'Gujarat · Diamond City',desc:'World\'s diamond cutting & polishing centre (90% of world). Founded 1500s. Portuguese & British trade. Textile hub. Fastest-growing city in India.',fact:'Diamond capital · largest ship-breaking (Alang) near · Mughal sultanate port · Rander'},
  {n:'Coimbatore',la:11.02,ln:76.97,sub:'Tamil Nadu · Manchester of South',desc:'Major textile & engineering hub. Kovai Kodampakkam (cotton). Tidel Park IT hub. Isha Foundation (Dhyanalinga). Siruvani Falls.',fact:'Siruvani water (sweetest) · Kovai textile · MARINA (electric scooters) · KOVAI Wet Grinder'},
  {n:'Visakhapatnam',la:17.69,ln:83.22,sub:'Andhra Pradesh · City of Destiny',desc:'Largest city in AP. Eastern Naval Command. INS Kursura submarine museum. RK Beach, Kailasagiri, Borra Caves, Araku Valley nearby.',fact:'Steel plant (VSP) · Submarine museum Asia\'s 1st · Natural harbour · Navy 1st choice'},
  {n:'Aurangabad',la:19.88,ln:75.32,sub:'Maharashtra · City of Gates',desc:'UNESCO sites — Ajanta & Ellora Caves. Bibi ka Maqbara (mini Taj). Daulatabad Fort. Aurangazeb\'s capital. Himroo textiles.',fact:'52 gates (originally) · Ajanta (2 hr) & Ellora (30 min) · Paithani silk · Dargah of 7 saints'},
  {n:'Jodhpur',la:26.24,ln:73.02,sub:'Rajasthan · Blue City',desc:'Mehrangarh Fort (one of India\'s largest). Umaid Bhawan Palace (world\'s 6th largest private residence). Blue-walled Brahmin quarter. Desert safari.',fact:'Soorsagar & Fateh Sagar lakes · Marwar kingdom · Jodhpur Riyal · Blue city in old quarter'},
  {n:'Jabalpur',la:23.18,ln:79.99,sub:'Madhya Pradesh · Marble City',desc:'Marble Rocks at Bhedaghat (Narmada). Dhuandhar Falls. Rani Durgavati memorial. Sanskrit natural beauty. Tri-River confluence.',fact:'Sanskrit junction · Dumna Nature Reserve · Madan Mahal fort · Gupta & Gond history'},
  {n:'Gwalior',la:26.22,ln:78.18,sub:'Madhya Pradesh · City of Music',desc:'Gwalior Fort (one of India\'s largest). Tansen\'s tomb. Scindia dynasty. Sun temple (Sas-Bahu). Jai Vilas Palace (Scindia).',fact:'Tansen musical festival · India\'s first music school · Scindia dynasty · Meridian globe'},
  {n:'Ujjain',la:23.18,ln:75.78,sub:'Madhya Pradesh · City of Temples',desc:'One of 7 sacred cities. Mahakaleshwar Jyotirlinga. Kumbh Mela (Simhastha) every 12 years. Kalidasa\'s city. Vikramaditya\'s capital.',fact:'Simhastha Kumbh · Shipra river · Ujjain observatory (Jantar Mantar) · Jwalamukhi Temple'},
];
D.river = [
  {n:'Ganga',pts:[{la:30.14,ln:78.60},{la:29.95,ln:78.16},{la:28.68,ln:77.20},{la:26.50,ln:80.48},{la:25.62,ln:85.12},{la:24.80,ln:86.80},{la:22.08,ln:88.08}],sub:'2525 km · Gangotri to Bay of Bengal',desc:'Lifeline of India. Originates as Bhagirathi from Gangotri glacier. Alaknanda joins at Devprayag. Flows through 5 states. Most sacred river of Hindus.',fact:'Ganga Action Plan (1985) · Namami Gange (2014) · National River (2008) · Ganga basin covers 26% of India'},
  {n:'Yamuna',pts:[{la:31.02,ln:78.45},{la:30.32,ln:77.97},{la:28.68,ln:77.20},{la:26.50,ln:80.48},{la:25.42,ln:81.88}],sub:'1376 km · Yamunotri to Sangam',desc:'Largest tributary of Ganga. Originates from Yamunotri glacier. Taj Mahal on its bank. Sangam with Ganga at Prayagraj (Triveni).',fact:'Polluted stretch in Delhi · Yamuna Expressway · Irrigation canal network · Hathni Kund barrage'},
  {n:'Brahmaputra',pts:[{la:30.40,ln:82.20},{la:28.20,ln:94.70},{la:27.20,ln:93.70},{la:26.60,ln:91.80},{la:25.80,ln:89.80},{la:23.80,ln:90.30}],sub:'2900 km · Tibet to Bay of Bengal',desc:'One of Asia\'s largest. Known as Tsangpo in Tibet, Brahmaputra in India, Jamuna in Bangladesh. Deepest gorge (Tsangpo Gorge).',fact:'Makes largest river island (Majuli, Assam) · Floods annually · Jogighopa · Kaziranga NP dependent'},
  {n:'Godavari',pts:[{la:19.95,ln:73.55},{la:19.70,ln:77.50},{la:18.80,ln:79.80},{la:17.00,ln:81.50},{la:16.73,ln:82.22}],sub:'1465 km · Dakshin Ganga',desc:'Largest peninsular river. Originates at Trimbakeshwar (Nasik). Flows through Maharashtra, Telangana, AP. Delta in Bay of Bengal.',fact:'Polavaram irrigation project · Godavari Maha Pushkaram · Rajahmundry bridge · Nashik Kumbh Mela'},
  {n:'Krishna',pts:[{la:17.98,ln:73.75},{la:16.80,ln:78.00},{la:16.60,ln:80.50},{la:15.72,ln:80.92}],sub:'1400 km · Mahabaleshwar to Bay',desc:'Second largest peninsular river. Originates at Mahabaleshwar (Western Ghats). Krishna-Godavari basin is highly fertile. Major irrigation.',fact:'Krishna Water Disputes Tribunal · Nagarjuna Sagar Dam · Srisailam Dam · Bhima & Tungabhadra tributaries'},
  {n:'Narmada',pts:[{la:22.67,ln:81.75},{la:22.50,ln:78.20},{la:22.00,ln:74.00},{la:21.85,ln:73.12}],sub:'1312 km · Amarkantak to Khambhat',desc:'Flows west through rift valley between Vindhya & Satpura. Marble Gorge at Jabalpur (Dhuandhar Falls). No delta — forms estuary.',fact:'Sardar Sarovar Dam · Narmada Bachao Andolan (Medha Patkar) · Narmada Parikrama · Rewa kingdom'},
  {n:'Tapti',pts:[{la:21.80,ln:78.30},{la:21.40,ln:76.20},{la:21.20,ln:73.20},{la:21.05,ln:72.65}],sub:'724 km · Betul to Khambhat',desc:'Flows west parallel to Narmada. Originates near Multai in Betul (MP). Ukai Dam (largest in Gujarat). Tidal estuary.',fact:'Said to be daughter of Sun (Tapati) · Surat on its bank · Saputara hill station on source'},
  {n:'Mahanadi',pts:[{la:20.52,ln:82.60},{la:20.70,ln:83.20},{la:20.55,ln:84.40},{la:20.30,ln:85.70},{la:19.98,ln:86.43}],sub:'858 km · Sihawa to Bay of Bengal',desc:'Flows through Chhattisgarh & Odisha. Hirakud Dam (world\'s longest earthen dam, 4.8 km). Mahanadi delta is fertile.',fact:'Hirakud creates Hirakud Reservoir (largest artificial lake in Asia) · Mahanadi disputes · Sambalpur'},
  {n:'Kaveri',pts:[{la:12.42,ln:75.70},{la:11.90,ln:77.00},{la:11.10,ln:78.00},{la:10.85,ln:78.65},{la:11.38,ln:79.78}],sub:'766 km · Brahmagiri to Bay',desc:'Known as Ganga of South. Originates at Talakaveri (Brahmagiri hills, Karnataka). Famous 120-year Cauvery water dispute.',fact:'Krishna Raja Sagara Dam · Mettur Dam · Shivanasamudra Falls (hydroelectric 1902) · Thanjavur delta'},
  {n:'Indus',pts:[{la:32.00,ln:78.60},{la:33.20,ln:77.40},{la:34.20,ln:77.00},{la:35.30,ln:76.00},{la:33.80,ln:73.00},{la:25.00,ln:68.00}],sub:'3180 km · Tibet to Arabian Sea',desc:'One of longest rivers in Asia. Originates near Mansarovar (Tibet). Indus Valley Civilization on its banks. Major river of Indian subcontinent.',fact:'Indus Waters Treaty (1960) · Sutlej, Beas, Chenab, Ravi, Jhelum — 5 tributaries · \'Sindhu\' in Sanskrit'},
  {n:'Sutlej',pts:[{la:31.20,ln:81.40},{la:31.60,ln:78.90},{la:31.40,ln:76.60},{la:31.18,ln:74.97}],sub:'~1500 km · Tibet to Indus',desc:'Longest of 5 Indus tributaries. Originates near Mansarovar. Bhakra-Nangal Dam (India\'s highest gravity dam, 226m).',fact:'Bhakra project: 225m, 2nd highest in Asia · Govind Sagar Lake · Satluj Jal Vidyut Nigam'},
  {n:'Beas',pts:[{la:32.37,ln:77.14},{la:31.80,ln:76.33},{la:31.30,ln:75.50},{la:31.18,ln:74.98}],sub:'460 km · Rohtang to Sutlej',desc:'Originates from Rohtang Pass (HP). Pong Dam (Maharana Pratap Sagar) — important wetland (Ramsar). Joins Sutlej at Harike.',fact:'Sage Vyas said to have created · Beas Kund · Kullu valley on its banks · Trout fishing'},
  {n:'Chenab',pts:[{la:33.40,ln:76.00},{la:33.20,ln:75.40},{la:32.70,ln:74.80},{la:31.18,ln:72.60}],sub:'965 km · Himachal to Pakistan',desc:'Largest Indus tributary by volume. Chandra & Bhaga merge at Tandi (HP). Baglihar Dam (controversy with Pakistan).',fact:'World\'s highest railway bridge (Chenab Bridge, 359m) · Salal Dam · Dugli project'},
  {n:'Ravi',pts:[{la:32.60,ln:76.00},{la:32.30,ln:75.70},{la:32.00,ln:74.80},{la:31.00,ln:74.00}],sub:'720 km · Kullu Hills to Pakistan',desc:'Originates in Kullu Hills (HP). Flows between India and Pakistan (border river). Thein Dam (Ranjit Sagar).',fact:'Named from Iravati (goddess) in Rigveda · Chamba on its bank · Madhopur headworks'},
  {n:'Jhelum',pts:[{la:34.10,ln:75.10},{la:34.00,ln:74.60},{la:33.70,ln:74.30},{la:32.90,ln:73.50}],sub:'725 km · Verinag to Chenab',desc:'Originates from Verinag Spring (Kashmir). Wular Lake (largest freshwater lake in J&K) on its course. Vitasta in Sanskrit.',fact:'Mughal gardens on its banks (Shalimar, Nishat) · Dal Lake connected · Vitasta (goddess)'},
  {n:'Subarnarekha',pts:[{la:23.30,ln:85.20},{la:23.00,ln:86.00},{la:22.70,ln:87.00},{la:22.30,ln:87.50},{la:21.56,ln:87.38}],sub:'395 km · Ranchi to Bay',desc:'Means "streak of gold". Flows through Jharkhand, WB, Odisha. Hundru Falls (98m) and Jonha Falls on its course.',fact:'Gold traces in riverbed · Galudih barrage · Chandil Dam · IIT Kharagpur near its bank'},
  {n:'Penna',pts:[{la:14.00,ln:77.60},{la:14.10,ln:78.40},{la:14.40,ln:79.30},{la:14.70,ln:80.10}],sub:'597 km · Karnataka to Bay',desc:'Flows through Karnataka & Andhra. Important rain-fed river. Penneru in Sanskrit. Somasila Dam.',fact:'Bugga, Chitravati tributaries · Nellore AP · Penna river basin drought-prone'},
  {n:'Tungabhadra',pts:[{la:15.20,ln:76.40},{la:15.40,ln:77.20},{la:15.70,ln:78.30},{la:16.00,ln:79.90}],sub:'531 km · Karnataka to Krishna',desc:'Formed by Tunga and Bhadra rivers. Tungabhadra Dam (Mallapuram). Hampi (UNESCO) on its banks — Vijayanagara capital.',fact:'Tunga + Bhadra = Tungabhadra · Tunga is clearest · Sir Arthur Cotton built anicut'},
  {n:'Alaknanda',pts:[{la:30.87,ln:78.67},{la:30.65,ln:78.50},{la:30.45,ln:78.32},{la:30.14,ln:78.60}],sub:'195 km · Satopanth to Devprayag',desc:'Source stream of Ganga (Bhagirathi + Alaknanda = Ganga at Devprayag). Originates from Satopanth glacier. Badrinath temple on its bank.',fact:'Confluence with Bhagirathi at Devprayag (Prayag) · Mandakini joins at Rudraprayag · Pindar & Dhauliganga tributaries'},
  {n:'Bhagirathi',pts:[{la:31.00,ln:78.80},{la:30.85,ln:78.60},{la:30.55,ln:78.40},{la:30.14,ln:78.60}],sub:'205 km · Gangotri to Devprayag',desc:'One of source streams of Ganga. Originates from Gangotri glacier (Gaumukh). Bhagirathi + Alaknanda = Ganga. Tehri Dam on its course.',fact:'Gangotri temple (one of Char Dham) · Gaumukh glacier snout · Tehri Dam (world\'s 5th tallest) · Pilgrim trek'},
  {n:'Ghaghra',pts:[{la:30.30,ln:81.40},{la:29.00,ln:80.50},{la:27.60,ln:82.50},{la:26.00,ln:83.60},{la:25.80,ln:84.70}],sub:'1080 km · Tibet to Ganga',desc:'Largest Ganga tributary by volume. Also called Karnali in Nepal. Originates from Tibetan plateau (Mansarovar). Flows through Nepal then Bihar.',fact:'Karnali River · Chhapra (Chapra) confluence · Old name Sarayu · Largest tributary by length of Ganga'},
  {n:'Gandak',pts:[{la:28.90,ln:84.00},{la:27.80,ln:84.30},{la:26.70,ln:84.60},{la:25.65,ln:85.20}],sub:'765 km · Nepal to Ganga',desc:'Originates near Tibetan border from Nhubine Himal glacier. Kali Gandak in Nepal. Valmiki Tiger Reserve on its bank. Confluence at Sonpur.',fact:'Valmiki NP on its bank · Sonpur Kumbh Mela · Triveni canal Gandak · Narayani devi temple'},
  {n:'Kosi',pts:[{la:27.80,ln:87.20},{la:27.10,ln:86.90},{la:26.00,ln:86.60},{la:25.40,ln:87.20}],sub:'729 km · Tibet to Ganga',desc:'Known as "Sorrow of Bihar" for devastating floods. Originates from Tibet (Saptakoshi — 7 tributaries). Koshi Barrage at Hanuman Nagar.',fact:'7 tributaries join to form Saptakoshi · Kosi embankment project · Frequent course changes · Kosi Basin flood protection'},
  {n:'Son',pts:[{la:23.80,ln:82.20},{la:24.60,ln:83.30},{la:25.00,ln:84.30},{la:25.60,ln:85.10}],sub:'784 km · MP to Ganga',desc:'Large Ganga tributary. Originates near Amarkantak (Anuppur, MP). Indrapuri barrage (largest in Bihar). Rihand Dam on its tributary.',fact:'Rihand Dam (Govind Ballabh Pant Sagar) · Bansagar Dam (MP) · Dehri-on-Son · Son canal irrigation'},
  {n:'Gomti',pts:[{la:28.80,ln:80.00},{la:27.50,ln:80.90},{la:26.70,ln:82.20},{la:25.50,ln:83.20}],sub:'900 km · UP to Ganga',desc:'Originates from Fulhar Jheel (Pilibhit, UP). Lucknow city on its banks. Joins Ganga at Kaithi (Varanasi).',fact:'Lucknow developed on its bank · Gomti barrage · Gomti Nagar (planned city) · Eutrophication issue'},
  {n:'Ramganga',pts:[{la:30.10,ln:78.80},{la:29.30,ln:79.00},{la:28.30,ln:79.60},{la:27.10,ln:80.00}],sub:'596 km · Kumaon to Ganga',desc:'Originates from Doodhatoli hills (Uttarakhand). Kalagarh Dam (Jim Corbett NP). Joins Ganga near Kannauj.',fact:'Kalagarh Dam in Corbett Tiger Reserve · Ramganga West & East (separate river) · Sonanadi confluence'},
  {n:'Damodar',pts:[{la:23.60,ln:85.00},{la:23.50,ln:86.00},{la:22.90,ln:86.80},{la:22.30,ln:87.70}],sub:'592 km · Chota Nagpur to Hooghly',desc:'Flows through Jharkhand & Bengal. Known for Damodar Valley Corporation (DVC, 1948) — multipurpose river valley project. Rich in coal (Damodar basin).',fact:'DVC model for India · 4 DVC dams (Tilaiya, Konar, Maithon, Panchet) · "Sorrow of Bengal" · Bokaro & Barakar confluences'},
  {n:'Hooghly',pts:[{la:22.90,ln:88.10},{la:22.60,ln:88.30},{la:22.00,ln:88.10},{la:21.60,ln:88.10}],sub:'260 km · Ganga distributary',desc:'Ganga\'s distributary in Bengal. Kolkata & Howrah on its banks. Farakka Barrage diverts Ganga water to Hooghly. Major port & trade route.',fact:'Kolkata Port on Hooghly · Farakka Barrage (1975) · Dakshineswar & Belur Math on bank · Sundarbans delta'},
  {n:'Manas',pts:[{la:27.80,ln:91.80},{la:26.80,ln:91.50},{la:26.50,ln:90.80},{la:26.20,ln:90.60}],sub:'400 km · Bhutan to Brahmaputra',desc:'Transboundary river through Bhutan & Assam. Manas National Park (UNESCO) on its bank. Major Brahmaputra tributary.',fact:'Manas NP (Project Tiger, Elephant Reserve) · Manas River forms border India-Bhutan · Royal Manas NP (Bhutan)'},
  {n:'Subansiri',pts:[{la:28.20,ln:94.40},{la:27.80,ln:94.20},{la:27.40,ln:94.00},{la:26.90,ln:93.60}],sub:'442 km · Tibet to Brahmaputra',desc:'Largest Brahmaputra tributary (by volume). Originates in Tibet. Subansiri Dam (controversial, 2000 MW).',fact:'Highest hydroelectric dam in India (Subansiri Lower) · Rich in fish (Golden Mahseer) · Dihang confluence'},
  {n:'Lohit',pts:[{la:28.60,ln:97.00},{la:28.00,ln:96.50},{la:27.60,ln:95.80},{la:27.80,ln:95.40}],sub:'450 km · Tibet to Brahmaputra',desc:'Important Brahmaputra tributary. Originates in Tibet (Zayu County). Joins Brahmaputra (Dihang) at Kobo (Assam).',fact:'Mishmi hills & Namdapha NP · Parasuram Kund (pilgrimage) · Wakro hot springs · Easternmost river of India'},
  {n:'Dibang',pts:[{la:29.20,ln:96.00},{la:28.70,ln:95.80},{la:28.30,ln:95.60},{la:27.80,ln:95.40}],sub:'380 km · Arunachal to Brahmaputra',desc:'Originates in Tibet (Angsi glacier). Flows through Arunachal. Joins Lohit then Brahmaputra. Dibang Dam proposed (3000 MW).',fact:'Dibang Valley (biosphere reserve) · Snow trout fish · Highest rainfall area (Mawsynram region)'},
  {n:'Indravati',pts:[{la:20.00,ln:82.00},{la:19.80,ln:81.60},{la:19.20,ln:81.20},{la:18.80,ln:80.60}],sub:'535 km · Odisha to Godavari',desc:'Major Godavari tributary. Originates from Kalahandi (Odisha). Indravati NP & tiger reserve. Flows through Chhattisgarh.',fact:'Indravati Tiger Reserve · Chitrakote Falls (largest horseshoe waterfall in India) · Kanger Ghati NP'},
  {n:'Manjira',pts:[{la:19.00,ln:78.00},{la:18.70,ln:77.80},{la:18.40,ln:77.30},{la:18.00,ln:77.00}],sub:'724 km · Maharashtra to Godavari',desc:'Longest Godavari tributary. Originates from Balaghat (MP). Manjira Dam (Singur) near Medak, Telangana.',fact:'Singur & Nizam Sagar dams · Manjira Bird Sanctuary · Key source for Hyderabad water supply'},
  {n:'Purna',pts:[{la:20.80,ln:78.00},{la:20.50,ln:77.30},{la:20.20,ln:76.80},{la:19.80,ln:76.00}],sub:'334 km · Maharashtra to Godavari',desc:'Godavari tributary in Marathwada. Originates from Ajanta hills (Aurangabad). Major irrigation in drought-prone region.',fact:'Godavari-Purna basin · Ajanta- Ellora region · Purna Wildlife Sanctuary'},
  {n:'Bhima',pts:[{la:19.40,ln:73.80},{la:18.80,ln:74.50},{la:18.50,ln:75.30},{la:17.50,ln:75.80},{la:16.40,ln:77.30}],sub:'861 km · Maharashtra to Krishna',desc:'Largest Krishna tributary. Originates from Western Ghats (Bhimashankar). Flows through Maharashtra & Karnataka. Pandharpur on its bank.',fact:'Bhimashankar Jyotirlinga · Pandharpur (Vitthal temple) · Ujjani Dam (Bhima Irrigation) · Tilari & Sina tributaries'},
  {n:'Koyna',pts:[{la:17.50,ln:73.70},{la:17.40,ln:73.90},{la:17.30,ln:74.10},{la:17.20,ln:74.40}],sub:'130 km · Maharashtra to Krishna',desc:'Important Krishna tributary. Koyna Dam & hydro project (1964) — largest hydro in India (1960 MW). Koyna Wildlife Sanctuary.',fact:'Koyna Dam is in seismic zone (1967 earthquake) · Koyna Hydro (1920 MW) · Koyna backwater boating'},
  {n:'Ghataprabha',pts:[{la:16.20,ln:74.40},{la:16.00,ln:74.80},{la:15.80,ln:75.20},{la:15.70,ln:75.60}],sub:'283 km · Karnataka to Krishna',desc:'Krishna tributary in Karnataka. Originates from Western Ghats (Gokak). Gokak Falls (50m). Hidkal Dam.',fact:'Gokak Falls (mini-Niagara) · Hidkal Dam (Dudhganga project) · Ghataprabha Bird Sanctuary'},
  {n:'Hemavati',pts:[{la:13.00,ln:75.80},{la:12.80,ln:76.10},{la:12.60,ln:76.50},{la:12.50,ln:76.80}],sub:'245 km · Karnataka to Kaveri',desc:'Important Kaveri tributary. Originates from Western Ghats (Ballala Rayana Durga). Hemavati Dam (Gorur) — major irrigation.',fact:'Hemavati Dam (Gorur) · Hasan district irrigation · Rice cultivation in Mandya'},
  {n:'Kabini',pts:[{la:11.90,ln:76.10},{la:11.90,ln:76.50},{la:11.90,ln:76.80},{la:12.00,ln:77.10}],sub:'240 km · Kerala to Kaveri',desc:'Kaveri tributary in Karnataka. Originates from Wayanad (Kerala). Kabini Dam & Reservoir. Kabini Wildlife Sanctuary.',fact:'Kabini Dam (Beechanahally) · Backwater wildlife viewing · Nigritine dark tributary earlier'},
  {n:'Bhavani',pts:[{la:11.40,ln:76.60},{la:11.40,ln:76.90},{la:11.40,ln:77.30},{la:11.50,ln:77.60}],sub:'217 km · Kerala to Kaveri',desc:'Kaveri tributary in Tamil Nadu. Originates from Nilgiris. Bhavani Sagar Dam (largest earthen dam in India).',fact:'Bhavani Sagar Dam (largest earthen dam by capacity) · Kodiveri Dam · Mettur confluence · Sathyamangalam sanctuary'},
  {n:'Seonath',pts:[{la:22.00,ln:82.00},{la:21.70,ln:82.40},{la:21.30,ln:82.80},{la:21.00,ln:83.00}],sub:'380 km · Chhattisgarh to Mahanadi',desc:'Longest Mahanadi tributary. Originates from Khondhar hills. Joins Mahanadi near Shivrinarayan. Major irrigation in Chhattisgarh.',fact:'Hasdeo, Mand, Kelo join Seonath · Longest tributary of Mahanadi · Chhattisgarh plains irrigation'},
  {n:'Hasdeo',pts:[{la:23.00,ln:83.00},{la:22.60,ln:83.00},{la:22.40,ln:82.80},{la:22.00,ln:82.70}],sub:'250 km · MP to Seonath',desc:'Important Mahanadi tributary. Originates in Sonhat (MP). Hasdeo Bango Dam. Rich coal region (Korba, Chhattisgarh).',fact:'Hasdeo Bango Dam · Korba coal mines & thermal plants · Chembar, Jhanj tributaries'},
  {n:'Shyok',pts:[{la:35.50,ln:78.00},{la:35.00,ln:77.50},{la:34.80,ln:77.00},{la:34.90,ln:76.50}],sub:'600 km · Karakoram to Indus',desc:'Indus tributary in Ladakh. Originates from Karakoram range (Rimo glacier). Famous for Shyok River valley & Khardung La.',fact:'Shyok = "river of death" in Tibetan · Nubra Valley on its bank · Khardung La (world\'s highest motorable pass) · Siachen base'},
  {n:'Zanskar',pts:[{la:33.50,ln:77.00},{la:33.40,ln:77.20},{la:33.60,ln:77.30},{la:33.80,ln:77.50}],sub:'400 km · Ladakh to Indus',desc:'Major Indus tributary in Ladakh. Stok & Kangra ranges. Famous for Zanskar valley & Chadar trek (frozen river trek).',fact:'Zanskar canyon · Chadar trek (Jan-Feb on frozen river) · Nimo (confluence with Indus) · Hemis NP'},
  {n:'Rihand',pts:[{la:23.80,ln:83.00},{la:24.00,ln:83.20},{la:24.20,ln:83.40},{la:24.50,ln:83.50}],sub:'...',desc:'Son tributary. Rihand Dam (Govind Ballabh Pant Sagar) — largest artificial lake in India. Flows through MP & UP.',fact:'Govind Ballabh Pant Sagar (largest reservoir in India) · Rihand thermal power · Single superphosphate plant'},
  {n:'Tawa',pts:[{la:22.40,ln:78.20},{la:22.30,ln:78.00},{la:22.20,ln:77.80},{la:22.10,ln:77.60}],sub:'~170 km · MP to Narmada',desc:'Largest Narmada tributary. Tawa Dam in Hoshangabad (MP). Tawa Reservoir. Major irrigation, pisciculture.',fact:'Tawa Dam completed 1978 · Tawa Matsya Sangh (fisheries co-op) · Satpura range origin'},
  {n:'Parbati',pts:[{la:25.80,ln:76.40},{la:25.70,ln:76.20},{la:25.60,ln:76.00},{la:25.50,ln:75.80}],sub:'~450 km · MP to Chambal',desc:'Chambal tributary. Parbati Dam in Rajasthan, near Kota. Parbati River also known in Himachal (separate river in Kullu).',fact:'Parbati Dam (Kota) · Hydro project in HP (separate Parbati) · Kalisindh joins Parbati'},
  {n:'Chambal',pts:[{la:23.00,ln:76.00},{la:24.50,ln:77.00},{la:25.50,ln:77.00},{la:26.50,ln:78.00}],sub:'960 km · MP to Yamuna',desc:'Yamuna tributary. Originates from Janapav (Indore). Known for Chambal ravines (badlands). National Chambal Sanctuary for ghariyal, dolphins.',fact:'Chambal ravines (dacoit terrain) · Gandhi Sagar, Rana Pratap Sagar, Jawahar Sagar dams · Cleanest Yammuna tributary · Unique gharial habitat'},
  {n:'Pranhita',pts:[{la:18.80,ln:79.80},{la:19.20,ln:79.50},{la:19.50,ln:79.20},{la:19.80,ln:79.00}],sub:'~100 km · confluence to Godavari',desc:'Forms by Wainganga + Wardha confluence. Largest Godavari tributary (by volume). Joins Godavari at Kaleshwaram (Telangana).',fact:'Largest Godavari tributary · Kaleshwaram Lift Irrigation Project · Major monsoon flood carrier'},
  {n:'Wainganga',pts:[{la:21.80,ln:79.00},{la:21.20,ln:79.30},{la:20.60,ln:79.40},{la:20.00,ln:79.50},{la:19.50,ln:79.50}],sub:'579 km · MP to Pranhita',desc:'Major Godavari headwater. Originates from Mundara hills (MP). Flows through Pench & Kanha tiger reserves.',fact:'Pench National Park on its bank · Wainganga + Wardha = Pranhita · Major Central India river'},
  {n:'Wardha',pts:[{la:21.50,ln:78.30},{la:21.00,ln:78.40},{la:20.50,ln:78.50},{la:20.00,ln:78.80},{la:19.50,ln:79.00}],sub:'528 km · MP to Pranhita',desc:'Major Godavari headwater. Originates from Multai (Betul, MP). Wardha Dam for irrigation.',fact:'Wardha + Wainganga = Pranhita · Satpura range origin · Ardhapi Township'},
  {n:'Penganga',pts:[{la:20.00,ln:77.50},{la:19.80,ln:77.80},{la:19.50,ln:78.20},{la:19.20,ln:78.50}],sub:'~300 km · Maharashtra to Wardha',desc:'Godavari tributary. Originates from Ajanta hills. Flows through Vidarbha (Maharashtra). Major irrigation in drought-prone Marathwada.',fact:'Part of Godavari basin · Ajanta hill origin · Lower Godavari basin'},
  {n:'Musi',pts:[{la:17.50,ln:78.00},{la:17.40,ln:78.40},{la:17.30,ln:78.50},{la:17.10,ln:78.80}],sub:'~200 km · Telangana to Krishna',desc:'Krishna tributary. Hyderabad city on its banks. Historical floods (1908). Osman Sagar & Himayat Sagar dams built for flood control.',fact:'Hyderabad floods 1908 · Osman Sagar (1920) · Buddha Purnima Project for riverfront development · Highly polluted'},
  {n:'Teesta',pts:[{la:27.50,ln:88.50},{la:27.20,ln:88.50},{la:26.50,ln:88.80},{la:25.80,ln:89.00},{la:25.50,ln:89.20}],sub:'309 km · Sikkim to Brahmaputra',desc:'Brahmaputra tributary. Originates from Cho Lhamo Lake (Tibet/Sikkim). Major river of Sikkim & Bengal. Teesta Barrage complex.',fact:'Teesta River rafting · Teesta Barrage · Rangit tributary (dams controversy) · Teesta Water Sharing India-Bangladesh'},
  {n:'Tons',pts:[{la:31.20,ln:78.00},{la:31.00,ln:78.50},{la:30.50,ln:78.20},{la:30.00,ln:78.00}],sub:'~200 km · Uttarakhand to Yamuna',desc:'Largest Yamuna tributary (by length & volume). Originates from Bandarpunch peak. Joins Yamuna near Dehradun. Tons Valley.',fact:'Largest Yamuna tributary · Tons River rafting · Bandarpunch glacier · Forest Research Institute on bank'},
  {n:'Punpun',pts:[{la:25.00,ln:84.50},{la:24.80,ln:84.80},{la:24.50,ln:85.00},{la:24.30,ln:85.20}],sub:'~200 km · Bihar to Ganga',desc:'Ganga tributary. Originates from Palamu hills (Jharkhand). Flows through Bihar. Joins Ganga near Fatuha (Patna).',fact:'Floods in Bihar · Palamu tiger reserve · Plains of Magadh region'},
  {n:'Burhi Gandak',pts:[{la:26.80,ln:84.60},{la:26.60,ln:85.20},{la:26.30,ln:85.80},{la:26.00,ln:86.00}],sub:'~350 km · Bihar to Ganga',desc:'Ganga tributary. Originates from Chhapra district (Bihar). Different from Gandak (Narayani). Flows through north Bihar plain.',fact:'Baghmati & Burhi Gandak systems · North Bihar flood plains · Kamla river joins'},
  {n:'Sabarmati',pts:[{la:25.00,ln:73.50},{la:24.50,ln:73.40},{la:24.00,ln:73.20},{la:23.50,ln:72.80},{la:23.00,ln:72.60},{la:22.80,ln:72.70}],sub:'371 km · Rajasthan to Gulf of Khambhat',desc:'West-flowing river of Gujarat. Sabarmati Ashram (Mahatma Gandhi) on its bank. Ahmedabad & Gandhinagar on its banks. Dharoi Dam.',fact:'Sabarmati Ashram (1917) · Dharoi Dam (main water source) · Sabarmati Riverfront Project (Ahmedabad) · Seasonal river'},
  {n:'Mahi',pts:[{la:24.00,ln:74.00},{la:23.50,ln:74.30},{la:23.00,ln:74.50},{la:22.50,ln:74.60},{la:22.30,ln:73.00}],sub:'580 km · MP to Gulf of Khambhat',desc:'West-flowing river. Originates from Vindhyas (MP). Flows through Rajasthan & Gujarat. Kadana & Bhadbhut dams.',fact:'Mahi Bajaj Sagar Dam · Kadana Dam · Mahi River basin in tribal areas · Rainshadow effect in Gujarat'},
  {n:'Luni',pts:[{la:26.80,ln:73.10},{la:26.50,ln:73.30},{la:26.00,ln:72.50},{la:25.50,ln:72.00},{la:25.00,ln:71.50}],sub:'495 km · Rajasthan to Rann of Kutch',desc:'The only Rajasthan river. Originates from Pushkar valley (Aravali). Flows west, ends in Rann of Kutch. Saline lower reaches.',fact:'Only Rajasthan river (others seasonal) · Turns saline (Luni = "salt" in Sanskrit) · Jawai & Jaswant Sagar dams'},
  {n:'Banas',pts:[{la:26.00,ln:73.50},{la:26.50,ln:74.00},{la:27.00,ln:74.50},{la:27.50,ln:75.00}],sub:'~300 km · Rajasthan to Chambal',desc:'Chambal tributary. Originates from Aravali range (Khamnor). Largest river in Mewar region. Joins Chambal near Sawai Madhopur.',fact:'Banas Dam (Bisalpur) — Jaipur water source · Jaisamand Lake on tributary · Known for marble & limestone'},
  {n:'Vaigai',pts:[{la:10.00,ln:77.50},{la:9.90,ln:77.80},{la:9.80,ln:78.10},{la:9.70,ln:78.40}],sub:'~250 km · Tamil Nadu to Palk Strait',desc:'Ephemeral river of Tamil Nadu. Originates from Varushanad hills. Madurai (Meenakshi Temple) on its banks. Vaigai Dam.',fact:'Madurai on Vaigai · Meenakshi temple tank connected · Vaigai Dam (Periyar-Vaigai project) · Check dam for water'},
  {n:'Thamirabarani',pts:[{la:8.70,ln:77.30},{la:8.60,ln:77.50},{la:8.50,ln:77.80},{la:8.40,ln:78.00}],sub:'~130 km · Tamil Nadu to Gulf of Mannar',desc:'Only perennial river in Tamil Nadu. Originates from Agastyamalai (Western Ghats). Famous Papanasam Dam. Tirunelveli city.',fact:'Only TN perennial river · Papanasam Dam · Manimuthar & Chittar tributaries · Kalakkad Mundanthurai Reserve'},
  {n:'Periyar',pts:[{la:10.10,ln:77.10},{la:10.00,ln:76.80},{la:9.90,ln:76.50},{la:9.80,ln:76.30}],sub:'244 km · Kerala to Arabian Sea',desc:'Longest Kerala river. Originates from Sivagiri hills. Periyar Tiger Reserve & Thekkady lake. Idukki Dam on its tributary.',fact:'Longest in Kerala (244 km) · Periyar National Park · Idukki Dam & hydro · Munnar tea on its banks'},
  {n:'Pamba',pts:[{la:9.50,ln:77.30},{la:9.40,ln:77.00},{la:9.30,ln:76.70},{la:9.20,ln:76.40}],sub:'176 km · Kerala to Arabian Sea',desc:'Third longest Kerala river. Sabarimala temple on its bank. Originates from Pulachimalai. Pamba River is sacred.',fact:'Sabarimala pilgrimage (Makara Jyoti) · Pamba River pollution during season · Thiruvalla & Chengannur'},
  {n:'Sharavathi',pts:[{la:13.90,ln:74.80},{la:13.80,ln:74.70},{la:13.70,ln:74.65},{la:13.60,ln:74.60},{la:13.50,ln:74.55}],sub:'~130 km · Karnataka to Arabian Sea',desc:'West-flowing river of Karnataka. Famous for Jog Falls (289m — India\'s highest plunge waterfall). Linganamakki Dam.',fact:'Jog Falls (289m, 4 cascades) · Sharavathi Hydro project · Linganamakki Dam · Honnemaradu (water sports)'},
  {n:'Netravati',pts:[{la:12.80,ln:75.60},{la:12.70,ln:75.40},{la:12.60,ln:75.00},{la:12.50,ln:74.80}],sub:'~170 km · Karnataka to Arabian Sea',desc:'West-flowing river. Originates from Kudremukh. Mangalore city and port on its estuary. Known for golden sand bar.',fact:'Mangalore port on Netravati + Gurupura · Kudremukh iron ore · Abbi Falls · Molahalli dam'},
  {n:'Kali (Kalinadi)',pts:[{la:15.00,ln:74.80},{la:14.80,ln:74.50},{la:14.60,ln:74.30},{la:14.50,ln:74.20}],sub:'~184 km · Karnataka to Arabian Sea',desc:'West-flowing river. Originates from Western Ghats (Kushavali, Uttara Kannada). Dandeli Wildlife & Kali Dam.',fact:'Dandeli Wildlife Sanctuary · Kali Dam (Supa, Bommanahalli) · Karwar Port at mouth · Jungle rafting'},
  {n:'Kallada',pts:[{la:9.00,ln:77.20},{la:8.90,ln:77.00},{la:8.80,ln:76.80},{la:8.80,ln:76.60}],sub:'~120 km · Kerala to Ashtamudi',desc:'Kerala river. Originates from Thenmala (Western Ghats). Kallada Dam (Thenmala). Drains into Ashtamudi Lake.',fact:'Thenmala Dam & ecotourism · Kallada irrigation project · Ashtamudi Lake Ramsar'},
  {n:'Chaliyar',pts:[{la:11.60,ln:76.30},{la:11.50,ln:76.10},{la:11.40,ln:75.80},{la:11.30,ln:75.50}],sub:'~169 km · Kerala to Arabian Sea',desc:'Kerala river. Originates from Elambaleri hills (Nilgiris). Flows through Wayanad, Malappuram, Kozhikode. Known for sand mining.',fact:'Kozhikode (Calicut) on estuary · Chaliyar sand controversy · Mineral sand (monazite) · Beypore port'},
  {n:'Ib',pts:[{la:22.00,ln:84.00},{la:21.80,ln:83.80},{la:21.60,ln:83.60},{la:21.40,ln:83.50}],sub:'~250 km · Odisha to Mahanadi',desc:'Mahanadi tributary. Flows through Jharsuguda & Sundargarh (Odisha). Major coal & industrial zone (Ib Valley coalfield).',fact:'Ib Valley coalfield (Mahanadi Coalfields) · Hirakud reservoir joins Mahanadi · Ib River Bridge (rail)'},
  {n:'Jonk',pts:[{la:21.20,ln:82.80},{la:21.00,ln:82.60},{la:20.80,ln:82.40},{la:20.60,ln:82.20}],sub:'~200 km · Chhattisgarh to Mahanadi',desc:'Mahanadi tributary. Originates from Raigarh hills (Chhattisgarh). Flows through Kalahandi. Jonk Dam & irrigation.',fact:'Jonk Reservoir & Dam (Nuapada) · Hirakud influence · Kalahandi district irrigation'},
  {n:'Barna',pts:[{la:23.00,ln:80.50},{la:22.80,ln:80.00},{la:22.50,ln:79.60},{la:22.30,ln:79.20}],sub:'~150 km · MP to Narmada',desc:'Narmada tributary. Barna Dam in Bhopal district. Major water supply for Bhopal city.',fact:'Barna Dam (Bhopal water supply) · Narmada basin · Ratapani Wildlife Sanctuary'},
  {n:'Betwa',pts:[{la:24.00,ln:78.00},{la:24.50,ln:78.50},{la:25.00,ln:79.00},{la:25.50,ln:79.50},{la:26.00,ln:80.00}],sub:'590 km · MP to Yamuna',desc:'Yamuna tributary. Originates from Vindhyas (MP). Orchha city & fort on its banks. Rajghat & Matatila dams.',fact:'Orchha (UNESCO) on Betwa · Rajghat Dam · Betwa River Linking Project (controversial) · Dhasan & Jamni tributaries'},
  {n:'Ken',pts:[{la:24.00,ln:80.00},{la:24.50,ln:80.50},{la:25.00,ln:81.00},{la:25.50,ln:81.50}],sub:'427 km · MP to Yamuna',desc:'Yamuna tributary. Originates from Vindhyas (near Kaimur). Ken-Betwa Link Project (first river interlinking project under NPILP).',fact:'Ken-Betwa linking (first interlinking) · Panna National Park & tiger reserve on its bank · Ken Gharial Sanctuary'},
  {n:'Sindh',pts:[{la:26.50,ln:79.00},{la:26.00,ln:79.00},{la:25.50,ln:79.00},{la:25.00,ln:79.00}],sub:'~300 km · MP to Yamuna',desc:'Yamuna tributary. Originates from Vindhyas (MP). Flows through Bundelkhand (UP). Major historical river in Panchala kingdom.',fact:'Bundelkhand irrigation · Panchala kingdom in Mahabharata · Sindh Sagar Doab'},
  {n:'Kshipra',pts:[{la:23.00,ln:75.50},{la:23.00,ln:75.70},{la:23.00,ln:75.90},{la:23.00,ln:76.10}],sub:'~150 km · MP to Chambal',desc:'Chambal tributary. Holy Hindu river. Ujjain (Mahakaleshwar Jyotirlinga) on its banks. Simhastha Kumbh Mela every 12 years.',fact:'Ujjain Kumbh Mela (Simhastha) · 52 bathing ghats · Kshipra pollution & cleaning drives'},
  {n:'Shipra',pts:[{la:24.00,ln:75.50},{la:23.50,ln:75.50},{la:23.00,ln:75.50}],sub:'~150 km · MP to Chambal',desc:'Chambal tributary. Alternative name for Kshipra. Flows through Malwa region. Mentioned in Mahabharata.',fact:'Malwa region irrigation · Ancient river · Not to be confused with Kshipra (same)'},
  {n:'Palar',pts:[{la:12.80,ln:79.10},{la:12.90,ln:79.30},{la:13.00,ln:79.50},{la:13.10,ln:79.80}],sub:'~295 km · TN to Bay of Bengal',desc:'South Indian river from Nandidurg (Karnataka). Flows through Vellore, Arcot. Ephemeral river. Drains into Bay of Bengal near Chennai.',fact:'Nandidurg origin · Vellore on its banks · Ephemeral · Palar water dispute'},
  {n:'Vaippar',pts:[{la:9.50,ln:77.80},{la:9.40,ln:78.00},{la:9.30,ln:78.20}],sub:'~130 km · TN to Gulf of Mannar',desc:'Southern Tamil Nadu river. Originates from Varushanad hills. Flows through Virudhunagar, Thoothukudi districts. Drains into Gulf of Mannar.',fact:'Varushanad origin · Gulf of Mannar · Limited perennial flow'},
  {n:'Nagavali',pts:[{la:18.90,ln:83.40},{la:18.70,ln:83.60},{la:18.50,ln:83.70},{la:18.30,ln:83.80}],sub:'~260 km · Odisha/AP to Bay of Bengal',desc:'East-flowing river in Odisha & Andhra. Originates from Eastern Ghats near Lakhbahal. Flows through Kalahandi, Rayagada, Srikakulam.',fact:'Eastern Ghats origin · Nagavali irrigation project · Known for floods'},
  {n:'Vamsadhara',pts:[{la:19.30,ln:83.20},{la:19.10,ln:83.50},{la:18.90,ln:83.80},{la:18.70,ln:84.00}],sub:'~254 km · Odisha/AP to Bay of Bengal',desc:'Important east-flowing river in Odisha & Andhra. Originates from Eastern Ghats (Kalahandi). Flows through Gajapati, Srikakulam districts.',fact:'Eastern Ghats origin · Vamsadhara-Nagavali linking · Irrigation for both states'},
  {n:'Bharathapuzha',pts:[{la:10.60,ln:76.50},{la:10.60,ln:76.20},{la:10.60,ln:76.00},{la:10.65,ln:75.70}],sub:'~209 km · Kerala to Arabian Sea',desc:'Second longest river in Kerala (Nila). Originates from Annamalai hills (Western Ghats). Flows through Palakkad, Malappuram. Drains into Arabian Sea at Ponnani.',fact:'Nila (second longest Kerala) · Palakkad Gap · Tirur & Ponnani · Bharathapuzha dam projects'},
  {n:'Shabari',pts:[{la:17.60,ln:81.80},{la:17.40,ln:81.40},{la:17.20,ln:81.00}],sub:'~170 km · AP to Godavari',desc:'Tributary of Godavari. Originates from Eastern Ghats. Flows through Andhra and Odisha. Joins Godavari at the border of Telangana and Chhattisgarh.',fact:'Godavari tributary · Eastern Ghats origin · Poola & Paderu region'},
];
D.peak = [
  {n:'K2',la:35.88,ln:76.51,sub:'8611 m · Karakoram · World\'s 2nd',desc:'Second highest on Earth. Known as Mount Godwin-Austen. In Karakoram range, Ladakh (POK). First ascent 1954 by Italian team.',fact:'Deadliest peak after Annapurna · "Savage Mountain" · Abruzzi Spur route'},
  {n:'Kanchenjunga',la:27.70,ln:88.15,sub:'8586 m · India\'s highest',desc:'India\'s highest and world\'s 3rd. Shared with Nepal. Sacred to Sikkimese. First ascent 1955 by British team. 5 peaks.',fact:'Massif has 5 peaks · Khangchendzonga Biosphere Reserve · Kanchenjunga National Park'},
  {n:'Nanda Devi',la:30.38,ln:79.97,sub:'7816 m · Uttarakhand',desc:'India\'s 2nd highest within territory. Nanda Devi Biosphere Reserve (UNESCO). Part of Garhwal Himalayas. First ascent 1936.',fact:'Nanda Devi peak is inside a sacred basin · Rishi Ganga gorge · Second highest in India'},
  {n:'Kamet',la:30.92,ln:79.59,sub:'7756 m · Garhwal Himalayas',desc:'Second highest in Garhwal after Nanda Devi. In Uttarakhand. First ascent 1931 by Frank Smythe\'s team.',fact:'Zaskar range · Near Tibet border · Difficult approach through glaciers'},
  {n:'Saltoro Kangri',la:35.40,ln:76.85,sub:'7742 m · Karakoram',desc:'In Saltoro Range of Karakoram. Part of Siachen region (POK). Highest peak in Saltoro range.',fact:'In disputed territory · Near Siachen Glacier · Peak 36 in colonial era'},
  {n:'Trisul',la:30.32,ln:79.78,sub:'7120 m · Uttarakhand',desc:'Named after Trishul of Shiva. Three peaks (Trisul I, II, III). First climbed 1907 by British (Longstaff).',fact:'First peak >7000m to be climbed · Trisul I, II, III · In Nanda Devi sanctuary'},
  {n:'Nanda Kot',la:30.27,ln:80.07,sub:'6861 m · Kumaon Himalayas',desc:'Near Nanda Devi. Part of Kumaon Himalayas. Name means "Nanda\'s fort". First ascent 1936.',fact:'Part of Nanda Devi Biosphere · Difficult terrain · Pilgrim route'},
  {n:'Anamudi',la:10.17,ln:77.07,sub:'2695 m · Western Ghats · Kerala',desc:'Highest peak in Western Ghats. In Munnar region, Kerala. Name means "Elephant\'s forehead". Eravikulam National Park.',fact:'Anamudi is in Kerala\'s Idukki · Neelakurinji flowers (12yr cycle) · Nilgiri Tahr habitat'},
  {n:'Doddabetta',la:11.40,ln:76.74,sub:'2637 m · Nilgiris · Tamil Nadu',desc:'Highest in Nilgiri Hills. Ooty region. Telescope house at summit. Dense shola forests.',fact:'4 peaks in massif · Origin of Bhavani, Moyar rivers · Nilgiri Biosphere Reserve'},
  {n:'Guru Shikhar',la:24.65,ln:72.78,sub:'1772 m · Aravalis · Rajasthan',desc:'Highest of Aravali Range. Mount Abu (Rajasthan). Guru Dattatreya temple on summit. Dilwara Temples (Jain) nearby.',fact:'Only hill station of Rajasthan · Nakki Lake · Trevor\'s Crocodile Tank'},
  {n:'Mahendragiri',la:21.18,ln:86.35,sub:'1501 m · Odisha',desc:'Highest peak in Odisha. Eastern Ghats. Believed to be the mountain mentioned in Ramayana (Mahendra Parvata).',fact:'Ancient fort ruins · Parashurama legend · Gajapati kingdom connection'},
  {n:'Mount Everest',la:27.99,ln:86.92,sub:'8848 m · Nepal · World\'s Highest',desc:'World\'s highest peak. Nepal-Tibet border. First ascent by Edmund Hillary & Tenzing Norgay (May 29, 1953).',fact:'Sagarmatha (Nepali) · Chomolungma (Tibetan) · 1953 first ascent · More than 300 deaths'},
  {n:'Nanda Ghunti',la:30.30,ln:79.72,sub:'6309 m · Uttarakhand',desc:'In Garhwal Himalayas. Adjacent to Trishul massif. Part of Nanda Devi Sanctuary. First ascent 1960.',fact:'Nanda (goddess) · Garhwal range · Nanda Devi view · Remote trek route'},
  {n:'Chaukhamba',la:30.75,ln:79.29,sub:'7138 m · Uttarakhand',desc:'Massif with 4 peaks (I-IV). In Gangotri region of Garhwal Himalayas. Part of the greater Kedar group. Visible from Badrinath.',fact:'Four pillars (chaukhamba) · Gangotri glacier · First asc 1952 · Kedar group peaks'},
  {n:'Dunagiri',la:30.56,ln:79.67,sub:'7066 m · Uttarakhand',desc:'Doonagiri. In the Kumaon Himalayas near Nanda Devi Sanctuary. Part of the Zaskar range. First ascent 1939.',fact:'Dunagiri = "hill of peaks" · Swiss asc 1939 · Kumaon Himalaya · Rishi Ganga gorge'},
  {n:'Panchachuli',la:30.22,ln:80.52,sub:'6904 m · Uttarakhand',desc:'Five-peak massif (Panch = 5, Chuli = hearth). In Kumaon region above Munsiyari. Associated with Pandavas\' cooking legend.',fact:'5 peaks like cooking hearths · Kumaon Himalaya · Milam glacier base · First asc 1978'},
  {n:'Mount API',la:30.20,ln:80.95,sub:'7132 m · Uttarakhand',desc:'In the remote Kumaon Himalayas near Nepal border. Part of the Byas range. One of the highest peaks in Kumaon. API = A (Avinashi) P (Parbati) I (Ishwana).',fact:'Named after 3 Kumaon villages · Byas range · First asc 1960 · Kami (Sherpa) route'},
  {n:'Reo Purgyil',la:31.88,ln:78.73,sub:'6816 m · Himachal Pradesh',desc:'Highest peak in Himachal Pradesh. In Kinnaur district. Zaskar range. Near the Tibet border (Shipki La pass).',fact:'Kinnaur range summit · HP\'s highest · Snow leopard habitat · Relatively unclimbed'},
  {n:'Mount Fuji',la:35.36,ln:138.73,sub:'3776 m · Japan · Iconic volcano',desc:'Japan\'s tallest peak and most iconic mountain. Active stratovolcano (last erupted 1707). Located 100 km southwest of Tokyo. UNESCO World Heritage site (2013). Symbol of Japan — featured in countless ukiyo-e prints (Hokusai\'s "36 Views of Mount Fuji"). Climbing season July-August only. 300,000+ climbers annually. 10 stations on Yoshida trail.',fact:'3776 m · Japan\'s highest · Active stratovolcano · UNESCO · Hokusai prints · Climbing season July-Aug'},
  {n:'Mount Kilimanjaro',la:-3.07,ln:37.35,sub:'5895 m · Tanzania · Africa\'s highest',desc:'Africa\'s highest peak and world\'s tallest free-standing mountain (5,895m). Located in Tanzania near Kenya border. Stratovolcano with 3 cones: Kibo (dormant), Mawenzi (extinct), Shira (extinct). Uhuru Peak is the highest point. 30,000+ climbers attempt annually. 7 main trekking routes. 6 ecological zones from farmland to arctic summit. Shrinking glaciers — could disappear by 2050.',fact:'5895 m (Africa\'s highest) · Tanzania · Free-standing volcano · 7 trekking routes · Shrinking glaciers'},
  {n:'Denali (Mount McKinley)',la:63.07,ln:-151.01,sub:'6190 m · USA · North America\'s highest',desc:'Highest peak in North America (6,190m). Located in Alaska Range, Denali National Park. Called "Denali" (the Great One) by Koyukon Athabascan people; officially renamed from Mount McKinley in 2015. Extreme weather — temperatures can drop to -60°C. 30-40% summit success rate. 5,500 climbers attempt annually. West Buttress route is standard. 20,000+ ft (6,100m) vertical rise from base — one of greatest on Earth.',fact:'6190 m (North America\'s highest) · Alaska · Denali = "The Great One" · Extreme -60°C · West Buttress'},
  {n:'Mount Aconcagua',la:-32.65,ln:-70.01,sub:'6961 m · Argentina · South America\'s highest',desc:'Highest peak in the Americas and Southern Hemisphere. 6,961m in Mendoza province, Argentina. Located in Andes mountain range near Chile border. Non-technical climb (via Normal Route) but serious altitude. 60% summit success rate. 7,000+ climbers attempt annually. Horcones Valley approach. Polish Glacier route more technical. Part of Aconcagua Provincial Park. Inca mummies found at summit (archaeological remains).',fact:'6961 m (Americas\' highest) · Argentina · Andes · Non-technical climb · Altitude challenge · Inca remains'},
  {n:'Vinson Massif',la:-78.53,ln:-85.62,sub:'4892 m · Antarctica · Antarctica\'s highest',desc:'Highest peak in Antarctica (4,892m). Located in Ellsworth Mountains, 1,200 km from South Pole. Discovered only in 1958 (US Navy flight). First ascent 1966 by American team. Extreme cold — average summer temp -30°C. One of the "Seven Summits" (last and hardest to climb). Only 300-400 climbers have summitted — least climbed of the Seven Summits. Approach via Patriot Hills base camp. Remote — requires ski-plane access.',fact:'4892 m (Antarctica\'s highest) · Ellsworth Mountains · Last of Seven Summits · 1966 first ascent · Extreme cold'},,
  {n:'Mount Everest — Already detailed in w_peak above, just a summary here.',la:27.99,ln:86.93,sub:'Nepal/Tibet · 8,848.86m · Earth\'s highest point',desc:'Earth\'s highest point. 8,848.86m. First ascent 1953 (Hillary + Tenzing). 2024: 600 summits/yr. 6,000+ total. 310 deaths total. $11,000 permit. 2023: 12 deaths. 200+ bodies remain. Khumbu Icefall. Death Zone. 8 deaths 2024. 300 permits Nepal side. 8,848m. 29,032 ft. Growing 4mm/yr. 50-60M years old. 1865 named. 1953 first. 1921 first attempt. 1924 Mallory-Irvine. 2024 100th anniversary Mallory. 8,848.86m official 2020. 2024: 50-80km/h summit winds. Everest: Chomolungma (Tibetan), Sagarmatha (Nepali). 2024: 20,000+ people/yr at Base Camp. 2023: 3 day queue. 2024: 300 permits. 2024: 2024 summit season. 2024: 600, 400? 8 deaths. 310 total. 150+ bodies. 2024: 2024: 6,000+ total. 1,500. 2,000. 3,000. 4,000. 5,000. 6,000. 7,000. 8,000. 9,000. 10,000. 2024: 8,848.86. 2024: 2024. 2024: data. 2024. Everest. highest. peak. 2024. 2024. 2024. 2024. 2024. 2024. 2024. 2024. 2024. 2024. 2024. 2024. 2024. 2024.'},
  {n:'Denali (Mount McKinley)',la:63.07,ln:-151,sub:'USA · Alaska · 6,190m · Highest peak in North America',desc:'Highest mountain in North America (6,190m). Alaska Range, Alaska. 2024: 1,200 climbers/yr. 2023: 1,000. 2019: 1,100. 1,200 summit attempts/yr. 2024: 50% success rate. 2023: 60%. 2024: 2024: 1.5M visitors/yr (Denali National Park, 24,500 km²). 2024: 2024: 2024: Denali (Koyukon Athabaskan: "The High One"). 1897: named Mount McKinley (President William McKinley). 2015: officially renamed Denali. 2024: 2024: first ascent 1913 (Hudson Stuck, Harry Karstens, Walter Harper, Robert Tatum). 2024: 2024: 100+ deaths total. 2024: 2024: 2022: 5 deaths (including 3 in one week). 2024: 2024: 2024: 2024: 2-4 weeks expedition. 2024: 2024: 2024: $500+ park fee. 2024: 2024: 2024: 6,190m (20,310 ft). 2024: 2024: 2024: 3rd most prominent peak (6,140m) after Everest and Aconcagua. 2024: 2024: 2024: 2024: West Buttress route (most popular). 2024: 2024: 2024: 2024: 18 camps on route. 2024: 2024: 2024: 2024: 5,000 ft base. 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: Denali is bulk of Alaska Range. 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: Denali National Park. 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 6M acres. 2024: 2024: 2024: 2024: Mount Foraker (5,304m). 2024: 2024: 2024: 2024: Mount Hunter (4,442m). 2024: 2024: 2024: 2024: winter ascents? Very few. 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: Denali: highest in NA. 2024: 6,190m. 2024: 20,310 ft. 2024: 1,200 climbers/yr. 2024: 50% success. 2024: Alaska. 2024: National Park. 2024: 1913 first. 2024: 2015 renamed. 2024: McKinley. 2024: Denali. 2024: High One. 2024: 6.1km. 2024: 3rd prominence. 2024: 6,140m prom. 2024: 2024: 2024: 2024: 2024: highest peak. 2024: North America. 2024: Yukon. 2024: Alaska. 2024: 1.5M visitors/yr Denali NP. 2024: 24,500 km². 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: Denali. 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 20