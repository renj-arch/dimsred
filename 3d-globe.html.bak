// ============================================================
// LAYER PANEL
// ============================================================
const panel = document.getElementById('layersPanel');
const CAT_ORDER = ['city','national_park','ramsar','wildlife','river','railway','peak','port','airport','dam','nuclear','biosphere','unesco','battle','temple','institution','kingdom','tiger','hill','bird','i_pass','w_city','w_river','w_peak','w_np','w_unesco','w_battle','w_landmark','w_inst','w_kingdom','strait','desert','lake','island','peninsula','volcano','gulf','canal','range','sea','waterfall','reef','canyon','cape','delta','latitude','current','phenomena','wind','cloud','forest','rainfall','plateau','plain','valley','w_pass','glacier','w_bridge','lighthouse','wonder','tower','w_dam','w_airport','tunnel','trade','oil','personality','highway','i_range','crop','mineral'];

// Auto-play state
let _ap=null; // {k, idx, items, timeout}
function stopAutoPlay(){
  if(_ap){clearTimeout(_ap.timeout);_ap=null;rotating=false;
    document.querySelectorAll('.ap-btn').forEach(b=>{b.textContent='▶';b.style.color='rgba(255,255,255,.35)'});
    document.getElementById('subtitle').classList.remove('show');
    if(window.speechSynthesis)speechSynthesis.cancel();
  }
}
function startAutoPlay(k,items,resumeIdx){
  stopAutoPlay();
  // Ensure layer is visible
  if(layerVis[k]===false){toggleLayer(k,true);
    const vb=document.querySelector(`[data-ap="${k}"]`)?.closest('.lay-section')?.querySelector('.vis-btn');
    if(vb){vb.style.color='rgba(255,255,255,.5)';vb.textContent='◉';}
  }
  rotating=true;
  let idx=resumeIdx||0;
  const btn=document.querySelector(`[data-ap="${k}"]`);
  function next(){
    if(!_ap){rotating=false;return;}
    if(idx>=items.length)idx=0; // loop
    const item=items[idx];
    const hasPos = item.la||item.ln||(item.pts&&item.pts.length);
    if(hasPos){
      flyTo(item,CAT[k],k);
      speakText(item.n+'. '+(item.sub||''));
      if(btn)btn.textContent=(idx+1)+'/'+items.length;
      idx++;
      if(idx>=items.length)idx=0;
      _ap.idx=idx; // persist position for resume
      _ap.timeout=setTimeout(next,4200);
    }else{
      idx++;
      if(idx>=items.length)idx=0;
      _ap.idx=idx; // persist position for resume
      _ap.timeout=setTimeout(next,800); // skip faster
    }
  }
  _ap={k,idx,items,timeout:null};
  if(btn){btn.textContent='⏹';btn.style.color='#a78bfa';}
  next();
}
function buildPanel(){
  panel.innerHTML='';
  const collapseAll = localStorage.getItem('upsc_atlas_collapse')==='true';
  let prevRegion='';
  CAT_ORDER.forEach(k=>{
    const cat=CAT[k]; if(!cat) return;
    const items=D[k]; if(!items||!items.length) return;
    if(cat.region&&cat.region!==prevRegion){
      if(prevRegion){const d=document.createElement('div');d.style.cssText='height:1px;background:rgba(255,255,255,.06);margin:6px 10px';panel.appendChild(d)}
      prevRegion=cat.region;
    }
    const startVis=layerVis[k]!==false;
    const startLbl=labelVis[k]===true;
    const sec=document.createElement('div');sec.className='lay-section';
    const head=document.createElement('div');head.className='lay-head';
    head.innerHTML=`<span>${cat.icon||'●'}</span> ${cat.label} <span class="cnt">${items.length}</span> <span class="ap-btn" style="font-size:.55em;cursor:pointer;color:rgba(255,255,255,.35);margin-right:3px" title="Auto-play: visit all sites">▶</span> <span class="lbl-btn" style="font-size:.6em;cursor:pointer;color:${startLbl?'#a78bfa':'rgba(255,255,255,.2)'};margin-right:4px" title="Toggle labels">${startLbl?'Aa':'<span style="opacity:0.4">Aa</span>'}</span> <span class="vis-btn" style="font-size:.65em;color:${startVis?'rgba(255,255,255,.5)':'rgba(255,255,255,.15)'}">${startVis?'◉':'○'}</span> <span class="arr ${collapseAll?'':'open'}">▶</span>`;
    const cont=document.createElement('div');cont.className=`lay-items ${collapseAll?'':'open'}`;
    cat.subItems = items;
    items.forEach(item=>{
      const it=document.createElement('div');it.className='lay-it';
      it.innerHTML=`<span class="dot" style="background:${cat.color}"></span><span class="lbl">${item.n}</span>`;
      it.addEventListener('click',()=>{
        if(_ap)stopAutoPlay();
        if(k==='kingdom'||k==='w_kingdom'){
          const wasSame=allMarkers.some(m=>(m.cat===k||m.cat===k)&&m._mesh&&m._kingdomSelected===item);
          allMarkers.forEach(m=>{
            if((m.cat==='kingdom'||m.cat==='w_kingdom')&&m._mesh){
              if(wasSame){m._mesh.visible=true;m._hide=false;m._kingdomSelected=null;if(m.el)m.el.visible=true;}
              else{const same=m.data===item;m._mesh.visible=same;m._hide=!same;m._kingdomSelected=same?item:null;if(m.el)m.el.visible=same;}
            }
          });
        }
        flyTo(item,cat,k);
      });
      cont.appendChild(it);
    });
    head.querySelector('.vis-btn').addEventListener('click',(e)=>{
      e.stopPropagation();
      const on=layerVis[k]===false;
      toggleLayer(k,on);
      e.target.style.color=on?'rgba(255,255,255,.5)':'rgba(255,255,255,.15)';
      e.target.textContent=on?'◉':'○';
    });
    const lblBtn=head.querySelector('.lbl-btn');
    if(lblBtn)lblBtn.addEventListener('click',(e)=>{
      e.stopPropagation();
      const on=labelVis[k]!==true;
      toggleLabel(k,on);
      lblBtn.innerHTML=on?'Aa':'<span style="opacity:0.4">Aa</span>';
      lblBtn.style.color=on?'#a78bfa':'rgba(255,255,255,.2)';
      updateLabels();
    });
    const apBtn=head.querySelector('.ap-btn');
    if(apBtn){apBtn.dataset.ap=k;
      apBtn.addEventListener('click',(e)=>{
        e.stopPropagation();
        if(_ap&&_ap.k===k){
          if(_ap.timeout){
            // Playing → pause
            clearTimeout(_ap.timeout);_ap.timeout=null;rotating=false;
            e.target.textContent='▶';e.target.style.color='rgba(255,255,255,.35)';
            document.getElementById('subtitle').classList.remove('show');
            if(window.speechSynthesis)speechSynthesis.cancel();
          }else{
            // Paused → resume from where we left off
            startAutoPlay(k,items,_ap.idx);
          }
          return;
        }
        startAutoPlay(k,items);
      });
    }
    head.addEventListener('click',(e)=>{
      if(e.target.classList.contains('vis-btn')||e.target.classList.contains('lbl-btn')||e.target.closest('.lbl-btn')||e.target.classList.contains('ap-btn'))return;
      cont.classList.toggle('open');
      head.querySelector('.arr').classList.toggle('open');
      localStorage.setItem('upsc_atlas_collapse',!cont.classList.contains('open'));
    });
    sec.appendChild(head);sec.appendChild(cont);panel.appendChild(sec);
  });
}
buildPanel();


// Layer panel toggle for mobile
const layToggle=document.getElementById('layToggle');
document.getElementById('layToggle').addEventListener('click',()=>{
  const p=document.getElementById('layersPanel');
  p.classList.toggle('collapsed');
  layToggle.textContent=p.classList.contains('collapsed')?'▶':'◀';
});

// ============================================================
// ERA BAR
// ============================================================
(function initEraBar(){
  const chips=document.getElementById('eraChips');
  const yearsEl=document.getElementById('eraYears');
  const toggle=document.getElementById('eraToggle');
  let collapsed=false;
  toggle.addEventListener('click',()=>{
    collapsed=!collapsed;
    chips.style.display=collapsed?'none':'flex';
    toggle.textContent=collapsed?'▶':'▼';
  });
  ERAS.forEach(era=>{
    const btn=document.createElement('button');
    btn.className='era-chip'+(era.id==='all'?' active':'');
    btn.innerHTML=era.label+(era.id!=='all'?` <span style="opacity:.4;font-size:.8em">${eraRange(era)}</span>`:'');
    btn.addEventListener('click',()=>{
      document.querySelectorAll('.era-chip').forEach(c=>c.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('eraLabel').textContent=era.label;
      yearsEl.textContent=era.id==='all'?'':eraRange(era);
      filterByEra(era.id);
    });
    chips.appendChild(btn);
  });
})();

// ============================================================
// ERA FILTERING
// ============================================================
let currentEra='all';
function filterByEra(eraId){
  currentEra=eraId;
  const era=ERAS.find(e=>e.id===eraId);
  allMarkers.forEach(m=>{
    if(m._mesh){m._mesh.visible=true;m._hide=false;m._kingdomSelected=null;}
    if(!era||eraId==='all'){m._eraHidden=false;if(m.el)m.el.visible=true;if(m._mesh)m._mesh.visible=true;return;}
    const y=parseYear(m.data.sub||'');
    m._eraHidden=!y||y<era.start||y>era.end;
    if(m.el)m.el.visible=!m._eraHidden;
    if(m.lbl)m.lbl.visible=!m._eraHidden;
    if(m._mesh)m._mesh.visible=!m._eraHidden;
  });
}

// ============================================================
// FLY TO
// ============================================================
function flyTo(item,cat,k){
  const d=item;
  const pos=ll(d.la||(d.pts?d.pts[Math.floor(d.pts.length/2)].la:0),d.ln||(d.pts?d.pts[Math.floor(d.pts.length/2)].ln:0),R*2.2);
  pos.applyQuaternion(EG.quaternion);
  const start=cam.position.clone(),st=Date.now(),dur=1200;
  // Clear previous info & highlight during flight so they don't overlap
  clearHighlight();
  dp.classList.remove('show');
  document.getElementById('dDesc').textContent='';
  document.getElementById('dFact').textContent='';
  function anim(){
    const t=Math.min((Date.now()-st)/dur,1);
    const e=1-Math.pow(1-t,3);
    cam.position.lerpVectors(start,pos,e);
    ctrl.update();
    if(t<1)requestAnimationFrame(anim);else showDetail(d,cat,k);
  }
  anim();
}

// ============================================================
// DETAIL
// ============================================================
const dp=document.getElementById('detail');
function showDetail(d,cat,k){
  document.getElementById('dBadge').className='d-badge';
  document.getElementById('dBadge').style.background=cat.color+'20';
  document.getElementById('dBadge').style.color=cat.color;
  document.getElementById('dBadge').textContent=(cat.icon||'')+' '+(cat.label||k);
  document.getElementById('dTitle').textContent=d.n;
  document.getElementById('dSub').textContent=d.sub||'';
  document.getElementById('dDesc').textContent=d.desc||'';
  const fact=document.getElementById('dFact');
  if(d.fact&&d.fact.includes('wikipedia.org')){
    const m=d.fact.match(/(https:\/\/[^\s]+)/);
    fact.innerHTML='📌 '+d.fact.replace(/(https:\/\/[^\s]+)/,'<a href="$1" target="_blank" rel="noopener" style="color:'+cat.color+'">Open in Wikipedia →</a>');
  }else{
    fact.textContent=d.fact?'📌 '+d.fact:'';
  }
  // Highlight tube + arrows for line/path features
  if(d._tube){
    clearHighlight();
    d._tube.material.color.set('#fbbf24');
    d._tube.material.opacity=0.9;
    d._tube.scale.set(1.3,1.3,1.3);
    _selTube=d._tube;
    _selArrows=d._arrows||[];
    _selArrows.forEach(a=>{
      a.material.color.set('#fbbf24');
      a.material.opacity=0.9;
    });
  }
  const hlLat=d.la||(d.pts?d.pts[Math.floor(d.pts.length/2)].la:0);
  const hlLn=d.ln||(d.pts?d.pts[Math.floor(d.pts.length/2)].ln:0);
  if((hlLat||hlLn)&&!d._tube)setHighlight(hlLat,hlLn);
  // Show figure portrait
  if(k==='battle'||k==='w_battle')showPortrait(getFigure(d.n,d.desc,cat.color),cat.color);
  // Timeline play button
  const tlBtn=document.getElementById('dTimeline');
  if(d.steps&&d.steps.length){
    tlBtn.onclick=()=>playTimeline(d.steps,d,cat,k);
    tlBtn.style.display='inline-flex';
  }else tlBtn.style.display='none';
  // Contemporaries & era events
  const year=parseYear(d.sub||'');
  const eraEl=document.getElementById('dEra'),eraList=document.getElementById('dEraList');
  const evtEl=document.getElementById('dEvents'),evtList=document.getElementById('dEventsList');
  eraEl.style.display='none';evtEl.style.display='none';
  if(year){
    const contemps=getContemporaries(year);
    if(contemps.length){
      eraList.innerHTML=contemps.map(c=>
        `<span class="contemp-chip" title="${c.title}">${c.name}</span>`
      ).join('');
      eraEl.style.display='block';
    }
    const events=getEraEvents(year);
    if(events.length){
      evtList.innerHTML=events.slice(0,20).map(e=>
        `<div class="era-event-item" data-cat="${e.cat}" data-idx="${D[e.cat]?.indexOf(e.item)}">
          <span class="e-dot" style="background:${e.color}"></span>
          <span class="e-year">${e.year}${e.year<0?' BCE':' CE'}</span>
          <span>${e.label}</span>
        </div>`
      ).join('');
      evtList.querySelectorAll('.era-event-item').forEach(el=>{
        el.addEventListener('click',()=>{
          const ci=D[el.dataset.cat];
          if(ci&&ci[el.dataset.idx])flyTo(ci[el.dataset.idx],CAT[el.dataset.cat],el.dataset.cat);
        });
      });
      evtEl.style.display='block';
    }
    // Set era chip
    const curEra=ERAS.slice().reverse().find(e=>year>=e.start&&year<=e.end);
    if(curEra&&curEra.id!=='all')document.getElementById('eraLabel').textContent=curEra.label;
  }
  dp.classList.add('show');
}
document.getElementById('dClose').addEventListener('click',()=>{dp.classList.remove('show');clearHighlight();stopTimeline();hidePortrait();document.getElementById('subtitle').classList.remove('show')});

// Click on 3D markers — track pointer to distinguish click from drag
let _ptrDown=null;
ren.domElement.addEventListener('pointerdown',e=>{_ptrDown={x:e.clientX,y:e.clientY}});
const ray=new THREE.Raycaster(),ptr=new THREE.Vector2();
ren.domElement.addEventListener('click',(e)=>{
  if(_ptrDown){
    const dx=e.clientX-_ptrDown.x,dy=e.clientY-_ptrDown.y;
    if(dx*dx+dy*dy>16){_ptrDown=null;return;} // drag, not click
    _ptrDown=null;
  }
  ptr.x=(e.clientX/innerWidth)*2-1;ptr.y=-(e.clientY/innerHeight)*2+1;
  ray.setFromCamera(ptr,cam);
  const meshes=[];
  allMarkers.forEach(m=>{m.el.children.forEach(c=>meshes.push({el:m,mesh:c}))});
  const hits=ray.intersectObjects(meshes.map(m=>m.mesh));
  if(hits.length){
    const hit=meshes.find(m=>m.mesh===hits[0].object);
    if(hit){if(_ap)stopAutoPlay();stopTimeline();hidePortrait();const m=hit.el;showDetail(m.data,CAT[m.cat],m.cat);return;}
  }
  // Only dismiss panel on true click (not drag) when clicking empty globe space
  if(_ap)stopAutoPlay();
  dp.classList.remove('show');
  clearHighlight();
  hidePortrait();
});

// ============================================================
// SEARCH — local data + Wikipedia API fallback
// ============================================================
const searchInp=document.getElementById('searchInp');
let searchTimeout, _lastQ='';
const WIKI_API='https://en.wikipedia.org/api/rest_v1/page/summary/';
searchInp.addEventListener('input',()=>{
  clearTimeout(searchTimeout);
  const q=searchInp.value.trim();
  _lastQ=q;
  searchTimeout=setTimeout(()=>{
    if(q!==_lastQ)return; // stale — user kept typing
    if(!q)return;
    const lq=q.toLowerCase();
    // Local data search
    for(const k of CAT_ORDER){
      const items=D[k];if(!items)continue;
      for(const d of items){
        if(d.n&&d.n.toLowerCase().includes(lq)){
          if(_ap)stopAutoPlay();
          searchInp.value='';
          flyTo(d,CAT[k],k);
          return;
        }
      }
    }
    // Wikipedia API fallback (only for queries 3+ chars, catches network errors silently)
    if(q.length<3)return;
    fetch(WIKI_API+encodeURIComponent(q))
      .then(r=>r.ok?r.json():null)
      .then(data=>{
        if(!data||data.type==='disambiguation'||!data.extract)return;
        if(q!==_lastQ)return; // stale
        if(_ap)stopAutoPlay();
        searchInp.value='';
        const title=data.title||q;
        const coords=data.coordinates?{la:data.coordinates[0].lat,ln:data.coordinates[0].lon}:null;
        const desc=data.description||'Wikipedia article';
        const extract=data.extract.replace(/<[^>]*>/g,'').split('\n')[0].substring(0,400);
        const wikiUrl=data.content_urls?.desktop?.page||'https://en.wikipedia.org/wiki/'+encodeURIComponent(title);
        const fakeData={
          n:title,sub:desc,desc:extract+(data.extract.length>400?'…':''),
          fact:'🔍 Wikipedia · '+(data.content_urls?.desktop?.page?'Open in browser: ':'')+wikiUrl,
          la:coords?.la,ln:coords?.ln
        };
        if(coords){
          flyTo(fakeData,CAT.personality||{color:'#e879f9',icon:'🔍',label:'Wikipedia'},'wikipedia');
        }else{
          showDetail(fakeData,CAT.personality||{color:'#e879f9',icon:'🔍',label:'Wikipedia'},'wikipedia');
        }
      })
      .catch(()=>{});
  },600);
});

