  if(e.key==='Escape'){if(_ap)stopAutoPlay();dp.classList.remove('show');clearHighlight();stopTimeline();hidePortrait();document.getElementById('subtitle').classList.remove('show');if(window.speechSynthesis)speechSynthesis.cancel();}
});

// Resize
window.addEventListener('resize',()=>{const w=innerWidth-getPanelRM();cam.aspect=w/innerHeight;cam.updateProjectionMatrix();ren.setSize(w,innerHeight)});

// Label LOD — hide/show labels based on zoom, with per-category force toggle
const _scratch=new THREE.Vector3(),_list=[];
function updateLabels(){
  const d=cam.position.length();
  const forced=Object.keys(labelVis).filter(k=>labelVis[k]===true);
  // Always show labels for force-enabled categories
  allMarkers.forEach(m=>{
    if(m.lbl&&m.cat&&forced.includes(m.cat)){
      m.lbl.visible=!(m._eraHidden||m._hide);
    }
  });
  if(d<1.7){
    const camDir=cam.position.clone().normalize().applyQuaternion(EG.quaternion.clone().invert());
    const w=window.innerWidth, h=window.innerHeight, cx=w/2, cy=h/2, maxDist=w*0.12, minGap=w*0.035;
    _list.length=0;
    allMarkers.forEach(m=>{
      if(!m.lbl||m._eraHidden||m._hide)return;
      if(m.cat&&forced.includes(m.cat))return; // already shown above
      if(m.pos.dot(camDir)<=0){m.lbl.visible=false;return;}
      _scratch.copy(m.pos).applyQuaternion(EG.quaternion).project(cam);
      const sx=(_scratch.x*0.5+0.5)*w, sy=(-_scratch.y*0.5+0.5)*h;
      const dist=Math.hypot(sx-cx,sy-cy);
      if(dist>=maxDist){m.lbl.visible=false;return;}
      _list.push({m,dist,sx,sy});
    });
    _list.sort((a,b)=>a.dist-b.dist);
    const kept=[];
    _list.forEach(({m,sx,sy})=>{
      for(const p of kept){if(Math.hypot(sx-p[0],sy-p[1])<minGap){m.lbl.visible=false;return;}}
      kept.push([sx,sy]);
      m.lbl.visible=true;
    });
  }else{
    allMarkers.forEach(m=>{
      if(!m.lbl)return;
      if(m.cat&&forced.includes(m.cat))return; // keep visible even when zoomed out
      m.lbl.visible=false;
    });
  }
}
// ============================================================
// ============================================================
// HISTORICAL FIGURE PORTRAITS
// ============================================================
function genAvatar(initials,color){
  const c=document.createElement('canvas');c.width=120;c.height=120;
  const ctx=c.getContext('2d');
  const r=parseInt(color.slice(1,3),16),g=parseInt(color.slice(3,5),16),b=parseInt(color.slice(5,7),16);
  ctx.clearRect(0,0,120,120);
  ctx.beginPath();ctx.arc(60,60,54,0,Math.PI*2);
  ctx.fillStyle=`rgba(${r},${g},${b},0.12)`;ctx.fill();
  ctx.strokeStyle=color;ctx.lineWidth=2.5;ctx.stroke();
  ctx.fillStyle=color;ctx.font='bold 40px Inter,system-ui,sans-serif';
  ctx.textAlign='center';ctx.textBaseline='middle';
  ctx.fillText(initials,60,62);
  return c.toDataURL();
}

