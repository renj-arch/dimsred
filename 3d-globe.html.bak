function getBridge(name){
  const key=name.toLowerCase().replace(/[^a-z0-9\s]/g,'').trim();
  for(const [k,v] of Object.entries(BRIDGES)){
    if(key.includes(k))return v;
  }
  return '';
}

// ---- Chapter definitions ----
const LECTURE_CHAPTERS=[
  {index:0,title:'Dawn of Civilization',era:'c. 300,000 BCE – 10,000 BCE',theme:'The origins of humanity, from the first hominids to the birth of language, art, and agriculture.',yearRange:[-300000,-8000]},
  {index:1,title:'The Ancient World',era:'c. 10,000 BCE – 500 BCE',theme:'The rise of the first cities, writing, empires, and the foundations of civilization across Mesopotamia, Egypt, India, and China.',yearRange:[-8000,-500]},
  {index:2,title:'Classical Antiquity',era:'c. 500 BCE – 500 CE',theme:'The golden age of philosophy, democracy, and empire from Greece and Rome to the Axial Age.',yearRange:[-500,500]},
  {index:3,title:'Medieval Era',era:'c. 500 CE – 1400 CE',theme:'Faith, feudalism, and the spread of knowledge across continents.',yearRange:[500,1400]},
  {index:4,title:'Early Modern World',era:'c. 1400 CE – 1700 CE',theme:'Exploration, revolution in thought, and the dawn of global connection.',yearRange:[1400,1700]},
  {index:5,title:'Age of Revolutions',era:'c. 1700 CE – 1900 CE',theme:'Industry, science, and the transformation of society through revolution.',yearRange:[1700,1900]},
  {index:6,title:'The Modern Era',era:'c. 1900 CE – 1950 CE',theme:'Wars that reshaped the world, the rise of new powers, and the birth of the modern age.',yearRange:[1900,1950]},
  {index:7,title:'Contemporary World',era:'c. 1950 CE – 2000 CE',theme:'Technology, freedom movements, and humanity\'s reach beyond Earth.',yearRange:[1950,2000]},
  {index:8,title:'Into the 21st Century',era:'c. 2000 CE – Present',theme:'The digital age, global challenges, and the frontiers of tomorrow.',yearRange:[2000,2050]}
];

// ---- Lecture state ----
let _lecState=null; // {chapter,entries,index,playing}

// ---- Build lecture entry list sorted chronologically with chapter assignment ----
function buildLectureData(){
  const all=[];
  const arrays=[
    {data:D.battle,type:'battle'},
    {data:D.w_battle,type:'w_battle'},
    {data:D.kingdom,type:'kingdom'},
    {data:D.w_kingdom,type:'w_kingdom'}
  ];
  for(const {data,type} of arrays){
    for(const e of data){
      if(!e.la||!e.ln)continue;
      let year=parseYear(e.year);
      // Fallback: use first step's year (most precise)
      if(year===null&&e.steps&&e.steps[0]&&e.steps[0].year){
        year=parseYear(e.steps[0].year);
      }
      // Fallback: parse year from sub field (e.g. "~300,000 BCE · Africa")
      if(year===null&&e.sub){
        const subYear=e.sub.match(/([\d,]+)\s*(BCE|BC|CE|AD)?/);
        if(subYear)year=parseYear(subYear[0]);
      }
      if(year===null)year=9999;
      all.push({...e,_type:type,_year:year});
    }
  }
  all.sort((a,b)=>a._year-b._year);
  // Assign chapter
  for(const e of all){
    const y=e._year;
    let ci=0;
    for(let i=0;i<LECTURE_CHAPTERS.length;i++){
      const ch=LECTURE_CHAPTERS[i];
      if(y>=ch.yearRange[0]&&y<ch.yearRange[1]){ci=i;break;}
      if(i===LECTURE_CHAPTERS.length-1)ci=i;
    }
    e._chapter=ci;
  }
  return all;
}

// ---- Lecture narration: continuous documentary-style prose ----
function lectureNarrate(entry,prevEntry){
  const bridge=getBridge(entry.n||'');
  const parts=[bridge];
  // Main description
  if(entry.desc)parts.push(entry.desc);
  // Weave steps in naturally based on count
  if(entry.steps&&entry.steps.length>0){
    const stepDescs=entry.steps.map(s=>s.desc).filter(Boolean);
    if(stepDescs.length===1){
      parts.push(stepDescs[0]);
    }else if(stepDescs.length>1){
      parts.push('Over time, '+stepDescs.join(' '));
    }
  }
  // Weave facts in naturally — replace pipe separators with periods
  if(entry.fact){
    const cleanFact=entry.fact.replace(/·/g,'.').replace(/\.+/g,'.').trim();
    parts.push(cleanFact);
  }
  let text=parts.join(' ').replace(/\s+/g,' ').trim();
  // Ensure it ends with a period
  if(!text.endsWith('.')&&!text.endsWith('!')&&!text.endsWith('?'))text+='.';
  return text;
}

// ---- Show chapter intro screen ----
function showChapterIntro(chapter,entries){
  const div=document.getElementById('chapterIntro');
  document.getElementById('ciNum').textContent='CHAPTER '+(chapter.index+1);
  document.getElementById('ciTitle').textContent=chapter.title;
  document.getElementById('ciEra').textContent=chapter.era+' · '+entries.length+' entries';
  document.getElementById('ciTheme').textContent=chapter.theme;
  const btn=document.getElementById('ciStart');
  btn.onclick=()=>{
    hideChapterIntro();
    beginLecturePlayback(chapter,entries);
  };
  div.classList.add('show');
}
function hideChapterIntro(){
  document.getElementById('chapterIntro').classList.remove('show');
}

// ---- Show chapter outro screen ----
function showChapterOutro(chapter,nextChapter){
  const div=document.getElementById('chapterOutro');
  document.getElementById('coTitle').textContent=chapter.title+' Complete';
  document.getElementById('coSub').textContent='You\'ve explored '+chapter.era;
  const btn=document.getElementById('coNext');
  if(nextChapter){
    btn.textContent='▶ Next: '+nextChapter.title;
    btn.onclick=()=>{
      hideChapterOutro();
      startLectureChapter(nextChapter.index);
    };
  }else{
    btn.textContent='🎉 Finish Lecture';
    btn.onclick=()=>{
      hideChapterOutro();
      stopLecture();
      showLectureComplete();
    };
  }
  div.classList.add('show');
}
function hideChapterOutro(){
  document.getElementById('chapterOutro').classList.remove('show');
}

// ---- Show lecture panel ----
function showLecturePanel(){
  const panel=document.getElementById('lecturePanel');
  const container=document.getElementById('lpChapters');
  container.innerHTML='';
  const all=buildLectureData();
  for(let i=0;i<LECTURE_CHAPTERS.length;i++){
    const ch=LECTURE_CHAPTERS[i];
    const count=all.filter(e=>e._chapter===i).length;
    const btn=document.createElement('button');
    btn.className='lp-chap';
    btn.innerHTML=`<span class="lc-num">${i+1}</span><span class="lc-name">${ch.title}</span><span class="lc-era">${ch.era}</span><span class="lc-count">${count}</span>`;
    btn.addEventListener('click',()=>{
      hideLecturePanel();
      startLectureChapter(i);
    });
    container.appendChild(btn);
  }
  panel.classList.add('show');
  // Update lecture button
  const lb=document.getElementById('lectureBtn');
  if(!_lecState)lb.classList.remove('playing');
}
function hideLecturePanel(){
  document.getElementById('lecturePanel').classList.remove('show');
}

// ---- Show lecture complete screen ----
function showLectureComplete(){
  const div=document.getElementById('chapterOutro');
  document.getElementById('coTitle').textContent='🎉 Lecture Complete!';
  document.getElementById('coSub').textContent='You\'ve journeyed through all of world history on the globe.';
  document.getElementById('coNext').textContent='✕ Close';
  document.getElementById('coNext').onclick=()=>{
    hideChapterOutro();
    stopLecture();
  };
  div.classList.add('show');
  // Replace label
  document.querySelector('#chapterOutro .co-label').textContent='ALL CHAPTERS';
}

// ---- Start a lecture chapter ----
let _lecTick=0;
function startLectureChapter(chapterIndex){
  const all=buildLectureData();
  const entries=all.filter(e=>e._chapter===chapterIndex);
  if(entries.length===0){return;}
  const chapter=LECTURE_CHAPTERS[chapterIndex];
  
  // Cancel any lingering speech from previous chapter
  if(window.speechSynthesis)speechSynthesis.cancel();
  
  // Close any open detail panel
  dp.classList.remove('show');clearHighlight();hidePortrait();
  
  // Initialize state with tick counter (stale callbacks check _tick)
  _lecState={chapter,entries,index:0,playing:true,stopped:false,_tick:++_lecTick};
  document.getElementById('lectureBtn').classList.add('playing');
  
  // Show chapter intro
  showChapterIntro(chapter,entries);
}

// ---- Begin actual playback after chapter intro ----
function beginLecturePlayback(chapter,entries){
  if(!_lecState||_lecState.stopped)return;
  _lecState.playing=true;
  updateLectureBar();
  playLectureEntry();
}

// ---- Play current lecture entry ----
function playLectureEntry(){
  if(!_lecState||_lecState.stopped)return;
  const {entries,index}=_lecState;
  if(index>=entries.length){
    // Chapter complete
    _lecState.playing=false;
    const nextIdx=_lecState.chapter.index+1;
    const nextCh=nextIdx<LECTURE_CHAPTERS.length?LECTURE_CHAPTERS[nextIdx]:null;
    showChapterOutro(_lecState.chapter,nextCh);
    return;
  }
  const entry=entries[index];
  const prevEntry=index>0?entries[index-1]:null;
  const text=lectureNarrate(entry,prevEntry);
  
  // Update lecture bar
  updateLectureBar();
  
  // Capture tick so stale callbacks from old chapters auto-bail
  const tick=_lecState._tick;
  
  // Fly to entry's location
  const catColor=entry._type==='battle'?'#fb923c':entry._type==='w_battle'?'#a78bfa':entry._type==='kingdom'?'#34d399':'#60a5fa';
  flyToLatLon(entry.la,entry.ln,R*1.7,()=>{
    if(!_lecState||_lecState.stopped||_lecState._tick!==tick)return;
    
    // Get figure and show portrait via speakText
    const fig=getFigure(entry.n,entry.desc,catColor);
    
    // Narrate
    speakText(text,()=>{
      if(!_lecState||_lecState.stopped||_lecState._tick!==tick)return;
      document.getElementById('subtitle').classList.remove('show');
      hidePortrait();
      if(window.cleanTLArcs)cleanTLArcs();
      // Advance to next
      if(_lecState.playing){
        _lecState.index++;
        setTimeout(()=>{
          if(!_lecState||_lecState.stopped||_lecState._tick!==tick)return;
          playLectureEntry();
        },1800);
      }
    },fig,catColor);
  });
}

// ---- Lecture bar ----
function updateLectureBar(){
  const bar=document.getElementById('lectureBar');
  if(!_lecState){bar.classList.remove('show');return;}
  bar.classList.add('show');
  const {chapter,entries,index}=_lecState;
  document.getElementById('lbChapter').textContent='CH'+(chapter.index+1);
  document.getElementById('lbProgress').textContent=(index+1)+'/'+entries.length;
  const entry=entries[index];
  document.getElementById('lbTitle').textContent=entry?entry.n:'—';
  document.getElementById('lbPlay').textContent=_lecState.playing?'⏸':'▶';
}

// ---- Lecture controls ----
function stopLecture(){
  if(_lecState)_lecState.stopped=true;
  _lecState=null;
  document.getElementById('lectureBtn').classList.remove('playing');
  document.getElementById('lectureBar').classList.remove('show');
  if(window.speechSynthesis)speechSynthesis.cancel();
  if(window.cleanTLArcs)cleanTLArcs();
  hidePortrait();
  document.getElementById('subtitle').classList.remove('show');
  document.getElementById('chapterIntro').classList.remove('show');
  document.getElementById('chapterOutro').classList.remove('show');
}

function toggleLecturePlay(){
  if(!_lecState||document.getElementById('chapterIntro').classList.contains('show')||document.getElementById('chapterOutro').classList.contains('show'))return;
  _lecState.playing=!_lecState.playing;
  updateLectureBar();
  if(_lecState.playing){
    _lecState._tick=++_lecTick;
    playLectureEntry();
  }else{
    window.speechSynthesis&&window.speechSynthesis.cancel();
  }
}

function lecturePrev(){
  if(!_lecState||_lecState.index<=0||document.getElementById('chapterIntro').classList.contains('show')||document.getElementById('chapterOutro').classList.contains('show'))return;
  window.speechSynthesis&&window.speechSynthesis.cancel();
  _lecState.index--;
  _lecState.playing=true;
  _lecState._tick=++_lecTick;
  updateLectureBar();
  playLectureEntry();
}

function lectureNext(){
  if(!_lecState||document.getElementById('chapterIntro').classList.contains('show')||document.getElementById('chapterOutro').classList.contains('show'))return;
  window.speechSynthesis&&window.speechSynthesis.cancel();
  _lecState.index++;
  _lecState.playing=true;
  _lecState._tick=++_lecTick;
  updateLectureBar();
  playLectureEntry();
}

// Expose lecture controls
window.startLectureChapter=startLectureChapter;
window.stopLecture=stopLecture;
window.toggleLecturePlay=toggleLecturePlay;
window.lecturePrev=lecturePrev;
window.lectureNext=lectureNext;

// ---- Wire lecture UI ----
document.getElementById('lectureBtn').addEventListener('click',showLecturePanel);
document.getElementById('lpClose').addEventListener('click',hideLecturePanel);
document.getElementById('lbPlay').addEventListener('click',toggleLecturePlay);
document.getElementById('lbPrev').addEventListener('click',lecturePrev);
document.getElementById('lbNext').addEventListener('click',lectureNext);
document.getElementById('lbStop').addEventListener('click',stopLecture);
// Close panel if user clicks backdrop
document.getElementById('lecturePanel').addEventListener('click',(e)=>{
  if(e.target===e.currentTarget)hideLecturePanel();
});

// Warm up speech engine early to prevent muted first words
setTimeout(speechWarmup,500);
document.addEventListener('click',()=>{if(!window._speechWarmed){window._speechWarmed=true;speechWarmup()}},{once:true});

}catch(e){}
</script>
</body>
</html>
