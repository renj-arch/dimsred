D.unesco = [
  {n:'Taj Mahal',la:27.18,ln:78.02,sub:'Agra, UP · 1983',desc:'UNESCO World Heritage. Built by Shah Jahan for Mumtaz (1631-53). Masterpiece of Mughal architecture. One of Seven Wonders of the World.',fact:'Marble inlay with semi-precious stones · Symmetry · Ustad Ahmad Lahauri architect'},
  {n:'Ajanta Caves',la:20.55,ln:75.70,sub:'Aurangabad, MH · 1983',desc:'UNESCO WHS. 29 rock-cut Buddhist cave monuments (2nd cent BCE - 600 CE). Paintings and sculptures.',fact:'Chaityas and viharas · Frescoes of Jataka tales · Rediscovered 1819 by British officer'},
  {n:'Ellora Caves',la:20.02,ln:75.17,sub:'Aurangabad, MH · 1983',desc:'UNESCO WHS. 34 rock-cut temples (600-1000 CE). Buddhist, Hindu, Jain coexistence. Kailasa Temple (world\'s largest monolithic rock-cut).',fact:'Kailasa (Cave 16) carved from top down · 34 caves total · Rashtrakuta built'},
  {n:'Red Fort Complex',la:28.66,ln:77.22,sub:'Delhi · 2007',desc:'UNESCO WHS. Built by Shah Jahan (1639-48). Main residence of Mughal emperors. PM hoists flag on Independence Day.',fact:'Lahori Gate · Diwan-i-Aam/Khas · Mughal Gardens · Rang Mahal'},
  {n:'Qutub Minar',la:28.52,ln:77.18,sub:'Delhi · 1993',desc:'UNESCO WHS. 73m tall victory tower. Built by Qutb-ud-din Aibak (began) and Iltutmish (completed). Red sandstone and marble.',fact:'5 storeys · Quwwat-ul-Islam mosque (first mosque in India) · Iron pillar (non-rusting)'},
  {n:'Humayun\'s Tomb',la:28.59,ln:77.25,sub:'Delhi · 1993',desc:'UNESCO WHS. Built 1572 by Bega Begum (Hamida Banu). Precursor to Taj Mahal. Charbagh garden layout.',fact:'First garden-tomb in India · "Dormitory of Mughals" houses several tombs'},
  {n:'Khajuraho Temples',la:24.85,ln:79.93,sub:'MP · 1986',desc:'UNESCO WHS. 20+ temples (originally 85). Chandela dynasty (950-1050 CE). Famous for erotic sculptures. Nagara architecture.',fact:'Kandariya Mahadeva temple (31m high) · Water tanks · 10% of sculptures are erotic'},
  {n:'Sanchi Stupa',la:23.48,ln:77.73,sub:'MP · 1989',desc:'UNESCO WHS. Great Stupa built by Ashoka (3rd cent BCE). Toranas (gateways). Buddhist pilgrimage site.',fact:'4 toranas with Jataka narratives · Dome representing universe · Founded by Ashoka'},
  {n:'Konark Sun Temple',la:19.88,ln:86.10,sub:'Odisha · 1984',desc:'UNESCO WHS. Built by Narasimhadeva I (Ganga dynasty, 1250 CE). Giant chariot of Sun with 12 wheels, 7 horses.',fact:'Dancing hall · Falling into ruin (magnet effects?) · Huge wheels for sundial purpose'},
  {n:'Goa Churches (Bom Jesus)',la:15.50,ln:73.91,sub:'Goa · 1986',desc:'UNESCO WHS. Basilica of Bom Jesus (body of St. Francis Xavier). Se Cathedral (largest church in Asia).',fact:'Old Goa (Velha Goa) · St. Francis Xavier\'s body every 10 years · Portuguese baroque'},
  {n:'Hampi',la:15.33,ln:76.47,sub:'Karnataka · 1986',desc:'UNESCO WHS. Vijayanagara Empire capital (1336-1646). Virupaksha Temple, Vittala Temple (stone chariot), Lotus Mahal.',fact:'Epicentre of Ramayana (Kishkinda) · Tungabhadra river · Vijayanagara architecture'},
  {n:'Mahabalipuram',la:12.62,ln:80.19,sub:'Tamil Nadu · 1984',desc:'UNESCO WHS. Pallava dynasty (7th-9th cent). Shore Temple, Five Rathas, Arjuna\'s Penance. Rock-cut architecture.',fact:'Shore Temple survives tsunami 2004 · Descent of Ganga (world\'s largest bas-relief)'},
  {n:'Great Living Chola Temples',la:10.78,ln:79.13,sub:'TN · 1987, 2004',desc:'UNESCO WHS. Brihadeeswara Temple (Thanjavur, 1010 CE). Gangaikonda Cholapuram, Airavatesvara. Rajaraja Chola built.',fact:'Brihadeeswara dome weighs 80 tons · Single stone Nandi · Chola bronze sculpture'},
  {n:'Darjeeling Himalayan Railway',la:26.68,ln:88.30,sub:'WB · 1999',desc:'UNESCO WHS. "Toy Train" from Siliguri to Darjeeling (88 km). 2 ft gauge. Loop & zigzag. Est. 1881.',fact:'Batasia Loop · Ghum station (highest in India, 2258m) · Steam locos'},
  {n:'Kalka-Shimla Railway',la:30.90,ln:76.94,sub:'HP · 2008',desc:'UNESCO WHS. 96 km, 102 tunnels, 864 bridges. 2 ft 6 in gauge. Opened 1903. Scenic route.',fact:'102 tunnels (oldest surviving) · Barog tunnel longest (1.1 km) · Pinjore gardens'},
  {n:'Elephanta Caves',la:18.95,ln:72.93,sub:'Maharashtra · 1987',desc:'UNESCO WHS. Rock-cut cave temples on Elephanta Island (near Mumbai). 5th-7th cent. Trimurti Sadashiva (three-headed Shiva).',fact:'Portuguese named after elephant statue · Trimurti (18 ft high) · 7 caves total'},
  {n:'Rani ki Vav',la:23.86,ln:72.10,sub:'Gujarat · 2014',desc:'UNESCO WHS. Queen\'s stepwell in Patan. Built by Udayamati (queen of Bhima I, Solanki dynasty 1063). 7 levels deep, 500+ sculptures.',fact:'Best-known stepwell · Inverted temple design · 1500+ sculptures · Architectural marvel'},
  {n:'Chandigarh Capitol Complex',la:30.76,ln:76.80,sub:'Chandigarh · 2016',desc:'UNESCO WHS. Le Corbusier\'s masterpiece. High Court, Secretariat, Legislative Assembly, Open Hand Monument, Tower of Shadows.',fact:'Part of 17 Le Corbusier works worldwide exposed by UNESCO · Geometric design'},
  {n:'Jaipur City',la:26.91,ln:75.79,sub:'Rajasthan · 2019',desc:'UNESCO WHS. Walled city of Jaipur. Founded 1727 by Sawai Jai Singh II. Grid plan (Vastu Shastra). Pink City.',fact:'Only Indian city inscribed as WHS (2019) · Bazaars: Johari, Bapu · Pink colour 1876'},
  {n:'Kashmir Mughal Gardens',la:34.08,ln:74.80,sub:'J&K · Tentative',desc:'Shalimar Bagh, Nishat Bagh, Chashme Shahi, Pari Mahal. Built by Mughals (Jahangir, Shah Jahan). Charbagh style.',fact:'Shalimar Bagh built by Jahangir for Nur Jahan · Nishat Bagh: 12 terraces'},
  {n:'Hill Forts of Rajasthan',la:24.88,ln:74.65,sub:'Rajasthan · 2013',desc:'Serial WHS of 6 hill forts: Chittorgarh, Kumbhalgarh, Ranthambore, Gagron, Amber, Jaisalmer. Rajput military architecture.',fact:'6 forts in series · Chittorgarh (Rana Kumbha) · Kumbhalgarh (world\'s 2nd longest wall) · Jaisalmer living fort'},
  {n:'Nalanda',la:25.14,ln:85.45,sub:'Bihar · 2016',desc:'UNESCO WHS. Ancient Nalanda University ruins (5th-12th cent). World\'s oldest residential university. Kumaragupta founded. Destroyed by Bakhtiyar Khilji (1193).',fact:'World\'s oldest university · 9-storey library · Burned 6 months · Hiuen Tsang studied'},
  {n:'Fatehpur Sikri',la:27.09,ln:77.66,sub:'UP · 1986',desc:'UNESCO WHS. Built by Akbar (1569-85). Mughal capital for 15 years. Buland Darwaza, Panch Mahal, Jodha Bai\'s Palace, Jama Masjid.',fact:'Buland Darwaza (54m high) · Abandoned due to water shortage · Sheikh Salim Chishti\'s dargah'},
  {n:'Champaner-Pavagadh',la:22.48,ln:73.54,sub:'Gujarat · 2004',desc:'UNESCO WHS. Capital of Mahmud Begada (15th cent). Pavagadh Hill + Champaner city. Kaleidoscope of Hindu & Islamic architecture.',fact:'Jama Masjid (Champaner) · Stepwells · Pavagadh Temple (Mata Kali) · Fort on volcanic hill'},
  {n:'Pattadakal',la:15.95,ln:75.82,sub:'Karnataka · 1987',desc:'UNESCO WHS. Chalukya architecture (7th-8th cent). 10 temples: Virupaksha (Victory of Vikramaditya II). Blend of Nagara & Dravida styles.',fact:'Virupaksha & Mallikarjuna built by queens · Coronation site of Chalukya kings · Sangameshwara'},
  {n:'Western Ghats',la:12.00,ln:76.00,sub:'Multiple states · 2012',desc:'UNESCO WHS (serial site). 39 properties across 6 states. One of 8 hottest biodiversity hotspots. Older than Himalayas.',fact:'Biodiversity hotspot · 39 component sites · 325+ endemic species · Nilgiri, Agasthyamalai'},
  {n:'Sundarbans National Park',la:21.85,ln:88.87,sub:'WB · 1987',desc:'UNESCO WHS. World\'s largest mangrove forest. Royal Bengal Tiger habitat. Ganga-Brahmaputra delta. Est. 1984.',fact:'World\'s largest mangrove · Sundari trees · Tiger-human conflict · Dolphin, croc, turtle'},
];
D.battle = [
  {n:'Battle of Plassey',la:23.80,ln:88.27,sub:'1757 · Bengal',desc:'June 23, 1757. Robert Clive vs Siraj-ud-Daulah. Mir Jafar betrayed Nawab. Established British political power in India.',fact:'"Battle that won India for Britain" · Fought during monsoon · 72 British casualties',steps:[
    {year:"Apr 1756",label:"Siraj becomes Nawab of Bengal",la:22.57,ln:88.36,desc:"Siraj-ud-Daulah becomes Nawab of Bengal after the death of Alivardi Khan. The young nawab is suspicious of British fortifications in Calcutta."},
    {year:"Jun 1756",label:"Siraj captures Calcutta",la:22.57,ln:88.36,desc:"Siraj attacks and captures the British settlement at Calcutta. The garrison surrenders. 146 British prisoners are locked in a small cell overnight — the Black Hole incident."},
    {year:"Jan 1757",label:"Clive recovers Calcutta",la:22.57,ln:88.36,desc:"Robert Clive and Admiral Watson arrive from Madras with a naval force. They recapture Calcutta from Siraj's forces and negotiate a treaty."},
    {year:"Jun 1757",label:"Conspiracy with Mir Jafar",la:23.80,ln:88.27,desc:"Clive conspires with Mir Jafar, Siraj's commander-in-chief, and other Bengali nobles. Mir Jafar agrees to betray Siraj in exchange for the throne of Bengal."},
    {year:"23 Jun 1757",label:"Battle of Plassey",la:23.80,ln:88.27,desc:"Clive's 3,000 troops face Siraj's 50,000 at Plassey. A monsoon downpour soaks Siraj's gunpowder but Clive's tents keep his powder dry. Mir Jafar defects. Siraj flees. The British win with only 72 casualties."}
  ]},
  {n:'Battle of Buxar',la:25.56,ln:83.98,sub:'1764 · Bihar',desc:'British vs Mughal+Awadh+Bengal coalition. Shah Alam II surrendered. British got Diwani rights (tax collection) for Bengal, Bihar, Odisha.',fact:'Treaty of Allahabad (1765) · Made British dominant power in India',steps:[
    {year:"1760-63",label:"British expansion in Bengal",la:23.80,ln:88.27,desc:"After Plassey, the British East India Company expands its influence in Bengal under Mir Jafar and later Mir Qasim. Tensions rise over trade privileges and revenue collection."},
    {year:"1763",label:"Mir Qasim's revolt",la:25.40,ln:85.80,desc:"Mir Qasim, the Nawab of Bengal, rebels against British interference. He forms a grand alliance with Nawab Shuja-ud-Daulah of Awadh and Mughal Emperor Shah Alam II to expel the British from India."},
    {year:"23 Oct 1764",label:"Battle of Buxar",la:25.56,ln:83.98,desc:"Major Hector Munro leads 7,000 British troops against the combined 40,000-strong army of the three allies at Buxar. British discipline and superior firepower prevail despite being outnumbered."},
    {year:"1765",label:"Treaty of Allahabad",la:25.45,ln:81.85,desc:"Shah Alam II signs the Treaty of Allahabad, granting the British the Diwani (right to collect revenue) of Bengal, Bihar, and Odisha. This marks the formal beginning of British political rule in India."}
  ]},
  {n:'Battle of Panipat I',la:29.40,ln:76.97,sub:'1526 · Panipat',desc:'Babur (Mughal) vs Ibrahim Lodi (Delhi Sultanate). Babur used gunpowder & Rumi (flanking) tactics. Founded Mughal Empire.',fact:'First use of gunpowder in North India · Panipat town known for 3 battles!',steps:[
    {year:"1519-24",label:"Babur's early invasions",la:29.40,ln:76.97,desc:"Babur, the Timurid ruler of Kabul, launches multiple raids into Punjab. He is invited by Daulat Khan Lodi and Alam Khan to overthrow Ibrahim Lodi, who is deeply unpopular with his nobles."},
    {year:"Apr 1526",label:"Babur marches to Panipat",la:28.60,ln:77.20,desc:"Babur advances from Punjab with ~12,000 men, armed with matchlock muskets and field cannons. He selects Panipat as the battlefield, using the terrain to protect his flanks."},
    {year:"20 Apr 1526",label:"Battle of Panipat I",la:29.40,ln:76.97,desc:"Ibrahim Lodi's 50,000 men and 1,000 war elephants charge Babur's position. Babur's gunpowder weapons and tulughma (flanking) tactics shatter the Delhi army. Ibrahim Lodi is killed on the field."},
    {year:"1526-30",label:"Babur establishes Mughal rule",la:28.60,ln:77.20,desc:"Babur captures Delhi and Agra, founding the Mughal Empire. He faces Rajput resistance at Khanwa (1527) and Afghan uprisings before consolidating control over North India."}
  ]},
  {n:'Battle of Panipat II',la:29.40,ln:76.97,sub:'1556 · Panipat',desc:'Akbar (age 13, with Bairam Khan) vs Hemu. Hemu captured Delhi; Akbar recaptured. Secured Mughal rule.',fact:'Hemu was a Hindu king who ruled Delhi briefly (1 month) · Akbar\'s regent Bairam Khan',steps:[
    {year:"Jan 1556",label:"Humayun dies unexpectedly",la:28.60,ln:77.20,desc:"Emperor Humayun dies after falling from his library stairs in Delhi. His 13-year-old son Akbar ascends the Mughal throne, with Bairam Khan as regent. The empire is fragile and threatened from all sides."},
    {year:"Oct 1556",label:"Hemu captures Delhi and Agra",la:28.60,ln:77.20,desc:"Hemu, the Hindu general of Sher Shah's successor Adil Shah, sweeps through North India. He defeats the Mughal governor Tardi Beg at Agra and captures Delhi, crowning himself Raja Vikramaditya."},
    {year:"5 Nov 1556",label:"Battle of Panipat II",la:29.40,ln:76.97,desc:"The Mughal army under Bairam Khan and Akbar faces Hemu's forces at Panipat. Hemu leads from atop an elephant and is on the verge of victory when a stray arrow pierces his eye, felling him unconscious."},
    {year:"1556-60",label:"Consolidation of Mughal power",la:28.60,ln:77.20,desc:"With Hemu's death and the capture of Delhi, Bairam Khan secures Akbar's throne. The Mughal Empire is firmly re-established, and Akbar goes on to become the greatest Mughal emperor."}
  ]},
  {n:'Battle of Panipat III',la:29.40,ln:76.97,sub:'1761 · Panipat',desc:'Marathas vs Ahmad Shah Abdali (Afghan). Marathas decisively defeated. ~125,000 killed. Shattered Maratha power, paved way for British.',fact:'World\'s 4th bloodiest battle in 18th century · Fought on Jan 14, 1761',steps:[
    {year:"1750s",label:"Maratha expansion northward",la:28.61,ln:77.23,desc:"Under Peshwa Baji Rao I and his successors, the Marathas expand deep into North India. They extract chauth and sardeshmukhi from Mughal territories, becoming the dominant power."},
    {year:"1759",label:"Abdali invades India",la:33.70,ln:73.70,desc:"Ahmad Shah Abdali of Afghanistan invades India with a massive army. He claims Mughal territories and marches eastward, plundering along the way."},
    {year:"Aug 1760",label:"Marathas capture Delhi",la:28.61,ln:77.23,desc:"Sadashivrao Bhau leads a huge Maratha army north. They capture Delhi from Abdali's vassals, placing the Mughal emperor under Maratha protection."},
    {year:"Jan 1761",label:"The march to Panipat",la:29.40,ln:76.97,desc:"The massive Maratha army, with ~100,000 soldiers and 200,000 camp followers, marches to confront Abdali. Abdali's forces cut their supply lines. Starvation sets in the Maratha camp."},
    {year:"14 Jan 1761",label:"The decisive battle",la:29.40,ln:76.97,desc:"The desperate Maratha army attacks Abdali's positions. After 6 hours of fierce fighting, Abdali's tactical superiority and fresh cavalry overwhelm the exhausted Marathas. ~125,000 killed. The Maratha empire never fully recovers, paving the way for British supremacy."}
  ]},
  {n:'Battle of Haldighati',la:23.00,ln:73.50,sub:'1576 · Rajasthan',desc:'Maharana Pratap vs Akbar\'s army (Man Singh, Raja of Amber). Raiputs fought bravely but lost. Pratap escaped.',fact:'Pratap\'s horse Chetak died · Legendary battle of valour · Haldighati = turmeric valley',steps:[
    {year:"1572",label:"Maharana Pratap crowned",la:24.58,ln:73.68,desc:"Pratap Singh becomes the Maharana of Mewar after the death of his father Udai Singh II. He vows to never submit to Mughal authority."},
    {year:"1573-75",label:"Akbar's diplomatic overtures",la:27.18,ln:78.02,desc:"Emperor Akbar sends multiple embassies to Pratap, offering favorable terms. Pratap refuses to attend the Mughal court or pay tribute, choosing independence over submission."},
    {year:"Jun 1576",label:"Mughal army marches",la:26.47,ln:74.64,desc:"Akbar dispatches a massive Mughal army led by Raja Man Singh of Amber and Asaf Khan. They march towards Mewar to force Pratap into submission."},
    {year:"18 Jun 1576",label:"Battle of Haldighati",la:23.00,ln:73.50,desc:"Pratap's 20,000 Rajputs face Man Singh's 80,000 Mughals in the narrow mountain pass of Haldighati. Despite fierce Rajput charges, Mughal numbers prevail. Pratap's horse Chetak is mortally wounded but carries him to safety."},
    {year:"1576-97",label:"Pratap's guerrilla resistance",la:24.58,ln:73.68,desc:"Pratap escapes to the Aravalli hills and wages guerrilla warfare for the next 20 years. He reclaims most of Mewar except Chittor, and dies in 1597 as a free king — never having submitted to Akbar."}
  ]},
  {n:'Battle of Tarain II',la:29.80,ln:76.94,sub:'1192 · Tarain',desc:'Muhammad Ghori vs Prithviraj Chauhan. Ghori won (2nd attempt). Marked beginning of Muslim rule in North India.',fact:'Prithviraj captured and executed · Ghori established Delhi Sultanate via Qutb-ud-din Aibak',steps:[
    {year:"1191",label:"First Battle of Tarain",la:29.80,ln:76.94,desc:"Muhammad Ghori invades India and is defeated by Prithviraj Chauhan at Tarain. Ghori is captured but Prithviraj magnanimously releases him — a decision that proves fateful for Rajput India."},
    {year:"1191-92",label:"Ghori prepares for revenge",la:34.40,ln:66.96,desc:"Ghori returns to Ghazni, humiliated but determined. He assembles a massive army of 120,000 Afghan, Turk, and Persian cavalry and plans a second invasion with new tactics."},
    {year:"1192",label:"Second Battle of Tarain",la:29.80,ln:76.94,desc:"Ghori returns to Tarain with 120,000 troops. He feigns retreat and draws the Rajput cavalry into a trap. Prithviraj is captured and executed. The Rajput confederacy collapses."},
    {year:"1192-1206",label:"Ghori establishes Delhi Sultanate",la:28.60,ln:77.20,desc:"Ghori annexes Delhi and Ajmer, appointing Qutb-ud-din Aibak as his viceroy. After Ghori's assassination in 1206, Aibak founds the Mamluk (Slave) Dynasty, beginning the Delhi Sultanate era."}
  ]},
  {n:'Battle of Talikota',la:16.48,ln:76.32,sub:'1565 · Karnataka',desc:'Deccan Sultanates vs Vijayanagara Empire (Rama Raya). Vijayanagara defeated & Hampi sacked. End of last great Hindu empire.',fact:'Rama Raya\'s arrogance caused alliance against him · Hampi looted for 6 months',steps:[
    {year:"1560-65",label:"Rama Raya's aggressive diplomacy",la:15.40,ln:76.40,desc:"Rama Raya, the de facto ruler of Vijayanagara, plays the Deccan Sultanates against each other. His arrogant interference in their internal affairs unites the five sultanates — Bijapur, Ahmadnagar, Golconda, Bidar, and Berar."},
    {year:"Jan 1565",label:"Sultanates form a grand alliance",la:16.80,ln:75.70,desc:"The five Deccan sultanates set aside their rivalries and form a coalition. They march south with a massive combined army to crush Vijayanagara once and for all."},
    {year:"23 Jan 1565",label:"Battle of Talikota",la:16.48,ln:76.32,desc:"The two titanic armies clash at Talikota. Rama Raya's artillery superiority is nullified when two Muslim commanders in his service defect. Rama Raya is captured and beheaded on the battlefield, causing Vijayanagara's collapse."},
    {year:"1565-68",label:"Sack of Hampi",la:15.34,ln:76.47,desc:"The victorious sultanates pour into Vijayanagara's capital Hampi. The city is looted and systematically destroyed for six months. Temples and palaces are razed. The greatest Hindu empire falls, never to recover."}
  ]},
  {n:'Battle of Kalinga',la:20.30,ln:85.80,sub:'261 BCE · Odisha',desc:'Ashoka (Maurya) vs Kalinga. ~100,000 killed ~150,000 captured. Horrific war transformed Ashoka to embrace Buddhism.',fact:'Turning point of Indian history · Ashoka\'s edicts mention the battle · Dhauli hills',steps:[
    {year:"268 BCE",label:"Ashoka becomes Mauryan Emperor",la:25.61,ln:85.14,desc:"Ashoka ascends the Mauryan throne after a power struggle following Bindusara's death. He proves to be an ambitious and ruthless ruler, earning the epithet 'Chandashoka' or the fierce one."},
    {year:"267-262 BCE",label:"Ashoka consolidates the empire",la:25.61,ln:85.14,desc:"Ashoka expands the Mauryan empire in all directions. He builds a formidable army and a centralized administration from the capital Pataliputra."},
    {year:"261 BCE",label:"Invasion of Kalinga",la:20.30,ln:85.80,desc:"Ashoka launches a massive invasion against Kalinga, a prosperous kingdom on the east coast known for its fierce independence and maritime trade."},
    {year:"261 BCE",label:"The horrific battle",la:20.30,ln:85.80,desc:"The Kalingan army fights with desperate courage. The battle is savage — ~100,000 killed and ~150,000 deported. Rivers run red with blood. It is one of the bloodiest battles in ancient history."},
    {year:"261 BCE",label:"Ashoka embraces Buddhism",la:20.30,ln:85.80,desc:"Horrified by the carnage he has caused, Ashoka walks the battlefield and is overcome with remorse. He converts to Buddhism and adopts the policy of Dhamma Vijaya — conquest through righteousness — renouncing war forever."}
  ]},
  {n:'Battle of Hydaspes',la:33.50,ln:72.20,sub:'326 BCE · Jhelum (Pakistan)',desc:'Alexander vs King Porus (Paurava). Porus fought bravely, Alexander impressed. Last major battle of Alexander\'s Indian campaign.',fact:'Porus\'s elephant army · Jhelum = Hydaspes (Greek) · Alexander\'s army mutinied here',steps:[
    {year:"327 BCE",label:"Alexander crosses the Indus",la:34.00,ln:71.50,desc:"Alexander the Great crosses the Indus River after conquering the Persian Empire. He enters the Indian subcontinent, defeating several local tribes along the way."},
    {year:"326 BCE",label:"Alexander reaches the Hydaspes",la:33.50,ln:72.20,desc:"Alexander arrives at the Hydaspes River (Jhelum) in monsoon season. King Porus's army waits on the opposite bank with 200 war elephants, blocking Alexander's advance."},
    {year:"Jul 326 BCE",label:"Alexander's night crossing",la:33.50,ln:72.20,desc:"Alexander uses a brilliant tactical deception. He crosses the Hydaspes at night during a thunderstorm 27 km upstream, catching Porus's forces by surprise and forcing them to fight on two fronts."},
    {year:"Jul 326 BCE",label:"The battle against Porus",la:33.50,ln:72.20,desc:"Porus's elephants initially cause chaos among Alexander's cavalry. But Macedonian tactics of surrounding the enemy prevail. Porus fights from his elephant until wounded and finally surrenders with dignity."},
    {year:"326 BCE",label:"Mutiny and return",la:32.20,ln:74.60,desc:"Alexander is impressed by Porus and reinstates him as a vassal. But at the Beas River, Alexander's army mutinies, refusing to march further east. Alexander is forced to turn back, ending his Indian campaign."}
  ]},
  {n:'Second Anglo-Sikh War',la:32.80,ln:73.70,sub:'1848-49 · Punjab',desc:'Battle of Gujrat (1849). British defeated Sikhs. Annexed Punjab. Ranjit Singh\'s empire ended.',fact:'Treaty of Lahore (1846) · Koh-i-Noor diamond taken · Dalhousie annexed Punjab',steps:[
    {year:"1845-46",label:"First Anglo-Sikh War",la:31.18,ln:74.84,desc:"The British defeat the Sikh Khalsa Army in the First Anglo-Sikh War. The Treaty of Lahore reduces the Sikh kingdom to a vassal state, cedes Kashmir, and imposes a British Resident in Lahore."},
    {year:"Apr 1848",label:"Revolt at Multan",la:30.19,ln:71.47,desc:"Sikh soldiers and the governor of Multan, Mulraj, revolt against British interference. The rebellion spreads rapidly across Punjab, with Sikh nobles and the Khalsa army rallying under Chatar Singh and Sher Singh."},
    {year:"Jan 1849",label:"Battle of Chillianwala",la:32.64,ln:73.58,desc:"The British army under Lord Gough attacks the Sikh positions at Chillianwala. The battle is a bloody draw — the Sikhs prove their equal fighting ability, inflicting 2,300 British casualties in one of the costliest British battles in India."},
    {year:"21 Feb 1849",label:"Battle of Gujrat",la:32.80,ln:73.70,desc:"Lord Gough defeats the Sikh army at Gujrat using heavy artillery. The Sikh resistance collapses. The British pursue the remnants into the hills, and the Sikh army formally surrenders at Rawalpindi."},
    {year:"Mar 1849",label:"Annexation of Punjab",la:31.56,ln:74.36,desc:"Lord Dalhousie announces the annexation of Punjab into British India. The Koh-i-Noor diamond is confiscated and sent to Queen Victoria. The Sikh Empire of Maharaja Ranjit Singh is no more."}
  ]},
  {n:'Battle of Wandiwash',la:12.80,ln:79.60,sub:'1760 · Tamil Nadu',desc:'British (Sir Eyre Coote) vs French (Comte de Lally). British victory ended French ambitions in India.',fact:'Pondicherry captured 1761 · France lost Indian possessions except Pondicherry',steps:[
    {year:"1746-58",label:"Anglo-French rivalry in India",la:12.80,ln:79.60,desc:"The French under Dupleix and Bussy establish dominance in the Deccan and Carnatic during the First and Second Carnatic Wars. The British struggle to counter French influence in South India."},
    {year:"1758",label:"Lally's arrival and early success",la:12.80,ln:79.60,desc:"Comte de Lally arrives from France with a fleet. He captures Fort St. David from the British and besieges Madras. But his failure to take Madras and financial troubles weaken the French position."},
    {year:"22 Jan 1760",label:"Battle of Wandiwash",la:12.80,ln:79.60,desc:"Sir Eyre Coote's British forces engage Lally's French army at Wandiwash. British artillery and cavalry prove superior. The French are routed, and Lally retreats to Pondicherry, leaving his Indian allies exposed."},
    {year:"Jan 1761",label:"Fall of Pondicherry",la:11.93,ln:79.83,desc:"Coote besieges Pondicherry. Lally surrenders after months of starvation. The French fortifications are razed. France retains only Pondicherry as a trading post, and British supremacy in India is assured."}
  ]},
  {n:'First Battle of Tarain',la:29.80,ln:76.94,sub:'1191 · Tarain',desc:'Prithviraj Chauhan vs Muhammad Ghori. Rajput victory. Ghori captured but released. First major Muslim invasion of North India.',fact:'Prithviraj\'s chivalry spared Ghori · Ghori returned next year · Chauhan ruled Delhi & Ajmer',steps:[
    {year:"1186-90",label:"Ghori's conquests in Punjab",la:31.55,ln:74.34,desc:"Muhammad Ghori captures Multan, Sindh, and Lahore from the Ghaznavids. He establishes a strong base in Punjab, bringing his frontier to the borders of Prithviraj Chauhan's kingdom."},
    {year:"1190",label:"Ghori invades Rajput territory",la:29.80,ln:76.94,desc:"Ghori crosses into the territory of Prithviraj Chauhan, the powerful Rajput ruler of Delhi and Ajmer. He captures the fortress of Tabarhind (Bhatinda), provoking Prithviraj to respond."},
    {year:"1191",label:"First Battle of Tarain",la:29.80,ln:76.94,desc:"Prithviraj's massive Rajput army meets Ghori at Tarain. The Rajput cavalry charges overwhelm Ghori's forces. Ghori is wounded and captured but Prithviraj spares his life — a decision that has far-reaching consequences."},
    {year:"1191-92",label:"The aftermath",la:29.80,ln:76.94,desc:"Prithviraj returns to Delhi, having secured a decisive victory but failing to pursue Ghori. Ghori returns to Ghazni, humiliated, and spends the next year building a larger and better-prepared army for revenge."}
  ]},
  {n:'Siege of Chittorgarh',la:24.89,ln:74.65,sub:'1303 · Rajasthan',desc:'Alauddin Khalji vs Rana Ratan Singh. Khalji captured Chittor after 8-month siege. Padmini legend (jauhar). Shifted power in Rajasthan.',fact:'Legend of Rani Padmini · First of 3 jauhar in Chittor\'s history · Khalji renamed it Khizrabad',steps:[
    {year:"1296-1302",label:"Alauddin Khalji's consolidation",la:28.60,ln:77.20,desc:"Alauddin Khalji ascends the Delhi throne and launches campaigns across India. Chittorgarh, the symbol of Rajput pride and ruled by the Guhila dynasty under Rana Ratan Singh, remains independent and defiant."},
    {year:"Jan 1303",label:"Khalji marches to Chittor",la:24.89,ln:74.65,desc:"Alauddin Khalji, reportedly motivated by the legendary beauty of Rani Padmini, leads a massive army to Chittorgarh. The fort is one of the most formidable in India, perched on a 180m hill."},
    {year:"Jan-Aug 1303",label:"The eight-month siege",la:24.89,ln:74.65,desc:"Khalji's army encircles Chittor for eight long months. The Rajputs defend heroically, but food and water run out. Alauddin's superior siege equipment and numbers gradually wear down the defenders."},
    {year:"Aug 1303",label:"Jauhar and the fall",la:24.89,ln:74.65,desc:"With defeat imminent, Rani Padmini and the women of Chittor commit jauhar (self-immolation). The Rajput men don saffron robes and charge to their death. Chittor falls, and Alauddin renames it Khizrabad."}
  ]},
  {n:'Battle of Kili',la:28.80,ln:77.15,sub:'1299 · Delhi',desc:'Alauddin Khalji vs Mongols (Qutlugh Khwaja). First major Mongol defeat in India. Khalji\'s general Zafar Khan died. Saved Delhi from Mongol invasion.',fact:'Zafar Khan died fighting · 200,000 Mongol army · Alauddin\'s Deccan campaigns funded defense',steps:[
    {year:"1292-98",label:"Mongol invasions of India",la:28.80,ln:77.15,desc:"The Mongols under the Chagatai Khanate repeatedly invade the Delhi Sultanate. Alauddin Khalji, who seized the throne in 1296, fortifies Delhi's defenses and strengthens his army to counter the threat."},
    {year:"1299",label:"Qutlugh Khwaja's invasion",la:28.80,ln:77.15,desc:"Qutlugh Khwaja, a grandson of Genghis Khan's son Chagatai, leads a massive Mongol army of 200,000 toward Delhi. Alauddin decides to meet the Mongols in open battle rather than besieging them."},
    {year:"1299",label:"Battle of Kili",la:28.80,ln:77.15,desc:"The armies clash near Kili on the outskirts of Delhi. Alauddin's general Zafar Khan charges into the Mongol center and wreaks havoc but pursues too far and is surrounded and killed. However, the Mongol advance is halted."},
    {year:"1299-1306",label:"End of Mongol threat",la:28.80,ln:77.15,desc:"The Mongols retreat after heavy losses. Alauddin uses the wealth from his Deccan campaigns to build stronger defenses. Subsequent Mongol invasions in 1303, 1305, and 1306 are all repulsed, ending the Mongol menace to Delhi."}
  ]},
  {n:'Battle of Khanwa',la:27.03,ln:77.57,sub:'1527 · Rajasthan',desc:'Babur vs Rana Sanga (Mewar). Babur\'s decisive victory using gunpowder & tulughma tactics. Consolidated Mughal rule in North India.',fact:'Babur declared Jihad · Cannons terrified Rajput cavalry · Rana Sanga escaped, died 1528',steps:[
    {year:"Apr 1526",label:"Babur defeats Ibrahim Lodi",la:29.40,ln:76.97,desc:"Babur wins the Battle of Panipat and establishes Mughal rule in Delhi. His control is far from secure — the powerful Rajput confederacy under Rana Sanga poses the greatest threat to his nascent empire."},
    {year:"Jan 1527",label:"Rana Sanga's Rajput confederacy",la:24.58,ln:73.68,desc:"Rana Sanga of Mewar assembles a massive Rajput army of 120,000 cavalry and 500 war elephants. He is joined by several Rajput and Afghan chiefs who see Babur as a foreign invader to be expelled."},
    {year:"16 Mar 1527",label:"Battle of Khanwa",la:27.03,ln:77.57,desc:"Babur's 60,000 men face the Rajput alliance at Khanwa. Babur uses his cannons and matchlockmen behind a defensive cart formation. The terrified Rajput elephants and cavalry are mowed down by gunpowder fire."},
    {year:"1527-30",label:"Consolidation of Mughal rule",la:28.60,ln:77.20,desc:"Rana Sanga escapes but dies of poison in 1528. Babur's victory at Khanwa breaks Rajput resistance and cements Mughal rule in North India. He adopts the title Ghazi (holy warrior) after this battle."}
  ]},
  {n:'Battle of Ghaghra',la:25.65,ln:84.66,sub:'1529 · Bihar',desc:'Babur vs Afghan confederation (Mahmud Lodi & Sultan of Bengal). Last battle of Babur. Completed Mughal control of North India.',fact:'Babur\'s last battle · Afghans crushed · Bengal annexed · Mughal dominance assured',steps:[
    {year:"1526-28",label:"Afghan resistance in the east",la:28.60,ln:77.20,desc:"After Babur's victories at Panipat and Khanwa, Afghan nobles loyal to the Lodi dynasty regroup in Bihar under Mahmud Lodi, brother of Ibrahim Lodi. They ally with Sultan Nusrat Shah of Bengal."},
    {year:"Jan 1529",label:"Babur marches east",la:25.65,ln:84.66,desc:"Babur marches from Agra to confront the Afghan-Bengal alliance. He crosses the Ganges and arrives near the confluence of the Ganges and Ghaghra rivers, where the allied forces are encamped."},
    {year:"6 May 1529",label:"Battle of Ghaghra",la:25.65,ln:84.66,desc:"Babur attacks the Afghan camp with a coordinated river and land assault. The Afghan forces are decisively defeated. Mahmud Lodi escapes but the Afghan resistance in North India is effectively crushed."},
    {year:"1529-30",label:"Babur's final years",la:28.60,ln:77.20,desc:"Babur returns to Agra having secured Mughal control from Kabul to Bengal. He dies in December 1530 at age 47. His son Humayun inherits an empire that stretches across North India."}
  ]},
  {n:'Battle of Chausa',la:25.50,ln:83.57,sub:'1539 · Bihar',desc:'Sher Shah Suri vs Humayun. Suri decisive victory. Humayun narrowly escaped (swam across Ganges). Suri crowned emperor.',fact:'Humayun\'s "bath" — escaped in water · Suri re-established Afghan rule · Paved way for Sur Empire',steps:[
    {year:"1537-38",label:"Sher Khan's rise in Bihar",la:25.50,ln:83.57,desc:"Sher Khan (later Sher Shah Suri), an Afghan chieftain, builds up his power in Bihar. He captures the fort of Chunar and begins challenging Mughal authority while Humayun is distracted by campaigns in Gujarat."},
    {year:"1539",label:"Humayun marches east",la:28.60,ln:77.20,desc:"Humayun finally marches against Sher Khan with a large Mughal army. Sher Khan uses scorched earth tactics, avoiding a pitched battle while his forces harass the Mughal supply lines."},
    {year:"26 Jun 1539",label:"Battle of Chausa",la:25.50,ln:83.57,desc:"Sher Khan launches a surprise dawn attack on the Mughal camp at Chausa. The Mughal army is caught completely off guard. Humayun barely escapes with his life, famously swimming across the Ganges on a water skin."},
    {year:"1539-40",label:"Sher Shah crowns himself",la:25.50,ln:83.57,desc:"After his victory, Sher Khan assumes the title Sher Shah Suri and is crowned emperor. He establishes the Sur Empire, implementing administrative reforms including the rupee currency and Grand Trunk Road."}
  ]},
  {n:'Battle of Kanauj',la:27.05,ln:79.92,sub:'1540 · UP',desc:'Sher Shah Suri vs Humayun (rematch). Humayun defeated again. Exiled 15 years (1540-1555). Sur Empire ruled North India.',fact:'Humayun exiled to Persia · Sher Shah\'s Grand Trunk Road · Land revenue system inspired Akbar',steps:[
    {year:"1539-40",label:"After Chausa",la:28.60,ln:77.20,desc:"After his humiliating defeat at Chausa, Humayun retreats to Agra and assembles a new army. Sher Shah consolidates his position in Bihar and prepares to strike at the heart of the Mughal Empire."},
    {year:"May 1540",label:"The march to Kanauj",la:27.05,ln:79.92,desc:"Sher Shah advances toward Kanauj with a well-organized army. Humayun marches to meet him. Both armies camp on opposite banks of the Ganges, engaging in a tense standoff for several weeks."},
    {year:"17 May 1540",label:"Battle of Kanauj (Bilgram)",la:27.05,ln:79.92,desc:"This time there is no surprise. Humayun's divided command and poor generalship are exposed. Sher Shah crushes the Mughal army in a set-piece battle. Humayun flees, beginning his 15-year exile in Persia."},
    {year:"1540-45",label:"Sher Shah's golden rule",la:27.05,ln:79.92,desc:"Sher Shah Suri rules from Delhi, implementing brilliant administrative and fiscal reforms. He builds the Grand Trunk Road, introduces the rupee, and establishes a land revenue system that later inspires Akbar's reforms."}
  ]},
  {n:'Battle of Kolhapur',la:16.70,ln:74.23,sub:'1659 · Maharashtra',desc:'Shivaji vs Afzal Khan (Bijapur). Shivaji killed Afzal Khan with tiger claws (wagh nakh). First major Maratha victory. Inspired rebellion.',fact:'Shivaji used wagh nakh & bichuwa · Afzal Khan\'s treachery plot · Booty funded Maratha forts',steps:[
    {year:"1645-58",label:"Shivaji's early conquests",la:18.50,ln:73.80,desc:"Shivaji captures several forts in the Western Ghats from Bijapur control. The Bijapur Sultanate, viewing Shivaji as a rebellious vassal, decides to crush him. Afzal Khan is dispatched with 10,000 troops."},
    {year:"1659",label:"Afzal Khan's treacherous plan",la:16.70,ln:74.23,desc:"Afzal Khan invites Shivaji for a peace meeting, planning to assassinate him. He hides a dagger in his coat. Shivaji, suspecting treachery, wears armor beneath his clothes and conceals wagh nakh (tiger claws) in his hand."},
    {year:"10 Nov 1659",label:"The meeting at Pratapgarh",la:16.70,ln:74.23,desc:"At the foothills of Pratapgarh fort, Afzal Khan embraces Shivaji and stabs him — but the armor saves Shivaji. Shivaji retaliates, ripping open Afzal Khan's stomach with his wagh nakh. The Bijapur army is routed."},
    {year:"1659-60",label:"Maratha rebellion ignited",la:18.50,ln:73.80,desc:"Shivaji captures enormous booty including 300 horses and 65 elephants. The victory inspires Maratha chiefs to rally behind Shivaji. He captures more forts and lays the foundation of the Maratha Empire."}
  ]},
  {n:'Battle of Pavan Khind',la:16.17,ln:73.97,sub:'1660 · Maharashtra',desc:'Baji Prabhu Deshpande & 300 Marathas vs 10,000 Bijapur army. Rearguard action allowing Shivaji\'s escape from Panhala fort. Ultimate sacrifice.',fact:'Baji Prabhu fought for 5 hours after being shot · Ghod Khind renamed Pavan Khind · 300 vs 10,000',steps:[
    {year:"1659-60",label:"Shivaji trapped at Panhala",la:16.81,ln:74.10,desc:"After the Afzal Khan incident, the Bijapur Sultan sends Siddi Jauhar with 30,000 men to besiege Shivaji at Panhala fort. The siege drags on for months with food running out inside the fort."},
    {year:"Jul 1660",label:"Shivaji's escape plan",la:16.81,ln:74.10,desc:"Shivaji decides to break out of Panhala. He sends a message that he will negotiate while secretly planning an escape. On the night of July 13, he and a small party slip out under cover of darkness."},
    {year:"13 Jul 1660",label:"The rearguard at Pavan Khind",la:16.17,ln:73.97,desc:"Baji Prabhu Deshpande and 300 Maratha soldiers hold the narrow mountain pass of Ghod Khind against 10,000 Bijapur pursuers. Despite being shot multiple times, Baji Prabhu fights for 5 hours holding the pass."},
    {year:"13 Jul 1660",label:"Shivaji reaches safety",la:16.17,ln:73.97,desc:"Baji Prabhu only stops fighting when he hears the cannon signal confirming Shivaji has safely reached Vishalgad. He dies standing, still holding his sword. Ghod Khind is renamed Pavan Khind (Holy Pass) in his honor."}
  ]},
  {n:'Battle of Sinhagad',la:18.37,ln:73.75,sub:'1670 · Maharashtra',desc:'Tanaji Malusare (Maratha) vs Mughal fort of Kondhana. Night climb with monitor lizard (ghorpad). Tanaji died but fort captured.',fact:'Shivaji said "Gad ala pan Sinha gela" (fort won but lion lost) · Condolence for Tanaji',steps:[
    {year:"1665-69",label:"Treaty of Purandar and its aftermath",la:18.37,ln:73.75,desc:"Shivaji signs the Treaty of Purandar with the Mughals, ceding many forts including Kondhana. By 1669, Shivaji decides to reclaim his lost territories and targets the strategic fort of Kondhana."},
    {year:"Feb 1670",label:"The night climb",la:18.37,ln:73.75,desc:"Tanaji Malusare, Shivaji's childhood friend and most trusted commander, leads 300 Mavalas at night. They use a ghorpad (monitor lizard) named Yeshwanti to scale the sheer 300m cliff of the fort."},
    {year:"4 Feb 1670",label:"Battle of Sinhagad",la:18.37,ln:73.75,desc:"Tanaji's men take the Mughal garrison by surprise. In the fierce hand-to-hand combat that follows, Tanaji fights brilliantly but is mortally wounded. His brother Suryaji takes command and secures the fort."},
    {year:"1670",label:"Shivaji's lament",la:18.37,ln:73.75,desc:"Shivaji famously says 'Gad ala pan Sinha gela' (The fort is won but the lion is lost). Kondhana is renamed Sinhagad (Lion's Fort) in Tanaji's honor. Shivaji personally visits the fort and holds a condolence ceremony."}
  ]},
  {n:'Battle of Palkhed',la:20.20,ln:75.50,sub:'1728 · Maharashtra',desc:'Baji Rao I vs Nizam-ul-Mulk. Masterpiece of cavalry movement & guerrilla logistics. Marathas surrounded & forced Nizam to treaty.',fact:'Baji Rao\'s lightning campaign · Cut off Nizam\'s supply · Palkhed = Baji Rao\'s tactical masterpiece',steps:[
    {year:"1720-27",label:"Rise of Baji Rao I",la:20.20,ln:75.50,desc:"At age 20, Baji Rao I becomes Peshwa of the Maratha Empire. He proposes a bold strategy of northern expansion. The Nizam-ul-Mulk, the Mughal viceroy of the Deccan, views the Marathas as a threat to his power."},
    {year:"1727",label:"Nizam invades Maratha territory",la:20.20,ln:75.50,desc:"The Nizam invades Maratha territory with a large army. Baji Rao refuses to meet him in a set-piece battle. Instead, he launches a lightning cavalry campaign that is considered the masterpiece of Indian guerrilla warfare."},
    {year:"1728",label:"Baji Rao's lightning campaign",la:20.20,ln:75.50,desc:"Baji Rao marches 1,000 km in three weeks with 40,000 cavalry, burning and looting Nizam's territories. He cuts the Nizam's supply lines and surrounds him at Palkhed, preventing any escape."},
    {year:"Mar 1728",label:"Treaty of Palkhed",la:20.20,ln:75.50,desc:"The Nizam, trapped without food or water, is forced to negotiate. He signs the Treaty of Palkhed, recognizing Maratha rights to collect chauth in the Deccan. Baji Rao's reputation as a military genius is established."}
  ]},
  {n:'Battle of Delhi (1737)',la:28.61,ln:77.23,sub:'1737 · Delhi',desc:'Baji Rao I vs Mughals. Marathas raided outskirts of Delhi. Mughal emperor Muhammad Shah sought peace. Maratha power reached North.',fact:'First Maratha appearance near Delhi · Jat-Sikh-Maratha alliance · Showed Mughal weakness',steps:[
    {year:"1728-36",label:"Maratha expansion northward",la:28.60,ln:77.23,desc:"After Palkhed, Baji Rao I turns his attention northward. The Marathas form alliances with the Jats and Sikhs, both of whom are resentful of Mughal rule. They begin raiding into Mughal territory."},
    {year:"Mar 1737",label:"March on Delhi",la:28.60,ln:77.23,desc:"Baji Rao leads a lightning cavalry raid directly toward Delhi. He covers 400 km in 12 days, bypassing Mughal fortresses and reaching the outskirts of the Mughal capital before the emperor can react."},
    {year:"Mar 1737",label:"Battle of Delhi outskirts",la:28.60,ln:77.23,desc:"The Mughal emperor Muhammad Shah sends a 30,000-strong army to stop the Marathas. Baji Rao defeats them near the gates of Delhi. The Marathas plunder the suburbs and the Mughal court is thrown into panic."},
    {year:"1737",label:"Treaty with the Mughals",la:28.60,ln:77.23,desc:"The Mughal emperor sues for peace, granting the Marathas the right to collect chauth in the rich provinces of Malwa and Bundelkhand. This is the first time Maratha power is acknowledged by the Mughal throne."}
  ]},
  {n:'Battle of Karnal',la:29.68,ln:76.98,sub:'1739 · Haryana',desc:'Nadir Shah (Persia) vs Mughal Emperor Muhammad Shah. Mughals crushed. Nadir Shah sacked Delhi, massacred ~30,000. Peacock throne taken.',fact:'Peacock throne taken to Iran · Koh-i-Noor from here · 30K Delhi massacre · Ended Mughal power',steps:[
    {year:"1738",label:"Nadir Shah invades India",la:34.00,ln:69.00,desc:"Nadir Shah of Persia, after conquering Afghanistan, invades the weakened Mughal Empire. He captures Ghazni, Kabul, and Lahore, then advances toward Delhi. The Mughal court is paralyzed and slow to respond."},
    {year:"Feb 1739",label:"The Mughal army assembles",la:29.68,ln:76.98,desc:"Emperor Muhammad Shah finally assembles a massive but poorly led army of 100,000 men at Karnal. The Mughal generals, consumed by internal rivalries, fail to coordinate."},
    {year:"24 Feb 1739",label:"Battle of Karnal",la:29.68,ln:76.98,desc:"Nadir Shah's 55,000 veteran Persian troops destroy the Mughal army in a few hours. The Mughal commander Khan Dowran is killed. The emperor is captured and forced to surrender Delhi to the Persian conqueror."},
    {year:"Mar 1739",label:"Sack of Delhi",la:28.60,ln:77.23,desc:"Nadir Shah enters Delhi and orders a general massacre after rumors of his assassination. ~30,000 citizens are killed. He loots the Peacock Throne, the Koh-i-Noor diamond, and treasures worth ₹875 million."}
  ]},
  {n:'Battle of Vasai',la:19.33,ln:72.82,sub:'1739 · Maharashtra',desc:'Marathas (Chimaji Appa, Baji Rao\'s brother) vs Portuguese. Ended Portuguese power in India. Bassein fort surrendered after 3-year siege.',fact:'Chimaji Appa\'s great victory · Portuguese reduced to Goa, Daman, Diu · 11 Maratha generals honored',steps:[
    {year:"1737-38",label:"Maratha campaign against the Portuguese",la:19.33,ln:72.82,desc:"Chimaji Appa, brother of Peshwa Baji Rao I, leads a Maratha campaign to expel the Portuguese from the Konkan coast. The Portuguese, who control the prosperous port of Vasai (Bassein), resist fiercely."},
    {year:"1738",label:"Capture of Portuguese outposts",la:19.10,ln:72.85,desc:"Chimaji Appa systematically captures Portuguese forts and strongholds around Vasai — including the key forts of Arnala, Kelve, and Mahim. The Portuguese are gradually pushed back into Vasai fort."},
    {year:"1739",label:"Siege of Vasai fort",la:19.33,ln:72.82,desc:"The Marathas besiege the heavily fortified Vasai fort. The Portuguese garrison holds out for months. Chimaji Appa uses a combination of artillery bombardment, mining, and frontal assaults to breach the defenses."},
    {year:"May 1739",label:"Fall of Vasai",la:19.33,ln:72.82,desc:"The Portuguese surrender after a heroic defense. Chimaji Appa enters the fort victorious. The treaty reduces Portuguese presence to Goa, Daman, and Diu. The Maratha Empire gains control of the Konkan coast."}
  ]},
  {n:'Battle of Udgir',la:18.38,ln:77.12,sub:'1760 · Maharashtra',desc:'Marathas (Sadashivrao Bhau) vs Nizam. Maratha victory. Treaty of Udgir gave Marathas territory of 6M rupees revenue.',fact:'Precursor to Panipat III · Maratha power at zenith before Panipat · Nizam paid tribute',steps:[
    {year:"1758-59",label:"Maratha power at its zenith",la:18.38,ln:77.12,desc:"The Marathas under the Peshwa are at the height of their power. They control Delhi and much of North India. The Nizam of Hyderabad, a long-time rival, still challenges Maratha authority in the Deccan."},
    {year:"1760",label:"Sadashivrao Bhau marches south",la:18.38,ln:77.12,desc:"Sadashivrao Bhau, the cousin of Peshwa Balaji Baji Rao, leads a large Maratha army against the Nizam. The Nizam's forces include French-trained troops with modern artillery."},
    {year:"Feb 1760",label:"Battle of Udgir",la:18.38,ln:77.12,desc:"The two armies meet at Udgir. Sadashivrao Bhau's tactical brilliance overwhelms the Nizam's forces. The Maratha cavalry outflanks the Nizam's artillery and the Nizam's army is routed."},
    {year:"1760",label:"Treaty of Udgir",la:18.38,ln:77.12,desc:"The Nizam signs the Treaty of Udgir, ceding territories worth 6 million rupees in annual revenue to the Marathas. The victory emboldens Sadashivrao Bhau to march north for the fateful campaign against Abdali at Panipat."}
  ]},
  {n:'Battle of Pollilur',la:12.87,ln:79.53,sub:'1780 · Tamil Nadu',desc:'Haidar Ali (Mysore) vs British (Colonel Baillie). Mysore crushed British detachment. Worst British defeat in India at that point.',fact:'Haidar Ali\'s rocket brigade used · 4,000 British killed or captured · Tipu Sultan fought here',steps:[
    {year:"1767-69",label:"First Anglo-Mysore War",la:12.87,ln:79.53,desc:"Haidar Ali of Mysore emerges as a formidable enemy of the British. After the inconclusive First Anglo-Mysore War, Haidar modernizes his army with French assistance and bides his time for revenge."},
    {year:"Jul 1780",label:"Haidar Ali invades the Carnatic",la:12.87,ln:79.53,desc:"Haidar Ali launches a massive invasion of the Carnatic with 80,000 troops, including rocket brigades and French-trained infantry. He sweeps through British-held territory, burning villages and cutting off Madras."},
    {year:"10 Sep 1780",label:"Battle of Pollilur",la:12.87,ln:79.53,desc:"Colonel Baillie's 4,000 British troops march to join Sir Hector Munro. Haidar Ali and his son Tipu Sultan trap Baillie at Pollilur. Mysorean rockets and cavalry destroy the British column. Only 200 British survive."},
    {year:"1780-82",label:"Aftermath",la:12.87,ln:79.53,desc:"The defeat at Pollilur is the worst British loss in India to date. Sir Eyre Coote is sent to retrieve the situation. The war ends with the Treaty of Mangalore in 1784, with no clear victor."}
  ]},
  {n:'Siege of Srirangapatna',la:12.42,ln:76.68,sub:'1799 · Karnataka',desc:'British (Wellesley) vs Tipu Sultan (Fourth Anglo-Mysore War). Tipu died defending. End of Mysore kingdom. British supreme in South.',fact:'Tipu\'s death at Water Gate "I would rather live two days like a tiger" · Tiger of Mysore',steps:[
    {year:"1792-98",label:"Tipu's recovery and French alliance",la:12.42,ln:76.68,desc:"After losing the Third Anglo-Mysore War, Tipu Sultan rebuilds his army and fortifications. He secretly sends envoys to Napoleon Bonaparte and the French Republic, seeking an alliance to expel the British from India."},
    {year:"Feb 1799",label:"British prepare for war",la:12.42,ln:76.68,desc:"Lord Wellesley (Governor-General) demands Tipu reduce his army and accept British protection. Tipu refuses. The British assemble a massive army under Arthur Wellesley, joined by the Nizam and Marathas."},
    {year:"Apr-May 1799",label:"Siege of Srirangapatna",la:12.42,ln:76.68,desc:"The British army besieges Srirangapatna, Tipu's island fortress. After breaching the walls on May 4, British troops storm the fort. Tipu fights personally at the Water Gate and is killed, his body found buried under a pile of defenders."},
    {year:"May 1799",label:"End of the Kingdom of Mysore",la:12.42,ln:76.68,desc:"Tipu's death ends the Anglo-Mysore Wars. The British restore the Wodeyar dynasty as a puppet ruler. Mysore becomes a princely state under British suzerainty. British supremacy in South India is complete."}
  ]},
  {n:'Battle of Assaye',la:20.24,ln:75.88,sub:'1803 · Maharashtra',desc:'Arthur Wellesley (future Duke of Wellington) vs Marathas (Sindhia & Bhonsle). British outnumbered 5:1 but won. Wellesley\'s greatest battle.',fact:'Wellesley said Assaye > Waterloo · 3,000 British vs 15,000 Marathas · 1,600 British casualties',steps:[
    {year:"1802",label:"Treaty of Bassein",la:19.33,ln:72.82,desc:"The Peshwa Baji Rao II signs the Treaty of Bassein with the British, accepting subsidiary alliance. This angers the Maratha chiefs Sindhia and Bhonsle, who refuse to accept British interference."},
    {year:"Aug 1803",label:"Maratha confederacy declares war",la:19.08,ln:72.87,desc:"Sindhia and Bhonsle form an alliance against the British. Arthur Wellesley, commanding British and allied troops, marches from the Deccan to confront them. The Maratha army numbers 50,000 with French-trained artillery."},
    {year:"23 Sep 1803",label:"Battle of Assaye",la:20.24,ln:75.88,desc:"Wellesley attacks despite being outnumbered 5:1. He leads from the front, losing two horses beneath him. British infantry braves deadly Maratha cannon fire and captures the guns. 1,600 British casualties in one of the bloodiest battles."},
    {year:"1803-05",label:"Wellesley's assessment",la:20.24,ln:75.88,desc:"The victory at Assaye breaks the Maratha resistance. Wellesley later says Assaye was his finest battle, greater than Waterloo. He captures Ahmednagar, and the war ends with the Marathas ceding territory to the British."}
  ]},
  {n:'Battle of Laswari',la:28.50,ln:77.10,sub:'1803 · Haryana',desc:'British (Lord Lake) vs Marathas (Sindhia\'s French-trained troops). British victory destroyed French influence in Maratha army. Delhi captured.',fact:'End of French-trained Indian regiments · Delhi & Agra captured · French generals left India',steps:[
    {year:"Aug 1803",label:"Lord Lake's campaign",la:28.60,ln:77.23,desc:"Lord Lake leads a British army north from Calcutta to capture Delhi and Agra. The Marathas under Sindhia have a modern army commanded by French generals Perron and Bourquin."},
    {year:"Sep 1803",label:"Battle of Aligarh",la:27.90,ln:78.08,desc:"Lake captures the fortress of Aligarh in a daring night assault. The French-trained Maratha gunners put up stiff resistance but are overwhelmed by British discipline and bayonet charges."},
    {year:"1 Nov 1803",label:"Battle of Laswari",la:28.50,ln:77.10,desc:"Lake's cavalry catches the Marathas under General Bourquin at Laswari. The Maratha infantry fights with desperate courage, standing their ground even as their positions are overrun. 7,000 Marathas are killed."},
    {year:"Nov 1803",label:"Capture of Delhi and Agra",la:28.60,ln:77.23,desc:"Lake enters Delhi without further resistance and takes the blind Mughal Emperor Shah Alam II under British protection. Agra falls soon after. French generals flee India, ending French military influence in the subcontinent."}
  ]},
  {n:'Siege of Bharatpur',la:27.22,ln:77.49,sub:'1825-26 · Rajasthan',desc:'British (Lord Combermere) vs Jat king Balwant Singh. Fort finally taken by mining & explosion. Last major Jat resistance.',fact:'Lord Combermere\'s counter-mines · 900 British casualties · Jat artillery matched British guns',steps:[
    {year:"1805-25",label:"Bharatpur's defiance",la:27.22,ln:77.49,desc:"Bharatpur, a fortified Jat kingdom, had famously resisted British siege in 1805 when Lord Lake was repulsed. In 1825, a succession dispute gives the British a pretext to intervene and capture the fort."},
    {year:"Dec 1825",label:"Lord Combermere's siege begins",la:27.22,ln:77.49,desc:"Lord Combermere arrives with a massive British army of 20,000 and heavy siege artillery. The Jat king Balwant Singh commands the fort's defense with skilled gunners who match the British cannonade."},
    {year:"Jan-Feb 1826",label:"Mining operations",la:27.22,ln:77.49,desc:"The British attempt mining operations to breach the walls. The Jats counter-mine, and several underground duels take place. British casualties mount. Combermere orders a massive mine to be dug under the main bastion."},
    {year:"18 Jan 1826",label:"Assault and capture",la:27.22,ln:77.49,desc:"The massive mine explodes, breaching the walls. British troops storm the fort in a bloody assault. Balwant Singh surrenders. Bharatpur is annexed, ending the last major Jat resistance against British rule."}
  ]},
  {n:'Battle of Sobraon',la:31.18,ln:74.84,sub:'1846 · Punjab',desc:'British vs Sikhs (First Anglo-Sikh War). Sikh defeat. Treaty of Lahore signed. Sikh army (Khalsa) reduced. Kashmir ceded.',fact:'Gulab Singh got Kashmir for 7.5M rupees · Sikhs\' bravery admired · River Sutlej battle',steps:[
    {year:"1839-45",label:"Decline of the Sikh Empire",la:31.56,ln:74.36,desc:"After Maharaja Ranjit Singh's death in 1839, the Sikh Empire is plagued by court intrigues and assassinations. The powerful Sikh Khalsa army grows restive and decides to cross the Sutlej River into British territory."},
    {year:"Dec 1845",label:"First Anglo-Sikh War begins",la:31.56,ln:74.36,desc:"The Sikh army crosses the Sutlej on December 11, 1845. The British under Sir Hugh Gough and Governor-General Hardinge fight a series of bloody battles at Mudki, Ferozeshah, and Aliwal."},
    {year:"10 Feb 1846",label:"Battle of Sobraon",la:31.18,ln:74.84,desc:"The Sikh army makes a final stand at Sobraon, entrenched in a horseshoe-shaped position on the Sutlej. British artillery pounds the Sikh positions for hours. The Sikhs fight with unparalleled bravery but are overwhelmed."},
    {year:"Mar 1846",label:"Treaty of Lahore",la:31.56,ln:74.36,desc:"The Sikhs surrender. The Treaty of Lahore reduces the Sikh army, imposes a British Resident, and cedes Kashmir and Jammu to Gulab Singh for 7.5 million rupees. The Sikh kingdom becomes a British protectorate."}
  ]},
  {n:'Siege of Delhi',la:28.61,ln:77.23,sub:'1857 · Delhi',desc:'British (John Nicholson) vs Indian rebels (Bahadur Shah Zafar). British recaptured Delhi after 5-month siege. End of Mughal Empire. Bahadur Shah exiled to Rangoon.',fact:'Last Mughal emperor exiled · 5 months (Jun-Sep 1857) · Delhi fell Sep 14 · Nicholson died · British revenge massacres',steps:[
    {year:"May 1857",label:"Rebels capture Delhi",la:28.61,ln:77.23,desc:"After the Meerut mutiny, Indian sepoys march to Delhi and capture the city. They proclaim Bahadur Shah Zafar as Emperor of Hindustan. The rebellion spreads rapidly across North and Central India."},
    {year:"Jun 1857",label:"British forces assemble at Ridge",la:28.65,ln:77.23,desc:"The British rush reinforcements from Punjab and establish positions on the Delhi Ridge overlooking the city. They are vastly outnumbered but determined to recapture the historic capital. John Nicholson leads the famed Moveable Column."},
    {year:"Jul-Aug 1857",label:"The long siege",la:28.61,ln:77.23,desc:"Both sides engage in constant skirmishes. The British bombard the city walls day and night. Cholera and heat take a toll on both armies. The rebels launch sorties but fail to dislodge the British from the Ridge."},
    {year:"14 Sep 1857",label:"Storming of Delhi",la:28.61,ln:77.23,desc:"British forces breach the walls at three points after a massive bombardment. John Nicholson leads the assault on the Kashmir Gate and is mortally wounded. After six days of street fighting, Delhi falls to the British."},
    {year:"Sep 1857",label:"Fall of the Mughal Empire",la:28.61,ln:77.23,desc:"Bahadur Shah Zafar is captured and exiled to Rangoon. Delhi is subjected to brutal reprisals. The Mughal Empire, which had ruled India for over 300 years, comes to an end. India passes fully under British Crown rule."}
  ]},
  {n:'Siege of Lucknow',la:26.85,ln:80.95,sub:'1857 · UP',desc:'British garrison besieged by Indian rebels. Defended by Henry Lawrence. Relieved twice (Havelock, Outram, Campbell). Symbol of British resilience.',fact:'Henry Lawrence died · Relief by Havelock Sep 25 · Campbell\'s relief Nov · 2,000+ British casualties · Begum Hazrat Mahal',steps:[
    {year:"Jun 1857",label:"Rebellion engulfs Awadh",la:26.85,ln:80.95,desc:"After the fall of Delhi, the rebellion spreads to Awadh. Sir Henry Lawrence, the British Resident in Lucknow, fortifies the Residency compound and prepares for a siege with 3,000 people including women and children."},
    {year:"Jul-Sep 1857",label:"The first siege",la:26.85,ln:80.95,desc:"Rebel forces under Begum Hazrat Mahal besiege the Residency. Lawrence is killed by a shell on July 4. Inside the compound, conditions deteriorate with disease and constant sniper fire."},
    {year:"25 Sep 1857",label:"First relief by Havelock",la:26.85,ln:80.95,desc:"Generals Havelock and Outram fight their way through the rebel cordon and reach the Residency. But they cannot evacuate the garrison and are themselves trapped, doubling the number of mouths to feed."},
    {year:"17 Nov 1857",label:"Second relief by Campbell",la:26.85,ln:80.95,desc:"Sir Colin Campbell arrives with a larger force and after heavy fighting, breaks through to the Residency. He evacuates the women, children, and wounded, then leaves a garrison to hold the city. Lucknow is finally recaptured in March 1858."}
  ]},
  {n:'Siege of Jhansi',la:25.45,ln:78.57,sub:'1858 · MP',desc:'Rani Lakshmibai vs British (Hugh Rose). Jhansi fell after fierce resistance. Rani escaped to Kalpi & Gwalior. Died fighting at Kotah-ki-Serai.',fact:'Rani Lakshmibai died Jun 18, 1858 · "I will not give my Jhansi" · Fought in male attire · Symbol of women\'s bravery',steps:[
    {year:"Jun 1857",label:"Jhansi under Rani Lakshmibai",la:25.45,ln:78.57,desc:"After the Meerut mutiny, the Rani of Jhansi is left in charge of the state. She maintains order in Jhansi while neighboring states fall to rebellion. The British suspect her of complicity with the rebels."},
    {year:"Jan 1858",label:"British advance on Jhansi",la:25.45,ln:78.57,desc:"Sir Hugh Rose marches toward Jhansi with a British army. He faces stiff resistance from rebel forces along the way. The Rani prepares Jhansi's defenses, personally inspecting the fortifications and manning the guns."},
    {year:"Mar-Apr 1858",label:"Siege of Jhansi",la:25.45,ln:78.57,desc:"Rose besieges Jhansi fort. The Rani leads the defense, firing cannons and rallying her troops. Despite her heroic leadership, British artillery breaches the walls after three weeks. The Rani escapes with her son strapped to her back."},
    {year:"18 Jun 1858",label:"Death of the Rani at Gwalior",la:26.22,ln:78.18,desc:"The Rani reaches Kalpi and then Gwalior, where she joins rebel leader Tantia Tope. At Kotah-ki-Serai, she fights the British in male attire. A sword cuts her head, and a bullet strikes her chest. She dies on the battlefield, becoming India's symbol of resistance."}
  ]},
  {n:'Battle of Koregaon',la:18.64,ln:74.07,sub:'1818 · Maharashtra',desc:'British (Mahar regiment) vs Marathas (Peshwa). 500 British (mostly Mahars) vs 20,000 Marathas. Mahars won. Symbol of Mahar (Dalit) martial valor.',fact:'500 vs 20,000 · Mahar regiment of British · Bhima Koregaon pillar · Peshwa\'s power ended',steps:[
    {year:"1817-18",label:"Third Anglo-Maratha War",la:18.64,ln:74.07,desc:"Peshwa Baji Rao II launches a war against the British. The Marathas are defeated at Khadki and Yerwada. The Peshwa flees south, pursued by British forces, including the 2nd Battalion of the 1st Bombay Native Infantry."},
    {year:"1 Jan 1818",label:"The Maratha trap",la:18.64,ln:74.07,desc:"The Peshwa's 20,000-strong Maratha army intercepts the British detachment of 500 men near the village of Koregaon on the Bhima River. The British force is composed largely of Mahar soldiers, a Dalit community."},
    {year:"1 Jan 1818",label:"Battle of Koregaon",la:18.64,ln:74.07,desc:"The outnumbered Mahar soldiers form a defensive square and fight off waves of Maratha attacks. Running out of ammunition, they hurl stones at the enemy. The Peshwa's army, despite its massive numerical advantage, fails to break them."},
    {year:"1818",label:"Legacy",la:18.64,ln:74.07,desc:"The Peshwa retreats, realizing the British cannot be easily crushed. He surrenders later that year. A pillar is erected at Bhima Koregaon to honor the Mahar soldiers. The site becomes a symbol of Dalit martial valor and pride."}
  ]},
  {n:'Siege of Arcot',la:12.90,ln:79.32,sub:'1751 · Tamil Nadu',desc:'Robert Clive vs French-backed Chanda Sahib. Clive held fort for 53 days with 200 British & 300 sepoys. Turned tide in Carnatic Wars.',fact:'Clive\'s first major command · 53-day siege · 200 vs 10,000 · Clive "a heaven-born general"',steps:[
    {year:"1749-51",label:"Carnatic succession dispute",la:12.90,ln:79.32,desc:"After the death of the Nawab of Carnatic, a succession war erupts. The French support Chanda Sahib, who captures Arcot. The British back the deposed claimant Muhammad Ali and decide to strike Arcot."},
    {year:"Aug 1751",label:"Clive's daring plan",la:12.90,ln:79.32,desc:"Robert Clive, an East India Company clerk turned soldier, volunteers to lead a small force to capture Arcot. He arrives with only 200 British soldiers and 300 sepoys, taking the fort by surprise while the garrison is at dinner."},
    {year:"Sep-Oct 1751",label:"The 53-day siege",la:12.90,ln:79.32,desc:"Chanda Sahib sends 10,000 men to retake Arcot. They besiege the fort, bombarding it day and night. Food runs out inside. Clive's sepoys show remarkable loyalty, drinking water from wells and eating only boiled grain."},
    {year:"Nov 1751",label:"Clive's victory",la:12.90,ln:79.32,desc:"Clive launches a sortie that breaks the siege. The enemy flees, leaving behind supplies. The victory establishes British military prestige in South India. Clive is hailed as a military genius and the tide of the Carnatic Wars turns in Britain's favor."}
  ]},
  {n:'Battle of Ambur',la:12.78,ln:78.69,sub:'1749 · Tamil Nadu',desc:'French (Dupleix) vs Nawab of Carnatic. French victory. Established French influence in South India. First major Carnatic War battle.',fact:'Dupleix\'s ambition · French & Indian troops vs Nawab · Anwar-ud-din killed · Start of Carnatic Wars',steps:[
    {year:"1748",label:"Death of Nizam-ul-Mulk",la:17.40,ln:78.50,desc:"The death of Nizam-ul-Mulk of Hyderabad triggers a succession crisis in the Deccan. The French Governor Dupleix sees an opportunity to expand French influence by intervening in the succession disputes of both Hyderabad and the Carnatic."},
    {year:"1749",label:"Dupleix backs Chanda Sahib",la:12.78,ln:78.69,desc:"Dupleix supports Chanda Sahib's claim to the Carnatic Nawabship against the incumbent Anwar-ud-din Khan. A French-trained army under the Marquis de Bussy marches south with Chanda Sahib's forces."},
    {year:"3 Aug 1749",label:"Battle of Ambur",la:12.78,ln:78.69,desc:"The French and allied forces meet Anwar-ud-din Khan's army at Ambur. French discipline and superior tactics rout the Nawab's forces. Anwar-ud-din Khan is killed in battle. Chanda Sahib is installed as Nawab."},
    {year:"1749-51",label:"French ascendancy",la:12.78,ln:78.69,desc:"The victory at Ambur establishes French military prestige in South India. Chanda Sahib rewards Dupleix with territories. The British, alarmed by French power, prepare to intervene — setting the stage for the Carnatic Wars."}
  ]},
  {n:'Battle of Delhi (1803)',la:28.61,ln:77.23,sub:'1803 · Delhi',desc:'British (Lord Lake) vs Marathas (Sindhia\'s French-trained army). British captured Delhi & Agra. Mughal Emperor Shah Alam II became British pensioner.',fact:'Shah Alam II under British protection · Delhi Sep 1803 · Agra Oct 1803 · French General Perron fled',steps:[
    {year:"1803",label:"Lord Lake's northern campaign",la:28.60,ln:77.23,desc:"As part of the Second Anglo-Maratha War, Lord Lake marches from Cawnpore toward Delhi with 10,000 British and sepoy troops. His objective is to capture Delhi and the blind Mughal emperor from the Marathas."},
    {year:"Sep 1803",label:"Battle outside Delhi",la:28.60,ln:77.23,desc:"Lake's forces encounter the Maratha army under General Bourquin and French commander Perron near Delhi. The Maratha French-trained battalions fight well but are overwhelmed by Lake's cavalry and artillery."},
    {year:"Sep 1803",label:"Capture of Delhi",la:28.60,ln:77.23,desc:"Lake enters Delhi without further opposition. The blind 75-year-old Emperor Shah Alam II, who has been a Maratha puppet, comes under British protection. He issues a firman legitimizing British rule in India."},
    {year:"Oct 1803",label:"Fall of Agra",la:27.18,ln:78.02,desc:"Lake marches on Agra and captures the impregnable fort after a brief siege. French General Perron flees to France. The British now control the Mughal heartland, and Shah Alam II becomes a British pensioner."}
  ]},
  {n:'Battle of Mahidpur',la:23.55,ln:75.82,sub:'1818 · MP',desc:'British (Hugh Malcolm) vs Marathas (Holkar). British victory. Ended Holkar resistance. All Maratha powers defeated. British paramountcy in India.',fact:'Hugh Malcolm\'s cavalry charge · Treaty of Mandaswar · Holkar became British vassal · Third Anglo-Maratha War',steps:[
    {year:"1817",label:"Holkar joins the Maratha alliance",la:23.55,ln:75.82,desc:"During the Third Anglo-Maratha War, Maharaja Malhar Rao Holkar II joins the Peshwa in a final attempt to overthrow British supremacy. The young ruler leads the Holkar army against the British."},
    {year:"Dec 1817",label:"Sir Hugh Malcolm's advance",la:23.55,ln:75.82,desc:"Sir Hugh Malcolm marches with a British force of 5,000 against Holkar's 30,000-strong army. Holkar's forces include Arab mercenaries, Pindari irregulars, and traditional Maratha cavalry."},
    {year:"21 Dec 1817",label:"Battle of Mahidpur",la:23.55,ln:75.82,desc:"Malcolm launches a daring cavalry charge that breaks through the Holkar lines. The British infantry follows up, capturing 70 guns. Holkar's army is routed. The young Maharaja flees the battlefield."},
    {year:"Jan 1818",label:"Treaty of Mandaswar",la:23.55,ln:75.82,desc:"Holkar surrenders and signs the Treaty of Mandaswar, becoming a British vassal. All Maratha powers are now defeated. The British East India Company becomes the paramount power of the Indian subcontinent."}
  ]},
  {n:'Battle of Asirgarh',la:21.47,ln:76.29,sub:'1601 · MP',desc:'Akbar (Mughal) vs Miran Bahadur (Khandesh Sultanate). Fort captured after long siege. Last major conquest of Akbar\'s reign. Khandesh annexed.',fact:'Asirgarh "impregnable" fort · 2-year siege · Akbar\'s last campaign · Khandesh annexed in Deccan',steps:[
    {year:"1599",label:"Akbar's Deccan campaign",la:21.47,ln:76.29,desc:"Emperor Akbar, after completing his conquests in North and West India, turns his attention to the Deccan. He marches south to subdue the Sultanates of Khandesh, Berar, and Ahmednagar."},
    {year:"1599-1600",label:"Siege of Asirgarh begins",la:21.47,ln:76.29,desc:"The formidable fort of Asirgarh, considered impregnable, is the seat of the Khandesh Sultanate's power. Akbar personally oversees the siege. The garrison under Miran Bahadur resists fiercely."},
    {year:"1600-01",label:"The long blockade",la:21.47,ln:76.29,desc:"Akbar's engineers dig trenches and build batteries around the fort. The Mughals bombard Asirgarh with heavy artillery. Inside, food and water run low. Negotiations fail as Miran Bahadur refuses to surrender."},
    {year:"Jan 1601",label:"Asirgarh falls",la:21.47,ln:76.29,desc:"After nearly two years, the fort finally surrenders. Khandesh is annexed into the Mughal Empire. This is Akbar's last major conquest. He dies in 1605, leaving a vast empire stretching from Kabul to the Deccan."}
  ]},
  {n:'Battle of Chillianwala',la:32.64,ln:73.58,sub:'1849 · Punjab',desc:'British vs Sikhs (Second Anglo-Sikh War). Bloody draw — both sides claimed victory. 2,300 British casualties. Sikhs proved equal to British in pitched battle.',fact:'British worst casualties in India · 89 British officers died · Sikhs fought to last · Ended British invincibility myth',steps:[
    {year:"Apr 1848",label:"Revolt against British control",la:32.80,ln:73.70,desc:"The Second Anglo-Sikh War begins with revolts at Multan and Lahore. The Sikh Khalsa army, still bristling from the humiliating Treaty of Lahore, rallies to fight the British once more under Chatar Singh and Sher Singh."},
    {year:"Jan 1849",label:"Lord Gough's advance",la:32.64,ln:73.58,desc:"The British commander Lord Gough leads 15,000 troops into Sikh territory. He is eager for a decisive battle but underestimates the revitalized Sikh Khalsa army, which is fighting for the very survival of the Sikh Empire."},
    {year:"13 Jan 1849",label:"Battle of Chillianwala",la:32.64,ln:73.58,desc:"Gough's attack on Sikh positions at Chillianwala is poorly coordinated. The Sikhs counterattack with ferocity, breaking through British lines. 2,300 British soldiers and 89 officers are killed. The jungle terrain causes chaos in the British ranks."},
    {year:"Jan-Feb 1849",label:"Aftermath",la:32.64,ln:73.58,desc:"Both sides claim victory, but the battle shocks the British public. Gough is almost relieved of command. The Sikhs prove they can match the British in a pitched battle. The British regroup and prepare for a final showdown at Gujrat."}
  ]},
  {n:'Kargil War',la:34.50,ln:76.10,sub:'1999 · Kargil',desc:'India vs Pakistan (intruders). Pakistani soldiers & militants infiltrated Kargil heights. Indian Army recaptured peaks (Tiger Hill, Tololing). Operation Vijay. 527 Indian died.',fact:'Operation Vijay · Tiger Hill capture · 527 Indian martyrs · Pakistani withdrawal (July 26) · Dras, Batalik sectors',steps:[
    {year:"May 1999",label:"Infiltration across the LOC",la:34.50,ln:76.10,desc:"Pakistani soldiers and militants cross the Line of Control and occupy strategic heights in the Kargil sector near the town of Dras. They dig into well-fortified positions commanding the Srinagar-Leh highway."},
    {year:"May 1999",label:"India detects the intrusion",la:34.50,ln:76.10,desc:"Local shepherds report suspicious activity to the Indian Army. Patrols confirm large-scale infiltration. The Indian government mobilizes forces and launches Operation Vijay."},
    {year:"Jun 1999",label:"Air strikes by the IAF",la:34.50,ln:76.10,desc:"The Indian Air Force launches Operation Safed Sagar. Mirage 2000 and MiG-21 fighter jets conduct precision bombing raids on enemy bunkers at altitudes over 16,000 feet."},
    {year:"Jun-Jul 1999",label:"Recapture of the peaks",la:34.58,ln:76.03,desc:"Indian Army soldiers climb steep cliffs under heavy fire to recapture key peaks — Tololing, Tiger Hill, and Point 4875. Intense hand-to-hand combat at extreme high altitude."},
    {year:"26 Jul 1999",label:"India declares victory",la:34.50,ln:76.10,desc:"Pakistan withdraws under international diplomatic pressure. India successfully evicts all intruders and regains control of the territory. 527 Indian soldiers are martyred. July 26 is celebrated as Kargil Vijay Diwas."}
  ]},
  {n:'Battle of Longewala',la:27.60,ln:73.03,sub:'1971 · Rajasthan',desc:'120 Indian soldiers (Major Kuldip Chandpuri) vs Pakistani 51st Infantry Brigade. Indian Air Force destroyed Pakistani tanks. Decisive Indian victory.',fact:'120 vs 2,000+ · HAL-24 Hunter jets from Jaisalmer · Pakistan lost 36+ tanks · Major Chandpuri\'s PVC recommendation',steps:[
    {year:"Dec 1971",label:"Pakistan's thrust into Rajasthan",la:27.60,ln:73.03,desc:"During the Indo-Pakistan War of 1971, Pakistan launches a major armored thrust into Rajasthan. The Pakistani 51st Infantry Brigade, supported by 60 tanks, advances toward the Longewala outpost near the border."},
    {year:"4 Dec 1971",label:"120 men vs 2,000+",la:27.60,ln:73.03,desc:"Major Kuldip Chandpuri commands the Longewala post with only 120 soldiers of the 23 Punjab Regiment. They have no heavy weapons, only light machine guns and one recoilless rifle. The Pakistani force numbers over 2,000."},
    {year:"5 Dec 1971",label:"The night battle",la:27.60,ln:73.03,desc:"The Pakistani attack begins at midnight. The Indians hold their fire until the tanks are close, then illuminate them with parachute flares. The recoilless rifle destroys the lead tank, blocking the approach. Pakistani tanks bog down in soft sand."},
    {year:"Dec 1971",label:"IAF destroys Pakistani armor",la:27.60,ln:73.03,desc:"At dawn, IAF Hunters from Jaisalmer arrive and destroy 36 Pakistani tanks using 68-mm rockets. Chandpuri is awarded the Maha Vir Chakra. The Pakistani offensive into Rajasthan is completely blunted."}
  ]},
  {n:'Battle of Ghaghra (1575)',la:25.65,ln:84.66,sub:'1575 · Bihar',desc:'Akbar\'s forces vs Afghan rebels (Daud Khan Karrani). Akbar\'s victory. Bengal & Bihar annexed into Mughal Empire. Afghan resistance in East ended.',fact:'End of Karrani dynasty · Bengal Mughal subah · Daud Khan killed · East India permanent Mughal territory',steps:[
    {year:"1572-74",label:"Daud Khan's rebellion",la:23.70,ln:90.40,desc:"Daud Khan Karrani, the Afghan ruler of Bengal, refuses to acknowledge Mughal suzerainty and rebels against Emperor Akbar. He raids into Bihar, threatening Mughal territory."},
    {year:"1574",label:"Akbar's advance into Bengal",la:25.65,ln:84.66,desc:"Akbar personally leads a large Mughal army into Bihar and Bengal. The Mughal navy under Muhammad Hussain proceeds down the Ganges to support the land campaign."},
    {year:"3 Mar 1575",label:"Battle of Ghaghra",la:25.65,ln:84.66,desc:"Akbar's forces under Munim Khan engage Daud Khan's Afghans near the Ghaghra river. The Mughal artillery and cavalry overwhelm the Afghan resistance. Daud Khan retreats to Bengal."},
    {year:"Jul 1575",label:"Annexation of Bengal",la:23.70,ln:90.40,desc:"Daud Khan is captured and executed. Bengal and Bihar are formally annexed into the Mughal Empire as provinces (subahs). Afghan resistance in eastern India is permanently crushed."}
  ]},
  {n:'Battle of Bhangani',la:30.77,ln:77.00,sub:'1688 · Himachal',desc:'Guru Gobind Singh vs Rajput hill chiefs. Guru\'s first battle (age 22). Sikh victory. Established Sikh military power in the Punjab hills.',fact:'Guru Gobind Singh\'s first battle · 40,000 vs 4,000 Sikhs · Udai Singh & Kirpa Chand died · Sikh tradition of valor',steps:[
    {year:"1685-87",label:"Guru Gobind Singh at Paonta",la:30.77,ln:77.00,desc:"Guru Gobind Singh establishes his base at Paonta Sahib. He attracts warriors and poets from across North India. His growing power alarms the Rajput hill chiefs who see him as a threat to their authority."},
    {year:"1688",label:"Alliance of the hill chiefs",la:30.77,ln:77.00,desc:"The Rajput hill rajas of Kahlur, Kangra, and others form a confederacy to crush the Guru. Raja Bhim Chand of Kahlur leads an army of 40,000 against the Guru's 4,000 followers."},
    {year:"Sep 1688",label:"Battle of Bhangani",la:30.77,ln:77.00,desc:"The two armies clash at Bhangani near Paonta Sahib. The Guru personally leads his forces. His Sikh warriors fight with exceptional courage despite being outnumbered 10:1. His panj pyare and poets like Bhai Mani Singh distinguish themselves."},
    {year:"Sep 1688",label:"Sikh victory",la:30.77,ln:77.00,desc:"The hill chiefs are defeated despite their numerical superiority. Generals Udai Singh and Kirpa Chand die fighting on the Sikh side. The victory establishes Guru Gobind Singh's military reputation and lays the foundation of the Khalsa army."}
  ]},
  {n:'Siege of Golconda',la:17.38,ln:78.40,sub:'1687 · Telangana',desc:'Aurangzeb vs Golconda Sultanate (Abul Hasan Qutb Shah). 8-month siege. Fort fell by bribery (Abdullah Pasha opened gate). Deccan annexed.',fact:'8-month siege · Diamond mines (Koh-i-Noor from here) · Last Qutb Shahi ruler died in prison · Aurangzeb\'s Deccan campaign',steps:[
    {year:"1685-86",label:"Aurangzeb's Deccan campaign",la:17.38,ln:78.40,desc:"Emperor Aurangzeb moves south to conquer the Deccan Sultanates. After the fall of Bijapur in 1686, he turns his attention to the wealthy Golconda Sultanate, ruled by the Qutb Shahi dynasty."},
    {year:"Jan 1687",label:"Siege of Golconda begins",la:17.38,ln:78.40,desc:"Aurangzeb's massive Mughal army surrounds the formidable Golconda fort, famous for its diamond mines. The fort's fortifications are extremely strong, and Abul Hasan Qutb Shah commands a large garrison with modern artillery."},
    {year:"Jan-Sep 1687",label:"The eight-month siege",la:17.38,ln:78.40,desc:"The Mughals bombard Golconda for eight months but fail to breach its walls. The defenders use rockets and cannons effectively. Aurangzeb's generals grow frustrated as the siege drags on with heavy Mughal casualties."},
    {year:"22 Sep 1687",label:"Betrayal and fall",la:17.38,ln:78.40,desc:"The fort finally falls by treachery. A Mughal officer, Abdullah Pasha, bribes an Afghan commander inside the fort to open a gate at night. Golconda is captured. Abul Hasan is imprisoned for life, and the Deccan is annexed."}
  ]},
  {n:'Battle of Raigarh',la:18.25,ln:73.44,sub:'1689 · Maharashtra',desc:'Mughals vs Marathas. Raigarh (Shivaji\'s capital) captured. Chhatrapati Rajaram fled to Jinji. Symbolic blow to Maratha morale.',fact:'Shivaji\'s capital lost · Rajaram escaped in disguise · Yesubai & Shahu captured · Marathas moved to Jinji',steps:[
    {year:"1680-88",label:"Maratha-Mughal conflict escalates",la:18.25,ln:73.44,desc:"After Shivaji's death in 1680, the Maratha Empire is led by his son Sambhaji. Sambhaji is captured and brutally executed by Aurangzeb in 1689. His younger brother Rajaram succeeds him."},
    {year:"1689",label:"Mughal army marches on Raigarh",la:18.25,ln:73.44,desc:"Aurangzeb orders the capture of Raigarh, Shivaji's capital and the symbolic heart of the Maratha Empire. A large Mughal force under Zulfiqar Khan approaches the fort."},
    {year:"1689",label:"Rajaram's escape and the fall",la:18.25,ln:73.44,desc:"Chhatrapati Rajaram escapes Raigarh disguised as a sadhu just before the fort falls. The Mughals capture the fort and take Rajaram's wife Yesubai and son Shahu as prisoners. The Maratha capital is lost."},
    {year:"1689",label:"The war continues",la:12.25,ln:79.39,desc:"Though Raigarh falls, the Marathas continue their resistance under Rajaram from Jinji in Tamil Nadu. The loss of their capital is a symbolic blow, but the Maratha guerrilla war against Aurangzeb continues for decades."}
  ]},
  {n:'Battle of Jinji',la:12.25,ln:79.39,sub:'1689-98 · Tamil Nadu',desc:'Marathas (Chhatrapati Rajaram) vs Mughals. 8-year siege. Marathas lost but Rajaram escaped. Mughals occupied but Marathas continued war in Deccan.',fact:'8-year siege · Rajaram escaped disguised as sadhu · Zulfiqar Khan delayed capture · Sankaridurg stronghold',steps:[
    {year:"1689",label:"Rajaram reaches Jinji",la:12.25,ln:79.39,desc:"After escaping Raigarh, Chhatrapati Rajaram arrives at the formidable fort of Jinji in Tamil Nadu. The fort is considered impregnable, and Rajaram establishes his court here, continuing the Maratha resistance."},
    {year:"1690-97",label:"The eight-year Mughal siege",la:12.25,ln:79.39,desc:"Zulfiqar Khan leads the Mughal siege of Jinji. The fort's triple walls and strong defenses make it nearly impossible to capture. The siege drags on for years, with Maratha raids keeping the Mughals constantly on edge."},
    {year:"1698",label:"Rajaram's escape and the fort's fall",la:12.25,ln:79.39,desc:"After eight years, the Mughals finally breach Jinji's defenses. Rajaram escapes once again, this time disguised as a sadhu. Zulfiqar Khan captures the fort, possibly deliberately allowing Rajaram to flee to prolong his own command."},
    {year:"1698-1707",label:"Maratha resistance continues",la:18.25,ln:73.44,desc:"Rajaram moves further south and continues the guerrilla war from the Deccan. After his death in 1700, his widow Tarabai leads the Marathas. The Mughals occupy Jinji but cannot crush the Maratha resistance."}
  ]},
  {n:'Battle of Umberkhind',la:18.24,ln:73.40,sub:'1661 · Maharashtra',desc:'Maratha guerrilla attack on Portuguese. Portuguese defeat in Sahyadri pass. Marathas used heavy stones & forest ambush. Portuguese never ventured inland again.',fact:'First Maratha vs European battle · Portuguese Viceroy\'s troops trapped · Maratha forest warfare · Secured Konkan region',steps:[
    {year:"1659-60",label:"Shivaji's conflict with the Portuguese",la:18.24,ln:73.40,desc:"After Shivaji's victory over Afzal Khan, tensions rise with the Portuguese, who control the Konkan coast. The Portuguese refuse to supply Shivaji with ammunition and support his rivals."},
    {year:"1661",label:"Portuguese expedition into the Sahyadris",la:18.24,ln:73.40,desc:"The Portuguese Viceroy sends a well-armed European force into the Sahyadri hills to assert control. The Portuguese march through the narrow pass of Umberkhind, confident of their military superiority."},
    {year:"1661",label:"The Maratha ambush",la:18.24,ln:73.40,desc:"Maratha forces hidden in the dense forest ambush the Portuguese column. They roll heavy stones down the slopes and attack with swords and bows. The Portuguese are trapped in the narrow pass, unable to deploy their firearms effectively."},
    {year:"1661",label:"Portuguese defeat",la:18.24,ln:73.40,desc:"The Portuguese force is annihilated. The survivors retreat to the coast, and the Portuguese never venture into the Maratha hinterland again. This is the first major battle between the Marathas and a European power."}
  ]},
];
D.temple = [
  {n:'Kashi Vishwanath',la:25.31,ln:82.97,sub:'Varanasi, UP · 12 Jyotirlinga',desc:'One of 12 Jyotirlingas. Temple of Shiva on Ganga. Original temple destroyed by Aurangzeb (Gyanvapi mosque built). Rebuilt by Marathas.',fact:'Corridor project (2021) connects to Ganga · Kashi Naresh · 2 golden domes'},
  {n:'Somnath Temple',la:20.89,ln:70.40,sub:'Gujarat · First Jyotirlinga',desc:'First among 12 Jyotirlingas. Destroyed and rebuilt 7+ times by invaders (Mahmud Ghazni 1025). Rebuilt 1951 under Sardar Patel.',fact:'"Somnath = protector of moon" · Rebuilt by Solanki king (12th cent) · Prabhas Patan'},
  {n:'Ramanathaswamy Temple',la:9.29,ln:79.31,sub:'Tamil Nadu · 12 Jyotirlinga',desc:'12th Jyotirlinga in Rameswaram. Longest temple corridor in India (1200m). Associated with Rama (Setu).',fact:'Lingam established by Rama · 1215m corridor · 3,800 ft pillars · 22 theerthams'},
  {n:'Meenakshi Temple',la:9.92,ln:78.12,sub:'Madurai, TN',desc:'One of India\'s most famous temples. 14 gopurams (gateway towers), 1000-pillar hall. Meenakshi (Parvati) + Sundareswar (Shiva).',fact:'14 gopurams, south tower 52m · Nayak architecture · 33000 sculptures · Puthu Mandapam'},
  {n:'Tirupati Balaji',la:13.68,ln:79.35,sub:'Tirumala, AP · Venkateswara',desc:'Richest temple in the world by offerings (~₹1000Cr/year). Lord Venkateswara (Vishnu). On Tirumala hills (860m).',fact:'7 hills (Seshachalam) · Laddu prasadam (GI tag) · Srivari Brahmotsavam · Devotional hub'},
  {n:'Golden Temple (Harmandir)',la:31.62,ln:74.88,sub:'Amritsar, Punjab',desc:'Holiest shrine of Sikhism. Built by Guru Arjan Dev (1604). Gold-plated dome (by Maharaja Ranjit Singh). Sarovar (pool) surrounds.',fact:'4 doors open to all · Akal Takht (highest Sikh authority) · Amritsar = pool of nectar'},
  {n:'Jagannath Temple',la:19.80,ln:85.82,sub:'Puri, Odisha',desc:'One of Char Dham. Built by Anantavarman Chodaganga (Ganga dynasty, 12th cent). Rath Yatra (chariot festival). Only temple with flag symbol.',fact:'Rath Yatra (world\'s largest chariot festival) · Mahaprasad · Non-Hindus can\'t enter'},
  {n:'Brihadeeswarar Temple',la:10.78,ln:79.13,sub:'Thanjavur, TN · UNESCO',desc:'UNESCO WHS. Built by Rajaraja Chola (1010 CE). Largest temple in India. Vimana (tower) 66m — tallest in Bharat. Single stone Nandi.',fact:'Kumbam (dome) weighs 80 tons · Tamil inscriptions on walls · Chola architecture zenith'},
  {n:'Lingaraj Temple',la:20.24,ln:85.83,sub:'Bhubaneswar, Odisha',desc:'Largest temple in Bhubaneswar (11th cent). Dedicated to Shiva (Tribhuvaneswar). Kalinga style of architecture. 55m high.',fact:'Bindu Sagar lake · 150+ smaller shrines within complex · Built by Jajati Keshari (Somavamsi)'},
  {n:'Badrinath Temple',la:30.74,ln:79.49,sub:'Uttarakhand · Char Dham',desc:'One of Char Dham & 108 Divya Desams. On Alaknanda River banks. Dedicated to Vishnu (Badrinarayan). Between Nar & Narayana peaks.',fact:'Adi Shankaracharya established (8th cent) · Neelkanth peak · Tapt Kund hot spring'},
  {n:'Kedarnath Temple',la:30.73,ln:79.07,sub:'Uttarakhand · Jyotirlinga',desc:'One of 12 Jyotirlingas and part of Chota Char Dham. At 3584m. Built by Pandavas (legend) / revived by Adi Shankaracharya.',fact:'Survived 2013 floods · Only open Apr-Nov · Half-ton lingam · Mandakini river'},
  {n:'Ranganathaswamy Temple',la:10.86,ln:78.69,sub:'Srirangam, TN',desc:'Largest functioning Hindu temple in the world (156 acres). Dedicated to Vishnu (Ranganatha). 21 gopurams. Part of Pancharanga Kshetrams.',fact:'1000-pillar mandapam · Rajagopuram (72m, unfinished) · Temple town within 7 walls'},
  {n:'Konark Sun Temple',la:19.89,ln:86.09,sub:'Konark, Odisha · UNESCO',desc:'UNESCO WHS. Built by Narasimhadeva I (1250 CE). Surya\'s chariot with 12 wheels & 7 horses. Magnetic influence legend.',fact:'Chandrabhaga river · Sun dial for time · Natya Mandap (dancing hall)'},
  {n:'Dwarkadhish Temple',la:22.23,ln:68.97,sub:'Dwarka, Gujarat · Char Dham',desc:'One of Char Dham. 5-storey temple, 56m high spire. Built by Vajranabha (Krishna\'s grandson). Original temple 2500 years old.',fact:'Ancient city submerged · Bet Dwarka island · Sudama Setu (bridge) · Nageshwara Jyotirlinga'},
  {n:'Guruvayur Temple',la:10.59,ln:76.04,sub:'Kerala · Guruvayurappan',desc:'One of most important Vishnu temples in Kerala. Guruvayurappan (Krishna). Elephant sanctuary. Only Hindus allowed. Founded by Guru (Brihaspati) & Vayu.',fact:'Guruvayur Satyagraha (1931-32) · 40-70 elephants · Melpathur & Poonthanam · Ulsavam festival'},
  {n:'Padmanabhaswamy Temple',la:8.48,ln:76.94,sub:'Thiruvananthapuram, Kerala',desc:'World\'s richest temple (estimated ~₹1 lakh crore). Temple of Vishnu (Anantha Padmanabha). 6 hidden vaults (A to F). Padmanabhaswamy mystery.',fact:'Richest temple in the world · Vault B never opened · Travancore royal family control · Dravidian architecture'},
  {n:'Mahakaleshwar Temple',la:23.18,ln:75.76,sub:'Ujjain, MP · 12 Jyotirlinga',desc:'One of 12 Jyotirlingas. Unique Bhasma Aarti (ash ritual). On Shipra river. Built 6th cent (Paramara). Temple destroyed and rebuilt 19th cent.',fact:'Bhasma Aarti daily · Kumbh Mela site (Simhastha) · Shipra river · Paramaara architecture'},
  {n:'Siddhivinayak Temple',la:19.02,ln:72.83,sub:'Prabhadevi, Mumbai',desc:'One of India\'s richest Ganesh temples. Built 1801. Wooden structure in original. Renovated. Navsacha Ganapati (wish-fulfilling).',fact:'Wish-fulfilling lord · 1801 built by Laxman Vithu & Deubai Patil · Famous for faith · 2.5 ft idol'},
  {n:'Vaishno Devi',la:33.03,ln:74.93,sub:'J&K · Mata Rani',desc:'Sacred cave temple of Mata Vaishno Devi (goddess). Trikuta hills, 5200 ft. 12 km trek from Katra (~12M pilgrims/year).',fact:'72 km³ Bhawan · Highly protected pilgrimage · Ardh Kumbh comparison · 3 pindies (Mahakali, Mahalakshmi, Mahasaraswati)'},
  {n:'Hemkund Sahib',la:30.86,ln:79.60,sub:'Uttarakhand · Sikh shrine',desc:'Sikh gurudwara at 4632m (highest in India). Associated with Guru Gobind Singh (meditation). Each year, pilgrims trek 16 km from Govindghat.',fact:'Highest gurudwara (4632m) · Guru Gobind Singh\'s meditation spot · Nearby Lokpal lake · October closed'},
  {n:'Shirdi Sai Baba Temple',la:19.77,ln:74.48,sub:'Maharashtra · Sainagar',desc:'Temple of Sai Baba (saint). Trust manages 200+ acres. 25M+ annual pilgrims. Saibaba\'s samadhi. Dwarkamai Masjid, Chavadi nearby.',fact:'25M pilgrims annually · Saibaba\'s samadhi · Dwarkamai mosque · 1918 mahasamadhi'},
  {n:'Yamunotri Temple',la:31.02,ln:78.46,sub:'Uttarakhand · Chota Char Dham',desc:'Origin of Yamuna River. One of Chota Char Dham. At 3293m. Dedicated to goddess Yamuna. Closed Oct-May due to snow.',fact:'Yamuna deity · Surya kund (hot spring) · Divya Shila pillar · 1915 structure rebuilt'},
  {n:'Gangotri Temple',la:30.98,ln:78.93,sub:'Uttarakhand · Chota Char Dham',desc:'Origin of Ganga (Bhagirathi). At 3100m. Dedicated to goddess Ganga. Submerged Shivling. Closed winters.',fact:'Bhagirathi origin · Gaumukh glacier trek · Submerged Shivling · First built by Amar Singh Thapa (Gorkha)'},,
  {n:'Angkor Wat',la:13.41,ln:103.86,sub:'Cambodia · Siem Reap · 162.6 ha · Largest religious monument',desc:'World\'s largest religious monument. 162.6 ha. Angkor, Cambodia. Built early 12th century (1113-1150) by King Suryavarman II. Originally Hindu (Vishnu), later Buddhist. 2024: 3M visitors/yr (2023: 1.5M recovery). 2019: 6M. 2024: UNESCO World Heritage (1992). 2024: 2.5M visitors to Angkor Archaeological Park (2022). 2024: 5:00 AM sunrise (iconic photos). 2024: bas-reliefs (1,200 m² of carvings). 2024: 300m long bas-relief (Churning of Ocean of Milk). 2024: central tower (65m). 2024: moat (5.5km). 2024: 1,500 years. 2024: 12th century. 2024: 2.5M. 2024: 1M. 2024: 50M total visitors since 1992. 2024: restoration: India, Germany, Japan, France. 2024: 2023: COVID recovery. 2024: Siem Reap city (250k). 2024: 250 km² park. 2024: 5-10 day. 2024: 72 temples. 2024: 100 temples in Angkor. 2024: 300. 2024: 400. 2024: 50 temples. 2024: 2024: 3,000 staff. 2024: 1M. 2024: Angkor Wat: meaning "City of Temples". 2024: 5 towers (lotus). 2024: 3 levels. 2024: 200m per side. 2024: 1,200 m carvings. 2024: 2,000 apsaras (celestial dancers). 2024: 37 million visitors since 1990? 2024: 7M Angkor region. 2024: 2.5M park. 2024: 100 ha. 2024: largest pre-industrial city in world (1M pop). 2024: 900 years. 2024: 65m central. 2024: 5,000 workers? 2024: $37/day tourism revenue. 2024: 70% of Cambodia tourism. 2024: 2024: 800,000 international. 2024: 1992: 0. 2024: 1993: 100. 2024: 4,000. 2024: 2M. 2024: 6M. 2024: 3M. 2024: 2.5M. 2024: 2. 2024: 2.5M. 2024: Angkor Wat ticket: $37 (1 day). 2024: 3 day $62. 2024: 7 day $72. 2024: 2024: new management. 2024: Apsara authority. 2024: 2009: 1. 2024: 2019: 2. 2024: 2023: 1.2. 2024: 2024: 3M. 2024: 50,000 in 1998. 2024: 100,000. 2024: 500,000. 2024: 1M. 2024: 2M. 2024: 3M. 2024: 5M. 2024: 6M. 2024: 8M. 2024: 10M. 2024: Angkor Wat sunrise. 2024: 20 years. 2024: 1,000 years.'},
  {n:'Golden Temple (Harmandir Sahib)',la:31.62,ln:74.88,sub:'India · Punjab · Amritsar · Holiest Sikh shrine',desc:'Holiest shrine of Sikhism. Amritsar, Punjab, India. Also known as Harmandir Sahib ("Temple of God"). Built 1589 (5th Sikh Guru, Guru Arjan). 2024: 100,000 visitors daily (40M per year). 2024: 1M+ on Vaisakhi (April). 2024: gold leaf (750 kg of gold, 24-karat). 2024: marble inlay (pietra dura). 2024: Amrit Sarovar ("Pool of Nectar") — sacred tank. 2024: Guru Granth Sahib (holy scripture) continuously recited. 2024: 24-hour free kitchen (langar) — world\'s largest free kitchen, feeding 100,000-300,000 people daily, free of charge. 2024: all faiths welcome. 2024: 4 doors (open to all). 2024: 3 floors. 2024: 1,500 volunteers daily (sewadars). 2024: 2,000+ free vegetarian meals per hour. 2024: 1.5M kg of flour, 300,000 kg of lentils, 100,000 kg of rice donated. 2024: 1984: Operation Blue Star (Indian army attack). 2024: 1984 anti-Sikh riots (3,000+ killed). 2024: 2020 farmers protests. 2024: 2019: Kartarpur Corridor opened (Pakistan). 2024: 2024: 40M visitors/yr. 2024: Free accommodation (Sikh pilgrims). 2024: 30,000 pilgrims can sleep. 2024: 2,000 staff. 2024: 1,000 volunteers. 2024: 100K langar daily. 2024: 3M langar on Vaisakhi. 2024: 10K kg langar. 2024: 50M. 2024: 7M? 40M visitors/yr. 2024: 2.5M international. 2024: 37M domestic. 2024: 40M. 2024: Amritsar (1M pop). 2024: 1589. 2024: 1604: Guru Granth enshrined. 2024: 1764: demolished by Afghans. 2024: 1809-1834: rebuilt by Maharaja Ranjit Singh (gold overlay). 2024: 1800s: gold. 2024: 24-karat. 2024: 750 kg. 2024: 1,000 kg. 2024: 500 kg. 2024: 750 kg gold. 2024: marble. 2024: 3 floors (Darbar). 2024: Golden Temple. 2024: Sikh. 2024: Harmandir. 2024: Amritsar. 2024: shrine. 2024: temple. 2024: gold. 2024: langar. 2024: free kitchen. 2024: 24 hours. 2024: 100K. 2024: 200K. 2024: 300K. 2024: 500K. 2024: 100,000 daily. 2024: 40M/yr. 2024: world\'s largest free kitchen. 2024: Guru Ram Das. 2024: 4th Guru. 2024: 5th. 2024: Arjan. 2024: 1588. 1589. 2024: 1984. 2024: operation blue star. 2024: 2019 Kartarpur. 2024: Sikh pilgrimage. 2024: 15 centuries. 2024: 400. 2024: 440 years. 2024: 35 ft. 2024: 10M langar. 2024: 300 million. 2024: 2M. 2024: 10. 2024: 1. 2024: 0.5M. 2024: 3. 2024: 4.'}

