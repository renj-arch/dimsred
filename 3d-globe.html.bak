D.national_park = [
  {n:'Jim Corbett NP',la:29.53,ln:78.77,sub:'Uttarakhand · India\'s oldest NP',desc:'Est. 1936 as Hailey National Park. India\'s first NP and first Project Tiger reserve (1973-74). Named after hunter-naturalist Jim Corbett.',fact:'Ramganga river passes through · Dhikala zone · 650+ bird species · Bengal tiger, elephant, leopard'},
  {n:'Kaziranga NP',la:26.58,ln:93.37,sub:'Assam · UNESCO World Heritage',desc:'UNESCO WHS (1985). Hosts 2/3 of world\'s one-horned rhinoceros. Floodplains of Brahmaputra. Est. 1905 as reserve forest.',fact:'2400+ rhinos · Tiger reserve also · Great Indian hornbill · Wild buffalo, elephant, swamp deer'},
  {n:'Sundarbans NP',la:21.85,ln:88.87,sub:'West Bengal · UNESCO · Mangrove',desc:'World\'s largest mangrove forest. UNESCO WHS (1987). Royal Bengal Tiger habitat. Ganga-Brahmaputra delta. Est. 1984.',fact:'Tiger human conflict common · 4 national parks in delta · Sundari trees · Crocodile, dolphin, turtle'},
  {n:'Gir NP',la:21.14,ln:70.80,sub:'Gujarat · Last Asiatic Lions',desc:'Only place in wild where Asiatic lions survive (674 lions, 2020 census). Former hunting preserve of Nawab of Junagadh.',fact:'Lion population increased from 20 (1913) to 674 (2020) · Also leopards, hyenas · Maldhari tribals'},
  {n:'Kanha NP',la:22.22,ln:80.63,sub:'Madhya Pradesh · Tiger Reserve',desc:'Inspiration for Kipling\'s "The Jungle Book" (Mowgli). Kanha Tiger Reserve. Est. 1955. Known for barasingha (swamp deer).',fact:'Only place for hard-ground barasingha · Banjar valley · Bamni Dadar sunset point'},
  {n:'Bandhavgarh NP',la:23.70,ln:81.00,sub:'MP · Highest tiger density',desc:'Highest tiger density in India. Bandhavgarh Fort (2000yo). Est. 1968. White tiger origin (Rewa).',fact:'Tiger capital of India · Bandhavgarh Fort (mentioned in Ramayana/Narad Pancharatra)'},
  {n:'Ranthambore NP',la:26.02,ln:76.50,sub:'Rajasthan · Famous tiger reserve',desc:'Famous for tiger sightings. Ranthambore Fort (UNESCO) within park. Est. 1955. Part of Project Tiger (1973).',fact:'Padam Talao lake · Junction of Aravalli & Vindhya · Famous tigers: Machli, Noor'},
  {n:'Periyar NP',la:9.48,ln:77.20,sub:'Kerala · Elephant Reserve',desc:'In Western Ghats. Periyar Lake (artificial, created by Mullaperiyar Dam). Elephant & tiger reserve. Est. 1982.',fact:'Cardamom Hills · Boat safari on lake · Nilgiri Tahr · 1600 flowering plants'},
  {n:'Keoladeo NP',la:27.16,ln:77.52,sub:'Rajasthan · UNESCO · Bird Sanctuary',desc:'UNESCO WHS (1985). Bharatpur Bird Sanctuary. Man-made wetland. Wintering ground for Siberian cranes (now rare).',fact:'364 bird species · Est. 1981 as NP · Also Ramsar site · 2.8 sq km small'},
  {n:'Manas NP',la:26.73,ln:91.02,sub:'Assam · UNESCO · Biosphere',desc:'UNESCO WHS (1985). Project Tiger & Elephant reserve. Manas Biosphere Reserve. On Manas River, Bhutan border.',fact:'Endangered: pygmy hog, hispid hare, golden langur · Bodo tribal area · 2830 sq km'},
  {n:'Namdapha NP',la:27.50,ln:96.50,sub:'Arunachal · 4 big cats',desc:'Only NP with 4 big cats: tiger, leopard, clouded leopard, snow leopard. Largest NP in Eastern Himalayas.',fact:'1985 sq km · Hoolock gibbon · Red panda · 1000+ plant species · Biodiversity hotspot'},
  {n:'Silent Valley NP',la:11.22,ln:76.43,sub:'Kerala · Tropical evergreens',desc:'Last intact tropical evergreen forest in Western Ghats. Silent Valley Hydroelectric Project controversy (1970s).',fact:'Sahyadri (mountain) range · Lion-tailed macaque · Nilgiri langur · Declared NP in 1985'},
  {n:'Great Himalayan NP',la:31.82,ln:77.50,sub:'HP · UNESCO WHS',desc:'UNESCO WHS (2014). Alpine peaks, glaciers, biodiversity. 1256 sq km in Kullu region. Est. 1984.',fact:'Snow leopard, western tragopan · Bhrigu Lake · Sainj & Tirthan valleys · 800+ bird species'},
  {n:'Valley of Flowers NP',la:30.73,ln:79.60,sub:'Uttarakhand · UNESCO WHS',desc:'UNESCO WHS (2005). Alpine meadows with endemic flora. Part of Nanda Devi Biosphere Reserve. Est. 1982.',fact:'87.5 sq km · 600+ alpine flowers · Brahma Kamal · Closed Nov-Apr due to snow'},
  {n:'Hemis NP',la:33.88,ln:77.42,sub:'Ladakh · Largest NP (India)',desc:'Largest NP in India (4400 sq km). High altitude (3000-6000m). Snow leopard habitat. Hemis Monastery nearby.',fact:'Ladakh Urial, Tibetan argali, Wild yak · Snow leopard capital · Hemis Gompa festival'},
  {n:'Simlipal NP',la:21.83,ln:86.33,sub:'Odisha · Biosphere Reserve',desc:'UNESCO Biosphere Reserve (2009). Tiger reserve. 2750 sq km. Waterfalls (Barehipani, Joranda).',fact:'Barehipani (399m) and Joranda (181m) falls · Melanism in tigers (black tigers) · 96 mammals'},
  {n:'Dudhwa NP',la:28.47,ln:80.70,sub:'UP · Tiger Reserve',desc:'Dudhwa Tiger Reserve. Terai region. North of River Sarda. Swamp deer, Bengal florican. Est. 1977 (NP).',fact:'Named after Dudhwa (milk-like) river · Rhino reintroduction (1984) · Kishanpur Sanctuary'},
  {n:'Gorumara NP',la:26.82,ln:88.85,sub:'West Bengal',desc:'In Dooars region (Terai). Known for Indian one-horned rhino. Jaldhaka river on its border. Est. 1994.',fact:'13 lakes in park · Wild elephants · Gaur (Indian bison) · Lepidopterans (butterflies)'},
  {n:'Dachigam NP',la:34.15,ln:75.00,sub:'J&K · Hangul habitat',desc:'High-altitude NP in Zabarwan Range near Srinagar. Only habitat of Hangul (Kashmir stag, critically endangered). Est. 1981.',fact:'Dal Lake catchment · 141 sq km · Snow leopard, musk deer · Alpine meadow'},
  {n:'Rajaji NP',la:30.06,ln:78.07,sub:'Uttarakhand · Elephant reserve',desc:'Named after C. Rajagopalachari. Elephants, tigers. SHiwalik foothills. Ganga & Song rivers. Est. 1983.',fact:'Chilla (elephant corridor) · 820 sq km · Leopard, goral · Rajaji Tiger Reserve since 2015'},
  {n:'Mudumalai NP',la:11.60,ln:76.55,sub:'Tamil Nadu · Nilgiris',desc:'Part of Nilgiri Biosphere Reserve. Corridor between Bandipur, Wayanad & Nagarhole. Elephants, tigers. Est. 1940 (sanctuary), NP 1990.',fact:'Elephant corridor · Sigur plateau · 321 sq km · Moyar river valley · Nilgiri Tahr'},
  {n:'Bandipur NP',la:11.79,ln:76.49,sub:'Karnataka · Tiger reserve',desc:'Part of Nilgiri Biosphere. One of India\'s first tiger reserves (Project Tiger 1973). Kabini river border. Est. 1974.',fact:'Tiger reserve · Kabini backwaters · 874 sq km · Jungle Lodges boom'},
  {n:'Nagarhole NP',la:12.06,ln:76.15,sub:'Karnataka · Tiger reserve',desc:'Rajiv Gandhi (Nagarhole) NP. Part of Nilgiri Biosphere. Kabini river. Highest density of herbivores in Asia. Est. 1955 (sanctuary).',fact:'Kabini reservoir · 644 sq km · Bandipur border · Leopard, wild dog, elephant, bison'},
  {n:'Sariska NP',la:27.30,ln:76.43,sub:'Rajasthan · Tiger reserve',desc:'Sariska Tiger Reserve. Alwar district, Aravallis. Kankwari Fort. Tigers (reintroduced 2008 after extinction). Est. 1955.',fact:'Tigers reintroduced from Ranthambore · Sariska Palace · Bhangarh (haunted) fort nearby'},
  {n:'Pench NP',la:21.67,ln:79.30,sub:'MP/Maharashtra · Mowgli land',desc:'Inspiration for Kipling\'s The Jungle Book (Mowgli\'s forest). Pench river. Tiger reserve. Est. 1975 as NP.',fact:'Mowgli\'s real forest · Pench (Indravati) dam · 758 sq km · Leopard, wild dog, wolf'},
  {n:'Tadoba NP',la:20.38,ln:79.27,sub:'Maharashtra · Tiger reserve',desc:'Tadoba Andhari Tiger Reserve. Oldest NP in Maharashtra (1955). Best tiger sightings in central India.',fact:'Teliya lake · Tadoba (god Tadoba) · 625 sq km · Pandharpauni & Moharli gates'},
];
D.ramsar = [
  {n:'Chilika Lake',la:19.70,ln:85.33,sub:'Odisha · Asia\'s largest brackish lagoon',desc:'Asia\'s largest brackish water lagoon. First Indian Ramsar site (1981). Irrawaddy dolphins. Nalbana Island bird sanctuary.',fact:'1100 sq km area · Spawns fish · 150+ bird species · Rajhans migratory birds'},
  {n:'Wular Lake',la:34.35,ln:74.60,sub:'J&K · Asia\'s largest freshwater',desc:'One of Asia\'s largest freshwater lakes. Jhelum River feeds it. Important fish spawning ground. Tulbul Project (navigation).',fact:'189 sq km in summer · Ramsar 1990 · Water chestnut cultivation · Dal Lake comparison'},
  {n:'Loktak Lake',la:24.55,ln:93.82,sub:'Manipur · Floating islands',desc:'Largest freshwater lake in NE India (287 sq km). Famous for phumdis (floating islands). Keibul Lamjao — world\'s only floating NP.',fact:'Phumdis are heterogeneous mass of soil/vegetation · Loktak Hydel Project · Sangai deer habitat'},
  {n:'Sambhar Lake',la:26.92,ln:75.18,sub:'Rajasthan · Inland saline',desc:'India\'s largest inland saline lake. Major salt production (9.6% of India). Important waterbird site. Ramsar 1990.',fact:'Length 35 km, variable width · Shakambhari Devi temple on bank · Salt crust in summer'},
  {n:'Kolleru Lake',la:16.66,ln:81.25,sub:'AP · Freshwater lake',desc:'Large freshwater lake between Godavari & Krishna deltas. Bird sanctuary (1999). Ramsar 2002. Important for migratory birds.',fact:'Kolleru spans 308 sq km · Atapaka Bird Sanctuary · Fishing & aquaculture'},
  {n:'Ashtamudi Wetland',la:8.97,ln:76.60,sub:'Kerala · Backwaters',desc:'Second-largest wetland in Kerala. Eight-armed shape (namesake). Kayal tourism. Kallada River feeds it. Ramsar 2002.',fact:'32 km long · 61.4 sq km · Kollam town on its shore · Backwater'},
  {n:'Bhitarkanika',la:20.67,ln:86.92,sub:'Odisha · Mangroves',desc:'Mangrove ecosystem in Odisha (650 sq km). Gahirmatha Beach (world\'s largest olive ridley turtle rookery). Ramsar 2002.',fact:'Saltwater croc population · Gahirmatha marine sanctuary · Estuarine crocodile · 250+ birds'},
  {n:'Harike Lake',la:31.17,ln:74.97,sub:'Punjab · Confluence wetland',desc:'At confluence of Beas & Sutlej (Harike Barrage). Important bird area. Ramsar 1990. 4100 sq km wetland.',fact:'Built 1953 for irrigation · 200+ bird species · Indus dolphins (rare) · Gurudwar nearby'},
  {n:'Pong Dam Lake',la:32.02,ln:76.06,sub:'HP · Reservoir',desc:'Maharana Pratap Sagar. Created by Pong Dam on Beas River. Ramsar 2002. Important bird area (IBA).',fact:'240 sq km · 220+ bird species · Wildlife sanctuary · Hydropower generation'},
  {n:'Renuka Lake',la:30.62,ln:77.42,sub:'HP · Sacred lake',desc:'Teardrop-shaped lake in Sirmaur. Named after goddess Renuka. Ramsar 2005. Surrounding wildlife sanctuary.',fact:'2.5 sq km · Annual Renuka fair · Legend of Renu (father of Parashurama) · Sacred'},
  {n:'Rudrasagar Lake',la:23.50,ln:91.30,sub:'Tripura · Lake Palace',desc:'In Tripura. Known for Neermahal (Lake Palace, built 1930 by Tripura king). Ramsar 2005.',fact:'2.4 sq km · Gomati river · Sedimentation threat · Trout fish'},
  {n:'Hokera Wetland',la:34.10,ln:74.70,sub:'J&K · Bird area',desc:'In Zainagair Plateau (J&K). Important bird area. Ramsar 2005. 13.8 sq km. Jhelum catchment.',fact:'175+ birds · Water chestnut cultivation · Eutrophication threat'},
  {n:'Upper Ganga River',la:29.50,ln:78.00,sub:'UP · River stretch',desc:'Brijghat to Narora stretch (135 km). Ramsar 2005. Ganga river dolphin (platanista). Narora barrage.',fact:'Unique riverine Ramsar · Dolphins, gharial · Chambal nearby sanctuary'},
  {n:'Vembanad Lake',la:9.50,ln:76.40,sub:'Kerala · Longest in India',desc:'Longest lake in India (96.5 km). Kerala backwaters. Kumarakom bird sanctuary. Nehru Trophy boat race (Punnamada Kayal).',fact:'200 sq km · Ramsar 2002 · Pathiramanal island · Rice bowl of Kerala (Kuttanad)'},
  {n:'Sultanpur NP (Ramsar)',la:28.50,ln:76.90,sub:'Haryana',desc:'Sultanpur National Park. Important bird sanctuary near Gurugram. Ramsar 2021.',fact:'Migratory birds: flamingo, crane, pelican · 250+ bird species · Dried wetland revived'},
  {n:'Keoladeo NP (Bharatpur)',la:27.18,ln:77.51,sub:'Rajasthan',desc:'UNESCO World Heritage (1985). Major bird sanctuary. Famous for Siberian crane wintering. Est. 1981 as NP.',fact:'364 species of birds · 150+ migratory · Ramsar 1981 · Man-made wetland'},
  {n:'Point Calimere',la:10.30,ln:79.85,sub:'Tamil Nadu',desc:'Kodikkarai. Coastal wetland in Nagapattinam. Important for migratory birds including flamingos. Ramsar 2002.',fact:'38,500 ha · Flamingo · Dugong · Horseshoe crab'},
  {n:'East Kolkata Wetlands',la:22.55,ln:88.44,sub:'West Bengal',desc:'World\'s largest wastewater-fed aquaculture system. 12,500 ha. Ramsar 2002. Treats Kolkata\'s sewage naturally.',fact:'Natural sewage treatment · Fish ponds · 12,500 ha · 150+ bird species'},
  {n:'Kanjli Lake',la:31.42,ln:75.37,sub:'Punjab',desc:'Man-made lake on Kali Bein (rivulet). Built 1870. Sikh history (Guru Nanak). Important bird area.',fact:'Ramsar 2002 · Kali Bein restoration · Guru Nanak\'s pilgrimage'},
  {n:'Ropar Lake',la:30.97,ln:76.50,sub:'Punjab',desc:'Wetland on Sutlej River created by Ropar barrage. Located in Shivalik foothills. Ramsar 2002.',fact:'200+ birds · Indus dolphin (Platanista) · Ropar Wetland Conservation'},
  {n:'Chandra Taal',la:32.47,ln:77.62,sub:'Himachal Pradesh',desc:'High-altitude lake (4,300m) in Spiti. "Moon Lake". Ramsar 2005. Tso-chen or Chandra Taal.',fact:'High-altitude (4,300m) · Tso-chen in Tibetan · Spiti Valley · Butterfly habitat'},
  {n:'Nalsarovar Lake',la:22.77,ln:72.04,sub:'Gujarat',desc:'Largest natural wetland in Gujarat. 120 sq km. Important bird sanctuary. Ramsar 2012.',fact:'Large lake · 200+ species · Flamingo breeding site'},
  {n:'Thol Lake',la:23.08,ln:72.52,sub:'Gujarat',desc:'Artificial lake near Ahmedabad. Built 1912 by Gaekwad. Bird sanctuary. Ramsar 2021.',fact:'Ramsar 2021 · Flamingo, crane, pelican · Near Ahmedabad'},
  {n:'Bhindawas Lake',la:28.50,ln:76.55,sub:'Haryana',desc:'Man-made freshwater lake. Bird sanctuary. Ramsar 2021. Largest wetland in Haryana.',fact:'Ramsar 2021 · 260+ birds · Wildlife sanctuary'},
  {n:'Haiderpur Wetland',la:29.55,ln:77.90,sub:'Uttar Pradesh',desc:'Created by 1984 Madhya Ganga Barrage. 30 km from Bijnor. Ramsar 2021.',fact:'Ramsar 2021 · Ganga floodplains · 300+ birds'},
  {n:'Kabartal Lake',la:25.55,ln:86.15,sub:'Bihar',desc:'Also known as Kanwar Taal. Asia\'s largest freshwater oxbow lake. Ramsar 2020.',fact:'Largest oxbow in Asia · Ramsar 2020 · 265+ species'},
  {n:'Lonar Lake',la:19.97,ln:76.51,sub:'Maharashtra',desc:'Unique saline crater lake. Created by meteorite impact (~50k years ago). Brackish alkaline water. Ramsar 2020.',fact:'Only impact crater in basaltic rock · 1.8 km wide · Saline & alkaline'},
  {n:'Pangong Tso',la:33.72,ln:78.75,sub:'Ladakh',desc:'High-altitude brackish lake (4,350m). 134 km long (60% in China). Famous for 3 Idiots filming. Ramsar 2020.',fact:'High-altitude 4,350m · Endorheic basin · No fish · Seasonal colour change'},
  {n:'Tso Moriri',la:32.90,ln:78.30,sub:'Ladakh',desc:'High-altitude lake (4,522m). Changthang Wildlife Sanctuary. Ramsar 2002. Endorheic basin.',fact:'4,522m elevation · Changthang · Kiang and marmot habitat'},
  {n:'Nagi-Nakti Bird Sanctuaries',la:25.20,ln:86.70,sub:'Bihar',desc:'Two man-made reservoirs (Nagi + Nakti) in Jamui. Important bird areas. Ramsar 2023.',fact:'Ramsar 2023 · 200+ bird species · Boat race festival'},
  {n:'Ranganthittu Bird Sanctuary',la:12.42,ln:76.67,sub:'Karnataka',desc:'Six small islands on Kaveri River near Srirangapatna. Ramsar 2021. Important heronry.',fact:'Ramsar 2021 · 170+ birds · Boat safari'},
  {n:'Tampara Lake',la:19.30,ln:84.90,sub:'Odisha',desc:'Freshwater lake in Ganjam district of Odisha. Ramsar 2023.',fact:'Ramsar 2023 · Bird diversity · Dredging threat'},
  {n:'Satkosia Gorge',la:20.50,ln:84.80,sub:'Odisha',desc:'Gorge of Mahanadi River. Tiger reserve. Ramsar 2023.',fact:'Ramsar 2023 · Tiger reserve · Gharial and dolphin'},
  {n:'Nanda Lake',la:15.28,ln:73.98,sub:'Goa',desc:'Freshwater wetland in South Goa. Ramsar 2023.',fact:'Ramsar 2023 · Bird sanctuary · Waterbird diversity'},
  {n:'Karavetti Bird Sanctuary',la:10.65,ln:79.22,sub:'Tamil Nadu',desc:'Coastal wetland near Point Calimere. Ramsar 2023.',fact:'Ramsar 2023 · Waterbird site · Flamingo'},
  {n:'Vellode Lake',la:10.05,ln:77.78,sub:'Tamil Nadu',desc:'Vellode Bird Sanctuary near Erode. Ramsar 2023.',fact:'Ramsar 2023 · Bird sanctuary · Kalingarayan canal'},
  {n:'Vedanthangal Lake',la:12.54,ln:79.85,sub:'Tamil Nadu',desc:'India\'s oldest waterbird sanctuary (1798?). Ramsar 2023.',fact:'Ramsar 2023 · Oldest bird sanctuary · 40k+ birds'},
  {n:'Udhayamarthandapuram',la:10.47,ln:79.48,sub:'Tamil Nadu',desc:'Temple tank bird sanctuary in Tiruvarur. Ramsar 2023.',fact:'Ramsar 2023 · Temple tank · Waterbirds'},
  {n:'Koothankulam Bird Sanctuary',la:8.50,ln:77.76,sub:'Tamil Nadu',desc:'Village wetland in Tirunelveli. Important bird area. Ramsar 2023.',fact:'Ramsar 2023 · Flamingo hotspot'},
  {n:'Asan Conservation Reserve',la:30.44,ln:77.67,sub:'Uttarakhand',desc:'Man-made wetland at Asan barrage (Yamuna-Giri confluence). Wood duck. Ramsar 2020.',fact:'Ramsar 2020 · White-winged wood duck · 330+ birds'},
  {n:'Wadhvana Wetland',la:22.10,ln:73.08,sub:'Gujarat',desc:'Vadodara district. Man-made lake on Orsang River. Migratory birds. Ramsar 2021.',fact:'Ramsar 2021 · 230+ species · Migratory: flamingo, crane, pelican'},
  {n:'Tso Kar',la:33.27,ln:78.01,sub:'Ladakh · High altitude',desc:'High-altitude wetland complex (4500m). Startsapuk Tso + Tso Kar. Important for bar-headed geese, black-necked crane. Ramsar 2020.',fact:'Ramsar 2020 · 957 sq km · Changthang cold desert · Lake of white crust'},
  {n:'Bhitarkanika',la:20.65,ln:86.87,sub:'Odisha · Mangroves',desc:'Mangrove ecosystem in Odisha (650 sq km). Gahirmatha Beach (world\'s largest olive ridley turtle rookery). Ramsar 2002.',fact:'Saltwater croc population · Gahirmatha marine sanctuary · Estuarine crocodile · 250+ birds'},
  {n:'Hokersar',la:34.10,ln:74.70,sub:'J&K · Bird wetland',desc:'Hokersar Wetland near Srinagar. Important bird area (IBA). Dependence on Jhelum. Ramsar 2005.',fact:'Ramsar 2005 · 175+ bird species · Water chestnut · Eutrophication threat'},
  {n:'Nandur Madhmeshwar',la:20.08,ln:74.10,sub:'Maharashtra · Bharat of South',desc:'Known as "Bharatpur of Maharashtra". Man-made lake on Godavari. Bird paradise. Ramsar 2019.',fact:'Ramsar 2019 · 200+ species · Godavari floodplain · Nandur Madhmeshwar Dam bird diversity'},
  {n:'Loktak Lake',la:24.55,ln:93.78,sub:'Manipur · Floating islands',desc:'Largest freshwater lake in NE India (287 sq km). Famous for phumdis (floating islands). Keibul Lamjao — world\'s only floating NP.',fact:'Phumdis are heterogeneous mass of soil/vegetation · Loktak Hydel Project · Sangai deer habitat'},
  {n:'Pong Dam Lake',la:32.00,ln:76.05,sub:'HP · Reservoir',desc:'Maharana Pratap Sagar. Created by Pong Dam on Beas River. Ramsar 2002. Important bird area (IBA).',fact:'240 sq km · 220+ bird species · Wildlife sanctuary · Hydropower generation'},
  {n:'Harike Lake',la:31.17,ln:75.20,sub:'Punjab · Confluence wetland',desc:'At confluence of Beas & Sutlej (Harike Barrage). Important bird area. Ramsar 1990. 4100 sq km wetland.',fact:'Built 1953 for irrigation · 200+ bird species · Indus dolphins (rare) · Gurudwar nearby'},
  {n:'Sambhar Lake',la:26.92,ln:75.10,sub:'Rajasthan · Inland saline',desc:'India\'s largest inland saline lake. Major salt production (9.6% of India). Important waterbird site. Ramsar 1990.',fact:'Length 35 km, variable width · Shakambhari Devi temple on bank · Salt crust in summer'},
  {n:'Kolleru Lake',la:16.65,ln:81.28,sub:'AP · Freshwater lake',desc:'Large freshwater lake between Godavari & Krishna deltas. Bird sanctuary (1999). Ramsar 2002. Important for migratory birds.',fact:'Kolleru spans 308 sq km · Atapaka Bird Sanctuary · Fishing & aquaculture'},
  {n:'Thol Lake',la:23.10,ln:72.60,sub:'Gujarat · Bird sanctuary',desc:'Thol Wildlife Sanctuary (bird sanctuary). Man-made lake near Ahmedabad. Migratory birds. Ramsar 2021.',fact:'Ramsar 2021 · 160+ species · Flamingo, pelican, stork · Thol irrigation tank'},
];
D.port = [
  {n:'Mumbai Port',la:18.95,ln:72.85,sub:'Maharashtra · Major port',desc:'Largest natural deep-water harbour in India. Handles 12% of India\'s sea freight. One of oldest ports (built 1873).',fact:'Prince\'s, Victoria, Indira Docks · JNPT nearby (largest container) · Oil terminal'},
  {n:'JNPT (Nhava Sheva)',la:18.95,ln:72.95,sub:'Maharashtra · Largest container port',desc:'Jawaharlal Nehru Port Trust. India\'s largest container port. Built 1989 to decongest Mumbai. Handles 50% container traffic.',fact:'5 container terminals · SEZ area · Connected to Dedicated Freight Corridor'},
  {n:'Chennai Port',la:13.10,ln:80.30,sub:'Tamil Nadu',desc:'Second-largest container port in India. One of oldest (1881). Artificial harbour. Car export hub.',fact:'Oldest artificial harbour · Kamarajar Dock · Largest car export terminal'},
  {n:'Kolkata Port',la:22.50,ln:88.20,sub:'West Bengal · Riverine port',desc:'Only major riverine port in India. On Hooghly River. Kolkata Dock System (KDS) + Haldia Dock Complex.',fact:'1st major port of independent India · East India Company built 1770 · 3 hours from sea'},
  {n:'Paradip Port',la:20.28,ln:86.67,sub:'Odisha',desc:'Major port on Odisha coast. Deep-water port built 1966. Exports iron ore, coal, fertilizer.',fact:'Deepest port in India (19m draft) · Captive berths for steel plants · New POL terminal'},
  {n:'Visakhapatnam Port',la:17.72,ln:83.32,sub:'Andhra Pradesh',desc:'Deepest landlocked port in India. Natural harbour. Handles iron ore, coal, petroleum. Est. 1933.',fact:'Only Indian port with US Navy base during WWII · IN Kalinga base · Shipbuilding centre'},
  {n:'Kandla Port',la:23.00,ln:70.20,sub:'Gujarat · Tidal port',desc:'Deendayal Port (Kandla). Built after Partition (when Karachi went to Pakistan). In Gulf of Kutch. Major trade port.',fact:'Handles 40% of India\'s sea trade · Kandla SEZ · Free Trade & Warehousing Zone'},
  {n:'Mangalore Port',la:12.93,ln:74.82,sub:'Karnataka',desc:'Deep-water port at New Mangalore. Handles petroleum, iron ore, coffee, cashew. Est. 1974.',fact:'Kudremukh iron ore · MRPL oil refinery · Underwater pipeline to SBM'},
  {n:'Cochin Port',la:9.95,ln:76.25,sub:'Kerala · Natural harbour',desc:'Natural harbour on Arabian Sea. Willingdon Island (man-made). Kochi LNG terminal. International Container Transshipment Terminal (ICTT, Vallarpadam).',fact:'Willingdon Island (1936) · Chinese fishing nets · Kerala backwaters · Spices export'},
  {n:'Tuticorin Port',la:8.75,ln:78.20,sub:'Tamil Nadu',desc:'V.O. Chidambaranar Port. All-weather port. Pearl fishing (Tuticorin = pearl). Handles thermal coal, container.',fact:'Deepest all-weather port in east coast · 112m deep · Pearl fishery · Salt pans'},
  {n:'Ennore Port',la:13.27,ln:80.32,sub:'Tamil Nadu · Coal hub',desc:'Kamarajar Port (renamed). India\'s first corporatized port. Handles thermal coal for TNEB. Est. 2001.',fact:'Corporatized port · 12+ mt coal · Kamarajar Port Ltd · Adani group partnered'},
  {n:'Mormugao Port',la:15.41,ln:73.79,sub:'Goa · Iron ore hub',desc:'Major port on Goa coast. Natural harbour at mouth of Zuari River. Handles iron ore exports from Goa. Built early 1900s.',fact:'Iron ore export (46% of India) · Zuari & Mandovi rivers · Portuguese-built · Dockyard'},
  {n:'Okha Port',la:22.47,ln:69.10,sub:'Gujarat · Gateway to Beyt Dwarka',desc:'Port in Devbhumi Dwarka district. Ferry service to Beyt Dwarka. Salt & fish exports. Major fishing harbour.',fact:'Beyt Dwarka ferry · Khori creek · Fishing harbour · Historical Okha lighthouse'},
  {n:'Port Blair',la:11.68,ln:92.72,sub:'Andaman & Nicobar · Island port',desc:'Main port for Andaman Islands. Passenger & cargo to mainland. Cruise tourism. Cellular Jail history.',fact:'Car ferry to mainland · Indian Navy base (INS Jarawa) · Chatham saw mill'},
  {n:'Port of Shanghai',la:31.23,ln:121.47,sub:'China · World\'s busiest container port',desc:'World\'s busiest container port since 2010. Handles over 47M TEUs annually. Located at mouth of Yangtze River. Yangshan Deep-Water Port connected by 32km Donghai Bridge. Automated container terminal.',fact:'47M TEU (busiest in world) · Yangtze River mouth · Yangshan port (artificial island) · Donghai Bridge 32km · Automated terminal'},
  {n:'Port of Singapore',la:1.28,ln:103.85,sub:'Singapore · Strategic transshipment hub',desc:'Second-busiest container port in the world. Strategic hub on Strait of Malacca. 200+ shipping lines connect to 600+ ports globally. World\'s largest bunkering port. PSA International operates. Mega-port Tuas Terminal under development.',fact:'2nd busiest · Strait of Malacca · 200+ shipping lines · Largest bunkering hub · Tuas mega-port · PSA'},
  {n:'Port of Rotterdam',la:51.90,ln:4.28,sub:'Netherlands · Largest port in Europe',desc:'Largest seaport in Europe. 40+ km long, stretches into the North Sea. Handles 460M+ tonnes of cargo annually. Europoort industrial complex. Deep-water access for largest vessels. Fully automated container terminals. Connected to 1,000+ ports worldwide.',fact:'40+ km · Largest in Europe · 460M+ tonnes · Europoort · Fully automated · Maasvlakte 2 expansion'},
  {n:'Port of Busan',la:35.10,ln:129.08,sub:'South Korea · 6th busiest in world',desc:'South Korea\'s largest port and 6th busiest container port globally. Gateway to Northeast Asia. Handles 22M+ TEUs annually. Busan New Port development. Major shipbuilding and logistics hub. Connected to 500+ ports across 100+ countries.',fact:'22M+ TEU (6th in world) · Busan New Port · South Korea gateway · Logistics hub · 500+ ports connected'},
  {n:'Port of Shenzhen',la:22.55,ln:113.90,sub:'China · 30M+ TEU · World\'s 3rd busiest',desc:'China\'s second busiest and world\'s 3rd busiest container port. Located in Guangdong province on Pearl River Delta, just north of Hong Kong. Yantian, Shekou, and Chiwan container terminals. Handles 30M+ TEUs annually. Major export hub for electronics, furniture, and manufactured goods. Deep-water berths up to 18m depth.',fact:'30M+ TEU (3rd in world) · Pearl River Delta · Yantian terminal · Electronics export hub · 18m depth'},
  {n:'Port of Guangzhou',la:23.07,ln:113.53,sub:'China · 27M+ TEU · Major South China port',desc:'Major comprehensive port on Pearl River in Guangzhou, Guangdong province. One of world\'s busiest ports handling 27M+ TEUs. Nansha deep-water terminal opened 2004. Major hub for raw materials, grain, automobiles. 4,300+ berths. China\'s largest port for commodities. Connected to inland via Pearl River system.',fact:'27M+ TEU · Nansha terminal · Pearl River · 4,300+ berths · Commodities hub'},
  {n:'Port of Ningbo-Zhoushan',la:29.95,ln:122.20,sub:'China · 35M+ TEU · World\'s busiest by cargo tonnage',desc:'World\'s busiest port by cargo tonnage (1.2B+ tonnes annually). Handle 35M+ TEUs — 3rd busiest container port worldwide. Deep natural harbor of Zhoushan archipelago. Ningbo Zhoushan Port merged in 2006. Major oil, iron ore, and coal terminal. 300+ berths. Mega-container vessels call. 200+ international routes.',fact:'35M+ TEU · 1.2B+ tonnes (busiest by cargo) · Deep harbor · 300+ berths · Oil & ore terminal'},
  {n:'Port of Hamburg',la:53.99,ln:9.98,sub:'Germany · 8.7M TEU · Europe\'s 3rd busiest',desc:'Germany\'s largest and Europe\'s 3rd busiest port. Located on Elbe River, 110 km from North Sea. Handles 8.7M+ TEUs. Established 1189 — one of world\'s oldest ports. Hamburg HafenCity urban redevelopment project. Speicherstadt warehouse district (UNESCO). Major hub for European trade with China. Cruise terminal. 4 container terminals. Since Middle Ages — key Baltic and North Sea hub.',fact:'8.7M+ TEU · Elbe River · 1189 (oldest in Germany) · HafenCity · Speicherstadt UNESCO · China trade'},
  {n:'Port of Antwerp',la:51.27,ln:4.35,sub:'Belgium · 12M TEU · Europe\'s 2nd busiest',desc:'Europe\'s 2nd busiest port after Rotterdam. Located on Scheldt River, 60 km inland from North Sea. Handles 12M+ TEUs. World\'s 2nd largest petrochemical cluster. 13 container terminals, 170 km of quay walls. Founded 7th century. Integrated rail, road, and barge connections. Active in handling chemicals, steel, fruit. 300+ liner services. Port area of 120 km².',fact:'12M+ TEU · 2nd in Europe · Scheldt River · Petrochemical hub · 170 km quay · 120 km² area'},
  {n:'Port of Los Angeles',la:33.75,ln:-118.25,sub:'USA · 9.2M TEU · Americas\' busiest',desc:'America\'s busiest container port. Located in San Pedro Bay, 30 km south of downtown LA. Handles 9.2M+ TEUs — 17th busiest globally. Part of LA-Long Beach port complex (largest in Western Hemisphere). 8 container terminals, 43 km of waterfront. Major gateway for US-Asia trade — 40% of US imports. San Pedro Bay rail and freeway network. Clean Air Action Plan (emissions reduction).',fact:'9.2M+ TEU · Americas\' busiest · San Pedro Bay · 40% of US imports · LA-Long Beach complex · 8 terminals'},
];
D.airport = [
  {n:'IGI Airport Delhi',la:28.56,ln:77.10,sub:'Delhi · Busiest in India',desc:'Indira Gandhi International Airport. Busiest airport in India (70M+ annual). 3 terminals (T3 = 6th largest globally).',fact:'Terminal 3 built for 2010 CWG · Runway 11/29 CAT III-B · Aerocity business district'},
  {n:'Chhatrapati Shivaji Mumbai',la:19.09,ln:72.87,sub:'Maharashtra',desc:'Second busiest in India. T2 terminal (Art + architecture). Also serves domestic + international.',fact:'Named after Shivaji · T2 has 1.5M sq ft of art · Adlabs Imagica nearby'},
  {n:'Kempegowda Bengaluru',la:13.20,ln:77.71,sub:'Karnataka',desc:'Third busiest in India. T1 + T2 (T2 opened 2023). Award-winning terminal design.',fact:'Named after city founder · India\'s first private airport (PPP) · BIAL company'},
  {n:'Meenambakkam Chennai',la:12.98,ln:80.16,sub:'Tamil Nadu',desc:'Major airport in South India. 4 terminals (incl. new T4). Hub for domestic airlines.',fact:'Oldest airport in India after Mumbai & Delhi · Established 1940s'},
  {n:'Netaji Subhas Kolkata',la:22.65,ln:88.45,sub:'West Bengal',desc:'Major airport serving East & NE India. New integrated terminal (2013).',fact:'Named after Subhas Chandra Bose · T2 treats passengers with local culture'},
  {n:'Rajiv Gandhi Hyderabad',la:17.24,ln:78.43,sub:'Telangana',desc:'Served 21M+ annually. Award-winning (World Travel Awards). GMR Group operated.',fact:'Built at Shamshabad · Cargo hub · Bio-diversity zone nearby'},
  {n:'Cochin International',la:10.16,ln:76.40,sub:'Kerala',desc:'First fully solar-powered airport in the world. Built under PPP model (Airtravel in Kerala).',fact:'World\'s first solar airport (12 MW) · 3 terminals · Gold & spices cargo hub'},
  {n:'Sardar Vallabhbhai Ahmedabad',la:23.07,ln:72.63,sub:'Gujarat',desc:'Second busiest in Gujarat after Mumbai. New integrated terminal T2 (2023). Cargo hub.',fact:'Named after Sardar Patel · T2 handles 10M+ · Amdavad city connection'},
  {n:'Pune Airport',la:18.58,ln:73.92,sub:'Maharashtra',desc:'Also known as Lohagaon Airport. Civil enclave at IAF base. Rapid growth due to IT industry. New terminal built.',fact:'Air Force base sharing · Chhatrapati Sambhaji Maharaj name · IT corridor proximity'},
  {n:'Manohar Goa Mopa',la:15.74,ln:73.82,sub:'Goa · New greenfield',desc:'North Goa\'s new airport (opened Jan 2023). Built on Mopa plateau. GMR-led PPP. Designed to decongest Dabolim.',fact:'Newest airport in India · 4.4M capacity · Greenfield project · Goa tourism boost'},
  {n:'Chaudhary Charan Singh Lucknow',la:26.77,ln:80.89,sub:'Uttar Pradesh',desc:'Major airport in UP. T3 (2024) expanded capacity. Serves Ayodhya tourism. Amausi area.',fact:'Named after Chaudhary Charan Singh · T3 built for 12M · Ayodhya connectivity'},
  {n:'Lokpriya Gopinath Bordoloi Guwahati',la:26.11,ln:91.59,sub:'Assam · NE hub',desc:'Main airport for Northeast India. Also known as Guwahati International. Covers NE states\' connectivity. New terminal 2020.',fact:'India\'s 12th busiest · NE\'s only international hub · Brahmaputra river nearby'},
  {n:'Jaipur International',la:26.82,ln:75.81,sub:'Rajasthan',desc:'Also Sanganer Airport. New T1 terminal. Pink City tourism hub. Served by all major airlines.',fact:'New terminal for international flights · Sanganer area · Pink City tourism drive'},
  {n:'Biju Patnaik Bhubaneswar',la:20.25,ln:85.82,sub:'Odisha',desc:'Also Bhubaneswar Airport. New integrated terminal (2018). Konark & Puri tourism connection.',fact:'Biju Patnaik namesake · New T2 terminal · 8M annual capacity · Berhampur link'},
  {n:'Hartsfield-Jackson Atlanta',la:33.64,ln:-84.43,sub:'USA · 75M passengers · World\'s busiest',desc:'World\'s busiest airport by passenger traffic since 1998. Hartsfield-Jackson Atlanta International Airport (ATL) handled 75M+ passengers in 2023. Located 11 km south of downtown Atlanta, Georgia. Major hub for Delta Air Lines. 195 terminals with Plane Train automated people mover. 5 parallel runways.',fact:'75M+ passengers (busiest) · Atlanta, Georgia · Delta hub · 5 parallel runways · Plane Train'},
  {n:'Dubai International',la:25.25,ln:55.36,sub:'UAE · 87M passengers · Middle East hub',desc:'World\'s busiest airport by international passenger traffic. Dubai International (DXB) handled 87M passengers in 2023. Hub for Emirates Airlines. Terminal 3 is the largest airport terminal in the world (1.7M sq m). Located 4.6 km from Dubai city center. 90+ airlines connect to 240+ destinations.',fact:'87M passengers (busiest international) · Emirates hub · T3 largest · 240+ destinations'},
  {n:'Tokyo Haneda',la:35.55,ln:139.78,sub:'Japan · 87M passengers · Asia\'s busiest',desc:'One of the busiest airports in Asia. Tokyo International Airport (Haneda) handled 87M passengers in 2023. Located 14 km south of Tokyo. 3 terminals (T1, T2, T3). Known for punctuality and efficiency. Runway 16R/34L is over 3,000m. Growing international traffic alongside strong domestic network.',fact:'87M passengers · Tokyo · 14 km from city · 3 terminals · Punctuality record'},
  {n:'London Heathrow',la:51.47,ln:-0.45,sub:'UK · 79M passengers · Europe\'s busiest',desc:'Europe\'s busiest airport (79M passengers in 2023). Located 23 km west of Central London. 4 terminals (T2-T5). Hub for British Airways and Virgin Atlantic. 2 runways operating at 99% capacity. Crossrail (Elizabeth Line) connects to central London in 15 min. Original site of 1930 Great West Aerodrome.',fact:'79M passengers (Europe\'s busiest) · London · BA hub · 99% capacity · Elizabeth Line'},
  {n:'Los Angeles International',la:33.94,ln:-118.41,sub:'USA · 75M passengers · West Coast hub',desc:'Second busiest airport in the United States. LAX handled 75M passengers in 2023. 9 passenger terminals arranged in a U-shape. Iconic Theme Building (1961) with flying saucer-style restaurant. Major gateway to Asia-Pacific. 100+ airlines connect to 200+ destinations. LAX Automated People Mover under construction.',fact:'75M passengers · 2nd busiest in USA · 9 terminals · Theme Building · Asia-Pacific gateway'},
  {n:'Singapore Changi',la:1.36,ln:103.99,sub:'Singapore · 59M passengers · World\'s best',desc:'Regularly voted world\'s best airport. Singapore Changi Airport handled 59M passengers in 2023. 4 terminals + Jewel Changi (2019) with indoor Rain Vortex waterfall (40m), gardens, cinema, butterfly garden, pool. Hub for Singapore Airlines. Skytrax World\'s Best Airport award 12 times. 90 min from most Asian capitals.',fact:'59M passengers · World\'s best (Skytrax) · Jewel indoor waterfall · Singapore Airlines hub · 12x best airport'},
  {n:'Beijing Capital',la:40.08,ln:116.58,sub:'China · 52M passengers · China\'s busiest',desc:'Busiest airport in China (52M passengers in 2023). Located 32 km northeast of central Beijing. 3 terminals — T3 is one of largest in world (986,000 sq m). Hub for Air China, Hainan Airlines. Terminal 3 designed by Norman Foster with dragon-like shape. 3 runways.',fact:'52M passengers · China\'s busiest · Air China hub · T3 Norman Foster · 3 runways'},
  {n:'Hong Kong International',la:22.31,ln:113.91,sub:'China · 39M passengers · Global hub',desc:'Major international hub built on reclaimed Chek Lap Kok island (1,248 hectares). Opened 1998 replacing Kai Tak Airport. Cathay Pacific hub. World\'s busiest cargo airport by value. Third runway system under construction (2024). Skytrax 5-star rating. Airport Express train to central Hong Kong in 24 min.',fact:'39M passengers · Reclaimed island · Cathay Pacific hub · Cargo busiest by value · Third runway'},
  {n:'Istanbul Airport',la:41.26,ln:28.74,sub:'Turkey · 64M passengers · Mega-hub',desc:'Newest global mega-hub, opened 2018 replacing Atatürk Airport. 64M passengers in 2023. Full capacity planned at 200M passengers/year — largest in world. Hub for Turkish Airlines (flies to most countries of any airline). 5 runways. 1.4M sq m terminal. Control tower designed as tulip (Turkish symbol).',fact:'64M passengers · New mega-hub (2018) · Turkish Airlines hub · 200M planned capacity · 5 runways'},
  {n:'Frankfurt Airport',la:50.04,ln:8.56,sub:'Germany · 59M passengers · European hub',desc:'Germany\'s busiest and Europe\'s 3rd busiest airport (59M passengers in 2023). Located 12 km southwest of Frankfurt. Hub for Lufthansa. 4 runways, 2 terminals with long-distance train station. Cargo hub handling 2M+ tonnes/year. Direct ICE high-speed rail to Cologne, Munich, Basel. 325+ destinations.',fact:'59M passengers · Germany\'s busiest · Lufthansa hub · 4 runways · ICE rail · 325+ destinations'},
];
D.dam = [
  {n:'Bhakra Nangal Dam',la:31.42,ln:76.42,sub:'HP/Punjab · India\'s highest',desc:'Highest gravity dam in India (226m). On Sutlej River. Bhakra Reservoir (Govind Sagar). Built 1963. Projects: irrigation + 1325 MW power.',fact:'India\'s highest dam · "Nangal" township · Bhakra canal system irrigates Punjab, Haryana, Rajasthan'},
  {n:'Sardar Sarovar Dam',la:21.83,ln:73.78,sub:'Gujarat · Largest dam project',desc:'Third highest in India (163m). On Narmada River. Part of Narmada Valley Project. Irrigation in Gujarat, Rajasthan, Maharashtra, MP.',fact:'Sebastião Salgado\'s photos · Narmada Bachao Andolan · Provides water to Kutch & Saurashtra'},
  {n:'Hirakud Dam',la:21.52,ln:83.87,sub:'Odisha · World\'s longest earthen dam',desc:'World\'s longest earthen dam (4.8 km). On Mahanadi River. Built 1957. Creates Hirakud Reservoir (largest man-made lake in Asia).',fact:'Length 4.8 km · Height 60.9 m · Flood control + irrigation + 307.5 MW power'},
  {n:'Nagarjuna Sagar Dam',la:16.58,ln:79.31,sub:'Telangana/AP · Largest masonry dam',desc:'World\'s largest masonry dam (124m height, 1.6km length). On Krishna River. Built 1972. Named after Nagarjuna (Buddhist philosopher).',fact:'Buddhist ruins moved uphill before submersion · 270 km² reservoir · Canals in AP & Telangana'},
  {n:'Tungabhadra Dam',la:15.23,ln:76.34,sub:'Karnataka',desc:'On Tungabhadra River. Built near Hospet. 49.5 m height. Irrigates 3000+ sq km.',fact:'Near Hampi (UNESCO) · Created for Tungabhadra project · Power 72 MW'},
  {n:'Krishna Raja Sagara Dam',la:12.42,ln:76.58,sub:'Karnataka · Cauvery dam',desc:'On Kaveri River. Built by Sir M. Visvesvaraya (1924). Brindavan Gardens attached. Mysore water supply.',fact:'Sir M.V.\'s engineering marvel · "KRS" dam · 39 m height · Power + irrigation + drinking'},
  {n:'Mettur Dam',la:11.80,ln:77.80,sub:'Tamil Nadu',desc:'On Kaveri River. Largest dam in Tamil Nadu. Built 1934. 214 ft height. Creates Stanley Reservoir.',fact:'Mettur level determines Cauvery water sharing · Power: 40 MW · Salem district'},
  {n:'Tehri Dam',la:30.38,ln:78.48,sub:'Uttarakhand · Highest in India',desc:'Highest dam in India (260.5m). On Bhagirathi River. Built 2006. Multi-purpose: irrigation, power (1000 MW), drinking water.',fact:'Asia\'s 2nd highest, India\'s highest · Controversy over seismic zone · Displaced population'},
  {n:'Idukki Dam',la:9.85,ln:76.97,sub:'Kerala · Arch dam',desc:'India\'s first arch dam. On Periyar River. Between Kuravan & Kurathi hills. Built 1974. Height 169m.',fact:'Arch dam (curved) · Idukki Hydroelectric Project (780 MW) · Hill view from dam top'},
  {n:'Srisailam Dam',la:16.08,ln:78.90,sub:'Telangana/AP',desc:'Second largest capacity hydro project in India (1670 MW). On Krishna River. Nagarjunasagar-Srisailam Tiger Reserve.',fact:'Deepest man-made canyon in India · Mallikarjuna Jyotirlinga temple nearby'},
  {n:'Mullaperiyar Dam',la:9.53,ln:77.15,sub:'Kerala/TN · Century-old dispute',desc:'Periyar River. Built 1895 by British Raj. Masonry gravity dam (53.6m). Interstate water dispute between Kerala & TN.',fact:'1895 built on Periyar · 999-year lease between MH & Travancore · Dam safety concerns'},
  {n:'Ukai Dam',la:21.29,ln:73.57,sub:'Gujarat · Largest in state',desc:'On Tapti River. Second largest dam in Gujarat (after Sardar Sarovar). Vallabh Sagar lake. Irrigates Surat, Bharuch.',fact:'Tapti river dam · Vallabh Sagar reservoir · Power: 305 MW · Flood control'},
  {n:'Koyna Dam',la:17.40,ln:73.75,sub:'Maharashtra · Largest hydro',desc:'On Koyna River (tributary of Krishna). Part of Koyna Hydroelectric Project (1963). 1967 Koyna earthquake linked to reservoir.',fact:'One of world\'s largest hydro · 1920 MW capacity · Reservoir-induced seismicity · Koyna refuge'},
  {n:'Pandoh Dam',la:31.67,ln:77.07,sub:'HP · Beas diversion',desc:'On Beas River near Mandi. Diverts water to Sutlej for Bhakra. Built 1977. Height 76m.',fact:'Beas-Sutlej link · Bhakra augmentation · Pandoh lake · 990 MW diversion'},
  {n:'Kangsabati Dam',la:22.75,ln:86.70,sub:'West Bengal · Multipurpose',desc:'On Kangsabati River in Paschim Medinipur. Built 1965. Irrigation, flood control, power.',fact:'160 MW capacity · Kangsabati project · Mukutmanipur (largest earthen dam in WB) · Tourist spot'},
  {n:'Rihand Dam',la:24.20,ln:83.05,sub:'UP · Largest in state',desc:'On Rihand River (tributary of Son). Govind Ballabh Pant Sagar — India\'s largest man-made lake. Built 1962.',fact:'Govind Ballabh Pant Sagar · 300 MW power · Sonbhadra district · Singrauli coal fields'},
  {n:'Indira Sagar Dam',la:22.30,ln:76.63,sub:'Madhya Pradesh · 1,000 MW',desc:'Largest reservoir in India by volume (12.2B m³). On Narmada River near Khandwa, MP. 653m long, 92m high. Part of Narmada Valley Development Project. 8 turbine units (125 MW each). Commissioned 2004. Spillway capacity 86,600 m³/s. Submerged Omkareshwar ancient temple was relocated. Irrigates 1,230 km² in MP.',fact:'1,000 MW · 12.2B m³ (largest reservoir) · Narmada River · 653m long · 8 turbines · Khandwa, MP'},
  {n:'Bansagar Dam',la:24.20,ln:80.82,sub:'Madhya Pradesh · Multi-state',desc:'On Son River at Deolond, MP. Named after Shahanshah Bahadur (Bansagar). 680m long, 67m high. Gravity dam + earthen flanks. Joint project of MP, UP, Bihar (water sharing). 425 MW power capacity. Commissioned 2006. Reservoir area 103 km². Irrigates 2,570 km² across 3 states. Controversy over displacement and rehabilitation. Reservoir submerges some archaeological sites.',fact:'425 MW · Son River · MP/UP/Bihar joint project · 680m long · 2,570 km² irrigation · 2006'},
  {n:'Maithon Dam',la:23.78,ln:86.80,sub:'Jharkhand · 63.6 MW',desc:'On Barakar River (tributary of Damodar). One of 4 multi-purpose dams of Damodar Valley Corporation (DVC). 478m long, 48m high. Cofferdam type. Commissioned 1957 — among first major dams in independent India. 63.6 MW hydropower + thermal. 2 x 30 MW + 1 x 3.6 MW units. Maithon Lake popular boating destination. Deer park and tourist complex. Flood control for Damodar basin. Located in Dhanbad district. Reservoir area 65 km².',fact:'63.6 MW · Barakar River · DVC project · 1957 (early post-independence) · 478m long · Flood control · Dhanbad'},,
  {n:'Three Gorges Dam',la:30.83,ln:111,sub:'China · Yangtze River · 22,500 MW',desc:'World\'s largest power station by installed capacity (22,500 MW). 2,335m long, 181m tall. 39.3 billion cubic meters reservoir (660km long). Construction 1994-2012. Cost: $37 billion. 84,700 GWh annual output. 500,000+ tonnes of steel. 26 generators (each 700 MW). Yangtze River flood control — 1.5 million people relocated. Environmental controversy: 2 million people resettled. 1,300 archaeological sites submerged. 175m water level reached 2010. 10,000+ workers. 2020: record flood tested dam (first 75,000 m³/s inflow). 2024: 100 billion kWh generated in single month (August). Ship lift capacity 3,000 tonnes. 5-tier ship lock. 2022: dam completed 10 years. 2023: drought limited output (lowest in 160 years). 2024: China\'s largest clean energy project. 2019: fish passage experiments (40M yuan). 2020: Yangtze fishing ban (10 years). 2021: dam proved effective in extreme floods. 2022: 52MW floating solar farm on reservoir. Criticism: landslides along reservoir banks. 2018: dam deformation report (engineers say within safe limits). 2003: first generators operational. 2011: final generator (no. 26) installed. 1,300+ hills became islands. Reservoir covers 1,045 km². 90% of electricity to Shanghai and eastern China. 2025: plans to extend to 32 generators (28,000 MW). 2023: dam generated 100 billion kWh despite drought. 2016: "strongest earthquake" (M3.2) caused by reservoir. 2024: dam operations in flood season. Ship lock passage: 3-4 hours. Tourist attraction: 3M+ visitors/year.',fact:'22,500 MW (world\'s largest power station) · 2,335m long · 181m tall · $37 billion · 39.3 billion m³ reservoir · 660km reservoir · 84,700 GWh/year · 26 x 700 MW generators · 2M people relocated · flood control · Yangtze River · 5-tier ship lock · 3M+ visitors/year'},
  {n:'Itaipu Dam',la:-25.42,ln:-54.58,sub:'Brazil/Paraguay · Paraná River · 14,000 MW',desc:'Second largest hydroelectric dam in the world (14,000 MW, 20 generating units). 2023: world record production 103 billion kWh. 7,235m long, 196m tall. Built 1970-1984. Cost: $19.6 billion. 12.3 million m³ concrete. Reservoir: 1,350 km², 290km long. Binational project: Brazil-Paraguay. 50% ownership each. 2016: Itaipu generated 103.1 TWh (world record). 2023: record broken again 103.4 TWh. 1,200 workers killed during construction (worst disaster in civilian construction). 1984: first unit operational. 1991: all 18 units operational. 2006-2007: 2 more units added (20 total). 2008: surpassed Three Gorges as world\'s largest for a time. Falls of Iguaçu tourism. 60,000 visitors/month. 10 million visitors since opening. 2019: 40th anniversary. 2021: solar plant added (1 MW). 2023: world record for annual generation. 2024: Itaipu 50th year of construction anniversary. Paraguay economy: 90% of its electricity from Itaipu. Brazil supplies 15% of its consumption. 2022: drought reduced output by 30%. 2023: recovery. Itaipu Treaty: renegotiated 2023 (Brazil-Paraguay relations). 2024: new US$ 100M control system upgrade. Spillway capacity: 62,200 m³/s. 15,000 workers in construction peak. 98% availability average. 1,200 km high-voltage transmission lines. 750kV AC transmission. 600kV DC link to São Paulo. 1,000+ fish species protected. 2023: Itaipu+2GW solar/hydrogen projects. 2019: electric buses for tourism. 2022: Itaipu eco-tourism (butterfly farm, biological refuge). 2024: Itaipu expansion under study (20-30% more by turbine upgrades).',fact:'14,000 MW (2nd largest) · Brazil/Paraguay · Paraná River · 103 billion kWh record (2023) · 7,235m long · 196m tall · $19.6 billion · 20 generating units · 1,350 km² reservoir · 1970-1984 construction · 1,200 worker fatalities · Treaty renegotiated 2023 · Iguaçu Falls nearby'},
  {n:'Hoover Dam',la:36.02,ln:-114.74,sub:'USA · Nevada/Arizona · 2,080 MW',desc:'Iconic concrete arch-gravity dam on Colorado River. 726 feet (221m) tall. 1,244 feet (379m) long. Construction 1931-1936 (completed 2 years early). Cost: $49 million (1936). 17 generators (2,080 MW). 3.25 million m³ concrete. 100+ workers died. Lake Mead: largest US reservoir (35 million acre-feet, 640km shoreline). 1935: dedicated by President Franklin D. Roosevelt. Art Deco design. US National Historic Landmark (1985). 2022: Lake Mead water level at record low (1,040 feet, 30% capacity). 2023: US drought crisis — Hoover Dam hydro output down 25%. 2024: Lake Mead rises 20 feet from snowmelt (still 35% full). 1M+ visitors/year. Tour: power plant, tunnels (2,000+ steps). "The Dam that made Las Vegas" — provides water and power to 20M people. California, Arizona, Nevada depend on it. 2021: first federal water shortage declaration (Colorado River). 2022: tier 2 water cuts (AZ, NV). 2023: tier 2 continued. 2024: first-ever Tier 3 shortage discussions. 2010: $12B river tunnel (Lake Mead lowering) — new intake No. 3. 1960s: Lake Mead becomes recreation hub. 1936-1961: world\'s largest hydro plant. Boulder City — town built for workers. 2015: new visitor center opens. 2023: dam evacuation drill for structure safety. 2016: All-American Canal connection. 2021: solar panel installation (1MW). 1931: construction started during Great Depression. 21,000 workers employed. 2024: LA\'s water future tied to Hoover Dam. 2030: worst-case scenarios for Colorado River. Hoover Dam bypass bridge (Mike O\'Callaghan-Pat Tillman Bridge, 2010). 890 feet above Colorado River. 2023: lowest water levels since 1937. 2.4B kWh annual generation (reduced from 4B). Hydro turbines can\'t operate below 1,050 feet. 2024: white ring bathtub ring visible (135 feet drop).',fact:'221m tall · 2,080 MW · Colorado River · Nevada/Arizona · Lake Mead (largest US reservoir) · 1931-1936 built · Great Depression project · Art Deco · 1M+ visitors/yr · 20M people depend on it · water crisis (Lake Mead at 35% capacity 2024) · US drought · bypass bridge (2010) · 2024 Tier 3 shortage discussions · iconic'},
  {n:'Grand Coulee Dam',la:47.96,ln:-118.98,sub:'USA · Washington State · 6,809 MW',desc:'Largest hydroelectric power plant in the United States (6,809 MW). 168m tall, 1,592m long. Built 1933-1942 (original), expanded 1970s. 12 million m³ concrete. 33 generators. 20 billion kWh annual output. Columbia River. Part of Columbia Basin Project. Irrigated 670,000 acres. 1941: began power production (WWII aluminum smelters). 2024: record power demand in Pacific Northwest. 3 power plants: Left (3 units), Right (9 units), Third Powerplant (6 units + 2 pump-generators). 200 million tons of concrete. 4,500 workers in peak construction. 1950: pump-generators added. 19+ million acre-feet reservoir (Franklin D. Roosevelt Lake, 243km long). 2M+ visitors/year. Lake Roosevelt National Recreation Area (NPS). 1970: Third Power Plant expansion. 2023: US Army Corps of Engineers modernizing turbines. 2018: Columbia River Treaty renegotiation (US-Canada). 2022: Grand Coulee generation reduced due to drought. 2024: fish passage improvements. 1970s-1990s: tribal fish restoration programs (Colville Confederated Tribes). Grand Coulee originally built without fish ladders (blocked salmon — 1,100km of spawning habitat lost). 2010: Grand Coulee fish passage studies. World\'s largest concrete structure (until Three Gorges). 1986: National Historic Landmark. 1930s: Public Works Administration project. 20,000 jobs created. Grand Coulee Dam Visitor Center. 3,000+ employees. 202-203 modernization program ($500M). 2025: turbine upgrade to increase efficiency by 30%. 2021: pump-generator unit 3-2 replaced (largest in world). 1936: First concrete poured. 1941: First power. 2021: 80th anniversary. 25% of US Pacific Northwest electricity. 7% of total US hydropower. Eighth Wonder of the World hyperbole.',fact:'6,809 MW (largest in USA) · Washington State · Columbia River · 168m tall · 1,592m long · 12M m³ concrete · 33 generators · 20 billion kWh/yr · 670,000 acres irrigated · WWII aluminum production · no fish ladders (salmon blocked) · 2M+ visitors/yr · Franklin D. Roosevelt Lake · 1933-1942 built · $500M modernization · Lake Roosevelt NRA'},
  {n:'Sardar Sarovar Dam',la:21.83,ln:73.75,sub:'India · Gujarat · Narmada River · 1,450 MW',desc:'Controversial mega-dam on Narmada River, Gujarat. 163m tall, 1,210m long. 1,450 MW installed capacity (6 x 200MW + 5 x 50MW). 1,000km canal network. Irrigated 1.8 million hectares. Construction 1987-2017 (delayed). Cost: $5+ billion (inflation-adjusted). Central and state government project. Narmada Bachao Andolan (Save Narmada Movement) — massive protests. Medha Patkar led 30+ year protest. 2017: prime minister Modi dedicated the dam. 2023: dam at full capacity for first time. 2024: 2GW solar park planned on canal. Narmada River dispute among 4 states. 1994: Supreme Court case. 2000: construction allowed to continue. 40,000+ families displaced. Resettlement controversies (still ongoing). 2005: dam height increased from 121m to 138m, then to 163m. Relief and rehabilitation under scrutiny. World Bank withdrew funding in 1993 (pulled out after pressure). India\'s largest canal-based irrigation system. 1,200km of main canal. 75,000km of distribution canals. 2023: filling of reservoir flooded large areas, affecting tribal communities. 2020: record monsoon filled dam to 95% capacity. 2022: extreme floods — dam operations criticized. 2021: bumper crop season from canal water. 2024: drought mitigation for Saurashtra and Kutch regions. 1.3 million hectares agricultural potential. 130+ villages impacted. 10,000+ MW pumped storage project proposed. 2019: dam proved beneficial for drinking water (10,000 villages). 2024: groundwater recharge from canals. 1MW solar atop dam structure. Narmada Cleanup Plan (2023). Sardar Sarovar Project has 3,600 km canal system in Gujarat and Rajasthan. 1 billion cubic feet gravity dam. Largest dam in India in terms of water volume. Height dispute resolved 2017. 40 years in making.',fact:'163m tall · 1,210m long · 1,450 MW · Gujarat, India · Narmada River · 1.8M ha irrigated · 1,000km canal network · Narmada Bachao Andolan protests · 40,000+ families displaced · Supreme Court case (1994, 2000) · World Bank withdrew 1993 · cost $5B+ · 2017 dedicated by PM Modi · social/environmental controversy · largest canal irrigation in India'}

];
D.nuclear = [
  {n:'Tarapur Atomic Station',la:19.83,ln:72.66,sub:'Maharashtra · Oldest in India',desc:'India\'s first nuclear power plant (commissioned 1969). 2 BWR units (160 MW each). Under US-India 123 Agreement.',fact:'GE BWR technology · Built with US assistance · Commercial operation Oct 1969'},
  {n:'Rawatbhata (RAPS)',la:24.87,ln:75.60,sub:'Rajasthan',desc:'Rajasthan Atomic Power Station. 6 units (220 MW each). PHWR technology. First unit commissioned 1972.',fact:'Also known as Rawatbhata · Heavy water plant · Near Chittorgarh · 4 units operational'},
  {n:'Kalpakkam (MAPS)',la:12.56,ln:80.18,sub:'Tamil Nadu',desc:'Madras Atomic Power Station. 2 PHWR units (220 MW each). Also houses Kalpakkam PFBR (Prototype Fast Breeder Reactor).',fact:'IGCAR (Indira Gandhi Centre for Atomic Research) · PFBR (500 MW) expected · Desalination plant'},
  {n:'Kakrapar (KAPS)',la:21.25,ln:73.32,sub:'Gujarat',desc:'Kakrapar Atomic Power Station. 2 PHWR (220 MW) + 2 new units (700 MW each — India\'s largest). On Tapti River.',fact:'KAPP-3 & 4 (700 MW) are India\'s largest indigenous PHWRs · Near Vyara, Surat'},
  {n:'Narora (NAPS)',la:28.16,ln:78.40,sub:'Uttar Pradesh',desc:'Narora Atomic Power Station. 2 PHWR (220 MW each). On Ganga river bank. Also has Narora barrage.',fact:'Narora Atomic Power · Ramganga River · Double containment design · Tarapur-type training'},
  {n:'Kaiga (KAIGA)',la:14.87,ln:74.38,sub:'Karnataka',desc:'Kaiga Generating Station. 4 PHWR units (220 MW each). On Kadra reservoir (Kali river).',fact:'Western Ghats · Performed 962 days continuous operation (world record 2018-2021)'},
  {n:'Kudankulam (KKNPP)',la:8.17,ln:77.65,sub:'Tamil Nadu · Largest in India',desc:'Kudankulam Nuclear Power Plant. India\'s largest (2000 MW). VVER-1000 reactors (Russian). Built with Russia. Unit 1: 2013.',fact:'Under Indo-Russian nuclear cooperation · 6 units planned (6000 MW) · Protests post-Fukushima'},
  {n:'PFBR Kalpakkam',la:12.56,ln:80.17,sub:'Tamil Nadu · Fast Breeder',desc:'Prototype Fast Breeder Reactor (500 MW). World\'s first thorium-based reactor. Using uranium-238 & thorium.',fact:'Bhavini (Bharatiya Nabhikiya Vidyut Nigam Ltd) · Thorium cycle · Indigenous design'},
  {n:'Gorakhpur (GHAVP)',la:29.40,ln:75.60,sub:'Haryana · New project',desc:'Gorakhpur Haryana Anu Vidyut Pariyojana. 4 x 700 MW PHWR units. Under construction in Fatehabad district.',fact:'NPCIL project · 4 units of 700 MW · Fatehabad district · Under construction since 2014'},
  {n:'Chutka (M.P.)',la:22.45,ln:80.52,sub:'Madhya Pradesh · Proposed',desc:'Proposed 2 x 700 MW PHWR in Mandla district. Near Kanha National Park. Environmental clearance pending.',fact:'2x700 MW PHWR · Narmada river · Environmental concerns · Under state clearance'},
  {n:'Mahi Banswara',la:23.55,ln:74.45,sub:'Rajasthan · New PHWR',desc:'Mahi Banswara Atomic Power Station. 4 x 700 MW PHWR units planned in Banswara district. On Mahi River.',fact:'4 x 700 MW PHWR · Mahi river · Rajasthan Nuclear project · NPCIL in progress'},
  {n:'Kaiga Unit 5 & 6',la:14.87,ln:74.38,sub:'Karnataka · Expansion',desc:'Planned expansion of Kaiga station. 2 additional 700 MW PHWR units. Will bring Kaiga capacity to 2320 MW.',fact:'700 MW PHWR · New units under approval · Western Ghats location · Expansion plans'},
  {n:'Jaitapur (JNPP)',la:16.80,ln:73.48,sub:'Maharashtra · Largest planned',desc:'Proposed 9900 MW nuclear plant (6 x 1650 MW EPR). Indo-French cooperation (AREVA/EDF). Ratnagiri district.',fact:'9900 MW planned world\'s largest · EPR (French) · 6 units · Local opposition post-2011'},
  {n:'Palo Verde',la:33.39,ln:-112.86,sub:'USA · Arizona · 3,937 MW',desc:'Largest nuclear plant in USA by capacity. Only nuclear plant in the world not on a large body of water — uses treated wastewater (cooling). 3 pressurized water reactors (1,270 MW each). Commissioned 1986-1988. Phoenix metro area. Provides 35% of Arizona\'s clean energy. Salt River Project and Arizona Public Service.',fact:'3,937 MW · USA\'s largest · No lake/river cooling · Wastewater cooled · 3 units · Arizona'},
  {n:'Bruce Nuclear',la:44.33,ln:-81.60,sub:'Canada · Ontario · 6,550 MW',desc:'Largest nuclear plant in the world by capacity. 8 CANDU reactors (heavy water). On Lake Huron shore. Commissioned 1977-1987. Provides 30% of Ontario\'s power. Bruce Power operates. 6,550 MW net capacity. CANDU design uses natural uranium (no enrichment needed). Refurbishment program ongoing — will extend operations to 2064.',fact:'6,550 MW (largest in world) · 8 CANDU reactors · Lake Huron · Ontario · Heavy water · Natural uranium'},
  {n:'Zaporizhzhia NPP',la:47.50,ln:34.59,sub:'Ukraine · 5,700 MW',desc:'Largest nuclear plant in Europe. 6 VVER-1000 reactors (Russian design). Dnieper River near Enerhodar. Commissioned 1985-1996. Captured by Russian forces March 2022 (Russo-Ukrainian War). Multiple shelling incidents — fears of nuclear disaster. IAEA inspectors present since Sept 2022. Offline since Sept 2022 but needs power for cooling. Creates 20% of Ukraine\'s electricity. Zaporizhzhia region.',fact:'5,700 MW · Largest in Europe · 6 VVER-1000 · Captured 2022 · Shelling risk · IAEA monitoring'},
  {n:'Gravelines NPP',la:51.01,ln:2.14,sub:'France · 5,460 MW',desc:'Largest nuclear plant in Western Europe. 6 PWR reactors. Near Dunkirk on French North Sea coast. Commissioned 1980-1985. Cooling water directly from sea. 5,460 MW net capacity. Provides 6% of France\'s nuclear electricity. EDF operates. Close to Belgium border. French nuclear fleet is 56 reactors (70% of France\'s electricity).',fact:'5,460 MW · Largest in Western Europe · 6 PWR · Dunkirk, France · EDF · Sea cooling'},
  {n:'Ohi NPP',la:35.52,ln:135.65,sub:'Japan · Fukui · 4,710 MW',desc:'One of Japan\'s largest nuclear plants. 4 pressurized water reactors (2x1,175 MW, 2x1,180 MW). West coast of Honshu (Sea of Japan). Commissioned 1979-1993. Kansai Electric Power operates. Units 3 & 4 restarted after Fukushima (2018) — among first to resume. Ohi-3 and Ohi-4 are the only currently operating units. Seismic design upgraded after 2011. Tsunami walls built (12m high). Located in Wakasa Bay (Japan\'s "nuclear alley" — 14 reactors in Fukui pref).',fact:'4,710 MW · Kansai Electric · Restarted post-Fukushima · Sea of Japan coast · 4 PWR · Fukui nuclear alley'},
  {n:'Hanul NPP',la:37.10,ln:129.35,sub:'South Korea · 6,164 MW',desc:'Second largest nuclear plant in South Korea. 6 reactors (2x950 MW OPR-1000, 2x1,000 MW OPR-1000, 2x1,400 MW APR-1400). East coast (Sea of Japan/East Sea). Commissioned 1988-2005. Shin-Hanul Units 1&2 (APR-1400) under construction — will add 2,800 MW. KHNP operates. South Korea gets 30% of electricity from nuclear. Hanul was formerly known as Ulchin. Strong nuclear industry in Korea: APR-1400 reactors exported to UAE (Barakah).',fact:'6,164 MW · 6 reactors · APR-1400 design · East Sea coast · KHNP · Shin-Hanul expansion'},,
  {n:'Chernobyl Nuclear Power Plant',la:51.39,ln:30.1,sub:'Ukraine · 1986 disaster · Pripyat ghost city',desc:'Site of worst nuclear accident in history (April 26, 1986). Reactor No. 4 explosion during safety test. 2 direct deaths, 28 from acute radiation sickness. 350,000+ people evacuated (30km exclusion zone). Pripyat city abandoned (50,000 residents). Control rods design flaw (RBMK-1000 reactor). 2024: New Safe Confinement (NSC) arch completed 2019 (1.5 billion euro). 500 ton sarcophagus covering reactor. €2.1 billion total cleanup cost. 24,000+ liquidators (cleanup workers). 2022: Russian forces occupied Chernobyl (Feb-April 2022). Radiation dose spikes reported. 2023: IAEA monitoring resumed. 2024: wildlife sanctuary — wolves, bears, Przewalski\'s horses. 5,000+ solar panels installed 2018 (1MW). 1986-2000: other reactors continued operating. Reactors 1-3 shut down by 2000. 2,500 staff still operate waste management. 2023: Chernobyl radioactive waste repository (ISF-2) opened. 2025: full decommissioning phase. 2015: "Chernobylite" radioactive fuel dust. 2006: 20th anniversary documentary. 2019: HBO miniseries "Chernobyl" (Emmy-winning). Tourism: 100,000 visitors/year to exclusion zone. 2021: "Chernobyl: History of a Tragedy" book bestseller. 2024: mass tourism halted by war (Ukraine). 1990: Greenpeace report 93,000+ cancer deaths. 2021: UN says 30-40 deaths, Greenpeace disputes. "Zone of Alienation": 2,600 km². Forests (Red Forest) — most radioactive area. 2016: Arch assembly (lifted into place). 2022: radiation levels remained stable during occupation. 2024: IAEA placed permanent missions. 30km exclusion zone popular for dark tourism. 1985: RBMK-1000 reactor design. 1991: Ukraine independence — plant became issue. Reactor No. 4 — 30,000 curies/second release. 10-day fire. 200 tonnes fuel remains inside.',fact:'1986 disaster (worst nuclear accident) · Reactor 4 explosion · RBMK-1000 · Pripyat ghost city · 350,000 evacuated · 2 direct deaths · 28 ARS deaths · 350,000+ liquidators · New Safe Confinement arch (2019, €1.5B) · Russian occupation 2022 · HBO Chernobyl 2019 · 100k tourists/year · exclusion zone 2,600 km² · decommissioning ongoing'},
  {n:'Fukushima Daiichi Nuclear Power Plant',la:37.42,ln:141.03,sub:'Japan · 2011 nuclear disaster · March 11',desc:'Second worst nuclear disaster in history. March 11, 2011: 9.0 earthquake + 15m tsunami. Reactors 1-3 meltdowns (Units 4-6 damaged). 160,000 people evacuated (20km zone). 1,000+ deaths indirectly (evacuation stress, suicide). 2023: treated water release into Pacific begins (ALPS filtered water). 1.3 million tonnes of contaminated water stored. 2024: IAEA endorsed water release as safe. 2021: plan to release water over 30-40 years. 2023: China banned Japanese seafood. 2024: South Korea monitoring. 2022: robot surveys find molten fuel debris. 2024: fuel debris removal begins (10th year delay). 2019-2024: decommissioning cost $75B+. 2023: first fuel debris removal test. 2024: full debris removal 2025+. 2020: Olympic torch relay canceled through Fukushima. 2012: no-fly zone. 2023: 500+ tonnes of cesium released. 2011: hydrogen explosions (Unit 1, 3, 4). 2 TEPCO executives acquitted 2019 (criminal case). 2021: compensation paid to 300,000+ people ($90B). 2017: ice wall (frozen soil barrier) completed ($320M). 2024: fish testing — only 0.1% above limit. 2013: leak rates decreased. 2022: new submersible robot investigates Unit 1. 2023: Unit 1 interior photographed. 2024: 12th year since disaster. 2018: TEPCO admits 30-40 year cleanup timeline unrealistic. 2051: complete decommissioning target (doubtful). 2020: 30 km zone partially reopened. 2023: <2% of original residents returned to exclusion zone. 2024: Fukushima renewable energy hub (solar, hydrogen). 2025: Fukushima Bay tritium monitoring. 2011: Daiichi vs Daini — Daini survived worse tsunami. 2022: ROV insert. 2023: Fukushima treated water safety. 15,000+ deaths from earthquake/tsunami directly. Nuclear Accident Independent Investigation Commission (NAIIC) 2012. Contaminated water storage tanks: 1,000+. ALPS (Advanced Liquid Processing System) removes 62 radionuclides except tritium.',fact:'2011 triple meltdown · 9.0 earthquake + 15m tsunami · Reactor 1-3 meltdown · 160,000 evacuated · ALPS treated water release (2023-present) · 1.3M tonnes water stored · $75B+ cleanup · 2051 target decommission · ice wall ($320M) · IAEA endorses release · China seafood ban · 12th year cleanup · 0.1% of fish above limit'},
  {n:'Kashiwazaki-Kariwa Nuclear Power Plant',la:37.44,ln:138.6,sub:'Japan · Niigata · World\'s largest nuclear plant (8,212 MW)',desc:'World\'s largest nuclear power plant by capacity (8,212 MW). 7 boiling water reactors (BWR). 1,100 MW each. Kawashiwazaki-Kariwa Plant (KKP). Owned by TEPCO (same operator as Fukushima). Built 1980-1997. 2007: Chūetsu Offshore Earthquake (M6.6) — Richter scale. 4.2×10^13 Bq radioactive release. Plant shut for 2 years. 2009: restarted after $1.5B upgrades. 2011: Fukushima disaster — all Japanese nuclear plants shut. 2012-2023: plant idled. Safety upgrades: 2.5m tsunami wall, 360,000 m³ water storage. 2017: Nuclear Regulatory Authority (NRA) approves restart. 2018: local opposition blocks restart. 2019: restart approval rescinded (terrorism failure). 2021: NRA gives final approval for restart. 2023: Niigata Governor opposes restart. 2024: TEPCO seeking restart approval (Japan energy crisis). 2023: Japan\'s nuclear safety laws — new barrier required. 2024: reactor 7 restart targeted 2025. 2021: new counterterrorism measures required. 2025 restart: no-go. Rokkasho reprocessing plant stores 2,700 tonnes fuel. Kashiwazaki-Kariwa: iconic. 2002: TEPCO falsified inspection reports (scandal). 8,212 MW: 7 reactors — Site holds Guinness World Record. 2020: Kashiwazaki city population 85,000. 2022: Ukraine crisis — Japan\'s energy security. 2024: Japan imports 94% energy. Kariwa nuclear fuel storage pool. 2023: 4.1M tonnes spent fuel. 2011: Kashiwazaki-Kariwa shut after Fukushima. 2024: Japan prepares restart of world\'s biggest plant. 10,000+ workers during construction. Terraced layout. 2 large breakwaters. 2021: NRA safety approval. 2023: restart injunction. 2025: ongoing legal battles. 2024: Japan energy plan includes nuclear. 2022: 4.55 MW solar array at KKP. 2021: earthquake research at site.',fact:'8,212 MW (world\'s largest) · 7 BWR reactors · Niigata, Japan · TEPCO · 2007 M6.6 earthquake damage · $1.5B upgrades · Fukushima idled 2011-2024 · restart blocked by local opposition · Guinness World Record · 2002 inspection scandal · Japan energy crisis · safety approval battles'},
  {n:'Zaporizhzhia Nuclear Power Plant',la:47.51,ln:34.59,sub:'Ukraine · 6 reactors · 6,000 MW · Europe\'s largest',desc:'Europe\'s largest nuclear power plant (6 reactors, 6,000 MW). Located in Enerhodar, Ukraine, on Dnieper River. Owned by Energoatom (Ukraine). 1985-1996: reactors commissioned. 2022: Russian forces captured plant (March 4, 2022). World\'s first nuclear plant in active war zone. 2024: IAEA Mission resident at plant. Shelling: 10+ IAEA confirmed attacks. 2022: 2-month Russian control. 2023: Kakhovka Dam destroyed (water supply risk — cooling ponds). 2024: cooling towers and water available. 2023: backup diesel generators needed (external power cut). 2024: grid disconnections (9 times since 2022). 2022: radiation monitoring lost. 2023: IAEA presence established (4 inspectors permanent). 2024: plant in cold shutdown since September 2022. Reactors maintain cooling. 2023: mines found in buffer zone. 2022: fire in training building. 2023: reactor 6 restarted briefly for heating? (disputed). 2024: plant employees reduced from 11,000 to 2,000. 2,000 Russian National Guard troops. 2023: ZNPP safety at risk — IAEA Director General Rafael Grossi. 2024: IAEA continues rotation of experts. 2023-2024: attacks around plant (drones, artillery). 2023: safety zone proposal. 2024: No physical attacks on reactors (as of mid-2024). 2023: Enerhodar occupied since 2022. 2024: partially evacuated due to shelling. 2023: IAEA says 5 nuclear safety principles violated. 2024: ZNPP nuclear fuel shipments hampered. 2022: plant workers detained, tortured. 2023: IAEA grossi visit. 2024: IAEA. 2025: safety zone negotiation. 2022-2024: Russia-IAEA-Ukraine talks. Prolonged conflict. Core damage risk from drone crash. 2024: all 6 reactors in cold shutdown. 2023: spent fuel storage intact. 2024: external power restored several times. 2022: ZNPP VVER-1000 reactors (6). Total capacity 6,000 MW. 2024: maintenance performed. Large catastrophe theoretical but avoided.',fact:'6,000 MW (Europe\'s largest) · 6 VVER-1000 reactors · Ukraine · captured by Russia March 2022 · IAEA permanent mission · active war zone · cold shutdown since Sept 2022 · Kakhovka Dam destroyed 2023 · 2024: shelling continues · 10+ grid disconnections · Rafael Grossi · safety zone diplomacy · nuclear safety first in war'},
  {n:'Bruce Nuclear Generating Station',la:44.33,ln:-81.59,sub:'Canada · Ontario · 6,430 MW · World\'s largest operating',desc:'World\'s largest fully operational nuclear plant (6,430 MW). 8 CANDU reactors. Located on Lake Huron, Tiverton, Ontario. Built 1971-1987 (A station: 4 reactors, B station: 4 reactors). Owned by Bruce Power (leased from Ontario Power Generation). 2024: 30% of Ontario\'s electricity. 2023: produces 50 billion kWh/year. 2024: refurbishment program (6 units undergoing mid-life refurb). 2020: Unit 6 refurbished (completed). 2023: Unit 3 refurb started. 2025: Unit 4 under refurb. Unit 1 completed 2022 (refurb). 2025: Unit 2 under refurb. 2030: all 8 units refurbished. 2021: Bruce Power signs HEPA filter study. 2022: isotope production (medical cobalt-60, lutetium-177). Bruce C: proposed new 4,800 MW plant (4 BWRX-300 SMRs). 2024: Canada\'s largest infrastructure project (Bruce C). 2025: regulatory process for Bruce C. 2013: long-term power purchase agreement. 2001: Bruce Power leases plant (private operator). 1980s: Bruce A laid up (overheating, tube failures). 1990s: Bruce B operational. 96% capacity factor average. 4,500 employees. 2022: Bruce C consultant assessment. 2023: SMR feasibility. 2024: Bruce Power 4% of Canada\'s electricity. 2023: $13B refurbishment program. 2033: refurbishment completion. 2,300 MW output during peak. 2024: Bruce Power\'s net capacity. Bruce A Units 1-2: restart completed. 2022: Tritium removal facility expanded. 2022: major component replacement (MCR). 2021: 50th anniversary. 2014: Unit 1-2 return to service. 2024: $5B investment in Bruce County. 2023: extension plant life to 2064. SMR development. 2024: CANDU technology for global markets. 2050 net-zero goals. 2024: Ontario electricity demand growing 2%/year.',fact:'6,430 MW (world\'s largest operating) · 8 CANDU reactors · Ontario, Canada · Lake Huron · Bruce Power · 30% of Ontario electricity · 50 billion kWh/yr · $13B refurbishment program · medical isotopes (Co-60, Lu-177) · Bruce C proposed (4,800 MW SMRs) · 4,500 employees · CANDU technology · since 1971 · life extension to 2064'}

];
