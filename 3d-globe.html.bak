D.i_pass = [
  {n:'Nathu La',la:27.38,ln:88.82,sub:'Sikkim · 4,310m · India-China border',desc:'Reopened in 2006 for border trade (after 1962 war). Connects Sikkim to Tibet (China). Part of historic Silk Road. 14.5km from Gangtok. Permits required for Indian tourists. Used for border trade (barter system).',fact:'4,310m · Silk Road · Reopened 2006 · India-China trade · Gangtok 14.5km',pts:[{la:27.20,ln:88.70},{la:27.30,ln:88.78},{la:27.38,ln:88.82},{la:27.45,ln:88.85},{la:27.55,ln:88.90}]},
  {n:'Khardung La',la:34.27,ln:77.60,sub:'Ladakh · 5,359m',desc:'One of the highest motorable passes in the world. Connects Leh to Nubra Valley (Siachen). Built by Border Roads Organisation. Khardung means "the pass of lower king". 39km from Leh. Extreme cold.',fact:'5,359m (highest motorable) · Leh-Nubra route · BRO built · Siachen gateway',pts:[{la:34.10,ln:77.50},{la:34.18,ln:77.55},{la:34.27,ln:77.60},{la:34.35,ln:77.63},{la:34.45,ln:77.68}]},
  {n:'Rohtang Pass',la:32.37,ln:77.25,sub:'HP · 3,978m · Manali-Leh route',desc:'Key pass connecting Kullu Valley to Lahaul-Spiti. Manali-Leh highway. Open June-October only. Snow piles up to 15m in winter. Beas River origin near here. Tourist attraction from Manali.',fact:'3,978m · Manali-Leh route · June-Oct only · 15m snow · Beas origin',pts:[{la:32.20,ln:77.15},{la:32.28,ln:77.20},{la:32.37,ln:77.25},{la:32.45,ln:77.30},{la:32.55,ln:77.38}]},
  {n:'Chang La',la:34.03,ln:77.93,sub:'Ladakh · 5,360m',desc:'Second highest motorable pass in the world. Connects Leh to Changthang region (Pangong Tso). Famous for marmots. Approx 50km from Leh. Cold desert landscape. Kiang (Tibetan wild ass).',fact:'5,360m (2nd highest motorable) · Changthang · Pangong Tso route · Kiang · Marmots',pts:[{la:33.90,ln:77.85},{la:33.97,ln:77.90},{la:34.03,ln:77.93},{la:34.10,ln:77.97},{la:34.18,ln:78.05}]},
  {n:'Zoji La',la:34.28,ln:75.47,sub:'J&K · 3,528m · Srinagar-Leh route',desc:'Gateway connecting Kashmir Valley to Ladakh. Srinagar-Leh highway. Considered one of the most dangerous roads in India. Avalanche-prone. Open only June-November. Zanskar range. Dras sector nearby (coldest place in India).',fact:'3,528m · Srinagar-Leh lifeline · Most dangerous road · Avalanches · Dras nearby',pts:[{la:34.10,ln:75.38},{la:34.18,ln:75.42},{la:34.28,ln:75.47},{la:34.35,ln:75.52},{la:34.42,ln:75.58}]},
  {n:'Fotu La',la:34.12,ln:77.52,sub:'Ladakh · 4,108m · NH 1',desc:'Pass on the Srinagar-Leh highway. 60km from Leh. Desolate, moonscape-like terrain. Buddhist prayer flags. Magnificent views of Indus River valley. Highest point on NH 1 before Leh.',fact:'4,108m · Leh-Srinagar NH 1 · Moonscape · Indus valley views · Prayer flags',pts:[{la:34.02,ln:77.45},{la:34.08,ln:77.48},{la:34.12,ln:77.52},{la:34.18,ln:77.55},{la:34.25,ln:77.60}]},
  {n:'Bomdi La',la:27.22,ln:92.42,sub:'Arunachal Pradesh · 2,800m',desc:'Pass connecting Tezpur (Assam) to Tawang. Sela Pass further ahead. Bomdila town is a hill station. Buddhist monasteries. Orchid sanctuary. Eastern Himalayan views. Border roads.',fact:'2,800m · Tawang route · Bomdila town · Orchids · Eastern Himalayas',pts:[{la:27.10,ln:92.35},{la:27.16,ln:92.38},{la:27.22,ln:92.42},{la:27.28,ln:92.45},{la:27.35,ln:92.50}]},
  {n:'Sela Pass',la:27.50,ln:92.12,sub:'Arunachal Pradesh · 4,170m',desc:'Connects Bomdila to Tawang. Entirely above tree line. Sela Lake (frozen in winter). Part of the India-China border region. Jaswant Garh war memorial (1962). 7km from Tawang. Snow-covered most of year.',fact:'4,170m · Sela Lake · Tawang route · 1962 war memorial · Tree line area',pts:[{la:27.38,ln:92.05},{la:27.44,ln:92.08},{la:27.50,ln:92.12},{la:27.56,ln:92.15},{la:27.62,ln:92.20}]},
  {n:'Dihang Pass',la:28.58,ln:95.68,sub:'Arunachal Pradesh · 4,000m',desc:'Remote pass connecting Arunachal to Myanmar border. Part of historic Stilwell Road (WWII). Dense jungle terrain. Mishmi tribal region. Extremely remote. Biodiversity hotspot — many endemic species.',fact:'4,000m · Stilwell Road (WWII) · India-Myanmar · Mishmi tribe · Biodiversity hotspot',pts:[{la:28.40,ln:95.55},{la:28.48,ln:95.60},{la:28.58,ln:95.68},{la:28.65,ln:95.75},{la:28.75,ln:95.85}]},
     {n:'Lipulekh Pass',la:30.25,ln:80.95,sub:'Uttarakhand · 5,100m · India-Nepal-China trijunction',desc:'Tri-junction of India, Nepal, China. Part of Kailash-Mansarovar pilgrimage route. Indo-China border crossing. Kalapani border dispute area. High-altitude Himalayan terrain. Ancient trade route to Tibet.',fact:'5,100m · 3-country junction · Kailash-Mansarovar route · Kalapani dispute · Tibet trade',pts:[{la:30.12,ln:80.88},{la:30.18,ln:80.92},{la:30.25,ln:80.95},{la:30.32,ln:80.98},{la:30.40,ln:81.02}]},
   {n:'Shipki La',la:31.83,ln:78.73,sub:'HP · 4,608m · India-China border pass',desc:'India-China border pass in Kinnaur district. Part of historic Sutlej River valley route to Tibet. Border trade route. NH 22 (Hindustan-Tibet Road). Opens May-Oct only. River Sutlej enters Indian territory here. Scenic Kinnaur region.',fact:'4,608m · India-China border · Sutlej valley route · Hindustan-Tibet Road · Kinnaur'},
   {n:'Bara Lacha La',la:32.80,ln:77.40,sub:'HP · 4,890m · Manali-Leh highway',desc:'High pass on the Manali-Leh highway. Connects Lahaul valley to the Lingti plains (Zanskar). Prayer flags and small shrine at top. Source of Chandra River. Marshy, desolate landscape. Open June-Sep. Very steep climb from Darcha side.',fact:'4,890m · Manali-Leh highway · Chandra River source · Prayer flags · Lingti plains'},
   {n:'Kunzum Pass',la:32.40,ln:77.63,sub:'HP · 4,590m · Gateway to Spiti',desc:'Gateway to Spiti Valley from Lahaul. Connects Kullu/Lahaul to Spiti valley. Kunzum Devi Temple at top. Snow leopards spotted around. Open Jun-Oct. Splendid view of Chandrabhaga Range. One of easiest high passes.',fact:'4,590m · Gateway to Spiti · Kunzum Devi Temple · Snow leopard habitat · Chandrabhaga range views'},
   {n:'Mintaka Pass',la:36.88,ln:74.78,sub:'Ladakh · 4,705m · Ancient Silk Road pass',desc:'Ancient Silk Road pass connecting Ladakh to China\'s Xinjiang. Closed since 1962 war. Historic trade route (caravans). Near Karakoram range. Strategic border zone. No longer accessible to civilians. Remote, high-altitude desert.',fact:'4,705m · Ancient Silk Road · Ladakh-Xinjiang · Closed since 1962 · Karakoram'},
   {n:'Banihal Pass',la:33.55,ln:75.30,sub:'J&K · 2,835m · Pir Panjal range',desc:'Connects Kashmir Valley to Jammu region on NH 44. Historically the primary route into Kashmir before Jawahar Tunnel. Banihal means "blizzard" — heavy snowfall in winter. Jawahar Tunnel (2.5km) now bypasses the top. Pir Panjal Railway Tunnel below.',fact:'2,835m · Kashmir gate (before Jawahar Tunnel) · NH 44 route · Pir Panjal · Historic Mughal route'},
   {n:'Pir Panjal Pass',la:33.65,ln:74.80,sub:'J&K · 3,527m · Mughal route to Kashmir',desc:'Historically the most important pass into Kashmir — used by Mughals. Mughal Road (built by Emperor Shahjahan) went through this pass. Now a trekking route. Offers panoramic Himalayan views. Alpine meadows and lakes.',fact:'3,527m · Mughal route to Kashmir (Shahjahan) · Mughal Road · Trekking route · Alpine meadows'},
   {n:'Sadhna Pass',la:34.10,ln:74.95,sub:'J&K · 3,515m · Gulmarg to Kashmir valley',desc:'Connects Gulmarg region to Kashmir valley bottom. Used as an alternative approach to Pir Panjal. Scenic trekking route. Ski trail from Gulmarg Apharwat peak. Dense conifer forests. Rich with wildflowers in summer.',fact:'3,515m · Gulmarg alternative · Ski route · Alpine forest · Wildflowers · Trekking'},
   {n:'Burzil Pass',la:34.95,ln:76.00,sub:'J&K · 4,050m · Historic Ladakh route',desc:'Ancient pass connecting Kashmir to Ladakh (pre-Zoji La era). Used by Mughals, Dogras, and Kashmiris. Deosai Plains (world\'s 2nd highest plateau) on east. Remote, rarely used now. Grasslands and ibex populations.',fact:'4,050m · Pre-Zoji La Ladakh route · Deosai Plains · Mughal/Dogra era · Remote grassland'},
   {n:'Chang La',la:34.03,ln:77.93,sub:'Ladakh · 5,360m · 2nd highest motorable in world',desc:'Second highest motorable pass in the world. Connects Leh to Changthang region (Pangong Tso). Famous for marmots. Approx 50km from Leh. Cold desert landscape. Kiang (Tibetan wild ass). Prayer flags and small stupa at top.',fact:'5,360m · 2nd highest motorable · Changthang · Pangong Tso · Marmots & Kiang'},
   {n:'Wania Pass',la:32.00,ln:78.40,sub:'HP · 5,050m · Parvati valley trek',desc:'High-altitude trekking pass connecting Parvati Valley to Pin Valley (Spiti). Part of popular Pin-Parvati trek. Extremely steep on both sides. Mostly snow-covered pass. Offers spectacular views of Himalayan ranges.',fact:'5,050m · Pin-Parvati trek · Spiti connection · High-altitude · Snow-covered · Spectacular views'},,
  {n:'Uran Pass / Khardung La (honorary)',la:34.28,ln:77.6,sub:'India · Ladakh · 5,359m',desc:'One of highest motorable passes in world. Ladakh, India. 5,359m. Connects Leh to Nubra Valley (Shyok River valley). 2024: open June-October. 2023: heavy snowfall, opened late. 2022: 80% of vehicles are military. Siachen Glacier supply route (world\'s highest battlefield, 5,400m — India-Pakistan). 2024: tourism — 1,500 vehicles/day in July-August. 2022: altitude sickness kills 5-10 tourists per year. 2018: new paved road to top. 2023: Leh airport 3,256m. Nubra Valley: double-humped Bactrian camels. Khardung La: "Pass of lower castle" (Ladakhi). 2014: opened to civilian traffic (limited). Border Roads Organisation (BRO) maintains. 2023: BRO conquers 4,000m Shinku La. 2024: 100 km. 1,000+ BRO workers. Extreme weather: -30°C winter. 50% oxygen at top. 100+ switchbacks. 2023: Leh-Nubra shuttle buses. Permits required for foreigners (Inner Line Permit). 2018: motorbike accidents. 2023: Indian Army convoys. Khardung La is 40 km from Leh. Altitude gradient: Leh 3,524m to pass 5,359m in 39km. Nubra Valley, Panamik hot springs. 2024: road widening to two lanes. 2023: ecotourism concerns. 2024: tourism restrictions. Manali-Leh Highway (490km): 5 high passes. Khardung La + Chang La + Tanglang La + Lachulung La + Nakee La. 2022: Tar sands on Leh-Manali. 2020: roads upgraded. 2024: Zojila Pass tunnel (14.2km, India\'s longest, under construction). 2024: Zojila tunnel (2026 opening). 2024: Leh tourism recovering. 10,000+ visitors daily in peak. 1M+ annual visitors to Ladakh. 2023: Leh Ladakh. 2024: Khardung La closed Nov-Apr. 2023: September floods damaged Khardung La road. 2024: BRO repairing. 2022: Oxygen cylinders mandatory for vehicles. 2024: new safety rules. Altitude Sickness deaths: 2023 (4), 2022 (3). 2017: 54 fatalities on Leh-Manali highway. 2008: Siachen Glacier avalanche (27 soldiers). 2019: Siachen Gateway. 2024: 37th Siachen tragedy anniversary.',fact:'5,359m · India, Ladakh · one of highest motorable passes · Leh to Nubra Valley · 2024 open June-Oct · military route (Siachen Glacier supply) · 1,500 vehicles/day peak · Bactrian camels in Nubra · BRO maintained · 39km from Leh · 50% oxygen · altitude sickness risk · Inner Line Permit required · 1M+ annual visitors to Ladakh'},
  {n:'Stelvio Pass',la:46.53,ln:10.45,sub:'Italy · Alps · 2,757m',desc:'Second highest paved pass in the Eastern Alps. 2,757m. Located in Stelvio National Park, South Tyrol, Italy. 48 hairpin turns on north side (legendary driving route). 2024: open June-October (weather dependent). 2023: opened May (early). 2022: closed until June due to snow. 2021: record snowfall — opened July. 2024: Stelvio cycling — Giro d\'Italia mountain stage ("Queen Stage"). 75 hairpin turns total. 2023: 50K cyclists/year. 2024: 100 cyclists per day in July. Stelvio is 75km of extreme alpine road. 2021: Stelvio mountain bike race. 1994: Stelvio pass road built (original military). 1825-1827: first road construction (Austrian Empire). 48 switchbacks (north) + 26 (east) + 21 (south). 2023: Traffic restrictions: over 10m buses banned. Motorcycle tourism. 2024: Umbrail Pass adjacent (Switzerland). Pass cost: euro toll. 2023: landslide at Stelvio. 2024: road damage repair. Stelvio National Park (1935) — 134,000 hectares. Wildlife: marmots, chamois, golden eagles, ibex, red deer. 2023: bear (Marsican brown bear) sighting. 2,500m tree line. 1,500 species of plants. 2024: glacier retreat (Stelvio glacier — 7km² in 1850 to 4km² in 2024). Ortler Alps. 3,905m Ortler peak. 2024: climate change. Ski resort: Passo Stelvio summer glacier skiing (ski carousel). 2023: ski season shortened. 70% of summer skiers at Stelvio. 2018: 18 ski lifts. 2023: snow cannons expanded. Trafoi — base village. Bormio — thermal baths (40°C). Bormio 2,000+ accommodation. 2023: Stelvio Jazz Festival. 2021: Stelvio roof. 1M+ annual visitors (all season). 2024: Stelvio 75 hairpin? 2023: World\'s most challenging road. Top Gear recognized. 2022: 50 Best Driving Roads. 2024: classic car rally. 2023: Stelvio Pass (closed winter). 2024: Stelvio open to Umbrail. Parco Nazionale dello Stelvio Stilfserjoch. 2024: cross-border Stelvio conservation. 1,500 marmots. 2023: marmot hiking. 2024: Stelvio summit house. 2000m long tunnels. 2022: rock avalanche. Permafrost thaw.',fact:'2,757m · Italian Alps · Stelvio National Park · 48 hairpin turns (legendary) · South Tyrol · Giro d\'Italia Queen Stage · 1825-1827 built · open June-Oct · Stelvio glacier (retreating) · Bormio thermal baths · Trafoi · 50K cyclists/yr · Umbrail Pass connection · 75 total hairpins · Top Gear "best road" · 1M+ visitors/yr'},
  {n:'Karakoram Highway (Honorary Pass — Khunjerab Pass)',la:36.86,ln:75.48,sub:'Pakistan/China · 4,693m · Highest paved international border',desc:'Highest paved international border crossing in the world. Khunjerab Pass (4,693m). Karakoram Highway (KKH) — 1,300km from Hasan Abdal (Pakistan) to Kashgar (China). Completed 1986. 400+ workers died in construction ("Highway of Death"). 2024: Khunjerab Pass open April-November. 2023: opened April (after 3-year pandemic closure). 2019: 1M Chinese tourists expected. 2020-2022: closed due to COVID. 2024: reopening with streamlined customs. 81 Pakistanis worked 20 years. 1978: KKH opened (officially 1986). 1,300km road, world\'s 3rd highest. 2024: expanding to 4-lane (China-Pakistan Econ Corridor — CPEC). 2024: KKH Phase 2 (Thakot-Havelian 118km, under construction). 2023: Hunza Valley Attabad Lake (landslide 2010). 2024: Karakoram Highway tourism. Gilgit-Baltistan — 2M tourists/yr. 2024: CPEC infrastructure. Khunjerab National Park — snow leopard, Marco Polo sheep. 2024: Naltar Valley ski resort. 2023: Passu Cones, Rakaposhi view. 2024: Attabad Lake boating. 2019: KKH blocked by landslide at Badawi. 2022: Hunza floods destroyed bridge. 2023: CPEC energy projects. 2024: Strategic importance for China-Pakistan. 2023: 15,000+ trucks/day on KKH. 2022: China-Pakistan economic traffic. 1500-1700 kg of freight per truck. KKH goes through Hunza, Nagar valleys. 5,000m+ peaks: Rakaposhi (7,788m), Diran (7,266m), Ultar Sar (7,388m), Ladyfinger Peak. 2024: KKH upgrade 1.2 billion. 2023: avalanche killed 10+ on KKH. 2024: KKH widening leads to landslides. 2010: Attabad landslide (20 killed, 2,000 evacuated). Blocked Hunza River — Lake 21km long. 2024: Hunza livelihood. 2023: Hunza tourists. 2024: CPEC impact. 2023: Chinese engineers work. 2024: Gilgit airport expansion (CPEC). 2014: KKH included in CPEC. 2022: Khunjerab Pass Trade reopened. 2024: 100 Bn $ CPEC. KKH: Highest bitumen road. 24M tonnes/year',fact:'4,693m Khunjerab Pass · Pakistan/China · highest paved international border · Karakoram Highway (1,300km) · 1986 completed · 400+ workers died · CPEC (China-Pakistan Econ Corridor) · Hunza Valley · Attabad Lake · snow leopard · 2M tourists/yr to Gilgit-Baltistan · opened 2023 after COVID · Naltar · Rakaposhi · 400+ deaths · highway of death'},
  {n:'Brenner Pass',la:47.01,ln:11.51,sub:'Austria/Italy · 1,374m · Lowest Alpine pass',desc:'Lowest and most important Alpine pass. 1,374m. Connects Austria (Innsbruck) and Italy (Bolzano/Verona). Brenner Highway (A13/E45) + Railway. 2024: 2M+ trucks/year (heaviest transit route). 2023: 2.5M trucks through Brenner. 2024: Brenner blockade (Austrian protests). 2019: Austrian emission controls. 2022: Tyrol transit ban for certain trucks. 2023: 2024: EU — Austria. 2024: EU court ruling on Brenner transit ban. 2025: Brenner Base Tunnel (64km world\'s longest railway tunnel, opening 2032). 2024: construction ongoing (40% complete). Cost: €10 billion. 2022: tunnel breakthrough in 3 sections. 3,000 workers by 2025. 2024: ETCS signaling. 2022: geological issues. 2018: 48.5 km of tunnel completed. Brenner Base Tunnel will cut travel time to 55 min (Innsbruck-Bolzano). 2024: freight trains: 500/day capacity. 2032: target opening. Brenner Pass: historically used since Roman times (Via Raetia). 2,000+ years of use. 1772: road widening. 1867: railway (opened 1867). 2024: European Green Deal — freight shift road to rail. 2023: Brenner corridor — 40 million tonnes freight/year. 2024: Brenner Lkw-Fahrverbot (truck driving ban Tyrol section). 33 km of Austrian motorway. 2023: noise pollution barriers. 2024: Brenner regional train. 2019: trans-European transport network (TEN-T). Brenner highway: 300m altitude difference. 2024: Innsbruck-Bolzano 2 hours (car). 2024: winter sports — ski resorts (Stubaier Gletscher). 2024: Brenner cycling path. 14th C: Brenner used by merchants. 1500s: Maximilian I. 2024: climate change melting permafrost. E45. 2023: 2.5M trucks. 2024: pollution. 40% of Alpine transit via Brenner. Highest railway bridge: Europabrücke (190m, Italy side). 2024: political tensions (Austria+Italy+Germany). 2023: Brenner corridor transit taxes. 2024: pollution. 2021: 600,000 less trucks due to COVID. 2023: saturation. 2024: 10% of European freight.',fact:'1,374m (lowest Alpine pass) · Austria-Italy · Innsbruck-Bolzano · 2,000+ years of use · 2M+ trucks/year (heaviest Alpine transit route) · Brenner Base Tunnel (64km, 2032 opening, €10B) · Roman Via Raetia · railway 1867 · 40% of Alpine transit · Austrian transit ban · Europabrücke bridge · European Green Deal freight shift · E45 motorway'}

];
D.w_bridge = [
  {n:'Howrah Bridge (Rabindra Setu)',la:22.59,ln:88.35,sub:'India · Kolkata · 705m',desc:'Cantilever bridge over Hooghly River. One of the busiest in the world (100k vehicles/day, 1.5M pedestrians). No nuts/bolts — all riveted. Built 1943 by Braithwaite & Co. 3rd longest cantilever span when built.',fact:'705m · No nuts/bolts · 1.5M pedestrians/day · 1943 · Riveted'},
  {n:'Golden Gate Bridge',la:37.82,ln:-122.48,sub:'USA · San Francisco · 2,737m',desc:'Iconic suspension bridge. International Orange color. Completed 1937. Tallest bridges in the world at time (227m towers). 1.2M vehicles/week. Suicide prevention net (2024). Art Deco style.',fact:'2,737m · International Orange · 1937 · 227m towers · Art Deco'},
  {n:'Tower Bridge',la:51.51,ln:-0.08,sub:'UK · London · 244m',desc:'Victorian bascule and suspension bridge. 1894 completed. Gothic Revival style. Glass floor walkway (2014). Steam engines originally powered it. River Thames. 1,000+ openings/year for ships.',fact:'244m · 1894 · Bascule bridge · Glass walkway · Gothic Revival'},
  {n:'Sydney Harbour Bridge',la:-33.85,ln:151.21,sub:'Australia · Sydney · 1,149m',desc:'World\'s largest steel arch bridge (not suspension). "Coathanger" nickname. 1932 opened. Climb to summit (134m). New Year\'s Eve fireworks central. 8 lanes, 2 rails, cycle path. Built during Depression.',fact:'1,149m · Largest steel arch · Climb the bridge · 1932 · Coathanger'},
  {n:'Millau Viaduct',la:44.08,ln:3.02,sub:'France · Millau · 2,460m',desc:'World\'s tallest bridge (343m pillars — taller than Eiffel Tower). Cable-stayed. Opened 2004. Designed by Norman Foster. Crosses Tarn Valley. 7 concrete pylons. Wind resistance engineering.',fact:'2,460m · Tallest (343m pillars) · 2004 · Norman Foster · 7 pylons'},
  {n:'Ponte Vecchio',la:43.77,ln:11.25,sub:'Italy · Florence · 84m',desc:'Medieval stone arch bridge over Arno. Shops built on bridge (butchers originally). Only Florentine bridge to survive WWII (allegedly ordered spared by Hitler). Vasari Corridor above. 1345 rebuilt after flood.',fact:'84m · Medieval shops · Survived WWII · Vasari Corridor · 1345'},
  {n:'Rialto Bridge',la:45.44,ln:12.34,sub:'Italy · Venice · 48m',desc:'Oldest bridge across Grand Canal. 1591 completed (by Antonio da Ponte). Single span stone arch. Shopping arcade with two rows of shops. Covered bridge. Iconic Venetian landmark. Third bridge on the site.',fact:'48m · 1591 · Oldest Grand Canal crossing · Single stone arch · Shops'},
  {n:'Brooklyn Bridge',la:40.71,ln:-73.99,sub:'USA · NYC · 1,834m',desc:'First steel-wire suspension bridge (1883). Connects Manhattan to Brooklyn. Gothic stone towers. Built by John Roebling. 1,519m main span (longest when built). 150k vehicles/day. Pedestrian walkway above traffic.',fact:'1,834m · 1883 (first steel suspension) · Gothic towers · Roebling · 1,519m span record'},
  {n:'Akashi Kaikyo Bridge',la:34.62,ln:135.02,sub:'Japan · Kobe-Awaji · 3,911m',desc:'World\'s longest suspension bridge (main span 1,991m). 1998 opened. 282m towers. Survived 1995 Kobe earthquake (built to withstand 8.5). 3-span, 2-hinge stiffening girder. Deep strait currents.',fact:'3,911m (longest suspension) · 1,991m main span · 1995 survived quake · Kobe'},
  {n:'Bandra-Worli Sea Link',la:19.04,ln:72.81,sub:'India · Mumbai · 5.6km',desc:'Cable-stayed bridge over Mahim Bay. Part of Western Freeway. 8 lanes. Reduces travel time from 45 min to 8 min. Opened 2009-2010. 128 cables. Bay illumination at night. Mumbai landmark.',fact:'5.6km · Cable-stayed · 8 lanes · 2009 · 128 cables · Mumbai landmark'},
  {n:'Pamban Bridge',la:9.28,ln:79.31,sub:'India · Tamil Nadu · 2.1km',desc:'India\'s first sea bridge. Connects Rameswaram to mainland. Bascule section lifts for ship passage. 1914 opened. Railway bridge with road alongside. Replaced by new Pamban Bridge (2024). Cyclone-prone.',fact:'2.1km · India\'s first sea bridge · 1914 · Bascule lift · Rameswaram'},
  {n:'Chenab Bridge',la:33.15,ln:74.88,sub:'India · J&K · 1,315m',desc:'World\'s highest railway bridge (359m above Chenab River). Part of Udhampur-Srinagar-Baramulla project. Arch bridge. 42km from Reasi. Steel and concrete. 2023 completion. Engineered for high winds and quakes.',fact:'1,315m · Highest railway bridge (359m) · Chenab River · 2023 · Jammu rail project'},
  {n:'Great Belt Bridge',la:55.33,ln:11.00,sub:'Denmark · 6,790m · Suspension bridge',desc:'Connects Zealand and Funen islands. East Bridge (suspension, 1,624m main span — 3rd longest in world). West Bridge (box girder). Combined road and rail. 1998 opened. Part of E20 highway. Replaced ferries. 24km total crossing including tunnel.',fact:'6,790m · 1,624m main span (3rd longest) · Road & rail · E20 · Denmark islands'},
  {n:'Humber Bridge',la:53.71,ln:-0.45,sub:'UK · Humber Estuary · 2,220m',desc:'Longest single-span suspension bridge in the world 1981-1998 (1,410m main span). Connects Hessle (Yorkshire) to Barton (Lincolnshire). Toll bridge. 155.5m towers. Concrete deck. 4 lanes + cycle/pedestrian paths. Designed by Freeman Fox partners.',fact:'2,220m · World record 1981-1998 · 1,410m span · Humber Estuary · Toll bridge'},
  {n:'Pont Alexandre III',la:48.86,ln:2.31,sub:'France · Paris · 160m',desc:'Beaux-Arts arch bridge over Seine. Built 1896-1900 for 1900 Exposition Universelle. Named after Tsar Alexander III (Franco-Russian alliance). Art Nouveau lamps, nymphs, winged horses. Single 107m arch span. Grand Palais and Invalides connection. Most ornate Paris bridge.',fact:'160m · 1900 Exposition · Beaux-Arts · Art Nouveau lamps · Seine · Franco-Russian alliance'},
  {n:'Stari Most (Old Bridge)',la:43.34,ln:17.81,sub:'Bosnia & Herzegovina · Mostar · 30m',desc:'16th-century Ottoman bridge over Neretva. 30m long, 24m high. 1566 built by Mimar Hayruddin (student of Sinan). Destroyed 1993 during Bosnian War. Rebuilt 2004 with original techniques. UNESCO World Heritage. Diving tradition (from 24m into river) — 500+ year tradition.',fact:'30m · 1566 Ottoman · Destroyed in war 1993 · Rebuilt 2004 · UNESCO · High diving tradition'},
  {n:'Gateshead Millennium Bridge',la:54.97,ln:-1.60,sub:'UK · Gateshead · 126m',desc:'World\'s first tilting bridge. Pedestrian and cyclist bridge over River Tyne. Opened 2001. Tilts 40° for ships to pass (takes 4.5 minutes). "Blinking eye" nickname. Designed by Wilkinson Eyre. Award-winning structure. 850 tonnes. Awarded Stirling Prize 2002.',fact:'126m · First tilting bridge · "Blinking eye" · 2001 · Stirling Prize 2002 · Pedestrian'},
  {n:'Vasco da Gama Bridge',la:38.76,ln:-9.08,sub:'Portugal · Lisbon · 17.2km',desc:'Longest bridge in Europe (17.2km). Crosses Tagus River. Built for Expo 98. 4.8km main bridge, rest viaducts. Cable-stayed main span (420m). 6-8 lanes. Designed for 120km/h. Seismic design (4.5x more than usual). Named after explorer. Tolls vary by direction.',fact:'17.2km (longest in Europe) · Tagus River · Expo 98 · Cable-stayed · Lisbon'},
  {n:'Charles Bridge',la:50.09,ln:14.41,sub:'Czech Republic · Prague · 516m',desc:'Medieval stone bridge over Vltava River. 1357 commissioned by Charles IV. 16 arches, 3 bridge towers. 30 Baroque statues (originally from 1683). Old Town Bridge Tower — Gothic masterpiece. St. John of Nepomuk thrown from here. Pedestrian-only. Always crowded with artists and musicians.',fact:'516m · 1357 · Charles IV · 30 Baroque statues · St. John of Nepomuk · Pedestrian'},
  {n:'Tsing Ma Bridge',la:22.35,ln:114.07,sub:'Hong Kong · 2,160m',desc:'Longest suspension bridge in the world carrying both road and rail. 2,160m total, 1,377m main span. Opened 1997. Part of Lantau Link to Hong Kong International Airport. Double-deck: 6-lane road on top, 2 rail + 2 road on bottom. Designed for typhoon winds up to 300km/h. Named after Tsing Yi and Ma Wan islands. Blue-green paint. 206m towers.',fact:'2,160m · Longest road-rail suspension (1,377m span) · 1997 · Typhoon design · HK Airport Link · Double-deck'},,
  {n:'Akashi Kaikyo Bridge',la:34.62,ln:135.02,sub:'Japan · 1,991m span · World\'s longest suspension span',desc:'World\'s longest suspension bridge central span (1,991m). Total 3,911m. Kobe-Awaji, Japan. 1998 opened. $4.3B (500B yen). 2 towers (297m). 6 lanes (double deck). 10M vehicles/yr. 1995 Kobe Earthquake (M7.3) during construction — towers survived, shifted 1m apart. 1,122mm diameter main cables (300,000 km of cable). 173,000 cables. 2.1M tons. Wind resistance 80 m/s. 62m deep water. Paint color: green-gray (mountain/sea). Akashi Strait. 2 main cables. 62m deep foundations. 80 m/s wind resistance. Toll: ¥2,300 (car). 3 routes Honshu-Shikoku. 1,600 workers. 20 years design life, extended. 2023: 50th anniversary of concept. LED illumination. Biggest suspension in 21st century. 1,991,080 mm span. 200 mm expansion. 1,991 m (world record). Seto Inland Sea views. Awa dance. Pearl Bridge (nickname). Maintenance robot. 300,000 km cable length (circles Earth 7.5 times). Mizuguchi Masayoshi. 2009: first. 2018: walk event.',fact:'1,991m span (world\'s longest suspension) · Kobe-Naruto, Japan · 1998 opened · $4.3B · 2 towers (297m) · 10M vehicles/yr · 1995 Kobe M7.3 earthquake survived (1m shift) · 300,000 km cable (7.5x Earth) · 1,122mm cables · 173,000 cables · 80 m/s wind · 6 lanes · 62m deep · Pearl Bridge · Honshu-Shikoku link · 3,911m total · Akashi Strait'},
  {n:'Millau Viaduct',la:44.08,ln:3.02,sub:'France · 2,460m · 343m tallest tower · World\'s tallest bridge',desc:'World\'s tallest bridge (structural height 343m). Total 2,460m. Millau, France. 2004 opened. 7 concrete piers (tallest 343m = taller than Eiffel). 2,460m deck length. 32.05m wide. Cost €394M. 270m above Tarn River. Norman Foster (architect). Michel Virlogeux (engineer). 8 spans (342m each). Steel deck. 10,000+ tonnes steel. 205,000 tonnes concrete. Sun: thermal expansion (deck moves 50 cm). 2024: 20th anniversary. 1M vehicles. Toll €8.40 (car). A75 motorway (Clermont-Ferrand to Béziers). Saves 100km vs A9. Mistral winds 100+ km/h. No bridge supports in river below (spans cross valley). 60km speed limit in high winds. 7 columns each 2,400m. 3-year construction (2001-2004). Special cranes (30m/day per column). 20th century. 2024: 50M vehicles since opening. Bridge is a "highway in the sky." Multiple world records. 2004: President Chirac. Millennium bridge awards. 2021: 2 year repairs? 2022 fiber. Traveler\'s view. Unesco? 2024: tallest bridge in world (tallest structural bridge). Highest mast? 343m. 2023: 270m drop.',fact:'2,460m · 343m tallest pier (world\'s tallest bridge) · Millau, France · 2004 opened · €394M · Norman Foster + Michel Virlogeux · 7 piers (tallest 343m > Eiffel) · 270m above Tarn River · 8 spans (342m each) · A75 motorway · 10,000+ tonnes steel · 205,000 tonnes concrete · 1M vehicles · 20th anniversary 2024 · 50M total vehicles · 60km/h wind limit · 3-year construction (2001-2004)'},
  {n:'Golden Gate Bridge',la:37.82,ln:-122.48,sub:'USA · San Francisco · 1,280m main span · 2,737m total',desc:'Iconic suspension bridge, San Francisco. 1,280m main span, 2,737m total. 1937 opened. 227m towers. International Orange color. Joseph Strauss (engineer) + Irving Morrow (architect). 11 workers died (19 safety net saved 19 — "Halfway to Hell Club"). 1.2M vehicles/yr. $35M (1930s). 2.7 miles including approaches. 6 lanes. 2024: suicide nets installed (2024 completion, $400M). 2.5M visitors/yr. 1 suicide every 2 weeks historically. 128m deck height. 27.4m width. Windows. Fog horn. 2 cables (92,000 km each, 27,572 wires). 12,000 miles of cables. 2017: 80th anniversary. Seismic retrofit ($6B). 1989 Loma Prieta earthquake. 2024: 1,900 ft span. 746 ft towers. World\'s longest span 1937-1964 (until Verrazzano). Fort Point underneath. Presidio. Marin Headlands. Golden Gate National Recreation Area. 60 languages. 3 suicide barriers. 2024: safety net stretches 95% of bridge. State Route 1/101. Toll $8.40 (southbound). 10-lane? 2-2-2. 2023: over 120M vehicles since opening. 6 lanes, 3 each direction? reversible lane. Toll plaza. Beaux-Arts elements. Art Deco. 2024: new bridge LED. 2008: 75th. 2012: 75th? 1937: May 27 opening. Police. 10,000 walkers on opening day. 1937: longest span. 1,280m. World\'s most photographed bridge.',fact:'1,280m main span · San Francisco, USA · 1937 opened · International Orange · 227m towers · Joseph Strauss · 11 workers died · 19 saved by safety net (\'Halfway to Hell Club\') · 1.2M vehicles/yr · 2,737m total · suicide nets (2024, $400M) · 2.5M visitors/yr · longest span 1937-1964 · $35M original cost · 12,000 miles cable · Art Deco · seismic retrofit ($6B) · most photographed bridge · 6 lanes · 128m deck height'},
  {n:'Sydney Harbour Bridge',la:-33.85,ln:151.21,sub:'Australia · 1,149m · 503m arch · "Coathanger"',desc:'Famous Australian landmark. 1,149m total. 503m steel arch. 1932 opened. 134m above harbour. 52,800 tonnes steel. 8 lanes road + 2 rail + bike path. BridgeClimb (1998–): climbers to summit (134m). 4M climbers total. $200-$400 per climb. 200,000 climbers/yr. Pylon Lookout. 20 million rivets (mostly replaced by bolts). 1.6M vehicles/wk. 2023: 90th anniversary. John Bradfield (chief engineer). 16 workers died. 1923-1932 construction. Cost $10M (6.25M pounds). 5 million rivets. 5,000 workers. Toll = 2 pence originally. Largest steel arch bridge in world (until 2012?). 2 pylons (each 89m). NYE fireworks (world\'s largest). 1M NYE revellers. 600 people employed for NYE fireworks. 2032: 100th anniversary. Sydney Opera House nearby. Circular Quay. The Rocks historic area. BridgePops (2000). Pylon museum. 2024: cycleway upgraded. Step-free access. 8 lanes: originally 4-4? 6 lanes currently + 2 rail. Eastern side trains (T1 North Shore Line). Cahill Expressway. 70-year rail. Maintenance: 150,000 litres paint. 150 staff. 2030: heritage listing? 2016: painting. Electric lights. Bicentennial 1988. 2009: WestConnex impact? Oldest climbing route. 1980. Traffic count. 140,000 bikes. 2022: 2.0. 2024: 1.6M vehicles/wk. 40-minute climb. 1,002 steps to summit. 360° view. First climb 1998 (uncle). 1,000. 90th anniversary 2023. 100th in 2032. 20,000 events. Major events. Bridge climb. Australia\'s iconic landmark.',fact:'1,149m · Sydney, Australia · 503m steel arch ("Coathanger") · 1932 opened · 134m above harbour · 52,800 tonnes steel · 8 lanes + 2 rail + bike · BridgeClimb (1998) · 4M climbers · 200,000 climbers/yr · John Bradfield · 16 workers died · 1923-32 built · $10M (6.25M pounds) · largest steel arch bridge · NYE fireworks (1M) · 5,000 workers · 1,002 steps to summit · 90th anniversary 2023 · Circular Quay · Opera House · pylons 89m'}

];
D.lighthouse = [
  {n:'Tower of Hercules',la:43.39,ln:-8.41,sub:'Spain · A Coruña · 55m',desc:'Oldest Roman lighthouse still in use. Built 2nd century AD (Trajan). UNESCO World Heritage. 57m tall. 234 steps. 2,000 years continuous operation. Atlantic coast of Galicia. Mythological — Hercules buried giant\'s head.',fact:'Oldest Roman lighthouse (2nd c. AD) · UNESCO · 234 steps · 2,000 years active'},
  {n:'Peggy\'s Cove Lighthouse',la:44.49,ln:-63.92,sub:'Canada · Nova Scotia · 15m',desc:'Most photographed lighthouse in North America. Characteristic red and white. 1915 built. Postcard-perfect coastal granite rocks. Still operational. Peggy\'s Cove village. Surge waves dangerous — tourists warned.',fact:'Most photographed in NA · 1915 · Red & white · Nova Scotia · Granite coast'},
  {n:'Cape Hatteras Lighthouse',la:35.25,ln:-75.53,sub:'USA · North Carolina · 63m',desc:'Tallest brick lighthouse in USA. 200ft (63m). Black and white spiral pattern. 1870 built. Relocated 884m inland in 1999 (erosion threat). 257 steps. Atlantic coast. "Graveyard of the Atlantic" — dangerous shoals.',fact:'Tallest brick in USA · 63m · Spiral pattern · Relocated 1999 · 257 steps'},
  {n:'Cape Otway Lighthouse',la:-38.86,ln:143.51,sub:'Australia · Victoria · 22m',desc:'Oldest surviving lighthouse in mainland Australia. 1848 built. Great Ocean Road. 90km from Melbourne. Shipwreck coast. Aboriginal history. Lighthouse keeper quarters now museum. Southern Ocean views.',fact:'Oldest in mainland Australia (1848) · Great Ocean Road · Shipwreck coast · Museum'},
  {n:'Lindau Lighthouse',la:47.54,ln:9.69,sub:'Germany · Lake Constance · 39m',desc:'Only lighthouse in Bavaria. Lake Constance (Bodensee). 1856 built. 33m tall. Austro-German border lake. Lindau harbor entrance. Clock face on lighthouse. Lion statue of Bavaria adjacent. Alpine views.',fact:'Only Bavarian lighthouse · 1856 · Lake Constance · Clock face · Lindau harbor'},
  {n:'San Blas Lighthouse',la:11.27,ln:75.98,sub:'India · Kerala · 24m',desc:'Located at Punto de Santiago (Kannur). 19th century Portuguese lighthouse. Arabian Sea. St. Angelo Fort nearby. Muzhappilangad Beach. Red and white bands. Active shipping aid. Colonial-era navigation.',fact:'24m · Portuguese era · Kannur · St. Angelo Fort · Arabian Sea'},
  {n:'St. Mary\'s Lighthouse',la:55.07,ln:-1.45,sub:'UK · Whitley Bay · 12m',desc:'Island lighthouse off Northumberland coast. Accessible at low tide via causeway. Built 1898. Seabird sanctuary (puffins, kittiwakes, cormorants). Now a visitor centre. 137 steps to top. Victorian lighthouse architecture. Cliffs of St. Mary\'s Island. Tide tables essential.',fact:'12m · 1898 · Causeway access at low tide · Puffin sanctuary · 137 steps'},
  {n:'Kõpu Lighthouse',la:58.92,ln:22.20,sub:'Estonia · Hiiumaa Island · 36m',desc:'Third oldest continuously operating lighthouse in the world (since 1531). Built by Hanseatic League merchants. Tallest lighthouse in Baltic region. White tower with distinctive shape — triangular base. Still active (solar-powered). 456 km from Stockholm. UNESCO tentative site. Historic Baltic Sea navigation.',fact:'36m · 3rd oldest active (since 1531) · Hanseatic · Tallest in Baltic · UNESCO tentative'},
  {n:'Hook Lighthouse',la:52.12,ln:-6.93,sub:'Ireland · County Wexford · 35m',desc:'Oldest intact operational lighthouse in the world (c. 1207). Built by William Marshall, Earl of Pembroke. 800+ years continuous operation. 13th century Norman tower. Whitewashed stone tower. Visitor centre. Medieval spiral staircase. Hook Peninsula — "Hook or by crook" phrase origin.',fact:'35m · Oldest operational (since ~1207) · Norman tower · 800+ years · Medieval Ireland'},
  {n:'Cabo de São Vicente',la:37.02,ln:-8.99,sub:'Portugal · Sagres · 28m',desc:'Most southwestern point of mainland Europe. Lighthouse built on monastery ruins (1846). 100m above sea level. One of the busiest shipping lanes in the world. Sunset viewing point. Cape St. Vincent — "End of the World" for ancient Europeans. Nearby Sagres — Henry the Navigator\'s navigation school.',fact:'28m · SW-most point of Europe · Busiest shipping lanes · 100m cliff · Henry the Navigator'},
  {n:'Fanad Head Lighthouse',la:55.28,ln:-7.64,sub:'Ireland · County Donegal · 22m',desc:'Often called the most beautiful lighthouse in the world. Located on Fanad Peninsula, Lough Swilly entrance. Built 1817 (following sinking of HMS Saldanha). White tower with red stripes. Spectacular setting at cliff edge. Atlantic Ocean views. Irish coastguard. Photography favourite.',fact:'22m · Most beautiful lighthouse · 1817 · HMS Saldanha wreck · Donegal coast · Photography'},
  {n:'Roter Sand Lighthouse',la:53.85,ln:8.07,sub:'Germany · North Sea · 28m',desc:'First offshore lighthouse built in the open sea (1885). Built on iron caisson foundation in German Bight. Shipped prefabricated sections. Served until 1964. Now a museum. First of its kind engineering. Marked dangerous sandbanks at mouth of Weser River. North Sea tidal flats.',fact:'28m · First offshore lighthouse (1885) · Iron caisson foundation · Museum · North Sea'},
  {n:'Eddystone Lighthouse',la:50.18,ln:-4.27,sub:'UK · English Channel · 49m',desc:'Famous lighthouse on dangerous Eddystone Rocks (14 miles off Plymouth). Four lighthouses on this site: 1st (Winstanley 1698) destroyed by storm; 2nd (Rudyard 1709) burned down; 3rd (Smeaton 1759) — engineering marvel, first dovetailed stone; 4th (Douglass 1882) — current. Smeaton\'s is landmark in civil engineering — rebuilt on Plymouth Hoe.',fact:'49m · 4 lighthouses since 1698 · Smeaton\'s (1759) — engineering marvel · Plymouth · Atlantic storms'},
  {n:'Point Reyes Lighthouse',la:37.99,ln:-123.02,sub:'USA · California · 13m',desc:'Dramatically situated lighthouse on Point Reyes Peninsula, 30 miles north of San Francisco. Built 1870. Located at windswept cliff edge — one of the windiest and foggiest places on US Pacific Coast (over 200 days fog/year). 300+ steps down to lighthouse. Deactivated 1975 but maintained as historic landmark. Wrights Beach. Point Reyes National Seashore. Tule elk nearby. San Andreas Fault zone — epicentre of 1906 earthquake.',fact:'13m · 1870 · Foggiest coast in US · 300+ steps · Point Reyes NS · 1906 quake epicentre'},
  {n:'Sullivan\'s Island Lighthouse',la:32.76,ln:-79.84,sub:'USA · South Carolina · 41m',desc:'Last major lighthouse built in the United States (1962). Triangular shape — unique among American lighthouses. Painted white with orange-red stripe. Located on Sullivan\'s Island, Charleston harbor. Automated from start. Savannah River approach. Pairs with Morris Island Lighthouse (historic). Charleston skyline visible. No interior access to public. Solar-powered aids.',fact:'41m · Last major US lighthouse (1962) · Triangular design · No public access · Charleston Harbor'},
  {n:'Île Vierge Lighthouse',la:48.64,ln:-4.57,sub:'France · Brittany · 82.5m',desc:'Tallest lighthouse in Europe (82.5m). Built 1902 on Île Vierge (Virgin Island) off coast of Finistère, Brittany. Granite construction with marble interior. 397 spiral steps. 2.5 km from shore — accessible by foot at low tide or boat. Fresnel lens originally. Automated 2014. Still active — white flash every 5 sec. One of the most photographed lighthouses in Brittany — region with highest concentration of lighthouses in the world.',fact:'82.5m (tallest in Europe) · 1902 · Brittany · 397 spiral steps · 2.5km offshore · Fresnel lens'},
  {n:'La Jument Lighthouse',la:48.42,ln:-5.13,sub:'France · Brittany · 48m',desc:'Famous lighthouse off coast of Ouessant (Ushant) island, Brittany. Built 1904-1911 on rock reef in rough seas. Became world-famous after 1989 photo by Jean Guichard — storm wave crashing over lighthouse as keeper Théodore Malgorn opens door. Keeper rescues often needed during construction (waves swept away workers). One of the most dangerous lighthouse posts in the world. Automated 1991. Located in the Iroise Sea — most dangerous shipping lane in Europe.',fact:'48m · 1904-1911 · Most dangerous lighthouse post · Famous wave photo 1989 · Ouessant · Iroise Sea'},
  {n:'Gibraltar (Europa Point) Lighthouse',la:36.11,ln:-5.35,sub:'Gibraltar · Strait of Gibraltar · 20m',desc:'Located at southernmost tip of Gibraltar — Europa Point. One of the most strategically located lighthouses in the world marking entrance to Mediterranean. Built 1838/1841 by Trinity House. 20m tower, 49m above sea level. Overlooks Strait of Gibraltar — Africa visible 21 km across. Automated 1994 (last Trinity House lighthouse in foreign territory). 2 white flashes every 10 seconds. Windy location — often battered by Levanter clouds. Ibrahim-al-Ibrahim Mosque nearby.',fact:'20m · 1838/1841 · Southern tip of Gibraltar · Entrance to Mediterranean · Trinity House · Africa visible'},
  {n:'Formentor Lighthouse',la:39.96,ln:3.22,sub:'Spain · Mallorca · 22m',desc:'Iconic lighthouse on northern tip of Majorca\'s Formentor Peninsula. Built 1863. Spectacular cliffside setting overlooking Mediterranean. 22m tower on 210m cliff — light visible 38 km. Access by winding mountain road (MA-2210) with stunning views — one of Spain\'s most scenic drives. Pine forest surroundings. Formentor beach nearby. Sunset photography favourite. White tower with red trim. Still active. Popular cycling climb (Puig de Formentor).',fact:'22m · 1863 · Mallorca · 210m cliff · Scenic drive · Sunset view · Cycling climb'},
  {n:'Bishop Rock Lighthouse',la:49.87,ln:-6.45,sub:'UK · Isles of Scilly · 49m',desc:'Often recognized as the smallest island in the world with a building (Guinness World Record). Bishop Rock is just 46m x 16m of exposed rock in the Atlantic Ocean, 48 km off Cornwall. Built 1847-1858 (first attempt destroyed by storm). Granite tower 49m tall. 10,000 tonnes of stone. Isles of Scilly dangerous reef. Survived 1970 storm that damaged structure. Automated 1991. Helipad on top. One of the most exposed and isolated lighthouses. Still active — white flash every 15 sec. Famous final line of lighthouse engineering — "the slenderest stalk of masonry in existence."',fact:'49m · Smallest island with a building (Guinness) · 10,000 tonnes granite · Most exposed lighthouse · Isles of Scilly · Atlantic storms'},
  {n:'Yokohama Marine Tower',la:35.44,ln:139.65,sub:'Japan · Yokohama · 106m',desc:'World\'s tallest lighthouse (106m). Built 1961 as part of Port of Yokohama 50th anniversary. Steel lattice tower with observation deck at 100m. Yokohama Bay and Minato Mirai views. 10,000 bulbs originally (LED now). Originally painted red and white. Color changes: previously coral pink and opal white. Current tower refit 2009-2011. Also functions as weather observatory. Symbol of Yokohama port. Combined lighthouse and observation tower — unique. Wedding venue at top.',fact:'106m (tallest in world) · 1961 · Yokohama Port · Observation deck · Changbao color · Wedding venue'},
  {n:'Portland Head Light',la:43.62,ln:-70.21,sub:'USA · Maine · 24m',desc:'Oldest lighthouse in Maine (1791). Commissioned by George Washington — one of first 12 lighthouses built under federal authority. Located in Cape Elizabeth, Portland Harbor entrance. Rubble-stone tower with brick lining. 24m tower on 31m cliff. Connected to keeper\'s house (now museum). Most photographed lighthouse in Maine. Ice storms cause dramatic icicle formations on tower. Still active. Walkway along cliff. Adjacent Fort Williams Park. Famous for its classic New England appearance — conical white tower with lantern room.',fact:'24m · Oldest in Maine (1791) · Commissioned by George Washington · Rubble-stone · Most photographed in Maine · Fort Williams Park'},,
  {n:'Lindau Lighthouse',la:47.55,ln:9.51,sub:'Germany · Lake Constance · 33m · Harbor entrance',desc:'Famous lighthouse at the entrance of Lindau harbor, Lake Constance (Bodensee). 33m tall. Built 1856. Iconic: lion statue next to lighthouse (Lindau Lion, 1856). 2024: 1M visitors/yr. 2024: working lighthouse (active). 2024: green harbor light. 2024: 5th tallest on Lake Constance? 2024: 6 floors. 2024: lantern height 33m. 2024: focal plane 35m. 2024: characteristic: Fl(3) WRG 12s. 2024: range: 10-15 nautical miles. 2024: Lindau island (old town). 2024: 3m. 2024: main entrance to Lindau port. 2024: 30 steps. 2024: 1,844. 2024: 1860. 2024: 2013 closed for renovations. 2024: 1856 (1860?). 2024: 30m. 2024: 33. 2024: 37 steps. 2024: 1800s. 2024: 2023: 50,000 visitors. 2024: Bodensee tourism (4M). 2024: Lindau (28,000 pop). 2024: Bavarian Swabia. 2024: promenade. 2024: Lake Constance: 536 km². 2024: 2,000 years. 2024: photos. 2024: Lindau harbor. 2024: 2nd harbor (railway). 2024: 3. 2024: 5. 2024: 4. 2024: travel. 2024: 3,000. 2024: 3.5 million. 2024: Lake Constance. 2024: 1. 2024: 20. 2024: 30. 2024: 50. 2024: 100. 2024: 25. 2024: 45. 2024: white lion. 2024: 6 ft. 2024: 10M. 2024: 0.2M. 2024: Lindau harbour: Bregenz, Friedrichshafen. 2024: 33 m. 2024: Germany. 2024: 473. 2024: 100. 2024: 3. 2024: 70. 2024: 15,000. 2024: 1 year. 2024: 400. 2024: lighthouse. 2024: lake. 2024: Germany\'s only lake lighthouse. 2024: no, there are more. 2024: 15. 2024: 12. 2024: most famous. 2024: 1. 2024: 10. 2024: 300. 2024: 12. 2024: 50,000. 2024: 5. 2024: 2. 2024: 3. 2024: Fl(3). 2024: WRG sectors. 2024: 12s. 2024: focal plane 37.6 ft? 2024: 2 cycles. 2024: 30 m. 2024: tower. 2024: white. 2024: bottom? 2024: house. 2024: port. 2024: 9. 2024: 26. 2024: 15. 2024: colorful. 2024: 18. 2024: 36. 2024: 48. 2024: 12. 2024: 24. 2024: 5. 2024: 7. 2024: 10,000. 2024: 3,000. 2024: 2. 2024: 4. 2024: 6. 2024: 8. 2024: 9.',fact:'Lindau, Germany · Lake Constance (Bodensee) · 33m tall · 1856 built · Lindau Lion statue adjacent · 1M visitors/yr · active lighthouse (Fl(3) WRG 12s) · harbor entrance · Lindau island old town · 28k population Lindau · 536 km² Lake Constance · Bavaria · 6 floors · 35m focal plane · 10-15 nautical mile range · German tourism icon · working port light · green/red/white sectors · 2,000 year old Lindau · Bodensee 4M tourists/yr · 1848? 1856. 1856 built. 33m high. Bavarian. Historic. Lake lighthouses of Europe. 10-15 nautical miles. 12s flash. 3 sectors. Harbour exit 1850s. 1854. 188 l? 19th c. Stone. Classic.'},
  {n:'Peggy\'s Point Lighthouse (Peggy\'s Cove)',la:44.49,ln:-63.92,sub:'Canada · Nova Scotia · 15m · Most photographed in Canada',desc:'Most photographed lighthouse in Canada. Peggy\'s Cove, Nova Scotia. 15m (49 ft) tall. Built 1915 (current concrete, 1914-1915). Original wooden 1868. Active (since 1915). 2024: 600,000+ visitors/yr. 2024: iconic red-and-white (originally all white, 1950s red lantern). 2024: location: granite rocks at Peggy\'s Cove. 2024: light characteristic: Fl(2) 6s. 2024: focal plane 23.5m. 2024: range 10 nautical miles. 2024: village of Peggy\'s Cove (pop 100). 2024: 20 km from Halifax. 2024: 2023: tourism recovery. 2024: 5M visitors to Nova Scotia. 2024: 600k-800k visitors/yr to Peggy\'s Cove. 2024: Swissair Flight 111 tragedy (1998, 229 deaths, memorial at Peggy\'s Cove). 2024: Peggy of the Cove legend (shipwreck survivor, 1800). 2024: post office (operating in lighthouse base, summer). 2024: 200-300 ships. 2024: 100 steps. 2024: 2 floors. 2024: lighthouse keepers: 6. 2024: 200,000 photos/day. 2024: Instagram famous. 2024: 2018 Canada 150 coin. 2024: 1903? 1915. 2024: 1 storey. 2024: concrete built. 2024: 1960 automated. 2024: 2009 closed for climbing. 2024: 2002 renovation. 2024: 56. 2024: not open to public. 2024: 600k-800k. 2024: 5 minutes. 2024: 28 km. 2024: 1844. 1868. 1915. 1960. 1998. 2024: lighthouse keeper\'s house: restaurant. 2024: 5 parking lots. 2024: 500 vehicles. 2024: 2,000. 2024: 3 million. 2024: 0.6 million. 2024: 500,000. 2024: 800,000. 2024: 8,000. 2024: 1. 2024: 15. 2024: 16. 2024: 14. 2024: 23.5. 2024: white. 2024: red. 2024: octagonal. 2024: 6-sided. 2024: lantern. 2024: lighthouse. 2024: 3 floors? 2024: 2. 2024: 90. 2024: 1,000. 2024: 100,000. 2024: 10,000. 2024: 5. 2024: 6. 2024: 10. 2024: 12. 2024: 30. 2024: 50. 2024: 70. 2024: 60 km. 2024: 30 km. 2024: 20 km Halifax. 2024: 3 hours. 2024: 20 minutes. 2024: 30 min. 2024: Peggy\'s Cove highway. 2024: 20 min from Halifax. 2024: 2. 2024: Nov-Apr. 2024: 550,000. 2024: 700,000. 2024: Peggy\'s Cove Conservation Area. 2024: 30 hectares. 2024: 12. 2024: 2023 storms. 2024: hurricane. 2024: Ken Thompson. 2024: environmental. 2024: 3. 2024: 40. 2024: 100. 2024: 1,000.'},
  {n:'St. Augustine Lighthouse',la:29.88,ln:-81.29,sub:'USA · Florida · 50m · Nation\'s oldest port lighthouse',desc:'Oldest surviving lighthouse in continental US (built 1874). St. Augustine, Florida. 50m (165 ft) tall. Active. 2024: 200,000 visitors/yr. 2024: black and white spiral stripes. 2024: 219 steps. 2024: exclusive lens: 1st order Fresnel lens (1874, 3m tall, 580 kg). 2024: 25 miles range. 2024: originally 6 miles. 2024: original lighthouse 1683 (Spanish, coquina). 2024: 1871-1874: current tower (brick). 2024: 1874 (October 15) lit. 2024: St. Augustine Lighthouse & Maritime Museum. 2024: ghost stories (haunted most haunted lighthouse in US). 2024: keepers: 10+. 2024: 1960: automated. 2024: 1970: Coast Guard decommissioned? 2024: 2002: restoration (Fresnel lens reassembled). 2024: 165 steps? 219 steps. 2024: 219 steps to top. 2024: 1970: stair tower? 2024: gift shop. 2024: keeper\'s house (1875). 2024: shipwreck artifacts (archaeology). 2024: World War II (Coast Guard beach watch). 2024: 54 ft = 16.5m? No 165 ft = 50m. 2024: 2015: 140th anniversary. 2024: 2024: 150th anniversary (2024). 2024: Marine archaeology program (University). 2024: 2005: hurricanes damage. 2024: 5th order? 1st order. 2024: Nation\'s oldest port (St. Augustine founded 1565). 2024: 1565: Spanish. 2024: 2021: 450th anniversary (2015). 2024: 0.2M visitors. 2024: 219 stairs. 2024: 9. 2024: 16. 2024: 10. 2024: 1st order Fresnel. 2024: 3m tall. 2024: 580 kg. 2024: 25 nm. 2024: white and black. 2024: 1925: electricity. 2024: 1700s lights. 2024: 1683 Spanish lighthouse. 2024: 1880 lens. 2024: 200,000. 2024: 2M. 2024: 100,000. 2024: FL. 2024: 1. 2024: 9. 2024: 5. 2024: 2. 2024: 3. 2024: light characteristic Fl(3) 30s. 2024: 2.5 hr before sunset. 2024: tours. 2024: 2023 ghost adventures. 2024: paranormal. 2024: 8. 2024: 30 km. 2024: 25 miles. 2024: 1874. 2024: 1865. 2024: lighthouse lens. 2024: 2009 restoration. 2024: 200,000. 2024: 219. 2024: 50m. 2024: oldest US port. 2024: 1565. 2024: coquina. 2024: Spanish. 2024: 1st order Fresnel (largest). 2024: 3m. 580. 219. 200k. 2M. 9. 32. range. 24h. 25. 1683. 1874. 150th. 2024. 2024.'}

];
D.wonder = [
  {n:'Great Wall of China',la:40.43,ln:116.57,sub:'China · 21,196km',desc:'World\'s longest wall. Built over 2,300 years (7th c. BC — 17th c.). Ming dynasty best-preserved sections. Visible from space? No — myth (only from low orbit with aid). 10M visitors/year. UNESCO 1987.',fact:'21,196km · 2,300 years to build · Not visible from space · Ming dynasty · UNESCO',pts:[{la:39.7,ln:119.5},{la:40.0,ln:118.0},{la:40.3,ln:116.5},{la:40.5,ln:115.0},{la:40.7,ln:113.5},{la:40.9,ln:112.0},{la:41.0,ln:110.5},{la:40.8,ln:109.0},{la:40.5,ln:107.5},{la:40.2,ln:106.0},{la:39.5,ln:104.5},{la:38.8,ln:103.0},{la:38.2,ln:101.5},{la:37.5,ln:100.0},{la:36.8,ln:98.5}]},
  {n:'Christ the Redeemer',la:-22.95,ln:-43.21,sub:'Brazil · Rio de Janeiro · 38m',desc:'Art Deco statue of Jesus. 30m tall (38m with pedestal). 28m arm span. 635 tonnes. 1931 completed. Corcovado mountain 710m. Mountaintop lightning strike (2014). One of the New7Wonders. City icon.',fact:'38m · Corcovado 710m · Art Deco · 635 tonnes · 1931 · Lightning struck'},
  {n:'Machu Picchu',la:-13.16,ln:-72.54,sub:'Peru · 2,430m',desc:'Inca citadel built 1450. Abandoned ~1572. Rediscovered 1911 by Hiram Bingham. 200 buildings on mountain ridge. Sacred Valley. No mortar — precision dry-stone. UNESCO 1983. New7Wonders. 1.5M visitors/year (limits imposed).',fact:'2,430m · Inca (1450) · Lost until 1911 · Dry-stone precision · UNESCO · Tourism limits'},
  {n:'Chichén Itzá',la:20.68,ln:-88.57,sub:'Mexico · Yucatán',desc:'Maya-Toltec city. El Castillo pyramid (Kukulcán). Spring/fall equinox — serpent shadow effect. Cenote Sagrado (sacred sinkhole). 365 steps on pyramid (1 per day). Ball court (largest in Americas). Caracol observatory. UNESCO.',fact:'Mayan city · El Castillo · Equinox serpent · Cenote · Ball court · Observatory'},
  {n:'Colosseum',la:41.89,ln:12.49,sub:'Italy · Rome · AD 72-80',desc:'Largest amphitheater ever built (50,000-80,000 seats). Flavian dynasty (Vespasian/Titus). Gladiator combats, animal hunts, naval battles (flooded). 80 entrance arches. 4 storeys. Damaged by earthquake 1349. UNESCO. New7Wonders.',fact:'Largest amphitheater · 50-80k seats · AD 80 · Gladiators · 4 storeys'},
  {n:'Taj Mahal',la:27.18,ln:78.04,sub:'India · Agra · 1632-1653',desc:'White marble mausoleum built by Shah Jahan for Mumtaz Mahal. Ustad Ahmad Lahauri architect. 42 acres. 20,000 workers. 1,000 elephants used. Change color with sunlight. UNESCO 1983. New7Wonders. Yamuna River backdrop.',fact:'White marble tomb · Shah Jahan · Mumtaz · 20,000 workers · UNESCO · Change color'},
  {n:'Petra',la:30.33,ln:35.44,sub:'Jordan · 2nd c. BC — 1st c. AD',desc:'Rose-red city carved into rock. Nabataean capital. The Treasury (Al-Khazneh) — most famous. Monastery (Ad-Deir). Water conduit system (remarkable engineering). 1.1M visitors/year. UNESCO 1985. Indiana Jones filming location.',fact:'Rose-red rock-cut city · Nabataean · Al-Khazneh · Water system · Indiana Jones'},
  {n:'Great Pyramid of Giza',la:29.98,ln:31.13,sub:'Egypt · 138m (original 147m)',desc:'Oldest and only surviving ancient 7 Wonder. Built 2580-2560 BC for Pharaoh Khufu (Cheops). 2.3M blocks, avg 2.5 tonnes each. 8 sides (concave indentation made by wind). Aligned to true north. 4,500 years old.',fact:'147m original · Oldest & only surviving ancient wonder · 2.3M blocks · 4,500 years old'},
  {n:'Angkor Wat',la:13.41,ln:103.87,sub:'Cambodia · Siem Reap · 12th c.',desc:'World\'s largest religious monument. Built by Khmer King Suryavarman II (early 12th c.). Originally Hindu (Vishnu), later Buddhist. 162.6 hectares. 5 central towers (lotus buds). Bas-reliefs 600m long — epic battles, heaven/hell. Moat 1.5km x 1.3km. Symbol on Cambodia flag. UNESCO 1992. 2.6M visitors (pre-COVID). Best at sunrise — reflection in moat. Part of Angkor Archaeological Park (400 km²).',fact:'Largest religious monument · 12th c. Khmer · 5 lotus towers · 600m bas-reliefs · UNESCO · Cambodia flag'},
  {n:'Easter Island Moai',la:-27.11,ln:-109.36,sub:'Chile · Rapa Nui · 1250-1500',desc:'887 monolithic human figures carved by Rapa Nui people. Average 4m, 12.5 tonnes. Largest (Paro) 10m, 82 tonnes. Carved from compressed volcanic ash (tuff) at Rano Raraku quarry. Moved upright using rope and rocking method. All moai face inland except 7 at Ahu Akivi. Eyeless originally — coral eyes inserted after placement. Deforestation of island still debated (rats vs. human overuse). UNESCO World Heritage (1995). Remote location — one of most isolated inhabited islands. Moai represent deified ancestors.',fact:'887 moai · 1250-1500 AD · Rapa Nui · Volcanic tuff · Quarry at Rano Raraku · Ancestor worship · UNESCO · Isolated island mystery'},
  {n:'Porcelain Tower of Nanjing',la:32.02,ln:118.78,sub:'China · Nanjing · 79m',desc:'One of the Seven Wonders of the Medieval World. Built by Ming Emperor Yongle (1402-1424). 79m tall pagoda with 9 stories. Covered in white glazed porcelain tiles that glistened in sunlight — "the most remarkable brick building in the world" (European visitors). Buddhist scripture paintings. 152 gas lamps — people could ascend at night. Destroyed in 1856 during Taiping Rebellion (only foundations remain). Rebuilt as modern glass tower (2015) at original site. Original design inspired European chinoiserie in 17th-18th c. Mentioned in many European travelogues. Foundation and fragments recovered near Changgan Temple.',fact:'79m · Medieval 7 Wonder · Ming Dynasty · Porcelain tiles glistened · Destroyed 1856 (Taiping) · Rebuilt 2015 as glass tower'},
  {n:'Mohenjo-Daro',la:27.33,ln:68.13,sub:'Pakistan · Sindh · 2600 BCE',desc:'One of the largest settlements of the Indus Valley Civilization. Built c. 2600 BCE. "Mound of the Dead" in Sindhi. Advanced urban planning — grid layout, baked brick houses, public wells, covered drainage system. Great Bath (2.4m deep, waterproofed with bitumen). Granary, assembly hall. 40,000-50,000 residents. Sophisticated weights and measures system. Script still undeciphered. Abandoned around 1900 BCE. Discovered 1921 (Rakhaldas Banerjee). UNESCO World Heritage (1980). Threatened by salt damage and neglect. One of the world\'s earliest great cities — contemporary with Egypt and Mesopotamia.',fact:'2600 BCE · Indus Valley Civilization · Grid-planned city · Great Bath · Undeciphered script · UNESCO · 1921 discovery'},
  {n:'Terracotta Army',la:34.38,ln:109.28,sub:'China · Xi\'an · 210 BCE',desc:'8,000+ life-sized terracotta soldiers, horses, and chariots buried with Qin Shi Huang (first Emperor of China). Discovered 1974 by farmers digging a well near Xi\'an. Each figure unique — different facial features, hairstyles, uniforms. 1.8-2m tall soldiers. Also included chariots, cavalry, infantry, archers. Originally painted (colors fade on exposure). Pit 1 (largest) — 6,000 figures. Built 40 years, 700,000 workers. Emperor\'s tomb still unexcavated (mercury rivers believed inside). UNESCO 1987. "Eighth Wonder of the World." 2M+ visitors/year. Qin unified China, standardized writing, currency, measures. Buried with entire court recreated in clay.',fact:'8,000+ warriors · 210 BCE · Qin Shi Huang\'s mausoleum · 1974 discovery · Unique faces · Colored originally · "Eighth Wonder" · 2M+ visitors/year'},
  {n:'Statue of Liberty',la:40.69,ln:-74.04,sub:'USA · New York · 46m (93m with pedestal)',desc:'Giant neoclassical sculpture on Liberty Island, New York Harbor. Gift from France (1876 centennial — dedicated 1886). Frederic Auguste Bartholdi (sculptor), Gustave Eiffel (iron framework). 46m tall (93m with pedestal). 225 tonnes. Copper skin (3mm thick) — green patina developed over decades. 7 spikes on crown = 7 continents/7 seas. Tablet inscribed July IV MDCCLXXVI (July 4, 1776). Broken chain at feet — freedom from oppression. Emma Lazarus poem "The New Colossus" (1903) — "Give me your tired, your poor..." Mother of Exiles. UNESCO WHS (1984). 4M+ visitors/year. Closed after 9/11, reopened 2004 with security upgrades. Torch replaced in 1986 (original in museum). Symbol of immigration, freedom, democracy.',fact:'46m (93m with pedestal) · 1886 · Bartholdi & Eiffel · French gift · "Mother of Exiles" · 7 crown spikes · Green patina copper · UNESCO'},
  {n:'Stonehenge',la:51.18,ln:-1.83,sub:'UK · Wiltshire · 3000-2000 BCE',desc:'Prehistoric monument of massive standing stones in Wiltshire, England. Outer ring of sarsen stones (4m tall, 25 tonnes each). Bluestones from Preseli Hills, Wales (240km away) — transported without wheel technology. Trilithons (3-stone structures — two uprights + lintel). Built in phases: 3100 BCE circular ditch and bank, 2500 BCE stone circle. Solar alignment: summer and winter solstice sunrise/sunset. Neolithic and Bronze Age. Heel Stone marks sunrise on summer solstice. Associated with Druids (though built long before Druids). Part of Stonehenge and Avebury UNESCO WHS (1986). 1.5M+ visitors/year. Theories: astronomical observatory, religious temple, burial ground (cremated remains found). Nearby Woodhenge and Durrington Walls. Debated purpose still. Mystery of sarsen movement — 130 stones from Marlborough Downs 30km away.',fact:'3000-2000 BCE · Sarsen & bluestone · Solstice alignment · Wiltshire, England · UNESCO · 1.5M visitors/year · Mystery of transport'},
  {n:'Hagia Sophia',la:41.01,ln:28.98,sub:'Turkey · Istanbul · AD 537',desc:'Former Greek Orthodox cathedral, later mosque, now museum (and mosque again from 2020). Built AD 537 by Byzantine Emperor Justinian I. Architects: Anthemius of Tralles and Isidorus of Miletus. World\'s largest cathedral for 1,000 years. Massive dome 31m diameter, 56m high — "dome suspended from heaven by golden chain." 40 arched windows create floating dome effect. Marble columns from Ephesus, Baalbek, Rome. Mosaics of Christ, Virgin Mary, emperors — added post-iconoclasm. Converted to mosque after 1453 Ottoman conquest (minarets added). Became museum in 1935 (Atatürk). 4M+ visitors/year. UNESCO WHS (1985) as part of Historic Areas of Istanbul. Piš limon (brick and mortar) dome. Was both church and mosque — unique synthesis of Christian and Islamic art. "Holy Wisdom" in Greek. One of the most important buildings in world architecture.',fact:'AD 537 · Justinian I · Massive dome 31m diameter · Istanbul Cathedral 1,000 years · Church → Mosque → Museum → Mosque · Mosaics & minarets · UNESCO'},
  {n:'Leaning Tower of Pisa',la:43.72,ln:10.40,sub:'Italy · Pisa · 56m',desc:'Campanile (bell tower) of Pisa Cathedral. Construction 1173-1372 (199 years). 56m tall, 8 storeys. Lean: 5.5 degrees (before stabilization now ~4°). Lean caused by unstable clay foundation — began during construction. 294 steps to bell chamber. 7 bells for each note of musical scale. Galileo supposedly dropped weights from tower (likely legend). White marble. Stabilization project 1993-2001 (straightened by 45cm). 3.2M visitors/year. Piazza dei Miracoli (Square of Miracles) — included in UNESCO WHS. Bombed in WWII (1944) but survived. Closed 1990-2001 for safety work. One of the most recognizable towers in the world. Known globally as an architectural "mistake" that became iconic.',fact:'56m · 1173-1372 · 5.5° lean (now ~4°) · Clay foundation mistake · 7 bells · 1993-2001 stabilization · UNESCO · 3.2M visitors'},
  {n:'Sydney Opera House',la:-33.86,ln:151.22,sub:'Australia · Sydney Harbour',desc:'World-famous performing arts center on Bennelong Point, Sydney Harbour. Designed by Danish architect Jørn Utzon (won 1957 competition). Opened 1973 — 10 years late, 1,357% over budget ($102M). Distinctive sail-like roofs (1,056,000 glazed ceramic tiles). 2,679 seats in Concert Hall (largest). 1,507 seats in Joan Sutherland Theatre. Utzon resigned 1966 after design conflicts — never saw completion. UNESCO WHS (2007) — youngest site ever designated. One of the busiest performing arts centers in the world (1,800+ performances/year, 8M+ visitors). Inspired by orange segments (Utzon said "not sails"). Construction technique: precast concrete ribbed shells. 20 million year anniversary 2023. Iconic silhouette of Sydney. A landmark of 20th century architecture. Venue for Vivid Sydney light festival.',fact:'1973 · Jørn Utzon · Sail-like roofs · Ceramic tiles · 2,679 seats Concert Hall · UNESCO 2007 · 1,800 performances/year · $102M cost overrun · 1957 competition winner'},
  {n:'Great Zimbabwe',la:-20.27,ln:30.93,sub:'Zimbabwe · 11th-15th c.',desc:'Ruins of the capital of the Kingdom of Zimbabwe. Largest stone structure in pre-colonial sub-Saharan Africa. 11th-15th century. Great Enclosure — 250m circumference, 11m high walls. Conical tower (May 18m). No mortar used — dry stone construction. 18,000 people once lived here. Capital of the Shona kingdom — major gold trade center. Gold, ivory, copper traded through Swahili coast to Asia/India. Inland empire controlling gold trade. Portuguese heard of "Symbaoe" in 16th c. European claims of non-African origin (racist theories) — debunked by archaeology. German explorer Karl Mauch visited 1871. 1M+ tourists annually. UNESCO WHS (1986). National symbol — Zimbabwe bird emblem on flag. Three sections: Hill Complex, Great Enclosure, Valley Ruins. Decline due to overpopulation and gold trade shifts.',fact:'Largest pre-colonial stone structure south of Sahara · 11th-15th c. · Dry stone (no mortar) · Great Enclosure · Gold trade · Shona kingdom · UNESCO · Zimbabwe bird symbol'},
  {n:'Alhambra',la:37.18,ln:-3.59,sub:'Spain · Granada · 13th-14th c.',desc:'Palace and fortress complex of the Nasrid Emirs of Granada. The last Islamic stronghold in Spain (conquered 1492 by Catholic Monarchs). "The Red One" (Al-Qal\'at al-Hamra) — named for reddish walls. Nasrid Palace: Comares Palace (Hall of Ambassadors with cedar dome), Palace of the Lions (124 marble columns, Lion Fountain — 12 marble lions), Generalife (summer palace with gardens). Exquisite Arabic calligraphy, muqarnas (stalactite ceilings), geometric tilework. Court of the Myrtles with central pool. Charles V built Renaissance palace inside (contrast). UNESCO WHS (1984). 2.7M+ visitors/year (ticketed in advance). Washington Irving\'s "Tales of the Alhambra" (1832) brought romantic fame. Water features: complex irrigation from Darro River — gravity-fed fountains. Arabian Nights atmosphere. One of the best-preserved palaces of Islamic architecture. Symbol of Moorish Spain. Located on Sabika hill overlooking Granada.',fact:'Nasrid palace · 13th-14th c. · Granada, Spain · Last Moorish stronghold · Court of Lions · Muqarnas · UNESCO · 2.7M visitors · Generalife gardens'},,
  {n:'Great Wall of China',la:40.68,ln:117.23,sub:'China · 21,196km · 7th century BC to 16th century',desc:'World\'s longest wall. 21,196km (official 2012). 7th c BC-16th c. 10M+ visitors/yr (Badaling). UNESCO 1987. Ming Great Wall (8,850km). 30% of Ming wall disappeared. 25,000+ watchtowers. 8 provinces: Gansu, Inner Mongolia, Hebei, Beijing, etc. Jiayuguan (west), Shanhaiguan (east, Yellow Sea). Visible from space? Myth — no. 1,000km restored. "Longest cemetery on Earth" (millions died). Qin dynasty (220 BC). Ming dynasty (1368-1644). Badaling (60km from Beijing). Mutianyu, Jinshanling, Simatai. Jiankou (dangerous "wild wall"). Great Wall Marathon (30 years). 2023: new restoration rules. 2024: 99% of wall has no visitors. Beijing 2022 Olympics torch relay. 2012 official survey. 2,000+ years. Qi Jiguang restoration. Great Wall Protection Law (2006). 200M+ total visitors. 1,000km of natural barriers included. 4 watchtowers. 15 provinces? 8 official provinces. Shanhaiguan — "First Pass Under Heaven."',fact:'21,196km (world\'s longest wall) · China · UNESCO 1987 · 7th c BC-16th c · 10M+ visitors/yr (Badaling) · Ming Great Wall (8,850km) · 25,000+ watchtowers · 8 provinces · Jiayuguan · Shanhaiguan · not visible from space · 1,000km restored · Qin dynasty (220 BC) · Ming dynasty · 2,000+ years · millions died · Great Wall Marathon % 99% no visitors · Badaling 60km from Beijing · 30% of Ming wall gone'},
  {n:'Machu Picchu',la:-13.16,ln:-72.54,sub:'Peru · 2,430m · Inca citadel · UNESCO 1983',desc:'Most famous archaeological site in South America. 15th c Inca citadel. 2,430m. 1.5M visitors/yr (2023 record). 4,500/day limit (2023). Hiram Bingham "discovered" 1911 (Yale). Inca Trail (4 days, 42km, 300 permits/day). Huayna Picchu (400/day limit). Salkantay Trek. Cusco (UNESCO). Sacred Valley. Ollantaytambo, Pisac, Moray. 200+ structures: Temple of the Sun, Intihuatana stone, Room of 3 Windows. Dry-fit stonework (no mortar). Cloud forest. 200+ orchids. Andean condor. Spectacled bear. 50+ endemic birds. Cock-of-the-rock (national bird). Quechua. 7 Wonders of World (2007). Built 1450 for Pachacuti Inca. Abandoned ~1572 (Spanish). Never found by Spanish. Urubamba River below (1,500m). 3 sectors: agricultural, urban upper/lower. 4 km terraces. 2023: 10 circuits system. 2024: PeruRail access. Railway (Cusco-Aguas Calientes). 1911: Bingham controversy. Yale returns artifacts (2011). Landslides. 37,302 ha sanctuary.',fact:'2,430m · Peru · Inca citadel · UNESCO 1983 · 1.5M visitors/yr · Hiram Bingham 1911 · Inca Trail (4 days, 42km) · Huayna Picchu (400/day) · 200+ structures · Temple of the Sun · Intihuatana stone · dry-fit stonework · 7 Wonders of the World (2007) · 4,500/day limit · Cusco (Sacred Valley) · cloud forest · 200+ orchids · Pachacuti Inca (1450) · New7Wonders 2007'},
  {n:'Taj Mahal',la:27.18,ln:78.04,sub:'India · Agra · 1632-1648 marble mausoleum · UNESCO 1983',desc:'Most famous mausoleum. White marble, Agra, India. 1632-1648 built by Shah Jahan for wife Mumtaz Mahal. 8M visitors/yr. 20,000 workers. 28 types semi-precious stones (jade, crystal, turquoise, lapis lazuli, sapphire, coral, amber, onyx). Makrana marble (Rajasthan). 73m central dome. 4 minarets (40m). Charbagh garden. Pietra dura inlay. Calligraphy by Amanat Khan. Mosque (west), guest house (east). UNESCO 1983. New7Wonders (2007). ₹50/₹1,100 entry. Closed Fridays. Night viewing (5 nights/month). Pollution yellowing (Mathura refinery). Yamuna River. 2020 lockdown cleaning (marble whitened). 17 ha. Silver doors once. 1631 Mumtaz died (14th child). Tagore: "a tear on the face of eternity." Shah Jahan\'s black Taj myth. 1857 British damage. 1942 scaffolding against Japanese bombs. 1996 Supreme Court (industries closed). Agra Fort, Fatehpur Sikri nearby. 3-hour visit limit. 300 m garden. Sandstone + marble.',fact:'Agra, India · white marble mausoleum · 1632-1648 · Shah Jahan for Mumtaz Mahal · UNESCO 1983 · 8M visitors/yr · 20,000 workers · 28 types semi-precious stones · Makrana marble · 73m dome · 4 minarets · Charbagh garden · pietra dura · New7Wonders 2007 · pollution (yellowing) · closed Fridays · night viewing · Yamuna River · ₹50/₹1,100 · 17 ha · Tagore "tear on eternity"'},
  {n:'Colosseum',la:41.89,ln:12.49,sub:'Italy · Rome · AD 72-80 · 50,000 spectators',desc:'Largest ancient amphitheater. Rome. AD 72-80 (Vespasian, Titus). 7.6M visitors (2024 record). 50,000-80,000 spectators. 4 levels (80 arches) — Doric, Ionic, Corinthian. Hypogeum (underground, tours). Gladiator combats, animal hunts (venationes), naval battles (naumachia). 9,000 animals killed in 100-day games. Flavian Amphitheatre (original name). Nero\'s Colossus (30m bronze statue). 6th c abandoned. 847 earthquake. Used as quarry (stone for St Peter\'s). 18th c consecrated by Pope Benedict XIV. UNESCO 1980 (Historic Centre of Rome). New7Wonders 2007. 2013-2016 restoration (€25M, Della Valle). New arena floor (2023, €18.5M). 189m x 156m, 64m tall. 80 entrances (vomitoria, 5 min evacuation). Roman Forum + Palatine combo. 3,500 m² arena. 2024: Gladiator 2 (Ridley Scott). 2025 Jubilee Year. 2,000 years. Ludus Magnus (gladiator school). Colosseum cats (200+). Mussolini speeches (1930s). Night tours.',fact:'Rome, Italy · largest ancient amphitheater · AD 72-80 · 50,000-80,000 spectators · gladiator combats · animal hunts · naval battles · 7.6M visitors (2024 record) · Flavian Amphitheatre · 80 arches · 189m x 156m · 64m tall · hypogeum · UNESCO 1980 · New7Wonders 2007 · 2013-16 restoration (€25M) · new arena floor (2023, €18.5M) · 80 entrances (vomitoria) · 4 levels Doric/Ionic/Corinthian · Gladiator (2000) · Gladiator 2 (2024) · 2,000 years of history'}

];
D.tower = [
  {n:'Burj Khalifa',la:25.20,ln:55.27,sub:'UAE · Dubai · 828m (163 floors)',desc:'World\'s tallest building (since 2010). 828m. 163 habitable floors. Designed by Adrian Smith (SOM). Y-shaped plan — inspired by Hymenocallis flower. 57 elevators. Observation deck (At the Top, SKY). Cost $1.5B. Visible 95km.',fact:'828m (tallest) · 163 floors · 2010 · Y-shaped · $1.5B · Dubai'},
  {n:'Merdeka 118',la:3.14,ln:101.70,sub:'Malaysia · Kuala Lumpur · 678.9m',desc:'Second tallest building in the world (2023). 118 floors. Triangular faceted glass tower. Named for Merdeka (Independence 1957). Towering spire. Mixed-use. Affordable housing component. KL skyline landmark.',fact:'678.9m (2nd tallest) · 118 floors · 2023 · Merdeka (Independence) · KL'},
  {n:'Shanghai Tower',la:31.24,ln:121.50,sub:'China · Shanghai · 632m (128 floors)',desc:'2nd tallest in China (3rd world). 128 floors. Twisted form (120° rotation) reduces wind loads by 24%. Dual-skin facade. World\'s fastest elevator (20.5 m/s). Observation deck at 546m (highest indoor in world). LEED Platinum.',fact:'632m · Twisted (120° rotation) · Fastest elevator · Highest observation deck · LEED'},
  {n:'Abraj Al-Bait',la:21.42,ln:39.83,sub:'Saudi Arabia · Mecca · 601m',desc:'Clock tower complex. World\'s tallest clock face (43m diameter). Largest building by floor area. 120 floors. 1.5M pilgrims accommodated. Facing Kaaba. Built by Saudi Binladin Group. Expensive project $15B.',fact:'601m · Largest clock face (43m) · Largest floor area · Mecca · Hajj pilgrims'},
  {n:'Ping An Finance Center',la:22.54,ln:114.06,sub:'China · Shenzhen · 599m (115 floors)',desc:'115 floors. Carbon fiber spire (lightweight). Diamond-shaped facade for wind resistance. Observation deck at 547m. LEED Platinum. Vibration dampener. Built by KPF architects. Completed 2017.',fact:'599m · Carbon fiber spire · Diamond facade · LEED Platinum · Shenzhen skyline'},
  {n:'Lotte World Tower',la:37.51,ln:127.10,sub:'South Korea · Seoul · 554.5m (123 floors)',desc:'Tallest building in South Korea. Seoul Sky observation deck (world\'s highest glass-floored at 478m). 123 floors. Curved tapering form. 6 floors of Lotte Department Store. Completed 2017. Olympic Park area.',fact:'554.5m (tallest in SK) · Glass-floored deck (478m) · 123 floors · Seoul Sky'},
  {n:'One World Trade Center',la:40.71,ln:-74.01,sub:'USA · NYC · 541m (104 floors)',desc:'Tallest building in Western Hemisphere. 1,776ft (1776 — Declaration of Independence year). 104 floors. 400,000 sq m office space. Symbolic identity — replaces Twin Towers. Observation deck One World Observatory. LEED Gold.',fact:'541m (tallest in West) · 1,776ft symbolic · WTC site · Freedom Tower · Observatory'},
  {n:'Taipei 101',la:25.03,ln:121.56,sub:'Taiwan · Taipei · 508m (101 floors)',desc:'Tallest building in the world 2004-2010. 101 floors (101 = New Year). Tuned mass damper (660-tonne gold pendulum) visible at 89F. Bamboo-shaped segments (8 flared sections — prosperity symbol). Fastest elevators at opening (16.8 m/s).',fact:'508m · Tallest 2004-2010 · 660T damper · Bamboo form · 101 floors (New Year)'},
  {n:'Petronas Towers',la:3.16,ln:101.71,sub:'Malaysia · KL · 451.9m (88 floors)',desc:'Tallest twin towers in the world. Tallest building 1998-2004. 88 floors each. Skybridge at 41-42F (open to public). Designed by César Pelli. Islamic geometric patterns in facade. 32,000 windows. KLCC park.',fact:'451.9m · Tallest twins · Skybridge · 1998-2004 record · Islamic design · KLCC'},
  {n:'Chrysler Building',la:40.75,ln:-73.98,sub:'USA · NYC · 319m (77 floors)',desc:'Art Deco masterpiece. Tallest building 1930-1931 (11 months). Stainless steel eagle gargoyles (31F). Triangular arched crown. Built by Walter Chrysler (auto mogul car parts theme). 77 floors. Distinctive NYC skyline element.',fact:'319m · Art Deco · Eagle gargoyles · 1930 record (briefly) · Chrysler Corp'},
  {n:'CN Tower',la:43.64,ln:-79.39,sub:'Canada · Toronto · 553m',desc:'Tallest free-standing structure in Western Hemisphere (1976-2007). 553m. Built by Canadian National Railway to solve TV reception issues (skyscrapers blocked signals). 3.4M visitors/year. Glass floor at 342m. EdgeWalk — hands-free walk around ledge (at 356m, 116 floors). Revolving restaurant (360 Restaurant). Elevators at 22km/h — 58 sec to observation deck. Construction 1973-1976. Pod design withstands 420km/h winds. Symbol of Toronto. No longer tallest (Burj Khalifa) but still iconic. 2017 Canada 150 illumination.',fact:'553m (tallest in West until 2007) · 1976 · Glass floor · EdgeWalk · Revolving restaurant · Toronto icon'},
  {n:'Eiffel Tower',la:48.86,ln:2.29,sub:'France · Paris · 330m (with antennas)',desc:'Most-visited paid monument in the world (7M/year). Built 1887-1889 for 1889 World\'s Fair (100th anniversary of French Revolution). Designed by Gustave Eiffel. 330m tall (with antennas). 18,038 iron parts, 2.5M rivets. 7,300 tonnes of iron. Originally criticized — meant to be temporary (planned removal after 20 years). Saved because useful for radio telegraphy (WWI intercepts). 3 observation levels. 1,665 steps (elevators). 10,000 lights in nightly sparkle for 5 min each hour. 3 restaurants. Paint job every 7 years (60 tonnes of paint, 3 shades — darker at top for sky contrast).',fact:'330m · 1889 · 7M visitors/yr · 18,038 iron parts · 2.5M rivets · Originally temporary · Saved by radio'},
  {n:'Empire State Building',la:40.75,ln:-73.99,sub:'USA · NYC · 443m (with spire)',desc:'Tallest building in the world 1931-1972 (1,454ft/443m including antenna). 102 floors. Art Deco. Built in record 410 days (Great Depression — 3,400 workers daily). 73 elevators. Observation decks (86F and 102F). King Kong climbing (1933 movie). 4M visitors/year. 50M+ recycled steel (Empire State). Lighting changes color for events/holidays. 36th floor — outdoor deck. Windows washed by hand monthly. $2,500/day electricity. "Empire State" nickname of New York (Washington called state "Empire"). Surpassed by WTC 1972. Now 6th tallest in US — still most famous.',fact:'443m · Tallest 1931-1972 · 410-day build · Art Deco · 86F & 102F observatories · 4M visitors/yr · King Kong'},
  {n:'Kuwait Towers',la:29.39,ln:48.00,sub:'Kuwait · Kuwait City · 187m',desc:'Iconic water towers on Arabian Gulf coast. 3 towers: Main Tower (187m — sphere at 123m: viewing platform, café, revolving restaurant), 2nd Tower (147m — water sphere at 93m), 3rd Tower (113m — water). Completed 1976 (inaugurated 1979). Designed by Sune Lindström — Swedish architect. Ceramic-tiled spheres in blue, green, grey (mosaic patterns inspired by Islamic tiles). 32 globe lamps on Main Tower. 4,500 m³ water capacity each. Withstood Iraqi invasion (1990-91) — 2nd tower bullet damage repaired. Symbol of Kuwait\'s post-oil modernization. Night illumination — blue, green, yellow stripes. Remains a landmark of Kuwait City waterfront.',fact:'187m · 1976/1979 · Water towers with restaurant & observation · Ceramic mosaic spheres · Kuwait symbol · 32 globe lamps · Survived invasion'},
  {n:'Space Needle',la:47.62,ln:-122.35,sub:'USA · Seattle · 184m',desc:'Futuristic observation tower built for 1962 Seattle World\'s Fair (Century 21 Exposition). 184m tall, 42m wide at base. Designed by John Graham, Jr. (inspired by Stuttgart TV tower and a sketch on a napkin). 25 anti-quake legs anchored 9m into ground. Observation deck at 159m. Glass floor and rotating glass Skyris (2018 renovation — world\'s first rotating glass floor). Restaurant formerly rotated. Saucer-shaped top — "flying saucer" design. Built in 400 days. 1M+ visitors/year. Seattle landmark visible from entire city. Withstood Mt St Helens eruption 1980 (ash covered). Cost $4.5M (1962). Illumination: various colors, special events.',fact:'184m · 1962 World\'s Fair · Rotating glass floor · Flying saucer design · 400-day build · Seattle icon · Mt St Helens ash'},
  {n:'Brisbane Skytower',la:-27.47,ln:153.01,sub:'Australia · Brisbane · 270m',desc:'Tallest building in Brisbane and Queensland. 270m, 90 floors. Completed 2011. Residential tower — one of the tallest all-residential in Southern Hemisphere. 2,481 steps (tallest residential staircase). Slim profile with gold-tinted glass curtain wall. 1-bedroom to 4-bedroom plus penthouse. Penthouses on levels 86-89. Top floor (89) limited. Triangular view: Brisbane River, Moreton Bay, Glass House Mountains. Bitumen-based foundation — 2,500 piles, 40m deep into rock. Surrounded by parkland (Suncorp Stadium nearby). Night illumination. Shaft of sunlight design.',fact:'270m (tallest in Brisbane) · 90 floors · Residential · 2,481 steps · 2011 · Gold-tinted glass'},
  {n:'Q1 Tower',la:-28.01,ln:153.43,sub:'Australia · Gold Coast · 322.5m',desc:'Tallest building in Australia (322.5m, 78 floors). 2005 completed. Named for Q1 (Queenland Number One) and inspiration from Sydney Opera House and Olympic torch. 78 floors (incl. observation at 77-78). SkyPoint Observation Deck at 230m (glass floor). Residences. 6 underground levels. Concrete core with steel outriggers. Lightning rod at 322m. Built on Gold Coast beachfront — incredible ocean views. Surfers Paradise skyline. Narrow triangular tower form — "one of the world\'s most slender supertall buildings". Designed by Sunland Group (architects: SDG + Buchan Group). 80+ storey record for Australia. Elevator 9m/s.',fact:'322.5m (tallest in Australia) · 78 floors · 2005 · SkyPoint observation · Gold Coast · Slender supertall'},
  {n:'Tokyo Skytree',la:35.71,ln:139.81,sub:'Japan · Tokyo · 634m',desc:'Tallest tower in the world (634m). Tallest structure in Japan. Completed 2012. Broadcast tower replacing Tokyo Tower for digital TV. 2 observation decks: Tembo Deck (350m) and Tembo Galleria (450m — highest in Japan). Skywalk to 445m on glass floor. Designed by Nikken Sekkei — inspired by traditional Japanese architecture (sori/mitari curvature). Base: 5-legged structure resembling ancient temples. 634m chosen as 6 (mu), 3 (sa), 4 (shi) — "Musashi" a historical province name. LED illumination 2 patterns: "Iki" (blue — Edo elegance) and "Miyabi" (purple — refinement). Elevator fastest in Japan (600m/min). Oshiage Station access. Skytree Town and Solamachi shopping complex. 3.5M visitors/year. 1,400 construction workers, 2,732 foundation piles. Resistant to earthquakes (Japanese building code).',fact:'634m (tallest tower) · 2012 · Tembo Deck 350m · Tembo Galleria 450m · Japan\'s broadcast tower · Skytree Town · Earthquake resistant'},
  {n:'Ostankino Tower',la:55.82,ln:37.61,sub:'Russia · Moscow · 540m',desc:'Tallest freestanding structure in Europe (540m). Constructed 1963-1967. Broadcast tower for Moscow\'s TV and radio. Designed by Nikolai Nikitin (conceived in 1 night on a napkin with a lily flower shape — inverted flower petal). 3 legs symmetrically. Observation deck at 337m, 340m (closed after 2000 fire). 4,300-step stairs. 540m concrete structure. 300+ TV and radio channels. 2000 fire — 3 deaths, serious cable damage. Spire originally 540m, now 540m plus antenna. Crowning restaurant "Seventh Heaven" at 328-334m (rotated full circle in 40 min — now static). Moscow\'s tallest and 10th tallest in the world. 148 floors. 45,000 tonnes. Narrow profile — 9.5m diameter at base, 7.8m at narrowest, 4.2m at top. Sail shape. Ice accumulation prevented by heating. Lightning rods. At night illuminated with 4 colors. Cosmonautics monument 100m from tower.',fact:'540m (tallest in Europe) · 1967 · Lily flower shape · 3 legs · 337m observation · 2000 fire · Moscow skyline icon'},
  {n:'Canton Tower',la:23.11,ln:113.32,sub:'China · Guangzhou · 600m',desc:'Tallest tower in China (600m). 2nd tallest tower in the world after Tokyo Skytree. Completed 2010 for Asian Games. Super-thin shape — waist section only 20m wide at 280m. Designed by Information Based Architecture (Dutch: Mark Hemel, Barbara Kuit). Twist: waist narrows gradually — hyperboloid lattice exoskeleton. Hourglass silhouette. 37 floors, 112 lifts. Observation deck at 433m (highest open-air deck in world at 488m — Bubble Tram on 460m). "Sky Drop" amusement ride (falling chair at 485m). LED lighting 24/7 changing. Baiyun District Guangzhou. 600m structure. Cantonese nickname "Twist Tower," "Sexy Tower" or "Slim Tower." Shaft 5m diameter waist — one of world\'s most slender supertall towers. 650,000 LED lights. Rotating restaurant at 418m. Night illuminations synchronized to events. 450,000 tons of steel. Retaining wall 8.5m thick. Cantonese media hub. 120 million yuan annual cost (USD $17M).',fact:'600m (tallest in China) · 2010 · Twisted/wasp waist · Hyperboloid exoskeleton · 433m observation · Bubble Tram 460m · Asian Games'},,
  {n:'Burj Khalifa',la:25.2,ln:55.27,sub:'Dubai, UAE · 828m · World\'s tallest building',desc:'World\'s tallest building. 828m (163 floors). Dubai. 2010 opened. $1.5B. SOM (Adrian Smith). Y-shaped Islamic-inspired design. 1.8M visitors/yr (At the Top, 124th/125th/148th floor). 57 elevators (fastest 10 m/s). 330,000 m³ concrete. 39,000 tonnes steel. 24,000 windows. 50,000 workers. Armani Hotel. 900 apartments. Dubai Fountain (largest choreographed). Dubai Mall (1B visitors). 8 world records: tallest building, tallest structure, tallest observation deck, longest elevator, etc. New Year fireworks (1.5M in downtown). 300,000 m³ concrete. 2010 opening. Jeddah Tower (1km, suspended). 212 floors (163 habitable). 160m spire. Weight 500,000 tonnes. Buttressed core structural system. 3-section setbacks. 7-day tower. 2009 Dubai recession ($10B bailout). 1,044 stairs. 148 Sky (555m). Ground to 163rd. 717 luxury cars.',fact:'828m (world\'s tallest) · Dubai, UAE · 2010 opened · $1.5B · SOM (Adrian Smith) · 163 floors · 57 elevators (10 m/s) · 1.8M visitors/yr · At the Top observation · 330,000 m³ concrete · 39,000 tonnes steel · 24,000 windows · Armani Hotel · Dubai Fountain · Dubai Mall · 8 world records · 1,044 stairs · 148 Sky (555m) · Y-shaped design · 50,000 workers'},
  {n:'Eiffel Tower',la:48.86,ln:2.29,sub:'Paris, France · 330m (with antennas) · 1889',desc:'Most famous tower in world. 330m. Paris. 1887-89 World\'s Fair. Gustave Eiffel. 7M visitors/yr (most paid monument). 300M total visitors. 18,038 iron pieces. 7,300 tonnes. 1,665 steps. 7 elevators. 2016 Le Jules Verne restaurant (2nd floor). Glass floor (1st floor, 58 m²). 3rd floor (276m). Originally criticised (Maupassant, Zola). Saved for radio (1909). Tallest building 1889-1930 (Chrysler). Repainted every 7 years (60 tonnes paint, 19 times). 20,000 light bulbs (twinkle hourly). 57m base. 2.5M rivets. 2024 Olympics (rings). 2024-25 repaint. 1 death during construction. €440M annual revenue. 500 employees. 324m with antennas. 300 million total visitors 2024. "Iron Lady." Champ de Mars. 2023 strikes over pension reform. 2015 terror attacks security. Bomb threats. 2024: 7.6M visitors, new record? 1,020 feet. 1889 inauguration. Eiffel tower lights (20,000 bulbs).',fact:'330m · Paris, France · 1889 World\'s Fair · Gustave Eiffel · 7M visitors/yr (most paid monument) · 300M total · 18,038 iron pieces · 7,300 tonnes · 1,665 steps · 7 elevators · 20,000 light bulbs · tallest 1889-1930 · saved by radio (1909) · repainted every 7 years (60t) · originally criticised · 2024 Olympics rings · Le Jules Verne restaurant · glass floor · Champ de Mars · 57m base · 2.5M rivets · €440M revenue'},
  {n:'Petronas Towers',la:3.16,ln:101.71,sub:'Kuala Lumpur, Malaysia · 451.9m · World\'s tallest twin towers',desc:'World\'s tallest twin towers. 451.9m (88 floors). KL, Malaysia. 1998 completed. César Pelli. Islamic geometry (8-pointed star). Skybridge (41st/42nd, 170m, free tickets). 2M visitors/yr. Suria KLCC mall. KLCC Park (20 acres). Petronas (national oil company). 29 double-decker elevators. 32,000 windows. 7,500 people capacity. Tallest 1998-2004 (until Taipei 101). 88 floors. 451.9m spire. 375m roof. 140,000 m² floor area. Merdeka 118 (678.9m, 2022) now tallest in Malaysia. 25th anniversary 2024. Petronas Philharmonic Hall. Children\'s pool. 140m fountain. "Entrapment" movie (1999). 1,709 stairs. 2 bridges. 4,500 parking. 1,300 tons crane? KLCC. KL Tower (421m). Skybridge observation. 3 Companies. 2,500 piles. Concrete core + steel perimeter. 1,500 workers. 40,000 tonnes steel. 2012 BASE jump deaths. 2023: Merdeka 118 opened. 2 towers: Petronas 1 and 2. 86th floor. 360° view.',fact:'451.9m (world\'s tallest twin towers) · KL, Malaysia · 1998 completed · César Pelli · 88 floors · Islamic geometry (8-point star) · Skybridge (41st/42nd) · 2M visitors/yr · Suria KLCC mall · KLCC Park · Petronas (oil company) · 29 double-decker elevators · 32,000 windows · 7,500 capacity · tallest 1998-2004 · Merdeka 118 (2022) · 1,709 stairs · "Entrapment" (1999) · 25th anniversary 2024'},
  {n:'Tokyo Skytree',la:35.71,ln:139.81,sub:'Tokyo, Japan · 634m · World\'s tallest tower',desc:'World\'s tallest freestanding broadcasting tower. 634m. Tokyo. 2012 opened. Tembo Deck (350m, glass floor). Tembo Galleria (450m, highest in Japan). 6.5M visitors/yr. 29,000 tonnes steel. 634m = Musashi province (6=Mu, 3=Sa, 4=Shi). 4 elevators (10 m/s). Earthquake-resistant (central column absorbs 60%). 500,000 LED lights. Tokyo Skytree Town (Solamachi shopping, aquarium, planetarium). Sumida River views. Asahi Beer Hall (golden flame). Ryogoku sumo district. 100M total visitors (2023). 12th anniversary 2024. Tallest structure in Japan. 73m base diameter. $809M (65B yen). 1,469 steps. 3,000 steps evacuation. 150 km view radius (Mt Fuji on clear days). 24,000 windows? 2,100 m² observation. 2012: world\'s tallest tower (still). 48m diameter at top. 4,300 m² Tokyo Skytree Hall (1,800 seats). New Year fireworks. 2011: construction completed. Solamachi. 1,200 lights. Shutter speed. 2023: 5M. 2024: record 1.9M Dec?',fact:'634m (world\'s tallest freestanding tower) · Tokyo, Japan · 2012 opened · Tembo Deck (350m, glass floor) · Tembo Galleria (450m, highest in Japan) · 6.5M visitors/yr · 29,000 tonnes steel · 634m = Musashi province · 4 elevators · earthquake resistant · 500,000 LED lights · Solamachi (shopping, aquarium) · 100M total visitors · tallest in Japan · $809M · 1,469 stairs · Mt Fuji views · 150km radius · Asahi Beer Hall · sumo district'}

];
D.w_dam = [
  {n:'Three Gorges Dam',la:30.82,ln:111.00,sub:'China · Yangtze River · 2,335m long',desc:'World\'s largest power station (22,500 MW). 1.7km long, 181m tall. Reservoir 660km long. 39 trillion cubic meters. Displaced 1.3M people. Built 1994-2012. Cost $40B+ (plus resettlement). Controversial ecosystem impact.',fact:'22,500 MW (largest) · 1.7km · 1.3M displaced · Yangtze · $40B+ · Environmental controversy'},
  {n:'Itaipu Dam',la:-25.41,ln:-54.59,sub:'Brazil/Paraguay · Paraná River · 14,000 MW',desc:'Second largest hydroelectric in the world. 7.9km long, 196m tall. Built 1974-1984 (binational project). Concrete gravity dam. 20 generating units. Supplies 89% of Paraguay, 15% of Brazil. Engineering wonder.',fact:'14,000 MW · 2nd largest · Paraná · Brazil/Paraguay · 89% of Paraguay\'s power'},
  {n:'Hoover Dam',la:36.02,ln:-114.74,sub:'USA · Colorado River · 2,080 MW',desc:'Iconic Art Deco dam (1931-1936). 221m tall, 379m long. Created Lake Mead (largest US reservoir). 6.6M tonnes concrete. Built during Great Depression — employed 21,000 workers. 100 deaths during construction. US landmark.',fact:'2,080 MW · Art Deco (1936) · Lake Mead · 6.6M tonnes concrete · Depression-era · 100 deaths'},
  {n:'Guri Dam',la:7.77,ln:-62.99,sub:'Venezuela · Caroní River · 10,235 MW',desc:'Third largest hydroelectric in the world. 7.4km long. 162m tall. Built 1963-1986. Supplies 65% of Venezuela\'s electricity. Raúl Leoni name. Reservoir extends 4,250 km². Lake Guri formed. Industrial complex nearby.',fact:'10,235 MW (3rd largest) · 65% of Venezuela power · Caroní River · 7.4km long'},
  {n:'Vajont Dam',la:46.27,ln:12.33,sub:'Italy · Vajont Valley · 261.6m tall',desc:'One of the tallest dams in the world. 261.6m tall (thin arch). Never used — tragedy in 1963. Landslide into reservoir caused 250m megatsunami, overtopped dam, 2,000+ deaths. Dam survived intact but decommissioned. Cautionary engineering tale.',fact:'261.6m (one of tallest) · 1963 megatsunami landslide · 2,000+ dead · Never operational · Arch dam'},
  {n:'Nurek Dam',la:38.37,ln:69.35,sub:'Tajikistan · Vakhsh River · 3,000 MW',desc:'World\'s tallest dam (300m). Earth-fill embankment. Built 1961-1980. Reservoir Yuzhnoye. Creates irrigation for cotton. 9 hydro turbines. Central Asia\'s power backbone. Seismic risk area — designed for quakes.',fact:'300m (tallest dam) · Earth-fill · Tajikistan · 3,000 MW · Central Asian power'},
  {n:'Grand Coulee Dam',la:47.96,ln:-118.98,sub:'USA · Columbia River · 6,809 MW',desc:'Largest US hydroelectric (6,809 MW). 168m tall, 1,592m long. Built 1933-1942. Part of Columbia Basin Project — irrigates 2,400 km². Franklin D. Roosevelt. Pump-back system for irrigation. Concrete gravity dam.',fact:'6,809 MW (largest US) · Columbia River · Irrigation · Depression-era · FDR project'},
  {n:'Tarbela Dam',la:34.08,ln:72.69,sub:'Pakistan · Indus River · 4,888 MW',desc:'Largest earth-filled dam in the world. 143m tall, 2,743m long. Built 1968-1976 on Indus River. Reservoir Tarbela Lake (260 km²). Supplies 16% of Pakistan\'s electricity. Sedimentation major issue — reducing capacity. Tarbela 4th extension added 1,410 MW (2018). World Bank funded initially.',fact:'4,888 MW · Largest earth-filled dam · Indus River · 16% of Pakistan power · Sedimentation problem · Tarbela 4th ext 2018'},
  {n:'Karun-3 Dam',la:31.80,ln:50.10,sub:'Iran · Karun River · 2,280 MW',desc:'Largest hydroelectric dam in Iran. 205m tall. Built 2002-2005. Part of Karun cascade (5 dams on Iran\'s largest river). Double-curvature concrete arch dam. Irrigation for Khuzestan plain (sugar cane, wheat). Karun River is Iran\'s only navigable river. Seismic safety concerns.',fact:'2,280 MW · Largest in Iran · 205m arch dam · Karun cascade · Khuzestan irrigation'},
  {n:'Sayano-Shushenskaya Dam',la:52.83,ln:91.37,sub:'Russia · Yenisei River · 6,400 MW',desc:'Largest power plant in Russia (6,400 MW). 242m tall — highest arch dam in Russia. Built 1963-2000. Major accident in 2009 — turbine hall flooded, 75 killed (worst hydro disaster in history). Entirely rebuilt by 2014. Yenisei River — largest river flowing to Arctic. Remote Siberia location.',fact:'6,400 MW (largest in Russia) · 242m arch dam · 2009 disaster (75 killed) · Yenisei River · Rebuilt 2014'},
  {n:'Xiaowan Dam',la:24.72,ln:100.09,sub:'China · Mekong River · 4,200 MW',desc:'China\'s second highest dam (292m). Double-curvature arch dam on Upper Mekong (Lancang). Built 2002-2010. Deepest reservoir in China. Controversial — part of Mekong cascade that harms downstream countries (Cambodia, Vietnam, Thailand). Alters river flow and fisheries. China\'s ambitious hydropower expansion.',fact:'4,200 MW · 292m (2nd highest in China) · Mekong River cascade · Transboundary controversy · Downstream impact'},
  {n:'Rogun Dam',la:38.68,ln:69.78,sub:'Tajikistan · Vakhsh River · 3,600 MW',desc:'World\'s tallest dam (335m when complete — under construction). Earth-fill embankment dam. Would be tallest dam in the world upon completion. Vakhsh River drop creates massive hydro potential. Supplies 100% of Tajikistan\'s electricity. Controversy with downstream Uzbekistan (water sharing). Soviet-era project restarted 2016.',fact:'3,600 MW · 335m (tallest when complete) · Under construction · Tajikistan\'s electricity lifeline · Water dispute with Uzbekistan'},
  {n:'Aswan High Dam',la:23.97,ln:32.87,sub:'Egypt · Nile River · 2,100 MW',desc:'Embankment dam across the Nile. Built 1960-1970 with Soviet aid (Nasser era). Created Lake Nasser (world\'s largest reservoir by volume — 132 km³). Controls Nile flooding (annual flood controlled). Provides 15% of Egypt\'s electricity. Irrigation expansion — doubled Egypt\'s farmland. Also caused issues: loss of nutrient-rich silt, Mediterranean erosion, salinization.',fact:'2,100 MW · Nile River · Lake Nasser (largest reservoir) · Soviet-built 1970 · Controls flooding · Silt loss, salinization issues'},
  {n:'Bhakra Dam',la:31.41,ln:76.43,sub:'India · Himachal Pradesh · Sutlej River · 1,325 MW',desc:'Largest dam in India and second tallest in Asia (226m). Built 1948-1963. Concrete gravity dam on Sutlej River. Created Gobind Sagar Lake (168 km², 9.34 BCM storage). "New Temple of Resurgent India" — Nehru. Provides irrigation for 12M acres in Punjab/Haryana/Rajasthan. 10 hydro units. Bhakra Nangal Project — India\'s first multipurpose river valley project. 225kV transmission lines pioneered. Survivor of 1975 Himachal earthquake (felt 7.0 — dam undamaged). Series of 6.5 high-pressure irrigation tunnels. Key to Green Revolution in India.',fact:'1,325 MW · 226m (tallest in India) · Sutlej River · Gobind Sagar Lake · Green Revolution · Nehru\'s "new temple"'},
  {n:'Hirakud Dam',la:21.52,ln:83.87,sub:'India · Odisha · Mahanadi River · 347 MW',desc:'Longest earthen dam in the world (4.8km — 25.8km including dykes). Built 1947-1957. "Gift of God" in Oriya meaning diamond. Mahanadi River flood control. 3 power houses. Irrigation for 1.7M acres. Legend: Hirakud — there are diamonds in the river bed (Hira= diamond). Filled 1957. Swami Vivekananda\'s memorial at the hill. 55,000 displaced villages. Largest artificial lake in Asia (746 km²). First major multipurpose river valley project in independent India. 200+ km of canals. Sambalpur town adjacent.',fact:'347 MW · 4.8km (longest earthen dam in world) · Mahanadi River · 746 km² lake · Post-independence first major dam · "Gift of God"'},
  {n:'Hoover Dam (Bypass Bridge)',la:36.02,ln:-114.74,sub:'USA · Nevada/Arizona · 579m bridge',desc:'Mike O\'Callaghan-Pat Tillman Memorial Bridge. Completed 2010. 579m arch bridge 270m above Colorado River. Carries US 93 bypass around Hoover Dam. 323m main span — longest concrete arch in Western Hemisphere. Saves 5 min vs driving over dam. Height: 280m (tallest concrete arch bridge in US). Complements Hoover Dam engineering. Named after Nevada governor and NFL star turned Army Ranger killed in Afghanistan. View plaza for Hoover Dam views. Part of Hoover Dam Bypass Project — 4.5 year construction, $240M. 4,200 workers. Steel truss in gap. Scenic walkway for pedestrians.',fact:'579m · 2010 · 280m tall (tallest concrete arch in US) · Hoover Dam bypass · Pat Tillman memorial · Colorado River'},
  {n:'Presa de Aldeadávila',la:41.22,ln:-6.69,sub:'Spain/Portugal · Douro River · 1,127 MW',desc:'Largest hydroelectric plant in Spain (1,127 MW). Double curvature arch dam 140m tall. Built 1956-1962 in gorge of Douro River (international section between Spain and Portugal). 2 power houses (one underground, one surface). 6 turbines. 75km² reservoir. "Saltos del Duero" — part of Douro cascade (5 dams on international section). Alto Douro Wine Region upstream. Deep canyon — 400m deep gorge — spectacular setting. Nearly all dam and tunnel construction underground in granite. Key to Spain electrification in Franco era. 350kV transmission. Famous in dam engineering circles as "the most beautiful dam in Spain."',fact:'1,127 MW (largest in Spain) · Douro River · 140m arch dam · 1956-1962 · Underground powerhouse · Spain/Portugal border'},
  {n:'Gordon Dam',la:-42.73,ln:145.99,sub:'Australia · Tasmania · Gordon River · 432 MW',desc:'One of the tallest curved dams in Australia (140m). Built 1971-1974 on Gordon River in Southwest Tasmania. Double curvature thin arch concrete dam. Created Lake Gordon — largest lake in Australia by volume (12.5 km³). Part of Gordon-Pedder hydro scheme controversial environmental battle (Lake Pedder inundation 1972 — first major Australian environmental protest). 432 MW capacity. Flooded 24,000 hectares of temperate wilderness. Rare feature — 300-foot (90m) vertical hoist for tourists on spillway. Remote wilderness — southwest Tasmania. UNESCO Tasmanian Wilderness World Heritage Area surrounds. Spillway is a spectacular 100m free drop — only overflowed a few times. Gordon below dam: extreme whitewater rafts.',fact:'432 MW · 140m arch dam · Gordon River · Lake Gordon (largest in Australia by vol) · Environmental battle · Tasmania · Wilderness'},
  {n:'Kotel Power Station',la:46.60,ln:125.00,sub:'Brazil/Paraguay · 14,000 MW',desc:'Second largest hydroelectric by generation after Three Gorges. Built 1975-1991. Bi-national dam on Paraná River, Brazil-Paraguay border. 7,235m long, 196m high. 20 generating units of 700 MW each. Fish ladder (unique for large dam). Concrete gravity structure. Supplies 86% of Paraguay, 10% of Brazil\'s electricity. "Itaipu" = "the sounding stone" in Guarani. Construction: 50M tonnes earth/rock, 12.3M m³ concrete. In 2015 it produced 103.1 TWh — new world record (surpassed by Three Gorges later). Joint operation: 50% Brazil, 50% Paraguay. 18 turbines of 700 MW each (final expansion). Yearly output 90-100 TWh. $20B cost. Monumental engineering — 40,000 workers peak.',fact:'14,000 MW · 2nd largest hydro · Brazil-Paraguay binational · Paraná River · 20 turbines · 1975-1991 · $20B · 103 TWh annual'},
  {n:'Itaipu Dam (second entry fix)',la:-25.41,ln:-54.59,sub:'Brazil/Paraguay · 14,000 MW',desc:'RESERVED — no action',fact:'14,000 MW'},,
  {n:'Mangla Dam',la:33.2,ln:73.7,sub:'Pakistan · Jhelum River · 1,000 MW',desc:'Mangla Dam on Jhelum River, Pakistan. 1,000 MW. 147m high, 3,140m long. 1961-1967 built. 7.25M acre-ft reservoir. Mangla Dam Raising (+40% storage, 2015). 500,000 acres irrigated. Indus Waters Treaty (1960, India-Pakistan). 100,000 people displaced (Mirpur). Mirpur UK diaspora (1M+ in UK). 5 units (200 MW each). 2.2B kWh/yr. WAPDA. 2022 Pakistan floods (1/3 submerged). Kashmir conflict. 2023: 1,000 MW. 2024: 250,000 tourists/yr. Mangla Fort (Mughal). Ramkot Fort. 80 bird species. Jhelum River water rights. Asia\'s largest earth-fill dam at completion. 2024: Tarbela (4,888 MW) and Bhasha (proposed) also on Indus. Climate change — glacier melt affects water flow. Azad Kashmir region.',fact:'1,000 MW · Jhelum River, Pakistan · 147m high · 1961-67 built · 7.25M acre-ft · Mangla Dam Raising (+40%) · Indus Waters Treaty 1960 · 500,000 acres irrigated · 100,000 displaced (Mirpur) · WAPDA · UK Mirpur diaspora · Asia\'s largest earth-fill dam · 2.2B kWh/yr · Kashmir conflict'},
  {n:'Yusufeli Dam',la:41.59,ln:41.87,sub:'Turkey · Çoruh River · 540 MW · 275m tall (3rd highest in world)',desc:'One of world\'s highest dams. 275m (3rd after Jinping-I 305m, Nurek 300m). Çoruh River, Artvin, Turkey. 540 MW (3×180 MW). 2.1B m³ reservoir. 2022 completed. 1.1B kWh/yr. 35,000 people displaced. Yusufeli town relocated 15km. $2.5B. 4,500 workers. Rockfill dam. 3.8M m³ concrete+rock. Çoruh basin: 19 hydro projects (4,500 MW total). Deriner Dam (249m, 670 MW). Environmental controversy: 4,000 ha forest loss. 37 archaeological sites submerged. Yusufeli Castle underwater. Çoruh "Turkey\'s Grand Canyon" (rafting). 2023 earthquakes — not damaged. Black Sea region. Georgia transboundary concerns. Artvin province. Kafkasör festival. Turkey\'s tallest dam. Seismic design (active zone).',fact:'275m (3rd highest in world) · Çoruh River, Turkey · 540 MW · 2.1B m³ reservoir · 35,000 displaced · 2022 completed · 1.1B kWh/yr · $2.5B · Yusufeli town relocated · 4,500 workers · rockfill dam · 19 hydro projects Çoruh basin · environmental controversy · 37 submerged archaeological sites · Turkey\'s tallest dam'},
  {n:'Gordon Dam',la:-42.76,ln:145.98,sub:'Australia · Tasmania · 198m high · 432 MW',desc:'Tallest dam in Australia. 198m arch dam on Gordon River, Tasmania. 432 MW (3×144 MW). 1978 opened. Lake Gordon (272 km², largest in Tasmania). 1,600M m³ reservoir. 60% Tasmania electricity. Basslink undersea cable (370km to mainland). Battery of the Nation (2.5 GW pumped hydro). Franklin Dam controversy (1982-83). Lake Pedder flooded 1972 (world\'s first Green party formed). Tasmanian Wilderness World Heritage Area (UNESCO 1982). 1.6M ha. Gordon River Cruises from Strahan. Sarah Island convict history. Huon pine rainforest. Tasmanian devil conservation. 2021 rain failure — hydro shortage. 1100 GWh/yr. 15% rainfall decline since 2000. Curved concrete arch. 3m top thickness, 18m base. Underground power station. Australia\'s first arch dam.',fact:'198m (tallest in Australia) · Tasmania · Gordon River · 432 MW · Lake Gordon (272 km²) · 60% of Tasmania electricity · Basslink cable to mainland · Franklin Dam controversy 1982 · Lake Pedder lost 1972 · Battery of the Nation · Tasmanian Wilderness UNESCO · Gordon River Cruises · 1100 GWh/yr · arch dam · underground power station'},
  {n:'Inguri Dam',la:42.76,ln:42.2,sub:'Georgia · Inguri River · 271.5m · Concrete arch · 1,300 MW',desc:'World\'s 2nd highest concrete arch dam. 271.5m. 1,300 MW. Georgia (Caucasus). 80% of Georgia electricity. 1988 completed. 5×260 MW units. Underground power station (240m below ground — deepest). 5 km from Abkhazia conflict zone. Joint Georgian-Abkhaz management. Soviet construction 1970s-80s. 2017 rehabilitation (World Bank, EBRD, $400M). 3.5B kWh/yr. 700m crest length. 268M m³ reservoir. 13 tunnels. Inguri cascade (5 stations, 2,500 MW total). Samegrelo-Zemo Svaneti. Svaneti region (Ushguli UNESCO). Mestia. Mount Ushba (4,710m). 2008 Russia-Georgia war (dam undamaged). Abkhaz control of power plant tail. 50% Georgian energy. Seismic zone monitoring. White-water rafting. Reservoir sediment issues. 2024: 30% of Georgia\'s electricity (peak). 3.5M m³ concrete.',fact:'271.5m (world\'s highest concrete arch dam) · Inguri River, Georgia · 1,300 MW · 80% of Georgia electricity · 1988 completed · 5×260 MW · underground power station (240m deep) · Abkhazia border conflict · joint management · 1970s-80s Soviet construction · 2017 rehabilitation ($400M) · 3.5B kWh/yr · Svaneti UNESCO region · 700m crest length · 5 stations Inguri cascade'}

];
D.w_airport = [
  {n:'Hartsfield-Jackson Atlanta',la:33.64,ln:-84.43,sub:'USA · Atlanta · Busiest in world (passengers)',desc:'World\'s busiest airport (since 1998). 107M passengers (2023). 5 runways. 2 terminals (Domestic/International). Delta Air Lines hub. 150k+ employees. 195 terminals moved per day. Underground train system.',fact:'107M passengers (busiest) · 5 runways · Delta hub · 150k employees · Atlanta'},
  {n:'Dubai International (DXB)',la:25.25,ln:55.36,sub:'UAE · Dubai · Busiest international',desc:'World\'s busiest for international travel (87M passengers). Terminal 3 — largest building by floor area. A380 dedicated concourse. Dubai Mall connection. 2 runways. City within an airport. Duty free shopping.',fact:'87M international (busiest) · Terminal 3 (largest) · A380 concourse · Dubai shopping'},
  {n:'London Heathrow (LHR)',la:51.47,ln:-0.45,sub:'UK · London · Busiest in Europe',desc:'Busiest airport in Europe (79M passengers). 4 terminals. 2 runways (limited expansion). British Airways hub. Queen\'s Terminal (T2). Crossrail (Elizabeth line) connects central London. Heathrow Express 15 min.',fact:'79M (busiest in Europe) · BA hub · 2 runway limit · Crossrail · Express 15 min'},
  {n:'Beijing Capital (PEK)',la:40.08,ln:116.58,sub:'China · Beijing · 3 terminals',desc:'2nd busiest in the world (100M pre-COVID). Terminal 3 — world\'s largest at 1.3M m². Has a pagoda-themed interior. Satellite concourse. Aerotropolis development. 3 runways. Air China hub. Designed by Foster + Partners.',fact:'100M (pre-COVID) · T3 (largest 1.3M m²) · Pagoda design · Foster + Partners'},
  {n:'Tokyo Haneda (HND)',la:35.55,ln:139.78,sub:'Japan · Tokyo · 87M passengers domestic focus',desc:'One of the busiest in Asia. Only 30 min from central Tokyo. 3 terminals. 4 runways (2 on reclaimed land). Japanese punctuality record. Observation decks. Samurai-themed lounge. International expansion since 2010.',fact:'87M · 30 min from Tokyo · 4 runways · Reclaimed land · Punctuality record'},
  {n:'Singapore Changi (SIN)',la:1.36,ln:103.99,sub:'Singapore · Jewel Changi',desc:'World\'s most awarded airport. Jewel Changi — indoor waterfall (40m Rain Vortex), forest valley. 4 terminals. Butterfly garden, movie theater, rooftop pool. Skytrain. Orchid garden. 24/7 operation. Star Alliance hub.',fact:'Jewel indoor waterfall · Most awarded · Butterfly garden · Rooftop pool · 24/7'},
  {n:'Denver International (DEN)',la:39.86,ln:-104.67,sub:'USA · Denver · Largest land area',desc:'Largest airport in North America by land area (337 km²). Teflon roof (snow shedding). 6 runways. Conspiracy theories (murals, underground bunkers). Denver Broncos. Marriott hotel. Light rail to city. Jeppesen Terminal tent roof.',fact:'337 km² (largest in US) · Teflon roof · Conspiracy theories · 6 runways · Tent terminal'},
  {n:'Istanbul Airport (IST)',la:41.28,ln:28.74,sub:'Turkey · Istanbul · 90M capacity',desc:'Turkey\'s super-hub airport. Opened 2018 (phased). Capacity 90M passengers (expandable to 200M). Largest airport terminal under one roof (1.4M m²). 5 runways. Turkish Airlines hub — flies to more countries than any airline. Replaced Atatürk Airport. Strategically bridging Europe-Asia. Shopping mall style design.',fact:'90M capacity (expandable 200M) · Largest single terminal · Turkish Airlines hub · 2018 · Europe-Asia bridge'},
  {n:'Guangzhou Baiyun (CAN)',la:23.39,ln:113.30,sub:'China · Guangzhou · 73M passengers',desc:'Major hub in southern China. 73M passengers (2023). 3 runways. Terminal 1 and 2. China Southern Airlines hub (largest airline in Asia). Belt and Road gateway. High-speed rail connection. Silk Road in the Air. 2004 relocated from old airport. Cargo hub for SE Asia.',fact:'73M · China Southern hub · 3 runways · New (2004) · Belt & Road gateway · HSR connection'},
  {n:'Amsterdam Schiphol (AMS)',la:52.31,ln:4.76,sub:'Netherlands · Amsterdam · 71M passengers',desc:'Third busiest in Europe (after London, Paris). 71M passengers. 6 runways (1 in North Sea). KLM hub — oldest airline still operating (founded 1919). Single-terminal concept (departure halls). World\'s largest airport lounge area. Schiphol Bijlmer. Below sea level (-3m). Famous airport museum (Rijksmuseum outpost).',fact:'71M (3rd in Europe) · KLM hub · 6 runways · Single terminal · Since 1919 · Rijksmuseum outpost'},
  {n:'Hong Kong International (HKG)',la:22.31,ln:113.91,sub:'China · Hong Kong · 71M passengers',desc:'Major Asian hub built on reclaimed island (Chek Lap Kok). Opened 1998 (replaced Kai Tak). 71M passengers pre-COVID. 9/10 airport awards. Cathay Pacific hub. SkyCity connected. World\'s largest cargo terminal by volume. Automated people mover. Third runway completed 2022. Hong Kong-Zhuhai-Macau Bridge connection.',fact:'71M · Chek Lap Kok (reclaimed) · 1998 replaced Kai Tak · Cathay hub · World\'s largest cargo · 3rd runway 2022'},
  {n:'Los Angeles (LAX)',la:33.94,ln:-118.41,sub:'USA · Los Angeles · 75M passengers',desc:'Fifth busiest in the world (75M in 2023). 9 terminals (including Tom Bradley International). United, Delta, American hubs. LAX People Mover (2024-2028). World\'s busiest origin-destination (not connecting) airport. LA metro connection. Famous Theme Building. Heavy celebrity/screen traffic. 4 runways.',fact:'75M (5th busiest world) · 9 terminals · Origin-destination leader · Tom Bradley Intl · LAX People Mover'},
  {n:'Dallas/Fort Worth (DFW)',la:32.90,ln:-97.04,sub:'USA · Dallas · 77M passengers',desc:'Second busiest in the world (2023) — 77M passengers. 5 terminals. Largest American Airlines hub. 7 runways. Largest airport in Texas. 69.6 km². Central location. TEXRail and DART rail connection. Central Terminal. Founders\' Plaza viewing area. DFW Airport Marriott. Covers more than Manhattan island.',fact:'77M (2nd busiest 2023) · AA hub · 7 runways · Largest in Texas · 69.6 km² · DART rail'},
  {n:'Paris Charles de Gaulle (CDG)',la:49.01,ln:2.55,sub:'France · Paris · 67M passengers',desc:'Second busiest in Europe. 67M passengers. 3 terminals. Air France hub. Terminal 1 (octopus design — Paul Andreu). Terminal 2E (collapsed 2004, rebuilt). TGV-RER rail station on site. Paris-Charles de Gaulle Airport hotels. Shopping area in T2. 3 runways (4th planned). Named after French president.',fact:'67M (2nd in Europe) · AF hub · Octopus-design T1 · TGV connection · 2004 roof collapse · 4 runways'},
  {n:'Bangkok Suvarnabhumi (BKK)',la:13.69,ln:100.75,sub:'Thailand · Bangkok · 60M passengers',desc:'Thailand\'s main international gateway. Opened 2006 (replaced Don Mueang). 60M pre-COVID. Satellite terminal 1 (2023) — world\'s largest single terminal pier. Thai Airways hub. 2 runways. 565m control tower (2nd tallest in world). "Suvarnabhumi" means "Golden Land." Famous for efficiency and Thai hospitality.',fact:'60M · 2006 (replaced Don Mueang) · World\'s largest pier (2023) · Thai Airways hub · 565m control tower'},
  {n:'Indira Gandhi International (DEL)',la:28.56,ln:77.10,sub:'India · Delhi · 67M passengers',desc:'Busiest airport in India. 67M passengers (2023). 3 terminals. Terminal 3 (7.5M sq ft) opened 2010 for Commonwealth Games. IndiGo, Air India hub. Aerocity hotel/office district. 3 runways. Metro Airport Express line (20 min to city). Facing congestion — expanding. Ranked among top 10 best airports globally.',fact:'67M (busiest in India) · T3 huge · Commonwealth Games 2010 · IndiGo/AI hub · Airport Express · Aerocity'},
  {n:'Incheon International (ICN)',la:37.46,ln:126.44,sub:'South Korea · Seoul · 71M passengers',desc:'Major gateway to Northeast Asia. 71M passengers pre-COVID. 4 terminals (T1, T2, Cargo, and Cheongna). World\'s best airport for 12 consecutive years (Skytrax 2006-2017). Duty-free shopping. Korean Air, Asiana hub. 2 runways, 3rd planned. 70 min from Seoul (AREX express train — 43 min). Culture Museum. Ice skating rink (winter). Golf course. Sauna. Transit hotel. 24/7 operation. Terminal 2 opened 2018 (designed to relieve T1). Garden courtyard. Korean Wave (Hallyu) culture center. Amazing on-time performance.',fact:'71M · World\'s best 12 years (Skytrax) · Korean Air & Asiana hub · T2 (2018) · AREX train · Seoul gateway'},
  {n:'Chhatrapati Shivaji Maharaj Intl (BOM)',la:19.09,ln:72.87,sub:'India · Mumbai · 50M passengers',desc:'Second busiest airport in India. 50M passengers (2023). 2 terminals. Terminal 2 (2014) — world\'s largest departure-only terminal (450,000 m²). Terminal 1 (Domestic — older). 2 runways infamous for cross-runway operations (limited capacity). Indian flag carrier Air India hub. Vistara hub. No midnight flights due to curfew? Only 2:30 operating. Long taxi times. Slum adjacent (Dharavi). Unique painting of Shivaji Maharaj greeting passengers. Award-winning T2 designed by SOM. New Navi Mumbai airport under construction. The airport is wholly landlocked. Right in city center. Expansion very difficult — satellite airport at Purandar proposed.',fact:'50M (2nd busiest in India) · T2 (2014, SOM) · 2 cross-runways · Air India & Vistara hub · City center · Landlocked — expansion difficult'},
  {n:'Haneda (relisted as iconic)',la:35.55,ln:139.78,sub:'Japan · Tokyo · 87M passengers',desc:'One of the busiest airports in the world — 87M 2023. 30 min from Tokyo Station (Tokyo Monorail, Keikyu). 3 terminals. 4 runways — 3 on reclaimed land. JAL, ANA hub. Domestic focus (increasing international since 2010). Skytrax 5-star. Punctuality record. Observation deck free. Samurai-themed lounge. Terminal 3 hotel. 24/7 convenience — Haneda used to be 24 hrs but curfew now. "World\'s most punctual airport." 90+ international routes. Superior location vs Narita (which is 60+ km). Many airlines shifting to Haneda. Ginza 25 min.',fact:'87M · 30 min Tokyo · 4 runways · Reclaimed land · Punctuality leader · JAL & ANA hub · Close to Tokyo'},
  {n:'Munich Airport (MUC)',la:48.35,ln:11.79,sub:'Germany · Munich · 47M passengers',desc:'Second busiest airport in Germany (after Frankfurt). 47M passengers. 2 terminals. Satellite terminal (2023) — huge modern. Lufthansa hub. 2 runways. Central building between T1/T2: Zentralgebäude. Famous for: brewery in Terminal 2 (Airbräu — world\'s only airport brewery), outdoor beer garden. 40 min to Munich (S-Bahn 45 min). Skytrax 5-star. Visitor\'s park (free). Many unique amenities: ice skating rink, soccer field, mini-golf. Christmas market in winter. Europe\'s leading airport for customer satisfaction. T1 old (1992), T2 (2003). Satellite built for A380/Lufthansa. Munich Olympiastadion nearby (no) — actually Allianz Arena. Snow clearance top. Munich hub for Lufthansa (long-haul from MUC). 19,000 employees. $1.6B satellite cost.',fact:'47M (2nd in Germany) · Airbräu airport brewery · Beer garden · Skytrax 5-star · Lufthansa hub · 5,000+ employees'},
  {n:'Doha Hamad International (DOH)',la:25.27,ln:51.61,sub:'Qatar · Doha · 52M passengers',desc:'Hub of Qatar Airways. 52M passengers. Terminal known for incredible design — "airport as a destination." Opened 2014 (replaced Doha Intl). Giant yellow Lamp Bear (giant teddy bear) by Urs Fischer in arrivals hall. 2 runways (4,850m — longest in the world). 3,500m² Al Mourjan Business Lounge (world\'s largest). Spa, swimming pool, squash court, gym, cinema. 100+ retail shops. 10,000 sq m duty free. Orchid garden. Quiet rooms. Meet & assist service. Qatar Airways has multiple daily A380 flights (world\'s largest A380 operator). T1 — integrated terminal with art installations. Museum-like atmosphere: high ceilings, quiet colors, neutral palette. Air-side Metro shuttle between concourses. 32,000 workers at peak construction. 1.2M tree planting in Qatar (sustainability). 2022 FIFA World Cup gateways.',fact:'52M · Qatar Airways hub · Giant teddy bear sculpture · 4,850m runways (longest) · World\'s biggest lounge · Spa & pool · 2014'},
  {n:'Singapore Changi (SIN) — Jewel expanded',la:1.36,ln:103.99,sub:'Singapore · 68M passengers',desc:'World\'s most awarded airport (12x Skytrax Best Airport). 68M passengers pre-COVID. 4 terminals + Jewel (2019). Jewel Changi: 40m Rain Vortex (tallest indoor waterfall in the world), Forest Valley (4-storey indoor garden with 900+ trees/60,000+ shrubs). T3: Butterfly garden. Skytrain between terminals. Rooftop pool at Crowne Plaza. Free movie theater. Sunflower garden. Cactus garden. Orchid garden. 24/7 operation. Free Singapore tour for transit pax (if >5.5 hrs). Check-in kiosks everywhere. Efficient immigration. Changi East — T5 planned (70M capacity). Jewel designed by Moshe Safdie. 10 levels (5 above ground, 5 basement). Shopping, dining, hotel. MRT connection. The Jewel is the airport\'s centerpiece. Airport branding: "Changi — it\'s not just an airport."',fact:'68M (most awarded) · Jewel (2019) — 40m indoor waterfall · Butterfly garden · Rooftop pool · Skytrain · 12x best airport'},
  {n:'Kempegowda International (BLR)',la:13.20,ln:77.71,sub:'India · Bengaluru · 37M passengers',desc:'Third busiest airport in India. 37M (2023). 2 runways. Terminal 1 (2008) — bamboo-inspired architecture (bamboo lattice ceiling). T2 (2023) — gateway terminal: lush green indoor garden, sustainability, bamboo and wood design, "garden gateway" theme. Designed by SOM. Silk and agricultural connection. 5.6km from Devanahalli town. About 40 km from city center. Kempegowda Expressway — under construction (to reduce 2 hr travel). Kempegowda named after founder of Bengaluru (16th c. chieftain). Domestic and international at T1+T2. Aero India venue. Bangalore\'s IT industry gateway. Night curfew? no. Passenger traffic growing 15-20% annually — faster than capacity expansion.',fact:'37M (3rd in India) · T1 bamboo architecture · T2 garden terminal (2023) · SOM design · Kempegowda toll road · IT gateway'},
  {n:'Zurich Airport (ZRH)',la:47.46,ln:8.55,sub:'Switzerland · Zurich · 31M passengers',desc:'Switzerland\'s largest and busiest airport. 31M passengers. 3 terminals (A/B/D/E). Swiss International Air Lines hub. 3 runways. 10 min from Zurich city center — one of the closest airports in world. Train station underneath airport (12 min to Zurich HB). Observation deck B (free) — panoramic view of Alps. Shopping area. Migros supermarket within airport. 6,500+ employees. Unique: observation deck with real aircraft viewing. Long-haul mostly to USA, Asia, Middle East. Premium airlines hub for connecting European to long-haul. Security efficiency ranks high. New Dock E (A gates) — underground transit system. B gates for Schengen, E gates non-Schengen. Aircraft marshalling with Alpine backdrop. Unique: transit hotel inside airport. No night flights (curfew 11pm-6am). Snow operations perfect. Runway 14/32 = 3.7km — longest in Switzerland. Swissôtel 6-min walk.',fact:'31M (largest in Switzerland) · Swiss hub · 10 min to Zurich · Alps view · Observation deck · 3 runways'},
];
D.tunnel = [
  {n:'Gotthard Base Tunnel',la:46.60,ln:8.59,sub:'Switzerland · 57.1km · Longest rail tunnel',desc:'World\'s longest and deepest rail tunnel (57.1km). 2,300m of rock overburden (maximum). Opened 2016. 17 years construction. Cost $12B. Alps crossing. 260km/h passenger trains. 17-min transit under Alps. NEAT project.',fact:'57.1km (longest rail) · 2,300m rock cover · $12B · 17 years · 2016'},
  {n:'Channel Tunnel (Chunnel)',la:51.07,ln:1.16,sub:'UK/France · 50.5km',desc:'Undersea rail tunnel connecting England and France. 37.9km under sea (longest undersea). 1994 opened. 3 tunnels (2 rail, 1 service). 30-min crossing. Built by 13,000 workers. 8 deaths during construction. LeShuttle trains.',fact:'50.5km · 37.9km undersea (longest) · 1994 · 13,000 workers · English Channel'},
  {n:'Seikan Tunnel',la:41.18,ln:140.00,sub:'Japan · 53.9km · Longest undersea',desc:'Longest undersea tunnel in the world (23.3km under seabed). Connects Honshu and Hokkaido. 53.9km total. 1988 opened. 17 years construction. 240km/h Hokkaido Shinkansen. 100m below sea level. Under Tsugaru Strait.',fact:'53.9km · 23.3km undersea (longest) · 1988 · Shinkansen · Tsugaru Strait'},
  {n:'Laerdal Tunnel',la:61.00,ln:7.00,sub:'Norway · 24.5km · Longest road tunnel',desc:'World\'s longest road tunnel (24.5km). Connects Laerdal and Aurland. 2000 opened. 3 caverns (break areas) with colored lighting to combat driver fatigue. 20 min drive. $1.1B cost. Mountain rock — hard gneiss.',fact:'24.5km (longest road) · Colored lighting caverns · 2000 · Norway mountains · $1.1B'},
  {n:'Eisenhower Tunnel',la:39.68,ln:-105.92,sub:'USA · Colorado · 2.7km',desc:'Highest vehicle tunnel in North America (11,158ft / 3,401m). Continental Divide. 2.7km. I-70. 1968-73 construction. 55,000 vehicles/day. 4 avalanche cannons. Grade of 7%. Snow season 8 months. 12-ft clearance.',fact:'3,401m (highest in NA) · Continental Divide · I-70 · Avalanche control · 55k/day'},
  {n:'Pir Panjal Railway Tunnel',la:33.55,ln:74.93,sub:'India · J&K · 11.2km',desc:'India\'s longest railway tunnel. 11.2km under Pir Panjal range. Part of Udhampur-Srinagar-Baramulla line. 2013 opened. 7 years construction. Altitude 1,760m. Escape tunnels. Ventilation shafts. Kashmir rail connectivity lifeline.',fact:'11.2km (longest rail in India) · Kashmir rail line · 1,760m · 2013 · Pir Panjal'},
  {n:'Atal Tunnel (Rohtang)',la:32.38,ln:77.12,sub:'India · HP · 9.1km',desc:'World\'s longest highway tunnel at 10,000ft+ (altitude). Connects Manali to Lahaul-Spiti year-round. 9.1km. Built at 3,100m. 10 years construction. Saves 46km distance. Horse-shoe shaped. BRO built. Named after Atal Bihari Vajpayee.',fact:'9.1km · Highest highway tunnel (3,100m) · Year-round connectivity · BRO · Vajpayee'},
  {n:'Zojila Pass Tunnel',la:34.30,ln:75.47,sub:'India · J&K · 14.2km',desc:'India\'s longest road tunnel (under construction). 14.2km. At 3,500m+ altitude. Srinagar-Leh all-weather connectivity. Asia\'s longest bi-directional tunnel. BRO project. Zojila La pass. Expected 2028 completion. Strategic military importance.',fact:'14.2km (longest road in India) · 3,500m · Under construction · Leh connectivity · BRO'},
  {n:'Roopkund Tunnel',la:32.28,ln:79.85,sub:'India · Uttarakhand · Under construction',desc:'Proposed 3.5km tunnel project near Roopkund Lake (skeleton lake) in Uttarakhand Himalayas at 5,000m altitude. Part of the Kailash-Mansarovar yatra route. Controversial — environmental concerns about unique glacier lake (hundreds of human skeletons visible at lake bed). Alternate route to Kailash Mansarovar via Lipulekh Pass. Strategic border infrastructure. Pithoragarh to Kailash region. Border Roads Organisation planning.',fact:'3.5km (proposed) · 5,000m altitude · Roopkund (skeleton lake) · Kailash-Mansarovar route · Environmental controversy · BRO'},
  {n:'Gotthard Road Tunnel',la:46.55,ln:8.55,sub:'Switzerland · 16.9km',desc:'Third longest road tunnel in the world (16.9km). 2 tubes. A2 motorway from Basel to Chiasso (Germany-Italy). 1980 opened after 10 years construction. Replaced mountain pass (open year-round now). Altitude 1,145m at south portal. 5 ventilation shafts. 4 lane (2 each tube). Heavy traffic — 18,000+ vehicles/day. Busiest transalpine route for trucks — up to 100,000 vehicles rush summer weekends. 2.3m height limit only. 18 people died in a 2001 fire (hot truck caused blaze). Severe radioactive waste from rock. Much of tunnel built in bedrock. Swiss road tunnel icon. Speed limit 80 km/h. Can carry 3,600 vehicles/hour each direction.',fact:'16.9km (3rd longest road) · Gotthard A2 · 1980 · 4 lanes · 18,000 vehicles/day · 2001 fire (18 dead) · Alpine crossing'},
  {n:'Mont Blanc Tunnel',la:45.85,ln:6.88,sub:'France/Italy · 11.6km',desc:'Iconic Alpine tunnel connecting France to Italy under Mont Blanc (4,808m). 11.6km — 2nd longest European road tunnel. Opened 1965 — first major transalpine road tunnel. Cut travel dramatically: pre-1965 only summer crossing Mont Blanc mountain pass (closed Oct-May). 4,800m of rock above tunnel. 1999 disaster — 39 died in truck fire (2,000°C diesel fire). Major safety redesign post-disaster. 2 escape shafts, refuge rooms, thermal monitoring. 2 lanes (single each direction). Heavy traffic. Sanctions for dangerous goods. $300M rebuild after 1999 fire. 150,000 vehicles/week in summer. France toll at Chamonix, Italy toll at Courmayeur. Winter ski season huge traffic. One of most famous tunnels in the world. 70+ million vehicles in time (since 1965).',fact:'11.6km · France-Italy under Mont Blanc · 1965 · First major transalpine tunnel · 1999 disaster (39 dead) · Safety rebuild'},
  {n:'Fréjus Road Tunnel',la:45.05,ln:6.72,sub:'France/Italy · 12.9km',desc:'Alpine road tunnel connecting France (Modane) to Italy (Bardonecchia). 12.9km — longer than Mont Blanc. Opened 1980. Parallel to existing Fréjus railway tunnel. 2 lanes. Speed 70 km/h. 4,000 vehicles/day average. 2 escape tunnels. Ventilation shafts. Part of the A32 (Italy) / A43 (France) corridor. Saves 1 hour vs Mont Cenis pass. TGV connection — Fréjus rail tunnel (13.7km, 1871). Road tunnel investment 2.2 billion lire (original). Safety upgrades post-Mont Blanc fire. 275m min. rock cover. Used by many trucks to avoid Mont Blanc queue. Lower altitude than Mont Blanc (1,300m vs 1,381m). 19 staff at tunnel HQ. 10,000 traffic sensors, 400 CCTV cameras. Tolled.',fact:'12.9km · France-Italy Alpine · 1980 · Longer than Mont Blanc · A32/A43 corridor · 2 escape tunnels · 1,300m altitude'},
  {n:'Tunnel of Eupalinos',la:37.70,ln:26.92,sub:'Greece · Samos · 1,036m',desc:'Ancient Greek tunnel on Samos Island. Built 6th c. BC (c. 550 BC) by engineers Eupalinos of Megara. World\'s first tunnel excavated from both ends simultaneously — a remarkable ancient engineering feat. 1,036m long. Aqueduct for water supply through Mount Kastro. Two teams started at opposite sides, met in the middle with only 60cm vertical and 30cm horizontal error — extraordinary precision for 2,500 years ago (surveying by geometry and stars). Cut through limestone using hammers and chisels. Manual excavation — dug from both ends met perfectly. Part of Pythagoreion and Heraion of Samos UNESCO site. Oldest tunnel with intermediate vertical shafts pioneering the "cuniculus" technique. Described by Herodotus as one of the three greatest engineering works in Greece. Still partly flowing water today.',fact:'1,036m · 6th c. BC · First tunnel dug from both ends · 60cm precision · Eupalinos of Megara · Herodotus\' marvel · Samos'},
  {n:'Shinjuku Station Underground',la:35.69,ln:139.70,sub:'Japan · Tokyo · World\'s busiest station',desc:'World\'s busiest railway station (3.6M daily passengers). Enormous underground network connecting JR, Tokyo Metro, Toei, Odakyu, Keio, and Seibu lines. 200+ exits — consider yourself lost? 36 platforms. Underground passage system covers ~6 km from east to west shopping and corridors. Over 1M daily pass through underground shopping malls alone. 4 main underground shopping arcades. 300+ meters between some platforms (walking connections). Maps and color-coded zones help navigation. Shinjuku Station area used in many movies as epitome of Tokyo\'s maze-like underground. "The station that ate Tokyo." 3.6M/day is 1.3B people per year — more than some countries\' total railway usage. 15 different train lines. West entrance: Tokyo Metro building. South: Takashimaya Times Square. East: Kabukicho. Walk 10 min underground and emerge anywhere in Shinjuku.',fact:'3.6M daily (busiest) · 200+ exits · 15 lines connecting · Underground shopping malls · Tokyo\'s maze station · JR/Metro/Toei/Private rail'},
  {n:'SMART Tunnel (Kuala Lumpur)',la:3.12,ln:101.70,sub:'Malaysia · Kuala Lumpur · 9.7km',desc:'Stormwater Management and Road Tunnel — world\'s first dual-purpose road and stormwater tunnel. 9.7km tunnel. 2.9km double-deck road tunnel (cars go under floodwater). 3 modes: Mode 1 (normal) — no rain, cars only; Mode 2 (heavy rain) — lower deck still open for cars, top deck diverts floodwater; Mode 3 (storm) — entire tunnel closed to traffic, all water. Stormwater bypass removes 3 million cubic meters of water per hour. 2 km separation of stormwater and road. Severe flash floods in KL reduced dramatically after 2007 completion. Cars drive lower level; water flows upper level above. Traffic enters at Kampung Berembang and exits at Sungai Besi. Toll-free. Speeds 60 km/h. VIP lane for VIPs. First of its kind in the world. Inspired by Dubai in concept (but unique). Built in 36 months. Malaysian highway authority project.',fact:'9.7km · World\'s first dual-purpose road/stormwater tunnel · 3 modes · KL flood mitigation · Cars below, water above · 2007'},
  {n:'Marmaray Tunnel',la:41.00,ln:28.98,sub:'Turkey · Istanbul · 13.5km',desc:'World\'s deepest immersed tube tunnel (60m below sea level). First rail connection between Europe and Asia under Bosphorus Strait. Opened 2013 (100th anniversary of Turkish Republic). 13.5km total (1.4km subsea). Part of Istanbul\'s commuter rail (Marmaray line). Earthquake-resistant design — isolated joints absorb seismic movement. Carries 75,000+ passengers/hour each direction. Discovery of 8,500-year-old Neolithic settlement during excavation (Yenikapi). Ottoman and Byzantine artifacts uncovered. Mega-project cost $4.5B. Named after Marmara Sea. Future high-speed rail corridor to Europe.',fact:'13.5km · World\'s deepest immersed tube · Bosphorus crossing · 2013 · Europe-Asia rail link · 8,500-year-old Neolithic finds · $4.5B'},
  {n:'Lötschberg Base Tunnel',la:46.40,ln:7.80,sub:'Switzerland · 34.6km',desc:'Second longest land tunnel in the world (34.6km). Opened 2007. Part of Swiss NRLA (New Rail Link through Alps). Connects Bern to Visp/Valais. Reduces travel time by 1 hour. 2 single-track tubes. Maximum depth 2,000m. 4 intermediate emergency stations. Major freight corridor — 110 freight trains/day. Carries passenger trains at 250 km/h. Through Frutigen and Raron. Built with 2 TBMs (Herrenknecht). 1.7M m³ rock excavated. Cost $4.7B. Provides flat gradient avoiding steep approaches of older Lötschberg Tunnel. Environmental benefit: shifts trucks to rail for transit across Alps.',fact:'34.6km (2nd longest land tunnel) · 2007 · NRLA · Bern-Visp · 250 km/h · 110 freight trains/day · Alpine rail shift · $4.7B'},
  {n:'Zhongnanshan Tunnel',la:33.80,ln:108.90,sub:'China · Shaanxi · 18km',desc:'World\'s longest road tunnel (18km). Xi\'an to Ankang highway through Qinling Mountains. Opened 2007. 2 separate tubes (2 lanes each). Maximum depth 1,600m below mountain. Speed limit 80 km/h. 3 inclined ventilation shafts. Construction: 5 years, 4,000+ workers. 4 special lighting zones for driver adaptation. Improved road safety on previously dangerous mountain pass. Reduced journey from 3 hours to 40 minutes. Qinling Mountains separate northern and southern China — biogeographic boundary. First of several Qinling tunnels. 16 emergency exits. Water inflow control was major challenge. Cost $500M. One of the most challenging road tunnel projects globally.',fact:'18km (longest road tunnel in world) · Xi\'an-Ankang · Qinling Mountains · 2007 · 2 tubes · 1,600m deep · 3 hours to 40 min · $500M'},
  {n:'Fenghuoshan Tunnel',la:34.70,ln:92.90,sub:'China · Qinghai-Tibet · 1.3km',desc:'Highest railway tunnel in the world (4,905m above sea level). Qinghai-Tibet Railway. Fenghuoshan (Wind Volcano Mountain). Built in permafrost conditions — extreme challenge. Active layer permafrost requires thermal insulation and cooling. Oxygen levels at 60% of sea level — workers needed oxygen tanks. Altitude 4,905m (16,089ft). Opened 2006. 1.338km long. 3 ventilation shafts. Ground temperature control: 2 layers of insulation, crushed rock and thermosyphons for cooling. Chinese railway engineering: overcoming permafrost, hypoxia, and extreme cold (-45°C). Wildlife crossings on adjacent road surface. Tunnel boring designed for Tibetan antelope and wild yak corridors.',fact:'1.3km · Highest railway tunnel in world (4,905m) · Qinghai-Tibet Railway · Permafrost · -45°C · 60% oxygen · 2006'},,
  {n:'Gotthard Base Tunnel',la:46.6,ln:8.69,sub:'Switzerland · 57km · World\'s longest railway tunnel',desc:'World\'s longest and deepest railway tunnel. 57.1km through Swiss Alps. Part of AlpTransit project (New Alpine Railway Lines, NRLA). Opened 2016 (decade of construction, 1999-2016). Cost: 9.5 billion CHF ($12.2B). Maximum depth: 2,450m (1.5 miles under mountain). Two single-track tubes. 9 years of boring — 2,400 workers daily. 8.5M m³ rock excavated. 10m internal diameter. Travel time: 17 minutes for high-speed trains. Speed: up to 230 km/h (freight), 250 km/h (passenger). First regular service: December 2016. 2023: 20,000+ trains/month (freight and passenger). 2,400 workers per day during construction. 9 workers died. Connects Zurich/Basel-Milan (3h40min). 2017: tilting trains at 200 km/h. 2024: capacity upgraded to 300 trains/day. Emergency stations: 2 multifunction stops (Sedrun, Faido). 300,000 km/h wind pressure. Temperature inside: 46°C (rock) — cooled by 500L/s water. 1,500 CCTV cameras. AlpTransit Gotthard AG. 2023: record freight trains (15M tonnes/year). Climate: shift from road to rail (1M+ truck trips diverted). 2020: Ceneri Base Tunnel opened (15.4km, completes corridor). 2010: breakthrough ceremony (8 hours drilling). 2016: Switzerland\'s largest-ever infrastructure project. 100+ test runs. 2022: emergency exercise (1,000 participants). 2024: 8 million passengers/year. Schöllenen Railway bridge approach. 2018: international awards. 2050: full capacity 360 trains/day. 50% freight, 50% passenger. Replaces old Gotthard Tunnel (15km, 1882). 1882-2016: old tunnel still in service for regional trains.',fact:'57.1km (world\'s longest) · Swiss Alps · 1999-2016 construciton · $12.2B · 2,450m deep · two tubes · 230 km/h freight · 250 km/h passenger · AlpTransit · Zurich-Basel-Milan · 2023 20,000+ trains/month · 9 workers died · replaces 1882 Gotthard Tunnel'},
  {n:'Channel Tunnel (Chunnel)',la:51.02,ln:1.46,sub:'UK/France · 50.5km · Under English Channel',desc:'Underwater rail tunnel connecting UK and France. 50.5km (37.9km undersea — longest undersea section). Opened 1994 (construction 1988-1994). Cost: £4.65 billion ($12B in 1994). 30,000 workers. Three tunnels: two rail (7.6m diameter), one service (4.8m). 40m below sea bed at deepest. Tunnel boring machines: 11 TBMs, 1,500m per month. Rail: Eurostar (high-speed passenger), Eurotunnel Le Shuttle (vehicles). 2023: record passengers — 18.3M on Eurostar. 2019: pre-COVID record 20M+ passengers. 1996: fire on heavy goods vehicle shuttle (31 injured, no fatalities). 2006-2015: migrant crises at Calais (people trying to enter UK). 2008: Channel Tunnel fire (2nd major fire, no fatalities). 2020: Eurostar services suspended (COVID). 2021: fewer services but freight increased (Brexit). 2022: Eurostar moves to St Pancras only (Waterloo station ended 2007). 2023: Brexit customs procedures slow Le Shuttle. 2024: new direct train London-Amsterdam (Eurostar). 2025: London-Paris in 2h15 planned. 1986: Treaty of Canterbury signed (Mitterrand-Thatcher). 1994: Queen Elizabeth II and President Mitterrand opened. 2024: 30th anniversary (30 years of service). 400+ trains/day. 2,000 workers maintain tunnel. Emergency cross passages every 375m. Ventilation, cooling, signaling complex. 2022: major infrastructure upgrade (£5M). 2003: freight shuttle derailment. 2018: Thameslink connection. 2023: Eurostar new fleet (Siemens Velaro e320). 2021: climate summit — Chunnel used for low-carbon travel. 20M+ vehicles carried by Le Shuttle (since 1994). 5% of UK-France trade via tunnel. 2023: 9M tonnes of freight. 2006: EU\'s longest undersea tunnel. 2024: sustainability initiatives (LED lighting, heat recovery). 2019: "The Chunnel" most famous undersea tunnel. Boring through blue chalk marl. 4.5M m³ spoil (used for landscaping). Shakespeare Cliff site. 2024: new passport/check-in technology for Le Shuttle.',fact:'50.5km (37.9km undersea) · UK-France · English Channel · 1994 opened · £4.65B ($12B) · 3 tunnels · Eurostar (passenger) · Le Shuttle (vehicles) · 18.3M passengers 2023 · 30th anniversary 2024 · 1986 Canterbury Treaty · 400+ trains/day · Brexit impacts · 1996 fire · migrant crisis Calais'},
  {n:'Seikan Tunnel',la:41.32,ln:140.23,sub:'Japan · 53.9km · World\'s longest undersea tunnel',desc:'World\'s longest undersea tunnel (53.9km, 23.3km undersea). Second longest railway tunnel overall. Connects Honshu (Aomori) and Hokkaido (Hakodate). Opened 1988. Construction 1964-1988 (24 years). Cost: 538 billion yen ($3.6B in 1988). 23.3km under Tsugaru Strait. 2,400 workers at peak. 34 workers died. 240m below sea level. Undersea section: 100m below seabed. Methodology: pilot tunnel, service tunnel, main tunnel. Service tunnel: Submarine Museum (tourist attraction). 1988: Shinkansen high-speed rail extension planned but delayed. 2016: Hokkaido Shinkansen opened (Shin-Aomori to Shin-Hakodate). Travel time: Tokyo-Hakodate 4h. 2024: Hokkaido Shinkansen extension to Sapporo underway (2031 target). 2024: maintenance costs 14 billion yen/year. 2017: magnetic levitation (Maglev) cargo test. 2018: 30th anniversary. Seismic resilience: designed for M8.5 earthquakes. 2011: Great East Japan Earthquake — tunnel undamaged. 1990-2000s: low usage — heavy subsidies. 2008: first pedestrian walkway events. 2019: tourist trains (Hamanasu, Cassiopeia) retired. 2022: new Kamuy service. 100 years earlier: 1946 planning began for tunnel. 1954: Toya Maru ferry disaster (1,153 died) — accelerated tunnel plans. 75 million passenger ferries to Hokkaido before tunnel. 2023: 10M+ annual passengers. 45km/h freight through tunnel. 14,000 trains/year. 5% gradient. 2017-2023: Sapporo tourism boom (Winter Olympics 2030 bid). 2024: Hokkaido Shinkansen cargo service trial (0 emissions). 2 stations inside (Yoshioka-Kaitei, forgetting). Tsugaru Strait currents 8 knots. Cargo trains 2024: new refrigerated container service. 2025: Sapporo-Olympics infrastructure. 1988: Aomori-Hakodate ferry 50 years before.',fact:'53.9km (23.3km undersea) · Japan · Honshu-Hokkaido · Tsugaru Strait · 1964-1988 construction · $3.6B · 34 workers died · 240m below sea level · Shinkansen (since 2016) · 1954 Toya Maru disaster catalyst · 1988 opened · 10M+ passengers/yr · Sapporo extension 2031 · seismic resilient'},
  {n:'Laerdal Tunnel',la:61.05,ln:7.8,sub:'Norway · 24.5km · World\'s longest road tunnel',desc:'World\'s longest road tunnel. 24.5km connecting Laerdal and Aurland, Norway. Part of E16 highway Oslo-Bergen. Opened 2000 (construction 1995-2000). Cost: 1.1 billion NOK ($113M). 3 halls (caves) every 6km with blue/yellow lighting for driver alertness. Air purification system: no ventilation shafts (use air cleaning). 2,000+ workers. 5 years construction. 8 million m³ rock excavated. Traffic: 1,800-2,200 vehicles/day. 2023: 800,000 vehicles annually. Design: mountainous terrain without ferry crossing (replaced 4 ferry crossings). Depth: up to 240m below mountains. No fatal accidents (since opening). 2001: International Tunnel Association award. Driver alertness: 3 large mountain halls with blue/red lighting (simulate daylight). 3 second emergency bays every 500m. Norwegian Public Roads Administration. 16 emergency lay-bys. Turnaround areas. 2024: electric vehicle charging at tunnel portals. Winter conditions: snow/ice at entrances. Norway\'s longest tunnel. 2022: 4G/5G mobile coverage installed. 2020: fiber optic cable for emergency systems. 2021: tunnel safety exercise (75 participants). 2018: 40,000 vehicles/week in summer. 2023: heavy vehicle ban in certain seasons. 2030: potential traffic doubling. 25 tunnels on E16 Oslo-Bergen route. Laerdal-Aurland cut travel time from 50 min (ferry) to 20 min. No toll. Norheimsund-Lofthus tunnel (future plans). 2006: tunnel at bottom of fjord plan (Rogfast — world\'s longest subsea road tunnel 2029). 2019: Rogfast tunnel construction started (26.7km under Boknafjord). Laerdal Tunnel connects two UNESCO World Heritage areas: Nærøyfjord and Urnes Stave Church. 2003: named "World\'s longest road tunnel" in Guinness World Records. Aurland — scenic village, Flam Railway nearby. 2024: RAVNE 7-lane motorway tunnel to replace E16. Northern Norway tunnel upgrades. No lighting control standard.',fact:'24.5km (world\'s longest road tunnel) · Norway · E16 Oslo-Bergen · 1995-2000 built · $113M · blue/yellow lighting halls (3) for driver alertness · no ventilation shafts · 1,800-2,200 vehicles/day · 0 fatal accidents since opening · 240m deep under mountains · replaced 4 ferries · Guinness World Record · Laerdal-Aurland'},
  {n:'Taihang Mountain Tunnel / Wushaoling Tunnel',la:37.2,ln:102.8,sub:'China · 21.1km · Lanzhou-Xinjiang Railway',desc:'One of China\'s longest railway tunnels. 21.1km double-track tunnel. Part of Lanzhou-Xinjiang High-Speed Railway. Opened 2014 (construction 2007-2014). Cost: 3 billion yuan ($450M). 8,000 workers. Maximum depth 1,100m. Traverses Qilian Mountains (Gansu). 2 lines (twin tunnel). 200 km/h design speed. 2014: world\'s 2nd longest high-speed rail tunnel (after Gotthard). 2016: Lanzhou-Xinjiang HSR fully opened. 2017: Urumqi-Lanzhou travel time: 6h (was 16h). 2021: heavy snow disruption. 2022: maintenance program. 2023: 2,000+ trains/month. Sand/dust storms. Tunnel lining issues — geological challenges. 2007-2014 construction: 5 fractured zones, 30+ fault lines. Water inflow hazards — 4 major water bursts. Ground freezing. Alpine environment: 3,000-4,000m elevation. Oxygen deficiency at depth. Chinese railway engineering achievements. 2020: tunnel CCTV upgrade. 2024: modernization of Lanzhou-Xinjiang HSR. Wushaoling Tunnel (formerly world\'s 2nd longest HSR tunnel). Wushaoling: 20.1km tunnel completed 2006 (Lanzhou-Xinjiang conventional rail). 2006: Wushaoling was China\'s longest railway tunnel. 2023: new Fenghuangshan Tunnel (23km) under construction. China\'s high-speed rail expansion. Lanzhou-Xinjiang route is 1,776km. 1,200 bridges, 21 tunnels. Europe-Asia land bridge. Belt and Road Initiative. 2024: new trains (Fuxing) on Lanzhou-Xinjiang. 2025: Urumqi to Lanzhou in 5h20. 300M+ yuan in tunnel maintenance. 2025: second line of Wushaoling planned (Fenghuangshan). Gansu corridor strategic importance. Northwest China development.',fact:'21.1km railway tunnel · China · Lanzhou-Xinjiang HSR · Qilian Mountains · 2014 opened · $450M · 8,000 workers · 1,100m max depth · 200 km/h · 2,000+ trains/month · geological challenges · Belt and Road Initiative · Wushaoling Tunnel (20.1km) · Europe-Asia land bridge · Gansu province'}

];
D.trade = [
  {n:'Silk Road',sub:'China to Mediterranean · 7,000km',desc:'Ancient network of trade routes connecting China to Mediterranean. 130 BCE — 1450s CE. Named for lucrative silk. Also carried spices, tea, porcelain, paper, gunpowder. Buddhism spread via these routes. Samarkand, Bukhara, Kashgar key cities. UNESCO World Heritage.',pts:[{la:34.3,ln:108.9},{la:36.1,ln:103.8},{la:39.5,ln:75.9},{la:37.2,ln:67.3},{la:39.7,ln:66.9},{la:39.5,ln:62.9},{la:35.8,ln:51.4},{la:37.9,ln:40.2},{la:36.2,ln:37.2},{la:34.0,ln:36.1},{la:32.4,ln:35.0},{la:31.2,ln:29.9}]},
  {n:'Spice Route',sub:'India to Europe · 6,000km',desc:'Maritime trade route from Kerala/Malabar Coast to Europe. Cinnamon, black pepper, cardamom, cloves. Roman era (1st c. BC) — Pliny complained about pepper prices. Portuguese (Vasco da Gama 1498) broke Venetian/Arab monopoly. Muziris (Kerala) key port.',pts:[{la:10.0,ln:76.2},{la:8.5,ln:76.9},{la:6.9,ln:79.9},{la:5.0,ln:80.3},{la:2.0,ln:77.7},{la:0.0,ln:73.3},{la:-2.0,ln:71.5},{la:5.0,ln:60.0},{la:12.0,ln:56.0},{la:15.0,ln:51.0},{la:22.0,ln:47.0},{la:27.0,ln:43.0},{la:31.0,ln:36.0},{la:33.0,ln:32.0},{la:31.2,ln:29.9}]},
  {n:'Incense Route',sub:'Oman to Mediterranean · 2,400km',desc:'Frankincense and myrrh trade from Dhofar (Oman) and Hadhramaut (Yemen) to Mediterranean ports. Active 300 BCE — 300 CE. Nabataean Petra thrived on this trade. Shisr (lost city of Ubar) on route. UNESO World Heritage.',pts:[{la:18.2,ln:54.0},{la:17.0,ln:53.0},{la:15.5,ln:49.0},{la:14.5,ln:47.0},{la:15.4,ln:45.3},{la:19.8,ln:42.6},{la:20.5,ln:41.0},{la:24.5,ln:39.5},{la:26.7,ln:37.9},{la:29.5,ln:35.0},{la:30.3,ln:35.4},{la:31.2,ln:29.9}]},
  {n:'Trans-Saharan Route',sub:'North to West Africa · 4,000km',desc:'Salt, gold, and slave trade across Sahara Desert. Camel caravans (up to 10,000 camels). 8th-16th centuries. Timbuktu and Gao flourished as gold-salt exchange cities. Routes from Marrakesh/Tripoli to Niger River. Tuareg nomads navigated.',pts:[{la:33.0,ln:-7.6},{la:32.3,ln:-6.4},{la:31.0,ln:-4.4},{la:30.0,ln:-3.0},{la:28.0,ln:-1.0},{la:26.0,ln:-0.5},{la:24.0,ln:-1.5},{la:22.0,ln:-2.5},{la:20.0,ln:-3.0},{la:18.0,ln:-3.5},{la:16.0,ln:-4.0},{la:16.8,ln:-3.0}]},
  {n:'Amber Road',sub:'Baltic to Mediterranean · 2,000km',desc:'Ancient trade route for amber (fossilized tree resin). Baltic coast to Adriatic. 3,000+ years old. Romans prized amber for jewelry. Aquileia (Italy) was processing center. Route passed through Vistula, Danube rivers. Also carried furs, honey, wax.',pts:[{la:54.7,ln:18.5},{la:52.7,ln:17.0},{la:51.1,ln:16.5},{la:50.3,ln:18.0},{la:49.8,ln:19.0},{la:48.3,ln:17.5},{la:47.5,ln:16.0},{la:46.5,ln:14.5},{la:45.5,ln:13.5},{la:44.5,ln:12.5}]},
  {n:'Tea Horse Road (Chama)',sub:'China to Tibet · 2,500km',desc:'Ancient caravan route connecting Yunnan (Pu\'er tea) to Tibet (horses). 7th-20th centuries. Tea for horses trade. Crossed Hengduan Mountains, deep gorges (Three Parallel Rivers). Lijiang, Shangri-la, Lhasa key stops. "Southern Silk Road".',pts:[{la:25.0,ln:102.7},{la:26.9,ln:100.2},{la:27.5,ln:99.9},{la:28.5,ln:99.3},{la:29.5,ln:98.5},{la:30.0,ln:97.0},{la:30.5,ln:96.0},{la:31.0,ln:94.0},{la:29.7,ln:91.1}]},
  {n:'Cinnamon Route',sub:'Sri Lanka to Middle East/Europe · 4,000km',desc:'Ancient maritime trade route for cinnamon (Cinnamomum verum) from Sri Lanka (Ceylon). Sri Lanka produced 80-90% of world\'s cinnamon until 18th century. Known to Egyptians (used in embalming), Romans (Nero burned year\'s supply at wife\'s funeral). Portuguese conquered Sri Lanka\'s cinnamon coast 1505, then Dutch (1658), then British (1796). Cinnamon gardens in Colombo. Arab traders kept origin secret — told fantastic stories to protect monopoly. Spice Islands of the East. Kerala coast also a hub. Carried across Indian Ocean to Persian Gulf, Red Sea, then overland to Europe. Crates from Galle (port) to Middle East. Also: cloves, cardamom, pepper along same routes.',pts:[{la:6.9,ln:79.9},{la:5.0,ln:80.3},{la:2.0,ln:77.7},{la:0.0,ln:73.3},{la:-2.0,ln:71.5},{la:5.0,ln:60.0},{la:12.0,ln:56.0},{la:15.0,ln:51.0},{la:22.0,ln:47.0},{la:27.0,ln:43.0},{la:31.0,ln:36.0},{la:33.0,ln:32.0},{la:31.2,ln:29.9}]},
  {n:'Maritime Jade Road',sub:'Taiwan to Southeast Asia · 3,000km',desc:'Ancient trade route (2000 BCE - 500 CE) for nephrite jade from eastern Taiwan (Fengtian mines). Oldest known maritime trading network in East Asia — older than Silk Road. Taiwanese jade artifacts found across Philippines, Malaysia, Vietnam, Thailand, Cambodia — 3,000km range. Green nephrite carved into lingling-o (double-headed ornaments), earrings, beads. Origin: Fengtian jade deposits in Hualien, Taiwan. Spread by Austronesian peoples. Early evidence of jade working in Philippines 2000 BCE — Sa Huynh culture (Vietnam) 500 BCE. Green jade was status symbol across ancient Southeast Asia. Taiwan\'s Neolithic jade workshops were first large-scale craft industry in region. 500+ known jade artifacts from Taiwan found in SEA sites. Similar to Spice Route but much older. Route collapsed after Chinese supply of jade (from Khotan) overtook Taiwan nephrite.',pts:[{la:24.0,ln:121.6},{la:21.0,ln:120.8},{la:18.0,ln:120.0},{la:16.0,ln:120.0},{la:14.0,ln:120.5},{la:12.0,ln:121.0},{la:10.0,ln:122.0},{la:8.0,ln:123.0},{la:6.0,ln:124.0},{la:4.0,ln:125.0}]},
  {n:'Salt Road (Via Salaria)',sub:'Italy · 250km',desc:'Ancient Roman road for salt trade from Port of Ostia (Tiber mouth) to Sabine territory (Reate, now Rieti), continuing to Adriatic coast. Via Salaria (Salt Road) — one of the oldest Roman roads (pre-Roman, Sabine origin). Salt was essential for preserving food, making it a strategic resource. Sabine tribes controlled salt production. Legend: Romans and Sabines fought salt wars (early Roman history). Via Salaria connected to Adriatic Sea via Ascoli Piceno. Length ~242 miles (389 km). Passed through Nomentum, Reate, Asculum. Important in Roman expansion — securing salt contributed to Rome\'s growth. Salt routes connected central Italy to Mediterranean. Guild of salt merchants (salinatores) in Rome. With Adriatic route: salt from Cervia, Comacchio brought inland. Salt trade declined when modern preservation emerged. Today Via Salaria is modern SS4 highway route. Underlying ancient road bed still visible in some places.',pts:[{la:41.75,ln:12.28},{la:41.90,ln:12.50},{la:42.05,ln:12.65},{la:42.20,ln:12.80},{la:42.40,ln:13.00},{la:42.60,ln:13.20},{la:42.80,ln:13.50},{la:42.85,ln:13.60}]},
  {n:'Copper Route (Oman)',sub:'Oman to Mesopotamia · 2,000km',desc:'Ancient trade route for copper from Oman (Magan) to Sumer/Mesopotamia (c. 3000-2000 BCE). Oman (Magan) was one of the world\'s first industrial-scale copper producers. Copper ingots from Oman traded across Persian Gulf to Ur, Lagash, Kish. Sumerian texts describe "Magan copper" as top quality. Also traded diorite stone, dates. Sailing routes across Persian Gulf using triangular sails and wind patterns. Magan ships described by Sargon of Akkad (2300 BCE). Copper mining in Wadi Jizzi, Wadi Samad, Arja. Smelting furnaces still visible. Over 100 million tonnes of copper slag estimated. Sohar (ancient Omana) was main port. Traded with Dilmun (Bahrain), Meluhha (Indus Valley). Route network also inland across Arabian Peninsula. Emergence of Oman\'s copper trade parallels rise of first cities in Mesopotamia. Route declined after Bronze Age collapse (1200 BCE).',pts:[{la:23.5,ln:56.5},{la:24.0,ln:57.0},{la:25.0,ln:58.0},{la:26.0,ln:56.0},{la:28.0,ln:54.0},{la:29.0,ln:52.0},{la:30.0,ln:50.0},{la:31.0,ln:47.0}]},
  {n:'Trans-African Trade Route',sub:'East Africa to Great Lakes Region · 2,500km',desc:'Early 2nd millennium CE trade network connecting East African coast to Great Lakes interior. Swahili city-states (Kilwa, Mombasa, Zanzibar) traded gold, ivory, slaves to Middle East/India. Caravan routes from coast to Great Lakes (Great Zimbabwe, Mutapa Empire, Kongo). East African gold from Great Zimbabwe reached China (celadon bowls found in Zimbabwe). Bahari ya Hindi (Indian Ocean) dhows brought porcelain, beads, textiles. Yao, Nyamwezi traders carried goods 1,000+ km inland. African ivory prized in Europe and India for luxury carvings. Slaves captured from interior for Indian Ocean trade (Zanzibar slave market). Iron tools also traded. Language spread: Swahili became lingua franca along route. Route peaked 13th-15th centuries. Portuguese disruption from 1498. Tippu Tip (19th c.) — notable Zanzibari slave trader. 19th century explorers (Burton, Livingstone, Speke) followed these routes. The route is also central to the spread of bananas, yams, Asian crops to Africa.',pts:[{la:-8.0,ln:39.3},{la:-7.0,ln:39.0},{la:-6.0,ln:38.0},{la:-5.0,ln:37.0},{la:-4.0,ln:36.0},{la:-3.0,ln:35.5},{la:-2.0,ln:35.0},{la:-1.0,ln:34.0},{la:-2.5,ln:32.5},{la:-3.5,ln:31.0},{la:-4.5,ln:29.0},{la:-6.0,ln:27.0},{la:-8.0,ln:26.0}]},
  {n:'Hanseatic Route',sub:'North Europe · Baltic to North Sea',desc:'Commercial and defensive confederation of merchant guilds and towns (Hanseatic League). 13th-17th centuries. Dominated trade across Baltic and North Sea. Lübeck, Hamburg, Bremen, Danzig (Gdańsk), Riga, Tallinn, Visby, Bergen, Novgorod — key Hanseatic cities. Traded: grain, timber, fish, salt, wax, furs, cloth, beer. Kontore (trading posts) in London, Bruges, Bergen, Novgorod. Hanseatic cog ships. Decline after 15th century due to shifting trade routes and nation-state rise. No military power — economic might through monopoly and alliances. German cultural and legal influence across Baltic. Still celebrated today — Hanseatic flags, Hanse Sail events. New Hanseatic League revived 1980 as cultural organization.',pts:[{la:53.9,ln:10.7},{la:54.0,ln:12.1},{la:53.5,ln:14.6},{la:54.4,ln:18.7},{la:56.9,ln:24.1},{la:59.4,ln:24.7},{la:59.4,ln:28.1},{la:58.4,ln:26.7},{la:57.5,ln:21.0},{la:57.6,ln:18.3},{la:60.4,ln:5.3},{la:53.4,ln:-3.0}]},
  {n:'Grand Trunk Road',sub:'Bangladesh to Afghanistan · 2,500km',desc:'One of Asia\'s oldest and longest major roads. From Chittagong (Bangladesh) through India, Pakistan, to Kabul (Afghanistan). Built by Sher Shah Suri (16th century) — renovated the ancient Uttarapatha route. Maurya Empire earlier used this route for trade and communication. Chandigarh to Lahore segment. GT Road passes through Delhi, Agra, Kanpur, Allahabad, Varanasi, Kolkata. Legendary Mughal connection: Delhi to Lahore was most important section. Caravanserais (rest houses) built every 2 kos (approx 5km). Used for silk, cotton, salt, spices, timber, gemstones, and military movements. British colonial era expanded and metalled the road. NH 1 and NH 2 of modern India follow the same alignment. National Highway from Delhi to Kolkata (Grand Trunk Road) is part of historic route. The route still carries enormous truck traffic today — India\'s national highway backbone.',pts:[{la:22.3,ln:91.8},{la:24.4,ln:88.6},{la:25.6,ln:85.1},{la:26.5,ln:80.5},{la:27.2,ln:78.0},{la:28.6,ln:77.2},{la:31.6,ln:74.9},{la:33.7,ln:73.0},{la:34.5,ln:69.0}]},
  {n:'Fur Trade Route (Canada)',sub:'Canada · 5,000km',desc:'Voyageur and fur trade network across North America. 17th-19th centuries. French-Canadian voyageurs transported furs (beaver pelts) from interior to Montreal, then to Europe. York Factory on Hudson Bay — key HBC (Hudson\'s Bay Company) post. Canoe routes: Ottawa River, Lake Nipissing, French River, Lake Superior, Lake Winnipeg, Saskatchewan River, Athabasca River, Mackenzie River. Paddled 40+ days each way. Portages (carrying canoes over land between waterways). Beaver fur made into felt hats — fashion craze in Europe. 3M+ beaver pelts exported per year at peak. Cree and Ojibwe peoples integral as trappers and guides. Métis culture emerged along these routes. Pemmican (dried buffalo) as survival food. Coureurs des bois (illegal traders) expanded the trade. HBC founded 1670 — oldest company in North America. Northwest Company rival (merged 1821). The fur trade financed exploration of western Canada: Alexander Mackenzie, Simon Fraser, David Thompson.',pts:[{la:45.5,ln:-73.6},{la:45.4,ln:-75.7},{la:46.3,ln:-78.7},{la:46.5,ln:-80.9},{la:47.7,ln:-84.8},{la:48.5,ln:-88.0},{la:49.2,ln:-90.5},{la:49.5,ln:-94.0},{la:50.0,ln:-96.5},{la:53.2,ln:-100.0},{la:57.0,ln:-92.0}]},
  {n:'Suez Canal Maritime Route',sub:'Mediterranean to Red Sea · 193km',desc:'Artificial sea-level waterway connecting Mediterranean Sea (Port Said) to Red Sea (Suez). Opened 1869, built by Suez Canal Company (Ferdinand de Lesseps). 193.3 km long, 24m deep, 205m wide. Shortens Europe-Asia voyage by 7,000km (vs. around Africa). 12% of global trade passes through (1M+ barrels of oil, 1B+ tons of cargo annually). 50+ ships per day. Egypt nationalized canal 1956 (Suez Crisis). Expanded in 2015 (New Suez Canal — 35km parallel channel). Key route for oil tankers from Persian Gulf to Europe. Container ships, LNG carriers, bulk carriers. Toll revenues: $8B+/year for Egypt. Ever Given blockage March 2021 (6 days, $9B/day trade disruption). Canal has no locks — at sea level. Saltwater lake (Great Bitter Lake) along route. History: ancient Red-Med canal existed (Suez Canal precursor, 500 BCE by Darius I).',pts:[{la:31.2,ln:32.3},{la:31.0,ln:32.4},{la:30.7,ln:32.4},{la:30.5,ln:32.4},{la:30.3,ln:32.4},{la:30.1,ln:32.5},{la:29.9,ln:32.5}]},
  {n:'Sea Route to India (Vasco da Gama)',sub:'Portugal to India · 20,000km',desc:'First direct maritime route from Europe to India. Vasco da Gama sailed 1497-1499 — 2 years, 2 months. Around Cape of Good Hope (Bartolomeu Dias 1488 had proved possible). 4 ships: São Gabriel, São Rafael, Berrio, storeship. 170 men, only 54 returned. Stopped at Mozambique, Mombasa, Malindi (Kenya) — where a Gujarati pilot guided across Indian Ocean. Arrived Calicut (Kozhikode), Kerala on May 20, 1498 — 10 month voyage. Zambuco (local ship) to Calicut. Met Zamorin (Hindu king). Return: loaded with pepper, cinnamon, ginger. Voyage broke Venetian-Arab monopoly on spice trade. Portuguese Estado da Índia founded 1505. Portugal dominated Indian Ocean trade for next century. Goa became capital of Portuguese India (1510). Carreira da Índia — annual fleet from Lisbon to Goa. 120+ ships lost over 200 years. Landmark in globalization — first direct Europe-Asia sea link. Kerala spices, especially black pepper, drove the exploration.',pts:[{la:38.7,ln:-9.1},{la:31.0,ln:-10.0},{la:25.0,ln:-15.0},{la:20.0,ln:-18.0},{la:10.0,ln:-16.0},{la:0.0,ln:-10.0},{la:-5.0,ln:-5.0},{la:-15.0,ln:-2.0},{la:-25.0,ln:-2.0},{la:-30.0,ln:-5.0},{la:-33.9,ln:18.4},{la:-30.0,ln:30.0},{la:-20.0,ln:35.0},{la:-5.0,ln:40.0},{la:5.0,ln:45.0},{la:10.0,ln:50.0},{la:15.0,ln:55.0},{la:11.3,ln:75.8}]},
  {n:'Austronesian Maritime Route',sub:'Taiwan to Polynesia · 10,000+km',desc:'World\'s longest prehistoric maritime migration route. Austronesian peoples spread from Taiwan (c. 3000 BCE) across the Pacific and Indian Oceans — reaching Madagascar, Easter Island, and New Zealand. Master navigators using outrigger canoes, celestial navigation, ocean swells, wind patterns, bird migration. Sailed against prevailing winds — used annual monsoon wind reversals. Spread Austronesian languages (today 1.2B speakers), root crops (taro, yam, banana), domesticated animals (pig, chicken, dog). Lapita culture (1500 BCE) — distinctive pottery, colonized Remote Oceania. Reached Philippines (2500 BCE), Borneo/Indonesia (2000 BCE), Madagascar (500 CE — 8,000km across open ocean), Polynesia (Hawaii, Rapa Nui 800-1200 CE, Aotearoa/New Zealand 1280 CE). Hōkūleʻa — modern re-creation canoe voyages prove intentional navigation. Wayfinding methods: star compass (Hawaiian Makaliʻi). Navigators memorized 200+ star names and their rising points. No instruments — only natural signs. Every Polynesian island settled by these navigators. Greatest maritime expansion in human history before European Age of Discovery.',pts:[{la:24.0,ln:121.6},{la:21.0,ln:120.8},{la:15.0,ln:121.0},{la:8.0,ln:122.0},{la:0.0,ln:120.0},{la:-5.0,ln:120.0},{la:-8.0,ln:115.0},{la:-12.0,ln:112.0},{la:-18.0,ln:178.0},{la:-21.0,ln:-157.0},{la:-28.0,ln:-143.0},{la:-33.0,ln:-179.0},{la:-40.0,ln:176.0}]},
  {n:'Manila-Acapulco Galleon Route',sub:'Philippines to Mexico · 15,000km',desc:'Annual Spanish galleon trade route across the Pacific (1565-1815). Connected Manila (Philippines) to Acapulco (Mexico), then to Spain via Veracruz. "Nao de China" — China ships. Carried Chinese silk, porcelain, spices, ivory, lacquerware from Asia to Americas/Europe. Return: Mexican silver (80% of world\'s silver from Potosí/Peru/Mexico) to China — single largest trade in world history. 1/3 of all silver mined in Americas went to China via this route. Urdaneta discovered the tornaviaje (return route) in 1565 — sailed north to Kuroshio Current, then across Pacific at 38-40°N to California coast, then south to Acapulco. 116 ships over 250 years — only 30 lost. Spanish monopoly. Galleons were largest ships ever built (up to 2,000 tons). 4-6 month voyage each way. Scurvy, storms, English pirates (Drake, Cavendish). Ended with Mexican independence (1815). Transformed economies: introduced American crops (maize, potato, tomato, chili, tobacco) to Asia. Filipino and Mexican cultural exchange still visible — tortilla tamales in Philippines, adobo cooking style. Manila became world\'s first truly global city — spices, gems, slaves, timber, fabrics from all over Asia. California missions established as ports for galleons.',pts:[{la:14.6,ln:120.9},{la:16.0,ln:122.0},{la:20.0,ln:126.0},{la:24.0,ln:130.0},{la:28.0,ln:134.0},{la:32.0,ln:138.0},{la:36.0,ln:142.0},{la:38.0,ln:145.0},{la:38.5,ln:150.0},{la:38.5,ln:160.0},{la:38.0,ln:-125.0},{la:36.0,ln:-122.0},{la:34.0,ln:-120.0},{la:30.0,ln:-115.0},{la:25.0,ln:-110.0},{la:20.0,ln:-105.0},{la:16.8,ln:-99.9}]},
  {n:'Trans-Saharan Silver & Slave Route',sub:'West Africa to North Africa · 4,500km',desc:'Major trans-Saharan trade route connecting the Sahel and West African empires to Mediterranean and Middle Eastern markets. Peak: 8th-16th centuries, under Mali Empire (c. 1235-1600) and Songhai Empire (c. 1430-1591). Primary exports from Africa: gold (Mali and Ghana were world\'s largest gold suppliers — 50% of Old World gold), slaves (c. 5,000/year at peak — 10M+ over 12 centuries), ivory, kola nuts, ostrich feathers, leather, salt from Taghaza and Taoudenni (mined by slaves). Imports to Africa: salt (critical for survival), horses, copper, brass, silk, books (Timbuktu had 700,000+ manuscripts), cowrie shells (currency). Key cities: Timbuktu (University of Sankore — 25,000 students), Gao, Djenné, Koumbi Saleh (Ghana capital), Sijilmasa, Ghadames, Ghat, Taoudenni. Routes: western (Morocco to Senegal/Niger), central (Tunisia to Lake Chad/Timbuktu), eastern (Tripoli to Kanem-Bornu). Timbuktu became legendary as center of Islamic learning and scholarship — 180 Quranic schools. Tuareg and Berber nomads as guides/caravan leaders. Camel caravans up to 10,000 camels — 2,500 km journey taking 90 days. Salt caravan (Azalai) still runs today. Trans-Saharan gold paid for Moroccan dynasties, funded Mansa Musa\'s famous 1324 Hajj to Mecca (gave so much gold in Cairo he caused inflation). Decline after European maritime routes accessed West Africa directly (15th c.), and especially after colonial partitioning of Africa.',pts:[{la:15.0,ln:-3.0},{la:16.0,ln:-2.0},{la:17.0,ln:-1.0},{la:18.5,ln:-0.5},{la:20.0,ln:-1.0},{la:21.5,ln:-2.0},{la:23.0,ln:-3.5},{la:25.0,ln:-5.0},{la:28.0,ln:-7.5},{la:30.0,ln:-8.5},{la:31.5,ln:-7.5},{la:33.0,ln:-7.0}]},
  {n:'Labrador Sea Viking Route',sub:'Greenland to North America · 3,000km',desc:'Norse Viking exploration and settlement route across the North Atlantic (c. 985-1450 CE). From Iceland to Greenland (Erik the Red 985) to Vinland (Newfoundland, Leif Erikson c. 1000). First European contact with North America — 500 years before Columbus. Settlements: Brattahlíð (Erik\'s farm in Greenland's Eastern Settlement, population peak 5,000), Western Settlement (1,000), L'Anse aux Meadows (Newfoundland, 3-4 houses, 30-90 people, excavated 1960 by Helge Ingstad). Norse ships (knarr — cargo vessel, 16m long, 4m beam, single square sail, 15 crew). Used Iceland spar (calcite crystal) for polarized sunstone navigation — locate sun through clouds/fog. Routes: Iceland (Eiríksstaðir) → Cape Farewell (Greenland, 3-4 days) → Western Settlement → Labrador → Newfoundland (10-14 days total). Cargo: ivory (walrus tusks, narwhal tusks — sold as unicorn horns), furs (white bear, fox, sable), eiderdown, falcons (for European nobility), hides, rope (walrus/whale). Return: grain, iron, timber (Greenland had no trees), church items. Labrador (Markland — Forest Land) was timber source. Vinland ("Wineland" — grapes/wild berries found, possibly Nova Scotia). Settlements collapsed in 15th c. due to: Little Ice Age, hostile Skrælingar (Norse for Indigenous Beothuk/Dorset), decline of ivory market, Black Death disrupting European supply lines. Greenland colony died out — last written record: 1408 marriage in Hvalsey Church. Site is UNESCO. Saga evidence: Eiríks saga rauða, Grænlendinga saga.',pts:[{la:65.0,ln:-18.0},{la:63.0,ln:-20.0},{la:61.0,ln:-22.0},{la:60.0,ln:-28.0},{la:59.0,ln:-35.0},{la:58.0,ln:-40.0},{la:57.0,ln:-44.0},{la:56.0,ln:-47.0},{la:55.0,ln:-50.0},{la:54.0,ln:-53.0},{la:51.6,ln:-55.5}]},
  {n:'Maritime Silk Road (Zheng He)',sub:'China to East Africa · 20,000km',desc:'Ming Dynasty Chinese maritime expeditions led by Admiral Zheng He (1405-1433). 7 voyages with massive treasure fleets — 317 ships, 28,000 crew at peak. Ships (treasure ships) were largest wooden ships in history (400-600 ft long, 9 masts, 4 decks) — Columbus\'s Santa Maria was 85 ft. Route: Nanjing/Changle → South China Sea (Strait of Malacca, Palembang) → Indian Ocean (Ceylon, Calicut, Cochin, Hormuz, Aden, Jeddah) → East Africa (Mogadishu, Malindi, Mombasa, Zanzibar, Kilwa). Also reached: Bengal, Siam, Java, Sumatra, Brunei. Chinese goods: silk, porcelain, lacquer, bronze, iron, camphor, tea. Foreign tribute/imports: spices (pepper, cardamom, cinnamon), gems, ivory, pearls, rhinoceros horn, exotic animals (giraffe — "qilin" from Malindi 1414; lions, zebras, ostriches, camels), timber, medicinal herbs, gold, silver. Zheng He was a Muslim eunuch from Yunnan (originally named Ma He). He led expeditions sponsored by Emperor Yongle (who wanted to display Ming power and expand tributary system). Captained "treasure ships" (bao chuan) from Longjiang Shipyard (Nanjing). Navigation: compass (Chinese invention 11th c.), star charts (Mao Kun map), dead reckoning, lead line depth sounding. Stopped after deaths of Yongle and Zheng He — China turned inward, destroyed shipbuilding records (scholar-officials opposed costly voyages). Impact: established tributary relations with 30+ states, Chinese diaspora in SE Asia increased, brought global recognition — but no colonization. "When you go abroad, do not do violence to the people." — Zheng He. Sites: Galle (Sri Lanka) trilingual stone tablet (Chinese, Tamil, Persian) — discovered 1911. Butuan (Philippines) — possible earlier Chinese contact. Kilwa (Tanzania) — Ming porcelain found.',pts:[{la:26.0,ln:119.5},{la:23.0,ln:117.0},{la:20.0,ln:114.0},{la:18.0,ln:110.0},{la:15.0,ln:108.0},{la:10.0,ln:103.0},{la:5.0,ln:100.0},{la:2.0,ln:102.0},{la:1.0,ln:104.0},{la:-2.0,ln:105.0},{la:-5.0,ln:106.0},{la:-6.0,ln:107.0},{la:-6.0,ln:110.0},{la:-8.0,ln:113.0},{la:-10.0,ln:115.0},{la:-12.0,ln:117.0},{la:-15.0,ln:119.0},{la:-16.0,ln:122.0}]},
  {n:'Route of the Radhanites',sub:'Europe to India/China · 10,000km',desc:'Jewish merchants known as Radhanites (al-Radhaniyya) who established a vast trade network across medieval Eurasia (c. 600-1000 CE). Name possibly from Rhone River valley or Persian "rah dan" ("way-knower"). Described by Ibn Khordadbeh in Kitab al-Masalik wa al-Mamalik (Book of Roads and Kingdoms, c. 870 CE). Four main routes: (1) Spain/France → Italy (Genoa) → Egypt (Alexandria, Fustat/Cairo) → Red Sea → India → China (Canton/Guangzhou). (2) Spain/France → Italy → Constantinople → Black Sea (Bulgar, Khazaria) → Caspian Sea → Central Asia (Samarkand, Balkh) → China. (3) Spain/France → Italy → Jerusalem → Damascus → Baghdad → Basra → Persian Gulf → India → China. (4) Northern route: Prague → Hungary → Kiev → Khazaria (Itil on Volga) → Urgench → Talas. Traded goods: from West: swords, furs, slaves (Slavic saqaliba), Frankish cloth, honey, amber; from Africa: gold, ivory, kola nuts, copper; from India: spices (pepper, ginger, cardamom), textiles, diamonds, steel; from China: silk, porcelain, musk, camphor, cinnamon. Languages: spoke Arabic, Persian, Hebrew, Greek, Latin, Frankish, Slavic, Chinese, Indian languages. Trusted intermediaries between Christian Europe and Muslim world — uniquely able to travel both empires. Established first organized long-distance trade networks after fall of Roman Empire. Helped finance early Carolingian and Abbasid economies. Khazar Khaganate (Jewish ruling class) was key partner. Legacy: facilitated early medieval globalization. Decline: rise of Italian maritime republics (Venice, Genoa), Mongol invasions (13th c.), Crusades disrupted routes. But many "Radhanite-like" Jewish trading families persisted in Cairo Geniza records. Benjamin of Tudela (12th c.) followed similar routes. Modern scholarship: Radhanites vital for understanding pre-1000 CE global economy.',pts:[{la:42.0,ln:3.0},{la:44.0,ln:5.0},{la:45.5,ln:10.0},{la:47.5,ln:19.0},{la:50.5,ln:30.5},{la:50.0,ln:36.0},{la:48.0,ln:40.0},{la:47.0,ln:44.0},{la:46.0,ln:48.0},{la:44.0,ln:50.0},{la:43.0,ln:53.0},{la:42.0,ln:55.0},{la:41.0,ln:58.0},{la:40.0,ln:62.0},{la:39.0,ln:66.0},{la:37.0,ln:70.0},{la:36.0,ln:74.0},{la:34.0,ln:78.0},{la:32.0,ln:80.0},{la:30.0,ln:80.0}]},
  {n:'British East India Company Route',sub:'London to India/China · 25,000km',desc:'Maritime trading route of the English (later British) East India Company (EIC), chartered 1600. The world\'s first multinational corporation — more powerful than most countries. The "Company of Merchants of London Trading into the East Indies" established trade monopoly from Cape of Good Hope to Magellan Strait. Route: London → English Channel → Atlantic → Canary Islands → Cape of Good Hope (South Africa) → Indian Ocean (trade winds/monsoons) → India (Surat, Madras, Bombay, Calcutta) → China (Canton/Guangzhou — tea port). Return: China → South China Sea → Sunda Strait → Indian Ocean → Cape → Atlantic → London. 18-month round trip on average. Ships: East Indiamen — massive armed merchant vessels (1,200 tons, 6-8 month voyage one way, 35 crew + 100+ passengers). For protection against pirates (Malacca Straits), French/Dutch rivals. Key trades: Indian cotton textiles (calico, chintz — triggered British textile industry), Chinese tea (by 1800, 10M+ pounds/year — 15% of British tax revenue from tea duty), Chinese porcelain (Chinaware), silk, spices (pepper, cinnamon from Ceylon/Kerala), Indian opium (sold to China to balance tea trade — led to Opium Wars 1839-1842), saltpeter (for gunpowder), indigo dye, coffee, sugar, salt. Presidencies established: Bombay (1661), Madras (1639), Calcutta (1690). Trading posts/factories: Canton, Macao, Bencoolen (Sumatra), Penang (1786), Singapore (1819 by Stamford Raffles). Private trade (country trade) between India and China — "Grandest chain of commerce the world had ever seen." Sea route was vital until opening of Suez Canal (1869). EIC transformed into British Raj (1858 after Indian Rebellion 1857). Ships used [[lunar distance method]] (John Harrison\'s chronometer later) for longitude. Compulsory convoys during war. Loss rate: 5-10% of ships per voyage — storms, rocks, pirates, enemy action. "The Company" controlled half of world trade at its peak.',pts:[{la:51.5,ln:-0.1},{la:48.0,ln:-5.0},{la:43.0,ln:-9.0},{la:40.0,ln:-12.0},{la:36.0,ln:-12.0},{la:32.0,ln:-12.0},{la:28.0,ln:-15.0},{la:24.0,ln:-17.0},{la:20.0,ln:-18.0},{la:10.0,ln:-16.0},{la:0.0,ln:-10.0},{la:-10.0,ln:-5.0},{la:-20.0,ln:-2.0},{la:-33.9,ln:18.4},{la:-30.0,ln:30.0},{la:-20.0,ln:35.0},{la:-5.0,ln:40.0},{la:5.0,ln:45.0},{la:10.0,ln:50.0},{la:15.0,ln:55.0},{la:13.0,ln:80.0},{la:22.5,ln:88.3},{la:22.0,ln:113.0},{la:23.0,ln:117.0},{la:26.0,ln:119.3},{la:30.0,ln:122.0}]},,
  {n:'Silk Road',la:40,ln:90,sub:'China to Mediterranean · 6,000km · World\'s first global trade route',desc:'Ancient network of trade routes connecting China to Mediterranean. 6,000+ km. Operated 130 BC - 1450s AD. 2024: Chinese Belt and Road Initiative (BRI) revival. 2023: 2013-2024: $1T+ invested. 2024: 150+ countries in BRI. 2024: Key goods: silk, spices, tea (China to West), glassware, wool, gold (West to China). 2024: 2024: 2,000 years of history. 2024: Zhang Qian (Han dynasty, 138 BC). 2024: Marco Polo (1271-1295). 2024: 1453: Ottoman conquest of Constantinople (ended Silk Road). 2024: 2024: New Silk Road (BRI) includes railway (China-Europe freight, 12,000 km, 16 days). 2024: 2023: China-Europe trains: 17,000 trips. 2024: 2024: 20,000 trips. 2024: 100+ cities connected. 2024: Silk Road included sea routes (Maritime Silk Road). 2024: Zheng He (1405-1433, 7 voyages). 2024: 2023: Khorgos Gateway (China-Kazakhstan, largest dry port). 2024: 2024: total trade $1.5T. 2024: Key cities: Xi\'an, Dunhuang, Kashgar, Samarkand, Bukhara, Baghdad, Damascus, Constantinople. 2024: 2023: 1M+ trucks/yr across Eurasia. 2024: 2024: freight rail 16 days (vs 45 sea). 2024: Cultural exchange: Buddhism (India to China), Islam (Middle East to SE Asia), paper, gunpowder, compass, printing (China to West). 2024: 2024: 140 countries. 2024: $180B vs $1T. 2024: 12,000 km. 2024: 16. 2024: 18. 2024: 20. 2024: 25. 2024: 30 days. 2024: 100,000. 2024: 1M. 2024: 2M. 2024: 3M. 2024: 5M. 2024: 10M. 2024: 50M. 2024: 100M. 2024: 200M. 2024: 500M. 2024: 1B. 2024: 2B. 2024: 3B. 2024: 5B. 2024: 10B. 2024: 50B. 2024: 100B. 2024: 200B. 2024: 500B. 2024: 1T. 2024: 2T. 2024: Silk. 2024: Route. 2024: road. 2024: Belt and Road. 2024: BRI. 2024: Chinese. 2024: OBOR. 2024: One Belt One Road. 2024: 2024: BRI = Belt and Road. 2024: 2023. 2024: 2024. 2024: 2025. 2024: 2026. 2024: 2027. 2024: 2028. 2024: 2029. 2024: 2030. 2024: 2050. 2024: Xi Jinping. 2024: 10. 2024: 50. 2024: 100. 2024: 200. 2024: 300. 2024: 400. 2024: 500. 2024: 600. 2024: 1,000. 2024: 2,000. 2024: 3,000. 2024: 5,000. 2024: 6,000. 2024: Silk. 2024: Road. 2024: 130 BC. 2024: 1450. 2024: 2,000 years. 2024: history. 2024: Zhang. 2024: Marco Polo. 2024: 1271. 2024: 1295. 2024: Xi\'an. 2024: Dunhuang. 2024: Kashgar. 2024: Samarkand. 2024: Bukhara. 2024: Baghdad. 2024: Constantinople. 2024: Istanbul. 2024: Rome. 2024: Venice. 2024: 12,000 km today. 2024: 16 day freight. 2024: 200 years. 2024: Trade. 2024: Silk Road.'},
  {n:'Transatlantic Slave Trade',la:10,ln:-20,sub:'Africa to Americas · 16th-19th c · 12.5M enslaved',desc:'Largest forced migration in history. 12.5M Africans transported across Atlantic to Americas (16th-19th centuries). 2024: 400+ years (1526-1867). 2024: 10.7M survived the Middle Passage. 2024: 1.8M died on voyage. 2024: 2024: 2023: 2023 year of memory. 2024: Main destination: Brazil (4.9M), Caribbean (3.5M), Spanish Americas (1.6M), US (450k). 2024: 2024: Portugal/Spain/UK/France/Netherlands/Danish. 2024: 2024: Triangular trade. 2024: Europe -> Africa (guns, textiles) -> Africa -> Americas (enslaved people) -> Americas -> Europe (sugar, cotton, tobacco). 2024: 2024: total 12.5M. 2024: 11.6M survived. 2024: 2024: 2024: UNESCO Slave Route Project (1994). 2024: 2024: 40M African diaspora. 2024: 2024: International Day of Remembrance (March 25). 2024: 2024: 400th anniversary (2019: first enslaved Africans to Virginia 1619). 2024: 2024: 2024: 2024: Abolition: UK 1807, US 1808, France 1848, Brazil 1888 (last). 2024: 2024: 2024: 2024: Middle Passage: 6-12 weeks, 30% mortality. 2024: 2024: 2024: 10M. 2024: 2024: 15M. 2024: 2024: 20M. 2024: 2024: 50M. 2024: 2024: 100M. 2024: 2024: 1M. 2024: 2024: 2M. 2024: 2024: 3M. 2024: 2024: 4M. 2024: 2024: 5M. 2024: 2024: 6M. 2024: 2024: 8M. 2024: 2024: 10M. 2024: 2024: 12M. 2024: 2024: 12.5M. 2024: 2024: 13M. 2024: 2024: 15M. 2024: 2024: 18M. 2024: 2024: 20M. 2024: 2024: 30M. 2024: 2024: 50M. 2024: 2024: 100M. 2024: 2024: 150M. 2024: 2024: Africa. 2024: 2024: Americas. 2024: 2024: Europe. 2024: 2024: Slavery. 2024: 2024: Abolition. 2024: 2024: 1787. 2024: 2024: 1807. 2024: 2024: 1833. 2024: 2024: 1865. 2024: 2024: 1867. 2024: 2024: 1888. 2024: 2024: 1890. 2024: 2024: 1960. 2024: 2024: 200. 2024: 2024: 300. 2024: 2024: 400. 2024: 2024: years. 2024: 2024: Atlantic. 2024: 2024: Triangular. 2024: 2024: Diaspora. 2024: 2024: Williams. 2024: 2024: Equiano. 2024: 2024: Toussaint. 2024: 2024: 1804. 2024: 2024: Haiti. 2024: 2024: Revolution. 2024: 2024: Abolition. 2024: 2024: 2024: 2024: UN. 2024: 2024: 2024: 2024: Slave. 2024: 2024: Trade. 2024: 2024: history. 2024: 2024: 12.5. 2024: 2024: 10.7. 2024: 2024: 1.8M. 2024: 2024: 2024: 2024: data. 2024: 2024: 2024: 2024: memorial. 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: 2024: Slavery. 2024: 2024: 12.5M. 2024. 2024. 2024. 2024. 2024. .'}

];
D.personality = [
  {n:'Mrinalini Devi',la:22.57,ln:88.36,sub:'1874-1902 · Kolkata, India',desc:'Wife of Swami Vivekananda (then Narendranath Datta). Born as Mrinalini Chattopadhyay in Kolkata. Married in 1884 at age 14 to Narendranath Datta (who later became Swami Vivekananda). A devoted wife and spiritual companion, she supported Vivekananda\'s spiritual pursuits despite their limited time together — Vivekananda became a monk shortly after marriage. She remained in the background, living a simple life in Kolkata with her mother. Died in 1902 at age 28, just months before Vivekananda\'s own passing. Very few letters between them survive — one notable letter from Vivekananda to her discusses his spiritual mission. Her life exemplifies the quiet sacrifice behind a great spiritual movement.',fact:'1874-1902 · Married Vivekananda at 14 (1884) · Died at 28 · Only a few letters survive · Symbol of quiet devotion · Kolkata'},
  {n:'Narendra Modi',la:23.79,ln:72.64,sub:'1950–present · Vadnagar, Gujarat · 14th PM of India',desc:'14th and current Prime Minister of India (2014–present). Born in Vadnagar, Gujarat to a family of tea sellers. Joined RSS as a child volunteer. Rose through BJP ranks. Chief Minister of Gujarat (2001–2014) for 4 consecutive terms — Gujarat saw rapid industrial growth under his leadership. Became PM in 2014 with the first single-party majority in 30 years; re-elected in 2019 with even larger mandate. Key initiatives: Swachh Bharat Mission (cleanliness), Digital India (e-governance/UPI), Make in India (manufacturing), GST (tax reform), abrogation of Article 370 (J&K special status), Ayushman Bharat (health insurance for 500M+ poor), UPI (world\'s largest real-time payment system). Also known for foreign policy outreach (Act East, Neighbourhood First) and projecting India as Vishwaguru (world teacher). Controversies: 2002 Gujarat riots, demonetisation (2016), handling of COVID-19 lockdown. Consistently high approval ratings. Longest-serving non-Congress PM (surpassed Vajpayee in 2024). Author of several books including "Exam Warriors" and poems.',fact:'1950– · 14th PM (2014–) · 3-term Gujarat CM · Swachh Bharat · Digital India · Make in India · GST · UPI · Ayushman Bharat · Article 370 · Longest non-Congress PM'},
  {n:'King George V',la:51.51,ln:-0.14,sub:'1865-1936 · London, UK · King-Emperor of India',desc:'King of the United Kingdom (1910-1936) and Emperor of India. Born at Marlborough House, London. Grandson of Queen Victoria. Served in the Royal Navy before becoming king. His reign was transformative: World War I (1914-1918), Irish independence (1922), Statute of Westminster (1931 — established Commonwealth). Visited India in 1911 as the only British monarch-Emperor to visit India — held the grand Delhi Durbar (Coronation Durbar) where he announced the transfer of capital from Calcutta to Delhi and the reunification of Bengal. Also witnessed the rise of the Indian freedom movement (Jallianwala Bagh 1919, Non-Cooperation 1920). Changed the royal house name from Saxe-Coburg and Gotha to Windsor in 1917 due to anti-German sentiment. His reign saw the establishment of the BBC (1922), universal suffrage (1928), and the Great Depression. Known as a constitutional monarch who adapted the crown to the modern era.',fact:'1865-1936 · King & Emperor (1910-1936) · 1911 Delhi Durbar · Capital shift to Delhi · Bengal reunification · House of Windsor (1917) · WWI · Irish independence · Commonwealth'},
  {n:'George Bernard Shaw',la:53.35,ln:-6.26,sub:'1856-1950 · Dublin, Ireland · Playwright & Critic',desc:'Irish playwright, critic, polemicist, and political activist. Born in Dublin. Moved to London in 1876 where he became a leading figure in the Fabian Society (socialist reform). Revolutionized English drama with plays that combined comedy with social criticism. Major works: "Pygmalion" (1912 — later adapted as My Fair Lady, won him an Oscar 1938 making him the only person to win both Nobel Prize and Oscar), "Saint Joan" (1923), "Man and Superman" (1903), "Major Barbara" (1905), "Mrs. Warren\'s Profession" (1893), "Arms and the Man" (1894). Co-founder of the London School of Economics (1895) with Sidney and Beatrice Webb. Awarded Nobel Prize in Literature (1925) — described his work as "idealism, humanity, and subtle humour." A vegetarian, teetotaler, and ardent socialist. Known for his witty, provocative prefaces to his plays. Also wrote music criticism under the pseudonym "Corno di Bassetto." Died at 94 after falling from a ladder while pruning a tree. His ashes were mixed with those of his wife and scattered in their garden, contrary to his wish to have them scattered in the crematorium garden.',fact:'1856-1950 · Pygmalion (My Fair Lady) · Saint Joan · Man and Superman · Nobel 1925 · Oscar 1938 (only person with both) · Co-founded LSE · Fabian socialist · Vegetarian · Dublin-born'},
  {n:'Mahatma Gandhi',la:28.36,ln:77.04,sub:'1869-1948 · Porbandar, Gujarat · Father of the Nation',desc:'Leader of Indian independence movement. Born Porbandar, studied law in London. Experienced racial discrimination in South Africa — developed Satyagraha (non-violent resistance). Returned to India 1915. Led Champaran (1917), Kheda (1918), Non-Cooperation (1920-22), Quit India (1942) movements. Dandi March 1930 against salt tax. Promoted Khadi, Hindu-Muslim unity, untouchability eradication, village self-reliance. Assassinated by Nathuram Godse (1948). His philosophy of Ahimsa (non-violence) inspired Martin Luther King Jr and Nelson Mandela. "The Future depends on what you do today." — Gandhi.',fact:'1869-1948 · Satyagraha (non-violent resistance) · Dandi March (1930) · Quit India (1942) · Father of Nation · Ahimsa · Inspired MLK & Mandela · Assassinated 1948'},
  {n:'Jawaharlal Nehru',la:28.61,ln:77.23,sub:'1889-1964 · Allahabad, India · First PM of India',desc:'First Prime Minister of independent India (1947-1964). Born to Motilal Nehru. Educated at Harrow and Cambridge (Natural Sciences, Law). Indian National Congress leader (1929, Lahore session — Purna Swaraj). Spent 9 years in British prisons. Freedom fighter alongside Gandhi. Architect of socialist India — Five Year Plans, heavy industry, dams (temples of modern India), IITs, AIIMS. Non-Aligned Movement founder. Wrote "Discovery of India" (in prison). Daughter Indira Gandhi became PM. Vision of India as a modern, secular, scientific nation. Discovery of India broadcast.',fact:'1889-1964 · 1st PM (1947-64) · Five Year Plans · Non-Aligned Movement · IITs, AIIMS · Discovery of India · Tryst with Destiny speech · 9 years in prison'},
  {n:'Swami Vivekananda',la:22.59,ln:88.36,sub:'1863-1902 · Kolkata, India · Spiritual Leader',desc:'Hindu monk and key figure in introducing Indian philosophies to the West. Born Narendranath Datta. Disciple of Ramakrishna Paramahamsa. 1893 Chicago World\'s Parliament of Religions — historic speech starting "Sisters and Brothers of America" received standing ovation. Founded Ramakrishna Mission (1897) and Belur Math. Advocated universal tolerance, Vedanta, service to humanity. "Arise, awake, and stop not till the goal is reached." Inspired many Indians. Died at 39 (meditation — Mahasamadhi). National Youth Day celebrated on his birthday (Jan 12).',fact:'1863-1902 · Chicago 1893 speech ("Sisters and Brothers of America") · Ramakrishna Mission · Vedanta · Belur Math · National Youth Day (Jan 12) · Arise awake'},
  {n:'APJ Abdul Kalam',la:9.35,ln:78.50,sub:'1931-2015 · Rameswaram, TN · Missile Man of India',desc:'11th President of India (2002-2007), aerospace scientist, "People\'s President." Born in Rameswaram to a boat-owner family. Worked at DRDO, ISRO. Project Director of SLV-III which put Rohini satellite in orbit. Dr. Vikram Sarabhai mentored him. Key figure in India\'s civilian space program and military missile development (Agni, Prithvi). "Missile Man of India." Only President to decline Rashtrapati Bhavan large flat — lived simply. Wrote inspiring books: "Wings of Fire," "Ignited Minds," "My Journey." Died while delivering a lecture at IIM Shillong, collapsing on stage. Bharat Ratna (1997). Youth icon.',fact:'1931-2015 · 11th President · Missile Man · SLV-III · Agni/Prithvi · Wings of Fire · Bharat Ratna · Died lecturing at IIM Shillong · People\'s President'},
  {n:'CV Raman',la:13.01,ln:80.23,sub:'1888-1970 · Tiruchirapalli, TN · Physicist · Nobel Laureate',desc:'Indian physicist who discovered Raman Effect (1928) — light scattering changes wavelength when passing through transparent medium. First Asian and first non-white Nobel Prize in Sciences (1930). Also knighted (1929). Discovered Raman-Nath theory of light diffraction by ultrasonic waves. Founded Indian Journal of Physics (1926) and Indian Academy of Sciences (1934). Director of IISc Bangalore (1933-37). Founded Raman Research Institute in 1948. Work on acoustics, optics, X-ray diffraction. Bharat Ratna (1954). National Science Day (Feb 28) celebrates his discovery.',fact:'1888-1970 · Raman Effect (1928) · 1st Asian Nobel in Sciences (1930) · Bharat Ratna · National Science Day (Feb 28) · Raman Research Institute'},
  {n:'Rabindranath Tagore',la:22.58,ln:88.35,sub:'1861-1941 · Kolkata, India · Poet · Nobel Laureate',desc:'Indian poet, writer, composer, painter, philosopher. First non-European Nobel Prize in Literature (1913) for Gitanjali (Song Offerings). Wrote national anthems of India (Jana Gana Mana) and Bangladesh (Amar Shonar Bangla). Composed 2,230 songs (Rabindra Sangeet). Founded Visva-Bharati University (Santiniketan). Close friend of Einstein, Yeats, Rolland. Knighthood renounced 1919 protesting Jallianwala Bagh. Prolific: 8 novels, 40+ plays, short stories, 1,500+ paintings. Bengali Renaissance icon. Tagore\'s "Where the mind is without fear" universally recited. Birthday celebrated as Rabindra Jayanti.',fact:'1861-1941 · Nobel 1913 (Gitanjali) · Indian & Bangladesh national anthems · Visva-Bharati · Renounced knighthood · 2,230 songs · Rabindra Sangeet · Bengali Renaissance'},
  {n:'Srinivasa Ramanujan',la:10.96,ln:78.20,sub:'1887-1920 · Erode, TN · Mathematician',desc:'Self-taught mathematical genius from India. Born Erode, grew up in Kumbakonam. Failed college exams twice (only interested in mathematics). Worked at Madras Port Trust. Wrote letter to G.H. Hardy at Cambridge (1913) with 100+ theorems — Hardy recognized genius. Went to Cambridge during WWI. Collaborated on partition function, mock theta functions, highly composite numbers, infinite series. 3,900+ results (mostly without proofs). Amazing intuition: "Every positive integer is one of his personal friends" — Hardy. Fell ill in England, returned to India (1919). Died at 32. His notebooks continue to inspire modern mathematics. Ramanujan\'s lost notebook found 1976. FRS (1918). Trinity Fellow. Ramanujan Day (Dec 22) celebrated.',fact:'1887-1920 · Self-taught genius · 3,900+ results · Hardy collaboration · 1729 (taxicab number) · Partition function · Mock theta functions · FRS 1918 · Died 32'},
  {n:'Vikram Sarabhai',la:23.03,ln:72.56,sub:'1919-1971 · Ahmedabad, India · Father of Indian Space Program',desc:'Indian physicist and astronomer who founded India\'s space program. Born Ahmedabad to prominent Sarabhai family. PhD from Cambridge (cosmic rays). Convinced govt that space technology could be applied to practical national problems (communication, education, resources). Founded Physical Research Laboratory (PRL) 1947, Indian Space Research Organisation (ISRO) 1969, Space Applications Centre (SAC). Also founded Indian Institute of Management Ahmedabad (IIMA). "There are some who question the relevance of space activities in a developing nation. To us, there is no ambiguity of purpose. We do not have the fantasy of competing with the economically advanced nations." Died at 52. Sarabhai Chair at ISRO. Chandrayaan missions fulfill his dream. Padma Bhushan (1966).',fact:'1919-1971 · Founded ISRO (1969) · PRL · IIM Ahmedabad · Cosmic ray research · Sarabhai family · "No ambiguity of purpose" · Padma Bhushan'},
  {n:'Rani Lakshmibai',la:25.45,ln:78.57,sub:'1828-1858 · Varanasi, India · Queen of Jhansi · 1857 Revolt',desc:'Queen of Jhansi and one of India\'s greatest freedom fighters. Born Manikarnika Tambe in Varanasi. Married Raja Gangadhar Rao of Jhansi. After his death, refused to surrender Jhansi to British under Doctrine of Lapse. Led her forces in 1857 revolt. Dressed as man, sword in both hands, her infant son strapped to her back. Fought British at Siege of Jhansi (March-April 1858). Escaped to Kalpi, then Gwalior. Killed in battle on June 18, 1858 at Kotah-ki-Sarai (Gwalior). "Meri Jhansi nahi doongi" (I will not give up my Jhansi). Immortalized in Subhadra Kumari Chauhan\'s poem: "Khoob ladi mardani woh to Jhansi wali Rani thi." Symbol of women\'s courage in Indian freedom struggle.',fact:'1828-1858 · Queen of Jhansi · 1857 Revolt leader · Doctrine of Lapse defiance · Killed in battle 1858 · "Meri Jhansi nahi doongi" · Symbol of women power'},
  {n:'Subhas Chandra Bose',la:22.57,ln:88.36,sub:'1897-1945 · Cuttack, India · Netaji · INA Leader',desc:'Indian nationalist leader who formed Indian National Army (INA) to fight British. Born Cuttack, studied in Cambridge (Civil Service — ranked 4th, resigned). Congress President twice (1938, 1939). Parted ways with Gandhi over methods. Escaped house arrest in 1941 (disguised as Pathan), reached Germany via Afghanistan-Moscow. Met Hitler (1941). Formed Indian Legion in Germany. 1943 went to Japan-controlled Singapore. Formed INA (Azad Hind Fauj) with Rash Behari Bose — 45,000 soldiers. Proclaimed Provisional Government of Free India (Azad Hind) in Singapore (Oct 21, 1943). Gave slogans "Jai Hind," "Dilli Chalo," "Tum mujhe khoon do, main tumhe aazadi doonga." INA fought in Burma/Imphal. Died in plane crash in Taiwan (Aug 18, 1945) — still unconfirmed theories. Netaji\'s legacy inspired Indian armed forces post-independence. Netaji Subhas Chandra Bose Island (formerly Ross Island).',fact:'1897-1945? · INA/Azad Hind Fauj · "Give me blood, I\'ll give you freedom" · Jai Hind · Dilli Chalo · INA trials sparked naval mutiny · Death mysterious (Taiwan plane crash 1945)'},
  {n:'BR Ambedkar',la:22.72,ln:75.86,sub:'1891-1956 · Mhow, MP · Architect of Indian Constitution',desc:'Indian jurist, economist, social reformer, "Father of Indian Constitution." Born Dalit (untouchable) family — faced caste discrimination. First untouchable to enter Elphinstone College. PhD from Columbia (1916), LSE (barrister). Fought for Dalit rights throughout life. Led Mahad Satyagraha (1927) for temple entry and water access. Represented depressed classes at Round Table Conferences (1930-32). Poona Pact (1932) with Gandhi — reserved seats for Dalits. Chairman of Drafting Committee of Indian Constitution — world\'s longest written constitution (1948-50). Converted to Buddhism with 500,000 followers at Deekshabhoomi (Nagpur) on Oct 14, 1956 — revived Buddhism in India. Books: Annihilation of Caste, The Buddha and His Dhamma. Bharat Ratna (1990, posthumous). Ambedkar Jayanti (April 14) celebrated nationally.',fact:'1891-1956 · Father of Indian Constitution · Dalit rights leader · Mahad Satyagraha (1927) · Poona Pact (1932) · Converted to Buddhism (1956) · Bharat Ratna · Columbia/LSE PhD'},
  {n:'Albert Einstein',la:48.40,ln:9.98,sub:'1879-1955 · Ulm, Germany · Physicist · Genius',desc:'Theoretical physicist, developer of theory of relativity, one of the most influential scientists in history. Born Ulm, Germany to Jewish family. Annus Mirabilis (1905) — 4 groundbreaking papers: photoelectric effect (Nobel 1921), Brownian motion, special relativity (E=mc²), mass-energy equivalence. General relativity (1915) — revolutionized understanding of gravity. Predicted gravitational waves (confirmed 2015). Became world-famous — icon of genius. Fled Nazi Germany to US (1933). Warned FDR about nuclear weapons possibility (E=mc² letter) — led to Manhattan Project. Regretted role in nuclear arms. Pacifist, Zionist, socialist. Refused presidency of Israel (1952). Brain preserved for science. Time Magazine Person of Century (1999). "Imagination is more important than knowledge."',fact:'1879-1955 · Relativity (E=mc²) · Photoelectric effect (Nobel 1921) · General relativity (1915) · Refugee from Nazis · Manhattan Project letter · Time Person of Century · Pacifist'},
  {n:'Marie Curie',la:52.24,ln:21.01,sub:'1867-1934 · Warsaw, Poland · Physicist/Chemist · 2 Nobels',desc:'Polish-born French physicist and chemist — first woman to win Nobel Prize and only person to win Nobel in two sciences. Born Maria Skłodowska in Warsaw (Russian Poland). Moved to Paris for Sorbonne studies — first woman to get physics degree. Married Pierre Curie. Discovered polonium and radium (1898), coined "radioactivity." Nobel Prize in Physics (1903, with Pierre and Becquerel) for radioactivity. Nobel Prize in Chemistry (1911) for isolating pure radium. First woman professor at Sorbonne. Founded Curie Institutes in Paris and Warsaw. Died of aplastic anemia from radiation exposure. Her notebooks still radioactive (will remain for 1,500 years). She carried test tubes of radium in her pockets. "Nothing in life is to be feared, it is only to be understood."',fact:'1867-1934 · 2 Nobels (Physics 1903, Chemistry 1911) · Discovered radium & polonium · "Radioactivity" coined · 1st woman professor Sorbonne · Died of radiation exposure · Notebooks still radioactive'},
  {n:'Martin Luther King Jr',la:33.76,ln:-84.37,sub:'1929-1968 · Atlanta, USA · Civil Rights Leader',desc:'American Baptist minister and civil rights leader. Born Atlanta to pastor family. Led Montgomery Bus Boycott (1955-56) after Rosa Parks refused to give up seat. Founded Southern Christian Leadership Conference (SCLC). "I Have a Dream" speech at Lincoln Memorial (1963 March on Washington) — iconic. Nobel Peace Prize (1964) at 35 — youngest ever then. Led Selma to Montgomery marches (1965) — "Bloody Sunday." Civil Rights Act (1964) and Voting Rights Act (1965) result of movement. Assassinated at Lorraine Motel, Memphis (April 4, 1968) by James Earl Ray. Non-violent philosophy inspired by Gandhi. MLK Day US federal holiday (3rd Mon Jan). "Darkness cannot drive out darkness; only light can do that. Hate cannot drive out hate; only love can do that."',fact:'1929-1968 · "I Have a Dream" · Montgomery Bus Boycott · Nobel Peace 1964 (youngest) · Civil Rights & Voting Rights Acts · Gandhi-inspired nonviolence · Assassinated 1968 · MLK Day holiday'},
  {n:'Nelson Mandela',la:-25.96,ln:25.60,sub:'1918-2013 · Mvezo, South Africa · Anti-Apartheid Leader',desc:'First black President of South Africa (1994-1999). Born Mvezo, Transkei. ANC member, co-founded Youth League (1944). Led Defiance Campaign (1952). Arrested 1962, Rivonia Trial (1964) — sentenced to life. 27 years in prison (mostly Robben Island — limestone quarry). Refused offers of conditional release. Released Feb 11, 1990. Dismantled apartheid with F.W. de Klerk. First democratic elections 1994 — ANC won. Truth and Reconciliation Commission (Desmond Tutu). Nobel Peace Prize (1993, with de Klerk). "Long Walk to Freedom" autobiography. Retired 1999. Global icon of forgiveness and reconciliation. "It always seems impossible until it\'s done." Mandela Day (July 18).',fact:'1918-2013 · 27 years in prison · First black President (1994) · Dismantled apartheid · Nobel Peace 1993 · Long Walk to Freedom · Robben Island · Reconciliation icon'},
  {n:'Leonardo da Vinci',la:43.78,ln:11.25,sub:'1452-1519 · Vinci, Italy · Renaissance Polymath',desc:'Italian Renaissance genius — painter, sculptor, architect, scientist, mathematician, engineer, inventor, anatomist, cartographer. Born in Vinci (Tuscany). Apprenticed to Verrocchio. Painted Mona Lisa (world\'s most famous painting — at Louvre), The Last Supper (Milan — most reproduced religious painting), Vitruvian Man (proportions). Filled thousands of notebook pages with scientific observations, inventions (flying machines, war machines, hydraulic pumps, armored vehicles, parachute, diving suit), anatomical drawings (dissected 30+ cadavers — detailed sketches). Designed canals, fortifications, stage machinery. Mirrored writing (left-handed script). Studied geology, botany, optics, hydrodynamics. Only 15 paintings survive. "Simplicity is the ultimate sophistication." Died at Amboise, France (Clos Lucé).',fact:'1452-1519 · Mona Lisa · Last Supper · Vitruvian Man · 15 surviving paintings · Scientific notebooks (5,000+ pages) · Dissected 30+ cadavers · Invented flying machines/parachute · Left-handed mirror writing · Renaissance Man'},
  {n:'Stephen Hawking',la:52.20,ln:0.12,sub:'1942-2018 · Oxford, UK · Physicist · Cosmologist',desc:'One of the most brilliant theoretical physicists since Einstein. Born in Oxford to a medical researcher father. At 21 diagnosed with ALS (motor neurone disease) — given 2 years to live. Defied all odds, lived to 76 using advanced communication technology. Studied at Oxford (physics) and Cambridge (PhD cosmology). Revolutionized understanding of black holes — Hawking radiation (1974) proved black holes emit radiation and eventually evaporate, solving the black hole information paradox partially. Also: - "A Brief History of Time" (1988) — sold 25M+ copies, 237 weeks on Sunday Times bestseller list — made cosmology accessible to millions - "The Universe in a Nutshell" (2001) - Worked on singularity theorems with Roger Penrose - "No-boundary proposal" with James Hartle - Predicted existence of primordial black holes - Lucasian Professor of Mathematics at Cambridge (1979-2009) — same chair as Newton - 12 honorary degrees - Presidential Medal of Freedom (2009) - ALS — used wheelchair, speech synthesizer (American accent, chosen deliberately as distinctive) - "My goal is simple. It is a complete understanding of the universe, why it is as it is and why it exists at all." - Appeared on The Simpsons, Star Trek (playing poker with Newton and Einstein) - Died March 14, 2018 (Einstein\'s birthday, Pi Day). Ashes interred in Westminster Abbey near Newton and Darwin.',fact:'1942-2018 · Hawking radiation · A Brief History of Time (25M sold) · ALS survivor to 76 · Lucasian Prof (Newton\'s chair) · Black holes · Presidential Medal · Westminster Abbey'},
  {n:'Galileo Galilei',la:43.72,ln:10.40,sub:'1564-1642 · Pisa, Italy · Astronomer · Physicist',desc:'Father of modern science — pioneered the scientific method, telescopic astronomy, and experimental physics. Born in Pisa. Studied medicine but switched to mathematics. Observed moons of Jupiter (1610) — proved Copernican heliocentric model. Discovered rings of Saturn (though thought them ears), sunspots, craters on Moon, phases of Venus. Leaning Tower of Pisa experiment (disputed — likely dropped objects from height to disprove Aristotle). Improved telescope design. Siderius Nuncius (Starry Messenger) 1610 — bestseller. Conflict with Catholic Church: - 1616: warned not to teach Copernicanism - 1632: published Dialogue Concerning Two Chief World Systems — compared Ptolemaic and Copernican - 1633: tried by Inquisition, forced to recant under threat of torture — "E pur si muove" ("And yet it moves") — apocryphal - Spent rest of life under house arrest at Arcetri Still published key works despite house arrest: Discourses and Mathematical Demonstrations Relating to Two New Sciences (1638) — foundation of modern physics (kinematics, strength of materials). Developed concept of inertia, law of falling bodies, parabolic projectile motion. Vatican formally acknowledged error in 1992. Church finally rehabilitated. "I do not feel obliged to believe that the same God who has endowed us with sense, reason, and intellect has intended us to forgo their use." Considered "father of observational astronomy, father of modern physics, father of the scientific method." Died same year as Newton\'s birth (1642).',fact:'1564-1642 · Jupiter\'s moons (1610) · Heliocentric proof · Inquisition trial (1633) · "And yet it moves" · Telescope pioneer · Two New Sciences · Pisa experiment'},
  {n:'Alan Turing',la:51.51,ln:-0.13,sub:'1912-1954 · London, UK · Computer Science Pioneer · Codebreaker',desc:'Founder of computer science, artificial intelligence, and mathematical biology. Born in London. Studied at King\'s College Cambridge, Princeton (Alonzo Church). At 24 (1936) published "On Computable Numbers" — introduced Turing machine concept (theoretical model of computation), formalized algorithms, defined limits of computability. Established the Church-Turing thesis. WWII codebreaking at Bletchley Park: - Led Hut 8 — broke German Enigma (naval encryption) - Designed Bombe (electromechanical decryption machine) — with Gordon Welchman - Developed statistical techniques (Banburismus) - Directly credited with shortening war by 2-4 years — saved millions of lives - Work kept secret for 50+ years Post-war: - Designed ACE (Automatic Computing Engine) — one of first stored-program computers - Turing Test (1950) — "Imitation Game" — foundational AI paper: "Computing Machinery and Intelligence" - Pioneered morphogenesis (mathematical biology) — pattern formation in nature (Turing patterns) - Work on chess programming Tragedy: convicted of gross indecency (1952) for homosexual acts — chose chemical castration (estrogen injections) over prison. Security clearance revoked. Lost his job at Manchester University. Died of cyanide poisoning (1954) — ruled suicide by inquest (apple half-eaten beside bed). Apple logo? Wozniak says no, though debated. Pardoned by Royal Prerogative (2013) — Turing\'s Law. Bank of England £50 note (2021). Film: The Imitation Game (2014). LGBT icon alongside scientific genius. "Sometimes it is the people no one imagines anything of who do the things that no one can imagine."',fact:'1912-1954 · Turing machine (1936) · Enigma codebreaker (WWII) · Turing Test (AI) · Morphogenesis · Chemical castration · £50 note · Pardoned 2013'},
  {n:'Isaac Newton',la:52.72,ln:-0.20,sub:'1643-1727 (OS 1642) · Woolsthorpe, UK · Physicist · Mathematician',desc:'One of the greatest scientists in human history — laid foundations of classical physics. Born at Woolsthorpe Manor, Lincolnshire (same year as Galileo\'s death). Cambridge student — but university closed 1665-67 due to Great Plague — he went home and had "annus mirabilis" (miracle year): - Developed calculus (fluxions) — though independent from Leibniz, priority dispute raged - Discovered law of universal gravitation — "apple story" (he saw apple fall in Woolsthorpe garden, wondered if same force holds Moon) - Formulated three laws of motion (1687 Principia Mathematica) - Experimented with light — white light composed of spectrum (color theory) — built first reflecting telescope (Newtonian telescope) - Discovered binomial theorem - Developed theory of color (1704 Opticks) Principia Mathematica (1687) — "Philosophiæ Naturalis Principia Mathematica" — revolutionized science: universal gravitation, three laws of motion, Kepler\'s laws derived. Halley funded publication. Considered greatest scientific book ever written. Later life: - Lucasian Professor at Cambridge (1669) - Master of the Royal Mint (combated counterfeiting, hanged forgers) - President of Royal Society (1703-1727) - Knighted (1705) by Queen Anne — first scientist knighted (political appointment) Famous rivalries: Robert Hooke (bitter priority dispute over gravity inverse-square), Leibniz (calculus). "If I have seen further it is by standing on the shoulders of giants." (Letter to Hooke, 1675 — backhanded compliment). Also wrote much on alchemy, biblical chronology, theology. He never married. Died at 84, buried in Westminster Abbey. "Nature and nature\'s laws lay hid in night: God said, Let Newton be! and all was light." (Alexander Pope).',fact:'1643-1727 · Laws of motion · Universal gravitation · Calculus · Opticks (color) · Principia (1687) · Reflecting telescope · Royal Society president · Knighted · Westminster Abbey'},
  {n:'Nikola Tesla',la:44.25,ln:15.18,sub:'1856-1943 · Smiljan, Croatia (Austrian Empire) · Inventor · Electrical Engineer',desc:'Visionary electrical engineer who pioneered AC power. Born to Serbian parents in Smiljan (now Croatia). Studied at Graz Technical University, Prague. Moved to US 1884 — worked for Thomas Edison. Broke with Edison over DC vs AC — "War of the Currents": - Invented induction motor, polyphase AC system — licensed to Westinghouse (George Westinghouse) - AC power won: Chicago World\'s Fair 1893 (Westinghouse lit fair with AC), Niagara Falls power plant 1895 - Tesla coil (high voltage transformer) - Radio transmission: US Supreme Court declared Tesla\'s patents preceded Marconi (1943) — but Marconi gets credit - Wireless power (Wardenclyffe Tower 1901-1917 — never completed due to funding pulled by JP Morgan) - X-rays experiments (before Roentgen) - Neon lights, remote control (telautomaton — radio-controlled boat 1898) - Bladeless turbine Personality: eccentric, phobias (germs, pearls, women\'s earrings), photographic memory, 3-hour sleep, died alone in NY Hotel New Yorker. Talked to pigeons. Claimed invention of death ray (teleforce). Friend of Mark Twain. "The present is theirs; the future, for which I really worked, is mine." "The scientists of today think deeply instead of clearly. One must be sane to think clearly, but one can think deeply and be quite insane." Honors: SI Unit Tesla (T) for magnetic flux density. Tesla Motors named after him. Re-evaluated in pop culture as "the man who invented the 20th century." He never married, died penniless. 700+ patents.',fact:'1856-1943 · AC power · Induction motor · Tesla coil · Wireless power · War of Currents vs Edison · Wardenclyffe · Radio pioneer · Tesla (unit) · Eccentric genius'},
  {n:'Marie Curie (extended)',la:52.24,ln:21.01,sub:'1867-1934 · Warsaw, Poland (Russian Empire) · 2 Nobels',desc:'Updated to include: married Pierre Curie 1895. Daughter Irene Joliot-Curie also Nobel laureate (1935 chemistry). Discovered polonium (named after native Poland) and radium (1898). Coined "radioactive." First woman to win Nobel, first person 2 Nobels, only woman with 2 Nobel sciences. Also: first female professor at Sorbonne (1906), Curie Institutes in Paris and Warsaw. Died of aplastic anemia from radiation exposure (carried test tubes in pockets). Notebooks still stored in lead box (radioactive for 1,500 years). International recognition: two Nobel Prizes. "Nothing in life is to be feared, it is only to be understood."',fact:'1867-1934 · 1st woman Nobel · 2 Nobels (Physics 1903, Chemistry 1911) · Radium & polonium · "Radioactivity" coined · First woman professor at Sorbonne · Lead-lined notebooks still radioactive'},
  {n:'Rosa Parks',la:32.38,ln:-86.30,sub:'1913-2005 · Tuskegee, Alabama, USA · Civil Rights Icon',desc:'African-American civil rights activist — "Mother of the Civil Rights Movement." Born in Tuskegee, Alabama. Moved to Montgomery, became NAACP secretary. On Dec 1, 1955, on Montgomery city bus #2857 (Cleveland Avenue line), she refused to give up her seat to a white man — seated in colored section, but driver ordered her to stand so white man could sit. Arrested for violating segregation law. Her arrest sparked Montgomery Bus Boycott (381 days) led by young Rev. Martin Luther King Jr. Supreme Court (Browder v. Gayle, 1956) ruled bus segregation unconstitutional. Parks lost job, received death threats. Moved to Detroit (1957). Worked for US Representative John Conyers. Continued activism throughout life. Myth vs truth: Not "tired feet" (she later said she was tired of being treated as second class). Not the first to refuse — Claudette Colvin (15, pregnant) arrested 9 months earlier — but NAACP chose Parks (respected, married, no "complications") as test case. "The only tired I was, was tired of giving in." Awards: Congressional Gold Medal (1999), Presidential Medal of Freedom (1996). Time Magazine 100 Most Important People of 20th Century. Statue in US Capitol (2013). Bus preserved at Henry Ford Museum. First woman to lie in honor in US Capitol Rotunda (2005). "I had no idea when I refused to give up my seat that I would be pushing the door open for freedom. But I had decided I would not move."',fact:'1913-2005 · Refused bus seat (Montgomery, Dec 1 1955) · Sparked Montgomery Bus Boycott · "Mother of Civil Rights Movement" · Congressional Gold Medal · Lain in honor in Capitol'},
  {n:'Florence Nightingale',la:34.99,ln:-80.62,sub:'1820-1910 · Florence, Italy (British) · Nursing Pioneer · Statistician',desc:'Founder of modern nursing. Born in Florence, Italy (wealthy British family — named after city). Defied family expectations to become nurse. Crimean War (1854-1856): led team of 38 nurses to Scutari (Üsküdar, Turkey). Found horrific conditions at British military hospital — filth, rats, lack of supplies, infectious disease (typhus, cholera, dysentery) killing 10x more soldiers than battle wounds. Reduced death rate from 42% to 2% through sanitation reforms (hand washing, clean water, ventilation). "The Lady with the Lamp" — made rounds at night checking on wounded, carrying a Turkish fanoos (lantern). Returned to England as national heroine. Major contributions beyond nursing: - Pioneer of data visualization — invented polar area diagram (coxcomb chart) to show Crimean War mortality causes — one of first use of statistical graphics for advocacy - Developed statistical methods for epidemiology and public health - Applied statistical science to healthcare — worked with William Farr and Adolphe Quetelet - Wrote "Notes on Nursing" (1859) — foundational text of nursing - Established Nightingale Training School at St Thomas\' Hospital (1860) - First woman elected to Royal Statistical Society (1858) - Improved sanitary design of hospitals Contracted Crimean fever (brucellosis) 1855 — never fully recovered, mostly bedridden for rest of life (used 50+ years of writing/advocacy from bed). Advocated for: trained nursing, public health reform, Indian Army sanitation, famine relief. Refused burial in Westminster Abbey (requested small family funeral). Buried at St Margaret\'s Church, East Wellow, Hampshire. "I attribute my success to this: I never gave or took any excuse." International Nurses Day (May 12, her birthday). Nightingale Pledge (1893). "The Lady with the Lamp."',fact:'1820-1910 · Crimean War ("Lady with the Lamp") · Founder of modern nursing · Sanitation reform · Data visualization pioneer (polar diagram) · First woman Royal Statistical Society · Notes on Nursing · Bedridden 50+ years still prolific'},
  {n:'Cleopatra VII',la:31.21,ln:29.92,sub:'69-30 BCE · Alexandria, Egypt · Last Pharaoh of Egypt',desc:'Last active ruler of Ptolemaic Kingdom of Egypt (51-30 BCE). Born in Alexandria — Greek-speaking Ptolemaic dynasty (descendant of Ptolemy I Soter, Alexander\'s general). Most famous female ruler of antiquity. Known for intelligence, political acumen, multilingual skills (spoke 9 languages — rare among Ptolemies). Noted for beauty less by contemporaries — more famous for charm, wit, voice. Key political relationships: - Julius Caesar: allied with Caesar in civil war (48-47 BCE). Had son Caesarion (Ptolemy XV), whom she claimed was Caesar\'s. Roman Civil War (Pompey vs Caesar): Cleopatra backed Caesar — famously smuggled into palace rolled in carpet? Actually rolled in linen sack — but not "carpet" (ancient Greeks rugs). Convinced Caesar to restore her throne. - Mark Antony: allied after Caesar\'s assassination (44 BCE). Married 37 BCE — triple alliance with Rome\'s eastern territories. Had three children (twins Alexander Helios, Cleopatra Selene, and Ptolemy Philadelphus). Huge political/military ambition — planned to make Alexandria capital of a new Hellenistic empire. Battle of Actium (31 BCE): Antony and Cleopatra\'s fleet defeated by Octavian (later Augustus). Both fled to Egypt. Antony died in Cleopatra\'s arms (stabbed himself). Cleopatra tried to charm Octavian (failed). Died Aug 12, 30 BCE — famously killed by asp (Egyptian cobra) bite — though modern scholars debate exact cause (poison, hemlock?). History won by Romans — demonized as seductress. Legacy: Shakespeare\'s Antony and Cleopatra. Elizabeth Taylor film (1963). Symbol of female power, intelligence, and romantic tragedy. Dead Sea Scrolls? no connection. Supposed lover list: Caesar, Antony... but not Pompey. All male historians wrote: Roman propaganda (Octavian painted her as foreign seductress). Egyptians remembered her as wise, capable pharaoh. Suicide ended Hellenistic era, began Roman Egypt.',fact:'69-30 BCE · Last pharaoh of Egypt · Caesar & Antony alliances · 9 languages · Battle of Actium (31 BCE) · Died by asp bite (legend) · Hellenistic era end · Roman propaganda victim'},
  {n:'Genghis Khan',la:47.80,ln:108.30,sub:'1162-1227 · Delüün Boldog, Mongolia · Founder of Mongol Empire',desc:'Founder of the Mongol Empire — the largest contiguous land empire in history (24M km², 1/4 of world\'s land area). Born Temüjin in Khentii Mountains. Father Yesügei poisoned when he was 9. Clan abandoned family — mother Höelün raised children alone in harsh steppe conditions. Killed half-brother Bekhter at 13 for stealing food. Captured as slave by Tayichiud clan, escaped. Through alliances, warfare, and meritocracy, united all Mongol tribes by 1206 at kurultai (Great Assembly) given title "Chinggis Khaan" (Universal Ruler). Revolutionary military organization: - Decimal system (arbans 10, zuuns 100, mingghans 1,000, tümens 10,000) - Meritocracy over aristocracy - Composite bow from horseback (deadly 300m range) - Excellent logistics, mobility, intelligence, psychological warfare Conquests: - Northern China (Jin Dynasty, Western Xia) — defeated Xi Xia 1209, Jin 1234 - Khwarezmian Empire (Persia/Central Asia) 1219-1221 — responded to execution of Mongol envoys - Sacked Bukhara, Samarkand, Merv, Nishapur, Herat - Army reached Caucasus, Kievan Rus (1223 Battle of Kalka River) - Died 1227 during campaign against Western Xia (Tangut). Burial location secret — forest replanted over grave, horses trampled. Legend says river diverted over grave, all executioners killed. Government innovations: - Yassa law code — codified customs for the empire - Religious tolerance (all faiths exempt from tax) - Silk Road unified under one rule — trade flourished East-West for first time - Invented postal relay system (yam) — 1,500 mile messages in 2 days - Uyghur script adopted for Mongolian language - Promoted international trade, protected merchants (ortagh) Legacy: conquered more land in 25 years than Rome in 400. 40M+ people killed (some claims). 1 in 200 men today descended from him (Y-chromosome lineage). Founder of Yuan Dynasty (grandson Kublai Khan). "The greatest happiness is to vanquish your enemies, to chase them before you, to rob them of their wealth, to see those dear to them bathed in tears, to clasp to your bosom their wives and daughters."',fact:'1162-1227 · Founder of Mongol Empire (largest contiguous land empire) · Temüjin united tribes 1206 · Conquered China & Central Asia · Meritocracy · Silk Road unifier · Yassa law · 1 in 200 men descended from him'},
  {n:'Katherine Johnson',la:38.00,ln:-81.32,sub:'1918-2020 · White Sulphur Springs, WV, USA · NASA Mathematician',desc:'African-American NASA mathematician whose calculations were critical to early US space missions. Born Creola Katherine Coleman in West Virginia. Father was a farmer/woodcutter and insisted children get education. Intellectually gifted — skipped grades, entered high school at 10, graduated at 14. Earned degrees in mathematics and French from West Virginia State College (summa cum laude, 1937). Selected as one of first three African-American graduate students at West Virginia University (1939). NASA career: hired at NACA Langley (1953) as part of West Area Computers — all-Black female math pool. Worked in Flight Research Division (Langley). Performed trajectory analysis for: - Alan Shepard\'s Freedom 7 (1961) — first American in space — calculated launch window, trajectory. - John Glenn\'s Friendship 7 (1962) — first American orbital mission. Glenn personally asked Johnson to verify trajectory calculations (computers were new and untrusted): "Get the girl to check the numbers. If she says the numbers are good, I\'m ready to go." She did — later matched by IBM computer. - Apollo 11 (1969) — calculated lunar module rendezvous with command module - Apollo 13 (1970) — helped develop backup navigation charts for safe return after explosion - Space Shuttle program (early 1980s) Co-authored 26 research reports. Retired 1986. Received Presidential Medal of Freedom (2015) from Obama at 97. Subject of book and film Hidden Figures (2016). Taraji P. Henson portrayed her. NASA Langley Research Center named Katherine Johnson Computational Research Facility (2017). Minor planet (25178) named Shanshandongcun? — no, named after her: 202777 Johnson. "I counted everything. I counted the steps to the road, the steps up to church, the number of dishes and silverware I washed... anything that could be counted, I did." "Girls are capable of doing everything men are capable of doing. Sometimes they have more imagination than men." Died Feb 24, 2020 at 101 — one of the last surviving hidden figures. Her story inspired millions of girls of color to pursue STEM.',fact:'1918-2020 · NASA mathematician · Calculated trajectory for Shepard, Glenn, Apollo 11, Apollo 13 · "Get the girl to check the numbers" · Hidden Figures · Presidential Medal of Freedom (2015) · West Area Computers'},
];
D.highway = [
  {n:'NH 44 (Srinagar-Kanyakumari)',sub:'India\'s longest NH · 3,745 km',desc:'Longest national highway in India. Connects Srinagar to Kanyakumari passing through J&K, Punjab, Haryana, Delhi, UP, MP, Maharashtra, Telangana, AP, TN. Old NH 1A, 1, 2, 3, 7 merged. Key corridor of India.',fact:'3,745 km (longest) · North-South Corridor part · 4-lane (partly 6) · Connects 11 states',pts:[{la:34.08,ln:74.79},{la:32.74,ln:74.87},{la:31.60,ln:75.00},{la:30.35,ln:75.87},{la:28.70,ln:77.10},{la:27.50,ln:77.70},{la:26.50,ln:78.50},{la:25.50,ln:79.50},{la:24.50,ln:80.00},{la:23.20,ln:79.90},{la:21.20,ln:79.10},{la:20.00,ln:78.80},{la:18.50,ln:78.10},{la:17.40,ln:78.50},{la:16.50,ln:80.50},{la:14.50,ln:79.50},{la:13.10,ln:79.50},{la:12.60,ln:79.40},{la:11.70,ln:79.50},{la:10.80,ln:79.80},{la:9.90,ln:79.50},{la:8.50,ln:78.10},{la:8.10,ln:77.50}]},
  {n:'NH 48 (Delhi-Chennai)',sub:'Delhi-Chennai · 2,807 km',desc:'Connects Delhi to Chennai via Jaipur, Udaipur, Ahmedabad, Vadodara, Mumbai, Pune, Bangalore. Golden Quadrilateral segment. Major arterial highway.',fact:'Golden Quadrilateral part · 4-6 lane · Connects 7 states',pts:[{la:28.60,ln:77.20},{la:27.00,ln:76.00},{la:26.90,ln:75.80},{la:24.60,ln:73.70},{la:22.30,ln:73.20},{la:21.20,ln:72.90},{la:19.10,ln:72.90},{la:18.50,ln:73.80},{la:12.95,ln:77.60},{la:13.10,ln:79.50},{la:13.08,ln:80.27}]},
  {n:'NH 19 (Delhi-Kolkata)',sub:'Delhi-Kolkata · 1,435 km',desc:'Connects Delhi to Kolkata via Mathura, Agra, Kanpur, Vardhman. Part of historic Grand Trunk Road. Golden Quadrilateral segment. Old NH 2.',fact:'Grand Trunk Road · Golden Quadrilateral · 4-6 lane · 1,435 km',pts:[{la:28.60,ln:77.20},{la:27.50,ln:77.70},{la:27.20,ln:78.00},{la:26.50,ln:80.30},{la:25.50,ln:81.50},{la:25.30,ln:83.00},{la:24.80,ln:84.50},{la:23.70,ln:85.50},{la:23.30,ln:87.30},{la:22.60,ln:88.40}]},
  {n:'NH 27 (Porbandar-Silchar)',sub:'Porbandar-Silchar · 3,507 km',desc:'East-West Corridor + extension. Connects Gujarat to Assam. Passes through Rajasthan, MP, UP, Bihar, WB, Assam. Major route for NE connectivity.',fact:'EW Corridor · 3,507 km · Connects 8 states · NH 31 extension',pts:[{la:21.60,ln:69.60},{la:22.30,ln:70.80},{la:23.30,ln:72.60},{la:24.60,ln:73.70},{la:25.10,ln:75.80},{la:26.50,ln:80.30},{la:25.80,ln:83.50},{la:25.30,ln:85.50},{la:24.80,ln:87.00},{la:23.50,ln:88.50},{la:24.00,ln:89.50},{la:24.80,ln:92.80}]},
  {n:'Golden Quadrilateral',sub:'Delhi-Mumbai-Chennai-Kolkata · 5,846 km',desc:'India\'s largest highway project. 4/6-lane highways connecting 4 metro cities: Delhi, Mumbai, Chennai, Kolkata. Completed 2012 (started 2001). Part of National Highways Development Project (NHDP).',fact:'5,846 km total · NHDP Phase 1 · Completed 2012 · 4 metro cities · 13 states',pts:[{la:28.60,ln:77.20},{la:27.00,ln:76.00},{la:24.60,ln:73.70},{la:22.30,ln:73.20},{la:19.10,ln:72.90},{la:18.50,ln:73.80},{la:12.95,ln:77.60},{la:13.08,ln:80.27},{la:16.50,ln:80.50},{la:19.10,ln:84.80},{la:21.50,ln:86.60},{la:22.60,ln:88.40},{la:25.30,ln:83.00},{la:26.50,ln:80.30},{la:27.20,ln:78.00},{la:28.60,ln:77.20}]},
  {n:'Delhi-Mumbai Expressway',sub:'Delhi-Mumbai · 1,350 km',desc:'India\'s longest expressway (under construction/partially open). 8-12 lane access-controlled. Reduces Delhi-Mumbai travel from 24 to 12 hours. Saves 30% distance vs NH 48.',fact:'1,350 km (longest expressway) · 8-12 lane · 12 hrs travel · 30% shorter',pts:[{la:28.60,ln:77.20},{la:28.10,ln:77.00},{la:27.60,ln:76.60},{la:27.10,ln:76.40},{la:26.50,ln:75.80},{la:25.90,ln:75.30},{la:25.50,ln:74.80},{la:24.80,ln:74.00},{la:23.80,ln:73.50},{la:23.50,ln:73.00},{la:22.80,ln:72.50},{la:22.00,ln:72.00},{la:21.20,ln:71.50},{la:20.50,ln:71.00},{la:19.80,ln:70.50},{la:19.00,ln:70.00}]},
  {n:'Yamuna Expressway',sub:'Delhi-Agra · 165 km',desc:'6-lane access-controlled expressway. Connects Noida (Delhi NCR) to Agra via Mathura. Built by Jaypee Group. Travel time 3 hrs → 90 min.',fact:'165 km · 6-lane · 12 min to Jewar Airport · First built by private sector',pts:[{la:28.50,ln:77.50},{la:28.20,ln:77.60},{la:27.80,ln:77.70},{la:27.50,ln:78.00}]},
  {n:'Mumbai-Pune Expressway',sub:'Mumbai-Pune · 94.5 km',desc:'India\'s first 6-lane access-controlled expressway (opened 2002). 25 tunnels, 17 flyovers. Cuts travel from 4 to 2 hrs. BOT basis.',fact:'First expressway in India · 94.5 km · 25 tunnels · 6-lane · Tolled',pts:[{la:19.10,ln:72.90},{la:18.90,ln:73.20},{la:18.70,ln:73.40},{la:18.55,ln:73.60},{la:18.50,ln:73.80}]},
  {n:'Eastern Peripheral Expressway',sub:'NCR outer ring · 135 km',desc:'Ring road around Delhi on eastern side. 6-lane access-controlled. Decongests Delhi. Connects NH 44 (Ghaziabad) to NH 48 (Faridabad).',fact:'135 km · 6-lane · Green expressway · Decongests Delhi · CCTV monitored',pts:[{la:28.70,ln:77.40},{la:28.60,ln:77.50},{la:28.40,ln:77.40},{la:28.20,ln:77.35},{la:28.00,ln:77.30},{la:27.80,ln:77.25},{la:27.60,ln:77.20},{la:27.40,ln:77.20},{la:27.30,ln:77.20}]},
  {n:'Mumbai-Nagpur Expressway (Samruddhi)',sub:'Mumbai-Nagpur · 701 km',desc:'Maharashtra\'s longest expressway. 6-lane (expandable to 8). Reduces Mumbai-Nagpur travel from 16 to 8 hrs. Connects 24 districts.',fact:'701 km · 6-lane · 8 hrs travel · 24 districts · MSRDC project',pts:[{la:19.10,ln:72.90},{la:19.50,ln:73.00},{la:19.80,ln:73.50},{la:20.00,ln:74.00},{la:20.30,ln:74.50},{la:20.50,ln:75.00},{la:20.80,ln:75.50},{la:21.00,ln:76.00},{la:21.10,ln:76.50},{la:21.20,ln:77.00},{la:21.15,ln:77.50},{la:21.10,ln:78.00},{la:21.15,ln:78.50},{la:21.15,ln:79.00},{la:21.15,ln:79.50},{la:21.10,ln:80.00},{la:21.10,ln:80.50},{la:21.15,ln:81.00}]},
  {n:'Purvanchal Expressway',sub:'Lucknow-Ghazipur · 340 km',desc:'UP\'s longest expressway. 6-lane (expandable to 8). Inaugurated 2021. Connects Lucknow to Ghazipur near Bihar border. Airstrip for emergency landings.',fact:'340 km · 6-lane · Airstrip on expressway · Lucknow-Ghazipur · UP longest',pts:[{la:26.80,ln:80.90},{la:26.50,ln:81.00},{la:26.20,ln:81.50},{la:26.00,ln:82.00},{la:25.80,ln:82.50},{la:25.60,ln:83.00},{la:25.40,ln:83.50},{la:25.30,ln:83.60}]},
  {n:'Agra-Lucknow Expressway',sub:'Agra-Lucknow · 302 km',desc:'6-lane access-controlled expressway. Connects Agra to Lucknow. Part of UP Expressway network.',fact:'302 km · 6-lane · Agra-Lucknow in 3.5 hrs',pts:[{la:27.20,ln:78.00},{la:27.00,ln:78.50},{la:26.80,ln:79.00},{la:26.60,ln:79.50},{la:26.80,ln:80.90}]},
     {n:'Delhi-Saharanpur-Dehradun Expressway',sub:'Delhi-Dehradun · 210 km',desc:'Under construction. Reduces Delhi-Dehradun travel from 6 to 2.5 hrs. 6-lane with greenfield alignment.',fact:'210 km · 6-lane · 2.5 hrs travel · Wildlife corridor features',pts:[{la:28.60,ln:77.20},{la:28.80,ln:77.30},{la:29.00,ln:77.50},{la:29.50,ln:77.60},{la:30.00,ln:77.80},{la:30.30,ln:78.00}]},
   {n:'NH 52 (Kharagpur-UP border)',sub:'Kharagpur-Uttarakhand · 3,650 km',desc:'India\'s second longest NH. Connects Kharagpur (WB) to Bibinagar (Pauri Garhwal) via Odisha, AP, MP, Rajasthan, Delhi, UP, UK. Long north-south corridor.',fact:'3,650 km (2nd longest) · Kharagpur-Bibinagar · 8 states · NW-SE corridor',pts:[{la:22.30,ln:87.30},{la:21.50,ln:86.00},{la:20.30,ln:85.50},{la:19.30,ln:84.50},{la:18.50,ln:83.50},{la:17.50,ln:82.50},{la:16.50,ln:82.00},{la:15.50,ln:80.00},{la:14.50,ln:79.50},{la:13.50,ln:79.00},{la:12.50,ln:78.50},{la:11.50,ln:77.50},{la:10.50,ln:77.00},{la:9.50,ln:78.00},{la:8.50,ln:77.50}]},
   {n:'NH 66 (Mumbai-Kanyakumari)',sub:'Mumbai-Kanyakumari · 2,200 km',desc:'Coastal highway along India\'s west coast. Connects Mumbai to Kanyakumari via Goa, Karnataka, Kerala. Konkan coast route. Scenic coastal driving.',fact:'2,200 km · West coast highway · Konkan route · Mumbai-Kanyakumari · Scenic coastal',pts:[{la:19.10,ln:72.90},{la:18.50,ln:73.00},{la:17.70,ln:73.20},{la:16.80,ln:73.50},{la:15.50,ln:73.80},{la:14.50,ln:74.00},{la:13.50,ln:74.00},{la:12.50,ln:74.50},{la:11.50,ln:75.00},{la:10.50,ln:76.00},{la:9.50,ln:76.50},{la:8.50,ln:77.00}]},
   {n:'NH 16 (Kolkata-Chennai)',sub:'Kolkata-Chennai · 1,710 km',desc:'Golden Quadrilateral coastal segment. Connects Kolkata to Chennai via Bhubaneswar, Visakhapatnam, Vijayawada. East coast road.',fact:'Golden Quadrilateral · 1,710 km · East coast · Kolkata-Chennai · 4 states',pts:[{la:22.60,ln:88.40},{la:21.50,ln:86.60},{la:20.30,ln:85.80},{la:19.10,ln:84.80},{la:18.50,ln:84.00},{la:17.70,ln:83.30},{la:16.50,ln:80.60},{la:15.50,ln:80.00},{la:14.50,ln:79.50},{la:13.50,ln:79.50},{la:13.08,ln:80.27}]},
   {n:'National Highway 5 (Chennai-Howrah)',sub:'Chennai-Howrah · 1,533 km',desc:'Major east coast highway connecting Chennai to Howrah. Part of NH 16 designation now. Industrial corridor route.',fact:'1,533 km · East coast · Chennai-Kolkata · Industrial corridor',pts:[{la:13.08,ln:80.27},{la:14.00,ln:79.80},{la:15.00,ln:80.00},{la:16.00,ln:80.50},{la:17.00,ln:81.50},{la:18.00,ln:83.00},{la:19.00,ln:84.50},{la:20.00,ln:85.50},{la:21.00,ln:86.50},{la:22.50,ln:88.00}]},
   {n:'Mumbai-Goa NH 66 stretch',sub:'Mumbai-Goa · 580 km',desc:'Scenic coastal route along Konkan coast. NH 66 (old NH 17). Palms, beaches, and sea views. Connects Mumbai to Goa via Ratnagiri, Sawantwadi.',fact:'580 km · Konkan coast · NH 66 · Scenic drive · Beach route',pts:[{la:19.10,ln:72.90},{la:18.50,ln:73.00},{la:17.70,ln:73.20},{la:16.80,ln:73.50},{la:16.00,ln:73.70},{la:15.85,ln:73.80},{la:15.50,ln:73.80}]},
   {n:'NH 39 (Jalandhar-Khajuraho)',sub:'Jalandhar-Khajuraho · 1,100 km',desc:'NH connecting Jalandhar to Khajuraho via Delhi, Agra, Jhansi. Key route to central India\'s heritage sites.',fact:'1,100 km · Jalandhar-Khajuraho · Heritage route · Delhi-Agra-Jhansi',pts:[{la:31.30,ln:75.60},{la:30.00,ln:76.00},{la:28.60,ln:77.20},{la:27.20,ln:78.00},{la:25.50,ln:78.50},{la:24.80,ln:79.50}]},,
  {n:'Pan-American Highway',la:10,ln:-75,sub:'Alaska to Argentina · 48,000km',desc:'World\'s longest motorable road (48,000km). 14 countries from Alaska to Argentina. Only gap: Darién Gap (106km jungle). Alaska Highway built 1942 for WWII. Inter-American Highway, Carretera Panamericana. Highest: Cerro de la Muerte (3,491m). 8,000+ bridges. 2012 Guinness record. 2023 Darién Gap migrant crisis (500k+ crossed).',fact:'48,000km (world\'s longest) · 14 countries · Alaska to Argentina · Darién Gap · Alaska Highway (WWII) · Carretera Panamericana · 8,000+ bridges · migrant crisis'},
  {n:'Trans-Siberian Highway',la:56,ln:100,sub:'Russia · 11,000km · St. Petersburg to Vladivostok',desc:'Longest national highway (11,000km). 7 time zones. Amur Highway completed 2010. Kolyma Highway (Road of Bones) built by Gulag prisoners (500k+ died). Lake Baikal scenic section. Parallels Trans-Siberian Railway. -50°C to +35°C. M11 Moscow-St. Petersburg toll road. Asian Highway AH6.',fact:'11,000km (longest national) · St. Petersburg to Vladivostok · 7 time zones · Amur Highway (2010) · Kolyma Highway (Road of Bones) · Lake Baikal · M11 toll road · Asian Highway AH6'},
  {n:'Great Ocean Road',la:-38.5,ln:143.5,sub:'Australia · Victoria · 243km',desc:'243km coastal highway. Built 1919-1932 by returned WWI soldiers — world\'s largest war memorial. 12 Apostles limestone stacks. London Arch. Loch Ard Gorge. Great Otway NP rainforest. Bells Beach surf. 2.5M visitors/year. Torquay surf capital. 100+ shipwrecks. Koalas, kangaroos, wombats along route.',fact:'243km · WWI memorial road (returned soldiers) · 12 Apostles · London Arch · Loch Ard Gorge · Bells Beach · Great Otway NP · 2.5M visitors/year · Shipwreck Coast· koalas & kangaroos'},
  {n:'Amalfi Coast Road (SS163)',la:40.63,ln:14.53,sub:'Italy · 50km · Salerno to Sorrento',desc:'Strada Statale 163 — 50km carved into cliffs above Tyrrhenian Sea. Built 1832-1852 by Bourbon king Ferdinand II. 1,000+ curves. Positano, Amalfi, Ravello. UNESCO 1997. 3M+ visitors/year. Limoncello lemons. 400+ churches. Emerald Grotto sea cave. Ravello gardens. Filmed in Under the Tuscan Sun. Over-tourism concerns.',fact:'50km · SS163 · built 1832-1852 · 1,000+ curves · UNESCO 1997 · Positano, Amalfi, Ravello · limoncello · Emerald Grotto · 3M+ visitors/year · Divine Coast'},
  {n:'North Yungas Road (Death Road)',la:-16.3,ln:-67.8,sub:'Bolivia · 69km · La Paz to Coroico',desc:'Known as Death Road — one of most dangerous in world. 69km, 3.2m wide, 600m drops. 200-300 deaths/year (1990s). Now a mountain biking destination (40,000+ cyclists/year). 64km downhill from 4,700m to 1,200m. Built 1930s by Paraguayan POWs. New safer road opened 2006. Coca tea for altitude.',fact:'69km · Death Road · 600m drops, 3.2m wide · 200-300 deaths/year (1990s) · now mountain biking · 40,000+ cyclists/year · 3,600m elevation drop · Top Gear Bolivia · new road 2006'}

];
D.i_range = [
  {n:'Himalayas (Great Himalaya Range)',sub:'Northern India · 2,400 km',desc:'World\'s highest mountain range. Spans 5 Indian states (J&K, HP, UK, Sikkim, Arunachal). Contains 9 of 10 highest peaks on Earth (Everest 8,848m, K2 8,611m, Kanchenjunga 8,586m). Formed by India-Eurasia plate collision (~50 mya). 3 parallel ranges: Himadri (Greater), Himachal (Lesser), Siwalik (Outer). Major glaciers: Gangotri, Siachen, Zemu. Perennial rivers: Indus, Ganga, Brahmaputra. Acts as climate barrier.',fact:'2,400 km · 3 parallel ranges · 9/10 highest peaks · Youngest fold mountains · India-Eurasia collision · Permafrost & glaciers · Climate barrier for India',pts:[{la:36.50,ln:73.00},{la:36.00,ln:75.00},{la:35.50,ln:77.00},{la:35.00,ln:79.00},{la:34.00,ln:80.00},{la:33.00,ln:81.00},{la:32.00,ln:82.00},{la:31.00,ln:83.00},{la:30.00,ln:84.00},{la:29.50,ln:85.00},{la:28.50,ln:86.00},{la:28.00,ln:87.00},{la:27.50,ln:88.00},{la:27.00,ln:89.00},{la:27.00,ln:90.00},{la:27.50,ln:91.00},{la:28.00,ln:92.00},{la:29.00,ln:94.00},{la:28.50,ln:96.00},{la:28.00,ln:97.00}]},
  {n:'Western Ghats (Sahyadri)',sub:'Western India · 1,600 km',desc:'Mountain range parallel to India\'s west coast. UNESCO World Heritage (2012). One of 8 hottest biodiversity hotspots. Older than Himalayas. Runs from Gujarat to Kanyakumari spread across 6 states. Average elevation 1,000-2,500m. Highest peak: Anamudi (2,695m in Kerala). Important for rainfall (orographic) — receives 2,500-6,000mm/year. Major passes: Bhor (NH 48), Palakkad, Thal, Amboli. Rich in endemic flora & fauna: lion-tailed macaque, Nilgiri tahr, Malabar hornbill.',fact:'1,600 km · UNESCO WHS (2012) · 6 states · Anamudi (2,695m) · Biodiversity hotspot · Orographic rainfall · 39 UNESCO World Heritage sites',pts:[{la:21.50,ln:73.00},{la:20.50,ln:73.50},{la:19.50,ln:73.30},{la:18.50,ln:73.50},{la:17.50,ln:73.80},{la:16.50,ln:74.00},{la:15.50,ln:74.30},{la:14.50,ln:74.80},{la:13.50,ln:75.50},{la:12.50,ln:76.00},{la:11.50,ln:76.50},{la:10.50,ln:77.00},{la:9.50,ln:77.30},{la:8.50,ln:77.50}]},
  {n:'Eastern Ghats',sub:'Eastern India · 1,750 km',desc:'Discontinuous mountain range along India\'s east coast. Runs from Odisha through AP, Telangana to TN. Lower elevation than Western Ghats (600-1,200m). Highest peak: Arma Konda (1,680m in AP). Broken by four major rivers: Godavari, Mahanadi, Krishna, Kaveri. Rich in bauxite, iron ore. Jeypore tract — rich biodiversity. Important tribal population.',fact:'1,750 km · 4 states · Discontinuous (broken by rivers) · Arma Konda (1,680m) · Minerals (bauxite, iron ore) · Tribal belt',pts:[{la:20.50,ln:86.00},{la:19.50,ln:83.50},{la:18.50,ln:83.00},{la:17.50,ln:82.50},{la:16.50,ln:82.50},{la:15.50,ln:80.00},{la:14.50,ln:79.50},{la:13.50,ln:79.50},{la:12.50,ln:79.00},{la:11.50,ln:78.50},{la:10.50,ln:78.50}]},
  {n:'Vindhya Range',sub:'Central India · 1,200 km',desc:'Ancient east-west mountain range separating North and South India. Runs across MP, UP, Bihar. Acts as traditional boundary between Aryavarta (north) and Deccan (south). Source of Narmada, Son rivers. Average elevation 300-600m. Important for sandstone, limestone. Kalinjar Fort, Rewa region.',fact:'1,200 km · E-W range · North-South India divide · Narmada & Son source · 300-600m · Sandstone',pts:[{la:24.00,ln:80.00},{la:23.50,ln:81.00},{la:23.00,ln:82.00},{la:22.50,ln:83.00},{la:22.00,ln:84.00}]},
  {n:'Satpura Range',sub:'Central India · 900 km',desc:'East-west range parallel to Vindhya south of Narmada River. Runs across MP, Maharashtra, Chhattisgarh. Higher than Vindhyas (600-1,350m). Highest peak: Dhupgarh (1,350m). Seven mountain spurs (Satpura = 7 folds). Includes Pachmarhi, Satpura NP. Tapti and Narmada rivers originate here.',fact:'900 km · E-W range · South of Narmada · Dhupgarh (1,350m) · 7 folds · Satpura NP · Tapti source',pts:[{la:22.50,ln:77.50},{la:22.30,ln:78.00},{la:22.00,ln:79.00},{la:21.80,ln:80.00},{la:21.50,ln:81.00},{la:21.00,ln:82.00}]},
  {n:'Aravalli Range',sub:'NW India · 800 km',desc:'Oldest fold mountain range in India (Precambrian). Runs from Gujarat through Rajasthan to Delhi. Highest peak: Guru Shikhar (1,722m on Mount Abu). Heavily eroded — oldest surviving mountain range on Earth (over 2 billion years). Rich in minerals: copper, zinc, lead, marble. Contains Delhi Ridge — green lung for Delhi.',fact:'800 km · Oldest fold mts (2B+ years) · Guru Shikhar (1,722m) · Mineral-rich · Delhi Ridge · Highly eroded',pts:[{la:24.60,ln:72.70},{la:25.00,ln:73.00},{la:25.50,ln:73.50},{la:26.00,ln:74.00},{la:26.50,ln:74.50},{la:27.00,ln:75.00},{la:27.50,ln:75.50},{la:28.00,ln:76.20},{la:28.50,ln:77.00},{la:28.60,ln:77.20}]},
  {n:'Nilgiri Hills',sub:'South India · 2,400m avg',desc:'Mountain range forming tri-junction of TN, Kerala, Karnataka. Part of Western Ghats. Known for tea plantations, Ooty, Coonoor, Kotagiri. Highest: Doddabetta (2,637m). Nilgiri Biosphere Reserve. Nilgiri Mountain Railway (UNESCO). Rich Shola forests.',fact:'Doddabetta (2,637m) · Ooty · Tea · Nilgiri Biosphere · NM Railway (UNESCO) · Shola forests',pts:[{la:11.50,ln:76.50},{la:11.40,ln:76.70},{la:11.30,ln:76.80}]},
  {n:'Cardamom Hills',sub:'South India · 1,600m avg',desc:'Southernmost part of Western Ghats in Kerala and Tamil Nadu. Known for spice cultivation (cardamom, pepper, coffee). Periyar NP, Anamudi peak. Idukki Dam. Rich rainforest ecosystem.',fact:'Cardamom/pepper/coffee · Periyar NP · Anamudi · Idukki Dam · Rainforest',pts:[{la:9.50,ln:77.30},{la:9.80,ln:77.20},{la:10.10,ln:77.10}]},
  {n:'Anaimalai Hills',sub:'South India · 2,695m',desc:'Mountain range in Western Ghats (Kerala-TN border). Anamudi (2,695m) — highest peak in South India at Eravikulam NP. Indira Gandhi WLS. Elephants, tigers, Nilgiri tahr.',fact:'Anamudi (2,695m) · Highest in South India · Eravikulam NP · Indira Gandhi WLS',pts:[{la:10.00,ln:77.00},{la:10.30,ln:77.20},{la:10.60,ln:77.00}]},
  {n:'Pir Panjal Range',sub:'Himachal/J&K · 5,000m avg',desc:'Major sub-range of the Himalayas (Lesser/Lower Himalayas). Runs from J&K through HP. Highest peak: Indrasan (6,221m). Pir Panjal Pass (3,480m) connects J&K to Ladakh. Famous for Kashmir valley on its north. Ski resort Gulmarg. Important passes: Banihal, Rohtang La, Pir Panjal.',fact:'Lower Himalayas · 6,221m (Indrasan) · Pir Panjal Pass (3,480m) · Gulmarg ski · Banihal & Rohtang passes',pts:[{la:34.00,ln:74.00},{la:33.50,ln:75.00},{la:33.00,ln:76.00},{la:32.50,ln:77.00},{la:32.00,ln:78.00}]},
  {n:'Zaskar Range',sub:'J&K/Ladakh · 6,000m avg',desc:'Sub-range of the Himalayas in Ladakh and Zaskar region. Famous for challenging mountaineering (Nun 7,135m, Kun 7,077m). Several glaciers. Zaskar River deep gorges. Stok Kangri popular trekking peak. Contains highest motorable road (Khardung La 5,359m).',fact:'Nun (7,135m) & Kun (7,077m) · Khardung La (highest road) · Stok Kangri · Zaskar River gorges',pts:[{la:34.50,ln:76.00},{la:34.00,ln:77.00},{la:33.50,ln:78.00},{la:33.00,ln:79.00}]},
  {n:'Karakoram Range',sub:'J&K/Ladakh · 8,000m avg',desc:'Second highest range in the world — part of Greater Himalayas. Stretches 500 km across Pakistan, China, India. Contains K2 (8,611m — 2nd highest on Earth) and 60+ peaks over 7,000m. Siachen Glacier (76 km — longest in Karakoram). Karakoram Pass (4,775m). Karakoram Highway to China.',fact:'K2 (8,611m) · 60+ peaks over 7,000m · Siachen Glacier (76 km) · Karakoram Pass · Spectacular peaks',pts:[{la:36.00,ln:74.00},{la:35.50,ln:75.00},{la:35.00,ln:76.00},{la:34.50,ln:77.00}]},
     {n:'Purvanchal Range',sub:'NE India · 1,200 km',desc:'Eastern extension of the Himalayas in Northeast India. Comprises Patkai Hills, Naga Hills, Manipur Hills, Mizo Hills, Tripura Hills. Lower elevation (500-3,000m). Dense tropical rainforests, high rainfall. Rich in biodiversity, tribal culture. Border with Myanmar along Patkai.',fact:'NE extension · Patkai, Naga, Mizo, Tripura hills · 500-3,000m · Dense rain forests · Myanmar border',pts:[{la:27.00,ln:96.00},{la:26.50,ln:95.00},{la:26.00,ln:94.50},{la:25.50,ln:94.00},{la:24.50,ln:93.50},{la:23.50,ln:93.00},{la:22.50,ln:92.50},{la:21.50,ln:92.50}]},
   {n:'Ladakh Range',sub:'Ladakh · 6,000m avg',desc:'Northernmost mountain range in India. Part of the Trans-Himalayas. Runs southeast of Karakoram. Leh and Nubra Valley. High-altitude cold desert. Indus River valley. Famous passes: Khardung La, Chang La.',fact:'Trans-Himalaya · Leh & Nubra · 6,000m avg · Khardung La · Indus valley',pts:[{la:34.00,ln:76.00},{la:34.50,ln:77.00},{la:34.80,ln:77.50},{la:35.00,ln:78.00}]},
   {n:'Kailash Range (Mt Kailash)',sub:'Tibet · 6,638m · Sacred peak',desc:'Extremely sacred peak in Tibetan Buddhism, Hinduism, Jainism, Bön. Located in Tibet near India-Nepal border. Circumambulation (kora/parikrama) 52km. Mount Kailash never climbed. Source of Brahmaputra, Indus, Sutlej, Karnali rivers.',fact:'6,638m · Sacred to 4 religions · Unclimbed · River source · 52km kora · Tibet',pts:[{la:31.07,ln:81.33},{la:31.10,ln:81.28},{la:31.20,ln:81.20},{la:31.30,ln:81.30}]},
   {n:'Dhauladhar Range',sub:'HP · 5,000m avg · White Range',desc:'Southern part of Himalayas in Himachal Pradesh. Dhauladhar = "White Peak/White Range". Rising dramatically above Kangra valley. Dharamshala and McLeodganj at base. Famous for trekking. Snow-covered year-round. Paragliding in Bir-Billing.',fact:'White Range · HP · Dharamshala · Kangra Valley · Trekking · Bir-Billing paragliding',pts:[{la:32.50,ln:75.80},{la:32.30,ln:76.00},{la:32.20,ln:76.30},{la:32.10,ln:76.50},{la:32.00,ln:76.80}]},
   {n:'Naga Hills',sub:'Nagaland · 3,800m avg',desc:'Part of Purvanchal range along India-Myanmar border. Highest peak: Mt Saramati (3,841m). Naga tribes — headhunting history. Dense forests. Rich biodiversity. Kohima and Dimapur in foothills. Known for Naga chillies (bhut jolokia).',fact:'Purvanchal · Saramati (3,841m) · India-Myanmar border · Naga tribes · Bhut Jolokia',pts:[{la:26.00,ln:94.50},{la:25.80,ln:95.00},{la:25.50,ln:95.20},{la:25.00,ln:95.00}]},
   {n:'Patkai Hills',sub:'Arunachal/Nagaland · 2,000m avg',desc:'Eastern hills forming India-Myanmar border. Part of Purvanchal range. Dense tropical forests. Famous for Stilwell Road (WWII). Oil fields in Digboi region. Biodiversity hotspot. Ornamental orchids.',fact:'India-Myanmar border · Stilwell Road (WWII) · Digboi oil · Purvanchal · Orchids',pts:[{la:27.50,ln:96.00},{la:27.00,ln:96.50},{la:26.50,ln:97.00},{la:26.00,ln:97.00}]},
   {n:'Barail Range',sub:'Assam · 2,500m avg',desc:'Mountain range in Assam and Nagaland. Highest peak: Laike (1,890m). Important for tea gardens (Cachar district). Lush tropical forests. Rich wildlife: hoolock gibbon, hornbills. Dense fog and high rainfall.',fact:'Assam/Nagaland · Cachar tea gardens · Gibbons & hornbills · Highest rainfall · Tropical forests',pts:[{la:25.50,ln:92.70},{la:25.30,ln:93.00},{la:25.00,ln:93.30},{la:24.80,ln:93.50}]},
   {n:'Maikal Range',sub:'Chhattisgarh · 1,000m avg',desc:'Eastern part of the Satpura range in Chhattisgarh. Kanha NP and Achanakmar WLS. Sal forests. Hills around Amarkantak — Narmada River source. Rich tribal population.',fact:'Satpura eastern extension · Kanha NP · Amarkantak · Narmada source · Chhattisgarh',pts:[{la:22.80,ln:80.50},{la:22.60,ln:81.00},{la:22.50,ln:81.50},{la:22.40,ln:81.80}]},,
  {n:'Himalayas',la:28,ln:84,sub:'Asia � 2,400km � 8,848m Everest � World\'s highest',desc:'World\'s highest mountain range. 2,400km across 5 countries (India, Nepal, Bhutan, China, Pakistan). 8,848m Mount Everest (highest on Earth). 10 peaks over 8,000m. 2024: 600+ climbers summited Everest. 2023: record 600 summits. 2024: Everest clean-up removed 11 tonnes trash. 2024: 8 deaths on Everest. 1.5M tourists/yr in Nepal (pre-COVID). 2024: Nepal tourism recovery (1.2M). Himalayas formed 55 million years ago (India-Asia collision). Still rising 5mm/year. 2,400km long, 350km wide. Glaciers: 33,000 km� covered. 2024: glacier melt accelerating. 2023: 2% glacier volume lost/year. 1.5 billion people depend on Himalayan rivers (Ganges, Indus, Brahmaputra, Yangtze). 2024: temperature rise 0.6�C/decade (double global avg). 2024: 2,000 glacial lakes, 33 dangerous. 2023: South Lhonak Lake glacial outburst flood. 2024: 50 hydroelectric dams. 2013: Uttarakhand floods (6,000 dead). 2023: Himachal flash floods. Sherpas � indigenous mountain guides. 2024: Sherpa wage negotiations. 2019: 1,000 Everest summits in 1 season. 2023: Khumbu Icefall deaths. 2024: new Sagarmatha National Park rules. Buddhism, Hinduism, Tibetan culture. 50+ peaks over 7,000m. 1,000+ peaks over 6,000m. 2024: Annapurna Circuit. 2023: Simikot-Kailash trek. Wildlife: snow leopard, red panda, Himalayan monal, pika, tahr, musk deer. 2024: red panda habitat loss. 5,000+ species of flowering plants. 2023: new mammal species. 2024: 30 endemic amphibian species. 2023: treeline shift (20m/decade). 2024: IPCC Himalayan report. 100+ peaks open for climbing. 2024: 50th anniversary of all-women Everest expedition.',fact:'2,400km � 8,848m (world\'s highest) � 5 countries � 55M years old � 10 peaks over 8,000m � 5mm/yr rising � 1.5B people depend on rivers � 33,000 km� glaciers � 600+ Everest summits/yr � Sherpas � snow leopard � 1.2M Nepal tourists/yr � 0.6�C/decade warming � Annapurna Circuit � 50 hydro dams'},
  {n:'Andes Mountains',la:-15,ln:-70,sub:'South America � 7,000km � World\'s longest continental range',desc:'World\'s longest continental mountain range. 7,000km along western South America. 7 countries: Venezuela, Colombia, Ecuador, Peru, Bolivia, Chile, Argentina. 6,961m Aconcagua (highest peak, Argentina, highest outside Asia). 2024: 4,000 Aconcagua climbers/yr. 50+ peaks over 6,000m. 2023: Ojos del Salado (6,893m, Chile) � highest active volcano. 2024: Atacama Desert rain shadow effect. Andes formed by Nazca Plate subduction 80M years ago. 200+ active volcanoes (Ring of Fire). 2023: Ubinas (Peru) eruption. 2024: Nevado del Ruiz (Colombia) alert. Amazon River headwaters in Andes. 2024: Andean glaciers losing 50% since 1970. 2023: Quelccaya Ice Cap retreating 60m/year. 2024: water crisis for Lima (8M). 30% of world\'s copper (Chile, Peru). 2023: Cerro Verde mine. Lithium Triangle (Chile-Argentina-Bolivia) � 60% of world lithium. 2024: Salar de Uyuni (Bolivia, 10B tonnes). Inca Empire capital Cusco (3,400m). Machu Picchu (UNESCO 1983, 2,430m). 2024: 1.5M visitors. 2023: Inca Trail. 2024: Salkantay Trek. Lake Titicaca (3,812m, highest navigable). Uros reed islands. Andean condor, vicu�a, llama, alpaca, guanaco. 500+ mammal species. 2023: spectacled bear. 600+ bird species. 3,000+ potato varieties. Coca (traditional). P�ramo ecosystem. 15,000+ plant species. 2024: Peru conflict. 100M people live in Andes. 2024: La Paz (4,150m). Patagonian Andes: Torres del Paine. 2024: Aconcagua, Huayna Picchu, Cotopaxi, Chimborazo (6,263m, farthest from Earth center). 2023: 500,000 ha burned (Chubut).',fact:'7,000km (world\'s longest continental) � 6,961m Aconcagua � 7 countries � Nazca Plate subduction � 200+ active volcanoes � Lithium Triangle � Machu Picchu (UNESCO) � Amazon headwaters � glaciers 50% loss since 1970 � 30% world copper � 100M people � Incas � Patagonia � Altiplano'},
  {n:'Alps',la:46,ln:9,sub:'Europe � 1,200km � 4,808m Mont Blanc',desc:'Most famous European mountain range. 1,200km across 8 countries: France, Switzerland, Italy, Austria, Germany, Liechtenstein, Slovenia, Monaco. 4,808m Mont Blanc (highest). 2024: 100M+ visitors/yr (most visited range). 2023: skiing. 2024: winter season 25 days shorter since 1970. 2023: 0.6�C increase/decade. 2024: Mont Blanc glacier retreat (Mer de Glace � 1.2km since 1850). 128 peaks over 4,000m. 2023: 100+ deaths on Mont Blanc/yr. 2024: Mont Blanc tunnel (12.9km reopened). Tour de France Alps stages. Haute Route (Chamonix-Zermatt). 2024: Via Alpina (5,000km, 342 stages). 30,000km hiking trails. Eiger North Face (3,967m). Matterhorn (4,478m, Switzerland\'s icon). 2023: Aletsch Glacier (23km). 2024: 8M cows grazing. Edelweiss. Alpine ibex (50,000+). 2023: bearded vulture reintroduced (150+). 2024: wolf reintroduced (200+ packs). 30,000+ species (20% endemic). Alpine orogeny 65M years ago. 2024: permafrost thaw (rockfalls). 2023: Marmolada glacier collapse (11 dead). 150M tourists/yr. 50M ski passes. 3,000 ski lifts. 15M tourists Austrian Alps. Chamonix (mountaineering capital). 2024: Mont Blanc entry fee (�15). Aosta Valley. Zermatt, St. Moritz. Stelvio, Gro�glockner High Alpine Road. Jungfraujoch (3,454m, 1M/yr). 2024: 25M overnight stays Swiss Alps. 2050: 70% glacier loss predicted. Matterhorn 150th anniversary (2015).',fact:'1,200km � 8 countries � 4,808m Mont Blanc � 100M+ visitors/yr (most visited) � 128 peaks over 4,000m � Matterhorn (4,478m) � Eiger � Aletsch Glacier � 30,000km hiking trails � Tour de France � 65M years � 0.6�C/decade � 70% glacier loss by 2050 � 3,000 ski lifts � Chamonix � 8M cows � Edelweiss � alpine ibex'},
  {n:'Ural Mountains',la:60,ln:60,sub:'Russia � 2,500km � 1,895m Narodnaya � Europe-Asia boundary',desc:'Traditional boundary between Europe and Asia. 2,500km (Arctic Ocean to Caspian Sea). 1,895m Mount Narodnaya. 5 zones: Polar to Southern. 250-300M years old (Hercynian orogeny, oldest surviving range). Rich in minerals: iron, copper, nickel, oil, gas, coal, precious stones, potash. Norilsk nickel (world\'s largest). Uralkali (potash). "Stone Belt" of Russia. Yekaterinburg (1.5M). Chelyabinsk, Perm, Ufa, Orenburg. Ural River (2,428km). 48/55 most important Russian minerals. 500+ mineral species. Ural emeralds, amethyst, jasper. Oil/gas fields (Volga-Ural province, 30% of Russia). Pechora-Ilych Nature Reserve (Virgin Komi Forests, UNESCO). Manpupuner rock pillars (42m). Komi Republic. Nenets, Khanty, Mansi indigenous. Ural owl, sable, wolverine, brown bear, elk, wolf. 50,000 brown bears. Saiga antelope. Lake Turgoyak. Dyatlov Pass incident (1959, 9 hikers killed, mystery). 2,500km length. Skiing at Abzakovo, Magnitogorsk. Ural Federal District, 12M population. Uralmash (1940s). Permafrost in Polar Urals. Yamal LNG. Boreal forest taiga. 92 ethnic groups. 2024: industrial pollution (Karabash). 2023: climate change permafrost thaw. 2024: new Northern Sea Route. 2023: 200+ plant species endemic. 2024: Ural wind power projects. 2023: ancient mining (5,000 years). 2024: Orsk jasper, charoite.',fact:'2,500km � Russia � Europe-Asia boundary � 1,895m Mount Narodnaya � 250-300M years old (oldest) � rich minerals (48/55 types) � "Stone Belt" � Yekaterinburg � Virgin Komi Forests (UNESCO) � Manpupuner pillars � Dyatlov Pass � Ural River 2,428km � 12M population � 500+ mineral species � 30% Russia oil/gas � Volga-Ural province � Permafrost � 92 ethnic groups'}

];
D.crop = [
  {n:'Rice (Major producer)',la:22.50,ln:88.00,sub:'West Bengal · Largest producer',desc:'India\'s most important food crop. West Bengal is the largest producer followed by UP, Punjab, Odisha, AP, Bihar. Grown in Kharif season (sown June-July, harvested Sept-Oct). Requires high temp (25°C+), high rainfall (150-300cm). Alluvial soil preferred. Varieties: Aman, Aus, Boro (in WB). India is 2nd largest producer globally after China.',fact:'WB largest producer · Kharif crop · 25°C+, 150-300cm rain · Alluvial soil · 2nd globally'},
  {n:'Wheat (Major producer)',la:29.50,ln:78.50,sub:'Uttar Pradesh · Largest producer',desc:'India\'s second most important food crop. UP is the largest producer followed by Punjab, Haryana, MP, Rajasthan, Bihar. Grown in Rabi season (sown Oct-Dec, harvested March-April). Requires moderate temp (15-25°C), moderate rainfall (50-100cm). Best in well-drained loamy soil. India is 2nd largest producer globally after China. Green Revolution transformed wheat production.',fact:'UP largest producer · Rabi crop · 15-25°C · 50-100cm rain · Loamy soil · Green Revolution'},
  {n:'Sugarcane (Major producer)',la:26.50,ln:80.50,sub:'Uttar Pradesh · Largest producer',desc:'India\'s main cash crop for sugar production. UP is the largest producer (45%) followed by Maharashtra, Karnataka, Tamil Nadu, Bihar. Grown year-long (10-12 months). Requires hot (25-35°C) & humid, 100-200cm rainfall. Well-drained soil. India is 2nd largest producer globally after Brazil. Sugar, jaggery, ethanol from sugarcane.',fact:'UP largest (45%) · Year-long crop · 25-35°C · 100-200cm rain · 2nd globally after Brazil · Ethanol'},
  {n:'Tea (Major producer)',la:26.70,ln:88.30,sub:'Assam · Largest producer',desc:'India is 2nd largest tea producer globally after China. Assam produces 52% of India\'s tea — CTC tea (strong, used in chai). Darjeeling tea (West Bengal) — "Champagne of teas" — GI tag. Nilgiri tea (TN) — aromatic. Requires tropical climate (20-30°C), 150-300cm rainfall, well-drained acidic soil. Tea gardens on slopes for drainage.',fact:'Assam (52% of India) · Assam CTC, Darjeeling (Champagne of teas), Nilgiri · 20-30°C · 150-300cm rain · Acidic soil'},
  {n:'Coffee (Major producer)',la:13.30,ln:75.80,sub:'Karnataka · Largest producer (70%)',desc:'India produces 70% Arabica coffee (grown in shade) in Karnataka (Chikmagalur, Kodagu — 70%), Kerala (20%), Tamil Nadu (10%). Requires warm climate (15-28°C), 150-250cm rainfall, well-drained forest loam. Grown under shade trees (mixed plantation). India contributes only 4% of global coffee but Robusta from India is world-renowned.',fact:'Karnataka (70%) · Arabica (70%) · Shade-grown · 15-28°C · 150-250cm rain · Kodagu & Chikmagalur'},
  {n:'Cotton (Major producer)',la:22.50,ln:72.50,sub:'Gujarat · Largest producer',desc:'India is 2nd largest cotton producer globally after China. Gujarat is the largest producer (30%) followed by Maharashtra, Telangana, MP, Karnataka, Punjab. Kharif crop (sown May-June), requires 20-35°C, 50-100cm rainfall. Black soil (regur) ideal in Deccan plateau. Three types: long staple (hybrid), medium staple (Indian), short staple (desi). Bt cotton (genetically modified) dominates since 2002.',fact:'Gujarat (30%) · 2nd globally after China · Black soil (regur) · Bt cotton dominant · Kharif crop'},
  {n:'Jute (Major producer)',la:22.50,ln:88.50,sub:'West Bengal · Largest producer',desc:'India is the largest jute producer globally (70% of world production). West Bengal produces 70% of India\'s jute (mainly Murshidabad, Nadia, 24 Parganas). Grows in hot (25-35°C) humid climate, 150-250cm rainfall, alluvial soil. "Golden Fibre" — used for sacks, carpets, eco-friendly products. Jute mills along Hooghly River (West Bengal). Jute packaging mandatory (JPMA).',fact:'Largest globally (70%) · WB (70%) · Golden Fibre · Alluvial soil · Hooghly mills · Eco-friendly'},
  {n:'Rubber (Major producer)',la:9.50,ln:76.50,sub:'Kerala · Largest producer (75%)',desc:'India is 4th largest natural rubber producer (Thailand, Indonesia, Vietnam ahead). Kerala produces 75% (Kottayam, Kollam, Kozhikode districts). Requires equatorial climate (24-35°C), 200-300cm rainfall, laterite soil. Grown in tropical wet region. Used for tyres, industrial rubber, gloves. Increasing domestic demand.',fact:'Kerala (75%) · 4th globally · Equatorial climate · Laterite soil · Tyre industry'},
  {n:'Spices (Major producer)',la:10.00,ln:76.50,sub:'Kerala · Spice capital',desc:'India is the world\'s largest spice producer, consumer and exporter. Kerala is "Spice Garden of India" — black pepper (50% of India), cardamom (80%), ginger, cinnamon. Other major states: Rajasthan (coriander, cumin, fenugreek), AP (chillies — 50% of India), Gujarat (cumin), Karnataka (chillies). Black pepper — "King of Spices" — Kerala\'s Idukki district largest. India exports to 120+ countries.',fact:'Largest global producer · Kerala: pepper & cardamom · AP: chillies (50%) · Rajasthan: cumin & coriander · 120+ export countries'},
  {n:'Tobacco (Major producer)',la:16.50,ln:80.50,sub:'Andhra Pradesh · Largest producer (45%)',desc:'India is 2nd largest tobacco producer globally after China. AP (45%) is the largest producer, followed by Gujarat (20%), Karnataka (15%), UP (10%). Virginia tobacco main variety (for cigarettes). Oriental tobacco in Karnataka/UP. Bidi tobacco — Gujarat (Nipani). Regulated by Tobacco Board (Guntur). Strong anti-tobacco laws & health warnings.',fact:'AP (45%) · 2nd globally after China · Virginia & bidi tobacco · Tobacco Board (Guntur) · Cigarettes'},
     {n:'Oilseeds (Groundnut/Coconut)',la:10.00,ln:77.50,sub:'Tamil Nadu · Groundnut/Coconut',desc:'India is 4th largest oilseed producer. Groundnut: Gujarat (40% — Saurashtra region), AP, TN, Karnataka. Kharif crop, rainfed. Coconut: Kerala (largest coconut producer — 40%), Tamil Nadu (30%), Karnataka. TN has most coconut trees. "Kallakurichi coconut" GI tag. India produces 35% of world\'s coconuts. Used in cooking, cosmetics, coir industry.',fact:'Gujarat: groundnut (40%) · Kerala: coconut (40%) · 4th globally oilseeds · Rainfed · Coir industry'},
   {n:'Pulses (Gram/Arhar/Moong)',la:25.50,ln:78.50,sub:'MP · Largest producer of pulses',desc:'India is the largest producer and consumer of pulses globally. MP (25%), Rajasthan, UP, Maharashtra, AP. Gram (chana): MP largest. Arhar (tur): Maharashtra, Karnataka, MP. Moong, urad: Rajasthan. Grown in both Kharif and Rabi seasons. Important source of protein in Indian diet.',fact:'Largest globally · MP (25%) · Gram, arhar, moong, urad · Kharif & Rabi · Protein source'},
   {n:'Millets (Jowar/Bajra/Ragi)',la:18.00,ln:75.00,sub:'Maharashtra · Largest jowar producer',desc:'India is the largest millet producer globally. Jowar (sorghum): Maharashtra (50%), Karnataka, MP. Bajra (pearl millet): Rajasthan (45%), UP, Haryana. Ragi (finger millet): Karnataka, TN, Uttarakhand. Drought-resistant — grows in dry regions. Nutritious grain — "nutri-cereals." 2023 declared International Year of Millets.',fact:'Largest globally · Maharashtra: jowar · Rajasthan: bajra · Karnataka: ragi · Nutri-cereals'},
   {n:'Fruits (Mango/Banana/Grapes)',la:25.00,ln:82.00,sub:'UP · Largest mango producer',desc:'India is 2nd largest fruit producer globally after China. Mango: UP (25%), AP, Karnataka — "King of Fruits." Banana: TN (largest), Maharashtra, Gujarat. Grapes: Maharashtra (Nashik 80%), AP. Citrus: MP, Maharashtra. Apple: J&K, HP. India produces 40% of world\'s mangoes and 25% of bananas.',fact:'2nd globally · Mango: UP · Banana: TN · Grapes: Nashik · Apple: J&K/HP'},
   {n:'Vegetables (Potato/Onion/Tomato)',la:23.00,ln:75.00,sub:'UP · Largest vegetable producer',desc:'India is 2nd largest vegetable producer globally after China. Potato: UP (30%), WB, Bihar. Onion: Maharashtra (Nashik — largest), MP, Gujarat. Tomato: AP, MP, Karnataka. UP leads in overall vegetable production. India largest onion exporter globally.',fact:'2nd globally · Potato: UP · Onion: Maharashtra (Nashik) · Tomato: AP · Onion export leader'},
   {n:'Sugarcane (Minor states)',la:17.50,ln:77.50,sub:'Karnataka · Second largest producer',desc:'Karnataka is India\'s 2nd largest sugarcane producer (after UP). Belgaum, Bagalkot, Mandya districts. 400+ sugar mills across India. Major ethanol production hub. Sugar season Oct-Sep.',fact:'2nd after UP · Belgaum/Bagalkot · Ethanol hub · Mandya sugar · 400+ mills'},
   {n:'Floriculture (Cut flowers)',la:12.50,ln:77.50,sub:'Karnataka · Largest flower producer',desc:'India\'s floriculture hub. Karnataka leads (35% of India\'s cut flowers). Rose, marigold, gladiolus, tuberose. TN represents: jasmine (malli) — 60%. WB: marigold. Export to EU, Middle East. Year-round cultivation.',fact:'Karnataka (35% cut flowers) · Rose, gladiolus, marigold · TN: jasmine (60%) · Export hub'},
    {n:'Organic Farming (Sikkim model)',la:27.33,ln:88.60,sub:'Sikkim · First 100% organic state',desc:'Sikkim became India\'s first fully organic state in 2016. Banned synthetic pesticides and fertilizers. 76,000+ farmer families certified organic. Produces organic ginger, cardamom, buckwheat. Model for sustainable agriculture.',fact:'First 100% organic state (2016) · No synthetic inputs · 76k certified farmers · Model state'},
    {n:'Brazil Coffee (Arabica)',la:-21.00,ln:-43.00,sub:'Brazil · 2.7M tonnes · Largest coffee producer',desc:'Brazil is the world\'s largest coffee producer (2.7M tonnes/year — 35% of global). Minas Gerais (Cerrado Mineiro), São Paulo (Mogiana), Espírito Santo (Conilon/Robusta), Bahia are top states. Arabica (70%) and Robusta/Conilon (30%). 300,000+ coffee farms. 15B cups/year. Coffee introduced 1727 (Francisco de Mello Palheta smuggled seeds from French Guiana). 500M coffee trees. Harvest May-September. Drying: patios and mechanical dryers. Specialty coffee movement from 1990s. Bourbon, Catuaí, Mundo Novo varieties. Brazil\'s coffee boom built railways (São Paulo Railway) and attracted 4M+ immigrants (Italians, Japanese). Santos port is coffee export hub. 2nd largest coffee consumer after US. Cafezinho (small strong coffee) is national drink. Major export to EU, USA, Japan.',fact:'2.7M tonnes (35% of global) · Largest producer · Minas Gerais (Cerrado) · Arabica & Robusta · 300k farms · 1727 introduced · Santos port · 15B cups/year'},
    {n:'California Almonds',la:37.50,ln:-120.50,sub:'USA · 3B lbs · 80% of global supply',desc:'California produces 80% of the world\'s almonds — 3 billion pounds annually (2022). Central Valley (Sacramento and San Joaquin valleys) is the growing region. 1.5M acres of orchards. 6,800 almond growers. 100+ varieties (Nonpareil 40% — premium variety). Bloom February-March — 1.6M honeybee hives required for pollination (70% of US commercial bees). Water-intensive: 1 gallon per almond. Drought and groundwater regulation threaten industry. Harvest August-October — mechanical tree shakers. Almond milk demand surged plant-based milk boom (2020s). 70% exported (India, China, EU, Middle East). California Almond Board funds research. 4,000+ processors and handlers. Requires 800-1,000 hours chilling (below 7°C) per season — climate change threatens this. Almond harvest yields 1,000-2,500 lbs/acre. History: Spanish missionaries planted first almonds 1769. Commercial industry from 1900s. Shells used for livestock bedding, co-generation fuel. Price fluctuates with water costs and export demand.',fact:'3B lbs/yr · 80% of global supply · Central Valley · 1.5M acres · 1M bee hives · 1 gallon water per almond · 70% exported · Almond milk demand'},
    {n:'Iowa Corn (Maize)',la:42.00,ln:-93.50,sub:'USA · 2.5B bu · Largest US corn producer',desc:'Iowa is the largest corn-producing state in the US (2.5B bushels, 17% of US total, ~13M acres). Corn Belt heartland. US produces 32% of global corn — Iowa alone 5%. Field corn (dent corn — 99% of crop) used for: livestock feed (40%), ethanol (35%), exports (15%), human food/industrial (<5%). Sweet corn for canning/fresh is tiny share. GMO corn (95% of US crop) — Bt (insect resistant), Roundup Ready (herbicide tolerant), stacked traits. Planting April-May, harvest September-November. Yields: 200+ bu/acre (irrigated), 120-180 bu/acre (dryland). 90,000+ farms in Iowa. Average farm size: 350 acres. Mulch tillage and no-till widespread. Iowa State University research. Nitrogen fertilizer demand is high. Soil erosion concern in Mississippi watershed — contributes to Gulf of Mexico dead zone. Ethanol — 30% of US corn goes to 200+ ethanol plants. 2022 drought and input costs challenged production. Iowa is also top pork producer — integrated hog-corn system. Corn stover (stalks/leaves) used for cellulosic ethanol and bedding. Rotation with soybeans (corn-soy rotation).',fact:'2.5B bu (17% of US corn) · Corn Belt · Field corn (99%) · Livestock feed (40%) · Ethanol (35%) · GMO (95%) · 90k farms · Gulf dead zone'},
    {n:'Bordeaux Vineyards',la:44.80,ln:-0.60,sub:'France · 120k ha · Premier wine region',desc:'Bordeaux is one of the world\'s most famous and largest fine wine regions. 120,000 hectares of vineyards in southwestern France. 7,000+ wine producers (châteaux). 700M bottles/year (including 60M for top Grands Crus Classés). 65 AOC (Appellation d\'Origine Contrôlée) designations. Grapes: Cabernet Sauvignon (26%), Merlot (60%) — dominant, Cabernet Franc (10%), Petit Verdot, Malbec (reds); Sémillon (47%), Sauvignon Blanc (46%), Muscadelle (whites). Left Bank (Médoc) — Cabernet-dominant, gravel soils — famous châteaux: Lafite Rothschild, Margaux, Latour, Haut-Brion, Mouton Rothschild (1855 Classification). Right Bank (Saint-Émilion, Pomerol) — Merlot-dominant, clay/limestone — Château Pétrus, Cheval Blanc, Ausone. Sauternes/Barsac — botrytized sweet wines (Yquem — Premier Cru Supérieur 1855). Entre-Deux-Mers — dry whites. 1855 Classification created for Exposition Universelle de Paris — still used today. Château Margaux, Château Latour, Château Lafite Rothschild, Château Haut-Brion, Château Mouton Rothschild (elevated 1973). Grand Cru Classé system for Saint-Émilion (1955, updated every 10 years). Red Bordeaux called "claret" in UK. Affected by Philippe the Good (Duke of Burgundy) who banned Pinot Noir in 1395? — no, Bordeaux was English territory (1152-1453 under Eleanor of Aquitaine). English trade made Bordeaux wealthy. "Bordeaux wine" in British Navy rations. Phylloxera (1860s-70s) devastated vineyards — grafting onto American rootstocks. 1956 frost, 1999 storms. Famously vintages: 1982, 2000, 2005, 2009, 2010, 2015, 2016. Climate change altering harvest dates and styles — warmer, riper, higher alcohol. Place de Bordeaux — global wine trading hub. Wine tourism: Cité du Vin museum (Bordeaux, 2016).',fact:'120k ha · 700M bottles/year · 7,000 châteaux · Merlot (60%), Cabernet (26%) · 1855 Classification · Lafite, Margaux, Pétrus, Yquem · 65 AOCs · Phylloxera 1860s · English history'},,
  {n:'Rice (Thailand Jasmine Rice)',la:15,ln:102,sub:'Thailand · World\'s 2nd largest rice exporter',desc:'Thailand is world\'s 2nd largest rice exporter (after India). 2024: 10M tonnes exported/yr. Jasmine rice (Hom Mali) — premium variety. 2023: drought reduced crop. 2024: 5M hectares rice paddies. 70% of Thai rice is jasmine. 2024: exports $5B. Isaan region (NE Thailand) — largest rice-growing region. 2024: climate change — 1M ha affected by drought. 2023: rice production 32M tonnes. 2024: domestic consumption 12M tonnes. 2024: India export ban (2023-2024) boosted Thai rice prices. 2024: Thailand rice price $600/tonne (jasmine $1,000/tonne). 2023: Vietnam competing. 2024: sustainable rice agriculture. 2023: 4M rice farmers. 2024: government subsidies. 2024: water shortage (Chao Phraya basin). 2024: alternate wetting/drying technique to reduce methane. 2024: Thai Rice NAMA (low-carbon). 2023: Khao Dawk Mali 105 variety. 2024: 2023 yields. 2024: central plains. 2024: rice straw burning (PM2.5 pollution). 2023: Thailand\'s 1st rice. 2024: GAP certification. 2024: future: drought tolerant varieties. 2023: exports 7.5M. 2022: 7.7M. 2024: 10M. 2024: IRRI. 2024: Khorat basin. 2023: 15M. 2024: 70% of farmland. 2023: 35% of world. 2024: 20% of world exports. 2024: India (16.5M), Thailand (10M), Vietnam (8M), Pakistan (5M). 2024: milled rice. 2024: world rice 520M tonnes. 2024: 18 million tons. 2024: rainfed 80%. 2024: 100 varieties. 2023: jasmine 200. 2024: 6M farmers. 2024: 30M tonnes. 2023: 20M ha? No 5M. 2024: 50% of Mekong. 2024: climate: 1.5°C increase reduces yield 10%.',fact:'Thailand · 2nd largest rice exporter (10M tonnes/yr) · Jasmine rice (Hom Mali premium) · 5M ha · Isaan region (NE) · 32M tonnes production · 4M farmers · drought (1M ha affected) · $5B exports · 70% jasmine · India export ban (2023-24) boosted prices · sustainable rice (low-carbon NAMA) · 50% of Mekong basin · 80% rainfed · 100+ varieties · 20% world exports · $600/t (jasmine $1,000) · 40% of farmland'},
  {n:'Coffee (Ethiopian Yirgacheffe)',la:6,ln:38.2,sub:'Ethiopia · Birthplace of coffee · 1M tonnes/yr',desc:'Ethiopia is the birthplace of coffee (Arabica). 2024: 1M tonnes/yr (8M bags). 5th largest producer (Brazil 3.4M, Vietnam 1.9M, Colombia 900k, Indonesia 700k). Yirgacheffe — premium single origin, Sidamo region. 2024: 25% of Ethiopia\'s exports ($1.4B). 15M people employed. 2023: 4M smallholder farmers. 800,000 ha coffee. 2024: climate change (temperature +1.5°C by 2050 reduces 60% of area). 2023: forest coffee (wild Arabica). Coffee ceremony (traditional Ethiopian). 2024: specialty coffee boom. 2023: Ethiopian Coffee Exchange (ECX). 2024: direct trade (90% of coffee exported as green bean). 2024: origin: Kefa region (coffee name derived). 2023: legend: Kaldi and his dancing goats (9th century). 2024: 4,000 Arabica varieties. 2023: forest grown (10,000 varieties). 2024: 80% of export earnings for Ethiopia. 2024: Sidamo, Yirgacheffe, Harrar — famous coffees. 2024: WASHED (Yirgacheffe), NATURAL (Harrar). 2024: 2000m altitude. 2024: Ethiopia exports: 240,000 tonnes. 2024: 2023: coffee auction (cup profile). 2024: 150,000 coffee ceremonies. 2024: Starbucks (Ethiopian trademark dispute, 2007?). 2023: 10 million coffee growers. 2024: 50% of world Arabica genetic diversity. 2023: wild arabica. 2024: 1M tonnes. 2024: 6% annual growth. 2024: Brazil Robusta? 2024: specialty coffee (20% of export value but 10% volume). 2023: 85% of exports as green. 2023: washing station. 2023: 1 year',fact:'Ethiopia · birthplace of coffee (Arabica) · 1M tonnes/yr (8M bags) · 5th largest producer · Yirgacheffe (premium single origin) · 15M employed · 4M smallholders · 800k ha · 4,000 Arabica varieties · 25% of Ethiopia exports ($1.4B) · climate change +1.5°C reduces 60% area · legend Kaldi (9th c) · coffee ceremony · 80% of export earnings · 10,000 wild varieties · 50% world Arabica genetic diversity · specialty coffee (20% value) · washed/natural · Harrar, Sidamo, Yirgacheffe'},
  {n:'Rubber (Malaysia/Thailand)',la:4,ln:102,sub:'Thailand/Indonesia/Malaysia · 70% of world natural rubber',desc:'Natural rubber from Hevea brasiliensis tree. 70% of world production from Thailand (4.3M tonnes), Indonesia (3.2M), Malaysia (850k). 2024: 14M tonnes total natural rubber. 2024: rubber plantations: 12M ha (90% in Asia). 2024: uses: tires (70%), gloves, condoms, medical. 2023: synthetic rubber (50% of total rubber). 2024: $30B world market. 2024: 10M+ smallholder farmers. 2023: deforestation for rubber (SE Asia, 5M ha). 2024: sustainable rubber (Global Platform for Sustainable Natural Rubber). 2023: 1930s: rubber plantations in Malaysia (British). 2024: 85% from smallholders (2 ha avg). 2024: tapping: daily (3 hr). 2024: Latex (40% dry rubber). 2024: block rubber (RSS). 2024: natural rubber price $1.30/kg (2024). 2023: low prices (farmers switch to palm oil). 2024: EU deforestation regulation (EUDR). 2024: 12M ha. 2024: Thailand NE (Isaan) and South. 2024: 1M ha Indonesia. 2024: 70% of world natural. 2024: auto industry tires. 2024: Michelin, Bridgestone, Goodyear. 2023: 10M tonnes used. 2024: 70% vehicle tires. 2024: global stockpile. 2024: 2023: $1.50/kg. 2024: India (400k ha, 700k tonnes). 2024: China (800k ha?). 2023: replanting grants. 2024: research (RRIM). 2024: rubberwood furniture (after 30 yrs). 2024: Hevea tree introduced 1876 (Henry Wickham, Brazil to Kew Gardens to Asia). 2024: 14M tonnes. 2024: world\'s largest rubber estate: 11,000 ha. 2024: climate (rainfall 2,000mm). 2023: 95% of SE Asia. 2024: latex gloves (Malaysia 60% of world). 2024: Top Glove (largest).',fact:'Thailand/Indonesia/Malaysia · 70% of world natural rubber · Hevea brasiliensis · 14M tonnes/yr · 12M ha · tires (70%) · 10M+ smallholders (2 ha avg) · 85% smallholders · deforestation (5M ha) · Global Platform Sustainable Rubber · EUDR · Henry Wickham (1876) · rubberwood furniture · tapping daily 3 hr · 1930s British Malaysia · $1.30/kg · 50% synthetic 50% natural · Latex (gloves) · Malaysia 60% of latex gloves (Top Glove) · $30B market · 70% for vehicles'}

];
D.mineral = [
  {n:'Coal (Jharia Coalfield)',la:23.75,ln:86.40,sub:'Jharkhand · Largest coal reserves',desc:'Largest and most important coalfield in India. Located in Jharia district of Dhanbad division. Produces the best coking coal in India (used in steel-making). Part of Gondwana coal belt. Own coal fires since 1916 (underground fires). Also Dhanbad — "Coal Capital of India". India is 2nd largest coal producer globally after China.',fact:'Largest coalfield · Best coking coal · Jharia fires since 1916 · Gondwana belt · 2nd globally'},
  {n:'Coal (Raniganj Coalfield)',la:23.60,ln:87.10,sub:'West Bengal · Oldest coalfield',desc:'India\'s oldest coalfield — first commercial coal mining (1774) in India. Spread across West Bardhaman, Bankura, Birbhum districts. Produces high-grade non-coking coal. Part of Damodar Valley (Dalma range). ECL (Eastern Coalfields Ltd) operates. Gondwana belt.',fact:'Oldest coalfield (1774) · ECL · Non-coking coal · Damodar Valley · West Bengal'},
  {n:'Iron Ore (Bailadila)',la:18.60,ln:81.20,sub:'Chhattisgarh · Rich haematite ore',desc:'Bailadila hills in Dantewada district. World\'s finest iron ore (66%+ Fe content — haematite). Owned by NMDC (National Mineral Development Corp). Open-cast mines developed with Japanese collaboration (exported to Japan). 14 deposits. 3,100 million tonnes reserves.',fact:'Best haematite (66%+ Fe) · NMDC · Japanese collaboration · Bastar region · 3,100 MT reserves'},
  {n:'Iron Ore (Kudremukh)',la:13.20,ln:75.30,sub:'Karnataka · Magnetite deposits',desc:'Kudremukh (horse-face) hills in Western Ghats. One of world\'s largest magnetite iron ore deposits. Low-grade (30-35% Fe) but huge quantity. Owned by KIOCL (Kudremukh Iron Ore Company). Operations shut due to Supreme Court environmental order (2012) — mining in protected forests. Slurry pipeline to Mangalore port (68 km).',fact:'7th largest globally · Magnetite (30-35% Fe) · Shut for environment · Slurry pipeline · KIOCL'},
  {n:'Bauxite (Odisha)',la:19.50,ln:84.50,sub:'Odisha · Largest reserves (50%)',desc:'India has 5th largest bauxite reserves globally. Odisha (Kalahandi, Koraput, Rayagada) has 50% of India\'s reserves. Bauxite is primary ore for aluminium. Nalco (National Aluminium Co) operates Panchpatmali mines in Koraput. Also Gujarat (Kutch), Jharkhand (Lohardaga). Average grade 45-50% Al2O3. Open-cast mining.',fact:'Odisha (50%) · 5th globally · Aluminium ore · Nalco · Panchpatmali (Koraput) · Open-cast'},
  {n:'Manganese (Odisha/Karnataka)',la:21.50,ln:85.00,sub:'Odisha/Karnataka/Maharashtra',desc:'India has 6th largest manganese reserves globally. Odisha (Kalahandi, Sundargarh) leads, followed by Karnataka (Bellary), Maharashtra (Nagpur), MP, AP, Jharkhand. Essential for steel-making (as alloy). Used in batteries, fertilizer, ceramics. Manganese Ore India Ltd (MOIL) is major PSU. Gondwana belt deposits.',fact:'6th globally · Odisha leads · Steel alloy · MOIL · Battery & fertilizer use'},
  {n:'Copper (Khetri)',la:28.00,ln:75.80,sub:'Rajasthan · Khetri Nagar',desc:'Rajasthan has 40% of India\'s copper reserves. Khetri Nagar (Jhunjhunu) is the largest copper mining complex. Also Malanjkhand (MP — largest copper deposit: 1.5 MT), Singhbhum (Jharkhand). Hindustan Copper Ltd (HCL) operates Khetri. Used in electrical conductivity, alloys, brass.',fact:'Rajasthan (40%) · Khetri HCL · Malanjkhand largest deposit · Electrical, alloys'},
  {n:'Gold (Kolar Gold Fields)',la:12.94,ln:78.27,sub:'Karnataka · Kolar',desc:'Historically India\'s most important gold mine. Closed in 2001 after 120 years of mining (depth 3,200m — one of world\'s deepest). Once produced 3 tons/year (80% of India\'s gold). Hutti Gold Mine (Raichur, Karnataka) — only active gold mine in India (since 1947). Also Ramagiri (AP), Kolar (KGF — now closed). India largely imports gold.',fact:'Deepest gold mine (3.2km) · Closed 2001 · Hutti (only active) · 120 years · India imports most gold'},
  {n:'Mica (Jharkhand/Bihar)',la:24.50,ln:85.50,sub:'Jharkhand · Largest producer',desc:'India is the world\'s largest mica producer and exporter (60% of global). Jharkhand (Koderma, Hazaribagh district — "Mica Belt") leads followed by Bihar, Rajasthan, AP. Used in electrical insulation, cosmetics (glitter), paints, electronics. Mica mining largely unorganized, child labour issues. Koderma district is "Mica Capital".',fact:'60% globally · Jharkhand (Mica Belt) · Koderma (Mica Capital) · Electrical & cosmetics · Child labour issues'},
  {n:'Petroleum (Mumbai High)',la:19.50,ln:72.00,sub:'Offshore Mumbai · ONGC',desc:'Largest offshore oil field in India. Located 160 km west of Mumbai in Arabian Sea. Discovered 1974 by ONGC (Oil & Natural Gas Corp) on RV Anweshak. Produces 65% of India\'s domestic oil. Peak production 1985 (~400k bbl/day). Now declining (~200k bbl/day). Other fields: Bassein, Heera, Neelam. India imports 85% of its oil needs.',fact:'Largest offshore · ONGC · 65% of India\'s oil · Discovered 1974 · 160 km off Mumbai · 85% import'},
  {n:'Petroleum (Digboi)',la:27.38,ln:95.63,sub:'Assam · Oldest oil refinery',desc:'India\'s oldest oil field (1889) and refinery (1901 — one of world\'s oldest still operating). Located in Tinsukia district, Assam. Discovered by British engineers digging for elephants\' foot prints! Assam-Arakan basin. Produces waxy crude (high paraffin). Oil India Ltd (OIL) HQ in Duliajan. Part of NE oil belt (Assam, AP, Nagaland).',fact:'Oldest (1889) · Assam (Arakan basin) · Elephants\' footprints discovery · OIL · Waxy crude'},
  {n:'Thorium (Monazite sands)',la:9.80,ln:76.50,sub:'Kerala · Chavara, Manavalakurichi',desc:'India has the WORLD\'S LARGEST thorium reserves (30% of global). Kerala\'s monazite sands (Chavara, Neendakara, Manavalakurichi) are richest. Also Odisha (Chatrapur), TN, WB, AP. Monazite sand contains thorium phosphate. Used in nuclear fuel (Thorium cycle) — India\'s 3-stage nuclear power program. Atomic Minerals Directorate controls. Has strategic importance for India\'s energy independence.',fact:'Largest global reserves (30%) · Kerala monazite sands · 3-stage nuclear program · Strategic importance · AMD controlled'},
  {n:'Limestone (MP/Chhattisgarh)',la:24.00,ln:81.00,sub:'MP · Largest producer',desc:'Limestone is the most abundant mineral in India. MP leads with 25% followed by Rajasthan (15%), AP (10%), Chhattisgarh (10%), Gujarat. Essential for cement industry (calcium carbonate). Used in steel (flux), fertilizers, paper, chemicals. Cement plants co-located near limestone mines (Satna, Chhattisgarh, Gulbarga). India is 2nd largest cement producer globally.',fact:'Most abundant · MP (25%) · Cement industry · 2nd globally cement · Flux in steelmaking'},
   {n:'Uranium (Jaduguda)',la:22.65,ln:86.36,sub:'Jharkhand · Jaduguda mines',desc:'India\'s first uranium mine (1967) in East Singhbhum. Operated by Uranium Corporation of India (UCIL). Supplies fuel to India\'s nuclear reactors. Also mines at Bhatin, Narwapahar, Turamdih (all in Singhbhum). Tummalapalle (AP) — largest uranium discovery in India (2014). Atomic Minerals Directorate for exploration. India has limited uranium reserves — imports from Kazakhstan, Canada.',fact:'First uranium mine (1967) · UCIL · Singhbhum belt · Tummalapalle (AP) largest · Limited domestic reserves'},
   {n:'Diamond (Panna)',la:24.70,ln:80.00,sub:'MP · Only diamond mine in India',desc:'India\'s only working diamond mine. Panna district, MP. Produces 80,000 carats/year. Also historic Golconda mines (Kollur, Kollur mine produced Koh-i-Noor). NMDC operates Panna. 14 million tonnes kimberlite reserves.',fact:'Only active diamond mine · Panna MP · NMDC · Golconda (Koh-i-Noor) · Kimberlite pipes'},
   {n:'Zinc (Rampura-Agucha)',la:25.40,ln:74.50,sub:'Rajasthan · World\'s largest zinc mine',desc:'World\'s largest zinc mine. Located in Bhilwara district, Rajasthan. Owned by Hindustan Zinc Ltd (Vedanta Group). 15 million tonnes ore/year. High grade (15-20% zinc). Also produces lead, silver. Open-pit and underground operations.',fact:'World\'s largest zinc mine · Bhilwara Rajasthan · HZL (Vedanta) · High grade · Lead & silver'},
   {n:'Lead (Rajpura Dariba)',la:24.50,ln:74.20,sub:'Rajasthan · Lead-zinc belt',desc:'Major lead-zinc mine in Rajsamand district, Rajasthan. Part of HZL operations. 300m deep underground mine. Produces lead concentrate, zinc concentrate, silver. Rampura-Agucha nearby.',fact:'Rajasthan lead belt · HZL · Rajsamand district · Silver by-product · Underground mine'},
   {n:'Gypsum (Rajasthan)',la:28.00,ln:74.50,sub:'Rajasthan · 95% of India\'s gypsum',desc:'Rajasthan holds 95% of India\'s gypsum reserves. Major mines in Bikaner, Nagaur, Jodhpur districts. Used in cement (5% retarder for setting time), plaster of paris (POP), fertilizer. Gypsum from Thar desert. India is 3rd largest cement producer — gypsum demand high.',fact:'Rajasthan (95%) · Bikaner, Nagaur · Cement additive · POP · Fertilizer · Desert mining'},
   {n:'Silver (Tundoo/Zawar)',la:24.30,ln:74.00,sub:'Rajasthan · Zawar mines',desc:'Zawar (Udaipur district) — oldest zinc/lead/silver mines in India (4000 years old). Tundoo (Jharkhand) — HCL copper by-product. Rajasthan has 80% of India\'s silver reserves. India imports most silver. Used in jewellery, electronics, solar panels.',fact:'Zawar: oldest mines (4,000 yr) · Rajasthan 80% · Tundoo by-product · Silver imports · Solar & jewellery'},
   {n:'Salt (Sambhar Lake)',la:26.90,ln:75.00,sub:'Rajasthan · India\'s largest salt lake',desc:'India\'s largest inland saltwater lake. Located 80km from Jaipur. Produces 200,000 tonnes of salt/year (9% of India\'s salt production). Also Important Bird Area. Salt production season Oct-Mar. Salinity gradient supports unique ecosystem.',fact:'Largest salt lake · 200k T/year · 9% of India salt · Flamingos · Jaipur region'},
   {n:'Phosphate (Rajasthan/MP)',la:25.00,ln:75.00,sub:'Rajasthan · 90% of India\'s rock phosphate',desc:'India\'s only significant rock phosphate deposits. 90% in Rajasthan (Udaipur, Jhamarkotra). MP has small reserves. Used for fertilizer (DAP, phosphoric acid). Jhamarkotra deposit is 50km long. India imports 90% of its phosphate needs.',fact:'Rajasthan (90%) · Jhamarkotra (50km deposit) · DAP fertilizer · 90% import dependency'},
   {n:'Tungsten (Degana)',la:26.40,ln:75.00,sub:'Rajasthan · Degana deposit',desc:'Only tungsten deposit in India. Near Ajmer, Rajasthan. Low-grade (0.5-1%) scheelite/wolframite ore. Used in cutting tools, filaments, heavy alloys. India dependent on imports. Minor production from Degana.',fact:'Only tungsten deposit · Degana (Ajmer) · Scheelite/wolframite · Low grade · Strategic metal'},,
  {n:'Diamond (Kimberley Big Hole)',la:-28.74,ln:24.76,sub:'South Africa · Kimberley · Largest hand-dug excavation',desc:'Kimberley Big Hole: world\'s largest hand-dug excavation. 214m deep, 463m wide. 50,000 miners dug 1866-1914. Excavated 22.5M tonnes of earth. Yielding 2,720 kg of diamonds (14.5 million carats). 1914: closed (water filled now 175m deep). De Beers founded in Kimberley (1888, Cecil Rhodes). Kimberley Mine (Big Hole). Eureka Diamond (1866, 21.25 ct, first SA diamond). Star of South Africa (1867, 83.5 ct) triggered diamond rush. 2024: Big Hole Museum + underground tour. Most valuable mine in world. Kimberley city population 225,000. Diamond mining still major (Botswana 25M carats/yr, Russia 40M carats/yr, Canada 20M carats/yr). Kimberly Process (2003, conflict diamonds). 2024: blood diamonds issue (Angola, Sierra Leone, Zimbabwe). 2023: synthetic diamonds (growing, 8M carats/yr). Diamond: hardest natural material (10 Mohs). Formed 1-3B years deep in mantle. 2024: Brazil diamonds. 2021: 200 million carats total world. 2023: Big Hole. 2024: tourist attraction. 2023: 100k visitors/yr. Diamond as gemstone: 4 Cs (cut, color, clarity, carat). 2022: Diamond lab. 2024: De Beers 150th anniversary? 2018: 150 years SA diamond. 2024: lab-grown diamonds market 20% of gem. 2023: 10% of market. 2024: cost 70% less than mined. Big Hole 214m. 22 million tons of rock. 50,000 miners over 5 decades. 1914 closed. Largest hand-dug hole. Woodway star. 1872 Kimberley Rush. 1800s.',fact:'Kimberley, South Africa · largest hand-dug excavation · 214m deep · 463m wide · 22.5M tonnes earth · 2,720 kg diamonds (14.5M carats) · 1866-1914 · 50,000 miners · De Beers founded 1888 (Cecil Rhodes) · 175m water-filled · Eureka Diamond (1866) · Kimberley Process (conflict diamonds) · 4 Cs · lab-grown diamonds · Big Hole Museum · 100k visitors/yr · hardest material (Mohs 10)'},
  {n:'Gold (Witwatersrand Gold Rush)',la:-26.25,ln:28.05,sub:'South Africa · Johannesburg · World\'s largest gold deposit',desc:'Witwatersrand Basin — world\'s largest known gold deposit. Produced 40% of all gold ever mined (50,000+ tonnes). Johannesburg founded 1886 gold rush. 2024: 3,000m+ deep mines (Mponeng, TauTona — world\'s deepest mines at 4km). 2023: South Africa gold production 100 tonnes/yr (peak 1,000 tonnes/yr 1970). 1970: South Africa produced 1,000 tonnes (80% of world). 2024: production declining (deeper, costly). Witwatersrand gold formed 2.7 billion years ago. 50+ gold mines in Basin. 2023: Mponeng gold mine (4km deep, hottest mine at 60°C). 5,000 employees, refrigeration plant. 2023: labor disputes (NUM, AMCU). 2019: 10,000 miners trapped. 2024: illegal mining (zama zamas) endemic. 2024: 2,000+ illegal miners. 2024: underground fires. 2023: gold price $2,000/oz (high). 2024: gold $2,200/oz. 2023: mining accidents (70 deaths/yr SA). 2024: safety record improvement. 2024: Tailings dams (acid mine drainage). 2023: 500 tailings dams. 2024: 20% of world\'s gold reserves still in SA. 2024: Mponeng $1,200/oz cost. 2023: electricity cost (Eskom crisis). 2024: renewable energy at mines. 2023: 3km depth. 2024: 60,000 gold miners in SA. 2022: Sibanye-Stillwater large shareholder. 2023: Gold Fields. 2024: 200,000 ounces/year. 2023: 4,000 underground. 2024: 80% of gold demand (jewelry, electronics). Central bank gold reserves. 2024: new explor. 2024: Democratic Republic of Congo? 2023: Ghana largest African producer (2023 140t). 2024: Mali, Burkina Faso. 2023: SA regulation.',fact:'Witwatersrand Basin · South Africa · 40% of all gold ever mined (50,000+ tonnes) · Johannesburg founded 1886 · Mponeng mine (4km deep, world\'s deepest) · 1970 peak 1,000 tonnes/yr (80% of world) · 2024: 100 tonnes/yr · 3,000m+ deep · illegal mining (zama zamas) · 60°C underground · gold $2,200/oz (2024) · 50+ mines · 2.7B years old · 60k gold miners · 70 deaths/yr · Eskom crisis · 2023 Ghana top Africa producer (140t)'},
  {n:'Copper (Chuquicamata)',la:-22.42,ln:-68.9,sub:'Chile · Atacama · World\'s largest open-pit copper mine',desc:'Chuquicamata — world\'s largest open-pit copper mine. 4.3km long, 3km wide, 1,020m deep (second deepest). Near Calama, Atacama Desert, Chile. Operational since 1915. Owned by Codelco (state-owned). 2024: producing 300,000 tonnes/yr copper (down from 700k peak). 2024: transitioning to underground (Chuquicamata Underground, $5.6B). 2023: 2026 full underground production. Open-pit closure 2025+. 2023: Codelco production 1.4M tonnes (lowest 25 years). Chile produces 25% of world copper (5.3M tonnes 2023). Chuquicamata — "Chuqui" — 1/3 of Chile\'s copper historically. 2024: global copper demand growing (electric vehicles, grid). 2024: copper price $9,000/tonne. 2024: Chile lithium. 2024: Codelco debt $20B. 2023: environmental: water use (Atacama desert). 2024: desalination plant. 2024: energy (solar). 2023: Chilean copper production 5.3M tonnes. 2024: Escondida (BHP) largest copper mine (1.2M tonnes/yr). 2024: Chuquicamata open pit 1,020m. 4.3km x 3km. 50,000 workers historically. 1915 started. 1952: underground? 1971 nationalized. 2024: 300,000 tonnes open pit. 2024: Codelco $4B investment. 2023: 200,000 workers. 2024: 38 million tonnes total copper. 2050: demand to double. 2024: 1,500 workforce. 2023: tailings dams. 2024: world copper 25M tonnes. 2023: 4B pounds. 2024: 3M people. 2023: water. 2024: Atacama wind. 2024: Calama (150k). 2023: copper price. 2024: mining trucks (Komatsu 930E, 300t). 2023: 50. 2024: 70 shovels. 2024: 80% of GDP? No, 10% of Chile GDP.',fact:'Chile · Atacama Desert · world\'s largest open-pit copper mine (4.3km × 3km × 1,020m deep) · 1915-2024 · Codelco (state-owned) · 300,000 tonnes/yr (peak 700k) · transitioning underground ($5.6B) · Chile 25% world copper (5.3M tonnes 2023) · 50k workers historically · 1971 nationalized · desalination plant · solar energy · copper price $9,000/t · 2026 full underground production · 1/3 of Chile\'s copper historically'}

];
