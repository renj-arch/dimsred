})();


// Build cloud cover (procedural noise texture on sphere)
(function buildCloud(){
  const g=layerGroups.cloud;
  if(!g)return;
  const res=128;
  const size=res*res;
  const data=new Uint8Array(size*4);
  for(let i=0;i<size;i++){
    const x=i%res,y=Math.floor(i/res);
    const n=Math.sin(x*0.1)*Math.cos(y*0.12)+Math.sin(x*0.05+y*0.07)*0.5+Math.cos(x*0.03-y*0.09)*0.3;
    const v=Math.max(0,Math.min(1,(n+1.2)/2.4));
    const a=v>0.3?Math.round((v-0.3)*200):0;
    data[i*4]=255;data[i*4+1]=255;data[i*4+2]=255;data[i*4+3]=a;
  }
  const tex=new THREE.DataTexture(data,res,res,THREE.RGBAFormat,THREE.UnsignedByteType);
  tex.needsUpdate=true;
  const geo=new THREE.SphereGeometry(R*1.003,64,64);
  const mat=new THREE.MeshBasicMaterial({map:tex,transparent:true,depthWrite:false,opacity:1});
  const mesh=new THREE.Mesh(geo,mat);
  mesh.name='cloudLayer';
  g.add(mesh);
})();


// Build forest pins
(function buildForest(){
