function wikiKey(name){
  return name.replace(/[^a-z0-9 ]/g,'').trim().replace(/\s+/g,' ').toLowerCase();
}

function getFigure(itemName,itemDesc,catColor){
  const name=itemName||'',desc=itemDesc||'';
  const t=wikiKey(name);
  // Try direct match in FIGURES
  for(const key of Object.keys(FIGURES)){
    if(t.includes(key)||key.includes(t))return FIGURES[key];
  }
  // Try from description
  const dt=wikiKey(desc);
  for(const key of Object.keys(FIGURES)){
    if(dt.includes(key))return FIGURES[key];
  }
  // Generate dynamic figure from item name
  const wikiTitle=name.replace(/[^a-zA-Z0-9 ]/g,'').trim().replace(/\s+/g,'_');
  return {name,color:catColor,isDynamic:true,wiki:wikiTitle||null};
}

const pEl=document.getElementById('portrait');
const pImg=document.getElementById('pImg');
const pName=document.getElementById('pName');
const _thumbCache={};

function setAvatar(img,fig,color){
  const initials=fig.name.split(' ').slice(0,2).map(w=>w[0]).join('').toUpperCase();
  img.src=genAvatar(initials,color);
  img.style.display='block';
  img.nextElementSibling.style.display='none';
}

async function fetchWikiThumb(wikiTitle){
  if(_thumbCache[wikiTitle])return _thumbCache[wikiTitle];
  try{
    const r=await fetch(`https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(wikiTitle)}`);
    const d=await r.json();
    const url=d.thumbnail?.source||null;
    _thumbCache[wikiTitle]=url;
    return url;
  }catch(e){return null}
}

function showPortrait(fig,catColor){
  if(!fig){hidePortrait();return}
  const c=fig.color||catColor||'#fb923c';
  pName.textContent=fig.name;
  pName.style.background=c+'33';
  pEl.classList.add('show');
  // Show avatar immediately, try real image async
  setAvatar(pImg,fig,c);
  if(fig.wiki){
    fetchWikiThumb(fig.wiki).then(url=>{
      if(url&&pName.textContent===fig.name){
        const img=new Image();
        img.onload=()=>{if(pName.textContent===fig.name)pImg.src=url};
        img.onerror=()=>{};
        img.src=url;
      }
    });
  }
}

function hidePortrait(){
  pEl.classList.remove('show');
}

function matchFigure(text){
  if(!text)return null;
  const t=text.toLowerCase();
  for(const key of Object.keys(FIGURES)){
    if(t.includes(key))return key;
  }
  return null;
}

// ============================================================
// TIMELINE ANIMATION ENGINE
// ============================================================
let _tlState=null; // {steps,item,cat,idx,active,lines}

function speakText(text,cb,fig,catColor){
  if(fig)showPortrait(fig,catColor);
  const sub=document.getElementById('subtitle');
  if(text){sub.textContent=text;sub.classList.add('show')}
  if(!window.speechSynthesis||!text){if(cb)setTimeout(cb,800);return}
  speechSynthesis.cancel();
  // Strip commas from numbers so TTS reads "12000" as "twelve thousand" not "twelve zero zero zero"
  const speechText=text.replace(/(\d),(\d)/g,'$1$2');
  const u=new SpeechSynthesisUtterance(speechText);
  u.rate=0.82;u.pitch=0.95;u.volume=1.0;u.lang='en-IN';
  const pick=()=>{
    const voices=speechSynthesis.getVoices();
    const preferred=['Google UK English Female','Microsoft Zira','Google US English','Samantha','Veena'];
    for(const name of preferred){
      const v=voices.find(x=>x.name.includes(name));
      if(v){u.voice=v;break;}
    }
    if(!u.voice){const en=voices.find(x=>x.lang.startsWith('en'));if(en)u.voice=en;}
  };
  pick();
  if(speechSynthesis.getVoices().length===0){
    speechSynthesis.addEventListener('voiceschanged',()=>{pick()},{once:true});
  }
  const clear=()=>{hidePortrait();sub.classList.remove('show')};
  u.onend=()=>{clear();if(cb)setTimeout(cb,200)};
  u.onerror=()=>{clear();if(cb)setTimeout(cb,800)};
  speechSynthesis.speak(u);
}

function drawArc(from,to,color='#fb923c'){
  const pts=[];
  const n=40;
  for(let i=0;i<=n;i++){
    const t=i/n;
    const p=new THREE.Vector3().copy(from).lerp(to,t).normalize();
    const h=Math.sin(t*Math.PI)*0.18;
    p.multiplyScalar(R*1.005+h);
    pts.push(p);
  }
  const geo=new THREE.BufferGeometry().setFromPoints(pts);
  const mat=new THREE.LineBasicMaterial({color,transparent:true,opacity:0.6});
  const line=new THREE.Line(geo,mat);
  EG.add(line);
  return line;
}

function createPulseBeacon(lat,lng,color='#fb923c'){
  const pos=ll(lat,lng,R*1.008);
  const ring=new THREE.Mesh(
    new THREE.RingGeometry(0.015,0.035,24),
    new THREE.MeshBasicMaterial({color,transparent:true,opacity:0.8,side:THREE.DoubleSide,depthWrite:false})
  );
  ring.position.copy(pos);
  ring.lookAt(0,0,0);
  EG.add(ring);

  const glow=new THREE.Mesh(
    new THREE.SphereGeometry(0.025,12,12),
    new THREE.MeshBasicMaterial({color,transparent:true,opacity:0.3,blending:THREE.AdditiveBlending,depthWrite:false})
  );
  glow.position.copy(pos);
  EG.add(glow);

  const data={ring,glow,lat,lng,start:Date.now(),alive:true};
  const pulse=()=>{
    if(!data.alive||!_tlActive())return;
    const elapsed=Date.now()-data.start;
    const cycle=2000;
    const t=(elapsed%cycle)/cycle;
    const s=1+Math.sin(t*Math.PI*2)*0.6;
    data.ring.scale.set(s,s,s);
    data.ring.material.opacity=0.5+Math.sin(t*Math.PI*2)*0.3;
    data.glow.material.opacity=0.15+Math.sin(t*Math.PI*2)*0.15;
    requestAnimationFrame(pulse);
  };
  pulse();
  return data;
}

function createTravelingDot(curve,color='#fb923c'){
  const dot=new THREE.Mesh(
    new THREE.SphereGeometry(0.012,8,8),
    new THREE.MeshBasicMaterial({color,transparent:true,opacity:1,blending:THREE.AdditiveBlending})
  );
  EG.add(dot);
  const glow=new THREE.Mesh(
    new THREE.SphereGeometry(0.025,8,8),
    new THREE.MeshBasicMaterial({color,transparent:true,opacity:0.2,blending:THREE.AdditiveBlending,depthWrite:false})
  );
  EG.add(glow);
  const pos=new THREE.Vector3();
  let progress=0;
  const travel=()=>{
    if(progress>1||!_tlActive()){EG.remove(dot);EG.remove(glow);return}
    curve.getPointAt(progress,pos);
    dot.position.copy(pos);
    glow.position.copy(pos);
    progress+=0.015;
    requestAnimationFrame(travel);
  };
  travel();
}

function createStepLabel(idx,lat,lng,color='#fb923c'){
  const pos=ll(lat,lng,R*1.045);
  const c=document.createElement('canvas');c.width=160;c.height=160;
  const ctx=c.getContext('2d');
  ctx.shadowColor='rgba(0,0,0,0.95)';ctx.shadowBlur=30;
  ctx.beginPath();ctx.arc(80,80,55,0,Math.PI*2);
  ctx.fillStyle=color+'44';ctx.fill();
  ctx.strokeStyle=color;ctx.lineWidth=4;ctx.stroke();
  ctx.shadowBlur=0;
  ctx.fillStyle='#fff';ctx.font='bold 52px Inter,sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';
  ctx.fillText(String(idx+1),80,82);
  const t=new THREE.CanvasTexture(c);t.minFilter=THREE.LinearFilter;
  const s=new THREE.Sprite(new THREE.SpriteMaterial({map:t,transparent:true,depthTest:false}));
  s.scale.set(0.07,0.07,1);s.position.copy(pos);
  s.userData.baseScale=0.07;
  EG.add(s);
  if(!window._tlLabels)window._tlLabels=[];
  window._tlLabels.push(s);
  return s;
}

function flyToStep(idx){
  if(!_tlState||idx>=_tlState.steps.length){finishTimeline();return}
  const s=_tlState;
  s.idx=idx;
  const step=s.steps[idx];

  // Update UI
  document.getElementById('tlStep').textContent=`${idx+1} / ${s.steps.length}`;
  document.getElementById('tlLabel').textContent=`${step.year}  ·  ${step.label}`;
  document.getElementById('tlProgress').style.width=`${((idx+1)/s.steps.length)*100}%`;

  // Step label on globe
  s.stepLabels=s.stepLabels||[];
  s.stepLabels.push(createStepLabel(idx,step.la,step.ln,s.cat.color||'#fb923c'));

  // Draw arc from previous step with traveling dot
  if(idx>0){
    const prev=s.steps[idx-1];
    const from=ll(prev.la,prev.ln,R*1.008);
    const to=ll(step.la,step.ln,R*1.008);
    const line=s.lines.push(drawArc(from,to,s.cat.color||'#fb923c'));
    const arcPts=[];
    for(let i=0;i<=40;i++){
      const t=i/40;
      const p=new THREE.Vector3().copy(from).lerp(to,t).normalize();
      p.multiplyScalar(R*1.005+Math.sin(t*Math.PI)*0.18);
      arcPts.push(p);
    }
    const arcCurve=new THREE.CatmullRomCurve3(arcPts);
    createTravelingDot(arcCurve,s.cat.color||'#fb923c');
  }

  // Pulsing beacon at current location
  s.beacons=s.beacons||[];
  s.beacons.push(createPulseBeacon(step.la,step.ln,s.cat.color||'#fb923c'));

  // Fly camera to step location with cinematic arc
  const targetPos=ll(step.la,step.ln,R*1.7);
  targetPos.applyQuaternion(EG.quaternion);
  const startPos=cam.position.clone();
  const midPoint=new THREE.Vector3().addVectors(startPos,targetPos).multiplyScalar(0.5);
  midPoint.add(new THREE.Vector3(0,Math.max(0.3,Math.random()*0.2+0.15),0));
  const st=Date.now(),dur=2200;

  function tick(){
    const t=Math.min((Date.now()-st)/dur,1);
    const e=1-Math.pow(1-t,3);
    if(t<0.5){
      const subT=t*2;
      cam.position.lerpVectors(startPos,midPoint,subT);
    }else{
      const subT=(t-0.5)*2;
      cam.position.lerpVectors(midPoint,targetPos,subT);
    }
    ctrl.update();
    if(!_tlActive())return;
    if(t<1)requestAnimationFrame(tick);
    else{
      setHighlight(step.la,step.ln);
      const fig=getFigure(step.label,step.desc,s.cat.color);
      speakText(step.desc,()=>{
        if(!_tlActive())return;
        setTimeout(()=>flyToStep(idx+1),1200);
      },fig,s.cat.color);
    }
  }
  tick();
}

function _tlActive(){return _tlState&&_tlState.active}

function finishTimeline(){
  if(!_tlState)return;
  cleanTLArcs();
  const s=_tlState;
  const it=s.item,cat=s.cat,kat=s.kat;
  _tlState.active=false;
  _tlState=null;
  document.getElementById('tlBar').classList.remove('show');
  document.getElementById('subtitle').classList.remove('show');
  hidePortrait();
  ctrl.enableRotate=true;ctrl.enableZoom=true;ctrl.enablePan=false;
  // Show detail panel
  showDetail(it,cat,kat);
}

function cleanTLArcs(){
  if(!_tlState)return;
  _tlState.lines.forEach(l=>EG.remove(l));
  _tlState.lines=[];
  if(_tlState.beacons){_tlState.beacons.forEach(b=>{b.alive=false;EG.remove(b.ring);EG.remove(b.glow)});_tlState.beacons=[];}
  if(_tlState.stepLabels){_tlState.stepLabels.forEach(s=>EG.remove(s));_tlState.stepLabels=[];}
  window._tlLabels=null;
  clearHighlight();
}

function stopTimeline(){
  if(!_tlState||!_tlState.active)return;
  speechSynthesis.cancel();
  _tlState.active=false;
  cleanTLArcs();
  _tlState=null;
  document.getElementById('tlBar').classList.remove('show');
  document.getElementById('subtitle').classList.remove('show');
  hidePortrait();
  ctrl.enableRotate=true;ctrl.enableZoom=true;ctrl.enablePan=false;
}

function speechWarmup(){
  if(!window.speechSynthesis)return;
  speechSynthesis.cancel();
  const w=new SpeechSynthesisUtterance(' ');
  w.volume=0.01;w.rate=1;w.lang='en-US';
  speechSynthesis.speak(w);
  setTimeout(()=>{speechSynthesis.cancel()},100);
}

function playTimeline(steps,item,cat,kat){
  if(_tlState&&_tlState.active)return;
  // Hide detail
  dp.classList.remove('show');clearHighlight();
  // Setup state
  _tlState={steps,item:item,cat:cat,kat:kat,idx:0,active:true,lines:[]};
  // Lock controls
  ctrl.enableRotate=false;ctrl.enableZoom=false;
  // Show timeline bar
  document.getElementById('tlBar').classList.add('show');
  document.getElementById('tlPlayBtn').textContent='⏸';
  // Warm up speech engine (fixes muted first words)
  speechWarmup();
  // Small delay to let speech engine initialize
  setTimeout(()=>flyToStep(0),300);
}

// Timeline control buttons
document.getElementById('tlCloseBtn').addEventListener('click',stopTimeline);
document.getElementById('tlReplayBtn').addEventListener('click',()=>{
  if(!_tlActive())return;
  speechSynthesis.cancel();
  cleanTLArcs();
  const s=_tlState;
  const idx=s.idx;
  s.lines=[];s.beacons=[];s.stepLabels=[];
  // Reset camera to step location and replay
  const step=s.steps[idx];
  const target=ll(step.la,step.ln,R*1.7);
  target.applyQuaternion(EG.quaternion);
  cam.position.copy(target);
  ctrl.update();
  setHighlight(step.la,step.ln);
  s.beacons.push(createPulseBeacon(step.la,step.ln,s.cat.color||'#fb923c'));
  s.stepLabels.push(createStepLabel(idx,step.la,step.ln,s.cat.color||'#fb923c'));
  const fig=getFigure(step.label,step.desc,s.cat.color);
  speakText(step.desc,null,fig,s.cat.color);
});
document.getElementById('tlPlayBtn').addEventListener('click',()=>{
  if(!_tlActive()){stopTimeline();return}
  // Pause: not fully implemented — just stop for now
  stopTimeline();
});

// Animate
function anim(){
  requestAnimationFrame(anim);
  ctrl.update();
  if(rotating)EG.rotation.y+=0.0003;
  updateLabels();
  // Dynamic step label scaling — shrink when zoomed in to prevent overlap
  if(window._tlLabels&&_tlState&&_tlState.active){
    const d=cam.position.length();
    const s=Math.min(0.12,Math.max(0.025,0.045*Math.max(1,d-0.5)));
    window._tlLabels.forEach(l=>{if(l.parent)l.scale.set(s,s,1)});
  }
  // Pulse highlight ring — makes marker location visible even behind panel
  if(_selHighlight){
    const t=Date.now()*0.003;
    _selHighlight.children[0].material.opacity=0.55+0.4*Math.sin(t);
    _selHighlight.children[1].material.opacity=0.08+0.06*Math.sin(t+1.2);
    const s=1+0.3*Math.sin(t*0.7);
    _selHighlight.children[0].scale.set(s,s,s);
    _selHighlight.children[1].scale.set(s,s,s);
  }
  ren.render(scene,cam);
}

anim();

// ---- Camera flyTo helper (just move, no detail panel) ----
function flyToLatLon(la,ln,radius,callback){
  const pos=ll(la,ln,radius||R*1.7);
  pos.applyQuaternion(EG.quaternion);
  const start=cam.position.clone(),st=Date.now(),dur=1400;
  function tick(){
    const t=Math.min((Date.now()-st)/dur,1);
    const e=1-Math.pow(1-t,3);
    cam.position.lerpVectors(start,pos,e);
    ctrl.update();
    if(t<1)requestAnimationFrame(tick);
    else if(callback)callback();
  }
  tick();
}

