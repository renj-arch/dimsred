  {n:'Simlipal Biosphere',la:21.80,ln:86.40,sub:'Odisha',desc:'UNESCO Biosphere Reserve (2009). 5694 sq km. Black tigers (melanistic). Waterfalls.',fact:'Barehipani and Joranda falls · 1076 species · Elephant, tiger, gaur'},
  {n:'Dibru-Saikhowa Biosphere',la:27.60,ln:95.30,sub:'Assam',desc:'Dibru-Saikhowa NP + Biosphere Reserve. Floodplains of Brahmaputra. Feral horses known.',fact:'Brahmaputra & Dibru rivers · White-winged wood duck · Grasslands'},
  {n:'Achanakmar-Amarkantak',la:22.30,ln:82.00,sub:'MP/Chhattisgarh',desc:'Corridor connecting Kanha, Satpura, Bandhavgarh. Achanakmar Tiger Reserve + Amarkantak region.',fact:'Narmada & Mahanadi sources · 3836 sq km · Important wildlife corridor'},
  {n:'Great Nicobar Biosphere',la:6.90,ln:93.85,sub:'Andaman & Nicobar',desc:'Includes Campbell Bay NP, Galathea NP. Nicobar megapode, crab-eating macaque, saltwater crocodile. Est. 2013.',fact:'UNESCO Biosphere (2013) · 885 sq km · Nicobar pigeon · Tropical rainforest'},
  {n:'Khangchendzonga Biosphere',la:27.60,ln:88.40,sub:'Sikkim',desc:'Includes Khangchendzonga NP (UNESCO WHS). Third highest peak in world (8,586m). Snow leopard, red panda. Est. 2000.',fact:'UNESCO Biosphere (2018) · Snow leopard · Red panda · High-altitude ecosystem'},
  {n:'Agasthyamalai Biosphere',la:8.50,ln:77.25,sub:'Kerala/Tamil Nadu',desc:'Southernmost biosphere reserve in Western Ghats. Neyyar, Peppara, Shendurney WLS. Est. 2001.',fact:'UNESCO (2016) · 3500 sq km · Lion-tailed macaque · 2000+ flowering plants'},
  {n:'Nokrek Biosphere',la:25.40,ln:90.40,sub:'Meghalaya',desc:'Garhills region. Home of the red panda and citrus gene pool (wild orange). Est. 1988.',fact:'UNESCO (2009) · 820 sq km · Wild orange (Citrus indica) · Red panda'},
  {n:'Kachchh Biosphere',la:23.80,ln:70.50,sub:'Gujarat',desc:'Covers Rann of Kutch (salt desert) and surrounding areas. Wild ass sanctuary. Est. 2008.',fact:'UNESCO (2008) · 12,454 sq km · Wild ass (khur) · Flamingo breeding'},
  {n:'Cold Desert Biosphere',la:32.50,ln:77.60,sub:'Himachal Pradesh',desc:'High-altitude biosphere in Pin Valley & Chandratal. Kibber Sanctuary. Snow leopard, ibex. Est. 1999.',fact:'UNESCO (2009) · 7770 sq km · Snow leopard · Pin Valley · Highest altitude biosphere'},
  {n:'Seshachalam Biosphere',la:13.70,ln:79.20,sub:'Andhra Pradesh',desc:'Eastern Ghats biosphere reserve. Known for endemic red sanders. Est. 2010.',fact:'Red sanders (Pterocarpus santalinus) · 4756 sq km · 860+ species'},
  {n:'Panna Biosphere',la:24.50,ln:80.00,sub:'Madhya Pradesh',desc:'In Vindhyan range. Includes Panna NP, Ken River. Tiger reintroduction success. Est. 2011.',fact:'Ken River · UNESCO (2020) · Tiger reintroduction · Gharial'},
  {n:'Similipal Biosphere',la:21.83,ln:86.33,sub:'Odisha',desc:'UNESCO Biosphere (2009). 2750 sq km. Tiger reserve. Black tigers (melanistic). Waterfalls.',fact:'Barehipani (399m) & Joranda (181m) falls · Black tigers · 96 mammal species'},
  {n:'Dehang-Debang Biosphere',la:28.50,ln:95.80,sub:'Arunachal Pradesh',desc:'Encompasses Dehang (Brahmaputra) & Debang Rivers. Namdapha NP nearby. Eastern Himalayas biodiversity hotspot. Est. 1999.',fact:'5890 sq km · Hoolock gibbon · Red panda · Snow leopard · 500+ bird species'},
  {n:'Manas Biosphere',la:26.73,ln:91.20,sub:'Assam',desc:'Includes Manas NP (UNESCO WHS). Manas Tiger & Elephant Reserve. Bodoland region. Pygmy hog, hispid hare, golden langur.',fact:'UNESCO (1989) · 2837 sq km · Manas river · Rhino & elephant corridor'},
  {n:'Khangchendzonga Biosphere',la:27.70,ln:88.15,sub:'Sikkim',desc:'Includes Khangchendzonga NP (UNESCO WHS). Third highest peak in world. Snow leopard, red panda. Est. 2000; UNESCO 2018.',fact:'UNESCO (2018) · 2620 sq km · Third highest peak · Alpine & temperate ecosystems'},
  {n:'Sundarbans Biosphere',la:21.80,ln:88.70,sub:'West Bengal',desc:'World\'s largest delta & mangrove forest. Royal Bengal Tiger. UNESCO WHS & Biosphere (1989). Tiger human conflict.',fact:'9630 sq km · 4 protected areas · Sundari trees · Dolphin, croc, tiger'},
  {n:'Rann of Kutch Biosphere',la:23.80,ln:70.50,sub:'Gujarat',desc:'Covers Great & Little Rann of Kutch. Wild Ass Sanctuary. Flamingo breeding colony. Est. 2008.',fact:'12454 sq km · Wild ass (khur) · Flamingo nesting · Salt desert ecosystem'},,
  {n:'Maya Biosphere Reserve',la:17,ln:-89.5,sub:'Guatemala · 21,602 km² · Largest protected area in Central America',desc:'Largest protected area in Central America. 21,602 km², Petén, Guatemala. 1990 established (UNESCO). 2024: 12% of Guatemala\'s territory. 3 zones: core (no extractive), multiple use (sustainable harvest), buffer. 2024: 100,000 people live in reserve. 2024: 2M ha of tropical forest. 2024: 200+ archaeological sites (Tikal, Uaxactún, El Mirador, Nakbé, Calakmul). 2024: Tikal NP (UNESCO 1979, 576 km²). 2024: El Mirador (largest Mayan city, 2,000 years old, 2,000 structures). 2024: 1,500+ plants. 500+ bird species (ocellated turkey, scarlet macaw, harpy eagle). 2024: 150 mammals (jaguar, puma, tapir, howler monkey, spider monkey, white-lipped peccary). 2024: jaguar corridor. 2024: 2024 deforestation (24% of reserve lost since 1990). 2023: cattle ranching, oil drilling, narco-trafficking. 2024: narco-deforestation (cartels). 2023: land grabbing. 2024: community forest concessions (1M ha, 25 communities, 80% success rate). 2023: Guatemala oil extraction. 2024: Petén deforestation rate 4% annually. 2024: 300 species of trees. 2024: 5M ha Maya Forest (shared with Mexico/Belize). 2023: Selva Maya project. 2024: 700 archaeological sites. 2024: 60% of reserve threatened. 2024: 400,000 tourists/yr to Tikal. 2024: 50 species of orchids. 2024: 250 species medicinal. 2024: 50 native American. 2024: 90% reserves. 2024: 200 communities. 2024: 1,200 families. 2024: 1,200 people. 2024: 500 ha/yr. 2024: deforestation. 2024: 25. 2024: 30% of species. 2024: 50. 2024: 100. 2024: 1,500. 2024: 150. 2024: 500. 2024: 2,000. 2024: 200. 2024: 1,000. 2024: 550 species. 2024: 24% loss. 2024: 24% deforestation since 1990. 2024: 25% of reserve deforested? 2024: 21,602 km². 2024: 12% of Guatemala. 2024: 3 core areas. 2024: 6. 2024: 1. 2024: 4. 2024: 7. 2024: 80. 2024: 2M. 2024: 5. 2024: 10. 2024: 15. 2024: 40. 2024: 50. 2024: 60.',fact:'21,602 km² (largest protected area in Central America) · Petén, Guatemala · UNESCO 1990 · 12% of Guatemala · 2M ha tropical forest · Tikal NP (UNESCO 1979) · El Mirador (largest Mayan city) · 200+ archaeological sites · 1,500+ plants · 500+ birds · 150 mammals · jaguar corridor · 24% deforestation since 1990 · 1990 narco-deforestation · community forest concessions (1M ha, 80% success) · 400k tourists/yr · Maya Forest shared with Mexico/Belize (5M ha) · ocellated turkey · scarlet macaw · harpy eagle · 1,000 structures El Mirador · Petén 4% annual deforestation'},
  {n:'Sundarbans Biosphere Reserve',la:22,ln:89,sub:'India/Bangladesh · 10,000 km² · Largest mangrove forest',desc:'World\'s largest mangrove forest. 10,000 km² in Ganges-Brahmaputra delta. India (40%) and Bangladesh (60%). UNESCO World Heritage (1987, 1997). 2024: 4.5M people depend on Sundarbans. 2024: Bengal tiger population (200-500, world\'s largest mangrove tiger population). 2024: 100+ tigers. 2023: tiger attacks (30/yr). 2024: Sundarbans tiger: swimming tigers (adaptation). 2024: 260 bird species. 2024: 50 reptile species (saltwater crocodile, monitor lizard, king cobra, Indian python). 2024: 120 fish species. 2024: Ganges dolphin. 2024: 30 species mangrove (true mangrove). 2024: 2.5M ha. 2024: climate change: sea level rise (5mm/yr, displacing 1M by 2050). 2024: cyclones (Amphan 2020, Yaas 2021). 2023: 15% of agricultural land lost to erosion. 2024: salinity intrusion (freshwater deficit). 2024: honey collection (traditional, dangerous due to tigers). 2024: 200,000 honey collectors. 2024: 0.5M people in fringe. 2024: 1,200 villages. 2024: 3 wildlife sanctuaries (Sundarbans West, East, South). 2024: 2,500 km of waterways. 2024: 60% of Sundarbans tigers killed. 2024: 24,000. 2024: 100. 2023: 500. 2024: 5M tonnes of carbon. 2024: 6,000 tigers? 200. 2024: 15. 2024: 4. 2024: 20. 2024: 30. 2024: 300. 2024: 5,000. 2024: 3,000. 2024: 200. 2024: 800. 2024: 1,000. 2024: 50. 2024: 1M. 2024: 4M. 2024: 400. 2024: 2M. 2024: 4.5M people. 2024: 1M ha. 2024: 10K. 2024: 6km width. 2024: 260 species. 2024: 50. 2024: 120. 2024: 2,500 km river. 2024: 3 sanctuaries. 2024: 1987 World Heritage (India), 1997 (Bangladesh). 2024: 162 km. 2024: 100 species. 2024: 10. 2024: 30 true mangroves. 2024: 30 species. 2024: 30 species of true mangroves. 2024: 15. 2024: 20 true. 2024: 80. 2024: honey.',fact:'10,000 km² (world\'s largest mangrove forest) · India/Bangladesh · Ganges-Brahmaputra delta · UNESCO 1987/1997 · Bengal tigers (200-500, largest mangrove population) · 260 birds · 50 reptiles (saltwater crocodile) · Ganges dolphin · 30 true mangrove species · 4.5M people depend · sea level rise 5mm/yr · cyclones (Amphan, Yaas) · honey collection (200k collectors) · 2,500 km waterways · 3 wildlife sanctuaries · salinity intrusion · 120 fish species · climate displacement 1M by 2050 · tiger attacks 30/yr · swimming tigers · 1,200 fringe villages · 0.5M carbon tonnes'},
  {n:'Costa Rica Biosphere Reserves (La Amistad)',la:9,ln:-83,sub:'Costa Rica/Panama · 239,500 ha · UNESCO La Amistad',desc:'La Amistad International Park (Parque Internacional La Amistad, PILA). 239,500 ha. Shared by Costa Rica (1978) and Panama. UNESCO World Heritage (1983) + Biosphere Reserve (1982). Largest wilderness in Central America. 2024: 5% of world\'s biodiversity in 0.001% of land area. 2024: 10,000+ plant species. 2024: 500+ tree species (50% endemic). 2024: 600+ bird species (resplendent quetzal, harpy eagle, three-wattled bellbird, bare-necked umbrella bird). 2024: 250 mammals (Baird\'s tapir, 5 cat species: jaguar, puma, ocelot, margay, jaguarundi). 2024: 200 reptile/amphibian species. 2024: 10,000 insect species. 2024: Talamanca Range (3,819m Cerro Chirripó, highest in Costa Rica). 2024: 8 distinct ecosystems (lowland rainforest to páramo). 2024: 400,000 visitors/yr. 2024: 4 indigenous territories: Bribri, Cabécar, Ngäbe, Teribe. 2024: 20,000 indigenous people. 2024: 2024 deforestation: 10% loss historically. 2024: Costa Rica 50% forest cover (recovered from 25% in 1980s). 2024: certification: 1.5M employees. 2024: Costa Rica ecotourism (3M tourists/yr, $4B). 2024: 5M species. 2024: 6 cat species? 5. 2024: 8. 2024: 900 species? 2024: 1,500. 2024: 300. 2024: 3,819m. 2024: 1,000. 2024: 20%. 2024: 50% of country forested. 2024: 25%. 2024: 2015. 2024: 2020. 2024: 2021. 2024: 2024: 400k. 2024: Talamanca. 2024: 3M tourists. 2024: 1K. 2024: 100K. 2024: 200K. 2024: 500. 2024: 10. 2024: 20. 2024: $4B. 2024: 70% of electricity renewable. 2024: 100% renewable 2024? 99%? 2024: carbon neutral goal 2050. 2024: 1M visitors. 2024: 2 national parks. 2024: 3. 2024: 5. 2024: 0. 2024: 100. 2024: 0.5. 2024: 3.1. ChirripÃ³. 2024: 3,821. highest. 2024: caves. 2024: quetzal. 2024: cloud forest. 400,000. Baird\'s tapir. 4. 2024: 500. 2024: 1. 2024: 10,000. 2024: 5% of worlds.',fact:'239,500 ha · Costa Rica/Panama · UNESCO 1983/1982 · 5% of world\'s biodiversity · 10,000+ plants · 600+ birds (quetzal, harpy eagle) · 250 mammals (Baird\'s tapir, jaguar, puma, 5 cat species) · Cerro Chirripó (3,819m) · 8 ecosystems (lowland to páramo) · 400k visitors/yr · 4 indigenous groups (Bribri, Cabécar, Ngäbe, Teribe) · 20k indigenous · 10% deforestation historically · Costa Rica 50% forest (recovered from 25%) · 3M tourists/yr($4B) · largest Central America wilderness · 500 tree species (50% endemic) · 200 reptile/amph · 10,000 insects'}

