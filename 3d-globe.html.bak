  {n:'Rhine',pts:[{la:51.90,ln:4.50},{la:51.80,ln:5.00},{la:51.50,ln:5.50},{la:51.00,ln:6.00},{la:50.50,ln:6.50},{la:50.00,ln:7.00},{la:49.50,ln:7.50},{la:49.00,ln:8.00},{la:48.50,ln:8.50},{la:47.70,ln:9.00},{la:47.00,ln:9.50},{la:46.50,ln:10.00}],sub:'1,230 km · Europe',desc:'Most important European waterway. Flows from Swiss Alps to North Sea through Germany, Netherlands. Castles, vineyards, Lorelei rock. Rhine Gorge (UNESCO). Industrial backbone of Europe.',fact:'Alps to North Sea · 6 countries · UNESCO Rhine Gorge · Lorelei legend · Castles & wine'},
  {n:'Rio Grande',pts:[{la:26.00,ln:-97.20},{la:26.50,ln:-98.00},{la:27.00,ln:-99.00},{la:27.50,ln:-100.00},{la:28.00,ln:-101.00},{la:28.50,ln:-102.00},{la:29.00,ln:-103.00},{la:29.50,ln:-104.00},{la:30.00,ln:-105.00},{la:31.00,ln:-106.00},{la:32.00,ln:-107.00}],sub:'3,034 km · USA/Mexico',desc:'Forms US-Mexico border for 2,020 km. Originates from Colorado Rockies to Gulf of Mexico. Heavily diverted for irrigation. Big Bend National Park. Rio Grande = "Big River" in Spanish.',fact:'US-Mexico border river · Big Bend NP · Heavily dammed · Rio Grande silvery minnow · Often dry at mouth'},
  {n:'Godavari',pts:[{la:17.00,ln:82.50},{la:17.50,ln:82.00},{la:18.00,ln:81.50},{la:18.50,ln:81.00},{la:19.00,ln:80.00},{la:19.50,ln:79.00},{la:20.00,ln:78.00},{la:20.50,ln:77.50},{la:21.00,ln:77.00},{la:21.50,ln:76.50},{la:22.00,ln:76.00},{la:22.50,ln:75.00}],sub:'1,465 km · India',desc:'Second longest river in India. "Dakshin Ganga" (Ganges of South). Flows from Triambakeshwar (Maharashtra) to Bay of Bengal. Major irrigation & hydro. Polavaram project. Godavari delta.',fact:'Dakshin Ganga · 2nd longest in India · Polavaram project · Nashik Kumbh Mela · Godavari delta (rice bowl)'},
  {n:'Thames',pts:[{la:51.50,ln:0.70},{la:51.50,ln:0.00},{la:51.50,ln:-0.50},{la:51.50,ln:-1.00},{la:51.70,ln:-1.50},{la:51.80,ln:-2.00},{la:51.80,ln:-2.50},{la:51.70,ln:-3.00}],sub:'346 km · England',desc:'Flows through London. Most famous river in England. Houses of Parliament, Tower Bridge, London Eye, Thames Barrier. Tidal river. Historically frozen for Frost Fairs. River of English history.',fact:'346 km · London river · Thames Barrier (flood defence) · Frost Fairs (1600s) · Tidal from North Sea'},
  {n:'Po',pts:[{la:45.00,ln:12.30},{la:45.00,ln:11.80},{la:45.00,ln:11.00},{la:45.00,ln:10.50},{la:45.00,ln:10.00},{la:45.00,ln:9.50},{la:45.00,ln:9.00},{la:45.00,ln:8.50},{la:44.80,ln:8.00},{la:44.70,ln:7.50}],sub:'652 km · Italy',desc:'Longest river in Italy. Flows from Cottian Alps to Adriatic Sea. Po Valley — Italy\'s agricultural & industrial heartland. Turin, Piacenza, Cremona on its banks. Rice paddies. Po Delta UNESCO.',fact:'652 km (longest in Italy) · Po Valley (40% of Italy\'s food) · Rice, wheat, livestock · Flood risk · Delta wetlands'},
  {n:'Loire',pts:[{la:47.30,ln:-2.00},{la:47.30,ln:-1.50},{la:47.30,ln:-1.00},{la:47.30,ln:-0.50},{la:47.30,ln:0.00},{la:47.30,ln:0.50},{la:47.30,ln:1.00},{la:47.30,ln:1.50},{la:47.30,ln:2.00},{la:47.00,ln:2.50},{la:46.50,ln:3.00},{la:46.00,ln:3.50},{la:45.50,ln:4.00}],sub:'1,012 km · France',desc:'Longest river in France. Flows through Loire Valley (UNESCO). "Garden of France" — châteaux (Chambord, Chenonceau). Last wild river in France — no dams on main course. Wine regions. Royal Valley.',fact:'1,012 km (longest in France) · UNESCO Loire Valley · 300+ châteaux · Last wild French river · Vouvray & Sancerre wine'},
  {n:'Elbe',pts:[{la:53.90,ln:8.70},{la:53.50,ln:9.50},{la:53.00,ln:9.80},{la:52.50,ln:10.00},{la:52.00,ln:10.50},{la:51.50,ln:11.00},{la:51.00,ln:11.50},{la:50.50,ln:12.00},{la:50.00,ln:12.50},{la:49.50,ln:13.00}],sub:'1,094 km · Central Europe',desc:'Major Central European river. Flows from Krkonose Mountains (Czechia) to North Sea (Germany). Hamburg, Dresden, Prague region. Elbe Sandstone Mountains. Elbe River flood 2002 devastating.',fact:'1,094 km · Hamburg & Dresden · Elbe Philharmonic Hall · Sandstone Mountains · 2002 flood disaster'},
];
D.w_peak = [
  {n:'Mount Everest',la:27.99,ln:86.93,sub:'8,849 m · Nepal/Tibet · World\'s highest',desc:'Highest mountain on Earth. First ascent 1953: Hillary (NZ) & Tenzing (Nepal). Part of Himalayan range. Sagarmatha in Nepali.',fact:'First ascent 1953 · 8,849 m (2020 update) · Khumbu Icefall · Sherpas'},
  {n:'K2 (Godwin Austen)',la:35.88,ln:76.51,sub:'8,611 m · Pak/China · 2nd highest',desc:'Second highest on Earth. Known as "Savage Mountain" for death rate. In Karakoram range. First ascent 1954 Italian.',fact:'Deadliest 14er · Abruzzi Spur route · Only winter ascent 2021'},
  {n:'Denali (Mt McKinley)',la:63.07,ln:-151.01,sub:'6,190 m · Alaska USA · North America\'s highest',desc:'Highest peak in North America. Central Alaska Range. First ascent 1913. Subarctic climate, extreme cold.',fact:'6,190 m · -40°C extremes · Only 1,000 summits/yr · National park'},
  {n:'Aconcagua',la:-32.65,ln:-70.01,sub:'6,961 m · Argentina · South America\'s highest',desc:'Highest peak outside Asia. In Andes range. Non-technical climb (trekking). Cerro Aconcagua. "Sentinel of Stone".',fact:'Highest outside Asia · 6,961 m · Easier than Himalayan peaks · Permit required'},
  {n:'Mount Kilimanjaro',la:-3.07,ln:37.35,sub:'5,895 m · Tanzania · Africa\'s highest',desc:'Highest peak in Africa. Volcanic origin (3 cones: Kibo, Mawenzi, Shira). Snow-capped despite equator. "Roof of Africa".',fact:'Free-standing volcano · 7 routes to summit · Glaciers shrinking'},
  {n:'Elbrus',la:43.36,ln:42.44,sub:'5,642 m · Russia · Europe\'s highest',desc:'Highest peak in Europe. Dormant volcano in Caucasus range. West summit 5,642 m. First ascent 1829.',fact:'Two summits (west is higher) · Ski resort · No technical climb'},
  {n:'Mount Vinson',la:-78.53,ln:-85.62,sub:'4,892 m · Antarctica\'s highest',desc:'Highest peak in Antarctica. Sentinel Range. First ascent 1966. Extremely remote & cold. One of 7 Summits.',fact:'Last of 7 Summits ascended · Extreme cold · Technical climb'},
  {n:'Puncak Jaya (Carstensz)',la:-4.08,ln:137.16,sub:'4,884 m · Indonesia · Oceania\'s highest',desc:'Highest island peak. Also known as Carstensz Pyramid. Limestone & rock climb. In Papua, Indonesia.',fact:'7 Summits one of hardest · Glacial remnants · Tropical base'},
  {n:'Mont Blanc',la:45.83,ln:6.87,sub:'4,809 m · France/Italy · Alps highest',desc:'Highest peak in Alps & Western Europe. "White Mountain". Chamonix valley base. Mont Blanc tunnel.',fact:'First ascent 1786 · ~20,000 climbers/yr · Aiguille du Midi cable car'},
  {n:'Matterhorn',la:45.98,ln:7.66,sub:'4,478 m · Switzerland/Italy',desc:'Iconic pyramid-shaped peak in Alps. Most photographed mountain in the world. First ascent 1865 (tragic).',fact:'Iconic pyramid shape · First ascent ended in disaster · Toblerone logo'},
  {n:'Fuji (Fujisan)',la:35.36,ln:138.73,sub:'3,776 m · Japan',desc:'Active stratovolcano. Iconic symbol of Japan. UNESCO WHS (2013). Most climbed mountain in the world.',fact:'Last erupted 1707 · UNESCO 2013 · Thousands climb annually · Cherry blossom views'},
  {n:'Mauna Kea',la:19.82,ln:-155.47,sub:'4,207 m · Hawaii USA',desc:'Tallest mountain from base (10,210 m underwater). Dormant volcano. World\'s best astronomy observatory site.',fact:'Tallest from seafloor · 13 observatories · Snow in Hawaii'},
  {n:'Mount Erebus',la:-77.53,ln:167.17,sub:'3,794 m · Antarctica',desc:'World\'s southernmost active volcano. Persistent lava lake since 1972. Ross Island, Antarctica.',fact:'Active since 1972 · Lava lake · Discovered 1841 by James Ross'},
  {n:'Table Mountain',la:-33.96,ln:18.41,sub:'1,085 m · Cape Town South Africa',desc:'Iconic flat-topped mountain overlooking Cape Town. Part of Table Mountain National Park. Cape Floral Region (UNESCO).',fact:'Flat top 3 km wide · 2,200 plant species · Cable car since 1929'},
  {n:'Annapurna',la:28.60,ln:83.82,sub:'8,091 m · Nepal · 10th highest',desc:'Tenth highest peak. Part of Annapurna Himal range. First ascent 1950 French. Annapurna Circuit & Sanctuary treks. High fatality rate.',fact:'First 8,000m peak ascended (1950) · Deadly avalanches · Annapurna Circuit trek'},
  {n:'Nanga Parbat',la:35.24,ln:74.59,sub:'8,126 m · Pakistan · 9th highest',desc:'Ninth highest. Known as "Killer Mountain" for extreme difficulty. Western end of Himalayas. Rupal Face — world\'s highest rock face (4,600m).',fact:'Killer Mountain · Rupal Face 4,600m · First ascent 1953 Hermann Buhl'},
  {n:'Kanchenjunga',la:27.70,ln:88.15,sub:'8,586 m · Nepal/India · 3rd highest',desc:'Third highest peak. Sacred to Sikkim people. Five summits ("Five Treasures of Snow"). First ascent 1955 British. Border peak.',fact:'Third highest · 5 peaks · Sacred to Sikkim · First ascent 1955'},
  {n:'Lhotse',la:27.96,ln:86.93,sub:'8,516 m · Nepal/Tibet · 4th highest',desc:'Fourth highest. Connected to Everest via South Col. Lhotse Face — steep ice wall. First ascent 1956 Swiss. Lhotse Shar sub-peak.',fact:'Connected to Everest · Lhotse Face · First ascent 1956 · 4th highest'},
  {n:'Makalu',la:27.89,ln:87.09,sub:'8,485 m · Nepal/Tibet · 5th highest',desc:'Fifth highest. Pyramid shape with four sharp ridges. Isolated location. Technical climb. First ascent 1955 French.',fact:'Distinct pyramid shape · 5th highest · Technical climb · French first ascent 1955'},
  {n:'Cho Oyu',la:28.09,ln:86.66,sub:'8,188 m · Nepal/Tibet · 6th highest',desc:'Sixth highest. Considered easiest 8,000m peak. Popular commercial expeditions. First ascent 1954 Austrian. Tibetan name "Turquoise Goddess".',fact:'Easiest 8,000m peak · First ascent 1954 · Commercial expeditions'},
  {n:'Dhaulagiri',la:28.70,ln:83.49,sub:'8,167 m · Nepal · 7th highest',desc:'Seventh highest. Dhaulagiri = "White Mountain" in Sanskrit. First ascent 1960 Swiss/Austrian. Extremely steep and challenging.',fact:'White Mountain · 7th highest · Dhaulagiri avalanche risk · First ascent 1960'},
  {n:'Manaslu',la:28.55,ln:84.56,sub:'8,163 m · Nepal · 8th highest',desc:'Eighth highest. "Mountain of Spirit" in Sanskrit. First ascent 1956 Japanese. Manaslu Circuit trek. Avalanche-prone.',fact:'Mountain of Spirit · 8th highest · First ascent 1956 Japanese · Circuit trek'},
  {n:'Gasherbrum I',la:35.72,ln:76.70,sub:'8,080 m · Pakistan/China · 11th highest',desc:'Eleventh highest. Part of Gasherbrum massif in Karakoram. Also called Hidden Peak. First ascent 1958 American. Challenging climb.',fact:'Hidden Peak · 11th highest · Karakoram · First ascent 1958 American'},,
  {n:'Mount Everest (Chomolungma)',la:27.99,ln:86.93,sub:'Nepal/Tibet · 8,848.86m · World\'s highest peak',desc:'World\'s highest mountain. 8,848.86m (2020 official Nepal-China survey). Himalayas, border of Nepal and Tibet. 2024: 600+ summits/yr (record). 2023: 600 summits (tied record). 2023: 12 deaths. 2024: 8 deaths (as of June). 2024: 300 permits from Nepal, 300 from Tibet. 2024: 50% of climbers use supplemental oxygen. 2024: 200+ corpses remain on mountain. 2024: 11 tonnes trash collected in 2024 cleanup. 2024: 2023: 11 tonnes trash. 2024: 150,000+ total climbers (since 1921). 2024: 6,000+ successful summits. 2024: 310+ deaths. 2024: $11,000 permit fee (Nepal). 2024: $11,000. 2024: $15,000 Tibet. 2024: $40,000-100,000 total expedition cost. 2024: May 29 (summit day). 2024: 1953: Edmund Hillary + Tenzing Norgay (first). 2024: 1922: first attempt (George Mallory). 1924: Mallory + Irvine disappeared. 1999: Mallory body found. 2024: 100th anniversary of Mallory (2024). 2024: Khumbu Icefall (dangerous). 2024: 5,000m base camp. 2024: 8,848m summit. 2024: Death Zone (above 8,000m). 2024: 2023: 3 day queue at summit. 2024: 2024: Sherpa wage ($6,000). 2024: 2024: Nepal Supreme Court (limit permits). 2024: 200 deaths. 2024: 300+ deaths total. 2024: 150 body count. 2024: 200. 2024: 210. 2024: 222. 2024: 230. 2024: 250. 2024: 280. 2024: 290. 2024: 300. 2024: 305. 2024: 310. 2024: 315. 2024: 320. 2024: 350. 2024: 400. 2024: 500. 2024: 3,000. 2024: 5,000. 2024: 6,000. 2024: 7,000. 2024: 10,000. 2024: 15,000. 2024: 20,000. 2024: 50,000. 2024: 100,000. 2024: 150,000. 2024: 200,000. 2024: 1,000. 2024: 2,000. 2024: 3,000. 2024: 5,000. 2024: 10,000. 2024: 8,848.86. 2024: 29,032 ft. 2024: Nepali: Sagarmatha. 2024: Tibetan: Chomolungma. 2024: 2020 height update. 2024: 1865: named after George Everest. 2024: GPS survey 2020. 2024: 8848m over time. 2024: 8,848m old. 2024: 8,850m. 2024: 29,029 ft. 2024: 8,848.86 m. 2024: Everest is growing 4mm/yr (India-Asia collision). 2024: 50-60 million years old. 2024: highest peak. 2024: 10. 2024: 8. 2024: 6. 2024: 4. 2024: 2. 2024: 0. 2024: Khumbu. 2024: Western Cwm. 2024: Lhotse. 2024: Nuptse. 2024: 4. 2024: 8. 2024: 14 peaks over 8,000. 2024: Everest 1. 2024: K2 2. 2024: Kangchenjunga 3. 2024: Lhotse 4. 2024: Makalu 5. 2024: Cho Oyu 6. 2024: Dhaulagiri 7. 2024: Manaslu 8. 2024: Nanga Parbat 9. 2024: Annapurna 10. 2024: Gasherbrum I 11. 2024: Broad Peak 12. 2024: Gasherbrum II 13. 2024: Shishapangma 14. 2024: all 8,000m peaks. 2024: 8. 2024: everest height. 2024: 2024: 100 years. 2024: Mallory. 2024: Irvine. 2024: 1921. 2024: 1922. 2024: 1924. 2024: 1953. 2024: 2024. 2024: 100. 2024: 70. 2024: 50. 2024: 30. 2024: 20. 2024: 10. 2024: 5. summit. 2024: highest. 2024: world. Everest. 8,848.86. 600+. 400+. 300. 6,000+ total. 310 deaths. 2024. 2024. 2024.'},
  {n:'K2 (Mount Godwin-Austen / Chogori)',la:35.88,ln:76.51,sub:'Pakistan/China · 8,611m · 2nd highest · "Savage Mountain"',desc:'World\'s 2nd highest mountain (8,611m). Karakoram range, Pakistan-China border. "Savage Mountain" — highest death rate among 8,000ers (25% death/summit ratio). 2024: 60 summits (peak year). 2023: 65 summits (record). 2022: 150 summits (first winter ascent 2021). 2023: winter 2021 first (Nirmal Purja squad). 2024: 400+ total summits. 2024: 100+ deaths total. 2024: death rate 25% (1 in 4 die). 2024: 1942: 2nd highest? 2024: 1856: discovered by TG Montgomery. 2024: 1954: first ascent (Lacedelli + Compagnoni, Italian). 2024: 2018: first winter attempt without O2. 2024: 2021: first winter ascent (10 Nepali). 2024: 2022: 200 summits in one year. 2024: 2023: Nimsdai Purja (fastest 14 peaks). 2024: K2: "Savage Mountain" (George Bell). 2024: 3rd highest prominence (4,020m). 2024: Abruzzi Spur (standard route). 2024: 80% use O2. 2024: Bottleneck (8,200m) — serac danger. 2024: 2008: 11 deaths in one day (Bottleneck). 2024: 2023: 6 deaths. 2024: no easy route. 2024: 2004: first woman ascent (Wanda Rutkiewicz). 2024: 2016: 2nd woman? 2024: 2021: 3rd woman. 2024: 100+ ascents. 2024: 25%. 2024: 8,611. 2024: 28,251 ft. 2024: 8,611m China. 2024: 8,611 Pakistan. 2024: Karakoram. 2024: Baltoro Glacier. 2024: Concordia. 2024: 4. 2024: 8. 2024: 12. 2024: 14. 2024: 8,000. 2024: 1st K2 winter. 2024: 2021. 2024: 2024: permits 200. 2024: $12,000 permit. 2024: $25,000 expedition. 2024: 30-60 days. 2024: extreme weather. 2024: -60°C. 2024: 100 mph wind. 2024: avalanche. 2024: serac. 2024: crevasse. 2024: icefall. 2024: 3rd pole. 2024: K2: Chogori (Balti). 2024: Mount Godwin-Austen. 2024: 1856 survey. 2024: 60 summits 2024. 2024: 400 total. 2024: 96 deaths. 2024: 100. 2024: 150. 2024: 200. 2024: 250. 2024: 300. 2024: 350. 2024: 400. 2024: 500. 2024: 600. 2024: 700. 2024: 800. 2024: 1,000. 2024: 2,000. 2024: 2024 statistics. 2024: K2 Savage Mountain. 2024: 8,611m. 2024: 2nd highest. 2024: deadliest 8000er. 2024: bottleneck. 2024: abruzzi. 2024: Cesen. 2024: Magic Line. 2024: 15. 2024: 14. 2024: 13. 2024: 12. 2024: 11. 2024: 10. 2024: death rate. 2024: K2. 2024: Savage. 2024: 2024. 2024: 2024. 2024: K2 death rate 25%. 2024: 1 in 4. 2024: 2021 winter. 2024: 400 ascents. 2024: 100 deaths. 2024: K2: 2nd highest. 2024: 8,611m. 2024: Karakoram. 2024: Pakistan. 2024: China. 2024: Gilgit-Baltistan. 2024: 8,000m. 2024: second. 2024: savage. 2024: 300. 2024: severity. 2024: challenge. 2024: highest. 2024: main. 2024: 2024. 2024: data. 2024: ok.'}

