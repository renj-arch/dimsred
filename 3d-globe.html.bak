  'Mahapadma Nanda':          {b:-450,d:-362,title:'Nanda Emperor · First empire builder in India',type:'ruler',era:'Ancient'},
  'Alexander the Great':      {b:-356,d:-323,title:'Macedonian King · Invaded India 326 BCE',type:'ruler',era:'Global'},
  'Porus (King Puru)':        {b:-380,d:-315,title:'Paurava King · Fought Alexander at Hydaspes',type:'ruler',era:'Ancient'},
  'Megasthenes':              {b:-350,d:-290,title:'Greek Ambassador to Maurya court · Indica author',type:'explorer',era:'Global'},
  'Kalidasa':                 {b:-50,d:-50,title:'Classical Sanskrit poet · Shakuntala, Meghaduta',type:'scholar',era:'Ancient'},
  'Samudragupta':             {b:-335,d:-380,title:'Gupta Emperor · "Napoleon of India"',type:'ruler',era:'Ancient'},
