D.institution = [
  {n:'IIT Bombay',la:19.13,ln:72.92,sub:'Powai, Mumbai',desc:'Top IIT. Est. 1958. World-class engineering education. Known for robust campus culture & AI/robotics research.',fact:'NIRF rank #3 (engineering) · 550-acre campus · Powai lake · Shuttle radar topography'},
  {n:'IIT Delhi',la:28.54,ln:77.19,sub:'Hauz Khas, Delhi',desc:'Est. 1961 (IIT). Leading in computer science & engineering. Strong industry connections.',fact:'NIRF #2 · 325 acres · Industrial Research & Development unit · Team Robocon'},
  {n:'IIT Kanpur',la:26.51,ln:80.23,sub:'Kalyanpur, UP',desc:'Est. 1959. First IIT to offer computer science. Known for strong theoretical research. MIT collaboration.',fact:'NIRF #4 · 1050+ acres · HEC (IITK) · Indo-US Nuclear deal role'},
  {n:'IIT Kharagpur',la:22.32,ln:87.32,sub:'Kharagpur, WB',desc:'Oldest IIT (est. 1951). First IIT (founded at Hijli Jail). Largest IIT campus. Known for mechanical & aerospace.',fact:'NIRF #5 · 2100 acres · Oldest running train to campus · National Instruments'},
  {n:'IIT Madras',la:12.99,ln:80.23,sub:'Chennai, Tamil Nadu',desc:'Est. 1959. Leading in research output. Known for strong CS, civil, and ocean engineering. IITM Incubation Cell.',fact:'NIRF #1 (2023) · 620 acres · Seashore campus (Bay of Bengal) · Shaastra fest'},
  {n:'IIT Roorkee',la:29.87,ln:77.90,sub:'Roorkee, Uttarakhand',desc:'Oldest engineering college in Asia (est. 1847 as Thomason College of Civil Engineering). Became IIT in 2001.',fact:'NIRF #6 · 365 acres · Indian Institute of Hydrology · Ganga canal research'},
  {n:'IIT Guwahati',la:26.19,ln:91.69,sub:'Guwahati, Assam',desc:'Est. 1994. First IIT in NE India. On Brahmaputra bank. Known for design & research.',fact:'NIRF #7 · 700+ acres · Brahmaputra view · Tech-fest Techniche'},
  {n:'IIM Ahmedabad',la:23.03,ln:72.53,sub:'Ahmedabad, Gujarat',desc:'India\'s top business school (est. 1961). Louis Kahn-designed campus. Case-study method (Harvard affiliate).',fact:'NIRF #1 (management) · Kasturbhai Lalbhai campus · IIMA has highest CAT cut-off'},
  {n:'IIM Bangalore',la:12.89,ln:77.60,sub:'Bengaluru, Karnataka',desc:'Top B-school (est. 1973). Known for entrepreneurship. Located in Electronics City (IT hub).',fact:'NIRF #2 · NSRCEL (incubation cell) · 100 acres · Bannerghatta National Park nearby'},
  {n:'IIM Calcutta',la:22.47,ln:88.43,sub:'Joka, Kolkata',desc:'India\'s first business school (est. 1961 as IIMC). Known for finance & economics.',fact:'NIRF #3 · 135 acres · Thomas Gayen & Howard Disney buildings · Leadership summit'},
  {n:'AIIMS Delhi',la:28.57,ln:77.21,sub:'Ansari Nagar, Delhi',desc:'India\'s premier medical institute (est. 1956). Autonomous. Known for affordable world-class healthcare. NEET-based admission.',fact:'NIRF #1 (medical) · 126 acre · Seven AIIMS like institutions created under PMSSY'},
  {n:'PGIMER Chandigarh',la:30.77,ln:76.78,sub:'Chandigarh',desc:'Postgraduate Institute of Medical Education & Research. Est. 1962. Top medical research institution.',fact:'NIRF #2 · Founded under Act of Parliament · Liver & kidney transplant pioneer'},
  {n:'JNU Delhi',la:28.54,ln:77.17,sub:'New Delhi',desc:'Jawaharlal Nehru University. Top central university. Known for social sciences, languages, and international relations.',fact:'Central University · 1000 acres · "University of the Year" · Strong student politics'},
  {n:'University of Delhi',la:28.69,ln:77.21,sub:'Delhi',desc:'Central University (est. 1922). Largest university in India. 90+ colleges. Known for arts, sciences, commerce.',fact:'Vice-Regal Lodge · Over 700K students · St. Stephen\'s, Hindu, Ramjas colleges'},
  {n:'BHU (Banaras Hindu)',la:25.27,ln:82.99,sub:'Varanasi, UP',desc:'Est. 1916 by Madan Mohan Malaviya. Largest residential university in Asia. IIT BHU campus within.',fact:'1300 acres · 30K+ students · Bharat Kala Bhavan museum · Sir Sunderlal Hospital'},
  {n:'ISI Kolkata',la:22.56,ln:88.40,sub:'Kolkata, WB',desc:'Indian Statistical Institute. Est. 1931 by P.C. Mahalanobis. Institute of national importance. Statistics & data science.',fact:'"Statistical Quality Control" invented (Mahalanobis distance) · 1959 Act'},
  {n:'NLSIU Bangalore',la:12.82,ln:77.60,sub:'Bengaluru',desc:'National Law School of India University. Top law school in India. Est. 1986. CLAT admission.',fact:'NIRF #1 (law) · 40 acres · Prof. N.R. Madhava Menon founded · Mooting hub'},
  {n:'CUSAT',la:10.05,ln:76.33,sub:'Cochin, Kerala',desc:'Cochin University of Science & Technology. Est. 1971. Known for marine sciences, naval architecture.',fact:'State University · 2 campuses · School of Marine Sciences · Naval architecture rare'},
  {n:'TISS Mumbai',la:19.08,ln:72.88,sub:'Mumbai',desc:'Tata Institute of Social Sciences. Top social sciences institute (est. 1936). Social work, HR, development studies.',fact:'NIRF #1 (social work) · Founded with Sir Dorabji Tata Trust · Advocacy, activism hub'},
  {n:'IISc Bangalore',la:12.99,ln:77.58,sub:'Bengaluru',desc:'Indian Institute of Science. India\'s top research institute. Est. 1909 by J.N. Tata & Lord Minto. PhD/MSc only.',fact:'NIRF #1 (overall) · 400 acres · CV Raman, Homi Bhabha alumni · JNCASR nearby'},
  {n:'ACU (Aligarh Muslim)',la:27.92,ln:78.08,sub:'Aligarh, UP',desc:'AMU. Central University. Est. 1875 by Sir Syed Ahmad Khan (MAO College). Became university 1920.',fact:'Sir Syed Hall · Maulana Azad Library (4M+ books) · JN Medical College · LAC debate'},
  {n:'Jamia Millia Islamia',la:28.56,ln:77.27,sub:'Delhi',desc:'Central University (est. 1920). Founded at Aligarh, moved to Delhi. Known for mass communication, fine arts.',fact:'AJK Mass Comm Research Centre · 224 acres · Mujeeb Bagh · India\'s cleanest campus'},
  {n:'Anjuman-e-Islamia',la:18.96,ln:72.83,sub:'Mumbai · Est. 1874',desc:'One of India\'s oldest Muslim educational and social reform organizations. Founded in Mumbai in 1874 by social reformers including Badruddin Tyabji (later President of Indian National Congress). Established schools and colleges across Maharashtra including Anjuman-I-Islam\'s College in Mumbai. Pioneered modern education for the Muslim community. Runs 50+ educational institutions from primary to postgraduate level.',fact:'Founded 1874 · Badruddin Tyabji co-founder · 50+ institutions · Mumbai & Maharashtra · Pioneered Muslim modern education'},
  {n:'VIT Vellore',la:12.97,ln:79.16,sub:'Vellore, TN · Deemed University',desc:'Vellore Institute of Technology (est. 1984). Top private engineering institution. Known for international rankings & placements. VITEEE exam.',fact:'NIRF #8 (engineering) · 620+ acres · International campus (VIT Chennai, VIT AP) · 85% placement'},
  {n:'BITS Pilani',la:28.37,ln:75.60,sub:'Pilani, Rajasthan · Deemed University',desc:'Birla Institute of Technology & Science. Est. 1964 (from 1929 college). Top private university. Campuses in Pilani, Goa, Hyderabad, Dubai.',fact:'BITSAT exam · Pilani is main campus · Practice School (work-integrated) · Alumni in top global firms'},
  {n:'IIT Hyderabad',la:17.59,ln:78.29,sub:'Hyderabad, Telangana',desc:'Est. 2008. Fastest-growing IIT. Known for design & innovation. 576-acre campus. Strong CS & AI research.',fact:'NIRF #8 (engineering) · 576 acres · Kandi village campus · IITH drone lab & AI'},
  {n:'IIT Gandhinagar',la:23.21,ln:72.68,sub:'Gandhinagar, Gujarat',desc:'Est. 2008. Known for interdisciplinary approach. Liberal arts & design integrated. On Sabarmati riverfront.',fact:'NIRF #18 · 400 acres · PAIR (liberal arts) · Sabarmati river bank · Design focus'},
  {n:'IIT Indore',la:22.52,ln:75.90,sub:'Indore, MP',desc:'Est. 2009. Known for humanities & social sciences integration. Accepts JEE Advanced. Green campus, 500 acres.',fact:'NIRF #22 · 500 acres · Simrol campus · Herbaria & botanical garden · Abhyaas fest'},
  {n:'NIT Trichy',la:10.76,ln:78.80,sub:'Tiruchirappalli, TN',desc:'National Institute of Technology, Tiruchirappalli (est. 1964). Top NIT in India. Known for placements & industry connect.',fact:'NIRF #9 (engineering) · 800 acres · Called "NIT Pride" · Tata Consultancy Services partnership'},
  {n:'IISER Pune',la:18.54,ln:73.81,sub:'Pune, Maharashtra',desc:'Indian Institute of Science Education & Research. Est. 2006. Research & science education. Known for high-quality faculty.',fact:'NIRF #18 (university) · 100 acres · IISER system of 7 · Strong research output & international pubs'},
  {n:'CCMB Hyderabad',la:17.45,ln:78.38,sub:'Hyderabad, Telangana',desc:'Centre for Cellular & Molecular Biology. Est. 1977. Under CSIR. Pioneer in genomics, molecular biology & biotechnology in India.',fact:'CSIR lab · Human genome & COVID sequencing · Bt cotton innovation · Shahid Jameel, Mishra directors'},
  {n:'IIIT Hyderabad',la:17.44,ln:78.35,sub:'Hyderabad, Telangana',desc:'International Institute of Information Technology. Est. 1998. Deemed university. Research in CS, AI, robotics, language tech. Strong startup culture.',fact:'NIRF #56 (eng) · 62 acres · Founded by P. Raj Reddy, N. Seshagiri · Largest CS faculty in India'},
  {n:'ICAR-IARI Delhi',la:28.63,ln:77.15,sub:'Pusa, Delhi',desc:'Indian Agricultural Research Institute. Est. 1905 (Pusa, Bihar), moved to Delhi 1936. Green Revolution contribution. India\'s top agri research.',fact:'Green Revolution × M.S. Swaminathan · Pusa Institute · IARI breeds high-yield wheat · Nobel Peace Prize 1970 (food)'},
