  {n:'Nilgiri Biosphere',la:11.40,ln:76.60,sub:'Tamil Nadu/Kerala/Karnataka',desc:'India\'s first Biosphere Reserve (1986). Spans 5500 sq km. Includes Bandipur, Nagarhole, Wayanad, Mukurthi, Mudumalai.',fact:'First biosphere reserve · UNESCO (2000) · Nilgiri Tahr · Shola forests · Mudumalai elephant corridor'},
  {n:'Nanda Devi Biosphere',la:30.50,ln:79.80,sub:'Uttarakhand',desc:'UNESCO Biosphere Reserve (2004). Nanda Devi peak + Valley of Flowers. 6407 sq km. Alpine flora.',fact:'UNESCO Man & Biosphere · Buffer Zone · Lesser snow leopard habitat'},
  {n:'Gulf of Mannar Biosphere',la:9.00,ln:79.25,sub:'Tamil Nadu',desc:'First marine biosphere in India (1989). 21 islands. Coral reefs, seagrass, mangroves. Dugong (sea cow) habitat.',fact:'10500 sq km · 3600+ species · Dugong conservation · Pearl fishery'},
