    {
      "id": 70,
      "q": 12,
      "section": "Mathematics",
      "text": "A bank offers a special 'Festival Savings Scheme' where the interest rate for the first year is 5% per annum on the principal. However, the interest earned in the first year is added to the principal at the end of the year. If a customer deposits ₹10,000 and closes the account after exactly one year, what is the total amount received?",
      "options": [
        {
          "label": "A",
          "text": "₹10,500",
          "correct": true
        },
        {
          "label": "B",
          "text": "₹10,525",
          "correct": false
        },
        {
          "label": "C",
          "text": "₹10,600",
          "correct": false
        },
        {
          "label": "D",
          "text": "₹10,400",
          "correct": false
        }
      ],
      "solution": "Simple Interest = (P * R * T) / 100.\nSubstituting values: P = 10000, R = 5%, T = 1 year.\nSI = (10000 * 5 * 1) / 100.\nSI = 500.\nTotal Amount = Principal + Interest = 10000 + 500 = 10500."
    },
