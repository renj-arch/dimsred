  {
   "id": 133,
   "q": 1,
   "section": "Mathematics",
   "text": "A shopkeeper sells a cricket bat with a marked price of ₹5,000. He offers two alternatives: Scheme A: 15% discount followed by a further 10% discount on the reduced price. Scheme B: A single flat discount of x%. To make the final selling price identical in both schemes, what is the value of x?",
   "options": [
    {
     "label": "A",
     "text": "25%",
     "correct": false
    },
    {
     "label": "B",
     "text": "23.5%",
     "correct": true
    },
    {
     "label": "C",
     "text": "22.5%",
     "correct": false
    },
    {
     "label": "D",
     "text": "24%",
     "correct": false
    }
   ],
   "solution": "Discount A = 15%. Remaining = 85%.\nDiscount B = 10%. Remaining = 90%.\nCombined Remaining = 85% x 90% = 0.85 x 0.90 = 0.765.\nTotal Discount = 1 - 0.765 = 0.235.\nx = 23.5%."
  },
  {
   "id": 104,
   "q": 2,
   "section": "Mathematics",
   "text": "A bank offers a special 'Festival Savings Scheme' where the interest rate for the first year is 5% per annum on the principal. However, the interest earned in the first year is added to the principal at the end of the year. If a customer deposits ₹10,000 and closes the account after exactly one year, what is the total amount received?",
   "options": [
    {
     "label": "A",
     "text": "₹10,500",
     "correct": true
    },
    {
     "label": "B",
     "text": "₹10,525",
     "correct": false
    },
    {
     "label": "C",
     "text": "₹10,600",
     "correct": false
    },
    {
     "label": "D",
     "text": "₹10,400",
     "correct": false
    }
   ],
   "solution": "Simple Interest = (P * R * T) / 100.\nSubstituting values: P = 10000, R = 5%, T = 1 year.\nSI = (10000 * 5 * 1) / 100.\nSI = 500.\nTotal Amount = Principal + Interest = 10000 + 500 = 10500."
  },
