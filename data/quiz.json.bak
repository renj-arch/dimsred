      "type": "fill_blank",
      "category": "ISRO & Space",
      "region": "",
      "source": "Wiki",
      "pubDate": "2026-06-27T16:10:40.131Z",
      "subject": "ISRO & Space",
      "subSubject": "ISRO & Space",
