K, we get ln K = nFE°/(RT). A more positive E° gives a larger K."},{id:46066,text:"?? A concentration cell with electrodes of the same metal but different ion concentrations produces a potential because:",opts:[{l:"A",t:"The cell works to equalize concentrations",c:true},{l:"B",t:"The metals have different reduction potentials",c:false},{l:"C",t:"The salt bridge generates a potential",c:false},{l:"D",t:"Temperature differences create a potential",c:false}],sol:"The correct answer is <strong>A</strong>: A concentration cell produces a potential from the difference in ion concentrations; the cell drives the system toward equal concentrations (E = -(RT/nF) ln([dilute]/[concentrated]))."},{id:46067,text:"? Faraday&apos;s constant F is approximately equal to:",opts:[{l:"A",t:"96,485 C/mol",c:true},{l:"B",t:"96,485 J/mol",c:false},{l:"C",t:"6.022 × 10²³ C",c:false},{l:"D",t:"1.602 × 10?¹? C/mol",c:false}],sol:"The correct answer is <strong>A</strong>: The Faraday constant F = 96,485 C/mol is the charge of one mole of electrons (N_A × e = 6.022×10²³ × 1.602×10?¹? = 96,485 C/mol)."},{id:46068,text:"? How many coulombs are needed to deposit 0.500 g of silver (M = 107.87 g/mol, Ag? + e? ? Ag)?",opts:[{l:"A",t:"447 C",c:true},{l:"B",t:"894 C",c:false},{l:"C",t:"224 C",c:false},{l:"D",t:"96,485 C",c:false}],sol:"The correct answer is <strong>A</strong>: Q = m z F / M = (0.500 × 1 × 96485)/(107.87) = 447 C. Since z = 1 (one electron per Ag?), Q = 447 C."},{id:46069,text:"? The overpotential in electrolysis refers to:",opts:[{l:"A",t:"The extra voltage required above the thermodynamic E°",c:true},{l:"B",t:"The theoretical minimum voltage",c:false},{l:"C",t:"The voltage produced by a concentration cell",c:false},{l:"D",t:"The voltage of a fuel cell",c:false}],sol:"The correct answer is <strong>A</strong>: Overpotential is the additional voltage beyond the thermodynamic E° needed to overcome kinetic barriers (activation and concentration overpotential) during electrolysis."},{id:46070,text:"?? According to Kohlrausch&apos;s law, the molar conductivity of a strong electrolyte at low concentration follows:",opts:[{l:"A",t:"?_m = ?_m° - Kvc",c:true},{l:"B",t:"?_m = ?_m° + Kvc",c:false},{l:"C",t:"?_m = ?_m° - Kc",c:false},{l:"D",t:"?_m = K/vc",c:false}],sol:"The correct answer is <strong>A</strong>: Kohlrausch&apos;s law states ?_m = ?_m° - Kvc for strong electrolytes at low concentrations, where K is a constant depending on the electrolyte type."},{id:46071,text:"?? Given ?°(Na?) = 50.1 and ?°(Cl?) = 76.3 S·cm²/mol, the ?_m° of NaCl is:",opts:[{l:"A",t:"126.4",c:true},{l:"B",t:"26.2",c:false},{l:"C",t:"50.1",c:false},{l:"D",t:"76.3",c:false}],sol:"The correct answer is <strong>A</strong>: ?_m°(NaCl) = ?°(Na?) + ?°(Cl?) = 50.1 + 76.3 = 126.4 S·cm²/mol (Kohlrausch&apos;s law of independent migration)."},{id:46072,text:"?? For a weak electrolyte, the degree of dissociation a is given by:",opts:[{l:"A",t:"a = ?_m/?_m°",c:true},{l:"B",t:"a = ?_m° - ?_m",c:false},{l:"C",t:"a = (?_m)²",c:false},{l:"D",t:"a = v(?_m/?_m°)",c:false}],sol:"The correct answer is <strong>A</strong>: For a weak electrolyte, a = ?_m/?_m°, where ?_m is the molar conductivity at concentration c and ?_m° is the limiting molar conductivity."}];var answered={},correctCount=0;function renderPractice(){var c=document.getElementById('practice-qs'),h='';for(var i=0;i<practiceQs.length;i++){var q=practiceQs[i],o='';for(var j=0;j<q.opts.length;j++){o+='<div class="q-opt" onclick="selectOpt('+q.id+','+j+')">'+q.opts[j].l+'. '+q.opts[j].t+'</div>';}h+='<div class="q-card" id="q-'+q.id+'"><div class="q-text">'+(i+1)+'. '+q.text+'</div><div class="q-opts">'+o+'</div><div class="q-soln" id="soln-'+q.id+'"><strong>'+getCorrectLabel(q)+'</strong><br>'+q.sol+'</div></div>';}c.innerHTML=h;}function getCorrectLabel(q){for(var i=0;i<q.opts.length;i++){if(q.opts[i].c)return q.opts[i].l+'. '+q.opts[i].t;}return '';}function selectOpt(qId,idx){if(answered[qId])return;answered[qId]=true;var q=practiceQs.filter(function(x){return x.id===qId})[0];var opts=document.querySelectorAll('#q-'+qId+' .q-opt'),isCorrect=q.opts[idx].c;for(var i=0;i<opts.length;i++)opts[i].classList.add('disabled');if(isCorrect){opts[idx].classList.add('correct');correctCount++;}else{opts[idx].classList.add('wrong');for(var i=0;i<q.opts.length;i++){if(q.opts[i].c)opts[i].classList.add('correct');}}document.getElementById('soln-'+qId).classList.add('show');}function resetPractice(){if(!confirm('Reset?'))return;answered={};correctCount=0;document.querySelectorAll('.q-opt').forEach(function(e){e.className='q-opt'});document.querySelectorAll('.q-soln').forEach(function(e){e.classList.remove('show')});renderPractice();}renderPractice();</script></body></html>