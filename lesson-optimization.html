function renderPractice(){var c=document.getElementById('practice-qs'),h='';for(var i=0;i<practiceQs.length;i++){var q=practiceQs[i],o='';for(var j=0;j<q.opts.length;j++){o+='<div class="q-opt" data-qid="'+q.id+'" data-idx="'+j+'" onclick="selectOpt('+q.id+','+j+')">'+q.opts[j].l+'. '+q.opts[j].t+'</div>';}h+='<div class="q-card" id="q-'+q.id+'"><div class="q-num" style="font-size:.78em;color:var(--text-muted);margin-bottom:6px"><span>Question '+(i+1)+' of '+practiceQs.length+'</span></div><div class="q-text">'+q.text+'</div><div class="q-opts">'+o+'</div><div class="q-soln" id="soln-'+q.id+'"><strong>Answer: '+getCorrectLabel(q)+'</strong><br>'+q.sol+'</div><div class="q-result" id="result-'+q.id+'"></div></div>';}c.innerHTML=h;updateScore();}
function getCorrectLabel(q){for(var i=0;i<q.opts.length;i++){if(q.opts[i].c)return q.opts[i].l+'. '+q.opts[i].t;}return '';}
function selectOpt(qId,idx){if(answered[qId])return;answered[qId]=true;var q=practiceQs.filter(function(x){return x.id===qId})[0];var opts=document.querySelectorAll('#q-'+qId+' .q-opt');var isCorrect=q.opts[idx].c;for(var i=0;i<opts.length;i++)opts[i].classList.add('disabled');if(isCorrect){opts[idx].classList.add('correct');document.getElementById('result-'+qId).textContent='✅ Correct!';document.getElementById('result-'+qId).className='q-result correct';correctCount++;}else{opts[idx].classList.add('wrong');document.getElementById('result-'+qId).textContent='❌ Not quite. Read the solution!';document.getElementById('result-'+qId).className='q-result wrong';for(var i=0;i<q.opts.length;i++){if(q.opts[i].c)opts[i].classList.add('correct');}}document.getElementById('soln-'+qId).classList.add('show');updateScore();}
function updateScore(){var t=Object.keys(answered).length;var el=document.getElementById('score-display');if(!el){el=document.createElement('div');el.id='score-display';el.style.cssText='font-size:.85em;color:var(--text-sec);margin-bottom:10px;padding:10px 14px;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius)';document.getElementById('practice-qs').before(el);}el.innerHTML='<span style="font-weight:700">📊 Progress:</span> Attempted: '+t+'/'+practiceQs.length+' | ✅ Correct: '+correctCount+' | 🎯 Accuracy: '+(t>0?Math.round(correctCount/t*100):0)+'%';}
function resetPractice(){if(!confirm('Reset all answers?'))return;answered={};correctCount=0;document.querySelectorAll('#practice-qs .q-opt').forEach(function(e){e.className='q-opt'});document.querySelectorAll('#practice-qs .q-soln').forEach(function(e){e.classList.remove('show')});document.querySelectorAll('#practice-qs .q-result').forEach(function(e){e.textContent='';e.className='q-result'});var el=document.getElementById('score-display');if(el)el.textContent='';renderPractice();}
renderPractice();
</script></body></html>