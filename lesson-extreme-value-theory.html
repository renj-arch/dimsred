function renderPractice(){var c=document.getElementById('practice-qs'),h='';for(var i=0;i<practiceQs.length;i++){var q=practiceQs[i],o='';for(var j=0;j<q.opts.length;j++){o+='<div class="q-opt" onclick="selectOpt('+q.id+','+j+')">'+q.opts[j].l+'. '+q.opts[j].t+'</div>';}h+='<div class="q-card" id="q-'+q.id+'"><div class="q-text">'+(i+1)+'. '+q.text+'</div><div class="q-opts">'+o+'</div><div class="q-soln" id="soln-'+q.id+'"><strong>'+getCorrectLabel(q)+'</strong><br>'+q.sol+'</div></div>';}c.innerHTML=h;}
function getCorrectLabel(q){for(var i=0;i<q.opts.length;i++){if(q.opts[i].c)return q.opts[i].l+'. '+q.opts[i].t;}return '';}
function selectOpt(qId,idx){if(answered[qId])return;answered[qId]=true;var q=practiceQs.filter(function(x){return x.id===qId})[0];var opts=document.querySelectorAll('#q-'+qId+' .q-opt'),isCorrect=q.opts[idx].c;for(var i=0;i<opts.length;i++)opts[i].classList.add('disabled');if(isCorrect){opts[idx].classList.add('correct');correctCount++;}else{opts[idx].classList.add('wrong');for(var i=0;i<q.opts.length;i++){if(q.opts[i].c)opts[i].classList.add('correct');}}}
function resetPractice(){if(!confirm('Reset?'))return;answered={};correctCount=0;document.querySelectorAll('.q-opt').forEach(function(e){e.className='q-opt'});document.querySelectorAll('.q-soln').forEach(function(e){e.classList.remove('show')});renderPractice();}
renderPractice();
</script></body></html>